<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<!-- Required once the shell addresses the Field server on the same subnet (https://10.0.0.x:9093)
	     rather than over Tailscale. Reaching a Tailscale address goes out a utun interface and is not
	     gated by this privacy check; a plain-LAN address is, and so is the RTT receiver's inbound UDP
	     socket. Without the key the first connection fails silently. -->
	<key>NSHandsTrackingUsageDescription</key>
	<string>Spatial Ink draws at the position of your pinching fingers.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Field4Vision connects to the Field server running on your Mac to receive geometry and video and send Spatial Ink sketches.</string>
	<!-- Field serves a self-signed dev certificate. ATS exempts IP literals but not names, so reaching
	     the Mac by its Tailscale name (ServerConfig's default) failed the handshake with -1200 before
	     FieldServerTrustDelegate could accept the certificate. Scoped to the tailnet and `mi2`. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
			</dict>
			<key>mi2</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<false/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
