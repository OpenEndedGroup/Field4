<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<!-- Required once the shell addresses the Field server on the same subnet (https://10.0.0.x:9093)
	     rather than over Tailscale. Reaching a Tailscale address goes out a utun interface and is not
	     gated by this privacy check; a plain-LAN address is, and so is the RTT receiver's inbound UDP
	     socket. Without the key the first connection fails silently. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Field4Vision connects to the Field server running on your Mac to display documents, receive FLine geometry, and receive the rendered video stream.</string>
</dict>
</plist>
