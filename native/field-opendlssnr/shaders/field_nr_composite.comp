#version 460
#extension GL_GOOGLE_include_directive : require
#include "field_nr_common.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(std430,binding=4) readonly buffer Features {float features[];};
layout(std430,binding=5) readonly buffer Head {float head[];};
layout(binding=6,rgba16f) uniform writeonly image2D historyNext;
layout(binding=7,rgba16f) uniform writeonly image2D outputColor;
void main() {
 uvec2 id=gl_GlobalInvocationID.xy;
 if(id.x>=pc.validWidth || id.y>=pc.validHeight)return;
 uint i=(id.y*pc.fullWidth+id.x);
 vec3 h=vec3(head[i*4],head[i*4+1],head[i*4+2]);
 vec3 centered=vec3(features[i*16+4],features[i*16+5],features[i*16+6]);
 vec3 neural=clamp(fma(h,vec3(0.03125),centered)*8.0+0.5,0.0,1.0);
 if(validHistory(ivec2(id))) {
  float weight=clamp((1.0/(1.0+exp2(head[i*4+3]*uintBitsToFloat(0xbfb8aa3bu))))*clamp(pc.blendScale,0.0,1.0),0.0,1.0);
  neural=fma(vec3(weight),historySample(ivec2(id))-neural,neural);
 }
 for(int c=0;c<3;c++)neural[c]=truncateHalf(neural[c]);
 imageStore(historyNext,ivec2(id),vec4(neural,pc.temporal!=0u?texelFetch(depthTex,ivec2(id),0).r:1.0));
 vec3 published=mix(proxyAt(ivec2(id)),neural,pc.intensity);
 // Field output is linear light: the existing grading/display path can follow NR.
 vec3 linear=vec3(srgbDecode(published.r),srgbDecode(published.g),srgbDecode(published.b));
 float alpha=pc.preserveAlpha!=0u?texelFetch(sourceColor,ivec2(id),0).a:1.0;
 imageStore(outputColor,ivec2(id),vec4(linear,alpha));
}
