 "boxes" [
 {"id" "36523055-c4e9-49fe-a196-2ea6df5ba362" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Some syntax before we get started" "frame" #afield/rect [20 20 460 100] "preamble" "" "code" #afield/file-inline {"path" "36523055-c4e9-49fe-a196-2ea6df5ba362_code_.kt" "inline" "\n// 1) Preferred in Field: build inside `fline { ... }`.\nval f1 = fline {\n    moveTo(20, 20)\n    lineTo(120, 20)\n    lineTo(120, 120)\n    close()\n\n    filled = true\n    stroked = true\n    thickness = 3.0\n    color = vec(1.0, 1.0, 1.0, 0.25)\n}\n\n// 2) The explicit style: make a var and reuse it.\nval f3 = FLine()\nf3.moveTo(20, 20)\nf3.lineTo(120, 20)\nf3.lineTo(120, 120)\nf3.close()\nf3.filled = true\nf3.stroked = true\nf3.thickness = 3.0\nf3.color = vec(1.0, 1.0, 1.0, 0.25)\n\n// Show they really are the same geometry (offset so you can see them).\nlines(listOf(f1 + vec(0, 0, 0), f3 + vec(180, 0, 0)), w = 320.0, h = 170.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/some_syntax_before_we_get_started.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 26, \"column\": 1}, \"position\": {\"lineNumber\": 26, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 26, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "c0f13166-25d5-4b3e-a848-b70921085b77" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Styling color stroked filled pointed" "frame" #afield/rect [520 20 460 100] "preamble" "" "code" #afield/file-inline {"path" "c0f13166-25d5-4b3e-a848-b70921085b77_code_.kt" "inline" "\nval shape = fline {\n    moveTo(60, 60)\n    cubicTo(120, 20, 300, 240, 360, 180)\n    lineTo(360, 240)\n    lineTo(60, 240)\n    close()\n}\n\nval strokedOnly = shape.copy().apply {\n    stroked = true\n    filled = false\n    thickness = 6.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nval filledOnly = shape.copy().apply {\n    stroked = false\n    filled = true\n    color = vec(0.4, 1.0, 0.6, 0.25)\n}\n\nval debugPoints = shape.copy().apply {\n    stroked = false\n    filled = false\n    pointed = true\n    pointSize = 3.0\n    color = vec(1.0, 0.5, 0.2, 1.0)\n}\n\nlines(listOf(filledOnly, strokedOnly, debugPoints), w = 420.0, h = 320.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/styling_color_stroked_filled_pointed.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 30, \"column\": 1}, \"position\": {\"lineNumber\": 30, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 30, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "21a1c4ed-9f07-4ea5-a61e-fbb59c8008f4" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "moveTo overloads" "frame" #afield/rect [1020 20 460 100] "preamble" "" "code" #afield/file-inline {"path" "21a1c4ed-9f07-4ea5-a61e-fbb59c8008f4_code_.kt" "inline" "\nval a = vec(50, 50)\nval b = vec(350, 200)\n\nval f = fline {\n    moveTo(a)          // Vec2\n    lineTo(b.x, b.y)   // Numbers\n\n    thickness = 6.0\n    color = vec(0.9, 0.9, 1.0, 1.0)\n}\n\nlines(f, w = 400.0, h = 250.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/moveto_overloads.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 12, \"column\": 1}, \"position\": {\"lineNumber\": 12, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 12, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "bb72544f-7ff6-47b5-975f-176c0b4cd98c" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "lineTo overloads" "frame" #afield/rect [1520 20 460 100] "preamble" "" "code" #afield/file-inline {"path" "bb72544f-7ff6-47b5-975f-176c0b4cd98c_code_.kt" "inline" "\nval poly = fline {\n    moveTo(50, 50)\n    lineTo(350, 50)\n    lineTo(350, 200)\n    lineTo(50, 200)\n    close()\n\n    stroked = true\n    filled = true\n    thickness = 3.0\n    color = vec(0.2, 0.9, 0.6, 0.35)\n}\n\nlines(poly, w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/lineto_overloads.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 14, \"column\": 1}, \"position\": {\"lineNumber\": 14, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 14, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "b0e73159-c126-4839-88da-5481baf4b66d" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "cubicTo Bezier curves" "frame" #afield/rect [2020 20 460 100] "preamble" "" "code" #afield/file-inline {"path" "b0e73159-c126-4839-88da-5481baf4b66d_code_.kt" "inline" "\n// We'll draw the curve AND its control handles.\nval p0 = vec(50, 160)\nval c1 = vec(150, 20)\nval c2 = vec(250, 300)\nval p3 = vec(350, 160)\n\nval curve = fline {\n    moveTo(p0)\n    cubicTo(c1.v3, c2.v3, p3.v3)\n    thickness = 5.0\n    color = vec(1.0, 0.8, 0.2, 1.0)\n}\n\n// The \"handle lines\" show how tangents are determined.\nval handles = listOf(\n    seg(p0, c1, pointed = false, color = vec(1.0, 1.0, 1.0, 0.35)).apply { thickness = 2.0 },\n    seg(p3, c2, pointed = false, color = vec(1.0, 1.0, 1.0, 0.35)).apply { thickness = 2.0 },\n)\n\n// Dots for endpoints and control points.\nfun dot(p: Vec2, color: Vec4) = fline {\n    moveTo(p.x, p.y)\n    lineTo(p.x + 0.001, p.y + 0.001)\n    pointed = true\n    pointSize = 4.5\n    stroked = false\n    filled = true\n    this.color = color\n}\n\nval pts = listOf(\n    dot(p0, vec(1.0, 1.0, 1.0, 1.0)),\n    dot(p3, vec(1.0, 1.0, 1.0, 1.0)),\n    dot(c1, vec(0.4, 1.0, 0.6, 1.0)),\n    dot(c2, vec(0.4, 1.0, 0.6, 1.0)),\n)\n\nlines(handles + listOf(curve) + pts, w = 420.0, h = 320.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/cubicto_bezier_curves.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 38, \"column\": 1}, \"position\": {\"lineNumber\": 38, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 38, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "f26dab9f-8c81-4c2a-b26c-6229a8f5c37c" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "close" "frame" #afield/rect [2520 20 460 100] "preamble" "" "code" #afield/file-inline {"path" "f26dab9f-8c81-4c2a-b26c-6229a8f5c37c_code_.kt" "inline" "\nval tri = fline {\n    moveTo(200, 40)\n    lineTo(360, 240)\n    lineTo(40, 240)\n    close()\n\n    filled = true\n    stroked = true\n    thickness = 2.0\n    color = vec(0.9, 0.4, 0.9, 0.35)\n}\n\nlines(tri, w = 420.0, h = 300.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/close.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 13, \"column\": 1}, \"position\": {\"lineNumber\": 13, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 13, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "271752b1-edaf-408e-8d27-584a8eed6853" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "breakNext" "frame" #afield/rect [3020 20 460 100] "preamble" "" "code" #afield/file-inline {"path" "271752b1-edaf-408e-8d27-584a8eed6853_code_.kt" "inline" "\nval f = fline {\n    moveTo(50, 50)\n    lineTo(350, 50)\n\n    breakNext()\n    lineTo(50, 200)    // starts a new subpath\n    lineTo(350, 200)\n\n    thickness = 6.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nlines(f, w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/breaknext.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 13, \"column\": 1}, \"position\": {\"lineNumber\": 13, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 13, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "9b57e542-e11d-43bb-add7-1cdbe25e3c5d" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "pieces" "frame" #afield/rect [3520 20 460 100] "preamble" "" "code" #afield/file-inline {"path" "9b57e542-e11d-43bb-add7-1cdbe25e3c5d_code_.kt" "inline" "\nval f = fline {\n    moveTo(50, 50)\n    lineTo(350, 50)\n\n    moveTo(50, 200)\n    lineTo(350, 200)\n\n    thickness = 5.0\n    color = vec(0.7, 0.9, 1.0, 1.0)\n}\n\nval ps = f.pieces()\nlines(ps, w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/pieces.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 13, \"column\": 1}, \"position\": {\"lineNumber\": 13, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 13, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "c60751ef-ea01-4abf-b88c-458655b799ab" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "copy and transform" "frame" #afield/rect [4020 20 460 100] "preamble" "" "code" #afield/file-inline {"path" "c60751ef-ea01-4abf-b88c-458655b799ab_code_.kt" "inline" "\nval base = fline {\n    moveTo(60, 60)\n    cubicTo(120, 20, 240, 200, 320, 140)\n    thickness = 4.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nval wobble = base.transform { p ->\n    val dx = 10f * kotlin.math.sin(p.y * 0.05f)\n    vec(p.x + dx, p.y, p.z)\n}.apply {\n    color = vec(1.0, 0.4, 0.4, 1.0)\n}\n\nlines(listOf(base, wobble), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/copy_and_transform.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 15, \"column\": 1}, \"position\": {\"lineNumber\": 15, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 15, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "35d2ed3b-05ea-4e2f-8a4b-c3355c349e9d" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Operator transforms" "frame" #afield/rect [4520 20 460 100] "preamble" "" "code" #afield/file-inline {"path" "35d2ed3b-05ea-4e2f-8a4b-c3355c349e9d_code_.kt" "inline" "\nval square = fline {\n    moveTo(0, 0); lineTo(100, 0); lineTo(100, 100); lineTo(0, 100); close()\n    thickness = 3.0\n    filled = true\n    color = vec(0.3, 0.8, 1.0, 0.35)\n}\n\nval a = (square * 1.0) + vec(60, 60, 0)\nval b = (square * 1.4) + vec(200, 80, 0)\nval c = (square * 0.7) + vec(320, 140, 0)\n\nlines(listOf(a, b, c), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/operator_transforms.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 12, \"column\": 1}, \"position\": {\"lineNumber\": 12, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 12, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "d26a4b52-468b-4ca2-81cc-f34467d4876a" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Polylines polylineFrom and byAppendingPolyline" "frame" #afield/rect [20 520 460 100] "preamble" "" "code" #afield/file-inline {"path" "d26a4b52-468b-4ca2-81cc-f34467d4876a_code_.kt" "inline" "\nval pts = (0..80).map { i ->\n    val x = 20 + i * 5\n    val y = 120 + 60 * kotlin.math.sin(i * 0.2)\n    vec(x, y)\n}\n\nval wave = polylineFrom(pts, closed = false).apply {\n    thickness = 3.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nlines(wave, w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/polylines_polylinefrom_and_byappendingpolyline.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 12, \"column\": 1}, \"position\": {\"lineNumber\": 12, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 12, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "cdc1801b-80e0-45a6-bf55-dac757fffa3f" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Smooth polylines cubic splines" "frame" #afield/rect [520 520 460 100] "preamble" "" "code" #afield/file-inline {"path" "cdc1801b-80e0-45a6-bf55-dac757fffa3f_code_.kt" "inline" "\nval pts2 = (0..10).map { i ->\n    val x = 40 + i * 34\n    val y = 130 + 70 * kotlin.math.sin(i * 0.8)\n    vec(x, y)\n}\n\nval poly2 = polylineFrom(pts2, closed = false).apply {\n    thickness = 2.0\n    color = vec(1.0, 1.0, 1.0, 0.25)\n    pointed = true\n    pointSize = 3.0\n}\n\nval spline = cubicSplineFrom(pts2, closed = false, tension = 1f).apply {\n    thickness = 5.0\n    color = vec(0.7, 0.9, 1.0, 1.0)\n}\n\nlines(listOf(poly2, spline), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/smooth_polylines_cubic_splines.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 19, \"column\": 1}, \"position\": {\"lineNumber\": 19, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 19, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "2dab2a80-c55f-4a59-ab55-135188ca1725" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Incremental smoothing smoothTo and tcbTo" "frame" #afield/rect [1020 520 460 100] "preamble" "" "code" #afield/file-inline {"path" "2dab2a80-c55f-4a59-ab55-135188ca1725_code_.kt" "inline" "\nval s1 = fline {\n    moveTo(60, 200)\n    smoothTo(120, 60)\n    smoothTo(220, 240)\n    smoothTo(360, 120)\n    thickness = 5.0\n    color = vec(1.0, 0.7, 0.2, 0.9)\n}\n\nval s2 = fline {\n    moveTo(60, 200)\n    tcbTo(vec(120, 60), tension = 0.2f, continuity = -0.2f, bias = 0.0f)\n    tcbTo(vec(220, 240), tension = 0.2f, continuity = -0.2f, bias = 0.0f)\n    tcbTo(vec(360, 120), tension = 0.2f, continuity = -0.2f, bias = 0.0f)\n    thickness = 5.0\n    color = vec(0.4, 1.0, 0.6, 0.9)\n}\n\nlines(listOf(s1, s2), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/incremental_smoothing_smoothto_and_tcbto.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 19, \"column\": 1}, \"position\": {\"lineNumber\": 19, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 19, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "93b50206-4d92-47f0-8472-3590bd197ec3" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Biarcs biarcTo and biarcBetween" "frame" #afield/rect [1520 520 460 100] "preamble" "" "code" #afield/file-inline {"path" "93b50206-4d92-47f0-8472-3590bd197ec3_code_.kt" "inline" "\nval a = vec(70, 190)\nval b = vec(350, 90)\n\nval f1 = fline {\n    moveTo(a)\n    // Headings are in radians in the current drawing plane\n    biarcTo(b, startHeading = 0.0f, endHeading = (-1.2f), join = 0.55f, bulge = 0.08f, segments = 40)\n    thickness = 6.0\n    color = vec(1.0, 0.7, 0.2, 0.9)\n}\n\nval f2 = fline {\n    moveTo(a.x, a.y - 60)\n    biarcTo(vec(b.x, b.y - 60), startHeading = 0.2f, endHeading = (-1.0f), join = 0.35f, bulge = -0.10f, segments = 40)\n    thickness = 6.0\n    color = vec(0.4, 1.0, 0.6, 0.9)\n}\n\n// Endpoints as dots\nfun dot(p: Vec2, c: Vec4) = fline {\n    moveTo(p)\n    lineTo(p.x + 0.001, p.y + 0.001)\n    pointed = true\n    pointSize = 4.0\n    stroked = false\n    filled = true\n    color = c\n}\n\nlines(listOf(f1, f2, dot(a, vec(1, 1, 1, 1)), dot(b, vec(1, 1, 1, 1))), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/biarcs_biarcto_and_biarcbetween.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 30, \"column\": 1}, \"position\": {\"lineNumber\": 30, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 30, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "e1876604-8538-4ac4-83d4-9a35fe7a63cc" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Arcs arcTo" "frame" #afield/rect [2020 520 460 100] "preamble" "" "code" #afield/file-inline {"path" "e1876604-8538-4ac4-83d4-9a35fe7a63cc_code_.kt" "inline" "\nval rounded = fline {\n    moveTo(60, 200)\n    lineTo(60, 60)\n    arcTo(vec(60, 60), vec(360, 60), radius = 40, segments = 32)\n    lineTo(360, 200)\n\n    thickness = 6.0\n    color = vec(1.0, 0.9, 0.5, 1.0)\n}\n\nlines(rounded, w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/arcs_arcto.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 11, \"column\": 1}, \"position\": {\"lineNumber\": 11, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 11, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "cab0dcc3-7c5c-4f17-b67c-f3ac48b5532c" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Circular arc through a point circleThroughTo" "frame" #afield/rect [2520 520 460 100] "preamble" "" "code" #afield/file-inline {"path" "cab0dcc3-7c5c-4f17-b67c-f3ac48b5532c_code_.kt" "inline" "\nval f = fline {\n    moveTo(60, 200)\n    circleThroughTo(through = vec(220, 40), end = vec(360, 200), segments = 48)\n\n    thickness = 5.0\n    color = vec(0.6, 0.9, 1.0, 1.0)\n}\n\nlines(f, w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/circular_arc_through_a_point_circlethroughto.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 9, \"column\": 1}, \"position\": {\"lineNumber\": 9, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 9, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "3d6713ff-def5-4d2d-8e89-79da96712006" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Rotate scale reflect shear" "frame" #afield/rect [3020 520 460 100] "preamble" "" "code" #afield/file-inline {"path" "3d6713ff-def5-4d2d-8e89-79da96712006_code_.kt" "inline" "\nval base = fline {\n    moveTo(80, 60)\n    lineTo(320, 60)\n    lineTo(320, 200)\n    lineTo(80, 200)\n    close()\n\n    thickness = 3.0\n    stroked = true\n    filled = true\n    color = vec(1.0, 1.0, 1.0, 0.15)\n}\n\nval rot = base.byRotating2D(angle = 0.4f, center = vec(200f, 130f)).apply {\n    color = vec(1.0, 0.5, 0.2, 0.25)\n}\n\nval shear = base.byShearing2D(shearX = 0.35f, shearY = 0.0f).apply {\n    color = vec(0.4, 1.0, 0.6, 0.25)\n}\n\nlines(listOf(base, rot, shear), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/rotate_scale_reflect_shear.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 22, \"column\": 1}, \"position\": {\"lineNumber\": 22, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 22, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "f2cb5655-5fa1-4609-aef3-3ffa1f394e09" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3D transforms and projections" "frame" #afield/rect [3520 520 460 100] "preamble" "" "code" #afield/file-inline {"path" "f2cb5655-5fa1-4609-aef3-3ffa1f394e09_code_.kt" "inline" "\n// A little 3D helix, projected onto the Z=0 plane.\nval helix = fline {\n    moveTo(60, 120, -80)\n    for (i in 1..160) {\n        val t = i / 160.0\n        val a = t * kotlin.math.PI * 6.0\n        val r = 120.0\n        val x = 210 + r * kotlin.math.cos(a)\n        val y = 130 + r * kotlin.math.sin(a)\n        val z = -80 + 160 * t\n        lineTo(x, y, z)\n    }\n}\n\nval rotated = helix.byRotating3D(angle = 0.7f, axis = vec(0f, 1f, 0f), center = vec(210f, 130f, 0f))\n\nval ortho = rotated.byOrthographicProjecting(planePoint = vec(0f, 0f, 0f), planeNormal = vec(0f, 0f, 1f)).apply {\n    thickness = 3.0\n    color = vec(1.0, 1.0, 1.0, 0.45)\n}\n\nval persp = rotated.byPerspectiveProjecting(cameraPos = vec(210f, 130f, -320f)).apply {\n    thickness = 4.5\n    color = vec(1.0, 0.7, 0.2, 0.9)\n}\n\nlines(listOf(ortho, persp), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/3d_transforms_and_projections.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 27, \"column\": 1}, \"position\": {\"lineNumber\": 27, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 27, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "6038e077-f438-4705-be8a-249b18126927" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Cursor continuous traversal over segments" "frame" #afield/rect [4020 520 460 100] "preamble" "" "code" #afield/file-inline {"path" "6038e077-f438-4705-be8a-249b18126927_code_.kt" "inline" "\nval f = fline {\n    moveTo(50, 180)\n    cubicTo(120, 20, 300, 280, 350, 120)\n    thickness = 4.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nval c = f.cursor(tol = 0.01f)\nval total = c.lengthD()\n\nval dots = mutableListOf<FLine>()\nval ticks = mutableListOf<FLine>()\n\nfun dot(p: Vec3, color: Vec4) = fline {\n    moveTo(p.x, p.y)\n    lineTo(p.x + 0.001, p.y + 0.001)\n    pointed = true\n    pointSize = 2.75\n    stroked = false\n    filled = true\n    this.color = color\n}\n\nval step = 18f\nvar d = 0f\nwhile (d <= total) {\n    c.setD(d)\n    val p = c.position()\n    dots.add(dot(p, vec(1.0, 0.4, 0.3, 1.0)))\n\n    val t = c.tangent()\n    if (t != null && t.lengthSquared() > 1e-9) {\n        val dir = Vec3(t).normalize()\n        val a = Vec3(p).sub(Vec3(dir).mul(8f))\n        val b = Vec3(p).add(Vec3(dir).mul(8f))\n        ticks.add(fline {\n            moveTo(a)\n            lineTo(b)\n            thickness = 1.5\n            color = vec(1.0, 1.0, 1.0, 0.25)\n        })\n    }\n\n    d += step\n}\n\nlines(listOf(f) + ticks + dots, w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/cursor_continuous_traversal_over_segments.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 47, \"column\": 1}, \"position\": {\"lineNumber\": 47, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 47, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "c7f4ae60-28b2-4558-80f8-b0621734c6c7" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "sampleByNumber and sampleByDistance" "frame" #afield/rect [4520 520 460 100] "preamble" "" "code" #afield/file-inline {"path" "c7f4ae60-28b2-4558-80f8-b0621734c6c7_code_.kt" "inline" "\nval f = fline {\n    moveTo(60, 150)\n    cubicTo(120, 20, 300, 260, 360, 120)\n    thickness = 3.0\n    color = vec(0.9, 0.9, 1.0, 1.0)\n}\n\nval dots = polylineFrom(f.sampleByNumber(40).map { it.v2 }).apply {\n    pointed = true\n    pointSize = 2.5\n    stroked = false\n    filled = true\n    color = vec(1.0, 0.5, 0.2, 1.0)\n}\n\nlines(listOf(f, dots), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/samplebynumber_and_samplebydistance.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 16, \"column\": 1}, \"position\": {\"lineNumber\": 16, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 16, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "7cae7ad4-ee76-421e-9887-5bee130d1c17" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Simplify and smooth" "frame" #afield/rect [20 1020 460 100] "preamble" "" "code" #afield/file-inline {"path" "7cae7ad4-ee76-421e-9887-5bee130d1c17_code_.kt" "inline" "\nval noisy = fline {\n    moveTo(20, 130)\n    for (i in 0..90) {\n        val x = 20 + i * 4\n        val y = 130 + 50 * kotlin.math.sin(i * 0.2) + 12 * kotlin.math.sin(i * 1.7)\n        lineTo(x, y)\n    }\n    thickness = 2.0\n    color = vec(1.0, 1.0, 1.0, 0.25)\n}\n\nval smooth = noisy.byGaussianSmoothing(sigma = 2.0f, samples = 120).apply {\n    thickness = 4.0\n    color = vec(0.4, 1.0, 0.6, 1.0)\n}\n\nval simple = smooth.bySimplifying(epsilon = 2.0f).apply {\n    thickness = 6.0\n    color = vec(1.0, 0.4, 0.4, 0.75)\n}\n\nlines(listOf(noisy, smooth, simple), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/simplify_and_smooth.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 22, \"column\": 1}, \"position\": {\"lineNumber\": 22, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 22, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "9afe6869-e344-4bc5-81c2-32ab5c4c4df1" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Cleanup and resampling" "frame" #afield/rect [520 1020 460 100] "preamble" "" "code" #afield/file-inline {"path" "9afe6869-e344-4bc5-81c2-32ab5c4c4df1_code_.kt" "inline" "\nval raw = fline {\n    moveTo(40, 140)\n    for (i in 1..240) {\n        val t = i / 240.0\n        val x = 40 + t * 340\n        val y = 140 + 55 * kotlin.math.sin(t * 7.0 * kotlin.math.PI) + 8 * kotlin.math.sin(t * 60.0)\n        lineTo(x, y)\n    }\n    thickness = 2.0\n    color = vec(1.0, 1.0, 1.0, 0.25)\n}\n\nval chopped = raw.byChoppingSpacing(spacing = 1.5f).apply {\n    thickness = 3.0\n    color = vec(0.7, 0.9, 1.0, 0.75)\n}\n\nval resampled = chopped.byResampling(spacing = 12f).apply {\n    thickness = 4.5\n    color = vec(1.0, 0.6, 0.2, 0.95)\n    pointed = true\n    pointSize = 2.5\n    stroked = true\n    filled = false\n}\n\nlines(listOf(raw, chopped, resampled), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/cleanup_and_resampling.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 27, \"column\": 1}, \"position\": {\"lineNumber\": 27, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 27, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "b7b2a632-b17f-4d1e-8e2f-bee2eddf789a" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Noise utilities make it organic" "frame" #afield/rect [1020 1020 460 100] "preamble" "" "code" #afield/file-inline {"path" "b7b2a632-b17f-4d1e-8e2f-bee2eddf789a_code_.kt" "inline" "\nval base = fline {\n    moveTo(60, 180)\n    cubicTo(120, 20, 260, 280, 360, 120)\n}\n\nval clean = base.copy().apply {\n    thickness = 4.0\n    color = vec(1.0, 1.0, 1.0, 0.30)\n}\n\nval gauss = base.byGaussianNoising(amplitude = 6f, seed = 1L, samples = 140).apply {\n    thickness = 3.0\n    color = vec(1.0, 0.6, 0.2, 0.85)\n}\n\nval oriented = base.byOrientedGaussianNoising(normalAmplitude = 10f, tangentAmplitude = 1.5f, seed = 2L, samples = 140).apply {\n    thickness = 4.5\n    color = vec(0.4, 1.0, 0.6, 0.85)\n}\n\nval perlin = base.byPerlinNoising(amplitude = 12f, frequency = 0.02f, octaves = 4, seed = 3L, samples = 140).apply {\n    thickness = 3.5\n    color = vec(0.7, 0.9, 1.0, 0.85)\n}\n\nlines(listOf(clean, gauss, oriented, perlin), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/noise_utilities_make_it_organic.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 26, \"column\": 1}, \"position\": {\"lineNumber\": 26, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 26, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "d6323243-b174-468e-a2d7-aba36a117e31" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Filtering interpolation Gaussian process EMA One Euro alpha beta filters and gp" "frame" #afield/rect [1520 1020 460 100] "preamble" "" "code" #afield/file-inline {"path" "d6323243-b174-468e-a2d7-aba36a117e31_code_.kt" "inline" "\nval raw = fline {\n    moveTo(40, 140)\n    for (i in 1..240) {\n        val t = i / 240.0\n        val x = 40 + t * 340\n        val y = 140 + 55 * kotlin.math.sin(t * 7.0 * kotlin.math.PI) + 11 * kotlin.math.sin(t * 70.0)\n        lineTo(x, y)\n    }\n}\n\nval showRaw = raw.copy().apply {\n    thickness = 2.0\n    color = vec(1.0, 1.0, 1.0, 0.20)\n}\n\nval ema = raw.byEmaFiltering(alpha = 0.10f, samples = 220).apply {\n    thickness = 3.0\n    color = vec(0.7, 0.9, 1.0, 0.85)\n}\n\nval oneEuro = raw.byOneEuroFiltering(minCutoffHz = 1.0f, beta = 0.05f, dCutoffHz = 1.0f, fpsHint = 60f, samples = 220).apply {\n    thickness = 4.0\n    color = vec(0.4, 1.0, 0.6, 0.85)\n}\n\nval ab = raw.byAlphaBetaFiltering(alpha = 0.25f, beta = 0.08f, fpsHint = 60f, samples = 220).apply {\n    thickness = 3.5\n    color = vec(1.0, 0.6, 0.2, 0.85)\n}\n\nval gpMean = raw.byGaussianProcessInterpolating(\n    trainingSamples = 44,\n    samples = 220,\n    lengthScale = 0.11f,\n    variance = 1f,\n    noise = 0.02f,\n    drawSamples = false\n).apply {\n    thickness = 5.0\n    color = vec(1.0, 0.4, 0.4, 0.70)\n}\n\n// One-Dollar outputs a normalized gesture around the origin; shift it back into view.\nval oneDollar = (raw.byOneDollarFiltering(targetSamples = 64, targetSize = 220f, rotateToZero = true)).apply {\n    thickness = 4.0\n    color = vec(0.8, 0.6, 1.0, 0.85)\n}\nval oneDollarPlaced = oneDollar + vec(210, 140, 0)\n\nlines(listOf(showRaw, ema, oneEuro, ab, gpMean, oneDollarPlaced), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/filtering_interpolation_gaussian_process_ema_one_euro_alpha_beta_filters_and_gp.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 50, \"column\": 1}, \"position\": {\"lineNumber\": 50, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 50, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "d72a941b-a30e-49ce-8ce6-afb0227461f5" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Offsetting parallel curves" "frame" #afield/rect [2020 1020 460 100] "preamble" "" "code" #afield/file-inline {"path" "d72a941b-a30e-49ce-8ce6-afb0227461f5_code_.kt" "inline" "\nval base = fline {\n    moveTo(60, 180)\n    cubicTo(120, 20, 260, 280, 360, 120)\n    thickness = 3.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nval (l, r) = base.byCreatingParallelCurves(distance = 12f, samples = 80)\n\nval left = l.apply { color = vec(0.4, 1.0, 0.6, 1.0); thickness = 3.0 }\nval right = r.apply { color = vec(1.0, 0.4, 0.4, 1.0); thickness = 3.0 }\n\nlines(listOf(base, left, right), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/offsetting_parallel_curves.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 13, \"column\": 1}, \"position\": {\"lineNumber\": 13, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 13, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "206e22be-19aa-48c9-b8bd-ecd43bdf5a46" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Dashing" "frame" #afield/rect [2520 1020 460 100] "preamble" "" "code" #afield/file-inline {"path" "206e22be-19aa-48c9-b8bd-ecd43bdf5a46_code_.kt" "inline" "\nval f = fline {\n    moveTo(50, 180)\n    cubicTo(120, 20, 300, 280, 350, 120)\n    thickness = 6.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nval dashes = f.byDashing(dashLength = 18f, gapLength = 10f).mapIndexed { i, seg ->\n    seg.apply {\n        thickness = 6.0\n        color = if (i % 2 == 0) vec(1.0, 0.7, 0.2, 1.0) else vec(0.4, 1.0, 0.6, 1.0)\n    }\n}\n\nlines(dashes, w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/dashing.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 15, \"column\": 1}, \"position\": {\"lineNumber\": 15, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 15, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "20703fea-65a5-4bae-8152-8e4dc9c3f020" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Intersections" "frame" #afield/rect [3020 1020 460 100] "preamble" "" "code" #afield/file-inline {"path" "20703fea-65a5-4bae-8152-8e4dc9c3f020_code_.kt" "inline" "\nval a = fline {\n    moveTo(60, 60)\n    cubicTo(140, 10, 220, 260, 360, 180)\n    thickness = 4.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nval b = fline {\n    moveTo(60, 200)\n    cubicTo(120, 260, 260, 10, 360, 80)\n    thickness = 4.0\n    color = vec(0.7, 0.9, 1.0, 0.9)\n}\n\nval hits = a.findIntersectionsWith(b, tolerance = 1f)\nval hitDots = polylineFrom(hits.map { it.v2 }).apply {\n    pointed = true\n    pointSize = 5.0\n    stroked = false\n    filled = true\n    color = vec(1.0, 0.5, 0.2, 1.0)\n}\n\nlines(listOf(a, b, hitDots), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/intersections.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 24, \"column\": 1}, \"position\": {\"lineNumber\": 24, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 24, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "1caf3711-be4e-45b0-989f-b3d9c44e6057" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Curvature tangents normals" "frame" #afield/rect [3520 1020 460 100] "preamble" "" "code" #afield/file-inline {"path" "1caf3711-be4e-45b0-989f-b3d9c44e6057_code_.kt" "inline" "\nval f = fline {\n    moveTo(60, 190)\n    cubicTo(120, 20, 260, 280, 360, 120)\n    thickness = 4.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nval tangents = f.byCreatingTangentLines(samples = 18, length = 22f).onEach {\n    it.thickness = 1.5\n    it.color = vec(1.0, 1.0, 1.0, 0.20)\n}\n\nval normals = f.byCreatingNormalLines(samples = 18, length = 18f).onEach {\n    it.thickness = 1.5\n    it.color = vec(0.4, 1.0, 0.6, 0.22)\n}\n\nval corners = polylineFrom(f.findHighCurvaturePoints(threshold = 0.03f, samples = 120).map { it.v2 }).apply {\n    pointed = true\n    pointSize = 3.5\n    stroked = false\n    filled = true\n    color = vec(1.0, 0.5, 0.2, 1.0)\n}\n\nlines(listOf(f) + tangents + normals + listOf(corners), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/curvature_tangents_normals.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 26, \"column\": 1}, \"position\": {\"lineNumber\": 26, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 26, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "9f21cb7e-3673-4528-ac60-79ca60610ddd" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Convex hull inflections" "frame" #afield/rect [4020 1020 460 100] "preamble" "" "code" #afield/file-inline {"path" "9f21cb7e-3673-4528-ac60-79ca60610ddd_code_.kt" "inline" "\nval scribble = fline {\n    moveTo(60, 160)\n    cubicTo(120, 10, 160, 280, 220, 120)\n    cubicTo(280, -10, 320, 280, 360, 140)\n    thickness = 3.0\n    color = vec(1.0, 1.0, 1.0, 0.6)\n}\n\nval hull = scribble.byConvexHull2D().apply {\n    filled = true\n    stroked = true\n    thickness = 2.0\n    color = vec(0.4, 1.0, 0.6, 0.20)\n}\n\nval pieces = scribble.bySplittingAtInflections().mapIndexed { i, p ->\n    p.apply {\n        thickness = 4.0\n        color = if (i % 2 == 0) vec(1.0, 0.5, 0.2, 0.65) else vec(0.7, 0.9, 1.0, 0.65)\n    }\n}\n\nlines(listOf(hull, scribble) + pieces, w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/convex_hull_inflections.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 23, \"column\": 1}, \"position\": {\"lineNumber\": 23, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 23, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "b3260ddd-5379-438b-9e95-f5dbc8cdad7c" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Parameterized operations vary along the curve" "frame" #afield/rect [4520 1020 460 100] "preamble" "" "code" #afield/file-inline {"path" "b3260ddd-5379-438b-9e95-f5dbc8cdad7c_code_.kt" "inline" "\nval base = fline {\n    moveTo(60, 180)\n    cubicTo(120, 20, 260, 280, 360, 120)\n}\n\nval clean = base.copy().apply {\n    thickness = 4.0\n    color = vec(1.0, 1.0, 1.0, 0.35)\n}\n\nval wobble = base.byOffsettingParameterized(\n    distanceFunc = SineParameter(amplitude = 22f, frequency = 2.0f, phase = 0f, offset = 0f),\n    samples = 160\n).apply {\n    thickness = 3.0\n    color = vec(0.7, 0.9, 1.0, 0.85)\n}\n\nval quietPoint = vec(110, 70, 0)\nval amp = DistanceParameter(point = quietPoint, minValue = 0f, maxValue = 14f, maxDistance = 260f)\nval noisy = base.byNoisingParameterized(amplitudeFunc = amp, seed = 9L, samples = 160).apply {\n    thickness = 4.5\n    color = vec(1.0, 0.6, 0.2, 0.85)\n}\n\nval qp = fline {\n    moveTo(quietPoint.x, quietPoint.y)\n    lineTo(quietPoint.x + 0.001, quietPoint.y + 0.001)\n    pointed = true\n    pointSize = 4.5\n    stroked = false\n    filled = true\n    color = vec(0.4, 1.0, 0.6, 1.0)\n}\n\nlines(listOf(clean, wobble, noisy, qp), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/parameterized_operations_vary_along_the_curve.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 36, \"column\": 1}, \"position\": {\"lineNumber\": 36, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 36, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "c6452942-fe18-4766-8d1d-d07250303499" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Curve combination utilities" "frame" #afield/rect [20 1520 460 100] "preamble" "" "code" #afield/file-inline {"path" "c6452942-fe18-4766-8d1d-d07250303499_code_.kt" "inline" "\n// A smooth target curve (a circle-ish polyline)\nval center = vec(210.0, 130.0)\nval radius = 95.0\n\nval circle = fline {\n    for (i in 0..140) {\n        val a = (i / 140.0) * kotlin.math.PI * 2.0\n        val p = vec(center.x + radius * kotlin.math.cos(a), center.y + radius * kotlin.math.sin(a))\n        if (i == 0) moveTo(p) else lineTo(p)\n    }\n    close()\n    thickness = 3.0\n    color = vec(1.0, 1.0, 1.0, 0.35)\n}\n\n// A \u201cmessy\u201d version of it\nval messy = circle.byPerlinNoising(amplitude = 26f, frequency = 0.03f, octaves = 4, seed = 10L, samples = 180).apply {\n    thickness = 2.5\n    color = vec(1.0, 0.6, 0.2, 0.65)\n}\n\n// Project the messy samples back onto the circle\nval projected = messy.byProjectingOnto(circle, samples = 180).apply {\n    thickness = 4.0\n    color = vec(0.4, 1.0, 0.6, 0.85)\n}\n\nlines(listOf(circle, messy, projected), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/curve_combination_utilities.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 28, \"column\": 1}, \"position\": {\"lineNumber\": 28, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 28, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "d54a156c-993e-4eb8-a797-7814142db0d4" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Reverse blend extract" "frame" #afield/rect [520 1520 460 100] "preamble" "" "code" #afield/file-inline {"path" "d54a156c-993e-4eb8-a797-7814142db0d4_code_.kt" "inline" "\nval a = fline {\n    moveTo(60, 190)\n    cubicTo(120, 20, 260, 280, 360, 120)\n    thickness = 4.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nval b = a.byReversing().apply { color = vec(1.0, 0.4, 0.4, 0.65) }\n\nval mid = a.byBlendingWith(b, t = 0.5f).apply {\n    thickness = 6.0\n    color = vec(0.4, 1.0, 0.6, 0.7)\n}\n\nval snippet = a.byExtracting(tStart = 0.8f, tEnd = 1.9f).apply {\n    thickness = 8.0\n    color = vec(1.0, 0.7, 0.2, 0.8)\n}\n\nlines(listOf(a, b, mid, snippet), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/reverse_blend_extract.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 20, \"column\": 1}, \"position\": {\"lineNumber\": 20, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 20, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "f1fc1b70-6752-4189-bac9-99047f95fe99" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Euler spiral in 3D clothoid ish connection" "frame" #afield/rect [1020 1520 460 100] "preamble" "" "code" #afield/file-inline {"path" "f1fc1b70-6752-4189-bac9-99047f95fe99_code_.kt" "inline" "\nval start = vec(60, 180, 0)\nval end = vec(360, 120, 0)\n\nval f = fline {\n    moveTo(start)\n    // Start direction points right; end direction points up-left.\n    eulerSpiralTo(\n        endPoint = end,\n        startDirection = vec(1f, 0f, 0f),\n        endDirection = vec(-0.2f, -1f, 0f),\n        samples = 160,\n        iterations = 6\n    )\n    thickness = 5.0\n    color = vec(1.0, 0.7, 0.2, 1.0)\n}\n\nval endDirs = listOf(\n    seg(start.v2, (start + vec(60, 0, 0)).v2, pointed = false, color = vec(1.0, 1.0, 1.0, 0.25)).apply { thickness = 2.0 },\n    seg(end.v2, (end + vec(-15, -60, 0)).v2, pointed = false, color = vec(1.0, 1.0, 1.0, 0.25)).apply { thickness = 2.0 },\n)\n\nlines(endDirs + listOf(f), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/euler_spiral_in_3d_clothoid_ish_connection.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 23, \"column\": 1}, \"position\": {\"lineNumber\": 23, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 23, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "e1733c81-8ee8-4257-a970-732084fa83b4" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Boolean ops 2D" "frame" #afield/rect [1520 1520 460 100] "preamble" "" "code" #afield/file-inline {"path" "e1733c81-8ee8-4257-a970-732084fa83b4_code_.kt" "inline" "\nval a = fline {\n    moveTo(80, 80); lineTo(260, 80); lineTo(260, 220); lineTo(80, 220); close()\n    filled = true\n    stroked = true\n    thickness = 2.0\n    color = vec(1.0, 1.0, 1.0, 0.20)\n}\n\nval b = fline {\n    moveTo(170, 40); lineTo(340, 140); lineTo(170, 240); lineTo(40, 140); close()\n    filled = true\n    stroked = true\n    thickness = 2.0\n    color = vec(1.0, 1.0, 1.0, 0.20)\n}\n\nval u = a.byUnionWith(b).apply { color = vec(0.4, 1.0, 0.6, 0.40); filled = true; stroked = true; thickness = 3.0 }\nval i = a.byIntersectionWith(b).apply { color = vec(1.0, 0.5, 0.2, 0.55); filled = true; stroked = true; thickness = 3.0 }\n\nlines(listOf(a, b, u, i), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/boolean_ops_2d.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 20, \"column\": 1}, \"position\": {\"lineNumber\": 20, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 20, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "f827a539-c082-48fa-8143-09745d1a6fb8" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Closest point" "frame" #afield/rect [2020 1520 460 100] "preamble" "" "code" #afield/file-inline {"path" "f827a539-c082-48fa-8143-09745d1a6fb8_code_.kt" "inline" "\nval curve = fline {\n    moveTo(50, 180)\n    cubicTo(120, 20, 300, 280, 350, 120)\n    thickness = 5.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nval query = vec(260, 60, 0)\nval (closest, _) = curve.closestPoint(query)\n\nval marker = polylineFrom(listOf(query.v2, closest.v2)).apply {\n    thickness = 2.0\n    color = vec(1.0, 0.4, 0.4, 1.0)\n    pointed = true\n    pointSize = 3.0\n}\n\nlines(listOf(curve, marker), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/closest_point.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 18, \"column\": 1}, \"position\": {\"lineNumber\": 18, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 18, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "daaee237-69e1-4577-896b-0097092cb1b2" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Containment and area" "frame" #afield/rect [2520 1520 460 100] "preamble" "" "code" #afield/file-inline {"path" "daaee237-69e1-4577-896b-0097092cb1b2_code_.kt" "inline" "\nval poly = fline {\n    moveTo(60, 60)\n    lineTo(360, 80)\n    lineTo(320, 220)\n    lineTo(80, 200)\n    close()\n\n    filled = true\n    stroked = true\n    thickness = 3.0\n    color = vec(0.7, 0.9, 1.0, 0.25)\n}\n\nval c = poly.centroid2D()\nval center = fline {\n    moveTo(c.x, c.y)\n    lineTo(c.x + 0.001, c.y + 0.001) // tiny segment so it shows\n    pointed = true\n    pointSize = 5.0\n    stroked = false\n    filled = true\n    color = vec(1.0, 0.5, 0.2, 1.0)\n}\n\nlines(listOf(poly, center), w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/containment_and_area.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 25, \"column\": 1}, \"position\": {\"lineNumber\": 25, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 25, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "4885b180-eee7-470c-bd55-b1ba18ad2ecc" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Java2D bridge advanced but incredibly useful" "frame" #afield/rect [3020 1520 460 100] "preamble" "" "code" #afield/file-inline {"path" "4885b180-eee7-470c-bd55-b1ba18ad2ecc_code_.kt" "inline" "\nimport field.graphics.FLinesAndJavaShapes\nimport java.awt.geom.Ellipse2D\n\nval circleShape = Ellipse2D.Double(80.0, 60.0, 220.0, 220.0)\nval circle = FLinesAndJavaShapes.javaShapeToFLine(circleShape).apply {\n    thickness = 5.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nval diag = fline {\n    moveTo(40, 260)\n    lineTo(380, 40)\n    thickness = 3.0\n    color = vec(1.0, 0.4, 0.4, 1.0)\n}\n\nval hits = FLinesAndJavaShapes.intersect(circle, diag)\nval hitPts = polylineFrom(hits.map { it.v2 }).apply {\n    pointed = true\n    pointSize = 4.0\n    stroked = false\n    filled = true\n    color = vec(0.4, 1.0, 0.6, 1.0)\n}\n\nlines(listOf(circle, diag, hitPts), w = 420.0, h = 320.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/java2d_bridge_advanced_but_incredibly_useful.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 26, \"column\": 1}, \"position\": {\"lineNumber\": 26, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 26, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
 {"id" "de5bdc43-4b57-4f3d-bea3-9b61ab079bcf" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Bonus the tiny path mini language data format parameters" "frame" #afield/rect [3520 1520 460 100] "preamble" "" "code" #afield/file-inline {"path" "de5bdc43-4b57-4f3d-bea3-9b61ab079bcf_code_.kt" "inline" "\n// A little \"flower\" made from repeated cubic petals.\nval f = fline {\n    data(\n        format = \"m c+ z\",\n        parameters = listOf(\n            vec(200, 130, 0),\n\n            // Each repetition of `c` consumes 3 points: c1, c2, end.\n            vec(260, 40, 0), vec(340, 80, 0), vec(300, 130, 0),\n            vec(340, 180, 0), vec(260, 220, 0), vec(200, 190, 0),\n            vec(140, 220, 0), vec(60, 180, 0), vec(100, 130, 0),\n            vec(60, 80, 0),  vec(140, 40, 0),  vec(200, 130, 0),\n        )\n    )\n\n    filled = true\n    stroked = true\n    thickness = 3.0\n    color = vec(1.0, 0.7, 0.2, 0.35)\n}\n\nlines(f, w = 420.0, h = 260.0, fitToSize = true)\n\n\n\ndisplayOpen(\"lines\")\n\nrunBlocking {\n    screenshot(\"/Users/marc/temp/jvm-js-fullstack/public/docs/assets/bonus_the_tiny_path_mini_language_data_format_parameters.png\")\n}\n"} "code_editorState" "{\"cursorState\": [{\"inSelectionMode\": false, \"selectionStart\": {\"lineNumber\": 22, \"column\": 1}, \"position\": {\"lineNumber\": 22, \"column\": 1}}], \"viewState\": {\"scrollLeft\": 0, \"firstPosition\": {\"lineNumber\": 1, \"column\": 1}, \"firstPositionDeltaTop\": 0}, \"contributionsState\": {\"editor.contrib.folding\": {\"lineCount\": 22, \"provider\": \"indent\", \"foldedImports\": false}, \"editor.contrib.wordHighlighter\": false}}" "nested" #{}}}
