module.InputBuffer.mapAndWrite  {\n    this.clear()\n    for (n in 0 until numVec4) {\n        this.put(Math.random().toFloat()*8)\n        this.put(Math.random().toFloat()*8)\n        this.put((Math.random().toFloat()-0.5)*8)\n        this.put((Math.random().toFloat()-0.5)*8)\n    }\n    this.clear()\n}\n\nframes {\n    while(true) {\n        fr++\n\n         module.InputBuffer.mapAndRead {\n            var s = \"${fr}:: \"\n            this.clear()\n            for(n in 0 until 2)\n                s+=this.get(100+n).toString()+\" \"\n            _print(s)\n        }   \n\n        frame()\n    }    \n}\n"} "preamble" "import afield.four.buffers.VulkanBuffer\nimport afield.four.buffers.*\nimport afield.four.modules.*\nimport afield.four.Renderer\nval ComputeModulePointer.InputBuffer by ComputeMesh.FromUniform()\nvar Box.buffer by Inheritance<VulkanBuffer>()\nval Once.buffer by Onceing<VulkanBuffer>()\nval ComputeModulePointer.DrawingControl by ComputeMesh.FromUniform()\nval ComputeModulePointer.VertexData by ComputeMesh.FromUniform()\nval Once.renderer by Onceing<Renderer>()\nvar Box.renderer by Inheritance<Renderer>()\nval Once.window by Onceing<Window>()\nvar Box.window by Inheritance<Window>()" "vertex" #afield/file-inline {"path" "fc92e0e0-e7da-42d6-90d5-85c2234ffa39_vertex_.glsl" "inline" ""} "compute" #afield/file-inline {"path" "fc92e0e0-e7da-42d6-90d5-85c2234ffa39_compute_.glsl" "inline" "#version 450\n#extension GL_KHR_shader_subgroup_ballot: enable\n#extension GL_KHR_shader_subgroup_arithmetic: enable\n\nlayout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;\n\nlayout(set=0, binding = 0) buffer InputBuffer {\n    vec4 dat[];\n};\n\nlayout(set=0, binding = 1) buffer DrawingControl {\n    uint at;\n};\n\nlayout(set=0, binding = 2) buffer VertexData {\n    vec4 vertexData[];\n};\n\nvoid main() {\n    uint idx = gl_GlobalInvocationID.x;\n    float timeStep = 0.01;\n    \n    dat[idx].xy = dat[idx].zw * timeStep;\n    float l = length(dat[idx].zw);\n    float targetLength = sin(dat[idx].w*8+dat[idx].x*40-dat[idx].y*21);\n    float alpha = 0.9999;\n    if (l>0) {\n        l = l*alpha + (1-alpha)*targetLength;\n         dat[idx].zw = normalize(dat[idx].zw)*l;\n    }\n\n\n    uvec4 bits = subgroupBallot(true);\n    uint num = subgroupBallotBitCount(bits);\n    bool leader = subgroupElect();\n    uint now_at = 0;\n    if (leader) {\n        now_at = atomicAdd(at, num);\n    }\n    uint base = subgroupMax(now_at) + gl_SubgroupInvocationID;\n    if (base<2560000 && base>=0)\n        vertexData[base] = dat[idx];\n}"} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":true,\"selectionStart\":{\"lineNumber\":20,\"column\":3},\"position\":{\"lineNumber\":19,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":62,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "compute_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":43,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "metadata" #afield/file-inline {"path" "fc92e0e0-e7da-42d6-90d5-85c2234ffa39_metadata_.yaml" "inline" ""} "vertex_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":1,\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "preamble_editorState" "{\"cursor