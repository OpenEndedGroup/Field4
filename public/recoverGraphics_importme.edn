c.vertexBuffer.vertexData[base + 11]\n    );\n\n    if (data.useVertexColor == 0u) {\n        color = vec4(1.0);\n    }\n\n    vec4 viewPos =  data.proj * data.modelView*vec4(pos, 1.0);\n\n    mat3 mv3 = mat3(data.modelView);\n    vec3 normalVS = normalize(mv3 * normal);\n\n    vViewPos = viewPos.xyz;\n    vNormalVS = normalVS;\n    vUV = uv;\n    vColor = color * data.materialBaseColor;\n\n    gl_Position = viewPos;\n}"} "vertex_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":80,\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "fragment_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":9,\"column\":11},\"position\":{\"lineNumber\":9,\"column\":11}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":10,\"foldedImports\":false},\"editor.contrib.wordHighlighter\":true}}" "preamble_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":21,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "autorun" false}} {"id" "c1046457-6538-4bb2-84ab-b3ba06f0d557" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "6aab6f41-c2df-4d65-8032-2e9aee73b533" #afield/box "3d2ff86c-6977-498e-87f6-322278b7bbbb" #afield/box "113bce66-b253-4507-83cd-bcc442352ade"} "name" "Downsweep" "preamb