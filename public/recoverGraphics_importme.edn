eld/rect [-580.7578125 160.98828125 96.0 96.0] "code" #afield/file-inline {"path" "459b9c54-6363-4c27-a033-2f145e017022_code_.kt" "inline" "import afield.four.texture.*\n\nprop<HasImageView>(bbc) = target.thisImageView\n\nvar module = moduleHere()\nvar mesh = Mesh()\nmodule += \"mainMesh\" to mesh\nrenderer += \"boo\" to module\n\nval camera = Camera()\nmesh.p = camera.p\nmesh.m = camera.m\n\nvar kc = KeyCamera(camera=camera)\nmesh.set(4, 2) {\n    val z = 0.0\n    pos.add(-1,-1, z,\n            1.0,-1.0,z, \n            1,1,z, \n            -1.0, 1, z)\n    tc.add(0,0, 1,0, 1,1, 0,1)\n    tri.add(0,1,2)\n    tri.add(0,2,3)\n}\n"} "preamble" "import afield.four.buffers.*\nimport afield.four.modules.*\nimport java.nio.*\nimport afield.four.Renderer\nimport afield.four.targets.PingPongRenderToTexture\nimport afield.four.texture.*\nvar Box.target by Inheritance<PingPongRenderToTexture>()\nval Once.target by Onceing<PingPongRenderToTexture>()\nvar Box.otherView by Inheritance<HasImageView>()\nval Once.otherView by Onceing<HasImageView>()\nval Mesh.pos by FromInput()\nval Mesh.tc by FromInput()\nvar Structure.p by Structure.FromStructure<Any>()\nvar Mesh.p by Mesh.BoundFromStructure<org.joml.Matrix4f>()\nvar Structure.m by Structure.FromStructure<Any>()\nvar Mesh.m by Mesh.BoundFromStructure<org.joml.Matrix4f>()\nvar Structure.finalColor by Structure.FromStructure<Any>()\nvar Mesh.finalColor by Mesh.BoundFromStructure<org.joml.Vector4f>()\nvar Box.window by Inheritance<Window>()\nval Once.window by Onceing<Window>()\nvar Box.renderer by Inheritance<Renderer>()\nval Once.renderer by Onceing<Renderer>()\nvar Box.bbc by Inheritance<HasImageView>()\nval Once.bbc by Onceing<HasImageView>()\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var pos : FloatBuffer; lateinit var tc : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"tc\") { tc = this ; mesh.write(\"pos\") { pos = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } } ;            };         }" "fragment" #afield/file-inline {"path" "459b9c54-6363-4c27-a033-2f145e017022_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 1) in vec2 ftc;\n\nlayout(set=0, binding = 0) uniform sampler2D bbc;\n\nvoid main()\n{\n    vec4 c = texture(bbc, ftc.yx);\n    uFragColor = vec4(c.rgb, 1.0);\n} "} "vertex" #afield/file-inline {"path" "459b9c54-6363-4c27-a033-2f145e017022_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\nlayout (location = 1) in vec2 tc;\n\nlayout (location = 1) out vec2 ftc;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n    ftc = tc;\n}"} "compute" #afield/file-inline {"path" "459b9c54-6363-4c27-a033-2f145e017022_compute_.glsl" "inline" ""} "metadata" #afield/file-inline {"path" "459b9c54-6363-4c27-a033-2f145e017022_metadata_.yaml" "inline" ""} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":7,\"column\":23},\"position\":{\"lineNumber\":7,\"column\":23}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":25,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":true}}" "preamble_editorState" "{\"cursorState\":[{\"inSelectionMode\":true,\"selectionStart\":{\"lineNumber\":26,\"column\":1},\"position\":{\"lineNumber\":25,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":26,\"provider\":\"indent\",