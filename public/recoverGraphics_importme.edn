\n* `p` is the _projection matrix_ and it converts from the 3d space of the world to the 2d space of the screen in ways that follow the laws of perspective (in particular, things further away are proprotionally smaller)\n\n* `m` is the _model_view` matrix_ and this accounts for the rotation and translation of the camera _and_ the model\n\n*/\nval camera = Camera()\nm.p =  camera.p  \nm.m =  camera.m \n\n/**\nhere's our triangle, written using vertex attributes. `3` vertices and `1` triangle\n*/\nm.set(3, 1) {\n    val z = 0.0\n    pos.add(0,0,0+z, 1.0,0.1,z, 1,1,z)\n    tri.add(0,1,2)\n}\n\n\n// and here's our handy keyboard control over the camera.\nvar kc = KeyCamera(camera=camera)\n\n"} "preamble" "import afield.four.Renderer\nimport afield.four.buffers.*\nimport afield.four.modules.*\nimport java.nio.*\nval Once.renderer by Onceing<Renderer>()\nvar Box.renderer by Inheritance<Renderer>()\nval Once.window by Onceing<Window>()\nvar Box.window by Inheritance<Window>()\nval Mesh.pos by FromInput()\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var pos : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"pos\") { pos = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } ;            };         }\nvar Structure.p by Structure.FromStructure<Any>()\nvar Mesh.p by Mesh.BoundFromStructure<org.joml.Matrix4f>()\nvar Structure.m by Structure.FromStructure<Any>()\nvar Mesh.m by Mesh.BoundFromStructure<org.joml.Matrix4f>()" "fragment" #afield/file-inline {"path" "954d64d5-ee3f-4cb7-8ac7-1e2cce8a9073_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nvoid main()\n{\n    uFragColor = vec4(1.0, 0.8, 0.4, 1.0);\n}"} "vertex" #afield/file-inline {"path" "954d64d5-ee3f-4cb7-8ac7-