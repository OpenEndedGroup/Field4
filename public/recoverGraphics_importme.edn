or4f>()\nval Mesh.col by FromInput()\nval Mesh.pos by FromInput()\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var col : FloatBuffer; lateinit var pos : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int, builder : MappedStructure.() -> Unit) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"pos\") { pos = this ; mesh.write(\"col\") { col = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } } ;            };         }\nval Once.renderer by Onceing<Renderer>()\nvar Box.renderer by Inheritance<Renderer>()\nval Once.window by Onceing<Window>()\nvar Box.window by Inheritance<Window>()" "fragment" #afield/file-inline {"path" "42056e8d-ec8b-4bf8-b84a-1cd1d8524510_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 0) in vec4 fcol;\n\n{{ pc.dec }}\nvoid main()\n{\n    loadRegs();\n    \n    uFragColor = vec4(a());\n}"} "vertex" #afield/file-inline {"path" "42056e8d-ec8b-4bf8-b84a-1cd1d8524510_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\n// layout(push_constant) uniform matrices {\n//     mat4 projectionMatrix;\n//     mat4 modelMatrix;\n// } push_constants;\n\nvoid main()\n{\n    // gl_Position = push_constants.projectionMatrix * push_constants.modelMatrix * vec4(pos, 1);\n\n    fcol = col;\n    gl_Position = vec4(pos, 1);\n}"} "metadata" #afield/file-inline {"path" "42056e8d-ec8b-4bf8-b84a-1cd1d8524510_metadata_.yaml" "inline" ""} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":29,\"column\":1},\"position\":{\"lineNumber\":29,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contri