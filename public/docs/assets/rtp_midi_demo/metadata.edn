{"version" 2 "boxes" [{"id" "rtpm-session" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1. Open the session (run first)" "frame" #afield/rect [60.0 60.0 380.0 70.0] "code" #afield/file-inline {"path" "rtpm-session_code_.kt" "inline" "import afield.io.midi.rtp.*\n\n// Open an RTP-MIDI network session called \"Field\" on UDP 5004/5005 and announce it over Bonjour.\n// In macOS Audio MIDI Setup -> MIDI Studio -> Network, \"Field\" now appears in the Directory:\n// select it and press Connect. An iPad app with network MIDI, or rtpMIDI on Windows, lists it too.\nval midi = rtpMidi(\"Field\")\n\n// Each note that arrives runs this, on Field's main loop.\nmidi.onNote { pitch, velocity, channel ->\n    if (velocity > 0) markdown(\"last note\", \"note **$pitch** velocity $velocity on channel ${channel + 1}\")\n}\nmidi.onControl { cc, value, channel -> markdown(\"last control\", \"CC $cc = $value on channel ${channel + 1}\") }\n\nmarkdown(\"session\", \"Session **${midi.session.name}** on port ${midi.port}; ${midi.peers.size} peer(s).\")\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "rtpm-peer" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2. A peer joins (run)" "frame" #afield/rect [520.0 60.0 380.0 70.0] "code" #afield/file-inline {"path" "rtpm-peer_code_.kt" "inline" "import afield.io.midi.rtp.*\n\n// A second session in the same Field, so the demo works with nothing else on the network.\n// It invites the \"Field\" session from box 1 the way a Mac or an iPad would.\nval other = rtpMidi(\"Field peer\", port = 5006, advertise = false)\nother.invite(\"127.0.0.1\", 5004)\n\n// The invitation and the first clock exchange take a few milliseconds.\nThread.sleep(500)\nmarkdown(\"peers\", other.peers.joinToString(\"\\n\") { p ->\n    val stats = p.roundTripStatsMs?.let { (lo, mean, hi) -> \"round trip %.2f / %.2f / %.2f ms (min/mean/max)\".format(lo, mean, hi) } ?: \"not synced yet\"\n    \"- **${p.name}** at ${p.address.hostAddress}:${p.controlPort}, ${p.state.name.lowercase()}, $stats\"\n})\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "rtpm-play" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3. Play into it (run)" "frame" #afield/rect [980.0 60.0 380.0 70.0] "code" #afield/file-inline {"path" "rtpm-play_code_.kt" "inline" "import afield.io.midi.rtp.*\n\n// Play an arpeggio from the peer session into the \"Field\" session; box 1 shows each note as it\n// arrives. Pointed at a Mac's session instead, these notes reach any DAW listening to it.\nval other = rtpMidi(\"Field peer\", port = 5006, advertise = false)\nfor (pitch in listOf(60, 64, 67, 72)) {\n    other.noteOn(pitch, 90)\n    Thread.sleep(150)\n    other.noteOff(pitch)\n}\nother.controlChange(74, 100)\nThread.sleep(100)   // let the last packets arrive before counting\n\nval field = rtpMidi(\"Field\")\nmarkdown(\"received\", \"box 1's session has received ${field.messageCount} messages; held notes: ${field.held.size}\")\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"name" "root" "children" #{#afield/box "rtpm-session" #afield/box "rtpm-peer" #afield/box "rtpm-play"} "parents" #{#afield/box "metaroot"} "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}
