{"version" 2 "boxes" [{"id" "rhino_path_trace" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "rhino_trace_renderer"} "name" "a .3dm, path traced" "_tombstone" false "frame" #afield/rect [320.0 140.0 280.0 70.0] "code" #afield/file-inline {"path" "rhino_path_trace_code_.kt" "inline" "import afield.geometry.rhino.*\nimport afield.graphics.scene.fabricated.PathTraceEnvironment\nimport afield.graphics.scene.fabricated.PathTraceMaterial\nimport afield.graphics.scene.fabricated.PathTraceScene\nimport afield.graphics.scene.fabricated.PathTracingRenderer\nimport afield.graphics.vulkan.util.Camera\nimport java.io.File\n\nprop<PathTracingRenderer>(tracer)\n\n// Start here when changing render cost, lighting or convergence.\nval samplesPerFrame = 2\nval maxBounces = 6\nval exposure = 1.3f\nval environmentRotation = 2.1f\nval targetSamples = 600\n\n// The reader is an optional native library; this says how to build it when it is absent.\ncheck(Rhino3dm.isAvailable) { Rhino3dm.describe() }\n\n// ---- the file ------------------------------------------------------------------\n// Swap this for Rhino3dm.load(\"~/Downloads/model.3dm\") to trace your own.\nval dir = java.nio.file.Files.createTempDirectory(\"rhino-trace\").toFile()\nval model = Rhino3dm.load(Rhino3dm.writeNurbsSample(File(dir, \"save_small.3dm\")))\ndir.deleteRecursively()\nprintln(model)\n\n// ---- the scene -----------------------------------------------------------------\n// The fixture is in model units of about 50 across; a twentieth puts it near 2.5.\nval scene = PathTraceScene()\nval added = scene.rhino(model, scale = 0.05f)\nprintln(\"scene: ${added.objects} objects, ${added.triangleCount} triangles, ${added.degenerateCount} dropped\")\nprintln(\"       ${added.materials.values.toSet().size} materials, one per display colour\")\nprintln(\"model.mesh(): ${model.mesh().triangleCount} triangles\")\n\nval floor = scene.material(PathTraceMaterial.plastic(0.55f, 0.56f, 0.58f, 0.55f))\nval low = added.boundsMin.y - 0.01f\nval reach = 8f\nscene.quad(\n    Vector3f(-reach, low, -reach),\n    Vector3f(reach, low, -reach),\n    Vector3f(reach, low, reach),\n    Vector3f(-reach, low, reach),\n    floor,\n)\n\n// ---- the render ----------------------------------------------------------------\nval environment = PathTraceEnvironment.fromFile(\n    File(\"public/docs/assets/fabricate_demo/venice_sunset_1k.exr\").absolutePath,\n)\nval c = added.center\nval span = maxOf(added.size.x, added.size.z)\nval camera = Camera(renderer).also {\n    it.at.set(c.x + span * 0.55f, c.y + span * 0.55f, c.z + span * 1.25f)\n    it.target.set(c.x, c.y - added.size.y * 0.15f, c.z)\n    it.p.fov = 0.6\n}\n// 1000 x 614 is the window's own aspect, so the blit fills it rather than letterboxing.\ntracer = PathTracingRenderer(renderer, scene, environment, 1000, 614, camera).install()\ntracer.samplesPerFrame = samplesPerFrame\ntracer.maxBounces = maxBounces\ntracer.exposure = exposure\ntracer.environmentRotation = environmentRotation\ntracer.blitToScreen()\nprintln(\"${tracer.backend}: ${tracer.triangleCount} triangles\")\nframes {\n    while (tracer.samples < targetSamples) {\n        frame()\n    }\n    println(\"rhino trace converged: ${tracer.samples} samples\")\n}\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "rhino_trace_renderer" "properties" {"children" #{#afield/box "rhino_path_trace"} "parents" #{#afield/box "root"} "name" "path tracing renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 220.0 60.0] "code" #afield/file-inline {"path" "rhino_trace_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nonce.renderer {\n    window = Window(\"Field · Rhino to path tracer\")\n    Renderer(window)\n}\nstart(renderer::run)\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "rhino_path_trace" #afield/box "rhino_trace_renderer"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isPostScriptRoot" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}