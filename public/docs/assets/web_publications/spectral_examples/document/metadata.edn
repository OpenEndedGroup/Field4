{"version" 2 "boxes" [{"id" "spectral_filter_chains" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "filter chains as layered curves" "_tombstone" false "frame" #afield/rect [520.0 80.0 300.0 100.0] "code" #afield/file-inline {"path" "spectral_filter_chains_code_.kt" "inline" "val raw = mutableListOf<Float>()\nval smooth = mutableListOf<Float>()\nval filtered = mutableListOf<Float>()\n\nval ema = EMAFilter(alpha = 0.08f)\nval oneEuro = OneEuroFilter(minCutoff = 1.0f, beta = 0.02f, sampleRate = 120f)\nval band = BandPassFilter(frequency = 5f, sampleRate = 120f, q = 0.8f)\n\nfor (i in 0 until 420) {\n    val t = i / 120f\n    val signal =\n        (sin(2.0 * PI * 1.2 * t).toFloat() * 0.7f +\n            sin(2.0 * PI * 4.7 * t + 0.3).toFloat() * 0.22f +\n            (-0.12f + random().toFloat() * 0.24f))\n    raw += signal\n    val s = oneEuro(ema(signal))\n    smooth += s\n    filtered += band(s)\n}\n\n// One call puts all three streams on one axis — raw, the smoothed chain, and the band-passed\n// component each get their own trace (dark theme + cyan/orange palette applied).\nshowSignals(\n    \"raw\" to raw,\n    \"EMA + One-Euro (smoothed)\" to smooth,\n    \"band-pass (5 Hz)\" to filtered,\n    channel = \"main\",\n    xTitle = \"sample\",\n)\n"} "preamble" "" "nested" #{}}} {"id" "spectral_one_spectrum" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "one spectrum (chirp + tones)" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 100.0] "code" #afield/file-inline {"path" "spectral_one_spectrum_code_.kt" "inline" "// Synthesise a rising linear chirp + two steady tones, FFT it, draw the one-sided spectrum.\nval sampleRate = 8000.0\nval n = 2048\nval f0 = 300.0\nval f1 = 3000.0\nval dur = n / sampleRate\nval k = (f1 - f0) / dur\nval signal =\n    DoubleArray(n) { i ->\n        val t = i / sampleRate\n        0.9 * sin(2.0 * PI * (f0 * t + 0.5 * k * t * t)) +\n            0.4 * sin(2.0 * PI * 700.0 * t) +\n            0.3 * sin(2.0 * PI * 1800.0 * t)\n    }\n\nval spec = fft(signal, WindowType.HANN, sampleRate)\nval mag = spec.magnitudeOneSided()\nval freqs = spec.frequencies()\nval centroid = spec.centroid()\nval rolloff = spec.rolloff(0.85)\nval peak = spec.peakFrequency()\n\n// One call puts the magnitude curve on screen vs real Hz, centroid + rolloff as dashed marks.\nshowSignals(\n    \"magnitude\" to mag.toList(),\n    x = freqs.toList(),\n    channel = \"main\",\n    xTitle = \"frequency (Hz)\",\n    yTitle = \"magnitude\",\n    marks = [\n        \"centroid ${centroid.f0} Hz\" to centroid,\n        \"85% rolloff ${rolloff.f0} Hz\" to rolloff,\n    ],\n)\nprintln(\n    \"peak=${peak.f0}Hz centroid=${centroid.f0}Hz rolloff=${rolloff.f0}Hz bins=${mag.size}\",\n)\n"} "preamble" "" "nested" #{}}} {"id" "spectral_spectrogram" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "spectrogram of a chirp" "_tombstone" false "frame" #afield/rect [80.0 440.0 300.0 100.0] "code" #afield/file-inline {"path" "spectral_spectrogram_code_.kt" "inline" "val sampleRate = 8000.0\nval n = 24000\nval f0 = 300.0\nval f1 = 3000.0\nval dur = n / sampleRate\nval k = (f1 - f0) / dur\nval signal =\n    DoubleArray(n) { i ->\n        val t = i / sampleRate\n        0.9 * sin(2.0 * PI * (f0 * t + 0.5 * k * t * t)) +\n            0.35 * sin(2.0 * PI * 700.0 * t) +\n            0.30 * sin(2.0 * PI * 1800.0 * t)\n    }\n\nval spec = stft(signal, fftSize = 1024, hopSize = 256, window = WindowType.HANN, sampleRate = sampleRate)\nval mags = spec.magnitudes()\nval maxMag = spec.maxMagnitude().coerceAtLeast(1e-9)\nval centroid = spec.centroidTrace()\nval nyquist = sampleRate / 2.0\n\n// dB relative to the peak, as a [frame][bin] matrix.\nval dB =\n    Array(spec.numFrames) { f ->\n        DoubleArray(spec.numBins) { b -> 20.0 * log10((mags[f][b] / maxMag).coerceAtLeast(1e-4)) }\n    }\n// Spectral centroid as a normalized (x, y) overlay: x = time fraction, y = fraction of Nyquist.\nval trace =\n    centroid.indices.map { f ->\n        (f.toDouble() / (spec.numFrames - 1).coerceAtLeast(1)) to (centroid[f] / nyquist).coerceIn(0.0, 1.0)\n    }\n\nprintln(\n    \"frames=${spec.numFrames} bins=${spec.numBins} centroid ${centroid.first().f0} -> ${centroid.last().f0} Hz\",\n)\nshowHeatmap(\n    dB,\n    colormap = \"cyanorange\",\n    width = 1800,\n    height = 840,\n    vmin = -80.0,\n    vmax = 0.0,\n    transpose = true,\n    flipY = true,\n    overlay = trace,\n    overlayThickness = 3,\n)\n"} "preamble" "" "nested" #{}}} {"id" "spectral_streaming" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "streaming spectral features" "_tombstone" false "frame" #afield/rect [80.0 1540.0 300.0 100.0] "code" #afield/file-inline {"path" "spectral_streaming_code_.kt" "inline" "val sampleRate = 8000f\nval n = 8000\nval stream =\n    FloatArray(n) { i ->\n        val t = i / sampleRate\n        val f = 200f + 1800f * (i.toFloat() / n)\n        var s = 0.6f * sin(2.0 * PI * f * t).toFloat() + 0.25f * sin(2.0 * PI * 900.0 * t).toFloat()\n        if (i == n / 3 || i == 2 * n / 3) s += 2.0f\n        s\n    }\n\nval brightness = EMAFilter(0.1f) then SpectralCentroidFilter(fftSize = 1024, hopSize = 256, sampleRate = sampleRate)\nval onset = SpectralFluxFilter(fftSize = 1024, hopSize = 256, sampleRate = sampleRate)\nval level = RmsFilter(windowSize = 512)\n\nval cTrace = FloatArray(n)\nval fTrace = FloatArray(n)\nval rTrace = FloatArray(n)\nfor (i in 0 until n) {\n    cTrace[i] = brightness(stream[i])\n    fTrace[i] = onset(stream[i])\n    rTrace[i] = level(stream[i])\n}\n\n// Different scales (Hz vs flux vs 0..1 level): normalize each to compare shape, one call.\nshowSignals(\n    \"spectral centroid (Hz)\" to cTrace.toList(),\n    \"spectral flux (onset novelty)\" to fTrace.toList(),\n    \"rolling RMS (level)\" to rTrace.toList(),\n    channel = \"main\",\n    xTitle = \"sample\",\n    normalize = true,\n)\nprintln(\n    \"centroid ${cTrace[3000].f0} -> ${cTrace[n - 200].f0} Hz, flux peak ${(fTrace.maxOrNull() ?: 0f).f3}\",\n)\n"} "preamble" "" "nested" #{}}} {"id" "spectral_distribution_events" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "distribution-aware event flags" "_tombstone" false "frame" #afield/rect [520.0 440.0 300.0 100.0] "code" #afield/file-inline {"path" "spectral_distribution_events_code_.kt" "inline" "val gammaEvents = GammaEventDetector(windowSize = 64, tailProbabilityThreshold = 0.03f, influence = 0.15f)\nval betaEvents = BetaEventDetector(\n    windowSize = 64,\n    supportMin = -1f,\n    supportMax = 1f,\n    lowerTailThreshold = 0.04f,\n    upperTailThreshold = 0.04f,\n)\n\nval raw = mutableListOf<Float>()\nval eg = mutableListOf<Float>()\nval eb = mutableListOf<Float>()\n\nfor (i in 0 until 360) {\n    val t = i / 120f\n    var x = (sin(2.0 * PI * 1.1 * t) * 0.55 + (-0.08 + random() * 0.16)).toFloat()\n    if (i % 83 == 0) x += 0.95f\n    if (i % 127 == 0) x -= 0.8f\n    raw += x\n    eg += gammaEvents(kotlin.math.abs(x))\n    eb += betaEvents(x)\n}\n\n// The raw stream and both detectors' verdicts on one axis — the event traces flag their tail\n// crossings (beta fires either way, ±1) over the raw motion, so which departures triggered is clear.\nshowSignals(\n    \"raw\" to raw,\n    \"gamma events\" to eg,\n    \"beta events\" to eb,\n    channel = \"main\",\n    xTitle = \"sample\",\n)\n"} "preamble" "" "nested" #{}}} {"id" "spectral_mel" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "mel spectrogram (crossing chirps)" "_tombstone" false "frame" #afield/rect [80.0 820.0 340.0 100.0] "code" #afield/file-inline {"path" "spectral_mel_code_.kt" "inline" "val sampleRate = 8000.0\nval n = 24000\nval up0 = 200.0\nval up1 = 3200.0\nval dn0 = 3200.0\nval dn1 = 200.0\nval dur = n / sampleRate\nval ku = (up1 - up0) / dur\nval kd = (dn1 - dn0) / dur\nval signal =\n    DoubleArray(n) { i ->\n        val t = i / sampleRate\n        0.7 * sin(2.0 * PI * (up0 * t + 0.5 * ku * t * t)) + 0.7 * sin(2.0 * PI * (dn0 * t + 0.5 * kd * t * t))\n    }\n\nval spec = stft(signal, fftSize = 1024, hopSize = 256, window = WindowType.HANN, sampleRate = sampleRate)\nval numBands = 48\nval mel = Array(spec.numFrames) { Mel.filterBank(spec.magnitude(it), sampleRate, numBands, 0.0, sampleRate / 2.0) }\nvar maxMel = 1e-9\nfor (row in mel) for (v in row) if (v > maxMel) maxMel = v\n\n// dB relative to the peak, as a [frame][band] matrix.\nval dB =\n    Array(spec.numFrames) { f ->\n        DoubleArray(numBands) { b -> 20.0 * log10((mel[f][b] / maxMel).coerceAtLeast(1e-4)) }\n    }\n\nprintln(\"frames=${spec.numFrames} bands=$numBands\")\nshowHeatmap(\n    dB,\n    colormap = \"cyanorange\",\n    width = 1800,\n    height = 720,\n    vmin = -80.0,\n    vmax = 0.0,\n    transpose = true,\n    flipY = true,\n)\n"} "preamble" "" "nested" #{}}} {"id" "spectral_resonator" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "resonator bank (no transform)" "_tombstone" false "preamble" "" "frame" #afield/rect [80.0 1180.0 310.0 100.0] "code" #afield/file-inline {"path" "spectral_resonator_code_.kt" "inline" "import afield.audio.engine.resonate\nimport afield.audio.engine.resonatorAlphaHeuristics\n\nval sampleRate = 8000f\nval n = 24000\nval f0 = 300.0\nval f1 = 3000.0\nval durS = n / sampleRate.toDouble()\nval k = (f1 - f0) / durS\nval signal =\n    FloatArray(n) { i ->\n        val t = i / sampleRate.toDouble()\n        (0.9 * sin(2.0 * PI * (f0 * t + 0.5 * k * t * t)) +\n                0.35 * sin(2.0 * PI * 700.0 * t) +\n                0.30 * sin(2.0 * PI * 1800.0 * t))\n            .toFloat()\n    }\n\nval numRes = 96\nval minHz = 120.0\nval maxHz = 3900.0\nval freqs =\n    FloatArray(numRes) { i ->\n        kotlin.math.exp(ln(minHz) + (ln(maxHz) - ln(minHz)) * i / (numRes - 1)).toFloat()\n    }\nval alphas = resonatorAlphaHeuristics(freqs, sampleRate)\nval hop = 256\n\nval flat = resonate(signal, sampleRate, freqs, alphas, betas = alphas, hopLength = hop)\nval slices = flat.size / (2 * numRes)\nfun ampAt(s: Int, kk: Int): Float {\n    val base = s * 2 * numRes\n    val re = flat[base + kk]\n    val im = flat[base + numRes + kk]\n    return kotlin.math.sqrt(re * re + im * im)\n}\nvar maxA = 1e-9f\nfor (s in 0 until slices) for (kk in 0 until numRes) {\n    val a = ampAt(s, kk)\n    if (a > maxA) maxA = a\n}\n\n// dB relative to the peak, as a [slice][resonator] matrix.\nval dB =\n    Array(slices) { s ->\n        DoubleArray(numRes) { kk -> 20.0 * log10((ampAt(s, kk).toDouble() / maxA).coerceAtLeast(1e-4)) }\n    }\n\nprintln(\"resonators=$numRes slices=$slices freq ${freqs.first().toInt()} -> ${freqs.last().toInt()} Hz\")\nshowHeatmap(\n    dB,\n    colormap = \"cyanorange\",\n    width = 1800,\n    height = 720,\n    vmin = -80.0,\n    vmax = 0.0,\n    transpose = true,\n    flipY = true,\n)\n"} "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "spectral_one_spectrum" #afield/box "spectral_spectrogram" #afield/box "spectral_mel" #afield/box "spectral_resonator" #afield/box "spectral_streaming" #afield/box "spectral_filter_chains" #afield/box "spectral_distribution_events"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}