{"version" 2 "boxes" [{"id" "swept-thinned" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5 - Thinning a tablet stroke" "_tombstone" false "frame" #afield/rect [4620.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "swept-thinned_code_.kt" "inline" "// A tablet-like stroke: a point every 0.6 units, and pressure with a little sensor wobble.\nval rnd = java.util.Random(1)\nval raw =\n    (0 until 1000).map { i ->\n        val s = i / 999.0\n        val p = (0.15 + 0.85 * sin(PI * s).pow(0.7) + 0.03 * rnd.nextGaussian()).coerceIn(0.0, 1.0)\n        vec(600 * s, 60 * sin(9 * s) + 0.1 * rnd.nextGaussian(), 12 * p.pow(1.75))\n    }\nval thin = thinPenSamples(raw, tolerance = 0.5)\n\nval rawOutline = sweptCircleStroke(raw, samplesPerSegment = 4).shell\nval thinOutline = sweptCircleStroke(thin).shell\nprintln(\"raw: ${raw.size} samples, ${sweptCircleDegenerateSpans(raw).size} spans without an envelope\")\nprintln(\"thinned: ${thin.size} samples, ${sweptCircleDegenerateSpans(thin).size} spans without an envelope\")\n\nfun ink(f: FLine, dy: Double) = (f + vec(0.0, dy)).apply {\n    filled = true\n    stroked = false\n    color = vec(0.95, 0.95, 0.9, 1.0)\n}\nfun dots(knots: List<Vec3>, dy: Double, size: Double) = knots.map { k ->\n    fline {\n        moveTo(k.x, k.y + dy)\n        lineTo(k.x + 0.01, k.y + dy)\n    }\n        .apply {\n            pointed = true\n            pointSize = size\n            color = vec(1.0, 0.4, 0.3, 1.0)\n        }\n}\nlines(\n    [ink(rawOutline, 0.0), ink(thinOutline, 170.0)] + dots(raw, 0.0, 0.5) + dots(thin, 170.0, 1.2),\n    w = 900.0,\n    h = 380.0,\n    fitToSize = true,\n)\n"} "preamble" "" "nested" #{}}} {"id" "swept-o" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Pill, trapezoid pill, swept spline" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "swept-o_code_.kt" "inline" "// A quick hand-written \"o\": fourteen pen samples, pressure rising and falling.\nval w = 20.0\nval knots =\n    (0..13).map { i ->\n        val a = 2.2 + 2 * PI * i / 12.5\n        val p = 0.3 + 0.7 * sin(PI * i / 13)\n        val r = w * p.pow(1.75)\n        vec(90 + 70 * cos(a) * (1 + 0.04 * i), 100 + 80 * sin(a), r)\n    }\n\nfun ink(f: FLine, dx: Double) = (f + vec(dx, 0.0)).apply {\n    filled = true\n    stroked = false\n    color = vec(0.95, 0.95, 0.9, 1.0)\n}\n\n// pill: each span at its mean radius\nval pills = knots.zipWithNext { a, b ->\n    val m = (a.z + b.z) / 2\n    sweptCircleStroke([vec(a.x, a.y, m), vec(b.x, b.y, m)]).shell\n}\n// trapezoid pill: each span straight, radius linear from end to end\nval trapezoids = knots.zipWithNext { a, b -> sweptCircleStroke([a, b]).shell }\n// swept spline: cubic Béziers in (x, y, r) through every sample\nval spline = sweptCircleStroke(knots).shell\n\nval samples = knots.map { k ->\n    fline {\n        moveTo(k.x, k.y)\n        lineTo(k.x + 0.01, k.y)\n    }\n        .apply {\n            pointed = true\n            pointSize = 1.5\n            color = vec(1.0, 0.4, 0.3, 1.0)\n        }\n}\n\nlines(\n    pills.map { ink(it, 0.0) } +\n        trapezoids.map { ink(it, 220.0) } +\n        ink(spline, 440.0) +\n        samples +\n        samples.map { it + vec(220.0, 0.0) } +\n        samples.map { it + vec(440.0, 0.0) },\n    w = 900.0,\n    h = 300.0,\n    fitToSize = true,\n)\n"} "preamble" "" "nested" #{}}} {"id" "swept-corners" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "6 - Sharp turns" "_tombstone" false "frame" #afield/rect [5760.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "swept-corners_code_.kt" "inline" "// A \"z\" written quickly: a sample every 1.5 units along three strokes, pressing less as it goes.\nval turns = [vec(0.0, 0.0), vec(160.0, 0.0), vec(0.0, 140.0), vec(160.0, 140.0)]\nval path =\n    turns\n        .zipWithNext { a, b ->\n            val n = (a.distance(b) / 1.5).toInt()\n            (0 until n).map { j -> a + (b - a) * (j.toDouble() / n) }\n        }\n        .flatten() + turns.last()\nval raw = path.mapIndexed { i, p -> vec(p.x, p.y, 9.0 * (0.95 - 0.5 * i / path.size).pow(1.75)) }\n\nval knots = thinPenSamples(raw)\nval corners = penCorners(knots)\nprintln(\"${raw.size} samples thin to ${knots.size}; corners at $corners\")\n\nfun ink(f: FLine, dx: Double) = (f + vec(dx, 0.0)).apply {\n    filled = true\n    stroked = false\n    color = vec(0.95, 0.95, 0.9, 1.0)\n}\nval smooth = sweptCircleStroke(knots).shell\nval sharp = sweptCircleStroke(knots, corners = corners).shell\nlines(ink(smooth, 0.0), ink(sharp, 260.0), w = 900.0, h = 320.0, fitToSize = true)\n"} "preamble" "" "nested" #{}}} {"id" "swept-cubic" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Envelope of one cubic" "_tombstone" false "frame" #afield/rect [1200.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "swept-cubic_code_.kt" "inline" "// One cubic whose radius swells from 2 to about 17 and back to 2: the envelope against the plain ribbon.\nval centre = fline {\n    moveTo(0, 0)\n    cubicTo(40, 45, 80, -30, 120, 20)\n}\nval radius = parameterFromLambda { t, _ -> 2f + 26f * t * t * (1f - t) * 4f }\n\nval swept = centre.bySweptCircleEnveloping(radius, samples = 200, flatness = 0.02)\nval ribbon = centre.byVariableRibboning(parameterFromLambda { t, p -> 2f * radius.evaluate(t, p) }, samples = 200)\n// reference: the union of 1500 discs along the line\nval reference = centre.byJtsVariableBuffering(\n    numSamples = 1500,\n    distance = { t -> radius.evaluate(t.toFloat(), vec(0f, 0f, 0f)).toDouble() },\n)\n\nprintln(\"swept envelope: %.3f from the union of discs\".format(swept.shell.outlineDistanceTo(reference)))\nprintln(\"byVariableRibboning: %.3f\".format(ribbon.outlineDistanceTo(reference)))\n\nval circles =\n    (0..16).map { i ->\n        val s = centre.sampleSeries(17)[i]\n        val r = radius.evaluate(s.t, s.point).toDouble()\n        fline { circle(s.point.x.toDouble(), s.point.y.toDouble(), r) }\n            .apply {\n                thickness = 0.8\n                color = vec(1.0, 1.0, 1.0, 0.35)\n            }\n    }\nlines(\n    circles +\n        listOf(\n            centre.copy().apply { color = vec(1.0, 1.0, 1.0, 0.5) },\n            ribbon.copy().apply {\n                color = vec(1.0, 0.45, 0.3, 1.0)\n                thickness = 1.5\n            },\n            swept.left.copy().apply {\n                color = vec(0.4, 0.9, 1.0, 1.0)\n                thickness = 2.0\n            },\n            swept.right.copy().apply {\n                color = vec(0.4, 0.9, 1.0, 1.0)\n                thickness = 2.0\n            },\n        ),\n    w = 900.0,\n    h = 380.0,\n    fitToSize = true,\n)\n"} "preamble" "" "nested" #{}}} {"id" "swept-notation" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - A pressure stroke from the drawing layer" "_tombstone" false "frame" #afield/rect [3480.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "swept-notation_code_.kt" "inline" "// Write a pressure stroke onto the drawing layer, then read it back as pen samples.\nnotation {\n    stroke(\n        (0..40).map { i -> vec(-300.0 + 9.0 * i, 420.0 + 40.0 * sin(i / 5.0)) },\n        name = \"ink\",\n        pressure = { 0.15 + 0.85 * sin(PI * it).pow(0.7) },\n    )\n}\nval mark = notation.named(\"ink\")!!\nval knots = mark.points.zip(mark.pressures) { p, pressure -> vec(p.x, p.y, 12.0 * pressure.pow(1.75)) }\nval outline = sweptCircleStroke(knots)\nprintln(\"${knots.size} pen samples, ${sweptCircleDegenerateSpans(knots).size} spans without an envelope\")\nlines(\n    outline.shell.copy().apply {\n        filled = true\n        stroked = false\n        color = vec(0.95, 0.95, 0.9, 1.0)\n    },\n    w = 900.0,\n    h = 260.0,\n    fitToSize = true,\n)\n"} "preamble" "" "nested" #{}}} {"id" "swept-degenerate" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - Where there is no envelope" "_tombstone" false "frame" #afield/rect [2340.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "swept-degenerate_code_.kt" "inline" "// The pen nearly stops and presses: around the middle sample the radius changes faster than\n// the centre moves, and the circle swallows itself.\nval knots = listOf(\n    vec(0.0, 0.0, 4.0),\n    vec(60.0, 20.0, 7.0),\n    vec(66.0, 22.0, 30.0),\n    vec(72.0, 20.0, 8.0),\n    vec(150.0, 0.0, 4.0),\n)\nval spans = sweptCircleDegenerateSpans(knots)\nprintln(\"no envelope on \" + spans.joinToString { \"%.4f..%.4f\".format(it.start, it.endInclusive) })\n\nval outline = sweptCircleStroke(knots)\nval beziers = sweptCircleBeziers(knots)\nval path = fline {\n    moveTo(beziers[0][0].x, beziers[0][0].y)\n    for (b in beziers) cubicTo(b[1].x, b[1].y, b[2].x, b[2].y, b[3].x, b[3].y)\n}\nlines(\n    outline.shell.copy().apply {\n        filled = true\n        stroked = false\n        color = vec(0.95, 0.95, 0.9, 0.35)\n    },\n    outline.left.copy().apply {\n        color = vec(0.4, 0.9, 1.0, 1.0)\n        thickness = 2.0\n    },\n    outline.right.copy().apply {\n        color = vec(0.4, 0.9, 1.0, 1.0)\n        thickness = 2.0\n    },\n    path.copy().apply { color = vec(1.0, 1.0, 1.0, 0.6) },\n    w = 900.0,\n    h = 320.0,\n    fitToSize = true,\n)\n"} "preamble" "" "nested" #{}}} {"id" "swept-onstroke" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "7 - Outline strokes as they are drawn" "_tombstone" false "frame" #afield/rect [6900.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "swept-onstroke_code_.kt" "inline" "// Outline every stroke drawn by hand from now on, at the width the pen pressed.\nval inked = mutableListOf<FLine>()\nnotation.onStroke { mark ->\n    val knots = thinPenSamples(mark.penKnots(10.0))\n    inked +=\n        sweptCircleStroke(knots, corners = penCorners(knots)).shell.apply {\n            filled = true\n            stroked = false\n            color = vec(0.95, 0.95, 0.9, 1.0)\n        }\n    lines(inked, w = 900.0, h = 400.0, fitToSize = true)\n}\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "swept-o" #afield/box "swept-cubic" #afield/box "swept-degenerate" #afield/box "swept-notation" #afield/box "swept-thinned" #afield/box "swept-corners" #afield/box "swept-onstroke"} "parents" #{} "name" "root" "nested" #{} "drawing" "{\"type\":\"excalidraw\",\"version\":2,\"source\":\"field\",\"appState\":{\"viewBackgroundColor\":\"transparent\",\"gridSize\":null},\"files\":{},\"elements\":[{\"id\":\"swept-notation~default~ink\",\"type\":\"freedraw\",\"x\":-300.0,\"y\":420.0,\"width\":360.0,\"height\":79.82952880859375,\"angle\":0,\"strokeColor\":\"#1e1e1e\",\"backgroundColor\":\"transparent\",\"fillStyle\":\"hachure\",\"strokeWidth\":1.0,\"strokeStyle\":\"solid\",\"roughness\":0.0,\"opacity\":100.0,\"groupIds\":[],\"frameId\":null,\"roundness\":null,\"seed\":674775372,\"isDeleted\":false,\"boundElements\":[],\"link\":null,\"locked\":false,\"customData\":{\"fieldOwner\":\"swept-notation\",\"fieldKey\":\"default\",\"fieldName\":\"ink\",\"fieldStroke\":\"#1e1e1e\",\"fieldFill\":\"transparent\"},\"lastCommittedPoint\":null,\"startBinding\":null,\"endBinding\":null,\"points\":[[0.0,0.0],[9.0,7.94677734375],[18.0,15.57672119140625],[27.0,22.585693359375],[36.0,28.694244384765625],[45.0,33.658843994140625],[54.0,37.28155517578125],[63.0,39.417999267578125],[72.0,39.982940673828125],[81.0,38.95391845703125],[90.0,36.37188720703125],[99.0,32.33984375],[108.0,27.018524169921875],[117.0,20.62005615234375],[126.0,13.3995361328125],[135.0,5.644805908203125],[144.0,-2.3349609375],[153.0,-10.221649169921875],[162.0,-17.7008056640625],[171.0,-24.47430419921875],[180.0,-30.2720947265625],[189.0,-34.863037109375],[198.0,-38.0640869140625],[207.0,-39.747650146484375],[216.0,-39.846588134765625],[225.0,-38.356964111328125],[234.0,-35.33819580078125],[243.0,-30.91058349609375],[252.0,-25.25067138671875],[261.0,-18.584075927734375],[270.0,-11.176605224609375],[279.0,-3.323577880859375],[288.0,4.661956787109375],[297.0,12.461639404296875],[306.0,19.7645263671875],[315.0,26.279449462890625],[324.0,31.7467041015625],[333.0,35.948333740234375],[342.0,38.716796875],[351.0,39.941741943359375],[360.0,39.5743408203125]],\"pressures\":[0.15,0.306710216113422,0.4023437163400432,0.48045314646475956,0.5466821123213746,0.6035789024613823,0.6529720742530085,0.6965508962176807,0.7359505404528967,0.7726023663379981,0.8075007190861822,0.8410492212810039,0.8730742038807602,0.9029749170527884,0.9299331760045453,0.9531216392513796,0.9718758024470714,0.9858112147284476,0.9948755736826906,0.9993333245426586,0.9996873853227477,0.99655063635289,0.9904867922694808,0.981850499522079,0.9706699979240087,0.9566191597841436,0.9390950108168935,0.9173640557455559,0.890721166358927,0.8586257636931626,0.820802967202812,0.7773016304686581,0.7285008202685377,0.6750568437761807,0.6177847742238943,0.5574685821247796,0.49458183577280757,0.42886380004042823,0.35855012169187195,0.278206773440389,0.15000000000618052],\"simulatePressure\":false,\"version\":1,\"versionNonce\":1552418747,\"updated\":1794416492879}]}"}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_control