{"version" 2 "boxes" [{"id" "chain_renderer" "properties" {"children" #{#afield/box "skinned_volume_trace"} "parents" #{#afield/box "root"} "name" "path tracing renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 220.0 60.0] "code" #afield/file-inline {"path" "chain_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nonce.renderer {\n    window = Window(\"Field · Skinning through Manifold\")\n    Renderer(window)\n}\nstart(renderer::run)\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "skinned_volume_trace" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "chain_renderer"} "name" "a twisted limb, skinned two ways, weighed, traced" "_tombstone" false "frame" #afield/rect [320.0 140.0 300.0 70.0] "code" #afield/file-inline {"path" "skinned_volume_trace_code_.kt" "inline" "import afield.geometry.solid.manifold.ManifoldLibrary\nimport afield.geometry.solid.manifold.toSolid\nimport afield.graphics.scene.GltfSkinning.SkinningMethod\nimport afield.graphics.scene.GltfSkinning.SkinningOptions\nimport afield.graphics.scene.fabricated.PathTraceEnvironment\nimport afield.graphics.scene.fabricated.PathTraceMaterial\nimport afield.graphics.scene.fabricated.PathTraceScene\nimport afield.graphics.scene.fabricated.PathTracingRenderer\nimport afield.graphics.scene.fabricated.importTriMesh\nimport afield.graphics.vulkan.util.Camera\nimport java.io.File\n\nprop<PathTracingRenderer>(tracer)\n\nrequire(ManifoldLibrary.isAvailable) {\n    ManifoldLibrary.describe() + \"\\nOn macOS: brew install manifold, then run this box again.\"\n}\n\nval twist = 180f // degrees about the bone's own axis; 180 is the worst case for LBS\n\n// ---- stage one: skin the same file two ways -----------------------------------\nval rig = CappedTwistFixture.locate()\nfun posed(method: SkinningMethod) = skinnedGltfToTriMesh(\n    rig,\n    clip = \"twist\",\n    seconds = CappedTwistFixture.secondsFor(twist),\n    options = SkinningOptions(method = method),\n)\n\n/*\n---- stage two: each pose becomes a solid, is weighed, and comes back shaded ----\n60 degrees splits the caps from the wall and leaves the 30-degree facets of the\ntwelve-sided wall smooth.\n*/\nfun weighed(method: SkinningMethod) =\n    posed(method).toSolid().use { solid ->\n        println(\n            \"%-16s genus %d, volume %.4f (rest %.1f)\"\n                .format(\n                    method.name,\n                    solid.genus,\n                    solid.volume,\n                    CappedTwistFixture.REST_VOLUME,\n                ),\n        )\n        solid.toTriMesh(normals = true, minSharpAngle = 60.0)\n    }\nval lbs = weighed(SkinningMethod.LINEAR_BLEND)\nval dqs = weighed(SkinningMethod.DUAL_QUATERNION)\n\n// ---- stage three: lay both limbs on a floor and trace them --------------------\nval scene = PathTraceScene()\nval cyan = scene.material(PathTraceMaterial.plastic(0.30f, 0.72f, 0.90f, 0.35f))\nval orange = scene.material(PathTraceMaterial.plastic(0.95f, 0.50f, 0.20f, 0.35f))\nval floor = scene.material(PathTraceMaterial.plastic(0.5f, 0.51f, 0.53f, 0.5f))\n\n// The rig stands along +y from 0 to 4. Turn it onto its side (+y to +x), centre it, and\n// lift it by its radius so it rests on the floor at y = 0.\nfun lying(z: Float) = Matrix4f().translation(-2f, CappedTwistFixture.RADIUS, z).rotateZ(-0.5f * Math.PI.toFloat())\nval a = scene.importTriMesh(lbs, cyan, lying(0.8f))\nval b = scene.importTriMesh(dqs, orange, lying(-0.8f))\nprintln(\n    \"scene: ${a.triangleCount + b.triangleCount} triangles appended, \" +\n        \"${a.degenerateCount + b.degenerateCount} dropped\",\n)\n\nval reach = 8f\nscene.quad(\n    Vector3f(-reach, 0f, -reach),\n    Vector3f(reach, 0f, -reach),\n    Vector3f(reach, 0f, reach),\n    Vector3f(-reach, 0f, reach),\n    floor,\n)\n\nval environment = PathTraceEnvironment.fromFile(\n    File(\"public/docs/assets/fabricate_demo/venice_sunset_1k.exr\").absolutePath,\n)\nval camera = Camera(renderer).also {\n    it.at.set(1.2f, 3.4f, 5.2f)\n    it.target.set(0f, 0.35f, 0f)\n    it.p.fov = 0.62\n}\ntracer = PathTracingRenderer(renderer, scene, environment, 1000, 614, camera).install()\ntracer.samplesPerFrame = 2\ntracer.maxBounces = 6\ntracer.exposure = 1.3f\ntracer.environmentRotation = 2.1f\ntracer.indirectClamp = 10f\ntracer.blitToScreen()\nprintln(\"${tracer.backend}: ${tracer.triangleCount} triangles\")\nframes {\n    while (tracer.samples < 500) {\n        frame()\n    }\n    println(\"skinned volume study converged: ${tracer.samples} samples\")\n}\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "chain_renderer" #afield/box "skinned_volume_trace"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}