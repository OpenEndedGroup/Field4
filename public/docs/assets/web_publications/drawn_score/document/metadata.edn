{"version" 2 "boxes" [{"id" "ds_score" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "score" "_tombstone" false "frame" #afield/rect [20.0 40.0 190.0 60.0] "code" #afield/file-inline {"path" "ds_score_code_.kt" "inline" "/*\nThe score, drawn from code into the document's drawing: a frame named \"score\", a piano\nroll, a glissando and a held note. Running it again replaces these marks; anything you\ndraw by hand in the frame is left alone and is read with them.\n*/\nnotation { drawnScore() }\nprintln(\"${notation.mine.size} marks drawn\")\n"} "preamble" "" "nested" #{}}} {"id" "ds_read" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "read" "_tombstone" false "frame" #afield/rect [20.0 500.0 190.0 60.0] "code" #afield/file-inline {"path" "ds_read_code_.kt" "inline" "// Eight beats across, MIDI 84 at the top down to 48 at the bottom: every mark as an event.\nval score = notation.space(\"score\", x = 0.0..8.0, y = 84.0..48.0)\nprintln(\n    score.events.joinToString(\"\\n\") { e ->\n        \"%s: beat %.3f to %.3f, MIDI %.2f to %.2f\"\n            .format(e.mark.label ?: e.mark.kind.name.lowercase(), e.start, e.end, e.value, e.endValue)\n    },\n)\n"} "preamble" "" "nested" #{}}} {"id" "ds_pentatonic" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "pentatonic" "_tombstone" false "frame" #afield/rect [580.0 500.0 190.0 60.0] "code" #afield/file-inline {"path" "ds_pentatonic_code_.kt" "inline" "// The same drawing read another way: every note snapped to C minor pentatonic.\nval notes = DrawnScoreDocs.interpret(notation.space(\"score\", x = 0.0..8.0, y = 84.0..48.0)) // the loop in `play`\n\nval minorPentatonic = setOf(0, 3, 5, 7, 10) // C Eb F G Bb\nval inScale = (24..108).filter { it % 12 in minorPentatonic }\nval snap = { midi: Double -> inScale.minBy { kotlin.math.abs(it - midi) }.toDouble() }\nval tuned = mutableListOf<TimedNote>()\nfor (n in notes.map { it.copy(note = snap(it.note)) }) {\n    val last = tuned.lastOrNull()\n    if (last != null && last.note == n.note && last.end == n.start)\n        tuned[tuned.size - 1] = last.copy(end = n.end) // same pitch: hold it\n    else tuned += n\n}\n\nval voice = patVoice(wave = PatWave.TRIANGLE, decay = 0.004, sustain = 0.4)\nshowPatRollOf(\n    \"read\" to patTimed(notes, beats = 8.0),\n    \"C minor pentatonic\" to patTimed(tuned, beats = 8.0),\n    title = \"one drawing, two readings\",\n    cycles = 1,\n    pitched = true,\n    channel = \"roll\",\n)\nshowPatAudio(patTimed(tuned, beats = 8.0), cycles = 2, cps = 0.25, voice = voice, channel = \"audio\")\n"} "preamble" "" "nested" #{}}} {"id" "ds_listen" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "listen back" "_tombstone" false "frame" #afield/rect [860.0 500.0 190.0 60.0] "code" #afield/file-inline {"path" "ds_listen_code_.kt" "inline" "// Play both readings again, then take the sound apart: an onset per strike, a pitch per note.\nval notes = DrawnScoreDocs.interpret(notation.space(\"score\", x = 0.0..8.0, y = 84.0..48.0))\nval tuned = DrawnScoreDocs.pentatonic(notes)\nval voice = patVoice(wave = PatWave.TRIANGLE, decay = 0.004, sustain = 0.4)\nval heard = [notes, tuned].map {\n    DrawnScoreDocs.listen(patRenderStereo(patTimed(it, beats = 8.0), cycles = 2, cps = 0.25, voice = voice), it)\n}\nval trace = heard[0].trace()\nshowSignals(\n    \"drawn\" to trace.map { it.third },\n    \"heard\" to trace.map { it.second },\n    x = trace.map { it.first },\n    title = \"pitch: drawn and heard\",\n    xTitle = \"seconds\",\n    yTitle = \"MIDI\",\n)\nprintln(heard.joinToString(\"\\n\") { it.describe() })\n"} "preamble" "" "nested" #{}}} {"id" "ds_play" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "play" "_tombstone" false "frame" #afield/rect [300.0 500.0 190.0 60.0] "code" #afield/file-inline {"path" "ds_play_code_.kt" "inline" "// What each mark means as music is decided here, and you can change it.\nval score = notation.space(\"score\", x = 0.0..8.0, y = 84.0..48.0) // eight beats; MIDI 84 at the top\nval glideStep = 0.125 // how finely a moving stroke is read\n\nval notes = mutableListOf<TimedNote>()\nfor (e in score.events) {\n    val kind = e.mark.kind\n    if (kind == MarkType.TEXT || kind == MarkType.FRAME || kind == MarkType.ARROW) continue // labels, not notes\n    if (e.end <= e.start) continue // no width, no time\n    val moving = (kind == MarkType.STROKE || kind == MarkType.LINE) && kotlin.math.abs(e.endValue - e.value) > 0.5\n    if (!moving) { // a rectangle, or a level line: one note\n        notes += TimedNote(e.start, e.end, e.value)\n        continue\n    }\n    var t = e.start // a glissando: cut it every glideStep\n    while (t < e.end - 1e-9) {\n        val hit = score.vertical(t).firstOrNull { it.mark.id == e.mark.id && !it.isSpan }\n        if (hit != null) notes += TimedNote(t, minOf(t + glideStep, e.end), hit.value, hit.pressure ?: 1.0)\n        t += glideStep\n    }\n}\n\nval voice = patVoice(wave = PatWave.TRIANGLE, decay = 0.004, sustain = 0.4)\nshowPatRollOf(\n    \"read\" to patTimed(notes, beats = 8.0),\n    title = \"the score, read\",\n    subtitle = \"${notes.size} notes\",\n    cycles = 1,\n    pitched = true,\n    channel = \"roll\",\n)\nshowPatAudio(patTimed(notes, beats = 8.0), cycles = 2, cps = 0.25, voice = voice, channel = \"audio\")\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "ds_score" #afield/box "ds_read" #afield/box "ds_play" #afield/box "ds_pentatonic" #afield/box "ds_listen"} "parents" #{} "name" "root" "nested" #{} "drawing" "{\"type\":\"excalidraw\",\"version\":2,\"source\":\"field\",\"appState\":{\"viewBackgroundColor\":\"transparent\",\"gridSize\":null},\"files\":{},\"elements\":[{\"id\":\"ds_score~default~score\",\"type\":\"frame\",\"x\":260.0,\"y\":40.0,\"width\":800.0,\"height\":400.0,\"angle\":0,\"strokeColor\":\"#bbb\",\"backgroundColor\":\"transparent\",\"fillStyle\":\"hachure\",\"stroke