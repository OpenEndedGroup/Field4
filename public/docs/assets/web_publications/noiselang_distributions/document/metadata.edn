{"version" 2 "boxes" [{"id" "noise_walks" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 · a distribution of FLines" "_tombstone" false "frame" #afield/rect [500.0 180.0 420.0 100.0] "code" #afield/file-inline {"path" "noise_walks_code_.kt" "inline" "import afield.math.distribution.*\n\n// One graph: heading drifts by an independent normal each step; x and y accumulate.\nval steps = 40\nvar heading: Dist = Dist.dirac(0)\nvar x: Dist = Dist.dirac(0)\nvar y: Dist = Dist.dirac(0)\nval xs = ArrayList<Dist>()\nval ys = ArrayList<Dist>()\nfor (k in 0 until steps) {\n    heading = heading + normal(0, 0.25)\n    x = x + heading.cos() * 4\n    y = y + heading.sin() * 4\n    xs += x\n    ys += y\n}\nval reach = (x * x + y * y).sqrt()\n\n// 120 joint draws of every node: each sample is one whole path.\nval walks = 120\nval drawn = jointSamples(*(xs + ys).toTypedArray(), n = walks, seed = 7)\nval paths =\n    (0 until walks).map { w ->\n        fline {\n            moveTo(200, 150)\n            for (k in 0 until steps) lineTo(200 + drawn[k][w], 150 - drawn[steps + k][w])\n            color = vec(0.0, 0.67, 1.0, 0.35)\n        }\n    }\nlines(paths, channel = \"walks\", w = 400.0, h = 300.0)\n\nprintln(\"E(reach) = ${E(reach, n = 50_000)}   (a straight line would be ${steps * 4})\")\n__m(\"reach\").distribution(reach, batch = 20_000, title = \"distance from the start after $steps steps\")\n"} "preamble" "" "nested" #{}}} {"id" "noise_spike_to_triangle" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 · spike, die, two dice — launch me" "_tombstone" false "frame" #afield/rect [40.0 40.0 420.0 100.0] "code" #afield/file-inline {"path" "noise_spike_to_triangle_code_.kt" "inline" "import afield.math.distribution.*\n\nval a = Dist.dirac(5)\nval d1 = die(6)\nval d2 = die(6)\nval s = a + d1 + d2\n\nloop {\n    __m(\"spike\").distribution(a, batch = 500, title = \"A = 5, a Dirac spike\")\n    __m(\"die\").distribution(d1, batch = 500, title = \"D1, a fair die\")\n    __m(\"sum\").distribution(s, batch = 500, title = \"S = A + D1 + D2\", exact = 12.0)\n    frame()\n}\n"} "preamble" "" "nested" #{}}} {"id" "noise_queries" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 · P, E, Var and quantiles, with standard errors" "_tombstone" false "frame" #afield/rect [40.0 180.0 420.0 100.0] "code" #afield/file-inline {"path" "noise_queries_code_.kt" "inline" "import afield.math.distribution.*\n\nfun show(label: String, e: Estimate, exact: Double) =\n    println(\"%-24s %-28s exact %.5f   z = %+.2f\".format(label, e, exact, e.zFrom(exact)))\n\nval x = die(6)\nval y = die(6)\nshow(\"E(5 + X + Y)\", E(5 + x + y), 12.0)\nshow(\"P(X + Y < 10)\", P(x + y lt 10), 30.0 / 36)\nshow(\"E(X - X)\", E(x - x), 0.0)\nshow(\"Var(X - X')\", Var(x - x.iid()), 35.0 / 6)\n\nval birthday = draws(23, uniformInt(1, 365))\nval noShared = (0 until 23).fold(1.0) { p, k -> p * (365.0 - k) / 365.0 }\nshow(\"P(shared birthday)\", P(hasDuplicates(birthday)), 1 - noShared)\n\nval u = uniform(-1, 1)\nval v = uniform(-1, 1)\nshow(\"4 P(u² + v² < 1)\", P(u * u + v * v lt 1) * 4, Math.PI)\nshow(\"median of exp(1)\", quantile(exponential(1), 0.5), kotlin.math.ln(2.0))\n"} "preamble" "" "nested" #{}}} {"id" "noise_density" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 · samples settling under a density — launch me" "_tombstone" false "frame" #afield/rect [500.0 40.0 420.0 100.0] "code" #afield/file-inline {"path" "noise_density_code_.kt" "inline" "import afield.math.distribution.*\n\nval sum = normal(0, 1) + normal(2, 0.5)\nval squared = normal(0, 1).squared()\n\nloop {\n    __m(\"sum\").distribution(sum, batch = 400, title = \"N(0,1) + N(2,0.5)\", exact = 2.0)\n    __m(\"sq\").distribution(squared, batch = 400, title = \"Z², no closed form here\", exact = 1.0)\n    frame()\n}\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "noise_spike_to_triangle" #afield/box "noise_queries" #afield/box "noise_density" #afield/box "noise_walks"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}