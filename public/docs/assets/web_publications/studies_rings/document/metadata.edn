{"version" 2 "boxes" [{"id" "rings_change" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "rings_study"} "name" "change it" "_tombstone" false "frame" #afield/rect [40.0 200.0 240.0 70.0] "code" #afield/file-inline {"path" "rings_change_code_.kt" "inline" "/*\nChange the study: check the box's text in as the first revision if there is none yet,\nthen flip warmth (knob 2) between warm and cool. Each run publishes one revision and shows\nit beside its parent with their difference. Run \"rings\" first.\n*/\n\nvar now = ringsStudy.inspect(StudyCall.Inspect())\nif (now.revision == \"empty\") {\n    ringsStudy.edit(\n        StudyCall.Edit(\n            \"empty\",\n            now.facts[\"liveSourceHash\"] as String,\n            ringsStudy.revisions.liveSource(),\n            \"the starting rings\",\n        ),\n    )\n    now = ringsStudy.inspect(StudyCall.Inspect())\n}\nval warmth = StudyKnobs.plainNumbers(now.facts[\"source\"] as String)[2].value\nval changed = ringsStudy.setNumbers(\n    StudyCall.SetNumbers(\n        now.revision,\n        now.facts[\"liveSourceHash\"] as String,\n        [StudyCall.Number(2, if (warmth > 0.5) 0.2 else 0.8)],\n        if (warmth > 0.5) \"cooler\" else \"warmer\",\n    ),\n)\n\nprintln(changed.revision + \": \" + ringsStudy.revisions.liveSource())\ndisplay(\"main\", \"<img src='${changed.toolImages.single().dataUrl}' style='width:340px'/>\")\n"} "preamble" "import afield.study.source.SourceFramesStudy\nvar Box.rings by Inheritance<String>() /*from:rings_study*/ /**/\nval Once.rings by Onceing<String>() /*from:rings_study*/ /**/\nval Why.rings by Whying() /*from:rings_study*/ /**/\nvar Box.ringsStudy by Inheritance<SourceFramesStudy>() /*from:rings_study*/ /**/\nval Once.ringsStudy by Onceing<SourceFramesStudy>() /*from:rings_study*/ /**/\nval Why.ringsStudy by Whying() /*from:rings_study*/ /**/" "nested" #{}}} {"id" "rings_study" "properties" {"children" #{#afield/box "rings_change" #afield/box "rings_try"} "parents" #{#afield/box "root"} "name" "rings" "_tombstone" false "frame" #afield/rect [40.0 40.0 240.0 70.0] "code" #afield/file-inline {"path" "rings_study_code_.kt" "inline" "/*\nA study of this box's `rings` property: three numbers, a ring count, the brightness of\nthe dark bands, and warmth 0..1. Run this box first. It gives the document's AI4 chat ten\ntools (InspectRingsStudy ... RestoreRingsRevision); the two boxes below drive the same verbs\nfrom code. See public/docs/studies.md.\n*/\n\n// sourceFramesStudy saves the source property. Keep a person's edited text on rerun.\nprop<String>(rings)\nonce.rings { \"7 rings 0.05 ink 0.8 warmth\" }\nprop<SourceFramesStudy>(ringsStudy)\n\nringsStudy = sourceFramesStudy(\n    \"rings\",\n    studyFrames(\"rings, drawn on the CPU\") { source: String, w: Int, h: Int, t: Double ->\n        val (count, ink, warmth) = StudyKnobs.plainNumbers(source).map { it.value.toFloat() }\n        val px = FloatArray(w * h * 4)\n        for (y in 0 until h) for (x in 0 until w) {\n            val d = Math.hypot(x + 0.5 - w / 2.0, y + 0.5 - h / 2.0) / w\n            val v = (0.5 + 0.5 * Math.cos(d * count * 12.0 - t * 2.0)).toFloat()\n            val i = (y * w + x) * 4\n            px[i] = v * warmth + ink * (1 - v)\n            px[i + 1] = v * 0.5f + ink * (1 - v)\n            px[i + 2] = v * (1 - warmth) + ink * (1 - v)\n            px[i + 3] = 1f\n        }\n        afield.lang.stacksl.cpu.CpuRaster(w, h, px)\n    },\n)\n\nregisterStudyTools(\"Rings\", ringsStudy, about = \"The source is three numbers: ring count, ink brightness, warmth 0..1.\")\nprintln(\"rings study ready: \" + ringsStudy.inspect(StudyCall.Inspect()).revision)\n"} "preamble" "import afield.study.source.SourceFramesStudy\nvar Box.rings by Inheritance<String>() /**/\nval Once.rings by Onceing<String>() /**/\nval Why.rings by Whying() /**/\nvar Box.ringsStudy by Inheritance<SourceFramesStudy>() /**/\nval Once.ringsStudy by Onceing<SourceFramesStudy>() /**/\nval Why.ringsStudy by Whying() /**/" "rings" "7 rings 0.05 ink 0.2 warmth" "nested" #{}}} {"id" "rings_try" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "rings_study"} "name" "try things" "_tombstone" false "frame" #afield/rect [460.0 200.0 240.0 70.0] "code" #afield/file-inline {"path" "rings_try_code_.kt" "inline" "/*\nSpeculate without publishing: sweep the ring count, and try two candidates beside the\ncurrent revision. Nothing here changes the study; adopt a candidate from AI4 chat\n(AdoptRingsVariant) or with ringsStudy.adoptVariant(...). Run \"rings\" first.\n*/\nif (ringsStudy.inspect(StudyCall.Inspect()).revision == \"empty\") println(\"no revision yet: run \\\"change it\\\" first\")\nelse {\n    val source = ringsStudy.revisions.liveSource()\n    val swept = ringsStudy.sweep(StudyCall.Sweep(knob = 0, values = [3.0, 5.0, 7.0, 11.0, 15.0]))\n    val tried = ringsStudy.tryVariants(\n        StudyCall.TryVariants(\n            [\n                StudyCall.Variant(\n                    \"tight\",\n                    source = StudyKnobs.withPlainNumbers(source, mapOf(0 to 15.0)),\n                    note = \"15 rings\",\n                ),\n                StudyCall.Variant(\n                    \"bright\",\n                    source = StudyKnobs.withPlainNumbers(source, mapOf(1 to 0.4)),\n                    note = \"lighter dark bands\",\n                ),\n            ],\n        ),\n    )\n    println(\"held: \" + tried.facts[\"held\"])\n    display(\n        \"main\",\n        \"<img src='${swept.toolImages.single().dataUrl}' style='width:100%'/>\" +\n            \"<img src='${tried.toolImages.single().dataUrl}' style='width:340px'/>\",\n    )\n}\n"} "preamble" "import afield.study.source.SourceFramesStudy\nvar Box.rings by Inheritance<String>() /*from:rings_study*/ /**/\nval Once.rings by Onceing<String>() /*from:rings_study*/ /**/\nval Why.rings by Whying() /*from:rings_study*/ /**/\nvar Box.ringsStudy by Inheritance<SourceFramesStudy>() /*from:rings_study*/ /**/\nval Once.ringsStudy by Onceing<SourceFramesStudy>() /*from:rings_study*/ /**/\nval Why.ringsStudy by Whying() /*from:rings_study*/ /**/" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "rings_study" #afield/box "rings_change" #afield/box "rings_try"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet" "rings"]}