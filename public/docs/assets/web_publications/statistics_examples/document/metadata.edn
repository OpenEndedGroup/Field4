{"version" 2 "boxes" [{"id" "stats_histogram" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Histograms, and the rule that picks the bins" "_tombstone" false "frame" #afield/rect [80.0 470.0 400.0 100.0] "code" #afield/file-inline {"path" "stats_histogram_code_.kt" "inline" "/*\nbuildHistogram takes no bin-count argument. It picks the SMALLEST of the\nFreedman-Diaconis, Scott and Sturges widths, floored so the count cannot exceed 2000.\nRe-derive the whole decision from the public stats and predict the bin count.\n*/\nval rng = java.util.Random(11)\nval skewed = (0 until 500).map { exp(0.6 * rng.nextGaussian()) }\nval rng2 = java.util.Random(23)\nval bimodal = (0 until 500).map {\n    if (it % 2 == 0) -2.0 + 0.4 * rng2.nextGaussian() else 2.0 + 0.4 * rng2.nextGaussian()\n}\n\n/*\nRe-derives buildHistogram's choice for one signal and checks it against the real call.\nDeclared `fun Box.explain`, not `fun explain`: a local function that calls `println`\nneeds the box receiver, and K2 fails to compile it unless the receiver is explicit\n(\"No mapping for symbol: VALUE_PARAMETER SCRIPT_IMPLICIT_RECEIVER\").\n*/\nfun Box.explain(label: String, values: List<Double>): Histogram {\n    val s = buildSummaryStats(values)\n    val range = s.max - s.min\n    val cubeRoot = s.count.toDouble().pow(-1.0 / 3.0)\n    val hFd = 2.0 * s.iqr * cubeRoot\n    val hScott = 3.5 * s.sampleStdDev * cubeRoot\n    val kSturges = ceil(ln(s.count.toDouble()) / ln(2.0) + 1.0).toInt()\n    val hSturges = range / kSturges\n    val winner = minOf(hFd, hScott, hSturges)\n    val which = if (winner == hFd) \"Freedman-Diaconis\" else if (winner == hScott) \"Scott\" else \"Sturges\"\n    val predicted = Math.round(range / winner).toInt().coerceIn(1, 2000)\n    val actual = buildHistogram(values)\n    println(\"$label: iqr=${s.iqr.f3} sd=${s.sampleStdDev.f3} range=${range.f3}\")\n    println(\n        \"  FD=${hFd.f4}  Scott=${hScott.f4}  Sturges=${hSturges.f4} (k=$kSturges)\" + \"  -> $which wins\",\n    )\n    println(\n        \"  predicted ${predicted} bins of ${(range / predicted).f5}; \" +\n            \"got ${actual.bins.size} of ${actual.binWidth.f5} -> agree=${predicted == actual.bins.size}\",\n    )\n    println(\n        \"  counts sum to ${actual.count} of ${values.size}; \" +\n            \"bins tile [min,max] with no gap=${(1 until actual.bins.size).all {\n            abs(actual.bins[it].start - actual.bins[it - 1].end) < 1e-9\n        }}\",\n    )\n    return actual\n}\n\nval hSkewed = explain(\"skewed  \", skewed)\nval hBimodal = explain(\"bimodal \", bimodal)\nprintln(\n    \"The bimodal signal has the SAME n and gets ${hBimodal.bins.size} bins against \" +\n        \"${hSkewed.bins.size}: FD and Scott are driven by the distance BETWEEN the modes \" +\n        \"(iqr ~4) rather than the 0.4 spread within them, so the crudest rule wins. Sturges \" +\n        \"knows nothing but n, so it is ${hBimodal.bins.size} bins for any 500-point sample.\",\n)\n\nval svgs = [\n    histogramToSvg(hSkewed, widthPx = 380, heightPx = 230, padTop = 26, title = \"exp(0.6 g), n=500\", decimals = 3),\n    histogramToSvg(\n        hBimodal,\n        widthPx = 380,\n        heightPx = 230,\n        padTop = 26,\n        title = \"two modes at -2 and +2, n=500\",\n        decimals = 3,\n    ),\n]\nshowRow(\"histograms\", svgs)\n"} "preamble" "" "nested" #{}}} {"id" "stats_dependence" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Six questions, six answers — and is the answer big?" "_tombstone" false "frame" #afield/rect [960.0 80.0 450.0 100.0] "code" #afield/file-inline {"path" "stats_dependence_code_.kt" "inline" "// The whole reason StatsDependence has six coefficients instead of one. Six shapes, every\n// coefficient on each, printed as one table so the disagreements line up in a row.\nval n = 400\nval rng = java.util.Random(7)\nval x = DoubleArray(n) { it / (n - 1.0) * 2.0 - 1.0 }\n// One noise draw, reused, so the \"independent\" panel is literally the noise the others\n// are built out of.\nval noise = DoubleArray(n) { rng.nextGaussian() }\n\nval cases = [\n    \"linear\" to DoubleArray(n) { 0.8 * x[it] + 0.25 * noise[it] },\n    \"monotone, curved\" to DoubleArray(n) { exp(3.0 * x[it]) },\n    \"parabola\" to DoubleArray(n) { x[it] * x[it] },\n    \"sine, 3 cycles over x = -1..1\" to DoubleArray(n) { sin(3.0 * PI * x[it]) },\n    \"same mean, growing spread\" to DoubleArray(n) { (0.05 + abs(x[it])) * noise[it] },\n    \"independent\" to DoubleArray(n) { noise[it] },\n]\n\nprintln(\"shape                        r      rho     tau      xi     dCor    MIC~\")\nval panels = cases.map { (label, y) ->\n    val r = StatsDependence.pearson(x, y)\n    val rho = StatsDependence.spearman(x, y)\n    val tau = StatsDependence.kendallTauB(x, y)\n    val xi = StatsDependence.xi(x, y)\n    val dcor = StatsDependence.distanceCorrelation(x, y)\n    val mic = StatsDependence.micTicNaive(x, y).mic\n    println(\"%-26s %6.3f  %6.3f  %6.3f  %6.3f  %6.3f  %6.3f\".format(label, r, rho, tau, xi, dcor, mic))\n    val lo = y.min()\n    val span = (y.max() - lo).takeIf { it > 1e-12 } ?: 1.0\n    // SVG y grows downward, so flip to read the shapes the way the formulas are written.\n    val cloud = pointCloudFLine(\n        (0 until n).map { i -> vec((x[i] + 1.0) / 2.0, 1.0 - (y[i] - lo) / span) },\n        color = vec(0.48, 0.85, 1.0, 0.8),\n        pointSize = 1.1,\n    )\n    val caption = \"r=${r.f3} rho=${rho.f3} tau=${tau.f3}\" + \" xi=${xi.f3} dCor=${dcor.f3} MIC~=${mic.f3}\"\n    \"$label\\n$caption\" to cloud\n}\n\nval parabola = cases[2].second\nprintln(\n    \"xi is asymmetric on purpose: xi(x, x^2)=${StatsDependence.xi(x, parabola).f3} \" +\n        \"but xi(x^2, x)=${StatsDependence.xi(parabola, x).f3} — x is NOT a function of x^2.\",\n)\nprintln(\n    \"dCor is 1 only for a STRAIGHT line, not for any perfect relationship: \" +\n        \"dCor(x, 3x+1)=${StatsDependence.distanceCorrelation(x, DoubleArray(n) { 3.0 * x[it] + 1.0 }).f6}, \" +\n        \"dCor(x, -2x+5)=${StatsDependence.distanceCorrelation(x, DoubleArray(n) { -2.0 * x[it] + 5.0 }).f6}, \" +\n        \"but dCor on the parabola is only ${StatsDependence.distanceCorrelation(x, parabola).f3}.\",\n)\n\n// There are no p-values anywhere in this family, and dCor under independence is biased\n// well above zero. So measure the null: break the pairing, keep both marginals.\nval y = cases[4].second\nval observedDcor = StatsDependence.distanceCorrelation(x, y)\nval observedXi = StatsDependence.xi(x, y)\nval prng = java.util.Random(31)\nval reps = 400\nval order = (0 until n).toMutableList()\nval nullDcor = DoubleArray(reps)\nval nullXi = DoubleArray(reps)\nfor (rep in 0 until reps) {\n    order.shuffle(prng)\n    val shuffled = DoubleArray(n) { y[order[it]] }\n    nullDcor[rep] = StatsDependence.distanceCorrelation(x, shuffled)\n    nullXi[rep] = StatsDependence.xi(x, shuffled)\n}\nval sortedD = nullDcor.sortedArray()\nval sortedXi = nullXi.sortedArray()\nprintln(\n    \"growing-spread case: observed dCor=${observedDcor.f4} against a null of \" +\n        \"mean ${sortedD.average().f4}, 95th pct ${sortedD[(reps * 0.95).toInt()].f4}, \" +\n        \"max ${sortedD.last().f4} — re-pairings reaching it: ${sortedD.count { it >= observedDcor }}/$reps\",\n)\nprintln(\n    \"                     observed xi  =${observedXi.f4} against a null 95th pct of \" +\n        \"${sortedXi[(reps * 0.95).toInt()].f4} — re-pairings reaching it: \" +\n        \"${sortedXi.count { it >= observedXi }}/$reps. xi correctly declines to call this functional.\",\n)\n\n// Two columns rather than three: showPlaneGrid's grid columns are `max-content`, so a long\n// caption widens the card past `cellWidth` instead of wrapping inside it.\nval window = Rect(0.0, 0.0, 1.0, 1.0)\nval frame = window.toFLine(color = vec(0.35, 0.44, 0.56, 0.5), thickness = 1.0)\nshowPlaneGrid(\n    *panels.map { (label, cloud) -> label to [frame, cloud] }.toTypedArray(),\n    columns = 2,\n    cellWidth = 380,\n    cellHeight = 240,\n    window = window,\n)\n"} "preamble" "" "nested" #{}}} {"id" "stats_summary" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Summary stats, and exactly how boring they are" "_tombstone" false "frame" #afield/rect [80.0 80.0 420.0 100.0] "code" #afield/file-inline {"path" "stats_summary_code_.kt" "inline" "// buildSummaryStats hands back seventeen numbers. Three of them are routinely misread, so\n// pin each one as arithmetic rather than trusting the label on the card.\nval n = 500 // even, so the median is the mean of the two middle values\nval rng = java.util.Random(11)\nval signal = (0 until n).map { exp(0.6 * rng.nextGaussian()) }\n\nval buf = SummaryStatsBuffer(maxSize = n)\nbuf.addAll(signal)\nbuf.add(Double.NaN) // refused at `add` time, and counted\nbuf.add(Double.POSITIVE_INFINITY) // likewise: `values` never holds a non-finite number\nval s = buf.snapshot()\n\nprintln(\"n=${s.count}  seen=${buf.samplesSeen}  refused=${buf.droppedNonFinite}  evicted=${buf.droppedByCapacity}\")\nprintln(\n    \"min=${s.min.f3}  q1=${s.q1.f3}  median=${s.median.f3}\" + \"  q3=${s.q3.f3}  max=${s.max.f3}\",\n)\n\n// 1. mean > median is the signature of a right skew, and skewness agrees in sign.\nprintln(\n    \"mean=${s.mean.f3} vs median=${s.median.f3}: \" +\n        \"mean is larger = ${s.mean > s.median}, and skewness=${s.skewness.f3} > 0 = ${s.skewness > 0.0}\",\n)\n\n// 2. MAD is the median absolute deviation from the median, UNSCALED. Not sigma, and not\n//    half the IQR either. Compute it independently to be sure.\nval sorted = signal.sorted()\nval medianAgain = (sorted[n / 2 - 1] + sorted[n / 2]) / 2.0\nval madByHand = signal.map { abs(it - medianAgain) }.sorted().let { (it[n / 2 - 1] + it[n / 2]) / 2.0 }\nprintln(\n    \"MAD=${s.mad.f4} recomputed by hand=${madByHand.f4}  \" +\n        \"(that is ${(s.mad / s.iqr).f3} x the IQR, and ${(s.mad / s.sampleStdDev).f3} x the sd)\",\n)\n\n// 3. stddev/variance are the SAMPLE (n-1) forms; skew/kurtosis are the POPULATION (n)\n//    forms with no bias correction. Both live on the same card, which is a trap.\nval ratio = s.sampleStdDev / s.populationStdDev\nprintln(\n    \"sampleStdDev/populationStdDev=${ratio.f6} vs sqrt(n/(n-1))=\" +\n        \"${sqrt(n / (n - 1.0)).f6}  -> stddev is the n-1 form\",\n)\n\n// The guarded small-sample returns: zeros, not NaNs.\nprintln(\"n=1 sampleVariance=${buildSummaryStats(listOf(4.0)).sampleVariance} (not NaN)\")\nprintln(\"n=2 skewness=${buildSummaryStats(listOf(1.0, 3.0)).skewness} (needs n>2)\")\nprintln(\"n=3 kurtosisExcess=${buildSummaryStats(listOf(1.0, 3.0, 10.0)).kurtosisExcess} (needs n>3)\")\n\n// And the one field that is a genuine footgun: cv = sd/mean.\nval centred = signal.map { it - s.mean }\nprintln(\n    \"cv on this signal=${s.coeffOfVariation.f4}; \" +\n        \"re-centred so the mean is ~0, cv=${buildSummaryStats(centred).coeffOfVariation.f1}\",\n)\n\ndisplay(\"card\", buf.summaryHtml(widthPx = 620, chartHeightPx = 150, decimals = 3))\n"} "preamble" "" "nested" #{}}} {"id" "stats_rolling" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Rolling dependence across a regime change" "_tombstone" false "frame" #afield/rect [960.0 580.0 390.0 100.0] "code" #afield/file-inline {"path" "stats_rolling_code_.kt" "inline" "val w = 80\nval total = 600\nval change = 300\nval rng = java.util.Random(3)\n\nval dcor = RollingDistanceCorrelation(w)\nval xiRoll = RollingXiCorrelation(w)\n\nval xs = ArrayList<Double>()\nval ys = ArrayList<Double>()\nval dSeries = ArrayList<Double>()\nval xiSeries = ArrayList<Double>()\nval absR = ArrayList<Double>()\n\nfor (i in 0 until total) {\n    val xv = rng.nextGaussian()\n    // Before `change`: two independent Gaussians. After: y = x^2 - 1, a dependence Pearson cannot see.\n    val yv = if (i < change) rng.nextGaussian() else xv * xv - 1.0 + 0.15 * rng.nextGaussian()\n    xs += xv\n    ys += yv\n    val distanceValue = dcor.push(xv, yv)\n    val xiValue = xiRoll.push(xv, yv)\n    // Compare with the w-sample null only once a complete window has arrived.\n    val fullWindow = xs.size >= w\n    dSeries += if (fullWindow) requireNotNull(distanceValue) else Double.NaN\n    xiSeries += if (fullWindow) requireNotNull(xiValue) else Double.NaN\n    // There is no RollingPearson, so take the batch one over the same window for comparison.\n    val lo = maxOf(0, xs.size - w)\n    val bx = xs.subList(lo, xs.size).toDoubleArray()\n    val by = ys.subList(lo, ys.size).toDoubleArray()\n    absR += if (fullWindow) abs(StatsDependence.pearson(bx, by)) else Double.NaN\n}\n\n// Calibrate each statistic against its own null distribution at this window size.\n// These are pointwise reference levels, not a multiple-testing-adjusted change detector.\nval r2 = java.util.Random(1234)\nval k = 300\nval dNull = DoubleArray(k)\nval xiNull = DoubleArray(k)\nrepeat(k) { i ->\n    val nx = DoubleArray(w) { r2.nextGaussian() }\n    val ny = DoubleArray(w) { r2.nextGaussian() }\n    dNull[i] = StatsDependence.distanceCorrelation(nx, ny)\n    xiNull[i] = StatsDependence.chatterjeeXi(nx, ny)\n}\nval threshold = dNull.sortedArray()[(k * 0.95).toInt()]\nval xiThreshold = xiNull.sortedArray()[(k * 0.95).toInt()]\n\n// The incremental sums are not an approximation. Cross-check the last window against the O(w^2)\n// batch call, which materialises two full w x w distance matrices to get the same answer.\nval batchLast = StatsDependence.distanceCorrelation(xs.takeLast(w).toDoubleArray(), ys.takeLast(w).toDoubleArray())\nval agreement = abs(dSeries.last() - batchLast)\n\nval firstD = (change until total).firstOrNull { dSeries[it] > threshold }\nval firstXi = (change until total).firstOrNull { xiSeries[it] > xiThreshold }\nval dCrossing = firstD?.let { \"+${it - change} samples\" } ?: \"not crossed\"\nval xiCrossing = firstXi?.let { \"+${it - change} samples\" } ?: \"not crossed\"\n\nshowSignals(\n    \"rolling dCor\" to dSeries,\n    \"rolling xi\" to xiSeries,\n    \"rolling |pearson|\" to absR,\n    \"dCor null 95th pct at w=$w\" to List(total) { threshold },\n    \"xi null 95th pct at w=$w\" to List(total) { xiThreshold },\n    channel = \"traces\",\n    title = \"Three rolling coefficients across one regime change (window $w)\",\n    xTitle = \"sample\",\n    yTitle = \"coefficient\",\n    marks = [\"regime change\" to change],\n)\n// The two windows are the same three coefficients measured twice, so they read as a table.\n// The pipes in `|r|` are escaped, or they would split the cell they sit in.\nmarkdown(\n    \"numbers\",\n    \"\"\"\n    | window | dCor | xi | \\|r\\| |\n    |--------|------|----|-------|\n    | window-full to the change (i=$w..${change - 1}) | ${dSeries.subList(w, change).average().f3} | ${xiSeries.subList(w, change).average().f3} | ${absR.subList(w, change).average().f3} |\n    | settled after the change (i=${change + w}..${total - 1}) | ${dSeries.subList(change + w, total).average().f3} | ${xiSeries.subList(change + w, total).average().f3} | ${absR.subList(change + w, total).average().f3} |\n\n    {muted:dCor null 95th pct ${threshold.f3}: $dCrossing.\n    xi null 95th pct ${xiThreshold.f3}: $xiCrossing.}\n\n    {muted:incremental vs batch on the final window: |difference| = $agreement}\n\"\"\",\n    width = 900,\n)\n"} "preamble" "" "nested" #{}}} {"id" "stats_warp" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Reshaping a distribution with an 8-knot warp" "_tombstone" false "frame" #afield/rect [80.0 860.0 400.0 100.0] "code" #afield/file-inline {"path" "stats_warp_code_.kt" "inline" "// quantilewarp.kt does not measure anything. It fits a monotone 8-knot PCHIP curve from\n// the measured quantiles of recent samples onto the quantiles of a target distribution.\nval rng = java.util.Random(5)\nval fit = DoubleArray(4000) { exp(rng.nextGaussian()) } // log-normal: violently skewed\nval held = DoubleArray(4000) { exp(rng.nextGaussian()) } // a disjoint second draw\n\nval warp = AdaptiveQuantileWarp() // target UnitNormal, 8 knots\nval state = warp.update(fit)\nval warped = held.map { state.evaluate(it) }\nval before = buildSummaryStats(held.toList())\nval after = buildSummaryStats(warped)\n\nprintln(\n    \"The eight default probabilities are NOT symmetric: \" +\n        QuantileWarpConfig().probabilities.joinToString() +\n        \" — more knots on the left tail.\",\n)\nprintln(\"input knots : ${state.inputKnots.joinToString { it.f3 }}\")\nprintln(\"target knots: ${state.targetKnots.joinToString { it.f3 }}\")\nprintln(\n    \"held-out BEFORE: mean ${before.mean.f3}  sd ${before.sampleStdDev.f3}\" +\n        \"  skew ${before.skewness.f3}  excess kurtosis ${before.kurtosisExcess.f1}\",\n)\nprintln(\n    \"held-out AFTER : mean ${after.mean.f4}  sd ${after.sampleStdDev.f4}\" +\n        \"  skew ${after.skewness.f4}  excess kurtosis ${after.kurtosisExcess.f4}\",\n)\nprintln(\"  (every number above is OUT OF SAMPLE — the curve was fitted on a different draw)\")\n\n/*\nAn independent oracle for the 8-knot fit: the exact warp onto a unit normal is\nPhi^-1(Fhat(v)). Nothing in quantilewarp.kt computes that, so this tests the PCHIP\ninterpolation rather than restating it.\n*/\nval sortedFit = fit.sortedArray()\nfun empiricalCdf(v: Double): Double {\n    var lo = 0\n    var hi = sortedFit.size\n    while (lo < hi) {\n        val mid = (lo + hi) / 2\n        if (sortedFit[mid] <= v) lo = mid + 1 else hi = mid\n    }\n    return lo / sortedFit.size.toDouble()\n}\nval probes = (2..98).map { it / 100.0 }\nval inputs = probes.map { sortedFit[(it * (sortedFit.size - 1)).toInt()] }\nval pchip = inputs.map { state.evaluate(it) }\nval exact = inputs.map { inverseStandardNormalCdf(empiricalCdf(it).coerceIn(1e-4, 1.0 - 1e-4)) }\nprintln(\n    \"worst |8-knot PCHIP - exact Phi^-1(Fhat)| over the 2nd..98th percentile: \" +\n        \"${pchip.indices.maxOf { abs(pchip[it] - exact[it]) }.f4}\",\n)\nprintln(\n    \"inverseStandardNormalCdf(0.975)=${inverseStandardNormalCdf(0.975).f6} \" +\n        \"(published 1.959964); (0.001)=${inverseStandardNormalCdf(0.001).f6} (published -3.090232)\",\n)\n\n// Sharp edge 1: outside the fitted knots, evaluate extrapolates linearly from the\n// endpoint tangent, and nothing clamps it.\nprintln(\n    \"lowest input knot is ${state.inputKnots.first().f3}; \" +\n        \"evaluate(0.0)=${state.evaluate(0.0).f2}, evaluate(-1.0)=${state.evaluate(-1.0).f1} \" +\n        \"— unbounded linear extrapolation, so clamp the input yourself.\",\n)\n\n// Sharp edge 2: successive states are SMOOTHED, not replaced. alpha defaults to 0.20, so\n// the gap after k updates should be step * 0.8^k — an external closed form, not a restatement.\nval srng = java.util.Random(77)\nval stepping = AdaptiveQuantileWarp(QuantileWarpConfig(historyFrames = 1))\nvar st = stepping.update(DoubleArray(2000) { srng.nextGaussian() })\nval step = 10.0\nval gaps = (1..12).map {\n    st = stepping.update(DoubleArray(2000) { step + srng.nextGaussian() })\n    step - st.inputKnots[4]\n}\nprintln(\"median knot chasing a step to $step (smoothingAlpha=${QuantileWarpConfig().smoothingAlpha}):\")\n[1, 2, 4, 8, 12].forEach { k ->\n    println(\n        \"  after $k updates gap=${gaps[k - 1].f3}  vs closed form ${step}*0.8^$k=\" + \"${(step * 0.8.pow(k)).f3}\",\n    )\n}\n\nshowSignals(\n    \"8-knot PCHIP warp\" to pchip,\n    \"exact inverse-normal of the empirical CDF\" to exact,\n    x = probes,\n    channel = \"the fitted curve\",\n    title = \"The warp, against the exact answer it is approximating\",\n    xTitle = \"quantile of the fitting sample\",\n    yTitle = \"warped value\",\n)\nval svgs = [\n    histogramToSvg(\n        buildHistogram(held.toList()),\n        widthPx = 380,\n        heightPx = 220,\n        padTop = 26,\n        decimals = 2,\n        title = \"held-out input: skew ${before.skewness.f1}\",\n    ),\n    histogramToSvg(\n        buildHistogram(warped),\n        widthPx = 380,\n        heightPx = 220,\n        padTop = 26,\n        decimals = 2,\n        title = \"after the warp: skew ${after.skewness.f3}\",\n    ),\n]\nshowRow(\"distributions\", svgs)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "stats_summary" #afield/box "stats_histogram" #afield/box "stats_dependence" #afield/box "stats_rolling" #afield/box "stats_warp"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}