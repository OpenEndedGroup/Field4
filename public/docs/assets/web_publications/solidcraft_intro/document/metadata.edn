{"version" 2 "boxes" [{"id" "solidcraft_compare" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "SolidCraft — a parameter changes the part" "_tombstone" false "frame" #afield/rect [80.0 80.0 500.0 110.0] "code" #afield/file-inline {"path" "solidcraft_compare_code_.kt" "inline" "import afield.geometry.solid.solidcraft.SolidCraftDesign\nimport afield.geometry.solid.solidcraft.SolidCraftLibrary\n\nrun {\n    if (!SolidCraftLibrary.isAvailable) {\n        display(\n            \"main\",\n            \"<div style='padding:24px;background:#101318;color:#e6ecf4;font-family:Iosevka,monospace'>\" +\n                \"SolidCraft is optional. Run <code>./gradlew buildSolidCraftNative</code>, restart Field, then run this box.</div>\",\n        )\n        println(SolidCraftLibrary.describe())\n        return@run\n    }\n\n    // Change this value and run again. The sketch is 40 × 30 mm; the first extrusion is\n    // width / 2 deep, while the circular cut remains exactly 20 mm deep.\n    val width = 50\n    val tolerance = 0.1\n\n    SolidCraftDesign.openBundledExample().use { part ->\n        val original = part.summary().getJSONArray(\"bodies\").getJSONObject(0)\n        val before = part.mesh(tolerance = tolerance).toTriMesh().weld()\n        part.setParameter(\"width\", \"$width mm\")\n        val changed = part.summary().getJSONArray(\"bodies\").getJSONObject(0)\n        val after = part.mesh(tolerance = tolerance).toTriMesh().weld()\n\n        println(\n            \"B-rep volume: ${\"%.1f\".format(original.getDouble(\"volume\"))} → \" +\n                \"${\"%.1f\".format(changed.getDouble(\"volume\"))} mm³\",\n        )\n        println(\"STEP ${part.exportStep().size} bytes; STL ${part.exportStl().size} bytes\")\n        println(\"The hole is blind at width > 40 mm: its cut depth stays 20 mm.\")\n\n        showMeshGrid(\n            \"40 mm: through cut\" to before,\n            \"$width mm: blind cut\" to after,\n            columns = 2,\n            cellWidth = 380,\n            // Look from the cut's side of the XY plane so the blind hole stays visible.\n            view = MeshView(yawDegrees = 165.0, pitchDegrees = 14.0, wireframe = false),\n            renderer = MeshRenderer.CPU,\n        )\n    }\n}\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "solidcraft_compare"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}