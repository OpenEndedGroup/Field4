{"version" 2 "boxes" [{"id" "vector_field_swirls" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Swirls, sources and sinks" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 120.0] "code" #afield/file-inline {"path" "vector_field_swirls_code_.kt" "inline" "import afield.geometry.topology.vectorfield.*\n\n// Each entry is (x, y, outflow, swirl): positive outflow is a source, negative a sink, swirl turns it.\n// The slider scales every swirl: watch sources become spirals and saddles move.\nval features = [\n    [50.0, 45.0, 1.0, 0.6],\n    [150.0, 40.0, -1.0, -0.8],\n    [100.0, 100.0, 0.2, 1.2],\n    [40.0, 115.0, -0.8, 0.0],\n    [165.0, 115.0, 0.9, -0.3],\n]\n\nfun show(twist: Double) {\n    val flow =\n        Img.generateRGB(200, 150) { x, y ->\n            var u = 0.0\n            var v = 0.0\n            for ((cx, cy, out, swirl) in features) {\n                val dx = x - cx\n                val dy = y - cy\n                val k = exp(-(dx * dx + dy * dy) / 900.0)\n                u += k * (out * dx - twist * swirl * dy)\n                v += k * (out * dy + twist * swirl * dx)\n            }\n            Triple(u.toFloat(), v.toFloat(), 0f)\n        }\n    val topology = VectorFieldTopology.compute(flow, minStrength = 0.01)\n    val black = Img(200, 150, 3, FloatArray(200 * 150 * 3))\n    showImgGrid(\n        \"$topology\" to\n            black.drawFLines(\n                topology.streamlines(spacing = 9.0, length = 14.0) +\n                    topology.toFLines() +\n                    topology.criticalPointsFLine(8.0),\n                scale = 3.0,\n            ),\n        columns = 1,\n        cellSide = 600,\n    )\n}\nslider(\"swirl\", min = 0.0, max = 3.0, step = 0.05, initialValue = 1.0) { show(it) }\nshow(1.0)\n"} "preamble" "" "nested" #{}}} {"id" "vector_field_leaf" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Ridges and valleys of a photograph" "_tombstone" false "frame" #afield/rect [560.0 60.0 420.0 120.0] "code" #afield/file-inline {"path" "vector_field_leaf_code_.kt" "inline" "import afield.geometry.topology.vectorfield.*\n\n// The gradient of the leaf print's brightness runs uphill: its sinks (blue) are bright places, its\n// sources (red) dark ones, and the separatrices from its saddles (white) are ridges and valleys.\nval print = imgFromFile(\"public/docs/assets/vision/fline-viewer.jpg\", 3).crop(78, 262, 128, 236)\nval dark = Img(print.width, print.height, 3, FloatArray(print.width * print.height * 3))\n\nfun show(blur: Double) {\n    val topology = VectorFieldTopology.compute(VectorFieldTopology.gradientOf(print.luma().gaussianBlur(blur)))\n    showImgGrid(\n        \"photograph\" to print.scaleBy(2.0),\n        \"${topology.criticalPoints.size} points\" to\n            print.overlay(dark, 0.6).drawFLines(topology.toFLines() + topology.criticalPointsFLine(7.0), scale = 2.0),\n        columns = 2,\n        cellSide = 300,\n    )\n}\nslider(\"blur\", min = 3.0, max = 16.0, step = 0.5, initialValue = 7.0) { show(it) }\nshow(7.0)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "vector_field_swirls" #afield/box "vector_field_leaf"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}