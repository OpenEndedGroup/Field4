{"version" 2 "boxes" [{"id" "paint_blow" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Paint — blow a straw across wet paint" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 100.0] "code" #afield/file-inline {"path" "paint_blow_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n\n    val canvas = PaintCanvas(900, aspect = 1.4, seed = 11)\n    val brush = canvas.brush(BrushKind.HogFlat, width = 120.0)\n    brush.load(rgb(0.1, 0.18, 0.55), amount = 5.0, stiff = 0.3)\n    for (y in listOf(220, 330, 440, 550)) canvas.stroke(\n        FLine().moveTo(120, y).lineTo(880, y),\n        brush,\n        pressure = 1.0..1.0,\n    )\n    display(\"before\", canvas.png(wet = true, light = PaintLight.Raking))\n\n    val wet = canvas.wetMm3\n    // a straw, blown along a curve through the film\n    val path = FLine().moveTo(150, 480).cubicTo(350, 250, 600, 600, 850, 300)\n    val blown = canvas.blow(path, radius = 14.0, pressure = 0.9, tendril = 9.0)\n    display(\"main\", canvas.png(wet = true, light = PaintLight.Raking))\n    markdown(\n        \"blow moved %.1f mm³ at %d places, branching %.2f; wet paint %.2f mm³ before, %.2f after\"\n            .format(blown.movedMm3, blown.stations, blown.branching, wet, canvas.wetMm3),\n    )\n}\n"} "preamble" "" "nested" #{}}} {"id" "paint_blow_contrast" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Paint — one puff, three viscosity contrasts" "_tombstone" false "frame" #afield/rect [80.0 2400.0 340.0 100.0] "code" #afield/file-inline {"path" "paint_blow_contrast_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n\n    val canvas = PaintCanvas(900, aspect = 2.4, seed = 12)\n    val brush = canvas.brush(BrushKind.HogFlat, width = 130.0)\n    brush.load(rgb(0.1, 0.18, 0.55), amount = 5.0, stiff = 0.3)\n    for (y in listOf(140, 260)) canvas.stroke(FLine().moveTo(60, y).lineTo(940, y), brush, pressure = 1.0..1.0)\n    val report = StringBuilder()\n    for ((x, contrast) in listOf(170.0 to 1.5, 500.0 to 8.0, 830.0 to 200.0)) {\n        val b = canvas.blow(\n            FLine().moveTo(x, 200).lineTo(x + 2, 200),\n            radius = 16.0,\n            pressure = 1.0,\n            contrast = contrast,\n            tendril = 8.0,\n        )\n        report.append(\"contrast %.1f: branching %.2f  \\n\".format(contrast, b.branching))\n    }\n    display(\"main\", canvas.png(wet = true, light = PaintLight.Raking))\n    markdown(report.toString())\n}\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "paint_blow" #afield/box "paint_blow_contrast"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorph