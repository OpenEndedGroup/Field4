{"version" 2 "boxes" [{"id" "path_trace_renderer" "properties" {"children" #{#afield/box "path_trace_glass"} "parents" #{#afield/box "root"} "name" "path tracing renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 320.0 110.0] "code" #afield/file-inline {"path" "path_trace_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nonce.renderer {\n    window = Window(\"Field · Path tracing\")\n    Renderer(window)\n}\nstart(renderer::run)\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "path_trace_glass" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "path_trace_renderer"} "name" "glass material study" "_tombstone" false "frame" #afield/rect [320.0 180.0 350.0 120.0] "code" #afield/file-inline {"path" "path_trace_glass_code_.kt" "inline" "import afield.graphics.scene.fabricated.PathTraceGlassDemo\nimport afield.graphics.scene.fabricated.PathTracingRenderer\nimport java.io.File\n\nprop<PathTracingRenderer>(tracer)\ntracer = PathTraceGlassDemo.install(\n    renderer,\n    width = 1280,\n    height = 720,\n    environmentPath = File(\"public/docs/assets/fabricate_demo/venice_sunset_1k.exr\").absolutePath,\n)\ntracer.samplesPerFrame = 1\ntracer.maxBounces = 10\ntracer.exposure = 1.5f\nprintln(\"${tracer.backend}: ${tracer.triangleCount} triangles, ${tracer.width} x ${tracer.height}\")\ntracer.blitToScreen()\n// This coroutine only announces capture readiness; the named scene owns the tracer.\nframes {\n    while (tracer.samples < 2048) {\n        frame()\n    }\n    println(\"glass study converged: ${tracer.samples} samples\")\n}\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "path_trace_renderer" #afield/box "path_trace_glass"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode