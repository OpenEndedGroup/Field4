{"version" 2 "boxes" [{"id" "contour_tree_landscape" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - A landscape and its contour tree" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 120.0] "code" #afield/file-inline {"path" "contour_tree_landscape_code_.kt" "inline" "import afield.geometry.topology.trees.*\n\n// Seven hills and three hollows. Drag the slider to prune branches shorter than its persistence.\nval bumps = [\n    Triple(40.0, 40.0, 1.0),\n    Triple(150.0, 35.0, 0.8),\n    Triple(100.0, 80.0, 0.6),\n    Triple(30.0, 120.0, 0.7),\n    Triple(170.0, 120.0, 0.9),\n    Triple(120.0, 130.0, 0.5),\n    Triple(70.0, 60.0, 0.45),\n    Triple(100.0, 30.0, -0.5),\n    Triple(60.0, 100.0, -0.4),\n    Triple(150.0, 80.0, -0.45),\n]\nval field =\n    Img.generate(200, 150) { x, y ->\n        bumps.sumOf { (cx, cy, a) -> a * exp(-((x - cx).pow(2) + (y - cy).pow(2)) / 300.0) }.toFloat()\n    }\nval full = ContourTrees.contourTree(field)\n\nfun show(persistence: Double) {\n    val tree = full.simplify(persistence)\n    val dots = fline {\n        tree.nodes.forEach { moveTo(it.x, it.y) }\n        pointed = true\n        pointSize = 5.0\n    }\n    val plot =\n        Img(200, 150, 3, FloatArray(200 * 150 * 3)).drawFLines(tree.plot(200.0, 150.0, margin = 15.0), scale = 2.0)\n    showImgGrid(\n        \"field: ${tree.nodes.size} nodes\" to\n            field.normalized().colormap(\"viridis\").drawFLines([dots], scale = 2.0, color = Vec4(1f, 1f, 1f, 1f)),\n        \"regions: ${tree.arcs.size} arcs\" to tree.segmentationImage().scaleBy(2.0),\n        \"tree\" to plot,\n        columns = 3,\n        cellSide = 300,\n    )\n}\nslider(\"persistence\", min = 0.0, max = 0.5, step = 0.005, initialValue = 0.03) { show(it) }\nshow(0.03)\n"} "preamble" "" "nested" #{}}} {"id" "contour_tree_photo" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - A photograph's contour-tree regions" "_tombstone" false "frame" #afield/rect [560.0 60.0 420.0 120.0] "code" #afield/file-inline {"path" "contour_tree_photo_code_.kt" "inline" "import afield.geometry.topology.trees.*\n\n// The leaf print's brightness, divided into the regions of its contour tree, lightly and strongly simplified.\nval print = imgFromFile(\"public/docs/assets/vision/fline-viewer.jpg\", 3).crop(78, 262, 128, 236)\nval tree = ContourTrees.contourTree(print.luma().gaussianBlur(1.5))\nval light = tree.simplify(persistence = 0.01)\nval strong = tree.simplify(persistence = 0.05)\nshowImgGrid(\n    \"photograph\" to print.scaleBy(2.0),\n    \"${light.arcs.size} arcs\" to light.segmentationImage().scaleBy(2.0),\n    \"${strong.arcs.size} arcs\" to strong.segmentationImage().scaleBy(2.0),\n    columns = 3,\n    cellSide = 260,\n)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "contour_tree_landscape" #afield/box "contour_tree_photo"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot