{"version" 2 "boxes" [{"id" "dl_ratios" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5 · Ratio per sentence, five texts" "_tombstone" false "frame" #afield/rect [0.0 1400.0 450.0 100.0] "code" #afield/file-inline {"path" "dl_ratios_code_.kt" "inline" "import afield.graphics.text.sentences.*\n\nval texts = SentenceTexts.all()\ndisplay(\n    \"ratios\",\n    violin(\n        *texts.map { t -> t.key to t.measure().filter { it.length >= 8 }.map { it.ratio } }.toTypedArray(),\n        references = List(texts.size) { 1.0 },\n        yTitle = \"as written ÷ free random mean\",\n    ),\n)\n"} "preamble" "" "nested" #{}}} {"id" "dl_gettysburg" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 · Gettysburg, sentence by sentence" "_tombstone" false "frame" #afield/rect [900.0 0.0 450.0 100.0] "code" #afield/file-inline {"path" "dl_gettysburg_code_.kt" "inline" "import afield.graphics.text.sentences.*\n\nval text = SentenceTexts.load(\"gettysburg\")\nval ratioFont = font(\"Serif\", 18.0)\nval openingFont = font(\"Serif\", 13.0)\nvar y = 0.0\nval figure =\n    text.measure().flatMap { m ->\n        // The arcs start at x = 270, leaving a column for the ratio and the opening words.\n        val row =\n            m.tree.arcLines(at = P(270.0, y), spacing = 8.0, depth = 0.3) +\n                outlinedText(m.ratio.f2, P(0.0, y + 6), ratioFont) +\n                outlinedText(m.tree.words.take(4).joinToString(\" \") + \" …\", P(50.0, y + 5), openingFont)\n        y += m.tree.arcDepth(spacing = 8.0, depth = 0.3) + 30.0\n        row\n    }\ndisplay(\"figure\", figureSvg(figure))\n"} "preamble" "" "nested" #{}}} {"id" "dl_table" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 · Five texts side by side" "_tombstone" false "frame" #afield/rect [900.0 700.0 450.0 100.0] "code" #afield/file-inline {"path" "dl_table_code_.kt" "inline" "import afield.graphics.text.sentences.*\n\nval rows =\n    SentenceTexts.all().map { t ->\n        val m = t.measure()\n        val observed = m.sumOf { it.lengths.observed }.toDouble()\n        \"| ${t.title} | ${m.size} | %.1f | %.2f | %.2f | %.2f | %.0f%% |\"\n            .format(\n                m.map { it.length }.average(),\n                observed / m.sumOf { it.lengths.freeMean },\n                observed / m.sumOf { it.lengths.fixedOrderMean },\n                observed / m.sumOf { it.lengths.optimal },\n                100.0 * m.count { it.lengths.observed < it.lengths.freeMean } / m.size,\n            )\n    }\nmarkdown(\n    \"\"\"\n    | text | sentences | mean words | ÷ free random | ÷ fixed order | ÷ shortest | shorter than chance |\n    | --- | ---: | ---: | ---: | ---: | ---: | ---: |\n    ${rows.joinToString(\"\\n    \")}\"\"\".trimIndent(),\n)\n"} "preamble" "" "nested" #{}}} {"id" "dl_growth" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 · Length against sentence length" "_tombstone" false "frame" #afield/rect [0.0 700.0 450.0 100.0] "code" #afield/file-inline {"path" "dl_growth_code_.kt" "inline" "import afield.graphics.text.sentences.*\nimport space.kscience.plotly.*\nimport space.kscience.plotly.models.ScatterMode\n\nval measured = SentenceTexts.all().flatMap { it.measure() }\nval words = measured.map { it.length }\nval series = [\n    \"free random reordering (mean of 100)\" to measured.map { it.lengths.freeMean },\n    \"fixed order random reordering (mean of 100)\" to measured.map { it.lengths.fixedOrderMean },\n    \"as written\" to measured.map { it.lengths.observed.toDouble() },\n    \"shortest possible\" to measured.map { it.lengths.optimal.toDouble() },\n]\nval plot = Plotly.plot {\n    for ((name, values) in series) {\n        scatter {\n            this.name = name\n            x.set(words)\n            y.set(values)\n            mode = ScatterMode.markers\n            marker { size = 4.0 }\n        }\n    }\n    layout {\n        title = \"Total dependency length, ${measured.size} sentences from five texts\"\n        xaxis { title = \"words in the sentence\" }\n        yaxis { title = \"total dependency length\" }\n    }\n}\nplot.darkMode()\n// darkMode() places the legend beside the plot; put it inside, over the empty upper left.\nplot.layout {\n    legend {\n        x = 0.02\n        y = 0.98\n    }\n}\ndisplay(plot)\n"} "preamble" "" "nested" #{}}} {"id" "dl_reorderings" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 · One sentence and its reorderings" "_tombstone" false "frame" #afield/rect [0.0 0.0 450.0 100.0] "code" #afield/file-inline {"path" "dl_reorderings_code_.kt" "inline" "import afield.graphics.text.sentences.*\n\n// \"It is altogether fitting and proper that we should do this\", without its full stop.\nval tree = SentenceTexts.load(\"gettysburg\").sentences[4].tree()!!\nval rng = java.util.Random(5)\nval rows =\n    listOf(\"as spoken\" to tree.observed) +\n        (1..3).map { \"shuffled\" to Linearization.freeRandom(tree, rng) } +\n        listOf(\"shortest\" to Linearization.optimal(tree))\n\nval caption = font(\"Serif\", 30.0)\nvar y = 0.0\nval figure = rows.flatMap { (name, order) ->\n    val d = SentenceDiagram().use(tree.sentence(order))\n    d.scheme = Scheme.UD\n    d.wordFont = font(\"Serif\", 30.0)\n    d.wordGap = 22.0\n    d.heights = Heights.Flat(y)\n    d.arcLabels = false\n    d.x0 = 250.0\n    val f = d.flines()\n    // Keep the words and the arcs; the constituency tree is a stand-in for a reordered sentence.\n    val arcs =\n        f.copy(treeEdges = emptyList(), wordEdges = emptyList(), texts = f.texts.filter { it.kind == TextKind.WORD })\n    val label = outlinedText(\"$name  ${tree.length(order)}\", P(0.0, y), caption)\n    y = d.diagram().bounds.y1 + 60.0\n    arcs.everything() + label\n}\ndisplay(\"figure\", figureSvg(figure))\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "dl_reorderings" #afield/box "dl_gettysburg" #afield/box "dl_growth" #afield/box "dl_table" #afield/box "dl_ratios"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}