{"version" 2 "boxes" [{"id" "ordered_group_demo" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Ordered group keyframes" "_tombstone" false "frame" #afield/rect [40.0 40.0 480.0 100.0] "code" #afield/file-inline {"path" "ordered_group_demo_code_.kt" "inline" "import afield.animation.keyframes.OrderedKeyframeGroup\nimport afield.document.workspace.FileManager\nimport afield.study.source.SourceBackedFunction\n\n// An inherited property stays dynamic after source-only rehydration.\nprop<Double>(ruleOffset) = 0.1\nval group =\n    OrderedKeyframeGroup({ 5 }, sourceBoxId = thisBox.id) { resolved ->\n            println(\"Applied: \" + resolved.values(\"cooling\"))\n        }\n        .lane(\"cooling\", 0.0) { it in 0.0..1.0 }\nval a = group.capture()\nval cooling = sourceBlock { screenNo: Int ->\n    val ramp = 0.04 * screenNo\n    ruleOffset + ramp\n}\ngroup[\"cooling\"] = cooling\nval b = group.capture()\nval directory = FileManager.current().path(\"%document/keys/ordered-demo\")\nb.save(directory.resolve(\"wave\"))\nval restored = group.scope.loadKey(directory.resolve(\"wave\"))\ngroup.apply(restored)\ncheck(kotlin.math.abs(group.resolve()[\"cooling\", 4] - .26) < 1e-9)\nruleOffset = .2\ncheck(kotlin.math.abs(group.resolve()[\"cooling\", 4] - .36) < 1e-9)\n\n// Blend outputs at each index, not the syntax of their programs. Save the midpoint too.\nval middle = group.blend(a, restored) { .5 }\nmiddle.save(directory.resolve(\"midpoint\"))\nval reloadedMiddle = group.scope.loadKey(directory.resolve(\"midpoint\"))\ncheck(kotlin.math.abs(group.resolve(reloadedMiddle)[\"cooling\", 4] - .18) < 1e-9)\nval stagger = group.transition(a, b, seconds = .75, durationSeconds = 1.0, staggerSeconds = .25)\ngroup.apply(stagger)\ncheck(group.resolve()[\"cooling\", 4] == 0.0)\n\n// Each endpoint retains its own box's inherited context across a saved blend.\nval other = SourceBackedFunction<Int, Double>(\n    \"ordered_group_other\",\n    \"{ index: Int -> otherOffset + 0.02 * index }\",\n)\nval crossContext = group.blend(restored, group.scope.Key(\"cooling\" to other)) { .5 }\ncrossContext.save(directory.resolve(\"cross-context\"))\ncheck(\n    kotlin.math.abs(group.resolve(group.scope.loadKey(directory.resolve(\"cross-context\")))[\"cooling\", 4] - .37) < 1e-9,\n)\n\n// All indices validate before any writes. Keep the previous rules on failure.\nval previous = group.capture()\nval failure = runCatching {\n    group[\"cooling\"] = sourceBlock { screenNo: Int -> if (screenNo == 4) Double.NaN else .2 }\n}\n        .exceptionOrNull()!!\ncheck(failure.message!!.contains(\"index 4\"))\ncheck(group.capture().values == previous.values)\nmarkdown(\n    \"result\",\n    \"\"\"\n### Ordered keyframes passed\nFive members, typed function source, inherited property access, native save/reload,\na saved pointwise midpoint, stagger and rejection of a non-finite final member.\n\"\"\",\n)\n"} "preamble" "var Box.ruleOffset by Inheritance<Double>() /**/\nval Once.ruleOffset by Onceing<Double>() /**/\nval Why.ruleOffset by Whying() /**/" "nested" #{}}} {"id" "ordered_group_other" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Another rule context" "_tombstone" false "frame" #afield/rect [40.0 0.0 480.0 30.0] "code" #afield/file-inline {"path" "ordered_group_other_code_.kt" "inline" "prop<Double>(otherOffset) = 0.3\n"} "preamble" "var Box.otherOffset by Inheritance<Double>() /**/\nval Once.otherOffset by Onceing<Double>() /**/\nval Why.otherOffset by Whying() /**/" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "ordered_group_other" #afield/box "ordered_group_demo"} "parents" #{} "name" "root" "nested" #{} "fileManagerAccessHistory" [{"index" 1 "time" 1794344400162 "access" "path" "request" "%document/keys/ordered-demo" "resolvedPath" "/tmp/field-doc-publications-9ck_2lql/workspace/ordered_group_keyframes/files/keys/ordered-demo" "source" "document" "exists" false "box" "ordered_group_demo" "boxName" "Ordered group keyframes"}]}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}