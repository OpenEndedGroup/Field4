{"version" 2 "boxes" [{"id" "tree_growth" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Trees that compete for light" "_tombstone" false "frame" #afield/rect [60.0 60.0 360.0 100.0] "code" #afield/file-inline {"path" "tree_growth_code_.kt" "inline" "// One tree, 30 seasons. Each step() is one season: shadow, light, Borchert-Honda allocation,\n// growth and shedding.\nval tree = TreeGrowth(seed = 4L)\nval seasons = [2, 5, 10, 20, 30]\nval strip = ArrayList<Pair<String, Img>>()\nvar views: List<Pair<String, Img>> = []\nfor (s in 1..30) {\n    tree.step()\n    if (s in seasons)\n        strip.add(\"season \" + s + \": \" + tree.nodeCount + \" metamers\" to tree.render(TreeView.STRUCTURE, 3))\n    if (s == 20) {\n        views = [\n            \"season 20: bud light\" to tree.render(TreeView.LIGHT, 3),\n            \"resource flow (log)\" to tree.render(TreeView.RESOURCE, 3),\n            \"shadow grid\" to tree.render(TreeView.SHADOW, 3),\n        ]\n    }\n}\nprintln(tree)\nprintln(\"a tree (one root, n-1 edges, acyclic): \" + tree.isTree())\n\n// Borchert-Honda only ever splits, so what reaches the buds is what the root was given.\nprintln(\n    \"worst resource conservation error over 30 seasons: \" + \"%.1e\".format(tree.history.maxOf { it.conservationError }),\n)\nval last = tree.history.last()\nprintln(\n    \"season 30: \" +\n        last.buds +\n        \" buds read \" +\n        last.baseLight.f6 +\n        \" units of light; root gets \" +\n        last.baseResource.f6,\n)\n\n// Apical control: the same seed, four values of lambda.\nval lambdas = [0.44, 0.5, 0.56, 0.62]\nval crowns = lambdas.map { lam ->\n    val t = TreeGrowth(params = TreeGrowthParams(lambda = lam), seed = 4L).stepTimes(30)\n    val xs = (0 until t.nodeCount).map { t.x(it) }\n    val ys = (0 until t.nodeCount).map { t.y(it) }\n    println(\n        \"λ = \" +\n            lam +\n            \": \" +\n            t.nodeCount +\n            \" metamers, crown \" +\n            (xs.max() - xs.min()).f0 +\n            \" wide, \" +\n            (ys.max() - ys.min()).f0 +\n            \" tall\",\n    )\n    \"lambda = \" + lam to t.render(TreeView.STRUCTURE, 3)\n}\n\nshowImg(montage(strip + views + crowns, columns = 5, cellSide = 300))\n"} "preamble" "" "nested" #{}}} {"id" "tree_growth_lambda" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Apical control on a slider" "_tombstone" false "frame" #afield/rect [460.0 60.0 360.0 100.0] "code" #afield/file-inline {"path" "tree_growth_lambda_code_.kt" "inline" "// Apical control, live: drag the slider and the same seed regrows for 30 seasons under that lambda.\n// 0.5 sends growth resource where the light is; above it the leader wins, below it the side branches.\nfun regrow(lam: Double) {\n    val t = TreeGrowth(params = TreeGrowthParams(lambda = lam), seed = 4L).stepTimes(30)\n    showImg(\n        montage(\n            [\n                \"lambda = \" + lam.f2 + \": \" + t.nodeCount + \" metamers\" to t.render(TreeView.STRUCTURE, 4),\n                \"bud light\" to t.render(TreeView.LIGHT, 4),\n            ],\n            columns = 2,\n            cellSide = 480,\n        ),\n    )\n}\nslider(\"apical control λ\", min = 0.40, max = 0.66, step = 0.01, initialValue = 0.5) { regrow(it) }\ndisplayOpen(\"controls\")\nregrow(0.5)\n"} "preamble" "" "nested" #{}}} {"id" "tree_growth_moving" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Thirty seasons, growing — launch me" "_tombstone" false "frame" #afield/rect [60.0 200.0 360.0 100.0] "code" #afield/file-inline {"path" "tree_growth_moving_code_.kt" "inline" "// Thirty seasons over seven seconds. TreeGrowth is mutable and step() returns it, so it is the\n// `step` here directly. render() frames the whole grid, so the tree grows inside a fixed frame.\nanimateEvolution(\n    TreeGrowth(seed = 4L),\n    totalSteps = 30,\n    seconds = 7.0,\n    columns = 2,\n    cellSide = 450,\n    step = { it.step() },\n    panels = { t, n ->\n        [\n            \"season \" + n + \": \" + t.nodeCount + \" metamers\" to t.render(TreeView.STRUCTURE, 4),\n            \"bud light, \" + t.shedMetamersTotal + \" shed\" to t.render(TreeView.LIGHT, 4),\n        ]\n    },\n)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "tree_growth" #afield/box "tree_growth_moving" #afield/box "tree_growth_lambda"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}