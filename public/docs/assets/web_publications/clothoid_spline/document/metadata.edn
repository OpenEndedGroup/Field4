{"version" 2 "boxes" [{"id" "clothoid-spline-shape" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - A closed round shape" "_tombstone" false "frame" #afield/rect [1020.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "clothoid-spline-shape_code_.kt" "inline" "val knots = [vec(60, 80), vec(200, 40), vec(330, 110), vec(300, 240), vec(170, 200), vec(80, 260)]\n\nval shape = clothoidSplineFrom(knots, closed = true).apply {\n    thickness = 3.0\n    color = vec(0.5, 0.8, 1.0, 1.0)\n}\nval fill = shape.copy().apply {\n    stroked = false\n    filled = true\n    color = vec(0.5, 0.8, 1.0, 0.15)\n}\nval comb = shape.curvatureComb(scale = 1200.0, samples = 200).apply { color = vec(1.0, 1.0, 1.0, 0.35) }\nval dots = polylineFrom(knots).apply {\n    stroked = false\n    pointed = true\n    pointSize = 2.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nlines(fill, comb, shape, dots, w = 420.0, h = 320.0, fitToSize = true)\n"} "preamble" "" "nested" #{}}} {"id" "clothoid-spline-vs-cubic" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Clothoid vs cubic, with combs" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "clothoid-spline-vs-cubic_code_.kt" "inline" "val knots = (0..7).map { i -> vec(40 + i * 50, 130 + 70 * kotlin.math.sin(i * 0.9)) }\n\nval cubic = cubicSplineFrom(knots).apply {\n    thickness = 3.0\n    color = vec(1.0, 0.7, 0.3, 1.0)\n}\nval clothoid = clothoidSplineFrom(knots).apply {\n    thickness = 3.0\n    color = vec(0.5, 0.8, 1.0, 1.0)\n}\n\nval cubicComb = cubic.curvatureComb(scale = 1500.0).apply { color = vec(1.0, 0.7, 0.3, 0.5) }\nval clothoidComb = clothoid.curvatureComb(scale = 1500.0).apply { color = vec(0.5, 0.8, 1.0, 0.5) }\n\n// curvature against distance, cubic above, clothoid below\nval cubicPlot = (cubic.curvaturePlot(400.0, 70.0, maxCurvature = 0.05) + vec(20, 240)).apply {\n    thickness = 2.0\n    color = vec(1.0, 0.7, 0.3, 1.0)\n}\nval clothoidPlot = (clothoid.curvaturePlot(400.0, 70.0, maxCurvature = 0.05) + vec(20, 320)).apply {\n    thickness = 2.0\n    color = vec(0.5, 0.8, 1.0, 1.0)\n}\n\nval dots = polylineFrom(knots).apply {\n    stroked = false\n    pointed = true\n    pointSize = 2.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nlines(cubicComb, clothoidComb, cubic, clothoid, dots, cubicPlot, clothoidPlot, w = 420.0, h = 400.0, fitToSize = true)\n"} "preamble" "" "nested" #{}}} {"id" "clothoid-spline-circle" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Points on a circle" "_tombstone" false "frame" #afield/rect [540.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "clothoid-spline-circle_code_.kt" "inline" "val knots =\n    (0 until 7).map { i ->\n        val a = 2 * kotlin.math.PI * i / 7 + 0.3 * kotlin.math.sin(i * 1.7)\n        vec(200 + 100 * kotlin.math.cos(a), 150 + 100 * kotlin.math.sin(a))\n    }\n\nval round = clothoidSplineFrom(knots, closed = true).apply {\n    thickness = 3.0\n    color = vec(0.5, 0.8, 1.0, 1.0)\n}\nval cubic = cubicSplineFrom(knots, closed = true).apply {\n    thickness = 1.5\n    color = vec(1.0, 0.7, 0.3, 0.9)\n}\nval comb = round.curvatureComb(scale = 2000.0, samples = 140).apply { color = vec(0.5, 0.8, 1.0, 0.4) }\n\nlines(comb, cubic, round, w = 420.0, h = 320.0, fitToSize = true)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "clothoid-spline-vs-cubic" #afield/box "clothoid-spline-circle" #afield/box "clothoid-spline-shape"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vert