{"version" 2 "boxes" [{"id" "clothoid-spline-end-directions" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5 - Fixed end directions" "_tombstone" false "frame" #afield/rect [540.0 220.0 420.0 100.0] "code" #afield/file-inline {"path" "clothoid-spline-end-directions_code_.kt" "inline" "val knots = [vec(100, 200), vec(180, 80), vec(260, 60), vec(330, 140)]\n\nval free = clothoidSplineFrom(knots).apply {\n    thickness = 1.5\n    color = vec(1.0, 0.7, 0.3, 0.9)\n}\nval joined = clothoidSplineFrom(knots, startDirection = vec(1, 0), endDirection = vec(70, 140)).apply {\n    thickness = 3.0\n    color = vec(0.5, 0.8, 1.0, 1.0)\n}\n\n// the straight lines the spline joins\nval leadIn = polylineFrom([vec(20, 200), vec(100, 200)]).apply { thickness = 3.0 }\nval leadOut = polylineFrom([vec(330, 140), vec(400, 280)]).apply { thickness = 3.0 }\n\nlines(leadIn, leadOut, free, joined, w = 420.0, h = 320.0, fitToSize = true)\n"} "preamble" "" "nested" #{}}} {"id" "clothoid-spline-shape" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - A closed round shape" "_tombstone" false "frame" #afield/rect [1020.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "clothoid-spline-shape_code_.kt" "inline" "val knots = [vec(60, 80), vec(200, 40), vec(330, 110), vec(300, 240), vec(170, 200), vec(80, 260)]\n\nval shape = clothoidSplineFrom(knots, closed = true).apply {\n    thickness = 3.0\n    color = vec(0.5, 0.8, 1.0, 1.0)\n}\nval fill = shape.copy().apply {\n    stroked = false\n    filled = true\n    color = vec(0.5, 0.8, 1.0, 0.15)\n}\nval comb = shape.curvatureComb(scale = 1200.0, samples = 200).apply { color = vec(1.0, 1.0, 1.0, 0.35) }\nval dots = polylineFrom(knots).apply {\n    stroked = false\n    pointed = true\n    pointSize = 2.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nlines(fill, comb, shape, dots, w = 420.0, h = 320.0, fitToSize = true)\n"} "preamble" "" "nested" #{}}} {"id" "clothoid-spline-vs-cubic" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Clothoid vs cubic, with combs" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "clothoid-spline-vs-cubic_code_.kt" "inline" "val knots = (0..7).map { i -> vec(40 + i * 50, 130 + 70 * kotlin.math.sin(i * 0.9)) }\n\nval cubic = cubicSplineFrom(knots).apply {\n    thickness = 3.0\n    color = vec(1.0, 0.7, 0.3, 1.0)\n}\nval clothoid = clothoidSplineFrom(knots).apply {\n    thickness = 3.0\n    color = vec(0.5, 0.8, 1.0, 1.0)\n}\n\nval cubicComb = cubic.curvatureComb(scale = 1500.0).apply { color = vec(1.0, 0.7, 0.3, 0.5) }\nval clothoidComb = clothoid.curvatureComb(scale = 1500.0).apply { color = vec(0.5, 0.8, 1.0, 0.5) }\n\n// curvature against distance, cubic above, clothoid below\nval cubicPlot = (cubic.curvaturePlot(400.0, 70.0, maxCurvature = 0.05) + vec(20, 240)).apply {\n    thickness = 2.0\n    color = vec(1.0, 0.7, 0.3, 1.0)\n}\nval clothoidPlot = (clothoid.curvaturePlot(400.0, 70.0, maxCurvature = 0.05) + vec(20, 320)).apply {\n    thickness = 2.0\n    color = vec(0.5, 0.8, 1.0, 1.0)\n}\n\nval dots = polylineFrom(knots).apply {\n    stroked = false\n    pointed = true\n    pointSize = 2.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nlines(cubicComb, clothoidComb, cubic, clothoid, dots, cubicPlot, clothoidPlot, w = 420.0, h = 400.0, fitToSize = true)\n"} "preamble" "" "nested" #{}}} {"id" "clothoid-spline-corners" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - Corners, a D and an S" "_tombstone" false "frame" #afield/rect [60.0 220.0 420.0 100.0] "code" #afield/file-inline {"path" "clothoid-spline-corners_code_.kt" "inline" "val d = clothoidSplineFrom(\n    [vec(40, 280), vec(40, 40), vec(130, 50), vec(190, 160), vec(130, 270)],\n    closed = true,\n    corners = [0, 1],\n).apply {\n    thickness = 4.0\n    color = vec(0.5, 0.8, 1.0, 1.0)\n}\nval s = clothoidSplineFrom(\n    [vec(370, 70), vec(300, 40), vec(250, 100), vec(320, 160), vec(370, 230), vec(310, 280), vec(240, 250)],\n).apply {\n    thickness = 4.0\n    color = vec(1.0, 0.7, 0.3, 1.0)\n}\nval dComb = d.curvatureComb(scale = 800.0, samples = 160).apply { color = vec(1.0, 1.0, 1.0, 0.35) }\nval sComb = s.curvatureComb(scale = 800.0, samples = 160).apply { color = vec(1.0, 1.0, 1.0, 0.35) }\n\nlines(dComb, sComb, d, s, w = 420.0, h = 320.0, fitToSize = true)\n"} "preamble" "" "nested" #{}}} {"id" "clothoid-spline-circle" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Points on a circle" "_tombstone" false "frame" #afield/rect [540.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "clothoid-spline-circle_code_.kt" "inline" "val knots =\n    (0 until 7).map { i ->\n        val a = 2 * kotlin.math.PI * i / 7 + 0.3 * kotlin.math.sin(i * 1.7)\n        vec(200 + 100 * kotlin.math.cos(a), 150 + 100 * kotlin.math.sin(a))\n    }\n\nval round = clothoidSplineFrom(knots, closed = true).apply {\n    thickness = 3.0\n    color = vec(0.5, 0.8, 1.0, 1.0)\n}\nval cubic = cubicSplineFrom(knots, closed = true).apply {\n    thickness = 1.5\n    color = vec(1.0, 0.7, 0.3, 0.9)\n}\nval comb = round.curvatureComb(scale = 2000.0, samples = 140).apply { color = vec(0.5, 0.8, 1.0, 0.4) }\n\nlines(comb, cubic, round, w = 420.0, h = 320.0, fitToSize = true)\n"} "preamble" "" "nested" #{}}} {"id" "clothoid-spline-heights" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "6 - Heights, a climbing path" "_tombstone" false "frame" #afield/rect [1020.0 220.0 420.0 100.0] "code" #afield/file-inline {"path" "clothoid-spline-heights_code_.kt" "inline" "// a path that climbs as it winds: x and y on the ground, z up\nval knots = [\n    vec(0, 0, 0),\n    vec(140, -30, 10),\n    vec(240, 40, 30),\n    vec(220, 150, 50),\n    vec(100, 180, 60),\n    vec(20, 120, 75),\n    vec(70, 60, 95),\n    vec(170, 80, 120),\n]\nval path = clothoidSplineFrom(knots, samplesPerSegment = 64)\n// its shadow on the ground is the flat spline through the same points\nval shadow = clothoidSplineFrom(knots.map { vec(it.x, it.y, 0) }, samplesPerSegment = 64)\n\n// a slanted view from above and to the side: x across, y going back, z up\nfun view(p: Vec3) = vec(p.x + 0.3 * p.y, 240 - 0.6 * p.y - p.z, 0)\n\nval drawnPath =\n    path\n        .transform { view(it) }\n        .apply {\n            thickness = 3.0\n            color = vec(0.5, 0.8, 1.0, 1.0)\n        }\nval drawnShadow =\n    shadow\n        .transform { view(it) }\n        .apply {\n            thickness = 1.5\n            color = vec(1.0, 1.0, 1.0, 0.35)\n        }\nval posts = knots.map { k ->\n    polylineFrom([view(vec(k.x, k.y, 0)), view(k)]).apply { color = vec(1.0, 0.7, 0.3, 0.8) }\n}\n\nval curves: List<FLine> = [drawnShadow, drawnPath]\nlines(posts + curves, w = 420.0, h = 320.0, fitToSize = true)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "clothoid-spline-vs-cubic" #afield/box "clothoid-spline-circle" #afield/box "clothoid-spline-shape" #afield/box "clothoid-spline-corners" #afield/box "clothoid-spline-end-directions" #afield/box "clothoid-spline-heights"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGr