{"version" 2 "boxes" [{"id" "pe-stacksl" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Partial evaluation — edit the program, rerun, read the residual" "_tombstone" false "frame" #afield/rect [40.0 180.0 320.0 100.0] "autorun" false "code" #afield/file-inline {"path" "pe-stacksl_code_.kt" "inline" "import afield.lang.stacksl.cpu.*\n\n// Edit this and rerun: the residual is re-derived from the program each time.\nval program = \"uv 4.0 * fbm palette saturate\"\n\nval source = StackSLCpu.expandStackAuto(StackSLCpu.stillTemplate(), program)\nval started = System.nanoTime()\nval residual = GlslPartialEvaluator.specialize(source)\nval specializeMs = (System.nanoTime() - started) / 1e6\n\n// The same picture twice: interpreted, then the residual's register program.\nval interpreted = StackSLCpu.renderFragment(source, 160, 160)\nval specialized = residual.render(160, 160)\nval identical = interpreted.rgba.indices.all { interpreted.rgba[it].toRawBits() == specialized.rgba[it].toRawBits() }\n\ndisplay(specialized.toPngBytes())\nprintln(\n    \"${source.lines().size} lines of GLSL -> ${residual.operationCount} residual operations in %.1f ms\"\n        .format(specializeMs),\n)\nprintln(\"bit-identical to the interpreter: $identical\")\nprintln(residual.operationHistogram().take(6).joinToString(\", \") { (op, n) -> \"$op $n\" })\nmarkdown(\"residual\", \"```glsl\\n\" + residual.toGlsl().lines().take(40).joinToString(\"\\n\") + \"\\n...\\n```\")\n"} "preamble" "" "nested" #{}}} {"id" "pe-power" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Partial evaluation — power(x, 5) becomes four multiplies" "_tombstone" false "frame" #afield/rect [40.0 40.0 320.0 100.0] "autorun" false "code" #afield/file-inline {"path" "pe-power_code_.kt" "inline" "import afield.lang.stacksl.cpu.*\n\n// n is known, x is not: the loop runs while specializing and only the multiplies remain.\nval exponent = 5\nval shader =\n    \"\"\"\n    #version 450\n    layout(location = 0) in vec2 fragUV;\n    layout(location = 0) out vec4 outColor;\n    float power(float x, int n) {\n        float r = 1.0;\n        for (int i = 0; i < n; i++) r *= x;\n        return r;\n    }\n    void main() { outColor = vec4(power(fragUV.x, $exponent), 0.0, 0.0, 1.0); }\"\"\".trimIndent()\n\nval residual = GlslPartialEvaluator.specialize(shader)\nmarkdown(\"residual\", \"```glsl\\n\" + residual.toGlsl() + \"```\")\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "pe-power" #afield/box "pe-stacksl"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isPostScriptRoot" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}