{"version" 2 "boxes" [{"id" "kirigami_deployed" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "the same solid, opened" "_tombstone" false "frame" #afield/rect [60.0 1600.0 420.0 90.0] "code" #afield/file-inline {"path" "kirigami_deployed_code_.kt" "inline" "import afield.examples.chain.KirigamiSolidChain\n\nval anglesDegrees: List<Double> = [0.0, 15.0, 30.0, 45.0]\nval closed = KirigamiSolidChain.measure(angle = 0.0)\nval stages = anglesDegrees.map { degrees ->\n    degrees to KirigamiSolidChain.measure(angle = Math.toRadians(degrees))\n}\nfor ((deg, m) in stages) {\n    val s = cos(m.angle) + sin(m.angle)\n    println(\n        \"%4.0f deg  genus %d  parts %d  hull area x%.3f  (cos+sin)^2 %.3f  hinge gap %.0e\"\n            .format(\n                deg,\n                m.genus,\n                m.parts,\n                m.hullArea / closed.hullArea,\n                s * s,\n                m.hingeGap,\n            ),\n    )\n}\n\nshowImgGrid(\n    *stages\n        .map { (deg, m) ->\n            \"${deg.toInt()} deg, genus ${m.genus}\" to\n                imgFromBytes(\n                    m.mesh.renderPng(\n                        MeshView(yawDegrees = 25.0, pitchDegrees = 40.0, distance = 2.7, width = 520, height = 520),\n                    ),\n                )\n        }\n        .toTypedArray(),\n    columns = 4,\n    cellSide = 300,\n)\n"} "preamble" "" "nested" #{}}} {"id" "kirigami_circle_solid" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "the sheet that opens into a circle, as a solid" "_tombstone" false "frame" #afield/rect [60.0 3200.0 420.0 90.0] "code" #afield/file-inline {"path" "kirigami_circle_solid_code_.kt" "inline" "import afield.examples.chain.KirigamiSolidChain\nimport afield.geometry.conformal.KirigamiInverseDesign\n\nval n = 8\nval narrowGap = 0.01\nval wideGap = 0.04\nwatchdog = 300 // The first inverse solve takes about half a minute.\nval design = cached(\"kirigami-circle-$n\") { KirigamiInverseDesign(n = n).solve() }\n\n// Sharp corners retreat further as the gap widens, so a hinge can miss its tile.\nval gaps: List<Double> = [narrowGap, wideGap]\nval measurements = gaps.map { KirigamiSolidChain.measureDesign(design, gap = it) }\nval rows =\n    gaps.zip(measurements).joinToString(\"\\n\") { (gap, pair) ->\n        val (closed, opened) = pair\n        \"| $gap | ${closed.genus} / ${opened.genus} | ${closed.predictedGenus} | \" +\n            \"${closed.parts} / ${opened.parts} | ${closed.watertight && opened.watertight} | \" +\n            \"${closed.volume.f4} / ${opened.volume.f4} | ${(opened.hullArea / closed.hullArea).f3} |\"\n    }\nmarkdown(\n    \"numbers\",\n    \"\"\"\n    Design residual ${\"%.1e\".format(design.residual)} after ${design.iterations} iterations.\n\n    | Half slit width | Genus (closed / open) | Predicted | Parts (closed / open) | Both watertight | Volume (closed / open) | Hull area ratio |\n    | --- | --- | --- | --- | --- | --- | --- |\"\"\".trimIndent() + \"\\n\" + rows,\n)\n\nval (shut, open) = measurements.first()\nfun view(m: KirigamiSolidChain.Measured) = imgFromBytes(\n    m.mesh.renderPng(MeshView(yawDegrees = 25.0, pitchDegrees = 40.0, distance = 2.7, width = 620, height = 520)),\n)\nshowImgGrid(\n    \"cut pattern, closed\" to view(shut),\n    \"opened onto the circle\" to view(open),\n    columns = 2,\n    cellSide = 420,\n)\n"} "preamble" "" "watchdog" 300.0 "nested" #{}}} {"id" "kirigami_cut_plate" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "the closed sheet, cut with hinges you can make" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 90.0] "code" #afield/file-inline {"path" "kirigami_cut_plate_code_.kt" "inline" "import afield.examples.chain.KirigamiSolidChain\n\nval n = 8\nval thickness = 0.1\nval gap = 0.04 // Half the slit width.\nval bridge = 0.12 // Hinge bar length along the cut.\nval plate = KirigamiSolidChain.measure(n, angle = 0.0, thickness = thickness, gap = gap, bridge = bridge)\n\nmarkdown(\n    \"numbers\",\n    \"\"\"\n    - ${plate.tiles} tiles, ${plate.hinges} hinges\n    - Genus ${plate.genus}, predicted by hinges − tiles + 1 = ${plate.predictedGenus}\n    - Parts: ${plate.parts}, watertight: ${plate.watertight}\n    - Volume ${plate.volume.f6} = area ${plate.sectionArea.f6} × thickness $thickness\"\"\".trimIndent(),\n)\n\nshowImgGrid(\n    \"the cut plate, $thickness thick\" to\n        imgFromBytes(\n            plate.mesh.renderPng(\n                MeshView(yawDegrees = 25.0, pitchDegrees = 40.0, distance = 2.7, width = 900, height = 600),\n            ),\n        ),\n    columns = 1,\n    cellSide = 600,\n)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "kirigami_cut_plate" #afield/box "kirigami_deployed" #afield/box "kirigami_circle_solid"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_