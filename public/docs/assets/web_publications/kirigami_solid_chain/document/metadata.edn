{"version" 2 "boxes" [{"id" "kirigami_deployed" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "the same solid, opened" "_tombstone" false "frame" #afield/rect [60.0 1600.0 420.0 90.0] "code" #afield/file-inline {"path" "kirigami_deployed_code_.kt" "inline" "import afield.examples.chain.KirigamiSolidChain\nimport kotlin.math.cos\nimport kotlin.math.sin\n\nval closed = KirigamiSolidChain.measure(angle = 0.0)\nval stages = listOf(0.0, 15.0, 30.0, 45.0).map { it to KirigamiSolidChain.measure(angle = Math.toRadians(it)) }\nfor ((deg, m) in stages) {\n    val s = cos(m.angle) + sin(m.angle)\n    println(\n        \"%4.0f deg  genus %d  parts %d  hull area x%.3f  (cos+sin)^2 %.3f  hinge gap %.0e\"\n            .format(\n                deg,\n                m.genus,\n                m.parts,\n                m.hullArea / closed.hullArea,\n                s * s,\n                m.hingeGap,\n            ),\n    )\n}\n\nshowImgGrid(\n    *stages\n        .map { (deg, m) ->\n            \"${deg.toInt()} deg, genus ${m.genus}\" to\n                imgFromBytes(\n                    m.mesh.renderPng(\n                        MeshView(yawDegrees = 25.0, pitchDegrees = 40.0, distance = 2.7, width = 520, height = 520),\n                    ),\n                )\n        }\n        .toTypedArray(),\n    columns = 4,\n    cellSide = 300,\n)\n"} "preamble" "" "nested" #{}}} {"id" "kirigami_circle_solid" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "the sheet that opens into a circle, as a solid" "_tombstone" false "frame" #afield/rect [60.0 3200.0 420.0 90.0] "code" #afield/file-inline {"path" "kirigami_circle_solid_code_.kt" "inline" "import afield.examples.chain.KirigamiSolidChain\nimport afield.geometry.conformal.KirigamiInverseDesign\n\nwatchdog = 300 // the solve takes about half a minute the first time; then it is cached\nval design = cached(\"kirigami-circle-8\") { KirigamiInverseDesign(n = 8).solve() }\nprintln(\"design residual %.1e after %d iterations\".format(design.residual, design.iterations))\n\n// Tiles here are as small as a third of a unit and as sharp as 0.4 rad, so the slit is narrower.\nfun report(gap: Double): List<String> {\n    val (shut, open) = KirigamiSolidChain.measureDesign(design, gap = gap)\n    return listOf(\n        \"gap $gap: closed genus ${shut.genus}, opened genus ${open.genus} (hinges - tiles + 1 = ${shut.predictedGenus})\",\n        \"  ${shut.parts} part closed, ${open.parts} opened, watertight ${shut.watertight && open.watertight}\",\n        \"  volume %.4f closed, %.4f opened; opened hull / closed hull %.3f\"\n            .format(shut.volume, open.volume, open.hullArea / shut.hullArea),\n    )\n}\nval lines = report(0.01) + report(0.04)\nlines.forEach { println(it) }\ndisplay(\"numbers\", \"<pre>${lines.joinToString(\"\\n\")}</pre>\")\n\nval (shut, open) = KirigamiSolidChain.measureDesign(design, gap = 0.01)\nfun view(m: KirigamiSolidChain.Measured) = imgFromBytes(\n    m.mesh.renderPng(MeshView(yawDegrees = 25.0, pitchDegrees = 40.0, distance = 2.7, width = 620, height = 520)),\n)\nshowImgGrid(\n    \"cut pattern, closed\" to view(shut),\n    \"opened onto the circle\" to view(open),\n    columns = 2,\n    cellSide = 420,\n)\n"} "preamble" "" "watchdog" 300.0 "nested" #{}}} {"id" "kirigami_cut_plate" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "the closed sheet, cut with hinges you can make" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 90.0] "code" #afield/file-inline {"path" "kirigami_cut_plate_code_.kt" "inline" "import afield.examples.chain.KirigamiSolidChain\n\n// gap: half a slit's width. bridge: how far each hinge bar runs along its cut.\nval n = 8\nval gap = 0.04\nval bridge = 0.12\nval plate = KirigamiSolidChain.measure(n, angle = 0.0, thickness = 0.1, gap = gap, bridge = bridge)\n\nval report = listOf(\n    \"${plate.tiles} tiles, ${plate.hinges} hinges\",\n    \"genus ${plate.genus}, and hinges - tiles + 1 = ${plate.predictedGenus}\",\n    \"${plate.parts} part, watertight=${plate.watertight}\",\n    \"volume %.6f = area %.6f x thickness 0.1\".format(plate.volume, plate.sectionArea),\n)\nreport.forEach { println(it) }\ndisplay(\"numbers\", \"<pre>${report.joinToString(\"\\n\")}</pre>\")\n\n// A three-quarter view from above; the CPU rasteriser needs no Window.\nshowImgGrid(\n    \"the cut plate, 0.1 thick\" to\n        imgFromBytes(\n            plate.mesh.renderPng(\n                MeshView(yawDegrees = 25.0, pitchDegrees = 40.0, distance = 2.7, width = 900, height = 600),\n            ),\n        ),\n    columns = 1,\n    cellSide = 600,\n)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "kirigami_cut_plate" #afield/box "kirigami_deployed" #afield/box "kirigami_circle_solid"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_s