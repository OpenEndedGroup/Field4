{"version" 2 "boxes" [{"id" "youtube_vr_renderer" "properties" {"children" #{#afield/box "youtube_vr_panel"} "parents" #{#afield/box "root"} "name" "window + renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 320.0 100.0] "code" #afield/file-inline {"path" "youtube_vr_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\nOptions.profiling = false\n// OpenXR is the default on its supported desktop platforms. macOS remains the stereo\n// preview/development path because it has no system OpenXR runtime.\nOptions.enableVR = !Options.isMac\n\nonce.renderer {\n    window = Window(\"YouTube · puppet browser\")\n    val created = Renderer(window)\n    if (Options.enableVR) {\n        created.openXRHmdTarget = afield.graphics.vulkan.targets.OpenXRHmdTarget(created)\n    }\n    created\n}\n\nprintln(\"YouTube VR renderer ready\")\nstart(renderer::run)\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "youtube_vr_panel" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "youtube_vr_renderer"} "name" "YouTube — interactive Chromium panel" "_tombstone" false "frame" #afield/rect [320.0 140.0 400.0 100.0] "code" #afield/file-inline {"path" "youtube_vr_panel_code_.kt" "inline" "import afield.graphics.vulkan.Target\nimport afield.media.browser.FieldUiBrowserTexture\nimport afield.media.browser.PuppetBrowser\nimport afield.media.browser.PuppetBrowserVrPanel\nimport afield.media.browser.PuppetBrowserWindowInput\n\n// Publish browser controls to connected boxes.\nprop<PuppetBrowser>(browserControl)\n\n// The producer is a full Chromium page, not an embed: consent, account state, player,\n// navigation and audio all behave as they do in an ordinary browser.\nval browser = FieldUiBrowserTexture(\n    renderer = renderer,\n    url = \"https://www.youtube.com/watch?v=aqz-KE-bpKQ\",\n    width = 1280,\n    height = 720,\n    // Linux: Chromium's shared-texture export never fills the buffer (electron#53271).\n    cpuBitmapFallback = FieldUiBrowserTexture.cpuBitmapFallbackRequired,\n)\nbrowserControl = browser\n\n// Import the newest cross-process frame before either eye samples the resident texture.\nrenderer.renderList.preTargets[\"youtube-browser-upload\"] = Target { command, _ ->\n    browser.prepareSampledImagesFor(command)\n}\n\nval stereo = SideBySideStereoTarget(renderer, openXR = renderer.openXRHmdTarget)\nval panel = PuppetBrowserVrPanel(\n    renderer = renderer,\n    stereo = stereo,\n    browser = browser,\n    widthMeters = 1.6f,\n    distanceMeters = 1.3f,\n    name = \"youtube-browser-panel\",\n)\npanel.build()\npanel.enableDesktopInteraction()\n\n// The controller owns pointer input. Once the panel has focus, physical keyboard/IME\n// events from Field's Window remain available for search boxes and other text fields.\nval keyboard = PuppetBrowserWindowInput(browser, renderer.window) { _, _ -> null }\nkeyboard.takeFocus()\n\n// Desktop mirror of the same stereo texture that can be handed to OpenXR eye swapchains.\nstereo.packed.blitToScreen(\n    renderer = renderer,\n    target = renderer.renderList,\n    name = \"youtube-stereo-screen\",\n)\n\nvar announced = false\nloop {\n    if (!announced && browser.pageReady) {\n        announced = true\n        println(\n            \"YouTube is live on a ${browser.spec.width}x${browser.spec.height} \" +\n                \"texture; trigger accepts consent and controls playback\",\n        )\n    }\n    frame()\n}\n    .end {\n        renderer.renderList.preTargets.remove(\"youtube-browser-upload\")\n        keyboard.close()\n        browser.close()\n    }\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "youtube_vr_renderer" #afield/box "youtube_vr_panel"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}