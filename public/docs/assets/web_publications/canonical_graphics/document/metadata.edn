>() /**/\nval Once.b0 by Onceing<RenderToTexture>() /**/\nvar Box.b1 by Inheritance<RenderToTexture>() /**/\nval Once.b1 by Onceing<RenderToTexture>() /**/\nvar Box.target by Inheritance<RenderToTexture>() /**/\nval Once.target by Onceing<RenderToTexture>() /**/\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/\nval Why.bbc by Whying() /**/\nval Why.back by Whying() /**/\n/*graphics-input:pos*/ val Mesh.pos by FromInput()\n/*graphics-input:tc*/ val Mesh.tc by FromInput()\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\nval Why.b0 by Whying() /*from:d1aa12a9-740c-4c2b-a05b-0e9a3aeed51c*/ /**/\nval Why.b1 by Whying() /*from:d1aa12a9-740c-4c2b-a05b-0e9a3aeed51c*/ /**/\nval Why.target by Whying() /*from:9a1f9aea-5940-4d4c-976f-85b650a9c2d7*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "autorun" false "frame" #afield/rect [1392.5234375 4345.5 280.0 100.0] "code" #afield/file-inline {"path" "d9733b9a-73a8-4045-a756-2a6e28e08c21_code_.kt" "inline" "/*\nDisplay the blur, the end of the blur chain (window -> 5. Bluring -> 5. kernel -> 5. draw blur).\n\nDraws a quad in the window textured with the kernel's output. A multi-layer target is sampled as a\nsampler2DArray; the fragment shader (open \"fragment\" in the property switcher) reads layer 1 of\n`back`, the layer the kernel's vertex shader writes to.\n*/\n\n// The whole kernel target, bound to the fragment shader's `bbc`.\nprop<RenderToTexture>(bbc) = b1\n// imageViewArray holds one view per colour attachment; [1] is the second attachment, the\n// channel-swapped copy of the blur.\nval other = b1.imageViewArray[1]\nprop<HasImageView>(back) = other\n\nvar module = moduleHere()\nvar mesh = Mesh()\nmodule += \"mainMesh\" to mesh\nrenderer += \"boo\" to module\n\nval camera = Camera()\n// The quad runs from (-1, -1) to (1, 1): close enough that it fills the window.\ncamera.at = vec(0, 0, -1.2)\nmesh.p = camera.p\nmesh.m = camera.m\n\nvar kc by keyCamera(camera = camera)\n// A textured quad from (-1, -1) to (1, 1).\nmesh.set(4, 2) {\n    val z = 0.0\n    pos.add(\n        -1,\n        -1,\n        z,\n        1.0,\n        -1.0,\n        z,\n        1,\n        1,\n        z,\n        -1.0,\n        1,\n        z,\n    )\n    tc.add(0, 0, 1, 0, 1, 1, 0, 1)\n    tri.add(0, 1, 2)\n    tri.add(0, 2, 3)\n}\n"} "vertex" #afield/file-inline {"path" "d9733b9a-73a8-4045-a756-2a6e28e08c21_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\nlayout (location = 1) in vec2 tc;\n\nlayout (location = 1) out vec2 ftc;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n    ftc = tc;\n}"} "fragment" #afield/file-inline {"path" "d9733b9a-73a8-4045-a756-2a6e28e08c21_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 1) in vec2 ftc;\n\nlayout(set=0, binding = 0) uniform sampler2DArray bbc;\nlayout(set=0, binding = 1) uniform sampler2DArray back;\n\nvoid main()\n{\n    // The third coordinate picks the array layer; the last argument is a mip bias.\n    vec4 c = texture(back, vec3(ftc.yx,1.0), 0.0);\n    uFragColor = vec4(c.rgb, 1.0);\n}\n"} "nested" #{}}} {"id" "51ac805d-ba4c-4d11