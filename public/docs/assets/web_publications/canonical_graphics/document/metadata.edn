st uint bin = uint(g_elements_in[elementId] >> g_shift) & uint(RADIX_SORT_BINS - 1);\n            // increment the histogram\n            atomicAdd(histogram[bin], 1U);\n        }\n    }\n    barrier();\n\n    if (lID < RADIX_SORT_BINS) {\n        g_histograms[RADIX_SORT_BINS * wID + lID] = histogram[lID];\n    }\n}\n"} "_tombstone" true "autorun" false "nested" #{}}} {"id" "2fdb0de0-3da4-4490-99d7-5747527745b7" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [21.00001148744002 -18.54544664414493 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "bd7daf7f-f352-46e5-b300-fc08869ce7c5" "properties" {"children" #{} "parents" #{} "name" "histo_0" "frame" #afield/rect [606.42578125 638.60546875 92.0 92.0] "code" #afield/file-inline {"path" "bd7daf7f-f352-46e5-b300-fc08869ce7c5_code_.kt" "inline" "prop<ComputeModulePointer>(module)\n\nmodule = computeModuleHere(\n    parameters {},\n)\n\nvar m = ComputeMesh()\nvar localSize = 256\nm.x = globalInvocationSize\nm.y = 1\nm.z = 1\nmodule += \"mainInvocation\" to m\n\n// renderer += \"runCompute_histo0\" to module // TODO, these should all be attached to a nice thing\n"} "preamble" "" "compute" #afield/file-inline {"path" "bd7daf7f-f352-46e5-b300-fc08869ce7c5_compute_.glsl" "inline" "#version 460\n\n#define WORKGROUP_SIZE 256 \n#define RADIX_SORT_BINS 256\n\nlayout (local_size_x = WORKGROUP_SIZE) in;\n\nlayout (push_constant, std430) uniform PushConstants {\n    uint g_num_elements;\n    uint g_shift;\n    uint g_num_workgroups;\n    uint g_num_blocks_per_workgroup;\n};\n\nlayout (std430, set = 0, binding = 0) buffer m_buffer0 {\n    uint g_elements_in[];\n};\n\nlayout (std430, set = 0, binding = 1) buffer m_buffer1 {\n    uint unused[];\n};\n\nlayout (std430, set = 1, binding = 0) buffer m_bufferHistogram {\n    // [histogram_of_workgroup_0 | histogram_of_workgroup_1 | ... ]\n    uint g_histograms[]; // |g_histograms| = RADIX_SORT_BINS * #WORKGROUPS\n};\n\nshared uint[RADIX_SORT_BINS] histogram;\n\nvoid main() {\n    uint gID = gl_GlobalInvocationID.x;\n    uint lID = gl_LocalInvocationID.x;\n    uint wID = gl_WorkGroupID.x;\n\n    // initialize histogram\n    if (lID < RADIX_SORT_BINS) {\n        histogram[lID] = 0U;\n    }\n    barrier();\n\n    for (uint index = 0; index < g_num_blocks_per_workgroup; index++) {\n        uint elementId = wID * g_num_blocks_per_workgroup * WORKGROUP_SIZE + index * WORKGROUP_SIZE + lID;\n        if (elementId < g_num_elements) {\n            // determine the bin\n            const uint bin = uint(g_elements_in[elementId] >> g_shift) & uint(RADIX_SORT_BINS - 1);\n            // increment the histogram\n            atomicAdd(histogram[bin], 1U);\n        }\n    }\n    barrier();\n\n    if (lID < RADIX_SORT_BINS) {\n        g_histograms[RADIX_SORT_BINS * wID + lID] = histogram[lID];\n    }\n}\n"} "_tombstone" true "autorun" false "nested" #{}}} {"id" "d1aa12a9-740c-4c2b-a05b-0e9a3aeed51c" "properties" {"children" #{#afield/box "d9733b9a-73a8-4045-a756-2a6e28e08c21"} "parents" #{#afield/box "root" #afield/box "9a1f9aea-5940-4d4c-976f-85b650a9c2d7"} "name" "5. kernel" "frame" #afield/rect [1392.5234375 3850.5 280.0 100.0] "preamble" "import afield.graphics.vulkan.targets.RenderToTexture\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nimport afield.graphics.vulkan.Renderer\nimport afield.graphics.vulkan.util.Window\nvar Box.b0 by Inheritance<RenderToTexture>() /**/\nval Once.b0 by Onceing<RenderToTexture>() /**/\nval Why.b0 by Whying() /**/\nvar Box.b1 by Inheritance<RenderToTexture>() /**/\nval Once.b1 by Onceing<RenderToTexture>() /**/\nval Why.b1 by Whying() /**/\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;     this.resize(numVert, numTriangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\n/*graphics-pc-structure:radius*/ var Structure.radius by Structure.FromStructure<Any>() // e.g., 5–8\n/*graphics-pc-binding:radius*/ var Mesh.radius by Mesh.BoundFromStructure<Number>() // e.g., 5–8\n/*graphics-pc-binding-group:radius*/ var MeshGroup.radius by MeshGroup.BoundFromStructure<Number>() // e.g., 5–8\n/*graphics-pc-structure:sigma*/ var Structure.sigma by Structure.FromStructure<Any>() // e.g., radius * 0.5–0.7\n/*graphics-pc-binding:sigma*/ var Mesh.sigma by Mesh.BoundFromStructure<Number>() // e.g., radius * 0.5–0.7\n/*graphics-pc-binding-group:sigma*/ var MeshGroup.sigma by MeshGroup.BoundFromStructure<Number>() // e.g., radius * 0.5–0.7\nvar Box.target by Inheritance<RenderToTexture>() /*from:9a1f9aea-5940-4d4c-976f-85b650a9c2d7*/ /**/\nval Once.target by Onceing<RenderToTexture>() /*from:9a1f9aea-5940-4d4c-976f-85b650a9c2d7*/ /**/\nvar Box.window by Inheritance<Window>() /*from:9a1f9aea-5940-4d4c-976f-85b650a9c2d7*/ /**/\nval Once.window by Onceing<Window>() /*from:9a1f9aea-5940-4d4c-976f-85b650a9c2d7*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:9a1f9aea-5940-4d4c-976f-85b650a9c2d7*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:9a1f9aea-5940-4d4c-976f-85b650a9c2d7*/ /**/\nval Why.target by Whying() /*from:9a1f9aea-5940-4d4c-976f-85b650a9c2d7*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "code" #afield/file-inline {"path" "d1aa12a9-740c-4c2b-a05b-0e9a3aeed51c_code_.kt" "inline" "/*\nBlur kernel, the middle of the blur chain (window -> 5. Bluring -> 5. kernel -> 5. draw blur).\n\nSamples the parent's checkerboard target and writes a horizontal Gaussian blur into a second\ntarget, `b1`, which the child box `5. draw blur` displays. Most of the lesson is in the shaders\n(open \"vertex\" and \"fragment\" in the property switcher): the vertex shader computes the Gaussian\nweights once per vertex, and the fragment shader takes seven symmetric taps and writes two\ncolour attachments at once.\n*/\n\n// The parent's `target`, republished under the name the fragment shader samples (`sampler2D b0`).\nprop<RenderToTexture>(b0) = target\n\n// Two colour attachments (one per fragment-shader output), each with two layers and a mip chain.\nprop<RenderToTexture>(b1) = RenderToTexture {\n    useDepth = false\n    mipLevels = 10\n    colorLayerCount = 2\n    colorAttachments = 2\n}\n\nrenderer.renderList += \"b1\" to b1\n\nvar module = moduleHere {\n    primitiveType = triangle_strip\n    depth = 0\n    +b1\n}\n\nvar m = Mesh()\nmodule += \"mainMesh\" to m\nb1 += \"boo\" to module\n\n// radius and sigma are the vertex shader's push constants; edit them live to change the blur.\nm.radius = { 10.0f }\nm.sigma = { 10.0f }\n// A fullscreen quad with no vertex data: four vertices drawn as a triangle strip, positions made in\n// the vertex shader from gl_VertexIndex.\nm.resize(4)\n"} "vertex" #afield/file-inline {"path" "d1aa12a9-740c-4c2b-a05b-0e9a3aeed51c_vertex_.glsl" "inline" "#version 450\n#extension GL_ARB_shader_viewport_layer_array : enable\n\nlayout (location = 0) out vec2 ftc;\nlayout (location = 1) out vec4 radii;\nlayout (location = 2) out vec4 weights;\n\n// Push constants, set from Kotlin as m.radius and m.sigma.\nlayout(push_constant) uniform BlurParams {\n    float radius; // e.g., 5–8\n    float sigma; // e.g., radius * 0.5–0.7\n} blur;\n\nfloat gauss(float x, float sigma) {\n    float s2 = sigma * sigma;\n    return exp(-x * x / (2.0 * s2));\n}\n\nvoid main()\n{\n    // Fullscreen quad corners in triangle-strip order; there are no vertex attributes.\n    const vec2 positions[4] = vec2[](\n    vec2(-1.0, -1.0),\n    vec2(1.0, -1.0),\n    vec2(-1.0, 1.0),\n    vec2(1.0, 1.0)\n    );\n\n    // The Gaussian weights are the same for every pixel, so compute them here, four times, rather than\n    // once per fragment, and pass them down.\n    float r1 = blur.radius * 0.275; // near\n    float r2 = blur.radius * 0.65; // mid\n    float r3 = blur.radius * 0.95; // far\n\n    float w0 = gauss(0.0, blur.sigma);\n    float w1 = gauss(r1, blur.sigma);\n    float w2 = gauss(r2, blur.sigma);\n    float w3 = gauss(r3, blur.sigma);\n    float norm = w0 + 2.0 * (w1 + w2 + w3);\n\n    radii = vec4(r1,r2,r3,norm);\n    weights = vec4(w0,w1,w2,w3);\n\n    vec2 p = positions[gl_VertexIndex];\n    gl_Position = vec4(p, 0.0, 1.0);\n    ftc = p * 0.5 + 0.5;\n\n    // Write into layer 1 of the layered target (needs GL_ARB_shader_viewport_layer_array).\n    gl_Layer = 1;\n}\n"} "fragment" #afield/file-inline {"path" "d1aa12a9-740c-4c2b-a05b-0e9a3aeed51c_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 1) out vec4 uFragColor1;\nlayout(location = 0) in vec2 ftc;\n\nlayout(set = 0, binding = 0) uniform sampler2D b0;\n\nlayout(location = 1) in vec4 radii;\nlayout(location = 2) in vec4 weights;\n\nvoid main()\n{\n    // Seven-tap horizontal Gaussian: the centre plus three symmetric pairs, at the radii and with the\n    // weights the vertex shader computed. radii.w is the sum of the weights, used to normalise.\n\n    vec2 texel = 1.0 / vec2(textureSize(b0, 0));\n    vec2 dx1 = texel * vec2(radii.x, 0.0);\n    vec2 dx2 = texel * vec2(radii.y, 0.0);\n    vec2 dx3 = texel * vec2(radii.z, 0.0);\n\n    vec4 c =\n    weights.x * texture(b0, ftc)\n    + weights.y * (texture(b0, ftc + dx1) + texture(b0, ftc - dx1))\n    + weights.z * (texture(b0, ftc + dx2) + texture(b0, ftc - dx2))\n    + weights.w * (texture(b0, ftc + dx3) + texture(b0, ftc - dx3));\n\n    uFragColor = vec4(c.rgb / radii.w, 1.0);\n    // A second output, one per colour attachment of b1; this one has red and blue swapped.\n    uFragColor1 = vec4(c.bgr / radii.w, 1.0);\n\n}\n"} "autorun" false "nested" #{}}} {"id" "995d0358-73a0-45ee-8da3-72ef6b13f5c6" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [-13.99998851255998 -171.54544664414493 100.0 100.0] "code" #afield/file-inline {"path" "995d0358-73a0-45ee-8da3-72ef6b13f5c6_code_.kt" "inline" "\n"} "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "b14e67a9-ce58-4013-99b4-99e7749838e0" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [-137.81817029133356 -138.63635640499058 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "ad857eaa-362e-45ea-bdc8-472af40f1ed2" "properties" {"children" #{#afield/box "262e80f5-d991-453d-9af8-8d181ff0eb0b"} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "3b. compute particles" "frame" #afield/rect [916.5234374999998 1870.5 280.0 100.0] "preamble" "import afield.graphics.vulkan.Renderer\nimport afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.buffers.FrameBufferGroup\nimport arrow.core.right\nimport arrow.core.left\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nvar Box.outputPositions by Inheritance<FrameBufferGroup>() /**/\nval Once.outputPositions by Onceing<FrameBufferGroup>() /**/\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/\n/*start*/\n/*compute-structure-type:inData:InData*/\nclass InData(\n    members: List<Introspected.Member> = InDataLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var a by Structure.FromStructure<afield.math.linalg.Vector4f>()\n}\nfun InDataByteSize(): Long = 16L\nfun InDataLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"a\", 0, PrimitiveType.vec4.left(), 16, false),\n    )\nfun HasBuffer.asInData(): InData =\n    asStructure(InData(), InDataLayoutMembers())\nfun BufferParameters.asInData(): InData =\n    buffer.asInData()\n/*end*/\n/*start*/\n/*compute-structure-type:outData:OutData*/\nclass OutData(\n    members: List<Introspected.Member> = OutDataLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var a by Structure.FromStructure<afield.math.linalg.Vector4f>()\n}\nfun OutDataByteSize(): Long = 16L\nfun OutDataLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"a\", 0, PrimitiveType.vec4.left(), 16, false),\n    )\nfun HasBuffer.asOutData(): OutData =\n    asStructure(OutData(), OutDataLayoutMembers())\nfun BufferParameters.asOutData(): OutData =\n    buffer.asOutData()\n/*end*/\n/*start*/\n/*compute-structure-type:FieldProbeBuffer:FieldProbeBuffer*/\nclass FieldProbeBuffer(\n    members: List<Introspected.Member> = FieldProbeBufferLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var enabled by Structure.FromStructure<UInt>()\n    var capacity by Structure.FromStructure<UInt>()\n    var ordinalStart by Structure.FromStructure<UInt>()\n    var ordinalEndExclusive by Structure.FromStructure<UInt>()\n    var invocationCount by Structure.FromStructure<UInt>()\n    var acceptedCount by Structure.FromStructure<UInt>()\n    var finiteCount by Structure.FromStructure<UInt>()\n    var typeTag by Structure.FromStructure<UInt>()\n    var nanCount by Structure.FromStructure<UInt>()\n    var infCount by Structure.FromStructure<UInt>()\n    var nonZeroCount by Structure.FromStructure<UInt>()\n    var typeMismatchCount by Structure.FromStructure<UInt>()\n    var minOrderedX by Structure.FromStructure<UInt>()\n    var minOrderedY by Structure.FromStructure<UInt>()\n    var minOrderedZ by Structure.FromStructure<UInt>()\n    var minOrderedW by Structure.FromStructure<UInt>()\n    var maxOrderedX by Structure.FromStructure<UInt>()\n    var maxOrderedY by Structure.FromStructure<UInt>()\n    var maxOrderedZ by Structure.FromStructure<UInt>()\n    var maxOrderedW by Structure.FromStructure<UInt>()\n    var samples by Structure.FromStructure<afield.math.linalg.Vector4f>()\n}\nfun FieldProbeBufferByteSize(): Long = 4194384L\nfun FieldProbeBufferLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"enabled\", 0, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"capacity\", 4, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"ordinalStart\", 8, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"ordinalEndExclusive\", 12, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"invocationCount\", 16, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"acceptedCount\", 20, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"finiteCount\", 24, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"typeTag\", 28, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"nanCount\", 32, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"infCount\", 36, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"nonZeroCount\", 40, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"typeMismatchCount\", 44, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"minOrderedX\", 48, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"minOrderedY\", 52, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"minOrderedZ\", 56, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"minOrderedW\", 60, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"maxOrderedX\", 64, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"maxOrderedY\", 68, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"maxOrderedZ\", 72, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"maxOrderedW\", 76, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"samples\", 80, PrimitiveType.vec4.left(), 16, false),\n    )\nfun HasBuffer.asFieldProbeBuffer(): FieldProbeBuffer =\n    asStructure(FieldProbeBuffer(), FieldProbeBufferLayoutMembers())\nfun BufferParameters.asFieldProbeBuffer(): FieldProbeBuffer =\n    buffer.asFieldProbeBuffer()\n/*end*/\n/*compute-pc-structure:inData*/ var Structure.inData by Structure.FromStructure<Any>()\n/*compute-pc-binding:inData*/ var ComputeMesh.inData by ComputeMesh.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*compute-pc-binding-group:inData*/ var ComputeMeshGroup.inData by ComputeMeshGroup.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*compute-pc-structure:outData*/ var Structure.outData by Structure.FromStructure<Any>()\n/*compute-pc-binding:outData*/ var ComputeMesh.outData by ComputeMesh.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*compute-pc-binding-group:outData*/ var ComputeMeshGroup.outData by ComputeMeshGroup.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*compute-pc-structure:something*/ var Structure.something by Structure.FromStructure<Any>()\n/*compute-pc-binding:something*/ var ComputeMesh.something by ComputeMesh.BoundFromStructure<Number>()\n/*compute-pc-binding-group:something*/ var ComputeMeshGroup.something by ComputeMeshGroup.BoundFromStructure<Number>()\n/*compute-pc-structure:count*/ var Structure.count by Structure.FromStructure<Any>()\n/*compute-pc-binding:count*/ var ComputeMesh.count by ComputeMesh.BoundFromStructure<Any>()\n/*compute-pc-binding-group:count*/ var ComputeMeshGroup.count by ComputeMeshGroup.BoundFromStructure<Any>()\n/*compute-ssbo:FieldProbeBuffer*/ val ComputeModulePointer.FieldProbeBuffer by ComputeMesh.FromUniform()\nval Why.outputPositions by Whying() /**/\nvar Box.particleCount by Inheritance<Int>() /**/\nval Once.particleCount by Onceing<Int>() /**/\nval Why.particleCount by Whying() /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "code" #afield/file-inline {"path" "ad857eaa-362e-45ea-bdc8-472af40f1ed2_code_.kt" "inline" "/*\n3b. compute particles\n\nA compute shader that moves 100,000 particles held in GPU buffers, and publishes the output buffer so a\nchild box (\"3b. draw particles\") can draw it straight from the GPU. Needs the renderer window box as its\nparent.\n\nThe shader is in the `compute` property (open it with the editor's property switcher, `f1` or `ctrl-P`).\nIt receives both buffers as buffer references in its push constants, and calls `fieldProbe` on one\nvalue per particle so the distribution of that value can be watched in this box's \"probe\" output.\n*/\n\n// A probe that samples up to 1000 values from the shader and shows them in the \"probe\" output channel\nfieldProbeHere(1000).display(\"probe\")\ndisplayOpen(\"probe\")\n\nvar module = computeModuleHere {}\n\nvar m = ComputeMesh()\n\nmodule += \"mainMesh\" to m\nrenderer += \"module\" to module\n\n// N sets the buffer sizes, so changing it reallocates them: stop the draw child first, rerun this box, then\n// rerun the draw box.\nval N = 100000\nvar inData = defaultBuffer {\n    size = N.vec4s\n}\n    .buffer\n\nvar outData = defaultBuffer {\n    size = N.vec4s\n}\n    .buffer\n\n// `m.inData`, `m.outData`, `m.something` and `m.count` match the push-constant members the compute shader\n// declares. Each is a lambda, evaluated again every time the shader is dispatched.\nm.inData = { inData }\n\nm.outData = { outData }\n\nvar x = 0.0\n\n// an animation clock for the shader, advanced on every dispatch\nm.something = {\n    x += 0.01\n    x.f\n}\n// Publish the output buffer and the particle count to every box beneath this one\nprop<FrameBufferGroup>(outputPositions) = outData\nprop<Int>(particleCount) = N\n\n// `count` is a uint in the shader; an Int lambda feeds it. The shader uses it to skip the extra invocations in\n// the last workgroup.\nm.count = { N }\n\n// Dispatch N / 64 workgroups, rounded up (the shader's `local_size_x` is 64)\nm.x = (N + 63) / 64\n\nm.y = 1\n\nm.z = 1\n\n// Random starting values: xy is the position, zw are per-particle rates used by the shader\ninData.write {\n    for (x in 0 until N) {\n        put(vec(Math.random(), Math.random(), Math.random(), Math.random()))\n    }\n}\n\n/*\nThe dispatch is recorded into a frame, so wait a couple of frames before reading the output back; reading\nstraight away would print the buffer before the shader has written it. `frames` runs only because it is the\nlast expression in the box.\n*/\nframes {\n    frame()\n    frame()\n    outData.read {\n        print(get())\n    }\n}\n"} "compute" #afield/file-inline {"path" "ad857eaa-362e-45ea-bdc8-472af40f1ed2_compute_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\nlayout(local_size_x = 64) in;\n\nlayout(std430, buffer_reference) buffer inData\n{\n    vec4 a[];\n};\n\nlayout(std430, buffer_reference) buffer outData\n{\n    vec4 a[];\n};\n\n// Inserts the probe's GLSL, which defines `fieldProbe(x)`\n{% property \"fieldProbe\" %}\n\n// Set from Kotlin through m.inData, m.outData, m.something and m.count\nlayout(push_constant) uniform dat {\n    inData inData;\n    outData outData;\n    float something;\n    uint count;\n} pc;\n\nvoid main() {\n    uint idx = gl_GlobalInvocationID.x;\n    // The dispatch is rounded up to whole workgroups; invocations past the last particle do nothing.\n    if (idx >= pc.count) return;\n    pc.outData.a[idx].x = pc.inData.a[idx].x*cos(pc.something*pc.inData.a[idx].z) + pc.inData.a[idx].y*sin(pc.something*pc.inData.a[idx].w);\n    pc.outData.a[idx].y = -pc.inData.a[idx].x*sin(pc.something*pc.inData.a[idx].w) + pc.inData.a[idx].y*cos(pc.something*pc.inData.a[idx].z*0.03);\n\n    // sample the new y for the probe display\n    fieldProbe(pc.outData.a[idx].y);\n\n    // carry the per-particle rates through; the draw box uses w as the particle's size\n    pc.outData.a[idx].zw = pc.inData.a[idx].zw;\n}\n"} "autorun" false "nested" #{}}} {"id" "aa1389d5-230a-48d8-b616-3bdec85cff51" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [516.00001148744 -245.54544664414493 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "92e4a943-1cc2-433c-9953-18e0107f3854" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "7b. slang — Texture" "frame" #afield/rect [2820.5234374999995 1870.5 280.0 100.0] "code" #afield/file-inline {"path" "92e4a943-1cc2-433c-9953-18e0107f3854_code_.kt" "inline" "/*\nSlang: texture. Run this in a box beneath the renderer (`window`) box.\n\nThis is the texturing lesson with its shaders written in Slang. They are in this box's\n`vertex_fragment` property (open it from the editor's property switcher); when it is non-blank it is\nused for both stages instead of the GLSL `vertex` and `fragment` properties. The Kotlin does not change:\nresources and push constants are matched by their reflected names, whatever the shader language.\n*/\n\n// The texture is bound by name: `bbc` matches `Sampler2D bbc` in the Slang source.\n// The bundled image makes the lesson runnable; change the path to try your own.\nprop<LoadedTexture>(bbc) = LoadedTexture(\"public/docs/assets/afield_four_graphics/docs-checker-texture.png\")\nbbc.transferNow()\n\nvar module = moduleHere {}\nvar m = Mesh()\n\nmodule += \"mainMesh\" to m\nrenderer += \"boo\" to module\n\n// the camera's projection and view matrices feed the shader's `p` and `m` push constants\nval camera = Camera()\n// The quad runs from (0, 0) to (1, 1): aim at its centre, close enough that it fills the window.\ncamera.at = vec(0.5, 0.5, -0.8)\ncamera.target = vec(0.5, 0.5, 0)\nm.p = camera.p\nm.m = camera.m\n\nvar kc by keyCamera(camera = camera)\n// one textured quad: 4 vertices, 2 triangles\nm.set(4, 2) {\n    val z = 0.0\n\n    pos.add(\n        0,\n        0,\n        0 + z,\n        1.0,\n        0.1,\n        z,\n        1,\n        1,\n        z,\n        0,\n        1,\n        z,\n    )\n\n    tc.add(\n        0,\n        0,\n        1,\n        0,\n        1,\n        1,\n        0,\n        1,\n    )\n\n    tri.add(0, 1, 2)\n    tri.add(0, 2, 3)\n}\n"} "preamble" "import afield.graphics.texture.LoadedTexture\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nimport afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\nvar Box.bbc by Inheritance<LoadedTexture>() /**/\nval Once.bbc by Onceing<LoadedTexture>() /**/\nval Why.bbc by Whying() /**/\n/*graphics-input:pos*/ val Mesh.pos by FromInput()\n/*graphics-input:tc*/ val Mesh.tc by FromInput()\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var pos : FloatBuffer; lateinit var tc : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"tc\") { tc = this ; mesh.write(\"pos\") { pos = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } } ;            };         }\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\nvar Box.window by Inheritance<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.window by Onceing<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "fragment" #afield/file-inline {"path" "92e4a943-1cc2-433c-9953-18e0107f3854_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 1) in vec2 ftc;\n\nlayout(set = 0, binding = 0) uniform sampler2D bbc;\nvoid main()\n{\n    vec4 c = texture(bbc, ftc.yx);\n    uFragColor = vec4(c.rgb/1.0, 1.0);\n}"} "vertex" #afield/file-inline {"path" "92e4a943-1cc2-433c-9953-18e0107f3854_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\nlayout (location = 1) in vec2 tc;\n\nlayout (location = 1) out vec2 ftc;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n    ftc = tc;\n}"} "metadata" #afield/file-inline {"path" "92e4a943-1cc2-433c-9953-18e0107f3854_metadata_.yaml" "inline" ""} "autorun" false "nested" #{} "vertex_fragment" #afield/file-inline {"path" "92e4a943-1cc2-433c-9953-18e0107f3854_vertex_fragment_.slang" "inline" "// Vertex (`vsMain`) and fragment (`fsMain`) stages for the texture lesson, in one Slang file.\n\n// vertex attributes: the `pos` and `tc` the box code fills with m.set { ... }\nstruct VertexInput\n{\n    [[vk::location(0)]]\n    float3 pos;\n\n    [[vk::location(1)]]\n    float2 tc;\n};\n\n// an entry point's `uniform` parameter becomes the push-constant block (`m.p`, `m.m` in the box code)\nstruct Matrices\n{\n    float4x4 p;\n    float4x4 m;\n};\n\nstruct Varyings\n{\n    float4 position : SV_Position;\n    float2 ftc : TEXCOORD0;\n};\n\n// bound by name to prop<LoadedTexture>(bbc) in the box code\n[[vk::binding(0, 0)]]\nSampler2D bbc;\n\n[shader(\"vertex\")]\nVaryings vsMain(VertexInput input, uniform Matrices pc)\n{\n    Varyings output;\n    output.position = mul(pc.p, mul(pc.m, float4(input.pos, 1.0)));\n    output.ftc = input.tc;\n    return output;\n}\n\n[shader(\"fragment\")]\nfloat4 fsMain(Varyings input) : SV_Target0\n{\n    float4 c = bbc.Sample(input.ftc.yx);\n    return float4(c.rgb, 1.0);\n}\n"} "source_id" "55bc1784-bc44-40eb-bc01-d02eca463445"}} {"id" "948d9365-b743-49d8-add0-0a690d90f65d" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [351.18182970866644 -191.63635640499058 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "d6bcef2b-3044-4ea8-97ad-c0354a542c71" "properties" {"children" #{} "parents" #{#afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "ssbo in graphics" "frame" #afield/rect [101.0908203125 398.2744140625 100.0 100.0] "code" #afield/file-inline {"path" "d6bcef2b-3044-4ea8-97ad-c0354a542c71_code_.kt" "inline" "var m = Mesh()\nvar module = moduleHere(\n    parameters {\n        ssboSizer = { ssbo ->\n            print(\"sizing ${ssbo}\")\n            256\n        }\n    },\n)\n\nmodule += \"mainMesh\" to m\nrenderer += \"boo\" to module\n\nval camera = Camera()\ncamera.at = vec(-10, 2, 0)\n\nvar tick = 0.0\n\nmodule.InputBuffer.mapAndWrite {\n    for (n in 0 until 20) {\n        this.put(0f)\n        this.put(n.toFloat() / 9)\n        this.put(-n.toFloat() / 2)\n    }\n}\n\nloop {\n    module.camera.m = camera.m()\n    module.camera.p = camera.p()\n\n    camera.at = vec(-10 * Math.sin(tick), 0, 10 * Math.cos(tick))\n\n    for (n in 1..4) {\n        m.set(3 * n, 1 * n) {\n            n {\n                val z = 0.0 + it\n                pos.put(0, 0, -1 + z, 1.0, 0.1, z, 1, 1, z)\n                3 {\n                    col.put(10 - it * 0, it / 3.0, 1 - it / 3.0, 1)\n                }\n                tri.put(0 + 3 * it, 1 + 3 * it, 2 + 3 * it)\n            }\n        }\n    }\n    frame()\n    tick += 0.01\n    true\n}\n"} "preamble" "" "fragment" #afield/file-inline {"path" "d6bcef2b-3044-4ea8-97ad-c0354a542c71_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 0) in vec4 fcol;\nvoid main()\n{\n    uFragColor = vec4(fcol.rgb, 1.0);\n}"} "vertex" #afield/file-inline {"path" "d6bcef2b-3044-4ea8-97ad-c0354a542c71_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\nlayout (binding = 0) uniform camera {\n    mat4 p;\n    mat4 m;\n} cam;\n\nlayout(binding = 1) buffer InputBuffer {\n    float inData[];\n};\n\nvoid main()\n{\n    vec3 p = pos;\n    p.x += inData[0+3*gl_VertexIndex];\n    p.y += inData[1+3*gl_VertexIndex]/2;\n    p.z += inData[2+3*gl_VertexIndex];\n    gl_Position = cam.p*cam.m*vec4(p, 1);\n\n    fcol = col;\n}"} "metadata" #afield/file-inline {"path" "d6bcef2b-3044-4ea8-97ad-c0354a542c71_metadata_.yaml" "inline" ""} "autorun" false "nested" #{} "_tombstone" true}} {"id" "ef0fe7bf-5617-49bd-b733-c1a8db1107a3" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [-255.81817029133356 10.363643595009421 100.0 100.0] "code" #afield/file-inline {"path" "ef0fe7bf-5617-49bd-b733-c1a8db1107a3_code_.kt" "inline" "\n"} "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "e3544d32-1735-429d-934c-3e33651b9ce1" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [390.0 617.0 100.0 100.0] "code" #afield/file-inline {"path" "e3544d32-1735-429d-934c-3e33651b9ce1_code_.kt" "inline" "\n"} "preamble" "var Box.bob by Inheritance<Int>()\nval Once.bob by Onceing<Int>()" "_tombstone" true "autorun" false "nested" #{}}} {"id" "a668c7bc-f2ef-4a6b-a055-63658ff11651" "properties" {"children" #{} "parents" #{} "name" "" "frame" #afield/rect [8.181829708666442 -281.6363564049906 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "cd63d465-dbe0-4e55-bccf-14c6a7f5e54a" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "6. radix sort" "frame" #afield/rect [2344.5234375 3850.5 280.0 100.0] "preamble" "import afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\nvar Box.window by Inheritance<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.window by Onceing<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "code" #afield/file-inline {"path" "cd63d465-dbe0-4e55-bccf-14c6a7f5e54a_code_.kt" "inline" "/*\nA GPU radix sort. Run this in a box beneath the renderer (`window`) box; it draws nothing.\n\n`GpuRadixSort` is a packaged set of compute passes. The lesson is how such work is scheduled: it is\nrecorded into the renderer's command buffer for a frame, not executed when this code runs.\n*/\n\nval sorter = GpuRadixSort()\n\n/*\nThe buffer builder states every use the buffer will have, and those flags decide which accesses are\nlegal later: `storage()` for shader reads and writes, `addressable()` for buffer references,\n`hosted()` so the CPU can map it, and `dest()` so it can be a transfer destination.\n*/\n\nvar sourceBuffer = buffer {\n    size = 200.ints\n    storage()\n    addressable()\n    hosted()\n    dest()\n}\n    .buffer\n\n// 200 keys in descending order: 2000, 1999, ... 1801\nsourceBuffer.write {\n    200 {\n        putInt(2000 - it)\n    }\n}\n\n/*\n`renderList.others` is a slot on the frame that hands you the command buffer to record into.\n`sorter.sort(command, ...)` records the sort there; it runs on the GPU when that frame is submitted,\nand, because the target stays installed, it runs again every frame.\n*/\nrenderer.renderList.others[\"sort\"] = Target { command, index ->\n    sorter.sort(command, sourceBuffer, 200)\n}\n\n/*\nThe sort runs when a frame is submitted, so wait a couple of frames, then read the first key back through\nthe host-visible memory and print it in the editor: 1801 once sorted (2000 before). `frames` runs only\nbecause it is the last expression in the box.\n*/\nframes {\n    frame()\n    frame()\n    sourceBuffer.read_ints {\n        _print(this.get(0))\n    }\n}\n"} "autorun" false "nested" #{}}} {"id" "1e40d523-5edb-43ae-ae47-9559390f5f00" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [252.94033813476562 576.6108093261719 101.81817626953125 101.81820678710938] "code" #afield/file-inline {"path" "1e40d523-5edb-43ae-ae47-9559390f5f00_code_.kt" "inline" "\n"} "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "2e799089-1d68-49e1-a7a6-d92030a2a02d" "properties" {"children" #{} "parents" #{} "name" "draw parts indirect" "frame" #afield/rect [1032.8125 274.6640625 94.0 94.0] "code" #afield/file-inline {"path" "2e799089-1d68-49e1-a7a6-d92030a2a02d_code_.kt" "inline" "var module = moduleHere(\n    parameters {\n        primitiveType = triangles\n    },\n)\n\nvar m = Mesh()\n\nmodule += \"mainMesh\" to m\nrenderer += \"boo2\" to module\n\nm.aspectRatio = { window.width / window.height.toFloat() }\nvar partNum = 2_560_000\n\nm.set(partNum * 2 * 3, 0) {\n    // done!\n}\n"} "preamble" "" "fragment" #afield/file-inline {"path" "2e799089-1d68-49e1-a7a6-d92030a2a02d_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 0) in vec2 tc;\n\nvoid main()\n{\n    float d = 1-1.8*length(tc-vec2(0.5));\n    d = smoothstep(0.1, 0.2, d);\n    uFragColor = vec4(0.0, 0.8, 1.0, d*0.1);\n}"} "vertex" #afield/file-inline {"path" "2e799089-1d68-49e1-a7a6-d92030a2a02d_vertex_.glsl" "inline" "#version 450\nlayout(set=0, binding = 0) buffer VertexData {\n    vec4 dat[];\n};\n\nlayout(location = 0) out vec2 tc;\n\nlayout(push_constant) uniform push {\n    float aspectRatio;\n} pc;\n\nconst vec3[6] part = {\n    vec3(0,0,0),\n    vec3(1,0,0),\n    vec3(1,1,0),\n    vec3(0,0,0),\n    vec3(1,1,0),\n    vec3(0,1,0)\n};\n\n\nvoid main()\n{\n    float scale = max(0.05, 0.195*length(dat[gl_VertexIndex/6].wz))*0.03;\n    vec3 p = (part[gl_VertexIndex%6]-vec3(0.5, 0.5, 0))*scale;\n\n    p.xy += dat[gl_VertexIndex/6].xy*1000.0;\n    p.xy *= vec2(1/pc.aspectRatio, 1);\n    gl_Position = vec4(p*0.04, 1);\n\n    tc = part[gl_VertexIndex%6].xy;\n}"} "metadata" #afield/file-inline {"path" "2e799089-1d68-49e1-a7a6-d92030a2a02d_metadata_.yaml" "inline" ""} "autorun" false "nested" #{} "_tombstone" true}} {"id" "de832c1f-f451-4f99-8684-9f77df8f67d8" "properties" {"children" #{} "parents" #{} "name" "load ply" "frame" #afield/rect [144.203125 626.953125 98.0 98.0] "code" #afield/file-inline {"path" "de832c1f-f451-4f99-8684-9f77df8f67d8_code_.kt" "inline" "var table = readPlyAsFloatTable(\"/Users/marc/Desktop/lego_point_cloud_6999.ply\")\n_print(table.offsets)\n\nvar ll = listOf(\n    \"f_dc_0\",\n    \"f_dc_1\",\n    \"f_dc_2\",\n    \"opacity\",\n    \"scale_0\",\n    \"scale_1\",\n    \"scale_2\",\n    \"rot_0\",\n    \"rot_1\",\n    \"rot_2\",\n    \"rot_3\",\n    \"f_rest_0\",\n    \"f_rest_1\",\n    \"f_rest_2\",\n    \"f_rest_3\",\n    \"f_rest_4\",\n)\nvar buffer = table.subsetFloatBufferColumns(ll)\nvar pos = table.subsetFloatBufferColumns(listOf(\"x\", \"y\", \"z\", \"opacity\"))\n\nvar numPoints = buffer.limit() / 16\n\n/*\nnumPoints = 10\n(mat4?)\nxyz_rgba_sss_rrrr\n*/\n\nbuffer.limit(numPoints * 16)\npos.limit(numPoints * 4)\n\nprop<FloatBuffer>(splatBuffer) = buffer\nprop<FloatBuffer>(splatPos) = pos\nprop<Int>(splatNum) = numPoints\n\nparents.first().name = \"bob\"\n"} "preamble" "" "metadata" #afield/file-inline {"path" "de832c1f-f451-4f99-8684-9f77df8f67d8_metadata_.yaml" "inline" ""} "autorun" false "nested" #{} "_tombstone" true}} {"id" "1c723888-8b02-4da8-b6a3-64b915ae6b29" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "Texture2" "frame" #afield/rect [439.5 740.96484375 100.0 76.359375] "preamble" "" "code" #afield/file-inline {"path" "1c723888-8b02-4da8-b6a3-64b915ae6b29_code_.kt" "inline" "\n"} "metadata" #afield/file-inline {"path" "1c723888-8b02-4da8-b6a3-64b915ae6b29_metadata_.yaml" "inline" ""} "_tombstone" true "autorun" false "nested" #{}}} {"id" "6aab6f41-c2df-4d65-8032-2e9aee73b533" "properties" {"children" #{} "parents" #{#afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "radix" "frame" #afield/rect [450.38671875 549.3515625 98.0 61.59375] "code" #afield/file-inline {"path" "6aab6f41-c2df-4d65-8032-2e9aee73b533_code_.kt" "inline" "import org.joml.primitives.Rectanglef\n\nvar positions = buffer {\n    size = splatNum.vec4s\n    addressable()\n    hosted()\n}\n    .buffer\n\npositions.mapAndWrite {\n    this.put(splatPos)\n}\n\nvar dists = buffer {\n    size = splatNum.ints\n    addressable()\n    hosted()\n}\n    .buffer\n\nvar indices = buffer {\n    size = splatNum.ints\n    storage()\n    addressable()\n    hosted()\n}\n    .buffer\n\nvar indirectBuffer = buffer {\n    size = 8.ints\n    storage()\n    addressable()\n    hosted()\n    dest()\n}\n    .buffer\n\nprop<VulkanBuffer>(splatPositions) = positions\nprop<VulkanBuffer>(splatDistances) = dists\nprop<VulkanBuffer>(splatIndices) = indices\nprop<VulkanBuffer>(indirect) = indirectBuffer\n\nvar module = computeModuleHere(\n    parameters {},\n)\n\nvar m = ComputeMesh()\n\nmodule += \"zero\" to zeroBuffer(indirect)\nmodule += \"mainInvocation\" to m\n\nm.splatPositions = { positions }\nm.splatDistances = { dists }\nm.splatIndices = { indices }\nm.indirect = { indirectBuffer }\nm.splatNum = { splatNum }\nm.cameraPosition = { vec(0, 0, 0, 0) }\n\nvar workGroupSize = 32\nm.x = 1 + splatNum / workGroupSize\nm.y = 1\nm.z = 1\n\n// renderer += \"distanceCompute\" to module\nrenderer.computeList.others += \"distanceCompute\" to target { cmd, index -> }\n\nrenderer.computeList.others +=\n    \"distanceCompute\" to\n        target { cmd, index ->\n            module.render(cmd, Rectanglef())\n        }\n\nif (false) {\n    indirect.mapAndRead_ints {\n        print(this.get(1))\n    }\n\n    dists.mapAndRead_ints {\n        for (n in 0 until 10) {\n            System.out.println(get(n) - 1317050000)\n        }\n    }\n}\n"} "preamble" "" "compute" #afield/file-inline {"path" "6aab6f41-c2df-4d65-8032-2e9aee73b533_compute_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\nlayout(local_size_x = 32) in;\n\nlayout(std430, buffer_reference) buffer SplatPositions\n{\n    vec4 positions[];\n};\n\nlayout(std430, buffer_reference) buffer SplatIndices\n{\n    uint index[];\n};\n\nlayout(std430, buffer_reference) buffer SplatDistances\n{\n    float distance[];\n};\n\nlayout(std430, buffer_reference) buffer Indirect\n{\n    uint indexcount;\n    uint instanceCount;\n    uint firstIndex;\n    uint vertexOffset;\n    uint firstInstance;\n    uint instanceOffset;\n};\n\nlayout(push_constant) uniform push {\n    SplatPositions splatPositions;\n    SplatIndices splatIndices;\n    SplatDistances splatDistances;\n    Indirect indirect;\n    uint splatNum;\n    vec4 cameraPosition;\n} pc;\n\nuint encodeMinMaxFp32(float val)\n{\n    uint bits = floatBitsToUint(val);\n    bits ^= (int(bits) >> 31) | 0x80000000u;\n    return bits;\n}\n\nvoid main() {\n    uint idx = gl_GlobalInvocationID.x;\n    vec3 D = pc.splatPositions.positions[idx].xyz - pc.cameraPosition.xyz;\n    float d = dot(D, D);\n    \n    if (idx<pc.splatNum) {\n        pc.splatDistances.distance[idx] = encodeMinMaxFp32(-d);\n        pc.splatIndices.index[idx] = idx;\n        atomicAdd(pc.indirect.instanceCount, 1);\n    }\n}\n\n"} "metadata" #afield/file-inline {"path" "6aab6f41-c2df-4d65-8032-2e9aee73b533_metadata_.yaml" "inline" ""} "autorun" false "nested" #{} "_tombstone" true}} {"id" "55bc1784-bc44-40eb-bc01-d02eca463445" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "4. texturing" "frame" #afield/rect [916.5234374999998 3850.5 280.0 100.0] "code" #afield/file-inline {"path" "55bc1784-bc44-40eb-bc01-d02eca463445_code_.kt" "inline" "/*\nTexturing a quad.\n\nThe fragment shader declares `uniform sampler2D bbc` (open \"fragment\" in the property switcher).\nPublishing a LoadedTexture property with the same name is what binds it: resources are matched to\nshader declarations by name. Run this box beneath the renderer (`window`) box.\n\nThe bundled texture makes this lesson runnable; change the path to try your own image.\n*/\nprop<LoadedTexture>(bbc) = LoadedTexture(\"public/docs/assets/afield_four_graphics/docs-checker-texture.png\")\n// Upload the image to the GPU now, before the first draw needs it.\nbbc.transferNow()\n\nvar module = moduleHere {}\nvar m = Mesh()\n\nmodule += \"mainMesh\" to m\nrenderer += \"boo\" to module\n\n// p and m are the vertex shader's push-constant matrices, supplied by the camera.\nval camera = Camera()\n// The quad runs from (0, 0) to (1, 1): aim at its centre, close enough that it fills the window.\ncamera.at = vec(0.5, 0.5, -0.8)\ncamera.target = vec(0.5, 0.5, 0)\nm.p = camera.p\nm.m = camera.m\n\nvar kc by keyCamera(camera = camera)\n// Four vertices, two triangles. `pos` and `tc` are the vertex shader's two attributes: an xyz\n// position and a texture coordinate per vertex.\nm.set(4, 2) {\n    val z = 0.0\n\n    pos.add(\n        0,\n        0,\n        0 + z,\n        1.0,\n        0,\n        z,\n        1,\n        1,\n        z,\n        0,\n        1,\n        z,\n    )\n\n    tc.add(\n        0,\n        0,\n        1,\n        0,\n        1,\n        1,\n        0,\n        1,\n    )\n\n    tri.add(0, 1, 2)\n    tri.add(0, 2, 3)\n}\n"} "preamble" "import afield.graphics.texture.LoadedTexture\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nimport afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\nvar Box.bbc by Inheritance<LoadedTexture>() /**/\nval Once.bbc by Onceing<LoadedTexture>() /**/\nval Why.bbc by Whying() /**/\n/*graphics-input:pos*/ val Mesh.pos by FromInput()\n/*graphics-input:tc*/ val Mesh.tc by FromInput()\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var pos : FloatBuffer; lateinit var tc : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"tc\") { tc = this ; mesh.write(\"pos\") { pos = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } } ;            };         }\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\nvar Box.window by Inheritance<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.window by Onceing<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "fragment" #afield/file-inline {"path" "55bc1784-bc44-40eb-bc01-d02eca463445_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 1) in vec2 ftc;\n\nlayout(set = 0, binding = 0) uniform sampler2D bbc;\nvoid main()\n{\n    // ftc.yx swaps the texture coordinates, which transposes the image on the quad.\n    vec4 c = texture(bbc, ftc.yx);\n    uFragColor = vec4(c.rgb/1.0, 1.0);\n}"} "vertex" #afield/file-inline {"path" "55bc1784-bc44-40eb-bc01-d02eca463445_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\nlayout (location = 1) in vec2 tc;\n\nlayout (location = 1) out vec2 ftc;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n    ftc = tc;\n}"} "metadata" #afield/file-inline {"path" "55bc1784-bc44-40eb-bc01-d02eca463445_metadata_.yaml" "inline" ""} 