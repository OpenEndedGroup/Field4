returns.\nA Resolver returns GLSL source text, not a value: changing it recompiles the shader.\n*/\nshaderTemplate[\"col\"] = mapOf(\"fixedColor\" to Resolver { \"vec4(1,0.75,0,1)\" })\n\n// `//%-` is Field's execution break. The template is registered above it, so it exists before\n// moduleHere below reads the shader.\n//%-\nvar module = moduleHere {\n    primitiveType = triangle_strip\n}\n\nvar m = Mesh()\n\nmodule += m named \"my mesh\"\nrenderer += module\n\n// One triangle. The vertex shader uses positions directly, with no camera.\nm.set(3, 3) {\n    pos.add(0, 0, 0, 0.5, 0, 0, 0.5, 0.5, 0)\n    tri.add(0, 1, 2)\n}\n"} "fragment" #afield/file-inline {"path" "1103f132-7484-4440-8102-5bd159a29fbf_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\n\nlayout(location = 0) in vec4 fcol;\nvoid main()\n{\n    // {{ col.fixedColor }} is replaced by the source text from shaderTemplate[\"col\"].\n    uFragColor = vec4({{ col.fixedColor }});\n}"} "vertex" #afield/file-inline {"path" "1103f132-7484-4440-8102-5bd159a29fbf_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\n// No camera here: positions pass straight through to clip space.\n// layout(push_constant) uniform matrices {\n//     mat4 projectionMatrix;\n//     mat4 modelMatrix;\n// } push_constants;\n\nvoid main()\n{\n    // gl_Position = push_constants.projectionMatrix * push_constants.modelMatrix * vec4(pos, 1);\n\n    fcol = col;\n    gl_Position = vec4(pos, 1);\n}"} "metadata" #afield/file-inline {"path" "1103f132-7484-4440-8102-5bd159a29fbf_metadata_.yaml" "inline" ""} "autorun" false "nested" #{}}} {"id" "8323570b-87db-4623-95a2-bd61c7d0f6f7" "properties" {"children" #{#afield/box "1ae1daed-12d3-4629-8f81-66194c5b924c"} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "6. RTT - sending" "preamble" "import afield.graphics.vulkan.Renderer\nimport afield.media.stream.FieldRTTStreamer\nimport afield.graphics.vulkan.targets.RenderToTexture\n\n\n\n\n\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nvar Box.target by Inheritance<RenderToTexture>() /**/\nval Once.target by Onceing<RenderToTexture>() /**/\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var pos : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"pos\") { pos = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } ;            };         }\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/\nvar Box.streamer by Inheritance<FieldRTTStreamer>() /**/\nval Once.streamer by Onceing<FieldRTTStreamer>() /**/\nval Box._target by InheritanceFromContext<afield.graphics.vulkan.targets.RenderToTexture>() /**/\n/*graphics-input:pos*/ val Mesh.pos by FromInput()\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-structure:finalColor*/ var Structure.finalColor by Structure.FromStructure<Any>()\n/*graphics-pc-binding:finalColor*/ var Mesh.finalColor by Mesh.BoundFromStructure<org.joml.Vector4f>()\n/*graphics-pc-binding-group:finalColor*/ var MeshGroup.finalColor by MeshGroup.BoundFromStructure<org.joml.Vector4f>()" "frame" #afield/rect [2344.5234375 1375.5 280.0 100.0] "code" #afield/file-inline {"path" "8323570b-87db-4623-95a2-bd61c7d0f6f7_code_.kt" "inline" "import afield.media.stream.FieldRTTStreamer\nimport org.lwjgl.vulkan.VK10.*\n\n/*\n6. RTT - sending: render into a target that FieldRTTStreamer encodes and streams over the network.\nParent: window. The streamer allocates the surface and hands back a RenderToTexture to draw into;\nhere it sends 1280x720 at 15 fps to 127.0.0.1:9001. `6. RTT- draw rtt` also shows the target in\nthe window. The fragment shader (open it with the editor's property switcher) colours by pixel position.\n*/\n\nprop<FieldRTTStreamer>(streamer)\n// `once` creates the streamer only on the first run, so re-running the box keeps the same stream.\nonce.streamer {\n    FieldRTTStreamer(renderer, dest = \"127.0.0.1:9001\", width = 1280, height = 720, fps = 15)\n}\nprop<RenderToTexture>(target) = streamer.start().first()\n\n// Render the target each frame, and attach this box's module to the target rather than the window.\nrenderer.renderList += \"target\" to target\n\nvar module = moduleHere { +target }\nvar m = Mesh()\nmodule += \"mainMesh\" to m\ntarget += \"boo\" to module\n\nval camera = Camera()\nm.p = camera.p\nm.m = camera.m\n// finalColor is set every frame; the vertex shader uses its xy as a random offset.\nm.finalColor = { vec(Math.random(), Math.random(), Math.random(), 1.0) }\n\nvar kc by keyCamera(camera = camera)\n// Rebuild a large quad every frame.\nloop {\n    val sc = 10.5\n    m.set(4, 2) {\n        pos.add(-sc, -sc, 0)\n        pos.add(sc, -sc, 0)\n        pos.add(sc, sc, 0)\n        pos.add(-sc, sc, 0)\n        tri.add(0, 1, 2)\n        tri.add(0, 2, 3)\n    }\n}\n"} "fragment" #afield/file-inline {"path" "8323570b-87db-4623-95a2-bd61c7d0f6f7_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n    vec4 finalColor;\n} pc;\n\nvoid main()\n{\n    // uFragColor = pc.finalColor;\n    uFragColor = vec4(pow(gl_FragCoord.x/1240.0, 2.6),\n    pow(gl_FragCoord.y/1240.0, 2.6),0,1);\n}\n"} "vertex" #afield/file-inline {"path" "8323570b-87db-4623-95a2-bd61c7d0f6f7_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n    vec4 finalColor;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos + vec3(pc.finalColor.xy,0), 1);\n}"} "metadata" #afield/file-inline {"path" "8323570b-87db-4623-95a2-bd61c7d0f6f7_metadata_.yaml" "inline" ""} "autorun" false "nested" #{} "source_id" "818be776-a391-4703-9e6e-c6259440e2f1" "ai4_auto_name_signature" ""}} {"id" "0f95328a-7214-44a2-acb6-f22c01261e96" "properties" {"children" #{#afield/box "9df25333-3cb1-4bba-b628-b34c7ba61909"} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "11. forest fire" "_tombstone" false "frame" #afield/rect [4248.5234375 1375.5 280.0 100.0] "code" #afield/file-inline {"path" "0f95328a-7214-44a2-acb6-f22c01261e96_code_.kt" "inline" "/*\nRun this in a box beneath the renderer (`window`) box.\n\nA forest fire: a fixed scatter of trees, and four kinds of fire (red, green, blue,\nmagenta) that compete for them. Burnt trees recover, so a fire front can be\nfollowed by another. Nothing burns until something is lit; \"11b. fire starter\",\nbeneath this box, lights it.\nThe forest is 768 trees high and as wide as the window's shape needs, so it fills\nthe window without being stretched.\npublished as the `fire` property so boxes beneath this one can reach the system\n*/\nval treesHigh = 768\nprop<ShaderForestFireSystem>(fire) = ShaderForestFireSystem() {\n    height = treesHigh\n    width = treesHigh * window.width / window.height\n    treeDensity = 0.6f\n}\n\n// this installs the editable spreading rule in this box's fragment tab\nfire.installInto()\n"} "preamble" "import afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\nimport afield.simulation.agents.ShaderForestFireSystem\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nvar Box.fire by Inheritance<ShaderForestFireSystem>() /**/\nval Once.fire by Onceing<ShaderForestFireSystem>() /**/\nval Why.fire by Whying() /**/\nvar Box.window by Inheritance<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.window by Onceing<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;     this.resize(numVert, numTriangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\n/*graphics-pc-structure:refractoryDecay*/ var Structure.refractoryDecay by Structure.FromStructure<Any>()\n/*graphics-pc-binding:refractoryDecay*/ var Mesh.refractoryDecay by Mesh.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-binding-group:refractoryDecay*/ var MeshGroup.refractoryDecay by MeshGroup.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-structure:spreadStepPx*/ var Structure.spreadStepPx by Structure.FromStructure<Any>()\n/*graphics-pc-binding:spreadStepPx*/ var Mesh.spreadStepPx by Mesh.BoundFromStructure<Number>()\n/*graphics-pc-bind