(binding = 0) buffer InputBuffer {\n    uint inData[];\n};\n\nlayout(binding = 1) buffer OutputBuffer {\n    uint outData[];\n};\n\nvoid main() {\n    uint idx = gl_GlobalInvocationID.x;\n    outData[idx] = inData[idx] + 1;\n}"} "_tombstone" true "autorun" false "nested" #{}}} {"id" "307aea7f-853a-4ba4-92ba-8b13f8ce2507" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [-118.99998851255998 133.45455335585507 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "1ae1daed-12d3-4629-8f81-66194c5b924c" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "8323570b-87db-4623-95a2-bd61c7d0f6f7"} "name" "6. RTT- draw rtt" "source_id" "715eae62-197d-49a1-a202-464ae4465cd5" "preamble" "import afield.graphics.vulkan.Renderer\nimport java.nio.*\nimport arrow.core.right\nimport arrow.core.left\n\n\n\n\n\nimport afield.graphics.vulkan.targets.RenderToTexture\nimport afield.media.stream.FieldRTTStreamer\nvar Box.bbc by Inheritance<RenderToTexture>() /**/\nval Once.bbc by Onceing<RenderToTexture>() /**/\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var pos : FloatBuffer; lateinit var tc : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"tc\") { tc = this ; mesh.write(\"pos\") { pos = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } } ;            };         }\nvar Box.target by Inheritance<RenderToTexture>() /**/\nval Once.target by Onceing<RenderToTexture>() /**/\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/\nval Box._target by InheritanceFromContext<afield.graphics.vulkan.targets.RenderToTexture>() /**/\n/*graphics-input:pos*/ val Mesh.pos by FromInput()\n/*graphics-input:tc*/ val Mesh.tc by FromInput()\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<org.joml.Matrix4f>()\nvar Box.streamer by Inheritance<FieldRTTStreamer>() /**/\nval Once.streamer by Onceing<FieldRTTStreamer>() /**/" "autorun" false "frame" #afield/rect [2344.5234375 1870.5 280.0 100.0] "code" #afield/file-inline {"path" "1ae1daed-12d3-4629-8f81-66194c5b924c_code_.kt" "inline" "/*\n6. RTT- draw rtt: shows the streamed target from `6. RTT - sending` on a quad in the window.\nParent chain: window -> 6. RTT - sending. The fragment shader (open it with the editor's property\nswitcher) declares `sampler2D bbc`; publishing the target under the name `bbc` binds it there.\n*/\nprop<RenderToTexture>(bbc) = target\n\nvar module = moduleHere()\nvar mesh = Mesh()\nmodule += \"mainMesh\" to mesh\nrenderer += \"boo\" to module\n\nval camera = Camera()\nmesh.p = camera.p\nmesh.m = camera.m\n\n// Focus the renderer window to move the camera with the keyboard.\nvar kc by keyCamera(camera = camera)\nmesh.set(4, 2) {\n    // A 2x2 quad at z = 0: 4 vertices with texture coordinates, 2 triangles.\n    val z = 0.0\n    pos.add(\n        -1,\n        -1,\n        z,\n        1.0,\n        -1.0,\n        z,\n        1,\n        1,\n        z,\n        -1.0,\n        1,\n        z,\n    )\n    tc.add(0, 0, 1, 0, 1, 1, 0, 1)\n    tri.add(0, 1, 2)\n    tri.add(0, 2, 3)\n}\n"} "fragment" #afield/file-inline {"path" "1ae1daed-12d3-4629-8f81-66194c5b924c_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 1) in vec2 ftc;\n\nlayout(set=0, binding = 0) uniform sampler2D bbc;\n\nvoid main()\n{\n    vec4 c = texture(bbc, ftc.xy);\n    // A slight blue tint distinguishes this view from the streamed image.\n    uFragColor = vec4(c.rgb + vec3(0,0,0.2), 1.0);\n}\n"} "vertex" #afield/file-inline {"path" "1ae1daed-12d3-4629-8f81-66194c5b924c_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\nlayout (location = 1) in vec2 tc;\n\nlayout (location = 1) out vec2 ftc;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n    ftc = tc;\n}"} "metadata" #afield/file-inline {"path" "1ae1daed-12d3-4629-8f81-66194c5b924c_metadata_.yaml" "inline" ""} "nested" #{} "ai4_auto_name_signature" ""}} {"id" "628f3f96-42d0-48dd-93ea-ea4d9f03b865" "properties" {"children" #{} "parents" #{#afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "5e. Slug filled paths" "frame" #afield/rect [1868.5234375 4345.5 280.0 100.0] "autorun" false "nested" #{} "code" #afield/file-inline {"path" "628f3f96-42d0-48dd-93ea-ea4d9f03b865_code_.kt" "inline" "import afield.graphics.text.slug.*\nimport org.lwjgl.vulkan.VK10.*\n\n/*\n5e. Slug filled paths: an FLine filled on the GPU with the Slug coverage algorithm.\nParent: window. SlugPath.compile turns the path into curve and band data; the vertex and fragment\nshaders (open them with the editor's property switcher) draw one quad covering the path and compute\nper-pixel coverage from that data, so edges stay sharp at any zoom.\nCompiling needs the native helper; build it once with: bash native/field-slug/build.sh\n*/\nname = \"5e. Slug filled paths\"\nval path =\n    FLine().moveTo(-1, -1).lineTo(1, -1).cubicTo(vec(1.4, 0, 0), vec(0.8, 1.3, 0), vec(0, 1, 0)).lineTo(-1, 1).close()\n// Clockwise inner contour cuts a hole in the counterclockwise outer contour.\npath.moveTo(-0.3, -0.3).lineTo(-0.3, 0.3).lineTo(0.3, 0.3).lineTo(0.3, -0.3).close()\nval prepared = SlugPath.compile(path, \"field-slug\".file)\n\n// `//%-` is Field's execution break: the path is prepared above it, before the GPU setup below.\n//%-\nval module = moduleHere {\n    primitiveType = triangles\n    srcAlpha = VK_BLEND_FACTOR_ONE\n    depthWrite = false\n}\nval mesh = Mesh()\nmodule += \"slug\" to mesh\nrenderer += module\n// Six vertices: the two triangles of the covering quad.\nmesh.resize(6)\nval data = SlugBuffer(renderer, prepared)\n\n// When the box is re-run or stopped, remove the mesh first, then free the atlas it reads.\nRunScope.current()!!.own(policy = ReleasePolicy.RUNNING) {\n    if (module.current.meshes[\"slug\"] === mesh) module.current.meshes.remove(\"slug\")\n    data.close()\n}\n\n// Push constants, matched by name to the shaders' SlugPC block.\nmesh.slugData = { data }\nval camera = Camera()\ncamera.at = vec(0, 0, -4)\n\nmesh.mvp = { Matrix4f(camera.p.evaluateUniform()).mul(camera.modelView()) }\nmesh.viewport = {\n    val extent = renderer.swapChain.swapChainExtent\n    vec(extent.width(), extent.height())\n}\nvar tint = vec(0.9, 0.9, 0.9, 0.8)\nmesh.tint = { tint }\n\n// Focus the renderer window: WASD/arrows move, E/C rise/fall, R resets.\nvar kc by keyCamera(camera = camera)\n\n// Tint and camera can change without preparing the geometry again. To change the geometry, prepare a\n// new SlugPath and call data.replace(newPath) on the render thread.\n"} "vertex" #afield/file-inline {"path" "628f3f96-42d0-48dd-93ea-ea4d9f03b865_vertex_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\n// Adapted Slug core: Copyright (c) 2026 AlphaPixel LLC. See LICENSE-slughorn.\nlayout(std430, buffer_reference, buffer_reference_align = 4) readonly buffer SlugData { uint words[]; };\nlayout(push_constant) uniform SlugPC {\n    mat4 mvp;\n    SlugData slugData;\n    vec2 viewport;\n    vec4 tint;\n} pc;\nvec4 data4(uint at) {\n    return uintBitsToFloat(uvec4(pc.slugData.words[at], pc.slugData.words[at+1],\n        pc.slugData.words[at+2], pc.slugData.words[at+3]));\n}\nlayout(location=0) out vec2 emCoord;\nconst vec2 corners[6] = vec2[6](vec2(0,0), vec2(1,0), vec2(1,1), vec2(0,0), vec2(1,1), vec2(0,1));\nvoid main() {\n    vec4 bounds = data4(8u);\n    // A closed SlugBuffer's empty atlas: nothing to cover, so put every corner outside the clip volume.\n    if (!(bounds.z > bounds.x && bounds.w > bounds.y)) {\n        emCoord = vec2(0.0);\n        gl_Position = vec4(0.0, 0.0, 2.0, 1.0);\n        return;\n    }\n    vec2 corner = corners[gl_VertexIndex % 6];\n    vec2 q = mix(bounds.xy, bounds.zw, corner);\n    vec2 normal = 2.0 * corner - 1.0;\n    mat4 matrix = pc.mvp;\n    vec4 position = matrix * vec4(q, 0.0, 1.0);\n    // Lengyel's perspective-dependent dilation, expressed in homogeneous vectors.\n    // normal is the corner bisector scaled so both incident sides expand equally.\n    vec4 direction = matrix * vec4(normalize(normal), 0.0, 0.0);\n    float s = position.w;\n    float t = direction.w;\n    vec2 uv = pc.viewport * (s*direction.xy - t*position.xy);\n    float denominator = length(uv) - s*t;\n    float distance = denominator > 1e-12 ? s*s / denominator : 0.0;\n    q += distance * normal;\n    emCoord = q;\n    gl_Position = matrix * vec4(q, 0.0, 1.0);\n}\n"} "fragment" #afield/file-inline {"path" "628f3f96-42d0-48dd-93ea-ea4d9f03b865_fragment_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\n// Adapted Slug core: Copyright (c) 2026 AlphaPixel LLC. See LICENSE-slughorn.\nlayout(std430, buffer_reference, buffer_reference_align = 4) readonly buffer SlugData { uint words[]; };\nlayout(push_constant) uniform SlugPC {\n    mat4 mvp;\n    SlugData slugData;\n    vec2 viewport;\n    vec4 tint;\n} pc;\nvec4 data4(uint at) {\n    return uintBitsToFloat(uvec4(pc.slugData.words[at], pc.slugData.words[at+1],\n        pc.slugData.words[at+2], pc.slugData.words[at+3]));\n}\nlayout(location=0) in vec2 emCoord;\nlayout(location=0) out vec4 fragColor;\n#define TEX_WIDTH 9\n#define SLUG_INDIRECTION_SIZE 32\nuvec4 bandFetch(ivec2 xy) {\n    uint i = pc.slugData.words[7] + uint(xy.y * 512 + xy.x);\n    uint pair = pc.slugData.words[i];\n    return uvec4(pair & 65535u, pair >> 16u, 0u, 0u);\n}\nvec4 curveFetch(ivec2 xy) {\n    uint i = pc.slugData.words[6] + 4u * uint(xy.y * 512 + xy.x);\n    return data4(i);\n}\nuint slug_CalcRootCode(float y1, float y2, float y3) {\n\tuint i1 = floatBitsToUint(y1) >> 31u;\n\tuint i2 = floatBitsToUint(y2) >> 30u;\n\tuint i3 = floatBitsToUint(y3) >> 29u;\n\n\tuint shift = (i2 & 2u) | (i1 & ~2u);\n\tshift = (i3 & 4u) | (shift & ~4u);\n\n\treturn ((0x2E74u >> shift) & 0x0101u);\n}\n\nvec2 slug_SolveHorizPoly(vec4 p12, vec2 p3) {\n\tvec2 a = p12.xy - p12.zw * 2.0 + p3;\n\tvec2 b = p12.xy - p12.zw;\n\tfloat ra = 1.0 / a.y;\n\tfloat rb = 0.5 / b.y;\n\tfloat d = sqrt(max(b.y * b.y - a.y * p12.y, 0.0));\n\tfloat t1 = (b.y - d) * ra;\n\tfloat t2 = (b.y + d) * ra;\n\tif(abs(a.y) < 1.0 / 65536.0) { t1 = p12.y * rb; t2 = t1; }\n\treturn vec2(\n\t\t(a.x * t1 - b.x * 2.0) * t1 + p12.x,\n\t\t(a.x * t2 - b.x * 2.0) * t2 + p12.x\n\t);\n}\n\nvec2 slug_SolveVertPoly(vec4 p12, vec2 p3) {\n\tvec2 a = p12.xy - p12.zw * 2.0 + p3;\n\tvec2 b = p12.xy - p12.zw;\n\tfloat ra = 1.0 / a.x;\n\tfloat rb = 0.5 / b.x;\n\tfloat d = sqrt(max(b.x * b.x - a.x * p12.x, 0.0));\n\tfloat t1 = (b.x - d) * ra;\n\tfloat t2 = (b.x + d) * ra;\n\tif(abs(a.x) < 1.0 / 65536.0) { t1 = p12.x * rb; t2 = t1; }\n\treturn vec2(\n\t\t(a.y * t1 - b.y * 2.0) * t1 + p12.y,\n\t\t(a.y * t2 - b.y * 2.0) * t2 + p12.y\n\t);\n}\n\nivec2 slug_CalcBandLoc(ivec2 glyphLoc, uint offset) {\n\tivec2 bandLoc = ivec2(glyphLoc.x + int(offset), glyphLoc.y);\n\tbandLoc.y += bandLoc.x >> TEX_WIDTH;\n\tbandLoc.x &= (1 << TEX_WIDTH) - 1;\n\treturn bandLoc;\n}\n\n// Location of a curve's later texel, wrapping to the next row of the 512-wide data layout the same\n// way slug_CalcBandLoc() does, since a curve's texels may straddle a row boundary.\nivec2 slug_CalcCurveLoc(ivec2 curveLoc, int offset) {\n\tivec2 loc = ivec2(curveLoc.x + offset, curveLoc.y);\n\tloc.y += loc.x >> TEX_WIDTH;\n\tloc.x &= (1 << TEX_WIDTH) - 1;\n\treturn loc;\n}\n\nfloat slug_CalcCoverage(float xcov, float ycov, float xwgt, float ywgt) {\n\tfloat coverage = max(\n\t\tabs(xcov * xwgt + ycov * ywgt) / max(xwgt + ywgt, 1.0 / 65536.0),\n\t\tmin(abs(xcov), abs(ycov))\n\t);\n\treturn clamp(coverage, 0.0, 1.0);\n}\n\nfloat slug_Render(vec2 renderCoord, vec4 bandTransform, ivec2 glyphLoc, ivec2 bandMax) {\n\tvec2 emsPerPixel = fwidth(renderCoord);\n\tvec2 pixelsPerEm = 1.0 / emsPerPixel;\n\n\t// O(1) band index via indirection tables (2 fetches per axis).\n\tint qY = clamp(int(renderCoord.y * bandTransform.y + bandTransform.w), 0, SLUG_INDIRECTION_SIZE - 1);\n\tint qX = clamp(int(renderCoord.x * bandTransform.x + bandTransform.z), 0, SLUG_INDIRECTION_SIZE - 1);\n\tint bandY = int(bandFetch(ivec2(glyphLoc.x + qY, glyphLoc.y)).r);\n\tint bandX = int(bandFetch(ivec2(glyphLoc.x + SLUG_INDIRECTION_SIZE + qX, glyphLoc.y)).r);\n\n\t// Horizontal bands -- headers at glyphLoc + 2*IS + bandY\n\tfloat xcov = 0.0, xwgt = 0.0;\n\tuvec2 hbandData = bandFetch(ivec2(glyphLoc.x + 2 * SLUG_INDIRECTION_SIZE + bandY, glyphLoc.y)).xy;\n\n\tfor(int ci = 0; ci < int(hbandData.x); ci++) {\n\t\t// Compute each curve index's location separately, so a band's curve list may span\n\t\t// more than one row of the data layout.\n\t\tivec2 hbandLoc = slug_CalcBandLoc(glyphLoc, hbandData.y + uint(ci));\n\t\tivec2 curveLoc = ivec2(bandFetch(hbandLoc).xy);\n\t\tvec4 p12 = curveFetch(curveLoc) - vec4(renderCoord, renderCoord);\n\n\t\t// A curve's third control point is the next texel. Connected curves share endpoint\n\t\t// texels, so that texel can sit at the start of the next row.\n\t\tvec2 p3 = curveFetch(slug_CalcCurveLoc(curveLoc, 1)).xy - renderCoord;\n\n\t\tif(max(max(p12.x, p12.z), p3.x) * pixelsPerEm.x < -0.5) break;\n\n\t\tuint code = slug_CalcRootCode(p12.y, p12.w, p3.y);\n\t\tif(code != 0u) {\n\t\t\tvec2 r = slug_SolveHorizPoly(p12, p3) * pixelsPerEm.x;\n\t\t\tif((code & 1u) != 0u) { xcov += clamp(r.x + 0.5, 0.0, 1.0); xwgt = max(xwgt, clamp(1.0 - abs(r.x) * 2.0, 0.0, 1.0)); }\n\t\t\tif(code > 1u) { xcov -= clamp(r.y + 0.5, 0.0, 1.0); xwgt = max(xwgt, clamp(1.0 - abs(r.y) * 2.0, 0.0, 1.0)); }\n\t\t}\n\t}\n\n\t// Vertical bands -- headers at glyphLoc + 2*IS + numHBands + bandX\n\tfloat ycov = 0.0, ywgt = 0.0;\n\tuvec2 vbandData = bandFetch(ivec2(glyphLoc.x + 2 * SLUG_INDIRECTION_SIZE + bandMax.y + 1 + bandX, glyphLoc.y)).xy;\n\n\tfor(int ci = 0; ci < int(vbandData.x); ci++) {\n\t\t// See the matching comment in the horizontal-band loop above.\n\t\tivec2 vbandLoc = slug_CalcBandLoc(glyphLoc, vbandData.y + uint(ci));\n\t\tivec2 curveLoc = ivec2(bandFetch(vbandLoc).xy);\n\t\tvec4 p12 = curveFetch(curveLoc) - vec4(renderCoord, renderCoord);\n\n\t\t// See the matching comment in the horizontal-band loop above.\n\t\tvec2 p3 = curveFetch(slug_CalcCurveLoc(curveLoc, 1)).xy - renderCoord;\n\n\t\tif(max(max(p12.y, p12.w), p3.y) * pixelsPerEm.y < -0.5) break;\n\n\t\tuint code = slug_CalcRootCode(p12.x, p12.z, p3.x);\n\t\tif(code != 0u) {\n\t\t\tvec2 r = slug_SolveVertPoly(p12, p3) * pixelsPerEm.y;\n\t\t\tif((code & 1u) != 0u) { ycov -= clamp(r.x + 0.5, 0.0, 1.0); ywgt = max(ywgt, clamp(1.0 - abs(r.x) * 2.0, 0.0, 1.0)); }\n\t\t\tif(code > 1u) { ycov += clamp(r.y + 0.5, 0.0, 1.0); ywgt = max(ywgt, clamp(1.0 - abs(r.y) * 2.0, 0.0, 1.0)); }\n\t\t}\n\t}\n\n\treturn slug_CalcCoverage(xcov, ycov, xwgt, ywgt);\n}\n\n\n// The fill colour. Replace it with any procedural fill; coverage is computed independently of it.\nvec3 shade(vec2 q) { return pc.tint.rgb * (0.7 + 0.3*cos(vec3(0,2,4)+q.x*4.0+q.y*3.0)); }\nvoid main() {\n    ivec2 loc = ivec2(pc.slugData.words[16], pc.slugData.words[17]);\n    ivec2 bandMax = ivec2(pc.slugData.words[18], pc.slugData.words[19]);\n    floa