ructure:wrapY*/ var Structure.wrapY by Structure.FromStructure<Any>()\n/*graphics-pc-binding:wrapY*/ var Mesh.wrapY by Mesh.BoundFromStructure<Number>()\n/*graphics-pc-binding-group:wrapY*/ var MeshGroup.wrapY by MeshGroup.BoundFromStructure<Number>()\n/*graphics-pc-structure:borderSolidPx*/ var Structure.borderSolidPx by Structure.FromStructure<Any>()\n/*graphics-pc-binding:borderSolidPx*/ var Mesh.borderSolidPx by Mesh.BoundFromStructure<Number>()\n/*graphics-pc-binding-group:borderSolidPx*/ var MeshGroup.borderSolidPx by MeshGroup.BoundFromStructure<Number>()\n/*graphics-pc-structure:solidThreshold*/ var Structure.solidThreshold by Structure.FromStructure<Any>()\n/*graphics-pc-binding:solidThreshold*/ var Mesh.solidThreshold by Mesh.BoundFromStructure<Number>()\n/*graphics-pc-binding-group:solidThreshold*/ var MeshGroup.solidThreshold by MeshGroup.BoundFromStructure<Number>()\n/*graphics-pc-structure:clearRequested*/ var Structure.clearRequested by Structure.FromStructure<Any>()\n/*graphics-pc-binding:clearRequested*/ var Mesh.clearRequested by Mesh.BoundFromStructure<Number>()\n/*graphics-pc-binding-group:clearRequested*/ var MeshGroup.clearRequested by MeshGroup.BoundFromStructure<Number>()\n/*graphics-pc-structure:initialNoise*/ var Structure.initialNoise by Structure.FromStructure<Any>()\n/*graphics-pc-binding:initialNoise*/ var Mesh.initialNoise by Mesh.BoundFromStructure<Number>()\n/*graphics-pc-binding-group:initialNoise*/ var MeshGroup.initialNoise by MeshGroup.BoundFromStructure<Number>()" "nested" #{} "autorun" false "vertex" #afield/file-inline {"path" "b09e32ea-79a6-40a7-bb7a-99e6723081ad_vertex_.glsl" "inline" "#version 450\n\nvec2 fullscreenVertex(uint index) {\n    if (index == 0u) return vec2(-1.0, -1.0);\n    if (index == 1u) return vec2(3.0, -1.0);\n    return vec2(-1.0, 3.0);\n}\n\nvoid main() {\n    gl_Position = vec4(fullscreenVertex(uint(gl_VertexIndex)), 0.0, 1.0);\n}"} "fragment" #afield/file-inline {"path" "b09e32ea-79a6-40a7-bb7a-99e6723081ad_fragment_.glsl" "inline" "#version 450\n\nlayout(set = 0, binding = 0) uniform sampler2D fluid0Tex;\nlayout(set = 0, binding = 1) uniform sampler2D fluid1Tex;\nlayout(set = 0, binding = 2) uniform sampler2D fluid2Tex;\nlayout(set = 0, binding = 3) uniform sampler2D controlsTex;\n\nlayout(push_constant) uniform Push {\n    float relaxation;\n    float baseDensity;\n    vec2 baseVelocity;\n    float driveBlend;\n    float controlVelocityScale;\n    float maxVelocity;\n    float wrapX;\n    float wrapY;\n    float borderSolidPx;\n    float solidThreshold;\n    float clearRequested;\n    float initialNoise;\n} push;\n\n// directions 0-3, 4-7, and (8, density, velocity)\nlayout(location = 0) out vec4 out0;\nlayout(location = 1) out vec4 out1;\nlayout(location = 2) out vec4 out2;\n\nconst vec2 DIRS[9] = vec2[](\nvec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 1.0), vec2(-1.0, 0.0), vec2(0.0, -1.0),\nvec2(1.0, 1.0), vec2(-1.0, 1.0), vec2(-1.0, -1.0), vec2(1.0, -1.0)\n);\nconst float WEIGHTS[9] = float[](\n4.0 / 9.0, 1.0 / 9.0, 1.0 / 9.0, 1.0 / 9.0, 1.0 / 9.0,\n1.0 / 36.0, 1.0 / 36.0, 1.0 / 36.0, 1.0 / 36.0\n);\nconst int OPPOSITE[9] = int[](0, 3, 4, 1, 2, 7, 8, 5, 6);\n\nivec2 wrapPixel(ivec2 pixel, ivec2 dims) {\n    int x = push.wrapX > 0.5 ? ((pixel.x % dims.x) + dims.x) % dims.x : clamp(pixel.x, 0, dims.x - 1);\n    int y = push.wrapY > 0.5 ? ((pixel.y % dims.y) + dims.y) % dims.y : clamp(pixel.y, 0, dims.y - 1);\n    return ivec2(x, y);\n}\n\nbool isSolidAt(ivec2 pixel, ivec2 dims) {\n    if (push.borderSolidPx > 0.5) {\n        int border = int(round(push.borderSolidPx));\n        if (pixel.x < border || pixel.y < border || pixel.x >= dims.x - border || pixel.y >= dims.y - border) {\n            return true;\n        }\n    }\n    return texelFetch(controlsTex, wrapPixel(pixel, dims), 0).r >= push.solidThreshold;\n}\n\nvoid loadPopulations(ivec2 pixel, ivec2 dims, out float f[9]) {\n    ivec2 p = wrapPixel(pixel, dims);\n    vec4 a = texelFetch(fluid0Tex, p, 0);\n    vec4 b = texelFetch(fluid1Tex, p, 0);\n    vec4 c = texelFetch(fluid2Tex, p, 0);\n    f[0] = a.r;\n    f[1] = a.g;\n    f[2] = a.b;\n    f[3] = a.a;\n    f[4] = b.r;\n    f[5] = b.g;\n    f[6] = b.b;\n    f[7] = b.a;\n    f[8] = c.r;\n}\n\nfloat equilibrium(int i, float density, vec2 velocity) {\n    float cu = dot(DIRS[i], velocity);\n    return WEIGHTS[i] * density * (1.0 + 3.0 * cu + 4.5 * cu * cu - 1.5 * dot(velocity, velocity));\n}\n\nvoid macroscopic(float f[9], out float density, out vec2 velocity) {\n    density = 0.0;\n    for (int i = 0; i < 9; ++i) density += f[i];\n    density = max(density, 1e-5);\n    velocity = vec2(\n    f[1] - f[3] + f[5] - f[6] - f[7] + f[8],\n    f[2] - f[4] + f[5] + f[6] - f[7] - f[8]\n    ) / density;\n}\n\n// the population heading in direction i after the site at pixel has collided\nfloat postCollision(ivec2 pixel, int i, ivec2 dims) {\n    if (isSolidAt(pixel, dims)) return equilibrium(i, push.baseDensity, vec2(0.0));\n\n    float f[9];\n    loadPopulations(pixel, dims, f);\n    float density;\n    vec2 velocity;\n    macroscopic(f, density, velocity);\n\n    vec4 control = texelFetch(controlsTex, wrapPixel(pixel, dims), 0);\n    vec2 controlVelocity = control.gb * push.controlVelocityScale;\n    // the wind pulls every site toward it; the controls push on top\n    velocity = mix(velocity, push.baseVelocity, push.driveBlend) + controlVelocity;\n    // a dye source is also an inlet: hold its velocity near the wind plus its push\n    velocity = mix(velocity, push.baseVelocity + controlVelocity, clamp(control.a, 0.0, 1.0) * 0.85);\n\n    float speed = length(velocity);\n    if (speed > push.maxVelocity) velocity *= push.maxVelocity / speed;\n\n    return mix(f[i], equilibrium(i, density, velocity), push.relaxation);\n}\n\n// pull-streaming: what arrives here along direction i, reflected back off a solid neighbour\nfloat streamed(ivec2 pixel, int i, ivec2 dims) {\n    ivec2 source = pixel - ivec2(DIRS[i]);\n    if (isSolidAt(source, dims)) return postCollision(pixel, OPPOSITE[i], dims);\n    return postCollision(source, i, dims);\n}\n\nuint hash(uint x) {\n    x ^= x >> 16u;\n    x *= 0x7feb352du;\n    x ^= x >> 15u;\n    x *= 0x846ca68bu;\n    x ^= x >> 16u;\n    return x;\n}\n\nvec2 noiseAt(ivec2 pixel) {\n    uint h = hash(uint(pixel.x) ^ hash(uint(pixel.y) * 2654435761u));\n    return (vec2(float(h & 0xffffu), float(h >> 16u)) / 65535.0 - 0.5) * 2.0;\n}\n\nvoid writeAtRest(vec2 u) {\n    float rho = push.baseDensity;\n    out0 = vec4(equilibrium(0, rho, u), equilibrium(1, rho, u), equilibrium(2, rho, u), equilibrium(3, rho, u));\n    out1 = vec4(equilibrium(4, rho, u), equilibrium(5, rho, u), equilibrium(6, rho, u), equilibrium(7, rho, u));\n    out2 = vec4(equilibrium(8, rho, u), rho, u);\n}\n\nvoid main() {\n    ivec2 dims = textureSize(fluid0Tex, 0);\n    ivec2 pixel = clamp(ivec2(gl_FragCoord.xy), ivec2(0), dims - 1);\n\n    if (isSolidAt(pixel, dims)) {\n        writeAtRest(vec2(0.0));\n        return;\n    }\n    if (push.clearRequested > 0.5) {\n        writeAtRest(push.baseVelocity + noiseAt(pixel) * push.initialNoise);\n        return;\n    }\n\n    float f[9];\n    for (int i = 0; i < 9; ++i) f[i] = streamed(pixel, i, dims);\n\n    float density;\n    vec2 velocity;\n    macroscopic(f, density, velocity);\n    out0 = vec4(f[0], f[1], f[2], f[3]);\n    out1 = vec4(f[4], f[5], f[6], f[7]);\n    out2 = vec4(f[8], density, velocity);\n}\n"}}} {"id" "8dd7bb33-bd03-402f-81e9-dc56fbf81414" "properties" {"children" #{} "parents" #{#afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "Untitled" "frame" #afield/rect [0.0 0.0 3.21875 2.0] "code" #afield/file-inline {"path" "8dd7bb33-bd03-402f-81e9-dc56fbf81414_code_.kt" "inline" "\n"} "preamble" "" "fragment" #afield/file-inline {"path" "8dd7bb33-bd03-402f-81e9-dc56fbf81414_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nvoid main()\n{\n    uFragColor = vec4(1.0, 0.8, 0.4, 1.0);\n}"} "vertex" #afield/file-inline {"path" "8dd7bb33-bd03-402f-81e9-dc56fbf81414_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n}"} "_tombstone" true "autorun" false "nested" #{}}} {"id" "b2ba23e8-18e5-4f07-a709-2b89116a83b3" "properties" {"children" #{} "parents" #{#afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "2. hello camera" "preamble" "import afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nimport afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\n/*graphics-input:pos*/ val Mesh.pos by FromInput()\n/*graphics-input:col*/ val Mesh.col by FromInput()\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var pos : FloatBuffer; lateinit var col : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"col\") { col = this ; mesh.write(\"pos\") { pos = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } } ;            };         }\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\nvar Box.window by Inheritance<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.window by Onceing<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "frame" #afield/rect [440.5234375 2860.5 280.0 100.0] "code" #afield/file-inline {"path" "b2ba23e8-18e5-4f07-a709-2b89116a83b3_code_.kt" "inline" "/*\n2. hello camera\n\nA stack of triangles seen through a moving Camera. The camera's projection and view matrices reach the\nvertex shader as push constants. Needs the renderer window box as its parent.\n\nOpen the `vertex` property (editor property switcher, `f1` or `ctrl-P`) to see the `p` and `m` push\nconstants and how they transform each position. The `fragment` shader paints every triangle one flat\ncolor.\n*/\nvar m = Mesh()\nvar module = moduleHere()\n\nmodule += \"mainMesh\" to m\nrenderer += \"boo\" to module\n\n// A perspective camera, placed off to one side looking at the origin\n\nval camera = Camera()\ncamera.at = vec(-10, 2, 0)\n\n// The vertex shader declares push constants `p` and `m`, so the mesh has matching `m.p` and `m.m`.\n// They are given the camera's matrix objects rather than a snapshot, so they are read again every frame.\nm.p = camera.p\nm.m = camera.m\n\nvar tick = 0.0\nloop {\n    // orbit the camera around the origin\n    camera.at = vec(-10 * Math.sin(tick), 0, 10 * Math.cos(tick))\n    if (tick < 3) {\n        // For the first few seconds, rebuild the mesh with 1, 2, ... 100 triangles, one more each frame.\n        // `m.set(numVert, numTriangle)` sizes the mesh; `n { }` repeats its body n times with `it` as the index.\n        for (n in 1..100) {\n            camera.at = vec(-10 * Math.sin(tick), 0, 10 * Math.cos(tick))\n            tick += 0.01\n            m.set(3 * n, 1 * n) {\n                n {\n                    val z = 0.0 + it\n                    pos.add(0, 0, -1 + z, 1.0, 0.1, z, 1, 1, z)\n                    3 {\n                        col.add(0, it / 3.0, 1 - it / 3.0, 1)\n                    }\n                    tri.add(0 + 3 * it, 1 + 3 * it, 2 + 3 * it)\n                }\n            }\n            // wait for the next frame inside this loop body\n            frame()\n        }\n    } else {\n        tick += 0.01\n        frame()\n    }\n    true\n}\n"} "fragment" #afield/file-inline {"path" "b2ba23e8-18e5-4f07-a709-2b89116a83b3_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nvoid main()\n{\n    uFragColor = vec4(1.0, 0.8, 0.4, 1.0);\n}"} "vertex" #afield/file-inline {"path" "b2ba23e8-18e5-4f07-a709-2b89116a83b3_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\n// The camera matrices, supplied by the box through `m.p` and `m.m`\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n\n    fcol = col;\n}"} "metadata" #afield/file-inline {"path" "b2ba23e8-18e5-4f07-a709-2b89116a83b3_metadata_.yaml" "inline" ""} "autorun" false "nested" #{}}} {"id" "cc81ab4e-6c43-4908-bfff-7c8f827c927c" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "0. traditional triangle" "preamble" "import afield.graphics.vulkan.Renderer\nimport java.nio.*\nimport arrow.core.right\nimport arrow.core.left\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport afield.graphics.vulkan.util.Window\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var col : FloatBuffer; lateinit var pos : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"pos\") { pos = this ; mesh.write(\"col\") { col = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } } ;            };         }\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/\n/*graphics-input:col*/ val Mesh.col by FromInput()\n/*graphics-input:pos*/ val Mesh.pos by FromInput()\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "frame" #afield/rect [440.5234375 1375.5 280.0 100.0] "code" #afield/file-inline {"path" "cc81ab4e-6c43-4908-bfff-7c8f827c927c_code_.kt" "inline" "/*\n0. traditional triangle\n\nAbout the smallest drawing there is: a shader module, a mesh with three vertices, one triangle.\nNeeds the renderer window box as its parent.\n\nThe shaders live on this box too: open the `vertex` and `fragment` properties with the editor's property\nswitcher (`f1` or `ctrl-P`). The vertex shader passes `pos` straight through as a clip-space position and\nhands `col` on to the fragment shader, which tints it.\n*/\n\n// First a shader module belonging to this box, drawing triangle strips\nvar module = moduleHere {\n    primitiveType = triangle_strip\n}\n\n// then a mesh, which holds the vertex data the shaders read\nvar m = Mesh()\n\n// Connect the mesh to the module, and the module to the renderer\nmodule += m named \"my mesh\"\nrenderer += module\n\n// Fill the mesh: 3 vertices and 3 indices. `pos` and `col` are the vertex shader's inputs; `tri` is the\n// index list\nm.set(3, 3) {\n    pos.add(0, 0, 0, 0.5, 0, 0, 0.5, 0.5, 0)\n\n    // one color per vertex, interpolated across the triangle\n    3 {\n        col.add(0, it / 3.0, 1 - it / 3.0, 1)\n    }\n    tri.add(0, 1, 2)\n}\n"} "fragment" #afield/file-inline {"path" "cc81ab4e-6c43-4908-bfff-7c8f827c927c_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\n\n// the interpolated color from the vertex shader's `fcol` output (location 0)\nlayout(location = 0) in vec4 fcol;\nvoid main()\n{\n    uFragColor = vec4(1.0, 0.8, 0.4, 1.0)* fcol;\n}"} "vertex" #afield/file-inline {"path" "cc81ab4e-6c43-4908-bfff-7c8f827c927c_vertex_.glsl" "inline" "#version 450\n// Per-vertex inputs: the locations match the `pos` and `col` attributes the box fills with `m.set`\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\nvoid main()\n{\n    // no camera: positions are used directly as clip-space coordinates (-1..1 across the window)\n    fcol = col;\n    gl_Position = vec4(pos, 1);\n}"} "metadata" #afield/file-inline {"path" "cc81ab4e-6c43-4908-bfff-7c8f827c927c_metadata_.yaml" "inline" ""} "autorun" false "nested" #{}}} {"id" "dce6b085-943e-4e4d-94f7-7ba22f3f4a32" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [88.00001148744002 -75.54544664414493 100.0 100.0] "code" #afield/file-inline {"path" "dce6b085-943e-4e4d-94f7-7ba22f3f4a32_code_.kt" "inline" "\n"} "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "3cbcadc0-b279-470d-9a5f-afc120518829" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "4b. multi-texture" "preamble" "import afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nimport afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\nvar Box.ta by Inheritance<Array<ImageView>>() /**/\nval Once.ta by Onceing<Array<ImageView>>() /**/\nval Why.ta by Whying() /**/\n/*graphics-input:pos*/ val Mesh.pos by FromInput()\n/*graphics-input:tc*/ val Mesh.tc by FromInput()\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var pos : FloatBuffer; lateinit var tc : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"tc\") { tc = this ; mesh.write(\"pos\") { pos = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } } ;            };         }\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\nvar Box.window by Inheritance<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.window by Onceing<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "frame" #afield/rect [916.5234374999998 4345.5 280.0 100.0] "code" #afield/file-inline {"path" "3cbcadc0-b279-470d-9a5f-afc120518829_code_.kt" "inline" "/*\nAn array of textures.\n\nThe fragment shader declares `uniform sampler2D ta[3]` (open \"fragment\" in the property switcher)\nand shows one entry in each third of the quad: here the checkerboard, a gradient, then the\ncheckerboard again. The array published as `ta` must have exactly as many entries as the shader\ndeclares, or the texture is refused at link time.\nRun this box beneath the renderer (`window`) box.\n\nThe bundled textures make this lesson runnable; change these paths to try your own images.\n*/\nvar bbc = LoadedTexture(\"public/docs/assets/afield_four_graphics/docs-checker-texture.png\")\nbbc.transferNow()\n\nvar bbc2 = LoadedTexture(\"public/docs/assets/rt-uv-gradient.png\")\nbbc2.transferNow()\n\n// A sampler array is published as an Array<ImageView>, so take each texture's imageView.\nvar asArray: Array<ImageView> = arrayOf(bbc.imageView, bbc2.imageView, bbc.imageView)\n\nprop<Array<ImageView>>(ta) = asArray\n\nvar module = moduleHere {}\nvar m = Mesh()\n\nmodule += \"mainMesh\" to m\nrenderer += \"boo\" to module\n\nval camera = Camera()\n// The quad runs from (0, 0) to (1, 1): aim at its centre, close enough that it fills the window.\ncamera.at = vec(0.5, 0.5, -0.8)\ncamera.target = vec(0.5, 0.5, 0)\nm.p = camera.p\nm.m = camera.m\n\nvar kc by keyCamera(camera = camera)\n// The same textured quad as the texturing lesson: positions and texture coordinates for four\n// vertices, two triangles.\nm.set(4, 2) {\n    val z = 0.0\n\n    pos.add(\n        0,\n        0,\n        0 + z,\n        1.0,\n        0,\n        z,\n        1,\n        1,\n        z,\n        0,\n        1,\n        z,\n    )\n\n    tc.add(\n        0,\n        0,\n        1,\n        0,\n        1,\n        1,\n        0,\n        1,\n    )\n\n    tri.add(0, 1, 2)\n    tri.add(0, 2, 3)\n}\n"} "fragment" #afield/file-inline {"path" "3cbcadc0-b279-470d-9a5f-afc120518829_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 1) in vec2 ftc;\n\nlayout(set = 0, binding = 0) uniform sampler2D ta[3];\n\nvoid main()\n{\n    // Each third of the quad, left to right, shows one entry of the array. Every entry is sampled and the\n    // result chosen afterwards, so the array index stays a constant.\n    // ftc.yx swaps the texture coordinates, which transposes the image on the quad.\n    vec4 c0 = texture(ta[0], ftc.yx);\n    vec4 c1 = texture(ta[1], ftc.yx);\n    vec4 c2 = texture(ta[2], ftc.yx);\n    vec4 c = ftc.x < 1.0 / 3.0 ? c0 : (ftc.x < 2.0 / 3.0 ? c1 : c2);\n    uFragColor = vec4(c.rgb, 1.0);\n}"} "vertex" #afield/file-inline {"path" "3cbcadc0-b279-470d-9a5f-afc120518829_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\nlayout (location = 1) in vec2 tc;\n\nlayout (location = 1) out vec2 ftc;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n    ftc = tc;\n}"} "metadata" #afield/file-inline {"path" "3cbcadc0-b279-470d-9a5f-afc120518829_metadata_.yaml" "inline" ""} "autorun" false "nested" #{}}} {"id" "41239c2d-e555-43a2-afba-5729693253c6" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [381.18182970866644 -282.6363564049906 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "274da1a1-741d-4a73-9c63-a8e3a9416775" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [386.00001148744 -94.54544664414493 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "a55e6f72-c46a-4b74-8d74-5defac4a9f79" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [253.18182970866644 -260.6363564049906 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "9df25333-3cb1-4bba-b628-b34c7ba61909" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "0f95328a-7214-44a2-acb6-f22c01261e96"} "name" "11b. fire starter" "_tombstone" false "frame" #afield/rect [4248.5234375 1870.5 280.0 100.0] "code" #afield/file-inline {"path" "9df25333-3cb1-4bba-b628-b34c7ba61909_code_.kt" "inline" "/*\nRun this in a box beneath \"11. forest fire\", whose `fire` property it uses.\n\nDraws into the fire's ignition texture: two points that burn for ever, one red\nand one green. Each relights its neighbourhood as soon as the trees recover, so\neach sends out a train of rings, and where the trains meet one kind takes over.\nstart from a clean ignition texture and an unburnt forest, so a re-run does not keep the old drawing\n*/\nfire.clearFireInput()\nfire.clearState()\n\n// a module that renders into the ignition texture; the drawing itself is this box's `fragment` shader\nvar module = moduleHere(fire.fireInputParameters(\"starter\"))\nfire.addFireInput(\"starter\", module)\n\nval quad = fullscreenTriangle(module)\nmodule += \"quad\" to quad\n\n// positions are in trees, so place them as fractions of the forest's size\nval w = fire.settings.width.toFloat()\nval h = fire.settings.height.toFloat()\nquad.red = { vec(w * 0.33f, h * 0.5f) }\nquad.green = { vec(w * 0.68f, h * 0.5f) }\nquad.radius = { 4f }\n"} "vertex" #afield/file-inline {"path" "9df25333-3cb1-4bba-b628-b34c7ba61909_vertex_.glsl" "inline" "#version 450\n\n// one triangle that covers the whole target; positions come from the vertex index\nvec2 fullscreenVertex(uint index) {\n    if (index == 0u) return vec2(-1.0, -1.0);\n    if (index == 1u) return vec2(3.0, -1.0);\n    return vec2(-1.0, 3.0);\n}\n\nvoid main() {\n    gl_Position = vec4(fullscreenVertex(uint(gl_VertexIndex)), 0.0, 1.0);\n}\n"} "fragment" #afield/file-inline {"path" "9df25333-3cb1-4bba-b628-b34c7ba61909_fragment_.glsl" "inline" "#version 450\n\nlayout(push_constant) uniform Push {\n    vec2 red;\n    vec2 green;\n    float radius;\n} push;\n\nlayout(location = 0) out vec4 outColor;\n\n// one kind of fire per channel; additive, so writing 1 into a channel lights that kind here\nvoid main() {\n    vec2 p = gl_FragCoord.xy;\n    outColor = vec4(0.0);\n    if (distance(p, push.red) < push.radius) outColor.r = 1.0;\n    if (distance(p, push.green) < push.radius) outColor.g = 1.0;\n}\n"} "nested" #{} "preamble" "import afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\nimport afield.simulation.agents.ShaderForestFireSystem\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;     this.resize(numVert, numTriangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\nvar Box.fire by Inheritance<ShaderForestFireSystem>() /*from:0f95328a-7214-44a2-acb6-f22c01261e96*/ /**/\nval Once.fire by Onceing<ShaderForestFireSystem>() /*from:0f95328a-7214-44a2-acb6-f22c01261e96*/ /**/\nval Why.fire by Whying() /*from:0f95328a-7214-44a2-acb6-f22c01261e96*/ /**/\nvar Box.window by Inheritance<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.window by Onceing<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\n/*graphics-pc-structure:red*/ var Structure.red by Structure.FromStructure<Any>()\n/*graphics-pc-binding:red*/ var Mesh.red by Mesh.BoundFromStructure<afield.math.linalg.Vector2f>()\n/*graphics-pc-binding-group:red*/ var MeshGroup.red by MeshGroup.BoundFromStructure<afield.math.linalg.Vector2f>()\n/*graphics-pc-structure:green*/ var Structure.green by Structure.FromStructure<Any>()\n/*graphics-pc-binding:green*/ var Mesh.green by Mesh.BoundFromStructure<afield.math.linalg.Vector2f>()\n/*graphics-pc-binding-group:green*/ var MeshGroup.green by MeshGroup.BoundFromStructure<afield.math.linalg.Vector2f>()\n/*graphics-pc-structure:radius*/ var Structure.radius by Structure.FromStructure<Any>()\n/*graphics-pc-binding:radius*/ var Mesh.radius by Mesh.BoundFromStructure<Number>()\n/*graphics-pc-binding-group:radius*/ var MeshGroup.radius by MeshGroup.BoundFromStructure<Number>()" "autorun" false}} {"id" "a8dfc9a7-3062-4eca-ab7e-a243ff8e7bde" "properties" {"children" #{#afield/box "459b9c54-6363-4c27-a033-2f145e017022"} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "5. PingPongTT" "preamble" "import afield.graphics.vulkan.targets.PingPongRenderToTexture\nimport afield.graphics.texture.HasImageView\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nimport afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\nvar Box.target by Inheritance<PingPongRenderToTexture>() /**/\nval Once.target by Onceing<PingPongRenderToTexture>() /**/\nval Why.target by Whying() /**/\nvar Box.otherView by Inheritance<HasImageView>() /**/\nval Once.otherView by Onceing<HasImageView>() /**/\nval Why.otherView by Whying() /**/\n/*graphics-input:pos*/ val Mesh.pos by FromInput()\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var pos : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"pos\") { pos = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } ;            };         }\n/*graphics-pc-structure:time*/ var Structure.time by Structure.FromStructure<Any>()\n/*graphics-pc-binding:time*/ var Mesh.time by Mesh.BoundFromStructure<Number>()\n/*graphics-pc-binding-group:time*/ var MeshGroup.time by MeshGroup.BoundFromStructure<Number>()\nvar Box.window by Inheritance<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.window by Onceing<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "frame" #afield/rect [1392.5234375 2365.5 280.0 100.0] "code" #afield/file-inline {"path" "a8dfc9a7-3062-4eca-ab7e-a243ff8e7bde_code_.kt" "inline" "/*\nPing-pong render to texture: feedback from one frame to the next.\n\nA pass cannot read the image it is writing, so PingPongRenderToTexture keeps two images and swaps\ntheir roles every frame. The fragment shader (open \"fragment\" in the property switcher) samples\nlast frame's image as `otherView`, blurs and fades it a little, and stamps a moving dot into it, so\nthe dot leaves a trail that spreads out and dies away. The child box `5. draw pingpoing` displays it.\nRun this box beneath the renderer (`window`) box.\n*/\nimport org.lwjgl.vulkan.VK10.*\n\nprop<PingPongRenderToTexture>(target) = PingPongRenderToTexture {\n    clearFirst = false\n    useDepth = false\n}\n\n// The image that is not being drawn into this frame, i.e. the previous frame's result.\nprop<HasImageView>(otherView) = target.otherImageView\n\nrenderer.renderList += \"target\" to target\n\nvar module = moduleHere {\n    /*\n    A disabled alternative: a 16-bit float colour format for the module.\n     imageFormat = VK_FORMAT_R16G16B16A16_SFLOAT\n    Match this module's attachments to the target it draws into.\n    */\n    +target\n}\nvar m = Mesh()\nmodule += \"mainMesh\" to m\ntarget += \"boo\" to module\n\n// The shaders read this push constant to move the dot. It advances a fixed 1/60 s each frame rather\n// than following the clock, so a slow frame slows the animation instead of making it jump.\nvar time = 0f\nm.time = {\n    time += 1f / 60\n    time\n}\n\n// One triangle covering the target in clip space (the vertex shader ignores any camera).\nm.set(3, 1) {\n    pos.add(-1, -1, 0, 3, -1, 0, -1, 3, 0)\n    tri.add(0, 1, 2)\n}\n"} "fragment" #afield/file-inline {"path" "a8dfc9a7-3062-4eca-ab7e-a243ff8e7bde_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\n\nlayout(push_constant) uniform matrices {\n    float time;\n} pc;\n\nlayout(set=0, binding = 0) uniform sampler2D otherView;\n\nvoid main()\n{\n    // 1024 is the target's default size, so this maps pixels to texture coordinates.\n    vec2 tc = gl_FragCoord.xy / 1024.0;\n    vec2 px = vec2(1.0 / 1024.0);\n\n    // Last frame, blurred hard and faded a little: a 3 x 3 kernel reaching 5 pixels out each way, so\n    // whatever was drawn spreads out visibly from one frame to the next and slowly dies away.\n    vec3 c = vec3(0);\n    float total = 0.0;\n    for (int y = -1; y <= 1; y++)\n        for (int x = -1; x <= 1; x++) {\n            float w = (x == 0 && y == 0) ? 4.0 : ((x == 0 || y == 0) ? 2.0 : 1.0);\n            c += w * texture(otherView, tc + 5.0 * px * vec2(x, y)).rgb;\n            total += w;\n        }\n    c = c / total * 0.996;\n\n    // A dot moving on a Lissajous path, its colour cycling, stamped into the feedback every frame.\n    vec2 at = vec2(0.5) + 0.32 * vec2(cos(pc.time * 0.9), sin(pc.time * 1.3));\n    vec3 ink = 0.5 + 0.5 * cos(pc.time + vec3(0, 2, 4));\n    c = max(c, ink * smoothstep(0.025, 0.0, length(tc - at)));\n\n    uFragColor = vec4(c, 1.0);\n}\n"} "vertex" #afield/file-inline {"path" "a8dfc9a7-3062-4eca-ab7e-a243ff8e7bde_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout(push_constant) uniform matrices {\n    float time;\n} pc;\n\nvoid main()\n{\n    // One triangle that covers the whole target, in clip space: no camera, so every pixel is drawn.\n    gl_Position = vec4(pos.xy, 0, 1);\n}\n"} "metadata" #afield/file-inline {"path" "a8dfc9a7-3062-4eca-ab7e-a243ff8e7bde_metadata_.yaml" "inline" ""} "autorun" false "nested" #{}}} {"id" "57eb613c-90e0-46e1-b075-8e1578bc4934" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "6b. debugging / mapping - Texture probe example" "preamble" "import afield.graphics.texture.LoadedTexture\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nimport afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\nvar Box.bbc by Inheritance<LoadedTexture>() /**/\nval Once.bbc by Onceing<LoadedTexture>() /**/\nval Why.bbc by Whying() /**/\n/*graphics-input:pos*/ val Mesh.pos by FromInput()\n/*graphics-input:tc*/ val Mesh.tc by FromInput()\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var pos : FloatBuffer; lateinit var tc : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"tc\") { tc = this ; mesh.write(\"pos\") { pos = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } } ;            };         }\n/*start*/\n/*graphics-structure-type:FieldProbeBuffer:FieldProbeBuffer*/\nclass FieldProbeBuffer(\n    members: List<Introspected.Member> = FieldProbeBufferLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var enabled by Structure.FromStructure<UInt>()\n    var capacity by Structure.FromStructure<UInt>()\n    var ordinalStart by Structure.FromStructure<UInt>()\n    var ordinalEndExclusive by Structure.FromStructure<UInt>()\n    var invocationCount by Structure.FromStructure<UInt>()\n    var acceptedCount by Structure.FromStructure<UInt>()\n    var finiteCount by Structure.FromStructure<UInt>()\n    var typeTag by Structure.FromStructure<UInt>()\n    var nanCount by Structure.FromStructure<UInt>()\n    var infCount by Structure.FromStructure<UInt>()\n    var nonZeroCount by Structure.FromStructure<UInt>()\n    var typeMismatchCount by Structure.FromStructure<UInt>()\n    var minOrderedX by Structure.FromStructure<UInt>()\n    var minOrderedY by Structure.FromStructure<UInt>()\n    var minOrderedZ by Structure.FromStructure<UInt>()\n    var minOrderedW by Structure.FromStructure<UInt>()\n    var maxOrderedX by Structure.FromStructure<UInt>()\n    var maxOrderedY by Structure.FromStructure<UInt>()\n    var maxOrderedZ by Structure.FromStructure<UInt>()\n    var maxOrderedW by Structure.FromStructure<UInt>()\n    var samples by Structure.FromStructure<afield.math.linalg.Vector4f>()\n}\nfun FieldProbeBufferByteSize(): Long = 4194384L\nfun FieldProbeBufferLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"enabled\", 0, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"capacity\", 4, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"ordinalStart\", 8, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"ordinalEndExclusive\", 12, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"invocationCount\", 16, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"acceptedCount\", 20, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"finiteCount\", 24, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"typeTag\", 28, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"nanCount\", 32, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"infCount\", 36, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"nonZeroCount\", 40, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"typeMismatchCount\", 44, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"minOrderedX\", 48, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"minOrderedY\", 52, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"minOrderedZ\", 56, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"minOrderedW\", 60, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"maxOrderedX\", 64, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"maxOrderedY\", 68, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"maxOrderedZ\", 72, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"maxOrderedW\", 76, PrimitiveType.uint.left(), 0, false),\n        Introspected.Member(\"samples\", 80, PrimitiveType.vec4.left(), 16, false),\n    )\nfun HasBuffer.asFieldProbeBuffer(): FieldProbeBuffer =\n    asStructure(FieldProbeBuffer(), FieldProbeBufferLayoutMembers())\nfun BufferParameters.asFieldProbeBuffer(): FieldProbeBuffer =\n    buffer.asFieldProbeBuffer()\n/*end*/\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:time*/ var Structure.time by Structure.FromStructure<Any>()\n/*graphics-pc-binding:time*/ var Mesh.time by Mesh.BoundFromStructure<Number>()\n/*graphics-pc-binding-group:time*/ var MeshGroup.time by MeshGroup.BoundFromStructure<Number>()\n/*graphics-pc-structure:warpStrength*/ var Structure.warpStrength by Structure.FromStructure<Any>()\n/*graphics-pc-binding:warpStrength*/ var Mesh.warpStrength by Mesh.BoundFromStructure<Number>()\n/*graphics-pc-binding-group:warpStrength*/ var MeshGroup.warpStrength by MeshGroup.BoundFromStructure<Number>()\n/*graphics-pc-structure:warpXLo*/ var Structure.warpXLo by Structure.FromStructure<Any>()\n/*graphics-pc-binding:warpXLo*/ var Mesh.warpXLo by Mesh.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-binding-group:warpXLo*/ var MeshGroup.warpXLo by MeshGroup.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-structure:warpXHi*/ var Structure.warpXHi by Structure.FromStructure<Any>()\n/*graphics-pc-binding:warpXHi*/ var Mesh.warpXHi by Mesh.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-binding-group:warpXHi*/ var MeshGroup.warpXHi by MeshGroup.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-structure:warpYLo*/ var Structure.warpYLo by Structure.FromStructure<Any>()\n/*graphics-pc-binding:warpYLo*/ var Mesh.warpYLo by Mesh.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-binding-group:warpYLo*/ var MeshGroup.warpYLo by MeshGroup.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-structure:warpYHi*/ var Structure.warpYHi by Structure.FromStructure<Any>()\n/*graphics-pc-binding:warpYHi*/ var Mesh.warpYHi by Mesh.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-binding-group:warpYHi*/ var MeshGroup.warpYHi by MeshGroup.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-ssbo:FieldProbeBuffer*/ val ModulePointer.FieldProbeBuffer by FromUniform()\nvar Box.window by Inheritance<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.window by Onceing<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "frame" #afield/rect [2344.5234375 3355.5 280.0 100.0] "code" #afield/file-inline {"path" "57eb613c-90e0-46e1-b075-8e1578bc4934_code_.kt" "inline" "/*\nDebugging / mapping: a texture probe that drives a quantile warp. Run this in a box beneath the\nrenderer (`window`) box.\n\nThe fragment shader (open `fragment` from the editor's property switcher) probes a value it computes\nand then remaps that value through a warp curve before drawing it. Each frame the box reads the\nprobe's samples, refits the curve so the probed values spread evenly over 0..1, and pushes the new\ncurve back to the shader. Use this when the interesting variation sits in a narrow part of the range\nand a linear readout flattens it.\n*/\n\n// The texture is bound by name: `bbc` matches the `sampler2D bbc` in the fragment shader.\n// The bundled image makes the lesson runnable; change the path to try your own.\nprop<LoadedTexture>(bbc) = LoadedTexture(\"public/docs/assets/afield_four_graphics/docs-checker-texture.png\")\nbbc.transferNow()\n\nvar module = moduleHere {}\nvar m = Mesh()\n\n// create the probe and show its readback in the \"probe\" output channel\nval probe = fieldProbeHere().display(\"probe\")\n\n// The warp starts as the identity and adapts toward a uniform distribution on 0..1, smoothed over\n// recent frames.\nval identityWarp = QuantileWarpState.identity01()\nval warp = AdaptiveQuantileWarp(\n    config = QuantileWarpConfig(\n        historyFrames = 8,\n        smoothingAlpha = 0.01,\n    ),\n    target = TargetDistributions.Uniform01,\n).reset(seed = identityWarp)\n\n/*\nConnects the probe to the warp. `install = false` means nothing runs automatically: the `loop` at the\nend calls `tick()` once per frame. Each refit is passed to the block below, which writes the curve into\nthe mesh's `warpXLo` ... `warpYHi` push constants.\n*/\nval warper = fieldProbeQuantileWarp(\n    probe = probe,\n    warp = warp,\n    config = ShaderProbeQuantileWarpConfig(\n        minSamples = 256,\n        clipLower = 0.0,\n        clipUpper = 1.0,\n        displayChannel = null,\n    ),\n    install = false,\n) { nextWarp, _ ->\n    nextWarp.applyToPushConstants(\n        setVec4 = { name, value ->\n            m.push.set(name, value)\n        },\n    )\n}\n\nmodule += \"mainMesh\" to m\nrenderer += \"boo\" to module\n\n// the camera's projection and view matrices feed the shader's `p` and `m` push constants\nval camera = Camera()\nm.p = camera.p\nm.m = camera.m\nm.warpStrength = { 1.0f }\nvar kc by keyCamera(camera = camera)\nval n = 100\n// `n` textured quads (4 vertices, 2 triangles each), stacked one unit apart along z\nm.set(4 * n, 2 * n) {\n    n {\n        val z = it + 0.0\n\n        pos.add(\n            0,\n            0,\n            0 + z,\n            1.0,\n            0.1,\n            z,\n            1,\n            1,\n            z,\n            0,\n            1,\n            z,\n        )\n\n        tc.add(\n            0,\n            0,\n            1,\n            0,\n            1,\n            1,\n            0,\n            1,\n        )\n\n        val b = it * 4\n        tri.add(b + 0, b + 1, b + 2)\n        tri.add(b + 0, b + 2, b + 3)\n    }\n}\n\n// read the probe, refit the warp and push it to the shader, every frame\nloop {\n    warper.tick()\n}\n"} "fragment" #afield/file-inline {"path" "57eb613c-90e0-46e1-b075-8e1578bc4934_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 1) in vec2 ftc;\n\nlayout(set = 0, binding = 0) uniform sampler2D bbc;\n\n// the shader side of the probe, and the warp-curve functions (fieldQuantileWarpMix)\n{% property \"fieldProbe\" %}\n{% property \"quantileWarp\" %}\n\nlayout(push_constant) uniform Controls {\n    mat4 p;\n    mat4 m;\n    float time;\n    float warpStrength;\n    vec4 warpXLo;\n    vec4 warpXHi;\n    vec4 warpYLo;\n    vec4 warpYHi;\n} pc;\n// warpXLo ... warpYHi hold the eight knots of the warp curve, written from the box code each frame\n\nvoid main()\n{\n    vec4 c = texture(bbc, ftc.yx)/10.0;\n    c.r += sin(ftc.x*10.0+ftc.y*123.3)*0.0001;\n\n    // remap c.r through the warp curve; pc.warpStrength is the strength, 1 = fully warped\n    float r = fieldQuantileWarpMix(\n    c.r,\n    pc.warpStrength,\n    pc.warpXLo,\n    pc.warpXHi,\n    pc.warpYLo,\n    pc.warpYHi\n    );\n\n    // probe only a sparse, scattered subset of fragments, and probe the value before the warp\n    if (length(fract(gl_FragCoord.xy*100.9123))<0.1)\n    fieldProbe(c.r);\n\n    uFragColor = vec4(vec3(r), 1.0);\n}\n"} "vertex" #afield/file-inline {"path" "57eb613c-90e0-46e1-b075-8e1578bc4934_vertex_.glsl" "inline" "#version 450\n\nlayout (location = 0) in vec3 pos;\nlayout (location = 1) in vec2 tc;\n\nlayout (location = 1) out vec2 ftc;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n    float time;\n    float warpStrength;\n    vec4 warpXLo;\n    vec4 warpXHi;\n    vec4 warpYLo;\n    vec4 warpYHi;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n\n    ftc = tc;\n}\n"} "metadata" #afield/file-inline {"path" "57eb613c-90e0-46e1-b075-8e1578bc4934_metadata_.yaml" "inline" ""} "autorun" false "nested" #{} "source_id" "e1d6dd17-1ebd-40e7-a0ef-309779c562ff"}} {"id" "89403ce3-cf5e-4a24-82ab-cb645c91a683" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [569.0 473.0 100.0 100.0] "code" #afield/file-inline {"path" "89403ce3-cf5e-4a24-82ab-cb645c91a683_code_.kt" "inline" "print(\"hello world\")\n"} "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "19e9f8ed-78f3-491c-b64a-9ce99333a657" "properties" {"children" #{} "parents" #{} "name" "sort_0" "frame" #afield/rect [-49.04296875 1.55859375 65.4453125 74.5078125] "code" #afield/file-inline {"path" "19e9f8ed-78f3-491c-b64a-9ce99333a657_code_.kt" "inline" "\n"} "preamble" "" "compute" #afield/file-inline {"path" "19e9f8ed-78f3-491c-b64a-9ce99333a657_compute_.glsl" "inline" "#version 460\n#extension GL_GOOGLE_include_directive: enable\n#extension GL_KHR_shader_subgroup_basic: enable\n#extension GL_KHR_shader_subgroup_arithmetic: enable\n#extension GL_KHR_shader_subgroup_ballot: enable\n\n#define WORKGROUP_SIZE 256// assert WORKGROUP_SIZE >= RADIX_SORT_BINS\n#define RADIX_SORT_BINS 256\n#define SUBGROUP_SIZE 32// 32 NVIDIA; 64 AMD\n\nlayout (local_size_x = WORKGROUP_SIZE) in;\n\nlayout (push_constant, std430) uniform PushConstants {\n    uint g_num_elements;\n    uint g_shift;\n    uint g_num_workgroups;\n    uint g_num_blocks_per_workgroup;\n};\n\nlayout (std430, set = 0, binding = 0) buffer m_buffer0 {\n    uint g_elements_in[];\n};\n\nlayout (std430, set = 0, binding = 1) buffer m_buffer1 {\n    uint g_elements_out[];\n};\n\nlayout (std430, set = 1, binding = 0) buffer m_bufferHistogram {\n    // [histogram_of_workgroup_0 | histogram_of_workgroup_1 | ... ]\n    uint g_histograms[]; // |g_histograms| = RADIX_SORT_BINS * #WORKGROUPS\n};\n\nshared uint[RADIX_SORT_BINS / SUBGROUP_SIZE] sums;// subgroup reductions\nshared uint[RADIX_SORT_BINS] global_offsets;// global exclusive scan (prefix sum)\n\nstruct BinFlags {\n    uint flags[WORKGROUP_SIZE / 32];\n};\nshared BinFlags[RADIX_SORT_BINS] bin_flags;\n\nvoid main() {\n    uint gID = gl_GlobalInvocationID.x;\n    uint lID = gl_LocalInvocationID.x;\n    uint wID = gl_WorkGroupID.x;\n    uint sID = gl_SubgroupID;\n    uint lsID = gl_SubgroupInvocationID;\n\n    uint local_histogram = 0;\n    uint prefix_sum = 0;\n    uint histogram_count = 0;\n\n    if (lID < RADIX_SORT_BINS) {\n        uint count = 0;\n        for (uint j = 0; j < g_num_workgroups; j++) {\n            const uint t = g_histograms[RADIX_SORT_BINS * j + lID];\n            local_histogram = (j == wID) ? count : local_histogram;\n            count += t;\n        }\n        histogram_count = count;\n        const uint sum = subgroupAdd(histogram_count);\n        prefix_sum = subgroupExclusiveAdd(histogram_count);\n        if (subgroupElect()) {\n            // one thread inside the warp/subgroup enters this section\n            sums[sID] = sum;\n        }\n    }\n    barrier();\n\n    if (lID < RADIX_SORT_BINS) {\n        const uint sums_prefix_sum = subgroupBroadcast(subgroupExclusiveAdd(sums[lsID]), sID);\n        const uint global_histogram = sums_prefix_sum + prefix_sum;\n        global_offsets[lID] = global_histogram + local_histogram;\n    }\n\n    //     ==== scatter keys according to global offsets =====\n    const uint flags_bin = lID / 32;\n    const uint flags_bit = 1 << (lID % 32);\n\n    for (uint index = 0; index < g_num_blocks_per_workgroup; index++) {\n        uint elementId = wID * g_num_blocks_per_workgroup * WORKGROUP_SIZE + index * WORKGROUP_SIZE + lID;\n\n        // initialize bin flags\n        if (lID < RADIX_SORT_BINS) {\n            for (int i = 0; i < WORKGROUP_SIZE / 32; i++) {\n                bin_flags[lID].flags[i] = 0U;// init all bin flags to 0\n            }\n        }\n        barrier();\n\n        uint element_in = 0;\n        uint binID = 0;\n        uint binOffset = 0;\n        if (elementId < g_num_elements) {\n            element_in = g_elements_in[elementId];\n            binID = uint(element_in >> g_shift) & uint(RADIX_SORT_BINS - 1);\n            // offset for group\n            binOffset = global_offsets[binID];\n            // add bit to flag\n            atomicAdd(bin_flags[binID].flags[flags_bin], flags_bit);\n        }\n        barrier();\n\n        if (elementId < g_num_elements) {\n            // calculate output index of element\n            uint prefix = 0;\n            uint count = 0;\n            for (uint i = 0; i < WORKGROUP_SIZE / 32; i++) {\n                const uint bits = bin_flags[binID].flags[i];\n                const uint full_count = bitCount(bits);\n                const uint partial_count = bitCount(bits & (flags_bit - 1));\n                prefix += (i < flags_bin) ? full_count : 0U;\n                prefix += (i == flags_bin) ? partial_count : 0U;\n                count += full_count;\n            }\n            g_elements_out[binOffset + prefix] = element_in;\n            if (prefix == count - 1) {\n                atomicAdd(global_offsets[binID], count);\n            }\n        }\n\n        barrier();\n    }\n}"} "_tombstone" true "autorun" false "nested" #{}}} {"id" "f8532a8f-6782-44d7-bb95-b735dbafeb65" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [366.9403381347656 478.6108093261719 101.81817626953125 101.81820678710938] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "fe5a9b04-a029-4287-b1f5-0c2d4b060396" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [306.2379455566406 598.8210144042969 101.81817626953125 101.81820678710938] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "872869bf-fa33-4015-a911-d1042206d927" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [-269.9999