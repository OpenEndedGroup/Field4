s mapping.\n    uFragColor = texture(uTextures[0], vUV);\n}\n"} "vertex" #afield/file-inline {"path" "f1d2cbea-b20d-4794-b9f7-37b847dcdeb6_vertex_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\n#extension GL_EXT_scalar_block_layout : require\n\nlayout(std430, buffer_reference) readonly buffer VertexBuffer {\n    float vertexData[];\n};\n\nlayout(std430, buffer_reference) readonly buffer IndexBuffer {\n    uint indexData[];\n};\n\nlayout(push_constant) uniform PushConstants {\n    mat4 modelView;        // view * model\n    mat4 proj;             // projection\n\n    vec4 materialBaseColor;\n\n    uint vertexOffset;     // in floats\n    uint indexOffset;      // in indices\n    uint vertexStride;     // in floats\n    uint useVertexColor;   // bool as uint\n\n    VertexBuffer vertexBuffer;\n    IndexBuffer indexBuffer;\n} pc;\n\nlayout(location = 0) out vec3 vViewPos;\nlayout(location = 1) out vec3 vNormalVS;\nlayout(location = 2) out vec2 vUV;\nlayout(location = 3) out vec4 vColor;\n\nvoid main()\n{\n    // Fetch the index ourselves, then unpack this vertex from the flat float buffer: position at +0,\n    // normal at +3, uv at +6, colour at +8. The offsets select this primitive's slice of shared buffers.\n    uint idx = pc.indexBuffer.indexData[pc.indexOffset+uint(gl_VertexIndex)];\n    uint base = pc.vertexOffset + idx * pc.vertexStride;\n\n    vec3 pos = vec3(\n        pc.vertexBuffer.vertexData[base + 0],\n        pc.vertexBuffer.vertexData[base + 1],\n        pc.vertexBuffer.vertexData[base + 2]\n    );\n\n    vec3 normal = vec3(\n        pc.vertexBuffer.vertexData[base + 3],\n        pc.vertexBuffer.vertexData[base + 4],\n        pc.vertexBuffer.vertexData[base + 5]\n    );\n\n    vec2 uv = vec2(\n        pc.vertexBuffer.vertexData[base + 6],\n        pc.vertexBuffer.vertexData[base + 7]\n    );\n\n    vec4 color = vec4(\n        pc.vertexBuffer.vertexData[base + 8],\n        pc.vertexBuffer.vertexData[base + 9],\n        pc.vertexBuffer.vertexData[base + 10],\n        pc.vertexBuffer.vertexData[base + 11]\n    );\n\n    if (pc.useVertexColor == 0u) {\n        color = vec4(1.0);\n    }\n\n    vec4 viewPos =  pc.proj * pc.modelView*vec4(pos, 1.0);\n\n    mat3 mv3 = mat3(pc.modelView);\n    vec3 normalVS = normalize(mv3 * normal);\n\n    vViewPos = viewPos.xyz;\n    vNormalVS = normalVS;\n    vUV = uv;\n    vColor = color * pc.materialBaseColor;\n\n    gl_Position = viewPos;\n}"} "autorun" false "nested" #{}}} {"id" "65bd0587-dbfa-451a-8f6a-e003ff3d1abf" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "7. slang — hello triangle" "preamble" "import afield.graphics.vulkan.Renderer\nimport java.nio.*\nimport arrow.core.right\nimport arrow.core.left\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport afield.graphics.vulkan.util.Window\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;     this.resize(numVert, numTriangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:vertexData*/ var Structure.vertexData by Structure.FromStructure<Any>()\n/*graphics-pc-binding:vertexData*/ var Mesh.vertexData by Mesh.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-binding-group:vertexData*/ var MeshGroup.vertexData by MeshGroup.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-structure:d*/ var Structure.d by Structure.FromStructure<Any>()\n/*graphics-pc-binding:d*/ var Mesh.d by Mesh.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-binding-group:d*/ var MeshGroup.d by MeshGroup.BoundFromStructure<afield.math.linalg.Vector4f>()\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "frame" #afield/rect [2820.5234374999995 1375.5 280.0 100.0] "code" #afield/file-inline {"path" "65bd0587-dbfa-451a-8f6a-e003ff3d1abf_code_.kt" "inline" "/*\nSlang: hello triangle. Run this in a box beneath the renderer (`window`) box.\n\nThe Kotlin here is the same as \"1. hello triangle\"; what changes is the shader language. This box has a\n`vertex_fragment` property holding one Slang source with both stages (`vsMain` and `fsMain`); when it\nis non-blank it takes the place of the separate `vertex` and `fragment` shaders. Open `vertex_fragment`\nfrom the editor's property switcher (`f1` or `ctrl-P`) to read or edit it. Compiling it needs `slangc`\non the machine.\n\nNothing below depends on the language: reflection reads the compiled shader's interface, so the mesh\naccessors (`m.vertexData`) come out the same as they do for GLSL.\n*/\n\n// A shader module owned by this box that draws filled triangles\nvar module = moduleHere { primitiveType = triangles }\n\n// ... and a mesh, which runs that module's shaders over some data\nvar m = Mesh()\n\n// Connect the mesh to the module under the name \"someMesh\"\nmodule += m named \"someMesh\"\n\n// ... and connect the module to the renderer (under the name of this box)\nrenderer += module\n\n/*\nA buffer for the vertex positions.\n- `size = 3.vec4s` is a starting size. The loop below writes up to 150 vec4s, and the buffer grows to\n  fit what is written rather than failing.\n- `perFrame = true` gives one Vulkan buffer per frame in flight, so the CPU can write this frame's\n  data while the GPU is still reading an earlier frame's, without waiting.\n*/\nvar vertexData = defaultBuffer {\n    perFrame = true\n    size = 3.vec4s\n}\n    .buffer\n\n// Hand the buffer to the mesh. `m.vertexData` exists, with the right type, because Field reflected the\n// shader and found the `vertexData` pointer in its push constants.\nm.vertexData = { vertexData }\n\n// Nothing has been written to the buffer yet. That is fine: the mesh draws nothing until it is given a\n// vertex count with `m.resize` below.\n\n// A small animation: a row of triangles turning in circles\nvar t = 0.0\nfun polar(t: Double, r: Double) = vec(Math.sin(t), Math.cos(t)) * r.f\n\nloop {\n    t += 0.01\n    var num = 0\n\n    // the number of triangles changes over time: vertices can be added and removed while running\n    var numVertToWrite = (Math.sin(t * 0.1) * 20 + 30).i\n\n    vertexData.write {\n        for (x in 0 until numVertToWrite) {\n            val offset = vec(x * 0.02, 0, 0)\n            put(vec(polar(t, 0.5), 0) + offset)\n            put(vec(polar(t + 0.4, 0.4), 0) + offset)\n            put(vec(polar(t + 0.9, 0.3), 0) + offset)\n\n            num += 3\n        }\n    }\n\n    // Tell the mesh how many vertices to draw. With `primitiveType = triangles` every three make a\n    // triangle; where each vertex goes is up to the vertex shader.\n    m.resize(num)\n\n    // `loop` ignores this value and keeps running, once per frame, until the box is stopped\n    true\n}\n\n// Because `loop` is the last expression in the box, its body runs once per animation frame when the box is\n// launched (`alt-mouse-swipe` or `alt-up`).\n"} "metadata" #afield/file-inline {"path" "65bd0587-dbfa-451a-8f6a-e003ff3d1abf_metadata_.yaml" "inline" "docOrder: 0"} "autorun" false "nested" #{} "vertex_fragment" #afield/file-inline {"path" "65bd0587-dbfa-451a-8f6a-e003ff3d1abf_vertex_fragment_.slang" "inline" "// The Slang source for this lesson: the vertex stage (`vsMain`) and fragment stage (`fsMain`) in one file.\n// Field compiles it once per stage with `slangc`.\n\n// An entry point's `uniform` parameter becomes the push-constant block. `vertexData` is a pointer to the\n// buffer the Kotlin side assigns with `m.vertexData = { vertexData }`.\nstruct Matrices\n{\n    float4x4 p;\n    float4x4 m;\n    float4* vertexData;\n    float4 d;\n};\n\nstruct Varyings\n{\n    float4 position : SV_Position;\n    float4 localColor : TEXCOORD0;\n};\n\n// a ramp from 0 to 1 that repeats every b vertices, used to give each vertex its own colour\nfloat wrap(int a, int b)\n{\n    return float(a % b) / float(b - 1);\n}\n\n[shader(\"vertex\")]\nVaryings vsMain(uint vertexIndex : SV_VulkanVertexID, uniform Matrices matrices)\n{\n    Varyings output;\n\n    // positions are already in clip space, so no camera transform is applied\n    output.position = float4(matrices.vertexData[vertexIndex].xyz, 1.0);\n    output.localColor = float4(\n        wrap(int(vertexIndex), 3),\n        wrap(int(vertexIndex), 5),\n        wrap(int(vertexIndex), 11),\n        1.0);\n\n    return output;\n}\n\n[shader(\"fragment\")]\nfloat4 fsMain(Varyings input) : SV_Target0\n{\n    return float4(input.localColor.rgb, 1.0);\n}"} "source_id" "af0946dd-f25d-4355-984d-f0d24a43ee12"}} {"id" "42056e8d-ec8b-4bf8-b84a-1cd1d8524510" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "5c. some more templating" "preamble" "import afield.graphics.vulkan.buffers.*\nimport afield.docu