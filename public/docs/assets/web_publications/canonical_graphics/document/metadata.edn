       ssboSizer = { ubo ->\n            numVec4 * 4 * 4\n        }\n    },\n)\n\nvar m = ComputeMesh()\nvar localSize = 16\nm.x = numVec4 / localSize\nm.y = 1\nm.z = 1\nmodule += \"mainInvocation\" to m\nrenderer += \"runCompute\" to module\n\n// could be better\nprop<VulkanBuffer>(buffer) = module.InputBuffer.proxying!!\n\nvar fr = 0\nmodule.InputBuffer.mapAndWrite {\n    this.clear()\n    for (n in 0 until numVec4) {\n        this.add(Math.random().toFloat())\n        this.add(Math.random().toFloat())\n        this.add(Math.random().toFloat() - 0.5)\n        this.add(Math.random().toFloat() - 0.5)\n    }\n    this.clear()\n}\n\nframes {\n    while (true) {\n        fr++\n\n        module.InputBuffer.mapAndRead {\n            var s = \"${fr}:: \"\n            this.clear()\n            for (n in 0 until 2) s += this.get(n).toString() + \" \"\n            _print(s)\n        }\n\n        frame()\n    }\n}\n"} "compute" #afield/file-inline {"path" "dde61a17-912c-4577-8128-681829c23fec_compute_.glsl" "inline" "#version 450\nlayout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;\n\nlayout(set=0, binding = 0) buffer InputBuffer {\n    vec4 dat[];\n};\n\nvoid main() {\n    uint idx = gl_GlobalInvocationID.x;\n    float timeStep = 1.1;\n    dat[idx].xy += dat[idx].zw * timeStep;\n    dat[idx].zw *= 0.99;\n}"} "metadata" #afield/file-inline {"path" "dde61a17-912c-4577-8128-681829c23fec_metadata_.yaml" "inline" ""} "autorun" false "nested" #{} "_tombstone" true}} {"id" "459b9c54-6363-4c27-a033-2f145e017022" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "a8dfc9a7-3062-4eca-ab7e-a243ff8e7bde"} "name" "5. draw pingpoing " "preamble" "import afield.graphics.texture.HasImageView\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nimport afield.graphics.vulk