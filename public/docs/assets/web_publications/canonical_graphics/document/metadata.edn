(index == 0) {\n    reduction = 0;\n  }\n  barrier();\n\n  for (uint i = 0; WORKGROUP_SIZE * i < partitionCount; ++i) {\n    uint partitionIndex = WORKGROUP_SIZE * i + index;\n    uint value = partitionIndex < partitionCount ? partitionHistogramReference.partitionHistogram[RADIX * partitionIndex + radix] : 0;\n    uint excl = subgroupExclusiveAdd(value) + reduction;\n    uint sum = subgroupAdd(value);\n\n    if (subgroupElect()) {\n      intermediate[subgroupIndex] = sum;\n    }\n    barrier();\n\n    if (index < gl_NumSubgroups) {\n      uint excl = subgroupExclusiveAdd(intermediate[index]);\n      uint sum = subgroupAdd(intermediate[index]);\n      intermediate[index] = excl;\n\n      if (index == 0) {\n        reduction += sum;\n      }\n    }\n    barrier();\n\n    if (partitionIndex < partitionCount) {\n      excl += intermediate[subgroupIndex];\n      partitionHistogramReference.partitionHistogram[RADIX * partitionIndex + radix] = excl;\n    }\n    barrier();\n  }\n\n  if (gl_WorkGroupID.x == 0) {\n    // one workgroup is responsible for global histogram prefix sum\n    if (index < RADIX) {\n      uint value = globalHistogramReference.globalHistogram[RADIX * pass + index];\n      uint excl = subgroupExclusiveAdd(value);\n      uint sum = subgroupAdd(value);\n\n      if (subgroupElect()) {\n        intermediate[subgroupIndex] = sum;\n      }\n      barrier();\n\n      if (index < RADIX / gl_SubgroupSize) {\n        uint excl = subgroupExclusiveAdd(intermediate[index]);\n        intermediate[index] = excl;\n      }\n      barrier();\n\n      excl += intermediate[subgroupIndex];\n      globalHistogramReference.globalHistogram[RADIX * pass + index] = excl;\n    }\n  }\n}"} "metadata" #afield/file-inline {"path" "113bce66-b253-4507-83cd-bcc442352ade_metadata_.yaml" "inline" ""} "autorun" false "nested" #{} "_tombstone" true}} {"id" "776f6810-388a-466a-ac0c-82b263f037f1" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "inline uniform" "frame" #afield/rect [-373.8359375 712.40234375 100.0 100.0] "preamble" "" "code" #afield/file-inline {"path" "776f6810-388a-466a-ac0c-82b263f037f1_code_.kt" "inline" "// an example of storing the camera transforms inside a uniform buffer as opposed to using push constants. Usually we'd\n// _not_ do this. We're all in on buffer\nvar m = Mesh()\nvar module = moduleHere {\n    inlineUniforms = setOf(\"camera\")\n}\n\nmodule += \"mainMesh\" to m\nrenderer += module\n\nval camera = Camera()\ncamera.at = vec(-10, 2, 0)\nKeyCamera(camera = camera)\n\nvar tick = 0.0\nloop {\n    module.camera.m = camera.m()\n    module.camera.p = camera.p()\n    if (tick < 3) {\n        camera.at = vec(-10 * Math.sin(tick), 0, 10 * Math.cos(tick))\n        for (n in 1..100) {\n            camera.at = vec(-10 * Math.sin(tick), 0, 10 * Math.cos(tick))\n            tick += 0.01\n            m.set(3 * n, 1 * n) {\n                n {\n                    val z = 0.0 + it\n                    pos.add(0, 0, -1 + z, 1.0, 0.1, z, 1, 1, z)\n                    3 {\n                        col.add(10 - it * 0, it / 3.0, 1 - it / 3.0, 1)\n                    }\n                    tri.add(0 + 3 * it, 1 + 3 * it, 2 + 3 * it)\n                }\n            }\n            frame()\n        }\n    } else {\n        tick += 0.01\n        //        camera.at = vec(-10*Math.sin(tick),0,10*Math.cos(tick))\n        _print(tick)\n        frame()\n    }\n    true\n}\n"} "fragment" #afield/file-inline {"path" "776f6810-388a-466a-ac0c-82b263f037f1_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nvoid main()\n{\n    uFragColor = vec4(1.0, 0.8, 0.4, 1.0);\n}"} "vertex" #afield/file-inline {"path" "776f6810-388a-466a-ac0c-82b263f037f1_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\nlayout (set=0, binding = 0) uniform camera {\n    mat4 p;\n    mat4 m;\n} cam;\n\nvoid main()\n{\n    gl_Position = cam.p*cam.m*vec4(pos, 1);\n\n    fcol = col;\n}"} "_tombstone" true "autorun" false "nested" #{}}} {"id" "12ca48e3-456f-4423-bb0e-a9ab8b36ba7f" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [244.00001148744002 -276.54544664414493 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "fff56e56-9e7a-4add-9d19-140e1919acb1" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [190.00001148744002 -72.54544664414493 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "12c49c80-24b2-46ad-88fc-e7d33b481bd3" "properties" {"children" #{} "parents" #{} "name" "" "frame" #afield/rect [852.90234375 769.3828125 98.0 98.0] "code" #afield/file-inline {"path" "12c49c80-24b2-46ad-88fc-e7d33b481bd3_code_.kt" "inline" "\n"} "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "81f27655-7d32-4a4d-b73d-1b5d368efaa7" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "6. debugging — printf" "frame" #afield/rect [2344.5234375 2365.5 280.0 100.0] "code" #afield/file-inline {"path" "81f27655-7d32-4a4d-b73d-1b5d368efaa7_code_.kt" "inline" "/*\nDebugging: printf from a shader. Run this in a box beneath the renderer (`window`) box.\n\nThe Kotlin is a cut-down hello triangle; the lesson is in the vertex shader (open `vertex` from the\neditor's property switcher). It enables `GL_EXT_debug_printf` and calls `debugPrintfEXT` for vertex 0\nonly, so one line per draw reaches the log. Printing goes through the Vulkan validation layer\n(`Options.validate`, on by default, or `Options.shaderDebugPrintf`).\n*/\n\nvar module = moduleHere { primitiveType = triangles }\n\nvar m = Mesh()\nmodule += m named \"someMesh\"\nrenderer += module\n\nvar vertexData = defaultBuffer {\n    perFrame = true\n    size = 3.vec4s\n}\n    .buffer\n\n// `m.vertexData` is reflected from the `vertexData` buffer reference in the vertex shader's push constants\nm.vertexData = { vertexData }\nvar t = 0.0\n\nloop {\n    t += 0.01\n    var num = 0\n\n    var numVertToWrite = 3\n\n    // writes the same triangle three times, so the three copies draw on top of one another\n    vertexData.write {\n        for (x in 0 until numVertToWrite) {\n            put(vec(0, 0, 0))\n            put(vec(1, 0, 0))\n            put(vec(0, 1, 0))\n            num += 3\n        }\n    }\n\n    // the number of vertices to draw\n    m.resize(num)\n    true\n}\n"} "preamble" "import afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nimport afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;     this.resize(numVert, numTriangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\n/*start*/\n/*graphics-structure-type:vertexData:VertexDataBlock*/\n// GLSL block `vertexData` is VertexDataBlock here: VertexData would hide afield.graphics.render.VertexData.\nclass VertexDataBlock(\n    members: List<Introspected.Member> = VertexDataBlockLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var positions by Structure.FromStructure<afield.math.linalg.Vector4f>()\n}\nfun VertexDataBlockByteSize(): Long = 16L\nfun VertexDataBlockLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"positions\", 0, PrimitiveType.vec4.left(), 16, false),\n    )\nfun HasBuffer.asVertexDataBlock(): VertexDataBlock =\n    asStructure(VertexDataBlock(), VertexDataBlockLayoutMembers())\nfun BufferParameters.asVertexDataBlock(): VertexDataBlock =\n    buffer.asVertexDataBlock()\n/*end*/\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:vertexData*/ var Structure.vertexData by Structure.FromStructure<Any>()\n/*graphics-pc-binding:vertexData*/ var Mesh.vertexData by Mesh.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-binding-group:vertexData*/ var MeshGroup.vertexData by MeshGroup.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\nvar Box.window by Inheritance<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.window by Onceing<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "fragment" #afield/file-inline {"path" "81f27655-7d32-4a4d-b73d-1b5d368efaa7_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\n\n// location 0 here needs to match location 0 in the vertexShader\nlayout(location = 0) in vec4 localColor;\nvoid main()\n{\n    uFragColor = vec4(localColor.rgb, 0.3);\n}"} "vertex" #afield/file-inline {"path" "81f27655-7d32-4a4d-b73d-1b5d368efaa7_vertex_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\n// required for debugPrintfEXT\n#extension GL_EXT_debug_printf : enable\n\nlayout(std430, buffer_reference) buffer vertexData\n{\n    vec4 positions[];\n};\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n    vertexData vertexData;\n} pc;\n\nlayout(location=0) out vec4 localColor;\n\nfloat wrap(int a, int b) {\n    // Divide as floats so the ramp includes intermediate channel values.\n    return float(a % b) / float(b - 1);\n}\n\nvoid main()\n{\n    vec3 pos = pc.vertexData.positions[gl_VertexIndex].xyz;\n    gl_Position = vec4(pos, 1);\n\n    localColor = vec4(wrap(gl_VertexIndex,3),wrap(gl_VertexIndex,5),wrap(gl_VertexIndex,11),1.0);\n\n    // Guard the print: unguarded, every vertex of every draw would print and flood the log.\n    if (gl_VertexIndex == 0) {\n        debugPrintfEXT(\"VS: index=%d, pos=(%f,%f)\",gl_VertexIndex, pos.x, pos.y);\n    }\n}\n"} "autorun" false "nested" #{}}} {"id" "c6dbb6d0-1b0f-45de-bfc4-717e188004f5" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [2.0 0.0 108.0703125 2.25] "preamble" "" "_tombstone" true "code" #afield/file-inline {"path" "c6dbb6d0-1b0f-45de-bfc4-717e188004f5_code_.kt" "inline" "\n"} "autorun" false "nested" #{}}} {"id" "8b8d3306-5c31-49aa-ab27-659a992ebd09" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "3. compute shader" "frame" #afield/rect [916.5234374999998 1375.5 280.0 100.0] "code" #afield/file-inline {"path" "8b8d3306-5c31-49aa-ab27-659a992ebd09_code_.kt" "inline" "/*\n3. compute shader\n\nRuns a compute shader every frame over a small storage buffer and prints the results back on the CPU.\nNeeds the renderer window box as its parent.\n\nThe shader is in the `compute` property (open it with the editor's property switcher, `f1` or `ctrl-P`).\nIt declares two storage buffers, `InputBuffer` and `OutputBuffer`, bound by descriptor. Newer lessons\n(\"3b. compute particles\") pass buffers as buffer references instead, which is usually the better choice.\n*/\nvar numVec4 = 16\n\n// Storage buffers declared in the shader are allocated by the module; `ssboSizer` returns each one's size\n// in bytes (here 16 vec4s of 4 floats of 4 bytes, for both buffers)\nvar module = computeModuleHere {\n    ssboSizer = { ubo ->\n        numVec4 * 4 * 4\n    }\n}\n\nvar m = ComputeMesh()\n// must match `local_size_x` in the compute shader\nvar localSize = 16\n// number of workgroups to dispatch: enough groups of `localSize` to cover every vec4\nm.x = numVec4 / localSize\nm.y = 1\nm.z = 1\nmodule += \"mainInvocation\" to m\nrenderer += \"runCompute\" to module\n\nvar fr = 0\n// Write the initial input. `module.InputBuffer` exists because the shader declares that buffer.\nmodule.InputBuffer.mapAndWrite {\n    this.clear()\n    for (n in 0 until numVec4) {\n        this.add(n.toFloat() * 13.0)\n    }\n    this.clear()\n}\n\nframes {\n    while (true) {\n\n        // read the first 10 floats of the output back and print them\n        module.OutputBuffer.mapAndRead {\n            var s = \"${fr}:: \"\n            this.clear()\n            for (n in 0 until 10) s += this.get(n).toString() + \" \"\n            print(s)\n        }\n\n        fr++\n        // wait for the next frame\n        frame()\n    }\n}\n"} "preamble" "import afield.graphics.vulkan.Renderer\nimport arrow.core.right\nimport arrow.core.left\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport afield.graphics.vulkan.util.Window\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/\n/*start*/\n/*compute-structure-type:OutputBuffer:OutputBuffer*/\nclass OutputBuffer(\n    members: List<Introspected.Member> = OutputBufferLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var outData by Structure.FromStructure<afield.math.linalg.Vector4f>()\n}\nfun OutputBufferByteSize(): Long = 16L\nfun OutputBufferLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"outData\", 0, PrimitiveType.vec4.left(), 16, false),\n    )\nfun HasBuffer.asOutputBuffer(): OutputBuffer =\n    asStructure(OutputBuffer(), OutputBufferLayoutMembers())\nfun BufferParameters.asOutputBuffer(): OutputBuffer =\n    buffer.asOutputBuffer()\n/*end*/\n/*start*/\n/*compute-structure-type:InputBuffer:InputBuffer*/\nclass InputBuffer(\n    members: List<Introspected.Member> = InputBufferLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var inData by Structure.FromStructure<afield.math.linalg.Vector4f>()\n}\nfun InputBufferByteSize(): Long = 16L\nfun InputBufferLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"inData\", 0, PrimitiveType.vec4.left(), 16, false),\n    )\nfun HasBuffer.asInputBuffer(): InputBuffer =\n    asStructure(InputBuffer(), InputBufferLayoutMembers())\nfun BufferParameters.asInputBuffer(): InputBuffer =\n    buffer.asInputBuffer()\n/*end*/\n/*compute-ssbo:OutputBuffer*/ val ComputeModulePointer.OutputBuffer by ComputeMesh.FromUniform()\n/*compute-ssbo:InputBuffer*/ val ComputeModulePointer.InputBuffer by ComputeMesh.FromUniform()\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "compute" #afield/file-inline {"path" "8b8d3306-5c31-49aa-ab27-659a992ebd09_compute_.glsl" "inline" "#version 450\n// 16 invocations per workgroup; the box's `localSize` must match\nlayout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;\n\nlayout(set=0, binding = 0) writeonly buffer OutputBuffer {\n    vec4 outData[];\n};\n\nlayout(set=0, binding = 1) readonly buffer InputBuffer {\n    vec4 inData[];\n};\n\n\nvoid main() {\n    // one invocation per vec4\n    uint idx = gl_GlobalInvocationID.x;\n    if (idx<256)\n    outData[idx] = vec4(0.0)+inData[idx]*vec4(1,1,1,1)+vec4(3+idx*1, -(idx*21.0), idx*3, idx*4);\n}\n"} "metadata" #afield/file-inline {"path" "8b8d3306-5c31-49aa-ab27-659a992ebd09_metadata_.yaml" "inline" ""} "autorun" false "nested" #{}}} {"id" "b42d7b13-680e-4f9b-b789-8e6e7d8c4a21" "properties" {"children" #{} "parents" #{#afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "5d. GPU schema" "frame" #afield/rect [1868.5234375 3850.5 280.0 100.0] "autorun" false "nested" #{} "code" #afield/file-inline {"path" "b42d7b13-680e-4f9b-b789-8e6e7d8c4a21_code_.kt" "inline" "/*\n5d. GPU schema: one Kotlin data class describes vertex memory for both Kotlin and GLSL.\nParent: window. Three position/colour vertices form one triangle. The vertex shader (open it with\nthe editor's property switcher) splices in the generated struct with {{ Vertex.all }} and reads the\nvertices from a buffer by gl_VertexIndex, so the mesh has no vertex attributes of its own.\n*/\nname = \"5d. GPU schema\"\n\n@GpuStruct\ndata class Vertex(\n    val position: Vector3f,\n    val color: Vector4f,\n)\n\n// gpuSchema reflects the @GpuStruct class into a layout; its template exposes the GLSL declarations.\nval vertexSchema = gpuSchema<Vertex>()\nshaderTemplate[\"Vertex\"] = vertexSchema.template\n\nval vertices = [\n    Vertex(vec(-0.8f, -0.6f, 0f), vec(1f, 0.15f, 0.1f, 1f)),\n    Vertex(vec(0.8f, -0.6f, 0f), vec(0.1f, 0.9f, 0.3f, 1f)),\n    Vertex(vec(0.0f, 0.7f, 0f), vec(0.2f, 0.4f, 1.0f, 1f)),\n]\n\n// A buffer sized from the schema stride, filled with the vertices in the schema's byte layout.\nval vertexData = defaultBuffer {\n    size = (vertices.size * vertexSchema.strideBytes).bytes\n}\n    .buffer\n\nvertexData.mapAndWrite_bytes {\n    vertexSchema.writeArray(vertices, this)\n}\n\n// `//%-` is Field's execution break: the schema template exists before moduleHere reads the shader.\n//%-\n\nvar module = moduleHere {\n    primitiveType = triangles\n}\n\nvar m = Mesh()\nmodule += m named \"gpu schema triangle\"\nrenderer += module\n\n// `vertices` is a reflected physical pointer. Field writes vertexData's device address into\n// the push constant; the array itself stays in the addressable buffer.\nm.vertices = { vertexData }\nm.count = { vertices.size }\n\n// Draw vertices.size vertices; the shader fetches each from the buffer.\nm.resize(vertices.size)\n"} "vertex" #afield/file-inline {"path" "b42d7b13-680e-4f9b-b789-8e6e7d8c4a21_vertex_.glsl" "inline" "#version 460\n\n// Generated from the Kotlin Vertex class: the struct and the VertexArray buffer reference.\n{{ Vertex.all }}\n\nlayout(push_constant) uniform Push {\n    VertexArray vertices;\n    uint count;\n} pc;\n\nlayout(location = 0) out vec4 fcol;\n\nvoid main()\n{\n    uint i = uint(gl_VertexIndex);\n    Vertex vertex = pc.vertices.elements[i];\n\n    gl_Position = vec4(vertex.position, 1.0);\n    fcol = vertex.color * float(pc.count > 0u);\n}\n"} "fragment" #afield/file-inline {"path" "b42d7b13-680e-4f9b-b789-8e6e7d8c4a21_fragment_.glsl" "inline" "#version 460\n\nlayout(location = 0) in vec4 fcol;\nlayout(location = 0) out vec4 uFragColor;\n\nvoid main()\n{\n    uFragColor = fcol;\n}\n"} "metadata" #afield/file-inline {"path" "b42d7b13-680e-4f9b-b789-8e6e7d8c4a21_metadata_.yaml" "inline" "# 5d. GPU schema\n# Intentionally a separate lesson from 5c. some more templating / PushConstants<T>.\n"} "preamble" "import afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nimport afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;     this.resize(numVert, numTriangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\n/*start*/\n/*graphics-structure-type:Vertex:Vertex*/\nclass Vertex(\n    members: List<Introspected.Member> = VertexLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var position by Structure.FromStructure<afield.math.linalg.Vector3f>() // +0\n    var color by Structure.FromStructure<afield.math.linalg.Vector4f>() // +16\n}\nfun VertexByteSize(): Long = 32L\nfun VertexLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"position\", 0, PrimitiveType.vec3.left(), 0, false),\n        Introspected.Member(\"color\", 16, PrimitiveType.vec4.left(), 0, false),\n    )\nfun HasBuffer.asVertex(): Vertex =\n    asStructure(Vertex(), VertexLayoutMembers())\nfun BufferParameters.asVertex(): Vertex =\n    buffer.asVertex()\n/*end*/\n/*start*/\n/*graphics-structure-type:VertexArray:VertexArray*/\nclass VertexArray(\n    members: List<Introspected.Member> = VertexArrayLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    val elements: Vertex\n        get() = childStructure(\"elements\") { members, baseOffset, pathPrefix, root ->\n            Vertex(members, baseOffset, pathPrefix, root)\n        }\n}\nfun VertexArrayByteSize(): Long = 32L\nfun VertexArrayLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"elements\", 0, VertexLayoutMembers().right(), 32, false),\n    )\nfun HasBuffer.asVertexArray(): VertexArray =\n    asStructure(VertexArray(), VertexArrayLayoutMembers())\nfun BufferParameters.asVertexArray(): VertexArray =\n    buffer.asVertexArray()\n/*end*/\n/*graphics-pc-structure:vertices*/ var Structure.vertices by Structure.FromStructure<Any>()\n/*graphics-pc-binding:vertices*/ var Mesh.vertices by Mesh.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-binding-group:vertices*/ var MeshGroup.vertices by MeshGroup.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-structure:count*/ var Structure.count by Structure.FromStructure<Any>()\n/*graphics-pc-binding:count*/ var Mesh.count by Mesh.BoundFromStructure<Any>()\n/*graphics-pc-binding-group:count*/ var MeshGroup.count by MeshGroup.BoundFromStructure<Any>()\nvar Box.window by Inheritance<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.window by Onceing<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/"}} {"id" "7a4e1d7d-e91f-4caf-9c64-176b940cb2bf" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [310.18182970866644 -121.63635640499058 100.0 100.0] "code" #afield/file-inline {"path" "7a4e1d7d-e91f-4caf-9c64-176b940cb2bf_code_.kt" "inline" "\n"} "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "af3c81aa-0493-4a1c-8b3a-6b1e9f0aa931" "properties" {"children" #{} "parents" #{