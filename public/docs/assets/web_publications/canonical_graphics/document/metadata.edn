p.foo by MeshGroup.BoundFromStructure<Any>()\nvar Box.window by Inheritance<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.window by Onceing<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "frame" #afield/rect [1868.5234375 3355.5 280.0 100.0] "code" #afield/file-inline {"path" "42056e8d-ec8b-4bf8-b84a-1cd1d8524510_code_.kt" "inline" "/*\n5c. some more templating: a push-constant block generated from a Kotlin class.\nParent: window. PushConstants<T> reflects the class's members into a GLSL push_constant block;\nthe fragment shader (open it with the editor's property switcher) splices that in with\n{{ pc.dec }}, calls loadRegs(), and reads member `a` through the generated accessor a().\n*/\nclass MyPC(\n    var a: Vec4,\n    var b: Vec4,\n    var c: Vec4,\n) : PushConstants<MyPC>()\n\nvar pc = MyPC(vec(1, 0, 0, 1), vec(1, 2, 3, 4), vec(1, 2, 3, 4))\n\n// pc.glsl() emits the generated declaration; the template makes it available as {{ pc.dec }}.\nshaderTemplate[\"pc\"] = mapOf(\"dec\" to Resolver { pc.glsl() })\n\npc.a.x = 0.3f\n// A hand-written extra member, placed at the next free 16-byte-aligned offset after the generated ones.\npc.otherDeclarations = \"layout(offset=${pc.nextFreeOffset(16)}) uint foo;\"\n\n// `//%-` is Field's execution break: the declarations above are in place before moduleHere reads the shader.\n//%-\nvar module = moduleHere {\n    primitiveType = triangle_strip\n}\n\nvar m = Mesh()\n\nmodule += m named \"my mesh\"\nrenderer += module\n\n// Bind the whole Kotlin object to the push constants, and supply the extra member `foo`.\nm.push.bindAll { pc }\nm.foo = { 10u }\n\nm.set(3, 3) {\n    pos.add(0, 0, 0, 0.5, 0, 0, 0.5, 0.5, 0)\n    tri.add(0, 1, 2)\n}\n"} "fragment" #afield/file-inline {"path" "42056e8d-ec8b-4bf8-b84a-1cd1d8524510_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 0) in vec4 fcol;\n\n// Generated from the Kotlin class MyPC: the push_constant block, loadRegs() and accessors a(), b(), c().\n{{ pc.dec }}\nvoid main()\n{\n    loadRegs();\n\n    uFragColor = vec4(a());\n}\n"} "vertex" #afield/file-inline {"path" "42056e8d-ec8b-4bf8-b84a-1cd1d8524510_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\n// No camera here: positions pass straight through to clip space.\n// layout(push_constant) uniform matrices {\n//     mat4 projectionMatrix;\n//     mat4 modelMatrix;\n// } push_constants;\n\nvoid main()\n{\n    // gl_Position = push_constants.projectionMatrix * push_constants.modelMatrix * vec4(pos, 1);\n\n    fcol = col;\n    gl_Position = vec4(pos, 1);\n}"} "metadata" #afield/file-inline {"path" "42056e8d-ec8b-4bf8-b84a-1cd1d8524510_metadata_.yaml" "inline" ""} "autorun" false "nested" #{}}} {"id" "954d64d5-ee3f-4cb7-8ac7-1e2cce8a9073" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "2. hello keyboard camera" "preamble" "import afield.graphics.vulkan.Renderer\nimport java.nio.*\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport afield.graphics.vulkan.util.Window\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var pos : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"pos\") { pos = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } ;            };         }\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/\n/*graphics-input:pos*/ val Mesh.pos by FromInput()\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "frame" #afield/rect [440.5234375 3355.5 280.0 100.0] "code" #afield/file-inline {"path" "954d64d5-ee3f-4cb7-8ac7-1e2cce8a9073_code_.kt" "inline" "/*\n2. hello keyboard camera\n\nOne triangle, built from ordinary vertex attributes, seen through a Camera you can move with the keyboard\nwhile the renderer window has focus. Needs the renderer window box as its parent.\n\nThe `vertex` property holds the vertex shader (open it with the editor's property switcher, `f1` or\n`ctrl-P`): it multiplies each position by the `p` and `m` push constants. The `fragment` shader paints\none flat color.\n*/\n\n// As usual, a shader module and a mesh for it\nvar module = moduleHere()\nvar m = Mesh()\n\n// Connect the mesh to the module, and the module to the renderer\nmodule += m named \"mainMesh\"\nrenderer += module\n\n/*\nA Camera is a convenient way of producing two matrices, `p` and `m`:\n\n`p` is the projection matrix. It maps the 3D space of the world onto the screen following the rules of\nperspective (things further away are proportionally smaller).\n\n`m` is the model-view matrix. It accounts for the rotation and translation of the camera and the model.\n\nThe mesh's `m.p` and `m.m` match the vertex shader's push constants. They are given the camera's matrix\nobjects, which are read again every frame, so moving the camera needs no further code here.\n*/\nval camera = Camera()\n// The quad runs from (0, 0) to (1, 1): aim at its centre, close enough that it fills the window.\ncamera.at = vec(0.5, 0.5, -0.8)\ncamera.target = vec(0.5, 0.5, 0)\nm.p = camera.p\nm.m = camera.m\n\n// The triangle, written with vertex attributes: 3 vertices and 1 triangle\nm.set(3, 1) {\n    val z = 0.0\n    pos.add(0, 0, 0 + z, 1.0, 0.1, z, 1, 1, z)\n    tri.add(0, 1, 2)\n}\n\n// Keyboard control over the camera, read from the renderer window (R resets the camera). Because it is\n// registered under this property's name, re-running the box replaces the controls instead of adding more.\nvar kc by keyCamera(camera = camera)\n"} "fragment" #afield/file-inline {"path" "954d64d5-ee3f-4cb7-8ac7-1e2cce8a9073_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nvoid main()\n{\n    uFragColor = vec4(1.0, 0.8, 0.4, 1.0);\n}"} "vertex" #afield/file-inline {"path" "954d64d5-ee3f-4cb7-8ac7-1e2cce8a9073_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n}"} "metadata" #afield/file-inline {"path" "954d64d5-ee3f-4cb7-8ac7-1e2cce8a9073_metadata_.yaml" "inline" "docOrder: 1"} "autorun" false "nested" #{}}} {"id" "1103f132-7484-4440-8102-5bd159a29fbf" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "