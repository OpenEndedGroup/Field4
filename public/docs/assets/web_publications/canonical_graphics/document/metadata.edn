>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;     this.resize(numVert, numTriangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\n/*graphics-pc-structure:mode*/ var Structure.mode by Structure.FromStructure<Any>()\n/*graphics-pc-binding:mode*/ var Mesh.mode by Mesh.BoundFromStructure<Int>()\n/*graphics-pc-binding-group:mode*/ var MeshGroup.mode by MeshGroup.BoundFromStructure<Int>()\n/*graphics-pc-structure:density*/ var Structure.density by Structure.FromStructure<Any>()\n/*graphics-pc-binding:density*/ var Mesh.density by Mesh.BoundFromStructure<Number>()\n/*graphics-pc-binding-group:density*/ var MeshGroup.density by MeshGroup.BoundFromStructure<Number>()\n/*graphics-pc-structure:eastboundFraction*/ var Structure.eastboundFraction by Structure.FromStructure<Any>()\n/*graphics-pc-binding:eastboundFraction*/ var Mesh.eastboundFraction by Mesh.BoundFromStructure<Number>()\n/*graphics-pc-binding-group:eastboundFraction*/ var MeshGroup.eastboundFraction by MeshGroup.BoundFromStructure<Number>()\n/*graphics-pc-structure:seed*/ var Structure.seed by Structure.FromStructure<Any>()\n/*graphics-pc-binding:seed*/ var Mesh.seed by Mesh.BoundFromStructure<Int>()\n/*graphics-pc-binding-group:seed*/ var MeshGroup.seed by MeshGroup.BoundFromStructure<Int>()" "vertex" #afield/file-inline {"path" "1b0f6eb5-b860-401d-913a-6469b4285774_vertex_.glsl" "inline" "#version 450\n\nvec2 fullscreenVertex(uint index) {\n    if (index == 0u) return vec2(-1.0, -1.0);\n    if (index == 1u) return vec2(3.0, -1.0);\n    return vec2(-1.0, 3.0);\n}\n\nvoid main() {\n    gl_Position = vec4(fullscreenVertex(uint(gl_VertexIndex)), 0.0, 1.0);\n}"} "fragment" #afield/file-inline {"path" "1b0f6eb5-b860-401d-913a-6469b4285774_fragment_.glsl" "inline" "#version 450\n\nlayout(set = 0, binding = 0) uniform sampler2D sourceTex;\n\nlayout(push_constant) uniform Push {\n    int mode;\n    float density;\n    float eastboundFraction;\n    int seed;\n} push;\n\nlayout(location = 0) out vec4 outColor;\n\nconst vec4 EMPTY = vec4(0.0, 0.0, 0.0, 1.0);\nconst vec4 EAST = vec4(1.0, 0.0, 0.0, 1.0);\nconst vec4 SOUTH = vec4(0.0, 0.0, 1.0, 1.0);\n\nuint hash(uint x) {\n    x ^= x >> 16u;\n    x *= 0x7feb352du;\n    x ^= x >> 15u;\n    x *= 0x846ca68bu;\n    x ^= x >> 16u;\n    return x;\n}\n\nfloat random01(uvec2 p, uint salt) {\n    return float(hash(p.x ^ hash(p.y ^ hash(uint(push.seed) ^ salt)))) / 4294967295.0;\n}\n\n// 0 empty, 1 eastbound, 2 southbound\nint cellAt(ivec2 p, ivec2 dims) {\n    vec4 c = texelFetch(sourceTex, (p + dims) % dims, 0);\n    if (c.r > 0.5) return 1;\n    if (c.b > 0.5) return 2;\n    return 0;\n}\n\nvec4 colourOf(int cell) {\n    return cell == 1 ? EAST : (cell == 2 ? SOUTH : EMPTY);\n}\n\nvoid main() {\n    ivec2 dims = textureSize(sourceTex, 0);\n    ivec2 p = ivec2(gl_FragCoord.xy);\n\n    if (push.mode == 3) {\n        uvec2 u = uvec2(p);\n        if (random01(u, 1u) < push.density) {\n            outColor = random01(u, 2u) < push.eastboundFraction ? EAST : SOUTH;\n        }\n        else {\n            outColor = EMPTY;\n        }\n        return;\n    }\n\n    int here = cellAt(p, dims);\n    if (push.mode == 2) {\n        outColor = colourOf(here);\n        return;\n    }\n\n    // even half-steps move eastbound cars +x, odd ones move southbound cars +y\n    int mover = push.mode == 0 ? 1 : 2;\n    ivec2 ahead = push.mode == 0 ? ivec2(1, 0) : ivec2(0, 1);\n\n    int next = here;\n    if (here == mover && cellAt(p + ahead, dims) == 0) {\n        next = 0;\n        // a car moves out of this cell this half-step: one invocation per moving car,\n        // which is where to tap it (fieldProbe, fieldStats) without counting it twice\n    }\n    else if (here == 0 && cellAt(p - ahead, dims) == mover) {\n        next = mover;\n    }\n\n    outColor = colourOf(next);\n}\n"} "nested" #{} "autorun" false}} {"id" "b9512569-8d20-4a16-8c39-53fd96dd3cb2" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [155.00001148744002 -175.54544664414493 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "9ee9d658-29c0-4e4b-a50f-832ebb9d06e7" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [0.0 0.0 110.0 110.0] "preamble" "" "_tombstone" true "code" #afield/file-inline {"path" "9ee9d658-29c0-4e4b-a50f-832ebb9d06e7_code_.kt" "inline" "\n"} "autorun" false "nested" #{}}} {"id" "0a1600f2-7ab7-432d-9958-da9ae01b1378" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [327.00001148744 9.454553355855069 100.0 100.0] "code" #afield/file-inline {"path" "0a1600f2-7ab7-432d-9958-da9ae01b1378_code_.kt" "inline" "\n"} "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "72b68fa7-a8c3-4d4a-964d-2f66306692e3" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "b09e32ea-79a6-40a7-bb7a-99e6723081ad"} "name" "10b. lbm cylinder" "_tombstone" false "frame" #afield/rect [3772.5234375 1870.5 280.0 100.0] "code" #afield/file-inline {"path" "72b68fa7-a8c3-4d4a-964d-2f66306692e3_code_.kt" "inline" "/*\nRun this in a box beneath \"10. lattice boltzmann\", whose `lbm` property it uses.\n\nDraws into the fluid's control texture: a solid disc, walls top and bottom, and\nstripes of dye released at the left edge. The controls persist from frame to\nframe, so clear them first or a re-run leaves the old drawing behind.\n*/\nlbm.clearControls()\n\n// a module that renders into the control texture; the drawing itself is this box's `fragment` shader\nvar module = moduleHere(lbm.controlsParameters(\"cylinder\"))\nlbm.addControls(\"cylinder\", module)\n\nval quad = fullscreenTriangle(module)\nmodule += \"quad\" to quad\n\n// push constants read by the fragment shader, in lattice cells\nquad.center = { vec(160f, 236f) }\nquad.radius = { 24f }\nquad.height = { 480f }\n"} "vertex" #afield/file-inline {"path" "72b68fa7-a8c3-4d4a-964d-2f66306692e3_vertex_.glsl" "inline" "#version 450\n\n// one triangle that covers the whole target; positions come from the vertex index\nvec2 fullscreenVertex(uint index) {\n    if (index == 0u) return vec2(-1.0, -1.0);\n    if (index == 1u) return vec2(3.0, -1.0);\n    return vec2(-1.0, 3.0);\n}\n\nvoid main() {\n    gl_Position = vec4(fullscreenVertex(uint(gl_VertexIndex)), 0.0, 1.0);\n}\n"} "fragment" #afield/file-inline {"path" "72b68fa7-a8c3-4d4a-964d-2f66306692e3_fragment_.glsl" "inline" "#version 450\n\nlayout(push_constant) uniform Push {\n    vec2 center;\n    float radius;\n    float height;\n} push;\n\nlayout(location = 0) out vec4 outColor;\n\n// red: solid; green and blue: a push; alpha: a dye source.\n// The blend is additive and the controls carry over, so this is a drawing, not a frame.\nvoid main() {\n    vec2 p = gl_FragCoord.xy;\n    outColor = vec4(0.0);\n\n    if (distance(p, push.center) < push.radius) outColor.r = 1.0;\n    if (p.y < 3.0 || p.y > push.height - 3.0) outColor.r = 1.0;\n\n    if (p.x < 4.0 && mod(floor(p.y / 12.0), 2.0) == 0.0) outColor.a = 1.0;\n}\n"} "preamble" "import afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\nimport java.nio.*\nimport arrow.core.right\nimport arrow.core.left\nimport afield.graphics.shader.*\nimport afield.graphics.scene.*\nimport afield.graphics.render.*\nimport afield.document.context.*\nimport afield.graphics.vulkan.buffers.*\nimport afield.simulation.agents.ShaderLatticeBoltzmannSystem\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStruct