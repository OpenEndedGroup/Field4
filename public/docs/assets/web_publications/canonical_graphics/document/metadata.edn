layout(set=0, binding = 0) uniform sampler2D bbc;\n\nvoid main()\n{\n    // ftc.yx swaps the texture coordinates, which transposes the image on the quad.\n    vec4 c = texture(bbc, ftc.yx);\n    uFragColor = vec4(c.rgb, 1.0);\n}\n"} "vertex" #afield/file-inline {"path" "459b9c54-6363-4c27-a033-2f145e017022_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\nlayout (location = 1) in vec2 tc;\n\nlayout (location = 1) out vec2 ftc;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n    ftc = tc;\n}"} "metadata" #afield/file-inline {"path" "459b9c54-6363-4c27-a033-2f145e017022_metadata_.yaml" "inline" ""} "autorun" false "nested" #{}}} {"id" "af0946dd-f25d-4355-984d-f0d24a43ee12" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "1. hello triangle" "preamble" "import afield.graphics.vulkan.Renderer\nimport java.nio.*\nimport arrow.core.right\nimport arrow.core.left\nimport afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport afield.graphics.vulkan.util.Window\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;     this.resize(numVert, numTriangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/\n/*start*/\n/*graphics-structure-type:vertexData:VertexDataBlock*/\n// GLSL block `vertexData` is VertexDataBlock here: VertexData would hide afield.graphics.render.VertexData.\nclass VertexDataBlock(\n    members: List<Introspected.Member> = VertexDataBlockLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var positions by Structure.FromStructure<afield.math.linalg.Vector4f>()\n}\nfun VertexDataBlockByteSize(): Long = 16L\nfun VertexDataBlockLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"positions\", 0, PrimitiveType.vec4.left(), 16, false),\n    )\nfun HasBuffer.asVertexDataBlock(): VertexDataBlock =\n    asStructure(VertexDataBlock(), VertexDataBlockLayoutMembers())\nfun BufferParameters.asVertexDataBlock(): VertexDataBlock =\n    buffer.asVertexDataBlock()\n/*end*/\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>()\n/*graphics-pc-structure:vertexData*/ var Structure.vertexData by Structure.FromStructure<Any>()\n/*graphics-pc-binding:vertexData*/ var Mesh.vertexData by Mesh.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-binding-group:vertexData*/ var MeshGroup.vertexData by MeshGroup.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "frame" #afield/rect [440.5234375 1870.5 280.0 100.0] "code" #afield/file-inline {"path" "af0946dd-f25d-4355-984d-f0d24a43ee12_code_.kt" "inline" "/*\n1. hello triangle\n\nTriangles whose vertex positions are written from Kotlin into a GPU buffer every frame. The vertex shader\nreads that buffer through a buffer reference, so the mesh carries no vertex attributes at all.\nNeeds the renderer window box as its parent.\n\nThe `vertex` and `fragment` properties hold the shaders; open them with the editor's property switcher\n(`f1` or `ctrl-P`).\n*/\n\n// A shader module belonging to this box, drawing filled triangles\nvar module = moduleHere { primitiveType = triangles }\n\n// ... and a mesh, which runs the shader with some data\nvar m = Mesh()\n\n// Connect the mesh to the module under the name \"someMesh\"\nmodule += m named \"someMesh\"\n\n// ... and connect the module to the renderer (under the name of this box)\nrenderer += module\n\n// Now a buffer to hold the vertex positions\nvar vertexData = defaultBuffer {\n    perFrame = true\n    size = 3.vec4s\n}\n    .buffer\n\n/*\n`size = 3.vec4s` is only a starting size: the buffer grows when a write needs more room, as the loop below\ndoes (it writes up to 150 vec4s).\n\n`perFrame = true` gives one buffer per frame in flight, so the CPU can write the next frame's data while\nthe GPU is still reading the current frame's, without waiting.\n*/\n\n// Connect the buffer to the mesh. `m.vertexData` exists because Field has read the vertex shader and found\n// its `vertexData` buffer reference; it has the matching type.\nm.vertexData = { vertexData }\n\n// Nothing has been written to the buffer yet. That is fine, because the mesh has no vertices until\n// `m.resize` is called below.\n\n// Triangles that move in circles\nvar t = 0.0\nfun polar(t: Double, r: Double) = vec(Math.sin(t), Math.cos(t)) * r.f\n\nloop {\n    t += 0.01\n    var num = 0\n\n    var numVertToWrite = (Math.sin(t * 0.1) * 20 + 30).i // the triangle count changes over time\n\n    vertexData.write {\n        for (x in 0 until numVertToWrite) {\n            val offset = vec(x * 0.02, 0, 0)\n            put(vec(polar(t, 0.5), 0) + offset)\n            put(vec(polar(t + 0.4, 0.4), 0) + offset)\n            put(vec(polar(t + 0.9, 0.3), 0) + offset)\n\n            num += 3\n        }\n    }\n\n    // Tell the mesh how many vertices to draw. Every 3 make a triangle; what each vertex means is up to the\n    // vertex shader.\n    m.resize(num)\n\n    // returning true keeps the loop running\n    true\n}\n\n// `loop` is the last thing in this script, so its body runs once per animation frame while the box is\n// launched (`alt-mouse-swipe` or `alt-up`).\n"} "fragment" #afield/file-inline {"path" "af0946dd-f25d-4355-984d-f0d24a43ee12_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\n\n// location 0 here needs to match location 0 in the vertex shader\nlayout(location = 0) in vec4 localColor;\nvoid main()\n{\n    uFragColor = vec4(localColor.rgb*1, 0.3);\n}"} "vertex" #afield/file-inline {"path" "af0946dd-f25d-4355-984d-f0d24a43ee12_vertex_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\n\n// A buffer reference: a GPU address the box fills in from Kotlin with `m.vertexData = { ... }`\nlayout(std430, buffer_reference) buffer vertexData\n{\n    vec4 positions[];\n};\n\n// Push constants supplied by the mesh; this shader uses only the buffer address, not the matrices\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n    vertexData vertexData;\n} pc;\n\nlayout(location=0) out vec4 localColor;\n\nfloat wrap(int a, int b) {\n    // Divide as floats so the ramp includes intermediate channel values.\n    return float(a % b) / float(b - 1);\n}\n\nvoid main()\n{\n    // look up this vertex's position in the buffer; positions are already in clip space\n    gl_Position = vec4(pc.vertexData.positions[gl_VertexIndex].xyz, 1);\n\n    // compute a different color for every vertex\n    localColor = vec4(wrap(gl_VertexIndex,3),wrap(gl_VertexIndex,5),wrap(gl_VertexIndex,11),1.0);\n}\n"} "metadata" #afield/file-inline {"path" "af0946dd-f25d-4355-984d-f0d24a43ee12_metadata_.yaml" "inline" "docOrder: 0"} "autorun" false "nested" #{}}} {"id" "0e01f4b0-4b65-40db-a8b0-cd6cde4048d6" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "4. gltf loading" "preamble" "import afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nimport afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;     this.resize(numVert, numTriangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\n/*start*/\n/*graphics-structure-type:VertexBuffer:VertexBufferBlock*/\n// GLSL block `VertexBuffer` is VertexBufferBlock here: VertexBuffer would hide afield.graphics.vulkan.buffers.VertexBuffer.\nclass VertexBufferBlock(\n    members: List<Introspected.Member> = VertexBufferBlockLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var vertexData by Structure.FromStructure<Float>()\n}\nfun VertexBufferBlockByteSize(): Long = 4L\nfun VertexBufferBlockLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"vertexData\", 0, PrimitiveType.float.left(), 4, false),\n    )\nfun HasBuffer.asVertexBufferBlock(): VertexBufferBlock =\n    asStructure(VertexBufferBlock(), VertexBufferBlockLayoutMembers())\nfun BufferParameters.asVertexBufferBlock(): VertexBufferBlock =\n    buffer.asVertexBufferBlock()\n/*end*/\n/*start*/\n/*graphics-structure-type:IndexBuffer:IndexBuffer*/\nclass IndexBuffer(\n    members: List<Introspected.Member> = IndexBufferLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var indexData by Structure.FromStructure<UInt>()\n}\nfun IndexBufferByteSize(): Long = 4L\nfun IndexBufferLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"indexData\", 0, PrimitiveType.uint.left(), 4, false),\n    )\nfun HasBuffer.asIndexBuffer(): IndexBuffer =\n    asStructure(IndexBuffer(), IndexBufferLayoutMembers())\nfun BufferParameters.asIndexBuffer(): IndexBuffer =\n    buffer.asIndexBuffer()\n/*end*/\n/*graphics-pc-structure:modelView*/ var Structure.modelView by Structure.FromStructure<Any>() // view * model\n/*graphics-pc-binding:modelView*/ var Mesh.modelView by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>() // view * model\n/*graphics-pc-binding-group:modelView*/ var MeshGroup.modelView by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>() // view * model\n/*graphics-pc-structure:proj*/ var Structure.proj by Structure.FromStructure<Any>() // projection\n/*graphics-pc-binding:proj*/ var Mesh.proj by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>() // projection\n/*graphics-pc-binding-group:proj*/ var MeshGroup.proj by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>() // projection\n/*graphics-pc-structure:materialBaseColor*/ var Structure.materialBaseColor by Structure.FromStructure<Any>()\n/*graphics-pc-binding:materialBaseColor*/ var Mesh.materialBaseColor by Mesh.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-binding-group:materialBaseColor*/ var MeshGroup.materialBaseColor by MeshGroup.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-structure:vertexOffset*/ var Structure.vertexOffset by Structure.FromStructure<Any>() // in floats\n/*graphics-pc-binding:vertexOffset*/ var Mesh.vertexOffset by Mesh.BoundFromStructure<Any>() // in floats\n/*graphics-pc-binding-group:vertexOffset*/ var MeshGroup.vertexOffset by MeshGroup.BoundFromStructure<Any>() // in floats\n/*graphics-pc-structure:indexOffset*/ var Structure.indexOffset by Structure.FromStructure<Any>() // in indices\n/*graphics-pc-binding:indexOffset*/ var Mesh.indexOffset by Mesh.BoundFromStructure<Any>() // in indices\n/*graphics-pc-binding-group:indexOffset*/ var MeshGroup.indexOffset by MeshGroup.BoundFromStructure<Any>() // in indices\n/*graphics-pc-structure:vertexStride*/ var Structure.vertexStride by Structure.FromStructure<Any>() // in floats\n/*graphics-pc-binding:vertexStride*/ var Mesh.vertexStride by Mesh.BoundFromStructure<Any>() // in floats\n/*graphics-pc-binding-group:vertexStride*/ var MeshGroup.vertexStride by MeshGroup.BoundFromStructure<Any>() // in floats\n/*graphics-pc-structure:useVertexColor*/ var Structure.useVertexColor by Structure.FromStructure<Any>() // bool as uint\n/*graphics-pc-binding:useVertexColor*/ var Mesh.useVertexColor by Mesh.BoundFromStructure<Any>() // bool as uint\n/*graphics-pc-binding-group:useVertexColor*/ var MeshGroup.useVertexColor by MeshGroup.BoundFromStructure<Any>() // bool as uint\n/*graphics-pc-structure:vertexBuffer*/ var Structure.vertexBuffer by Structure.FromStructure<Any>()\n/*graphics-pc-binding:vertexBuffer*/ var Mesh.vertexBuffer by Mesh.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-binding-group:vertexBuffer*/ var MeshGroup.vertexBuffer by MeshGroup.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-structure:indexBuffer*/ var Structure.indexBuffer by Structure.FromStructure<Any>()\n/*graphics-pc-binding:indexBuffer*/ var Mesh.indexBuffer by Mesh.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-binding-group:indexBuffer*/ var MeshGroup.indexBuffer by MeshGroup.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\nvar Box.window by Inheritance<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.window by Onceing<Window>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.window by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/\nval Why.renderer by Whying() /*from:611072da-1af6-4d2d-85bf-07a9ba191aca*/ /**/" "frame" #afield/rect [916.5234374999998 2860.5 280.0 100.0] "code" #afield/file-inline {"path" "0e01f4b0-4b65-40db-a8b0-cd6cde4048d6_code_.kt" "inline" "/*\nLoading a glTF model.\n\ngltfModelHere reads a glTF file and returns a module whose shaders already match the file's vertex\nlayout, together with the meshes it found. Run this box beneath the renderer (`window`) box.\nThe vertex shader it writes (open \"vertex\" in the editor's property switcher) unpacks position,\nnormal, uv and colour from a flat float buffer by stride; the fragment shader shades by the\nview-space normal.\n\nThe file is the Khronos toy car in the docs assets, read relative to the directory Field runs from.\n*/\nvar (module, meshes) = gltfModelHere(\"public/docs/assets/fabricate_demo/ToyCar.glb\")\n\nvar m = Mesh()\nmodule += \"car\" to m\nrenderer += \"boo\" to module\n\n// orthoness blends between perspective (0) and orthographic (1) projection.\nval camera = Camera()\ncamera.p.orthoness = 0.3\ncamera.p.matchDepth = 2.0\ncamera.target = vec(0, 0.4, 0)\ncamera.at = vec(-2.2, 1.8, 2.9)\n\n// Keyboard controls for the camera; R resets it.\nKeyCamera(camera = camera)\n\n// The file stands the car up and scales it to centimetres (a 0.0001 node scale); this model matrix\n// keeps the rotation and makes it about four units long. meshes[model].meshes[primitive]: copy\n// primitive 0 of model 0 into our mesh.\nval model = Matrix4f().rotateX(Math.PI.toFloat() / 2).scale(0.01f)\nmeshes[0].meshes[0].applyToMesh(m, camera, model)\ncamera.p()\n\nloop {\n    frame()\n}\n"} "fragment" #afield/file-inline {"path" "0e01f4b0-4b65-40db-a8b0-cd6cde4048d6_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 3) in vec4 vColor;\nlayout(location = 1) in vec3 vNormalVS;\n\nvoid main()\n{\n    float d = abs(dot(vNormalVS.xyz, normalize(vec3(1, 0.4, -0.2))));\n    uFragColor = vec4(vNormalVS.rgb*d,1);\n}"} "vertex" #afield/file-inline {"path" "0e01f4b0-4b65-40db-a8b0-cd6cde4048d6_vertex_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\n#extension GL_EXT_scalar_block_layout : require\n\nlayout(std430, buffer_reference) readonly buffer VertexBuffer {\n    float vertexData[];\n};\n\nlayout(std430, buffer_reference) readonly buffer IndexBuffer {\n    uint indexData[];\n};\n\nlayout(push_constant) uniform PushConstants {\n    mat4 modelView;        // view * model\n    mat4 proj;             // projection\n\n    vec4 materialBaseColor;\n\n    uint vertexOffset;     // in floats\n    uint indexOffset;      // in indices\n    uint vertexStride;     // in floats\n    uint useVertexColor;   // bool as uint\n\n    VertexBuffer vertexBuffer;\n    IndexBuffer indexBuffer;\n} pc;\n\nlayout(location = 0) out vec3 vViewPos;\nlayout(location = 1) out vec3 vNormalVS;\nlayout(location = 2) out vec2 vUV;\nlayout(location = 3) out vec4 vColor;\n\nvoid main()\n{\n    // Fetch the index ourselves, then unpack this vertex from the flat float buffer: position at +0,\n    // normal at +3, uv at +6, colour at +8. The offsets select this primitive's slice of shared buffers.\n    uint idx = pc.indexBuffer.indexData[pc.indexOffset+uint(gl_VertexIndex)];\n    uint base = pc.vertexOffset + idx * pc.vertexStride;\n\n    vec3 pos = vec3(\n        pc.vertexBuffer.vertexData[base + 0],\n        pc.vertexBuffer.vertexData[base + 1],\n        pc.vertexBuffer.vertexData[base + 2]\n    );\n\n    vec3 normal = vec3(\n        pc.vertexBuffer.vertexData[base + 3],\n        pc.vertexBuffer.vertexData[base + 4],\n        pc.vertexBuffer.vertexData[base + 5]\n    );\n\n    vec2 uv = vec2(\n        pc.vertexBuffer.vertexData[base + 6],\n        pc.vertexBuffer.vertexData[base + 7]\n    );\n\n    vec4 color = vec4(\n        pc.vertexBuffer.vertexData[base + 8],\n        pc.vertexBuffer.vertexData[base + 9],\n        pc.vertexBuffer.vertexData[base + 10],\n        pc.vertexBuffer.vertexData[base + 11]\n    );\n\n    if (pc.useVertexColor == 0u) {\n        color = vec4(1.0);\n    }\n\n    vec4 viewPos =  pc.proj * pc.modelView*vec4(pos, 1.0);\n\n    mat3 mv3 = mat3(pc.modelView);\n    vec3 normalVS = normalize(mv3 * normal);\n\n    vViewPos = viewPos.xyz;\n    vNormalVS = normalVS;\n    vUV = uv;\n    vColor = color * pc.materialBaseColor;\n\n    gl_Position = viewPos;\n}"} "autorun" false "nested" #{}}} {"id" "c1046457-6538-4bb2-84ab-b3ba06f0d557" "properties" {"children" #{} "parents" #{} "name" "Downsweep" "preamble" "" "autorun" false "frame" #afield/rect [94.36328125 873.1423950195312 98.0 61.59375] "code" #afield/file-inline {"path" "c1046457-6538-4bb2-84ab-b3ba06f0d557_code_.kt" "inline" "import org.joml.primitives.Rectanglef\n\nval maxElementCount = splatNum * 2\n\nval RADIX = 256\nval WORKGROUP_SIZE = 512\nval PARTITION_DIVISION = 8\nval PARTITION_SIZE = PARTITION_DIVISION * WORKGROUP_SIZE\n\nfun roundUp(n: Int, to: Int) = ((n + to - 1) / to) * to\nval histogramSize = (1 + 4 * RADIX + roundUp(maxElementCount, PARTITION_SIZE) * RADIX)\nval inoutSize = maxElementCount\n\nval partitionCount = roundUp(splatNum, PARTITION_SIZE)\n\nvar tempStorage = buffer {\n    size = (histogramSize + inoutSize * 2).ints\n    addressable()\n    hosted()\n    dest()\n}\n    .buffer\n\nvar downsweep = computeModuleHere(\n    parameters {},\n)\n\nvar mUpsweep = ComputeMesh()\nvar mSpine = ComputeMesh()\nvar mDownsweep = ComputeMesh()\nupsweep += \"m\" to mUpsweep\nspine += \"m\" to mSpine\ndownsweep += \"m\" to mDownsweep\n\nrenderer.computeList.others += \"radixSort\" to target { cmd, index -> }\n\nrenderer.computeList.others +=\n    \"radixSort\" to\n        target { cmd, index ->\n            for (pass in 0 until 4) { // 4!\n                // _print(\"render ${pass}\")\n                val three = listOf(mUpsweep, mSpine, mDownsweep)\n\n                val p = pass\n                three.forEach { it.pass = { p } }\n                three.forEach { it.elementCountReference = { indirect + 4L } }\n                three.forEach { it.globalHistogramReference = { tempStorage + 4L } }\n                three.forEach { it.partitionHistogramReference = { tempStorage + 4L + 4L * 4 * RADIX } }\n\n                run {\n                    var a = { splatDistances + 0L }\n                    var b = {\n                        tempStorage + 4L + 4L * 4 * RADIX + roundUp(maxElementCount, PARTITION_SIZE) * RADIX * 4L\n                    }\n                    if (pass % 2 == 1) {\n                        val c = a\n                        a = b\n                        b = c\n                    }\n                    three.forEach { it.keysInReference = a }\n                    three.forEach { it.keysOutReference = b }\n                }\n                run {\n                    var a = { splatIndices + 0L }\n                    var b = {\n                        tempStorage +\n                            4L +\n                            4L * 4 * RADIX +\n                            roundUp(maxElementCount, PARTITION_SIZE) * RADIX * 4L +\n                            maxElementCount * 4L\n                    }\n                    if (pass % 2 == 1) {\n                        val c = a\n                        a = b\n                        b = c\n                    }\n                    three.forEach { it.valuesInReference = a }\n                    three.forEach { it.valuesOutReference = b }\n                }\n\n                computeMemoryBarri