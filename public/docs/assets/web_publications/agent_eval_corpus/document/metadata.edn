{"version" 2 "boxes" [{"id" "corpus_summary" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "What was mined" "_tombstone" false "frame" #afield/rect [60.0 40.0 340.0 100.0] "code" #afield/file-inline {"path" "corpus_summary_code_.kt" "inline" "/* The checked-in corpus: tasks by kind and split, and the reasons boxes were not mined. */\nval corpus = AgentEvalCorpus.load()\nprintln(\"${corpus.tasks.size} tasks from ${corpus.transcripts} transcripts (${corpus.codeBoxes} code boxes)\")\nval rows =\n    corpus.tasks\n        .groupingBy { it.kind + \" / \" + it.split }\n        .eachCount()\n        .toSortedMap()\n        .entries\n        .joinToString(\"\") { \"<tr><td>${it.key}</td><td>${it.value}</td></tr>\" }\nval dropped =\n    corpus.rejectionCounts().entries.take(12).joinToString(\"\") { \"<tr><td>${it.key}</td><td>${it.value}</td></tr>\" }\ndisplay(\n    \"main\",\n    \"<table><tr><th>kind / split</th><th>tasks</th></tr>$rows</table>\" +\n        \"<table><tr><th>dropped because</th><th>boxes</th></tr>$dropped</table>\",\n)\n"} "preamble" "" "nested" #{}}} {"id" "corpus_one_task" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "One task" "_tombstone" false "frame" #afield/rect [60.0 240.0 340.0 100.0] "code" #afield/file-inline {"path" "corpus_one_task_code_.kt" "inline" "/* One held-out task, drawn by seed: the goal and the checks the agent is judged by. */\nval task = AgentEvalCorpus.select(AgentEvalCorpus.load(), \"heldout\", 1, seed = 3).first()\nprintln(task.id + \" (\" + task.kind + \")\")\nprintln(task.request.goal)\ntask.request.checks.forEach { println(\"  check \" + it.kind + \" \" + it.box + \" \" + it.text) }\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "corpus_summary" #afield/box "corpus_one_task"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}