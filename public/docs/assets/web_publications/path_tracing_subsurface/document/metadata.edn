{"version" 2 "boxes" [{"id" "pt_sss_renderer" "properties" {"children" #{#afield/box "pt_sss_row"} "parents" #{#afield/box "root"} "name" "path tracing renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 320.0 110.0] "code" #afield/file-inline {"path" "pt_sss_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nonce.renderer {\n    window = Window(\"Field · subsurface scattering\", initialDimensions = Rect(80.0, 80.0, 1280.0, 400.0))\n    Renderer(window)\n}\nstart(renderer::run)\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "pt_sss_controls" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "pt_sss_row"} "name" "subsurface controls" "_tombstone" false "frame" #afield/rect [320.0 340.0 380.0 130.0] "code" #afield/file-inline {"path" "pt_sss_controls_code_.kt" "inline" "import afield.graphics.scene.fabricated.*\n\nvar scale = 1.0\nvar choice = AlbedoRemap.REFERENCE\n// Rewrite the four remapped spheres in place; the scene and its BVH stay as they are.\nfun apply() {\n    val r = Vector3f(radius).mul(scale.toFloat())\n    AlbedoRemap.entries.forEachIndexed { i, remap ->\n        val use = if (i == AlbedoRemap.entries.lastIndex) choice else remap\n        tracer.setMaterial(remapped[i], PathTraceMaterial.subsurface(skin, r, use))\n    }\n    println(\"radius x $scale, right-hand sphere through $choice\")\n}\ncontrolGroup(\"subsurface\") {\n    slider(\"radius\", min = 0.1, max = 4.0, step = 0.05, initialValue = 1.0, law = ControlLaw.LOGARITHMIC) {\n        scale = it\n        apply()\n    }\n    slider(\"remap\", min = 0.0, max = 3.0, step = 1.0, initialValue = 3.0) {\n        choice = AlbedoRemap.entries[it.toInt()]\n        apply()\n    }\n}\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "pt_sss_row" "properties" {"children" #{#afield/box "pt_sss_controls"} "parents" #{#afield/box "root" #afield/box "pt_sss_renderer"} "name" "subsurface remaps" "_tombstone" false "frame" #afield/rect [320.0 180.0 380.0 130.0] "code" #afield/file-inline {"path" "pt_sss_row_code_.kt" "inline" "import afield.graphics.scene.fabricated.*\nimport afield.graphics.vulkan.util.Camera\n\nprop<PathTracingRenderer>(tracer)\nprop<Vector3f>(skin)\nprop<Vector3f>(radius)\nprop<List<Int>>(remapped)\n\n// Linear-light skin colour: what the surface should look like after all the scattering.\nskin = Vector3f(0.75f, 0.45f, 0.33f)\n// How far each channel travels under the surface, in world units; red goes furthest.\nradius = Vector3f(0.36f, 0.14f, 0.08f)\n\nval scene = PathTraceScene()\nval floor = scene.material(PathTraceMaterial.diffuse(0.18f, 0.18f, 0.18f))\nscene.quad(Vector3f(-20f, 0f, -20f), Vector3f(-20f, 0f, 20f), Vector3f(20f, 0f, 20f), Vector3f(20f, 0f, -20f), floor)\nval target = scene.material(PathTraceMaterial(skin.x, skin.y, skin.z, roughness = 0.3f))\nscene.sphere(Vector3f(-4.4f, 0.95f, 0f), 0.95f, target, 64, 32)\nremapped =\n    AlbedoRemap.entries.mapIndexed { i, remap ->\n        val m = scene.material(PathTraceMaterial.subsurface(skin, radius, remap))\n        scene.sphere(Vector3f(-2.2f + 2.2f * i, 0.95f, 0f), 0.95f, m, 64, 32)\n        m\n    }\nval camera = Camera(renderer).also {\n    it.at.set(0f, 2.4f, 10.5f)\n    it.target.set(0f, 0.9f, 0f)\n    it.p.fov = 0.6\n}\ntracer = PathTracingRenderer(\n    renderer,\n    scene,\n    PathTraceEnvironment.fromFile(\"public/docs/assets/fabricate_demo/venice_sunset_1k.exr\"),\n    width = 1280,\n    height = 400,\n    camera = camera,\n    name = \"subsurface-remaps\",\n).install()\ntracer.maxBounces = 10\ntracer.samplesPerFrame = 2\ntracer.exposure = 1.4f\n// Long red walks occasionally return with a large weight; clamp them as specks, not energy.\ntracer.indirectClamp = 1f\ntracer.blitToScreen()\nprintln(\"left to right: diffuse target, ${AlbedoRemap.entries.joinToString()}\")\nframes {\n    while (tracer.samples < 1024) frame()\n    println(\"subsurface study converged: ${tracer.samples} samples\")\n}\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "pt_sss_renderer" #afield/box "pt_sss_row" #afield/box "pt_sss_controls"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isPostScriptRoot" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}