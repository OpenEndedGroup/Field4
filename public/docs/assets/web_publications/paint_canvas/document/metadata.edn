{"version" 2 "boxes" [{"id" "paint_flow_field" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Paint — strokes along a flow field" "_tombstone" false "frame" #afield/rect [80.0 1000.0 340.0 100.0] "code" #afield/file-inline {"path" "paint_flow_field_code_.kt" "inline" "import kotlin.random.Random\n\nrun {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n\n    // Change these, then rerun: the fixed seed makes comparisons repeatable.\n    val strokeCount = 260\n    val stepsPerStroke = 30\n    val stepLength = 6.0\n    val horizontalFrequency = 0.006\n    val verticalFrequency = 0.008\n    val diagonalFrequency = 0.002\n\n    val canvas = PaintCanvas(900, aspect = 1.4, seed = 4)\n    val brush = canvas.brush(BrushKind.Filbert, width = 16.0)\n    val rnd = Random(4)\n\n    // the direction of the field at (x, y)\n    fun angle(x: Double, y: Double) =\n        sin(x * horizontalFrequency) * 2.0 + cos(y * verticalFrequency + x * diagonalFrequency) * 1.5\n\n    repeat(strokeCount) {\n        var x = rnd.nextDouble(0.0, 1000.0)\n        var y = rnd.nextDouble(0.0, canvas.heightUnits)\n        val line = FLine().moveTo(x, y)\n        repeat(stepsPerStroke) {\n            val a = angle(x, y)\n            x += cos(a) * stepLength\n            y += sin(a) * stepLength\n            line.lineTo(x, y)\n        }\n        val t = y / canvas.heightUnits\n        // wipe = 0.4 keeps some of the last colour in the brush, so neighbouring strokes blend\n        brush.load(rgb(0.9 - 0.6 * t, 0.4 + 0.3 * sin(x * 0.01), 0.2 + 0.6 * t), stiff = 0.9, wipe = 0.4)\n        canvas.stroke(line, brush, pressure = 0.5..0.9)\n    }\n    display(\"main\", canvas.png(relief = 0.8))\n}\n"} "preamble" "" "nested" #{}}} {"id" "paint_pencil_drawing" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Paint — pencil, hatching and chalk" "_tombstone" false "frame" #afield/rect [80.0 1900.0 340.0 100.0] "code" #afield/file-inline {"path" "paint_pencil_drawing_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n\n    // a 20 cm sheet, so a 0.3 mm pencil point reads at this pixel width\n    val canvas = PaintCanvas(900, aspect = 1.5, sizeMm = 200.0)\n\n    val vase =\n        FLine()\n            .moveTo(420, 120)\n            .cubicTo(330, 220, 300, 420, 380, 560)\n            .lineTo(620, 560)\n            .cubicTo(700, 420, 670, 220, 580, 120)\n    canvas.sketch(vase, canvas.pencil(\"2B\"), pressure = 0.5, passes = 3)\n\n    // hatch the shadow side with a softer pencil\n    val shadow =\n        FLine()\n            .moveTo(560, 140)\n            .cubicTo(650, 240, 680, 420, 610, 550)\n            .lineTo(540, 550)\n            .cubicTo(600, 420, 590, 240, 520, 140)\n            .lineTo(560, 140)\n    canvas.hatch(shadow, canvas.pencil(\"4B\"), angle = 1.0, spacing = 7.0, length = 50.0)\n\n    // the table edge, ruled in chalk\n    canvas.draw(FLine().moveTo(80, 560).lineTo(920, 560), canvas.chalk(), pressure = 0.7, ruler = true)\n\n    display(\"main\", canvas.png(relief = 0.0))\n}\n"} "preamble" "" "nested" #{}}} {"id" "paint_first_strokes" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Paint — a canvas, a brush, three strokes" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 100.0] "code" #afield/file-inline {"path" "paint_first_strokes_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n\n    val canvas = PaintCanvas(900, aspect = 1.6)\n    val brush = canvas.brush(BrushKind.Filbert, width = 45.0)\n\n    brush.load(rgb(0.15, 0.3, 0.65))\n    canvas.stroke(FLine().moveTo(80, 140).cubicTo(330, 40, 630, 240, 920, 120), brush)\n\n    brush.load(rgb(0.95, 0.7, 0.15))\n    canvas.stroke(FLine().moveTo(80, 330).cubicTo(330, 230, 630, 430, 920, 310), brush)\n\n    // no reload: three more passes, and the brush runs out along the way\n    val zigzag = FLine().moveTo(80, 470)\n    for (i in 1..3) zigzag.lineTo(if (i % 2 == 1) 920 else 80, 470 + i * 40)\n    canvas.stroke(zigzag, brush)\n\n    display(\"main\", canvas.png())\n}\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "paint_first_strokes" #afield/box "paint_flow_field" #afield/box "paint_pencil_drawing"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}