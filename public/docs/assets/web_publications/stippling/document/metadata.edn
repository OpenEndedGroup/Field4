{"version" 2 "boxes" [{"id" "stipple_hello" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "stipple — a sphere in 6000 dots" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 100.0] "code" #afield/file-inline {"path" "stipple_hello_code_.kt" "inline" "// A shaded sphere on a white floor, as an Img: lit from up and to the left (y grows down).\nval sphere =\n    Img.generate(480, 360) { x, y ->\n        val dx = (x - 220) / 140.0\n        val dy = (y - 170) / 140.0\n        val r2 = dx * dx + dy * dy\n        val tone =\n            if (r2 < 1.0) 0.1 + 0.9 * max(0.0, -0.45 * dx - 0.55 * dy + 0.7 * sqrt(1.0 - r2))\n            else 1.0 - 0.6 * exp(-2.0 * ((x - 280) / 150.0).pow(2) - 2.0 * ((y - 318) / 30.0).pow(2))\n        tone.toFloat()\n    }\n\n// 6000 dots wherever it is dark (`invert`, as ink on paper), evenly spaced rather than clumped.\nval dots = sphere.stipple(6000, invert = true)\nshowImg(stipplesToImg(dots, sphere.width, sphere.height))\n\n// The same dots as geometry, for a plotter or an SVG: lines(stipplesToFLine(dots, size = 0.4))\n\n// Try this: 2000 or 20000 dots; `densityPower = 2f` for harder contrast (point density goes\n// as tone^densityPower); drop `invert` to stipple the light instead of the shadow.\n"} "preamble" "" "nested" #{}}} {"id" "stipple_relaxing" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Stippler — watching Lloyd relaxation settle" "_tombstone" false "frame" #afield/rect [80.0 640.0 370.0 100.0] "code" #afield/file-inline {"path" "stipple_relaxing_code_.kt" "inline" "// Launch it (Alt-R). The same sphere as `stipple_hello`.\nval sphere =\n    Img.generate(480, 360) { x, y ->\n        val dx = (x - 220) / 140.0\n        val dy = (y - 170) / 140.0\n        val r2 = dx * dx + dy * dy\n        val tone =\n            if (r2 < 1.0) 0.1 + 0.9 * max(0.0, -0.45 * dx - 0.55 * dy + 0.7 * sqrt(1.0 - r2))\n            else 1.0 - 0.6 * exp(-2.0 * ((x - 280) / 150.0).pow(2) - 2.0 * ((y - 318) / 30.0).pow(2))\n        tone.toFloat()\n    }\n\n/*\nWhere the stippler starts: one dot per equal share of the darkness along a Hilbert curve,\nso every region already has the right number of dots. Their spacing is rough, and evening\nit out is what relaxation is for.\n*/\nval s = Stippler(sphere, 6000, invert = true)\nshowImg(stipplesToImg(s.points(), 480, 360), channel = \"start\")\n\n// One Lloyd step per frame, until no dot moves.\nval moved = mutableListOf<Double>()\nloop {\n    if (moved.lastOrNull() == 0.0) return@loop\n    moved += s.step()\n    showImg(stipplesToImg(s.points(), 480, 360), channel = \"relaxed\")\n    showSignals(\"mean movement (px)\" to moved, title = \"Lloyd step ${s.iterations}\", xTitle = \"step\")\n}\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "stipple_hello" #afield/box "stipple_relaxing"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFi