{"version" 2 "boxes" [{"id" "agent_popup_prior_inspect" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "What prior does the popup have" "_tombstone" false "frame" #afield/rect [80.0 80.0 400.0 100.0] "code" #afield/file-inline {"path" "agent_popup_prior_inspect_code_.kt" "inline" "/*\nAsk Field what prior the completion popup has, instead of trusting a number typed into a\npage. `CommonMemberPrior` is the object the completion server itself calls, once per\ncandidate, on every keystroke — so this table is the popup's own arithmetic rather than a\ndescription of it. Change `receiver` to any qualified type name to ask about your own class.\n\nWhat this cannot tell you is which SECTION each of these lands in, which is the other half\nof where a row appears on screen. That answer belongs to KotlinCompletionSupport, and it is\n`internal` — deliberately unreachable from a box. Use `FIELD_RANK_DUMP` for that; it prints\na `category=` beside every visible row. See public/docs/completion_ranking.md.\n*/\nval receiver = \"afield.geometry.path.FLine\"\nval ranks = afield.runtime.completion.CommonMemberPrior.ranksFor(receiver)\n\n// Sorted by position rather than trusting the map's iteration order, so the figure is the\n// same every time it is drawn.\nval prior =\n    Table([\"position\", \"member\", \"prior score\"])\n        .rows(\n            ranks.entries\n                .sortedBy { it.value }\n                .map { (member, position) ->\n                    [position, member, afield.runtime.completion.CommonMemberPrior.scoreOf(position)]\n                },\n        )\n        .role(\"member\", CellRole.ACCENT)\n\n// Position 1 scores BASE, and each position after it costs STEP.\ncheck(\n    ranks.all { (_, position) ->\n        afield.runtime.completion.CommonMemberPrior.scoreOf(position) ==\n            afield.runtime.completion.CommonMemberPrior.BASE -\n                afield.runtime.completion.CommonMemberPrior.STEP * (position - 1)\n    },\n) {\n    \"the prior is no longer BASE less STEP per position\"\n}\n\nmarkdown(\n    \"main\",\n    \"\"\"\n    {muted:@CommonMembers on ${receiver.md} — ${ranks.size} members, first scores ${afield.runtime.completion.CommonMemberPrior.BASE}, less ${afield.runtime.completion.CommonMemberPrior.STEP} per position}\n\n    ${prior.h}\n\"\"\",\n)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "agent_popup_prior_inspect"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}