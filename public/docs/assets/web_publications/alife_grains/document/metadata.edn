{"version" 2 "boxes" [{"id" "grains_evolve" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 — Evolving toward a statistical profile" "_tombstone" false "frame" #afield/rect [60.0 200.0 420.0 100.0] "code" #afield/file-inline {"path" "grains_evolve_code_.kt" "inline" "/*\nFitness is a weighted mean of trapezoids over the set's statistics. The sliders move\nthree of them and the time scale; releasing one re-runs the search from the same seed.\nThe duration target stretches with the time scale, so the same grammars win, slower or faster.\n*/\nvar medianPitch = 62.0\nvar countCentre = 80.0\nvar polyWeight = 1.0\nvar timeScale = 1.0\n\nfun terms() = [\n    GrainFitnessTerm(\n        GrainStat.COUNT,\n        Trapezoid(countCentre * 0.15, countCentre * 0.5, countCentre * 1.5, countCentre * 5),\n    ),\n    GrainFitnessTerm(\n        GrainStat.MEDIAN_PITCH,\n        Trapezoid(medianPitch - 14, medianPitch - 4, medianPitch + 4, medianPitch + 16),\n    ),\n    GrainFitnessTerm(GrainStat.PITCH_SPREAD, Trapezoid(1.0, 4.0, 8.0, 16.0)),\n    GrainFitnessTerm(\n        GrainStat.DURATION,\n        Trapezoid(4.0 * timeScale, 12.0 * timeScale, 30.0 * timeScale, 60.0 * timeScale),\n    ),\n    GrainFitnessTerm(GrainStat.POLYPHONY, Trapezoid(1.0, 1.8, 3.5, 8.0), weight = polyWeight),\n    GrainFitnessTerm(GrainStat.MODE_SHARE, Trapezoid(0.0, 0.0, 0.3, 0.6)),\n]\n\nfun search() {\n    val run = PopulationSearch.evolve(\n        grainLSystemGenome(),\n        grainSetObjective(terms(), turtle = GrainTurtle(timeScale = timeScale)),\n        budget = 300,\n        seed = 7L,\n        crossoverRate = 0.3,\n        immigrantRate = 0.1,\n        label = \"grains\",\n    )\n    val best = decodeGrains(run.best!!.genome, 3, GrainTurtle(timeScale = timeScale))\n    display(\"main\", run.summary() + \"<br>\" + grainRule(run.best!!.genome) + \"<br>\" + GrainSetStats(best))\n    showImg(fitnessTraceImg(run.trace), channel = \"trace\", caption = \"best-so-far fitness against evaluations, 0 to 1\")\n    showImg(grainScoreImg(best, 640, 220), channel = \"score\", caption = \"the best set\")\n    display(\"audio\", renderGrains(best).wav())\n}\n\nslider(\"median pitch\", 40.0, 84.0, 1.0, medianPitch, channel = \"pitch target\") {\n    medianPitch = it\n    search()\n}\nslider(\"grain count\", 10.0, 300.0, 5.0, countCentre, channel = \"count target\") {\n    countCentre = it\n    search()\n}\nslider(\"polyphony weight\", 0.0, 4.0, 0.1, polyWeight, channel = \"polyphony weight\") {\n    polyWeight = it\n    search()\n}\nslider(\"time scale\", 0.125, 2.0, 0.025, timeScale, channel = \"time scale\") {\n    timeScale = it\n    search()\n}\nsearch()\n"} "preamble" "" "nested" #{}}} {"id" "grains_breed" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 — Interactive evolution: you choose the parents" "_tombstone" false "frame" #afield/rect [60.0 340.0 420.0 100.0] "code" #afield/file-inline {"path" "grains_breed_code_.kt" "inline" "// Listen to the six children, type the indices of the ones you like (e.g. \"1 4\"),\n// press return: they survive and the rest are their crossovers, each mutated once.\nval breeder = GrainBreeder(seed = 1L)\n\nfun show() {\n    displayClearAll()\n    val scores = breeder.scores()\n    val listing =\n        breeder.population.withIndex().joinToString(\"<br>\") { (i, g) ->\n            \"%d: %s &nbsp; trapezoid fitness %.2f\".format(i, grainRule(g), scores[i])\n        }\n    display(\"main\", \"generation ${breeder.generation}<br>\" + listing)\n    for ((i, g) in breeder.population.withIndex()) display(\"child $i\", renderGrains(decodeGrains(g, 3)).wav())\n    stringInput(\"parents (e.g. 1 4)\") { s ->\n        val picks = s.split(\" \", \",\").mapNotNull { it.trim().toIntOrNull() }\n        if (picks.isNotEmpty()) {\n            breeder.breed(picks)\n            show()\n        }\n    }\n}\n\nshow()\n"} "preamble" "" "nested" #{}}} {"id" "grains_decode" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 — An L-system read as grains" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "grains_decode_code_.kt" "inline" "// G plays a grain and moves on in time, f rests, + and - step the pitch,\n// [ and ] save and restore time and pitch, so each bracket is a new voice.\nval system = lSystem(\"G\", 'G' to \"G[+G-G]fG\")\nfor ((i, s) in system.derivations(2).withIndex()) println(\"gen $i: $s\")\nval grains = decodeGrains(system, 3)\nprintln(GrainSetStats(grains))\nshowImg(grainScoreImg(grains, 640, 220), caption = \"time across, pitch up; gold trunk, blue and red branches\")\ndisplay(\"audio\", renderGrains(grains).wav())\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "grains_decode" #afield/box "grains_evolve" #afield/box "grains_breed"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}