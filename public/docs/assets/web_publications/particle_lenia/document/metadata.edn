{"version" 2 "boxes" [{"id" "particle_lenia_still" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 — Particle Lenia: 3000 steps, the energy field and a control" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "particle_lenia_still_code_.kt" "inline" "val pl = ParticleLenia.random(200, side = 12.0, seed = 1L)\nfor (n in [0, 100, 500, 3000]) {\n    pl.stepTimes(n - pl.steps)\n    println(pl)\n}\nshowImg(\n    montage(\n        [\n            \"particles over -E, step 3000\" to pl.render(extent = 24.0, size = 360),\n            \"U, step 3000\" to pl.fieldImg(extent = 24.0, size = 360, which = \"U\").colormap(\"magma\", 0f, 1f),\n        ],\n        columns = 2,\n        cellSide = 360,\n    ),\n)\n// Control: the same seed with no kernel, so repulsion alone moves the particles.\nval control = ParticleLenia.random(200, side = 12.0, seed = 1L, params = ParticleLeniaParams(wK = 0.0)).stepTimes(3000)\nprintln(\"CONTROL, wK = 0: \" + control)\nshowImg(\n    energyPlotImg(pl.energyHistory, 720, 160),\n    channel = \"energy\",\n    caption =\n        \"mean particle energy, steps 0 to 3000: %.3f down to %.3f\".format(pl.energyHistory.first(), pl.currentEnergy()),\n)\n"} "preamble" "" "nested" #{}}} {"id" "particle_lenia_rotator" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 — Particle Lenia: a creature that turns and travels" "_tombstone" false "frame" #afield/rect [1060.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "particle_lenia_rotator_code_.kt" "inline" "// The rotator rule: a narrower kernel ring and weaker repulsion than the article's defaults.\nval rule = ParticleLeniaParams(sigmaK = 0.6, cRep = 0.3)\nval track = mutableListOf<Pair<Double, Double>>()\n\nanimateEvolution(\n    ParticleLenia.random(100, side = 12.0 * Math.sqrt(0.5), seed = 1L, params = rule),\n    totalSteps = 12000,\n    seconds = 7.0,\n    cellSide = 400,\n    step = { pl ->\n        pl.step()\n        if (pl.steps % 50 == 0) track += pl.centroid()\n        pl\n    },\n    panels = { pl, n ->\n        val img = pl.render(extent = 24.0, size = 300, cx = 0.0, cy = 0.0)\n        // the centroid's path so far, as small dots\n        [\"step %d\".format(n) to splatDots(img, track, 24.0, 0.0, 0.0, dotRadius = 1.0)]\n    },\n)\n"} "preamble" "" "nested" #{}}} {"id" "particle_lenia_movie" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 — Particle Lenia, animated" "_tombstone" false "frame" #afield/rect [560.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "particle_lenia_movie_code_.kt" "inline" "// 200 particles from a random square, 3000 steps, drawn over the energy field.\nanimateEvolution(\n    ParticleLenia.random(200, side = 12.0, seed = 1L),\n    totalSteps = 3000,\n    seconds = 7.0,\n    cellSide = 400,\n    step = { it.step() },\n    panels = { pl, n ->\n        [\n            \"step %d   mean E %.3f\".format(n, pl.currentEnergy()) to\n                pl.render(extent = 24.0, size = 300, cx = 0.0, cy = 0.0),\n        ]\n    },\n)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "particle_lenia_still" #afield/box "particle_lenia_movie" #afield/box "particle_lenia_rotator"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metada