{"version" 2 "boxes" [{"id" "sb_renderer" "properties" {"children" #{#afield/box "sb_even" #afield/box "sb_groups"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "sb_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nOptions.profiling = false\nonce.renderer {\n    window = Window(\"Shader boids\")\n    Renderer(window)\n}\nprintln(\"renderer ready\")\nstart(renderer::run)\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "sb_groups" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "sb_renderer"} "name" "separation reaches a quarter" "_tombstone" false "frame" #afield/rect [720.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "sb_groups_code_.kt" "inline" "import afield.simulation.physics.ShaderBoids\n\nprop<afield.simulation.physics.ShaderBoids>(groups)\n\nonce.groups {\n    val grid = GpuNeighbourGrid(\n        capacity = 12000,\n        cellsPerSide = 64,\n        domainMin = Vector2f(-1f, -1f),\n        domainSize = 2f,\n        renderer = renderer,\n        name = \"groupsGrid\",\n    )\n    ShaderBoids(grid, 12000, renderer) {\n            name = \"groups\"\n            radius = 2f / 64f\n        }\n        .also {\n            it.reset(Vector2f(-0.05f, -0.5f), 1.0f, speed = 0.2f, seed = 3)\n            it.install(renderer.renderList.others)\n            it.installDrawInto()\n        }\n}\n\n// The default weights; only separation's reach differs between the two boxes.\ngroups.settings.separation = 0.02f\ngroups.settings.separationRadiusFraction = 0.25f\ngroups.settings.alignment = 3.0f\ngroups.settings.cohesion = 200f\ngroups.settings.maxSpeed = 0.25f\ngroups.settings.containment = 1.5f\ngroups.settings.containmentRadius = 0.44f\ngroups.settings.containmentCenter = Vector2f(0.45f, 0f)\ngroups.settings.dt = 1f / 60f\ngroups.settings.pointSize = 3f\ngroups.settings.intensity = 1.5f\n// No driver: left alone, the flock settles into the shape its rule makes.\ngroups.settings.driverStrength = 0f\nprintln(\"groups: separationRadiusFraction = ${groups.settings.separationRadiusFraction}\")\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "sb_even" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "sb_renderer"} "name" "separation reaches the whole radius" "_tombstone" false "frame" #afield/rect [380.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "sb_even_code_.kt" "inline" "import afield.simulation.physics.ShaderBoids\n\nprop<afield.simulation.physics.ShaderBoids>(even)\n\nonce.even {\n    val grid = GpuNeighbourGrid(\n        capacity = 12000,\n        cellsPerSide = 64,\n        domainMin = Vector2f(-1f, -1f),\n        domainSize = 2f,\n        renderer = renderer,\n        name = \"evenGrid\",\n    )\n    ShaderBoids(grid, 12000, renderer) {\n            name = \"even\"\n            radius = 2f / 64f\n        }\n        .also {\n            it.reset(Vector2f(-0.95f, -0.5f), 1.0f, speed = 0.2f, seed = 3)\n            it.install(renderer.renderList.others)\n            it.installDrawInto()\n        }\n}\n\n// The default weights; only separation's reach differs between the two boxes.\neven.settings.separation = 0.02f\neven.settings.separationRadiusFraction = 1.0f\neven.settings.alignment = 3.0f\neven.settings.cohesion = 200f\neven.settings.maxSpeed = 0.25f\neven.settings.containment = 1.5f\neven.settings.containmentRadius = 0.44f\neven.settings.containmentCenter = Vector2f(-0.45f, 0f)\neven.settings.dt = 1f / 60f\neven.settings.pointSize = 3f\neven.settings.intensity = 1.5f\n// No driver: left alone, the flock settles into the shape its rule makes.\neven.settings.driverStrength = 0f\nprintln(\"even: separationRadiusFraction = ${even.settings.separationRadiusFraction}\")\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "sb_renderer" #afield/box "sb_even" #afield/box "sb_groups"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}