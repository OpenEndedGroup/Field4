ion = 0) in vec2 tc;\nvoid main() {\n    float d = max(0.0, 0.5-length(tc-vec2(0.5)));\n    float w = fwidth(d);\n    d = smoothstep(0.1, 0.1+w, d)*smoothstep(0.14+w, 0.14, d);\n    uFragColor = vec4(1.0, 0.8, 0.4, d*0.2);\n    if (d<0.01) discard;\n}\n"} "code" #afield/file-inline {"path" "tb_draw_code_.kt" "inline" "var module = moduleHere { primitiveType = triangles }\nvar m = Mesh()\nmodule += \"mesh\" to m\nrenderer += \"draw\" to module\nval N = 100000\nm.inData = { outputPositions }\nm.aspectRatio = { window.width / window.height.toFloat() }\nm.set(N * 2 * 3, 0) {}\nprintln(\"draw launched\")\n"} "preamble" "import afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield.graphics.render.*\nimport afield.graphics.scene.*\nimport afield.graphics.shader.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\nimport afield.graphics.vulkan.buffers.FrameBufferGroup\nimport afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;     this.resize(numVert, numTriangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\n/*start*/\n/*graphics-structure-type:inData:InData*/\nclass InData(\n    members: List<Introspected.Member> = InDataLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var pos by Structure.FromStructure<afield.math.linalg.Vector4f>()\n}\nfun InDataByteSize(): Long = 16L\nfun InDataLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"pos\", 0, PrimitiveType.vec4.left(), 16, false),\n    )\nfun HasBuffer.asInData(): InData =\n    asStructure(InData(), InDataLayoutMembers())\nfun BufferParameters.asInData(): InData =\n    buffer.asInData()\n/*end*/\n/*graphics-pc-structure:inData*/ var Structure.inData by Structure.FromStructure<Any>()\n/*graphics-pc-binding:inData*/ var Mesh.inData by Mesh.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-binding-group:inData*/ var MeshGroup.inData by MeshGroup.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-structure:aspectRatio*/ var Structure.aspectRatio by Structure.FromStructure<Any>()\n/*graphics-pc-binding:aspectRatio*/ var Mesh.aspectRatio by Mesh.BoundFromStructure<Number>()\n/*graphics-pc-binding-group:aspectRatio*/ var MeshGroup.aspectRatio by MeshGroup.BoundFromStructure<Number>()\nvar Box.outputPositions by Inheritance<FrameBufferGroup>() /*from:tb_compute*/ /**/\nval Once.outputPositions by Onceing<FrameBufferGroup>() /*from:tb_compute*/ /**/\nval Why.outputPositions by Whying() /*from:tb_compute*/ /**/\nvar Box.window by Inheritance<Window>() /*from:tb_renderer*/ /**/\nval Once.window by Onceing<Window>() /*from:tb_renderer*/ /**/\nval Why.window by Whying() /*from:tb_renderer*/ /**/\nvar Box.renderer by Inheritance<Renderer>() /*from:tb_renderer*/ /**/\nval Once.renderer by Onceing<Renderer>() /*from:tb_renderer*/ /**/\nval Why.renderer by Whying() /*from:tb_renderer*/ /**/" "nested" #{}}} {"id" "tb_compute" "properties" {"children" #{#afield/box "tb_draw"} "parents" #{#afield/box "root" #afield/box "tb_renderer"} "name" "compute particles" "_tombstone" false "frame" #afield/rect [340.0 40.0 300.0 100.0] "compute" #afield/file-inline {"path" "tb_compute_compute_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\nlayout(local_size_x = 64) in;\nlayout(std430, buffer_reference) buffer inData {\n    vec4 a[];\n};\nlayout(std430, buffer_reference) buffer outData {\n    vec4 a[];\n};\nlayout(push_constant) uniform dat {\n    inData inData;\n    outData outData;\n    float something;\n    uint particleCount;\n} pc;\n{% property \"fieldProbe\" %}\nvoid main() {\n    uint idx = gl_GlobalInvocationID.x;\n    if (idx >= pc.particleCount) return;\n    vec4 seed = pc.inData.a[idx]; // xy position, zw modulation and size.\n    float phaseZ = pc.something * seed.z;\n    float phaseW = pc.something * seed.w;\n    // The y cosine alone uses the slow phase.\n    float slowPhaseZ = phaseZ * 0.03;\n    vec2 moved = vec2(\n    seed.x * cos(phaseZ) + seed.y * sin(phaseW),\n    -seed.x * sin(phaseW) + seed.y * cos(slowPhaseZ)\n    );\n    pc.outData.a[idx] = vec4(moved, seed.zw);\n    vec2 delta = moved - seed.xy;\n    fieldProbe(length(delta));\n}\n"} "code" #afield/file-inline {"path" "tb_compute_code_.kt" "inline" "var module = computeModuleHere {}\nvar m = ComputeMesh()\nmodule += \"step\" to m\nrenderer += \"compute\" to module\nval N = 100000\nvar inData = defaultBuffer { size = N.vec4s }.buffer\nvar outData = defaultBuffer { size = N.vec4s }.buffer\nm.inData = { inData }\nm.outData = { outData }\nm.particleCount = { N }\n// The live renderer uses monotonic time; frame-synchronous docs capture replaces this\n// with frameIndex/fps, so an already-running multi-box scene still restarts at movie t=0.\nm.something = { (AnimationClock.nowSeconds() * 0.6).f }\n// Full coverage makes the published probe card independent of GPU workgroup ordering;\n// summaryHtml canonicalizes the scalar display order before plotting it.\nfieldProbeHere(samples = 100000).display(\"probe\")\ndisplayOpen(\"probe\") // mark the channel open so the card starts expanded when it arrives\nprop<FrameBufferGroup>(outputPositions) = outData\nm.x = (N + 63) / 64\nm.y = 1\nm.z = 1\nval seeded = kotlin.random.Random(0x4f1e1d)\ninData.write {\n    for (i in 0 until N) {\n        put(vec(seeded.nextDouble(), seeded.nextDouble(), seeded.nextDouble(), seeded.nextDouble()))\n    }\n}\nprintln(\"compute launched, N=\" + N)\n"} "preamble" "import afield.graphics.vulkan.buffers.*\nimport afield.document.context.*\nimport afield