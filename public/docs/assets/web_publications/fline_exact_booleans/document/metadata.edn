{"version" 2 "boxes" [{"id" "fline-exact-booleans" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Booleans, Area (left) and exact (right)" "_tombstone" false "frame" #afield/rect [60.0 60.0 460.0 100.0] "code" #afield/file-inline {"path" "fline-exact-booleans_code_.kt" "inline" "fun circle(cx: Double, cy: Double, r: Double) = FLine().circle(cx, cy, r)\n\nfun blob(x: Double, y: Double) = fline {\n    moveTo(x, y)\n    cubicTo(x + 40, y - 30, x + 90, y + 10, x + 100, y + 50)\n    cubicTo(x + 110, y + 90, x + 60, y + 70, x + 50, y + 110)\n    cubicTo(x + 40, y + 150, x - 20, y + 120, x - 10, y + 80)\n    cubicTo(x, y + 50, x - 30, y + 30, x, y)\n    close()\n}\n\n// a dot on every node: how many segments each answer used\nfun dots(f: FLine, c: Vec4) =\n    f.nodes\n        .mapNotNull { it.toOrNull }\n        .map { p ->\n            FLine().circle(p.x, p.y, 2.5).apply {\n                filled = true\n                stroked = false\n                color = c\n            }\n        }\n\nval out = mutableListOf<FLine>()\nfor ((row, op) in [FLineBooleanOp.Union, FLineBooleanOp.Subtract].withIndex()) {\n    val y = 40.0 + row * 190\n    for (col in 0..1) {\n        val x = 40.0 + col * 260\n        val a = blob(x + 20, y)\n        val b = circle(x + 90, y + 60, 45.0)\n        val r =\n            if (col == 1) a.booleanExact(b, op).line\n            else if (op == FLineBooleanOp.Union) a.byUnionWith(b) else a.byDifferenceWith(b)\n        r.filled = true\n        r.stroked = true\n        r.thickness = 1.5\n        r.color = if (col == 0) vec(1.0, 0.55, 0.35, 0.35) else vec(0.4, 0.9, 1.0, 0.35)\n        out.add(r)\n        out.addAll(dots(r, if (col == 0) vec(1.0, 0.4, 0.2, 1.0) else vec(0.3, 0.8, 1.0, 1.0)))\n        println(\"$op ${if (col == 0) \"Area\" else \"exact\"}: ${r.segmentCount2D()} segments\")\n    }\n}\nlines(out, w = 460.0, h = 380.0, fitToSize = true)\n"} "preamble" "" "nested" #{}}} {"id" "fline-exact-offsets" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Offsets, sampled (left) and exact (right)" "_tombstone" false "frame" #afield/rect [560.0 60.0 460.0 100.0] "code" #afield/file-inline {"path" "fline-exact-offsets_code_.kt" "inline" "fun star(cx: Double, cy: Double) = fline {\n    breakNext()\n    for (i in 0 until 10) {\n        val r = if (i % 2 == 0) 70.0 else 32.0\n        val a = kotlin.math.PI * i / 5\n        lineTo(cx + r * kotlin.math.cos(a), cy + r * kotlin.math.sin(a))\n    }\n    close()\n}\n\nfun sCurve(x: Double, y: Double) = fline {\n    moveTo(x, y)\n    cubicTo(x + 40, y - 55, x + 70, y + 55, x + 110, y)\n    cubicTo(x + 140, y - 35, x + 170, y + 30, x + 200, y + 5)\n    lineTo(x + 215, y + 55)\n}\n\nfun dots(f: FLine, c: Vec4) =\n    f.nodes\n        .mapNotNull { it.toOrNull }\n        .map { p ->\n            FLine().circle(p.x, p.y, 2.0).apply {\n                filled = true\n                stroked = false\n                color = c\n            }\n        }\n\nval out = mutableListOf<FLine>()\nfor (col in 0..1) {\n    val x = 30.0 + col * 280\n    val shapes = [star(x + 110, 100.0), sCurve(x, 270.0)]\n    for (s in shapes) {\n        s.thickness = 1.0\n        s.color = vec(1.0, 1.0, 1.0, 0.6)\n        out.add(s)\n        for (d in [12.0, -12.0]) {\n            val o = if (col == 0) s.byOffsetting(d.toFloat()) else s.byOffsettingExact(d.toFloat())\n            o.thickness = 1.5\n            o.color = if (col == 0) vec(1.0, 0.55, 0.35, 1.0) else vec(0.4, 0.9, 1.0, 1.0)\n            out.add(o)\n            out.addAll(dots(o, if (col == 0) vec(1.0, 0.4, 0.2, 1.0) else vec(0.3, 0.8, 1.0, 1.0)))\n            println(\"${if (col == 0) \"byOffsetting\" else \"byOffsettingExact\"} d=$d: ${o.segmentCount2D()} segments\")\n        }\n    }\n}\nlines(out, w = 560.0, h = 360.0, fitToSize = true)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "fline-exact-booleans" #afield/box "fline-exact-offsets"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}