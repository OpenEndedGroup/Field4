{"version" 2 "boxes" [{"id" "spreadsheet_constraints_temperature" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Temperature · run me" "_tombstone" false "frame" #afield/rect [80.0 80.0 420.0 60.0] "code" #afield/file-inline {"path" "spreadsheet_constraints_temperature_code_.kt" "inline" "// B1 and B2 are variables; B4 says how they are related.\n// Type 37 into B1 and Fahrenheit follows; type 451 into B2 and Celsius follows.\nsheet(height = 200) {\n    rows = 4\n    cols = 2\n    columnWidth(\"A\", 140)\n    this[\"A1\"] = \"Celsius\"\n    formula(\"B1\", \"free(100)\")\n    this[\"A2\"] = \"Fahrenheit\"\n    formula(\"B2\", \"free(212)\")\n    this[\"A3\"] = \"Kelvin\"\n    formula(\"B3\", \"B1 + 273.15\")\n    this[\"A4\"] = \"F from C\"\n    formula(\"B4\", \"B2 eq B1 * 9.0 / 5.0 + 32.0\")\n}\n"} "nested" #{} "preamble" "" "spreadsheet" #afield/file-inline {"path" "spreadsheet_constraints_temperature_spreadsheet_.json" "inline" "{\"rows\":4,\"cols\":2,\"colWidths\":[140.0,120.0],\"rowHeights\":[32.0,32.0,32.0,32.0],\"cells\":[{\"row\":0,\"col\":0,\"input\":\"Celsius\"},{\"row\":0,\"col\":1,\"input\":\"=free(100)\"},{\"row\":1,\"col\":0,\"input\":\"Fahrenheit\"},{\"row\":1,\"col\":1,\"input\":\"=free(212)\"},{\"row\":2,\"col\":0,\"input\":\"Kelvin\"},{\"row\":2,\"col\":1,\"input\":\"=B1 + 273.15\"},{\"row\":3,\"col\":0,\"input\":\"F from C\"},{\"row\":3,\"col\":1,\"input\":\"=B2 eq B1 * 9.0 / 5.0 + 32.0\"}],\"solved\":{\"0:1\":\"=free(100)\",\"1:1\":\"=free(212)\"}}"}}} {"id" "spreadsheet_constraints_rectangle" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Rectangle · run me" "_tombstone" false "frame" #afield/rect [80.0 380.0 420.0 60.0] "code" #afield/file-inline {"path" "spreadsheet_constraints_rectangle_code_.kt" "inline" "/*\nWidth and height are variables; area and perimeter are ordinary formulas over them.\nThe two assertions hold the area at 40 and the width at no more than 6.\nType 8 into the width: the sheet stops it at 6 and the height takes up the area.\n*/\nsheet(height = 260) {\n    rows = 6\n    cols = 2\n    columnWidth(\"A\", 140)\n    this[\"A1\"] = \"width\"\n    formula(\"B1\", \"free(4)\")\n    this[\"A2\"] = \"height\"\n    formula(\"B2\", \"free(5)\")\n    this[\"A3\"] = \"area\"\n    formula(\"B3\", \"B1 * B2\")\n    this[\"A4\"] = \"perimeter\"\n    formula(\"B4\", \"2 * (B1 + B2)\")\n    this[\"A5\"] = \"area is 40\"\n    formula(\"B5\", \"B3 eq 40\")\n    this[\"A6\"] = \"no wider than 6\"\n    formula(\"B6\", \"B1 le 6\")\n}\n"} "nested" #{} "preamble" "" "spreadsheet" #afield/file-inline {"path" "spreadsheet_constraints_rectangle_spreadsheet_.json" "inline" "{\"rows\":6,\"cols\":2,\"colWidths\":[140.0,120.0],\"rowHeights\":[32.0,32.0,32.0,32.0,32.0,32.0],\"cells\":[{\"row\":0,\"col\":0,\"input\":\"width\"},{\"row\":0,\"col\":1,\"input\":\"=free(4)\"},{\"row\":1,\"col\":0,\"input\":\"height\"},{\"row\":1,\"col\":1,\"input\":\"=free(5)\"},{\"row\":2,\"col\":0,\"input\":\"area\"},{\"row\":2,\"col\":1,\"input\":\"=B1 * B2\"},{\"row\":3,\"col\":0,\"input\":\"perimeter\"},{\"row\":3,\"col\":1,\"input\":\"=2 * (B1 + B2)\"},{\"row\":4,\"col\":0,\"input\":\"area is 40\"},{\"row\":4,\"col\":1,\"input\":\"=B3 eq 40\"},{\"row\":5,\"col\":0,\"input\":\"no wider than 6\"},{\"row\":5,\"col\":1,\"input\":\"=B1 le 6\"}],\"solved\":{}}"}}} {"id" "root" "properties" {"children" #{#afield/box "spreadsheet_constraints_temperature" #afield/box "spreadsheet_constraints_rectangle"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "