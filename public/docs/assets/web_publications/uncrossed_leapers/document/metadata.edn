{"version" 2 "boxes" [{"id" "ul_gallery" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - five leapers on three surfaces" "_tombstone" false "frame" #afield/rect [60.0 900.0 300.0 100.0] "code" #afield/file-inline {"path" "ul_gallery_code_.kt" "inline" "import afield.geometry.leaper.*\n\n/*\nFive leapers on three surfaces, n×n. A cylinder joins the left and right edges; a torus also\njoins top and bottom. A move may leave through a joined edge and come back through the\nopposite one, and \"uncrossed\" is judged on that surface. Dashed blue edges are joined.\n*/\nval n = 7\nval nodeBudget = 1_000_000L\nval leapers = [Leaper.KNIGHT, Leaper.CAMEL, Leaper.ZEBRA, Leaper.GIRAFFE, Leaper.ANTELOPE]\nval topologies = BoardTopology.entries\nval cell = 10.0\nval step = n * cell + 16.0\nval out = ArrayList<FLine>()\nval lengths = leapers.map { ArrayList<String>() }\nleapers.forEachIndexed { c, leaper -> out += leaperLabel(leaper.name, 40.0 + c * step, -6.0, 6.0) }\ntopologies.forEachIndexed { r, t ->\n    out += leaperLabel(t.name.lowercase(), 0.0, r * step + n * cell / 2, 5.0)\n    leapers.forEachIndexed { c, leaper ->\n        val board = LeaperBoard(n, n, leaper, t)\n        val result = board.bestUncrossedPath(nodeBudget = nodeBudget, rounds = 300)\n        val x = 40.0 + c * step\n        val y = r * step\n        out += result.best?.uncrossedTile(cell, x, y) ?: board.boardLines(cell, x, y)\n        lengths[c] += \"${result.length}${if (result.exhaustive) \"\" else \"?\"}\"\n    }\n}\nlines(out, w = 900.0, h = 520.0, fitToSize = true)\nmarkdown(\n    \"| $n×$n | rectangle | cylinder | torus |\\n|---|---|---|---|\\n\" +\n        leapers.indices.joinToString(\"\\n\") { k -> \"| ${leapers[k]} | ${lengths[k].joinToString(\" | \")} |\" } +\n        \"\\n\\n? = not proved: the best of a $nodeBudget-step search and 300 rounds of ruin and recreate\",\n)\n"} "preamble" "" "nested" #{}}} {"id" "ul_draw" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "8 - is my drawing an uncrossed path?" "_tombstone" false "frame" #afield/rect [760.0 2900.0 300.0 100.0] "code" #afield/file-inline {"path" "ul_draw_code_.kt" "inline" "import afield.geometry.leaper.*\n\n/*\nDraw a knight path on the board this box puts on the drawing layer (Alt+D, then the pen),\none stroke through the centres of the squares, and run the box again. It reads the newest\nhand-drawn stroke over the board, snaps it to squares and says whether it is a legal\nuncrossed path. Until you draw one it checks a demonstration stroke of its own.\n*/\nval n = 6\nval cell = 40.0\nval left = frame.x + frame.w + 60.0\nval top = frame.y\nval board = LeaperBoard(n, n)\n// The newest hand-drawn stroke that lies over the board (with a square's slack all round).\nval drawn =\n    notation.strokes.lastOrNull { m ->\n        val b = m.bounds\n        m.handDrawn &&\n            b.x >= left - cell &&\n            b.y >= top - cell &&\n            b.x + b.w <= left + (n + 1) * cell &&\n            b.y + b.h <= top + (n + 1) * cell\n    }\n// The demonstration: a1 b3 c5 e4 c3 d5 — the last move crosses the third.\nval demoCells = intArrayOf(0, 13, 26, 22, 14, 27)\nnotation(\"board\") {\n    stroke = \"#5c7cfa\"\n    for (i in 0 until n) for (j in 0 until n) if ((i + j) % 2 == 0) {\n        rect(left + i * cell, top + j * cell, cell, cell, fill = \"#dbe4ff\", stroke = \"transparent\")\n    }\n    rect(left, top, n * cell, n * cell, fill = \"transparent\")\n    if (drawn == null) {\n        // Twelve samples along each move, the way a pen stroke records points.\n        fun centreX(c: Int) = left + (c % n + 0.5) * cell\n        fun centreY(c: Int) = top + (c / n + 0.5) * cell\n        val samples = ArrayList<Vec2>()\n        for (i in 0 until demoCells.size - 1) for (k in 0 until 12) {\n            val t = k / 12.0\n            val from = demoCells[i]\n            val to = demoCells[i + 1]\n            samples +=\n                vec(\n                    centreX(from) + (centreX(to) - centreX(from)) * t,\n                    centreY(from) + (centreY(to) - centreY(from)) * t,\n                )\n        }\n        samples += vec(centreX(demoCells.last()), centreY(demoCells.last()))\n        stroke(samples, name = \"demo path\", stroke = \"#e8590c\")\n    }\n}\nval mark = drawn ?: notation.named(\"demo path\")!!\nval pts = mark.points\nval cells = board.readDrawnPath(\n    pts.map { it.x.toDouble() }.toDoubleArray(),\n    pts.map { it.y.toDouble() }.toDoubleArray(),\n    cell,\n    left,\n    top,\n)\nval verdict = board.check(cells)\nval names = cells.joinToString(\" \") { board.cellName(it) }\nval source = if (drawn == null) \"the demonstration stroke\" else \"your stroke\"\nmarkdown(\n    if (verdict == null)\n        \"**Legal.** $source visits $names: an uncrossed path of ${cells.size - 1} moves \" +\n            \"(the longest on $n×$n is ${UNCROSSED_KNIGHT_PATH_MAXIMA[n - 1]}).\"\n    else \"**Not legal.** $source visits $names: $verdict.\",\n)\n"} "preamble" "" "nested" #{}}} {"id" "ul_arcs" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "ul_tours"} "name" "6b - workshop perpendicular arcs" "_tombstone" false "frame" #afield/rect [1460.0 2000.0 300.0 100.0] "code" #afield/file-inline {"path" "ul_arcs_code_.kt" "inline" "import kotlin.math.*\n\n// Uniform scale about each triple's original B. 1.0 restores the source arcs.\nval arcScale = 0.5\n// Signed shift along the original A-to-C normal, applied after scaling.\nval arcPush = 0.0\nrequire(arcScale > 0.0)\nval boardWidth = knightBoardWidth\nval boardHeight = knightBoardHeight\nval cell = knightCellSize\nval boardW = boardWidth * cell\nval boardH = boardHeight * cell\nval gap = 12.0\n\n// B is tour[k+1], not the midpoint of the sampled arc's list.\nval arcCentres = knightArcRows.mapIndexed { r, row ->\n    row.mapIndexed { t, arcs ->\n        val tour = knightTourRows[r][t]\n        check(arcs.size == tour.size - 2)\n        arcs.indices.map { k ->\n            val b = tour[k + 1]\n            ((b % boardWidth + 0.5) * cell) to ((b / boardWidth + 0.5) * cell)\n        }\n    }\n}\nval arcOffsets = knightArcRows.map { row ->\n    row.map { arcs ->\n        arcs.map { arc ->\n            val dx = arc.last().first - arc.first().first\n            val dy = arc.last().second - arc.first().second\n            val length = hypot(dx, dy)\n            require(length > 1e-9)\n            (-dy / length * arcPush) to (dx / length * arcPush)\n        }\n    }\n}\n// Reuse the parent's sampling without mutating it or fitting circles again.\nval scaledRows = knightArcRows.mapIndexed { r, row ->\n    row.mapIndexed { t, arcs ->\n        arcs.mapIndexed { k, arc ->\n            val b = arcCentres[r][t][k]\n            val offset = arcOffsets[r][t][k]\n            arc.map { p ->\n                (b.first + arcScale * (p.first - b.first) + offset.first) to\n                    (b.second + arcScale * (p.second - b.second) + offset.second)\n            }\n        }\n    }\n}\n\nvar checkedArcs = 0\nvar maxScaleError = 0.0\nvar maxAnchorError = 0.0\nknightArcRows.forEachIndexed { r, row ->\n    row.forEachIndexed { t, arcs ->\n        arcs.forEachIndexed { k, arc ->\n            val b = arcCentres[r][t][k]\n            val offset = arcOffsets[r][t][k]\n            val shiftedB = (b.first + offset.first) to (b.second + offset.second)\n            val scaled = scaledRows[r][t][k]\n            check(scaled.size == arc.size)\n            val bIndex = arc.indexOf(b)\n            check(bIndex >= 0) { \"The source arc must contain B exactly\" }\n            val anchorError = hypot(scaled[bIndex].first - shiftedB.first, scaled[bIndex].second - shiftedB.second)\n            maxAnchorError = max(maxAnchorError, anchorError)\n            scaled.zip(arc).forEach { (q, p) ->\n                val error = abs(\n                    hypot(q.first - shiftedB.first, q.second - shiftedB.second) -\n                        arcScale * hypot(p.first - b.first, p.second - b.second),\n                )\n                maxScaleError = max(maxScaleError, error)\n                check(error < 1e-9)\n            }\n            check(anchorError < 1e-9)\n            checkedArcs++\n        }\n    }\n}\n\nval tiles = scaledRows.flatMapIndexed { r, row ->\n    row.flatMapIndexed { t, arcs ->\n        val background = fline {\n            moveTo(0, 0)\n            lineTo(boardW, 0)\n            lineTo(boardW, boardH)\n            lineTo(0, boardH)\n            close()\n            filled = true\n            stroked = false\n            color = vec(1.0, 1.0, 1.0, 0.06)\n        }\n        val path = fline {\n            for (arc in arcs) arc.forEachIndexed { k, p ->\n                if (k == 0) moveTo(p.first, p.second) else lineTo(p.first, p.second)\n            }\n            thickness = 0.7\n            color = vec(0.98, 0.85, 0.3, 0.8)\n        }\n        val offset = vec(t * (boardW + gap), r * (boardH + gap) + 24.0, 0.0)\n        listOf(background, path).map { it + offset }\n    }\n}\nval title =\n    afield.ai.learning.pen.HersheyFont.load(\"futural\")\n        .text(\"Arc scale / \" + arcScale + \" about B / push \" + arcPush, size = 7.0)\n        .apply {\n            thickness = 0.5\n            color = vec(0.85, 0.85, 0.85, 1.0)\n        }\nlines(listOf(title) + tiles, w = 900.0, h = 500.0, fitToSize = true)\nprintln(\n    \"Scaled \" +\n        checkedArcs +\n        \" arcs about B by \" +\n        arcScale +\n        \". Maximum scale error: \" +\n        maxScaleError +\n        \"; B anchor error: \" +\n        maxAnchorError,\n)"} "preamble" "var Box.knightTourRows by Inheritance<List<List<IntArray>>>() /*from:ul_tours*/ /**/\nval Once.knightTourRows by Onceing<List<List<IntArray>>>() /*from:ul_tours*/ /**/\nval Why.knightTourRows by Whying() /*from:ul_tours*/ /**/\nvar Box.knightArcRows by Inheritance<List<List<List<List<Pair<Double, Double>>>>>>() /*from:ul_tours*/ /**/\nval Once.knightArcRows by Onceing<List<List<List<List<Pair<Double, Double>>>>>>() /*from:ul_tours*/ /**/\nval Why.knightArcRows by Whying() /*from:ul_tours*/ /**/\nvar Box.knightBoardWidth by Inheritance<Int>() /*from:ul_tours*/ /**/\nval Once.knightBoardWidth by Onceing<Int>() /*from:ul_tours*/ /**/\nval Why.knightBoardWidth by Whying() /*from:ul_tours*/ /**/\nvar Box.knightBoardHeight by Inheritance<Int>() /*from:ul_tours*/ /**/\nval Once.knightBoardHeight by Onceing<Int>() /*from:ul_tours*/ /**/\nval Why.knightBoardHeight by Whying() /*from:ul_tours*/ /**/\nvar Box.knightCellSize by Inheritance<Double>() /*from:ul_tours*/ /**/\nval Once.knightCellSize by Onceing<Double>() /*from:ul_tours*/ /**/\nval Why.knightCellSize by Whying() /*from:ul_tours*/ /**/" "nested" #{}}} {"id" "ul_sweep" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5 - how much of the board each leaper covers" "_tombstone" false "frame" #afield/rect [760.0 900.0 300.0 100.0] "code" #afield/file-inline {"path" "ul_sweep_code_.kt" "inline" "import afield.geometry.leaper.*\n\n/*\nHow much of the board each leaper can cover without crossing itself: the share of the n×n\nsquares its longest uncrossed path visits, for n = 4..9, on each surface. A hollow dot is a\nbest-found value (the search ran out of budget), a filled one is proved.\n*/\nval sizes = 4..9\nval nodeBudget = 200_000L\nval leapers = [Leaper.KNIGHT, Leaper.CAMEL, Leaper.ZEBRA, Leaper.GIRAFFE, Leaper.ANTELOPE]\nval colours = [\n    vec(0.98, 0.85, 0.3, 1.0),\n    vec(0.45, 0.8, 1.0, 1.0),\n    vec(0.95, 0.45, 0.45, 1.0),\n    vec(0.6, 0.9, 0.5, 1.0),\n    vec(0.8, 0.6, 1.0, 1.0),\n]\nval panelW = 150.0\nval panelH = 100.0\nval out = ArrayList<FLine>()\nval table = StringBuilder(\n    \"| surface | leaper | \" +\n        sizes.joinToString(\" | \") { \"$it×$it\" } +\n        \" |\\n|---|---|\" +\n        sizes.joinToString(\"\") { \"---|\" } +\n        \"\\n\",\n)\nBoardTopology.entries.forEachIndexed { p, t ->\n    val ox = p * (panelW + 30.0)\n    out += fline {\n        moveTo(ox, 0.0)\n        lineTo(ox, panelH)\n        lineTo(ox + panelW, panelH)\n        color = vec(1.0, 1.0, 1.0, 0.5)\n        thickness = 0.8\n    }\n    out += leaperLabel(t.name.lowercase(), ox + 4.0, -6.0, 6.0)\n    out += leaperLabel(\"100%\", ox - 22.0, 2.0, 4.0)\n    out += leaperLabel(\"n = ${sizes.first}\", ox, panelH + 9.0, 4.0)\n    out += leaperLabel(\"${sizes.last}\", ox + panelW - 4.0, panelH + 9.0, 4.0)\n    leapers.forEachIndexed { k, leaper ->\n        val results = sizes.map { n ->\n            LeaperBoard(n, n, leaper, t).bestUncrossedPath(nodeBudget = nodeBudget, rounds = 100, nodesPerRound = 4_000)\n        }\n        val pts = results.mapIndexed { i, r ->\n            val share = (if (r.best == null) 0.0 else r.length + 1.0) / (r.board.cells)\n            Triple(ox + i * panelW / (sizes.count() - 1), panelH * (1 - share), r)\n        }\n        out += fline {\n            pts.forEachIndexed { i, (x, y, _) -> if (i == 0) moveTo(x, y) else lineTo(x, y) }\n            color = colours[k]\n            thickness = 1.2\n        }\n        pts.forEach { (x, y, r) ->\n            out += fline {\n                circle(x, y, 2.2)\n                color = colours[k]\n                filled = r.exhaustive\n                thickness = 1.0\n            }\n        }\n        table.append(\n            \"| ${t.name.lowercase()} | ${leaper.name} | \" +\n                results.joinToString(\" | \") { \"${it.length}${if (it.exhaustive) \"\" else \"?\"}\" } +\n                \" |\\n\",\n        )\n    }\n}\nleapers.forEachIndexed { k, leaper -> out += leaperLabel(leaper.name, k * 70.0, panelH + 24.0, 5.0, colours[k]) }\nlines(out, w = 900.0, h = 260.0, fitToSize = true)\nmarkdown(\n    table.toString() +\n        \"\\nMoves in the longest path found; ? = not proved (best of a $nodeBudget-step search and 100 rounds of ruin and recreate).\",\n)\n"} "preamble" "" "nested" #{}}} {"id" "ul_cycles" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - longest uncrossed knight cycles" "_tombstone" false "frame" #afield/rect [1460.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "ul_cycles_code_.kt" "inline" "import afield.geometry.leaper.*\n\n/*\nClosed paths: the path must come back to its first square, and the closing move may not\ncross anything either. Up to 7×7 the search is exhaustive; 8×8 to 10×10 use ruin and\nrecreate. The known maxima are OEIS A157416.\n*/\nval sizes = 4..10\nval cell = 10.0\nvar x = 0.0\nval results = sizes.map { n -> LeaperBoard(n, n).bestUncrossedPath(closed = true, nodeBudget = 3_000_000) }\nval tiles = results.flatMap { r ->\n    val tile = r.best!!.uncrossedTile(cell, x, 0.0) + leaperLabel(\"${r.board.w}×${r.board.w}  ${r.length}\", x, -4.0)\n    x += r.board.w * cell + 14.0\n    tile\n}\nlines(tiles, w = 900.0, h = 200.0, fitToSize = true)\nmarkdown(\n    \"| board | moves found | A157416 | proved |\\n|---|---|---|---|\\n\" +\n        results.joinToString(\"\\n\") { r ->\n            \"| ${r.board.w}×${r.board.w} | ${r.length} | ${UNCROSSED_KNIGHT_CYCLE_MAXIMA[r.board.w - 1]} | ${if (r.exhaustive) \"yes\" else \"no\"} |\"\n        },\n)\n"} "preamble" "" "nested" #{}}} {"id" "ul_big" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - 8×8 and 9×9 against the known optimum" "_tombstone" false "frame" #afield/rect [760.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "ul_big_code_.kt" "inline" "import afield.geometry.leaper.*\nimport kotlin.random.Random\n\n/*\nPast 7×7 a proof takes minutes (35 on 8×8 needs 337 million search steps), so this box uses\nruin and recreate: cut a random tail off the best path so far and regrow it with a short\nsearch, 1000 times. It is not a proof, and where it ends depends on the seed, so each board\ngets four seeds; the best is drawn, against the known optimum, 35 and 47.\n*/\nval seeds = 1..4\nval cell = 10.0\nvar x = 0.0\nval tiles = ArrayList<FLine>()\nfor (n in [8, 9]) {\n    val board = LeaperBoard(n, n)\n    val runs = seeds.map { s -> board.longUncrossedPath(random = Random(s)) }\n    val best = runs.maxBy { it.length }\n    val known = UNCROSSED_KNIGHT_PATH_MAXIMA[n - 1]\n    tiles += best.best!!.uncrossedTile(cell, x, 0.0)\n    tiles += leaperLabel(\"$n×$n  ${best.length} of $known\", x, -4.0)\n    x += n * cell + 16.0\n    println(\n        \"$n×$n: seeds $seeds reach ${runs.map { it.length }} moves (known optimum $known), ${runs.sumOf { it.millis }} ms in all\",\n    )\n}\nlines(tiles, w = 700.0, h = 360.0, fitToSize = true)\n"} "preamble" "" "nested" #{}}} {"id" "ul_lines" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "ul_tours"} "name" "6a - workshop line experiments" "_tombstone" false "frame" #afield/rect [760.0 2000.0 300.0 100.0] "code" #afield/file-inline {"path" "ul_lines_code_.kt" "inline" "import afield.math.linalg.*\nimport kotlin.math.*\n\n/*\nZipped layers: use [a, b, c] or a scalar. Short lists hold their last value.\nAll geometry parameters are deliberately UNCLAMPED.\nTrims are fractions of the original move removed from each end.\n*/\nval startTrim = [0]\nval endTrim = [0]\nval nextPull = [5.0]\nval previousPull = [-15.0, -10.0, -5.0, 0, 5.0, 10.0, 15.0]\nval rotationRadians = [0]\nval perpendicularOffset = [0.0]\nval alongSlide = 7 { it * 4 }\nval strokeWidth = 7 { 1 / (1 + it.d) }\nval gap = 12.0\nval cell = knightCellSize\nval w = knightBoardWidth\nval h = knightBoardHeight\nval boardW = w * cell\nval boardH = h * cell\n\ndata class StrokeParameters(\n    val startTrim: Double = 0.0,\n    val endTrim: Double = 0.0,\n    val nextPull: Double = 0.0,\n    val previousPull: Double = 0.0,\n    val rotation: Double = 0.0,\n    val offset: Double = 0.0,\n    val slide: Double = 0.0,\n)\ndata class QuadraticStroke(val start: Vector2f, val control: Vector2f, val end: Vector2f)\n// Convert only at the parameter boundary; geometry stays strongly typed.\nfun parameterValues(value: Any): List<Double> = when (value) {\n    is Number -> [value.toDouble()]\n    is List<*> -> {\n        require(value.isNotEmpty()) { \"Parameter lists need at least one value.\" }\n        value.map {\n            require(it is Number) { \"Parameter values must be numbers.\" }\n            it.toDouble()\n        }\n    }\n    else -> error(\"Use a number or a nonempty list of numbers.\")\n}\nfun held(values: List<Double>, index: Int) = values.getOrElse(index) { values.last() }\nval channels = [startTrim, endTrim, nextPull, previousPull, rotationRadians, perpendicularOffset, alongSlide, strokeWidth].map {\n    parameterValues(it)\n}\nval layerCount = channels.maxOf { it.size }\nval parameterSets =\n    (0 until layerCount).map { i ->\n        StrokeParameters(\n            held(channels[0], i),\n            held(channels[1], i),\n            held(channels[2], i),\n            held(channels[3], i),\n            held(channels[4], i),\n            held(channels[5], i),\n            held(channels[6], i),\n        )\n    }\nval layerWidths = (0 until layerCount).map { held(channels[7], it) }\n// Hold-last and scalar checks, including deliberately out-of-range values.\ncheck(parameterValues(-1.0) == [-1.0])\ncheck((0..3).map { held(parameterValues([11.0, -1.0]), it) } == [11.0, -1.0, -1.0, -1.0])\ncheck((0..2).map { held(parameterValues(4.0), it) } == [4.0, 4.0, 4.0])\n\n/*\nFor move A->B, previous means the point before A; next means the point after B.\nControl pulls use unit directions from the trimmed midpoint to those ORIGINAL neighbours.\nZero-length pull directions contribute zero; neither pulls nor trims are restricted.\n*/\nfun makeStroke(a: Vector2f, b: Vector2f, previous: Vector2f?, next: Vector2f?, p: StrokeParameters): QuadraticStroke {\n    val delta = b - a\n    val start = a + delta * p.startTrim\n    val end = b - delta * p.endTrim\n    val middle = (start + end) * 0.5\n    var control = middle\n    if (next != null) control = control + (next - middle).normalized(1e-12f) * p.nextPull\n    if (previous != null) control = control + (previous - middle).normalized(1e-12f) * p.previousPull\n    // Axes follow the ORIGINAL A->B orientation, then rotate. Over-trimming does not flip them.\n    val rotation = quat(p.rotation)\n    val axis = delta.normalized(1e-12f) * rotation\n    val normal = vec(-axis.y(), axis.x())\n    val translation = normal * p.offset + axis * p.slide\n    fun transform(q: Vector2f) = middle + (q - middle) * rotation + translation\n    return QuadraticStroke(transform(start), transform(control), transform(end))\n}\n\n// Mathematical checks include extension, reversed endpoints and parameters outside [0,1].\nfun near(a: Vector2f, b: Vector2f) = (a - b).length() < 1e-5\nval aTest = vec(0.0, 0.0)\nval bTest = vec(10.0, 0.0)\nval identity = makeStroke(aTest, bTest, null, null, StrokeParameters())\ncheck(near(identity.start, aTest) && near(identity.end, bTest) && near(identity.control, vec(5.0, 0.0)))\nval extended = makeStroke(aTest, bTest, null, null, StrokeParameters(startTrim = -1.0, endTrim = -1.0))\ncheck(near(extended.start, vec(-10.0, 0.0)) && near(extended.end, vec(20.0, 0.0)))\nval reversed = makeStroke(aTest, bTest, null, null, StrokeParameters(startTrim = 2.0, endTrim = 2.0))\ncheck(near(reversed.start, vec(20.0, 0.0)) && near(reversed.end, vec(-10.0, 0.0)))\nval moved = makeStroke(aTest, bTest, null, null, StrokeParameters(rotation = PI / 2, offset = 2.0, slide = 3.0))\ncheck(near(moved.start, vec(3.0, -2.0)) && near(moved.end, vec(3.0, 8.0)))\nval pulled = makeStroke(aTest, bTest, null, vec(10.0, 10.0), StrokeParameters(nextPull = 11.0))\ncheck(abs((pulled.control - vec(5.0, 0.0)).length() - 11.0) < 1e-5)\nval pushed = makeStroke(aTest, bTest, vec(0.0, 10.0), null, StrokeParameters(previousPull = -11.0))\ncheck(near(pushed.control, vec(5.0, 0.0) + (vec(5.0, -10.0).normalized(1e-12f) * 11.0)))\n\nval pointRows = knightTourRows.map { row ->\n    row.map { tour ->\n        tour.map { i -> vec((i % w + 0.5) * cell, (i / w + 0.5) * cell) }\n    }\n}\nval strokeRows = pointRows.map { row ->\n    row.map { points ->\n        parameterSets.map { parameters ->\n            (0 until points.size - 1).map { k ->\n                makeStroke(points[k], points[k + 1], points.getOrNull(k - 1), points.getOrNull(k + 2), parameters)\n            }\n        }\n    }\n}\nval tiles = strokeRows.flatMapIndexed { r, row ->\n    row.flatMapIndexed { c, layers ->\n        val background = fline {\n            moveTo(0, 0)\n            lineTo(boardW, 0)\n            lineTo(boardW, boardH)\n            lineTo(0, boardH)\n            close()\n            filled = true\n            stroked = false\n            color = vec(1.0, 1.0, 1.0, 0.06)\n        }\n        val paths = layers.mapIndexed { layerIndex, strokes ->\n            fline {\n                for (q in strokes) {\n                    moveTo(q.start.x, q.start.y)\n                    // Exact quadratic represented as a cubic (no sampling approximation).\n                    val c1 = q.start + (q.control - q.start) * (2.0 / 3.0)\n                    val c2 = q.end + (q.control - q.end) * (2.0 / 3.0)\n                    cubicTo(c1.x, c1.y, c2.x, c2.y, q.end.x, q.end.y)\n                }\n                thickness = layerWidths[layerIndex]\n                color = vec(9.98 / (10 + r + c), 0.65, 0.3, 0.9)\n            }\n        }\n        (listOf(background) + paths).map { it + vec(c * (w * cell + gap), r * (h * cell + gap), 0.0) }\n    }\n}\nlines(*tiles.toTypedArray(), fitToSize = true)\nprintln(\n    \"Parametric quadratic moves: \" +\n        strokeRows.sumOf { row -> row.sumOf { layers -> layers.sumOf { it.size } } } +\n        \". \" +\n        parameterSets +\n        \". Layers: $layerCount. Unclamped geometry and hold-last checks passed; inherited tours unchanged.\",\n)"} "preamble" "var Box.knightTourRows by Inheritance<List<List<IntArray>>>() /*from:ul_tours*/ /**/\nval Once.knightTourRows by Onceing<List<List<IntArray>>>() /*from:ul_tours*/ /**/\nval Why.knightTourRows by Whying() /*from:ul_tours*/ /**/\nvar Box.knightArcRows by Inheritance<List<List<List<List<Pair<Double, Double>>>>>>() /*from:ul_tours*/ /**/\nval Once.knightArcRows by Onceing<List<List<List<List<Pair<Double, Double>>>>>>() /*from:ul_tours*/ /**/\nval Why.knightArcRows by Whying() /*from:ul_tours*/ /**/\nvar Box.knightBoardWidth by Inheritance<Int>() /*from:ul_tours*/ /**/\nval Once.knightBoardWidth by Onceing<Int>() /*from:ul_tours*/ /**/\nval Why.knightBoardWidth by Whying() /*from:ul_tours*/ /**/\nvar Box.knightBoardHeight by Inheritance<Int>() /*from:ul_tours*/ /**/\nval Once.knightBoardHeight by Onceing<Int>() /*from:ul_tours*/ /**/\nval Why.knightBoardHeight by Whying() /*from:ul_tours*/ /**/\nvar Box.knightCellSize by Inheritance<Double>() /*from:ul_tours*/ /**/\nval Once.knightCellSize by Onceing<Double>() /*from:ul_tours*/ /**/\nval Why.knightCellSize by Whying() /*from:ul_tours*/ /**/" "nested" #{}}} {"id" "ul_knight" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - longest uncrossed knight paths" "_tombstone" false "frame" #afield/rect [60.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "ul_knight_code_.kt" "inline" "import afield.geometry.leaper.*\n\n// The longest uncrossed knight path on each board from 3×3 to 7×7, by exhaustive search.\n// The table sets each result beside OEIS A003192, the known maxima.\nval sizes = 3..7\nval cell = 10.0\nvar x = 0.0\nval results = sizes.map { n -> LeaperBoard(n, n).longestUncrossedPath() }\nval tiles = results.flatMap { r ->\n    val tile = r.best!!.uncrossedTile(cell, x, 0.0) + leaperLabel(\"${r.board.w}×${r.board.w}  ${r.length}\", x, -4.0)\n    x += r.board.w * cell + 14.0\n    tile\n}\nlines(tiles, w = 900.0, h = 230.0, fitToSize = true)\nmarkdown(\n    \"| board | moves found | A003192 | proved | nodes searched | ms |\\n|---|---|---|---|---|---|\\n\" +\n        results.joinToString(\"\\n\") { r ->\n            \"| ${r.board.w}×${r.board.w} | ${r.length} | ${UNCROSSED_KNIGHT_PATH_MAXIMA[r.board.w - 1]} | \" +\n                \"${if (r.exhaustive) \"yes\" else \"no\"} | ${r.nodes} | ${r.millis} |\"\n        },\n)\n"} "preamble" "" "nested" #{}}} {"id" "ul_tours" "properties" {"children" #{#afield/box "ul_lines" #afield/box "ul_arcs"} "parents" #{#afield/box "root"} "name" "6 - uncrossed paths into the workshop views" "_tombstone" false "frame" #afield/rect [60.0 2000.0 300.0 100.0] "code" #afield/file-inline {"path" "ul_tours_code_.kt" "inline" "import afield.geometry.leaper.*\nimport afield.runtime.execution.begin\nimport kotlin.math.*\nimport kotlin.random.Random\n\n// Longest uncrossed knight paths and the longest closed one on 7×7, published under the knight-tour workshop's\n// property names, so the workshop's line and arc views connected below draw them unchanged.\nval w = 7\nval cell = 10.0\nval board = LeaperBoard(w, w)\n/*\nRow 1: four 24-move paths (the proved maximum) of different shapes, not turns or reflections of\none another: the first four distinct results from seeds 1, 2, 3, ..., each search stopping at its\nfirst 24-move path. Row 2: the 24-move closed path, with its first square repeated at the end\nso the closing move is drawn. Forty seeds find just one shape of it.\n*/\nval paths =\n    generateSequence(1) { it + 1 }\n        .map { seed -> board.longestUncrossedPath(random = Random(seed), atLeast = 23, stopAt = 24).best!! }\n        .distinctBy { it.shapeKey() }\n        .take(4)\n        .toList()\nval cycle = board.longestUncrossedPath(closed = true, random = Random(1), atLeast = 23, stopAt = 24).best!!\nval rows = [paths.map { it.cells }, [cycle.cells + cycle.cells[0]]]\n\n// Sample the circumcircle A -> B -> C, choosing the sweep that passes through B.\n// Split at B so all three original points occur exactly in the sampled stroke.\nfun threePointArc(\n    a: Pair<Double, Double>,\n    b: Pair<Double, Double>,\n    c: Pair<Double, Double>,\n): List<Pair<Double, Double>> {\n    val (ax, ay) = a\n    val bx = b.first - ax\n    val by = b.second - ay\n    val cx = c.first - ax\n    val cy = c.second - ay\n    val cross = bx * cy - by * cx\n    if (abs(cross) < 1e-9) return listOf(a, b, c)\n    val bb = bx * bx + by * by\n    val cc = cx * cx + cy * cy\n    val ux = (bb * cy - cc * by) / (2 * cross)\n    val uy = (bx * cc - cx * bb) / (2 * cross)\n    val radius = hypot(ux, uy)\n    val start = atan2(-uy, -ux)\n    val middle = atan2(by - uy, bx - ux)\n    val end = atan2(cy - uy, cx - ux)\n    val tau = 2 * PI\n    fun positive(angle: Double) = ((angle % tau) + tau) % tau\n    val toMiddle = positive(middle - start)\n    val toEnd = positive(end - start)\n    val sweep = if (toMiddle <= toEnd) toEnd else toEnd - tau\n    val firstSweep = if (sweep > 0) toMiddle else toMiddle - tau\n    val result = mutableListOf(a)\n    fun segment(angle: Double, delta: Double, endpoint: Pair<Double, Double>) {\n        val steps = max(1, ceil(abs(delta) / (PI / 48)).toInt())\n        for (j in 1 until steps) {\n            val theta = angle + delta * j / steps\n            result.add((ax + ux + radius * cos(theta)) to (ay + uy + radius * sin(theta)))\n        }\n        result.add(endpoint)\n    }\n    segment(start, firstSweep, b)\n    segment(middle, sweep - firstSweep, c)\n    return result\n}\n\nval arcRows = rows.map { row ->\n    row.map { tour ->\n        val points = tour.map { i -> ((i % w + 0.5) * cell) to ((i / w + 0.5) * cell) }\n        points.windowed(3).map { q -> threePointArc(q[0], q[1], q[2]) }\n    }\n}\nprop<List<List<IntArray>>>(knightTourRows) = rows\nprop<List<List<List<List<Pair<Double, Double>>>>>>(knightArcRows) = arcRows\nprop<Int>(knightBoardWidth) = w\nprop<Int>(knightBoardHeight) = w\nprop<Double>(knightCellSize) = cell\n\nval gap = 12.0\nval tiles =\n    [paths, [cycle]].flatMapIndexed { r, row ->\n        row.flatMapIndexed { c, path -> path.uncrossedTile(cell, c * (w * cell + gap), r * (w * cell + gap)) }\n    }\nlines(tiles, fitToSize = true)\nprintln(\"Published ${paths.size} differently shaped 24-move paths and the 24-move closed path on 7×7.\")\nchildren.forEach { it.begin() }\n"} "preamble" "var Box.knightTourRows by Inheritance<List<List<IntArray>>>() /**/\nval Once.knightTourRows by Onceing<List<List<IntArray>>>() /**/\nval Why.knightTourRows by Whying() /**/\nvar Box.knightArcRows by Inheritance<List<List<List<List<Pair<Double, Double>>>>>>() /**/\nval Once.knightArcRows by Onceing<List<List<List<List<Pair<Double, Double>>>>>>() /**/\nval Why.knightArcRows by Whying() /**/\nvar Box.knightBoardWidth by Inheritance<Int>() /**/\nval Once.knightBoardWidth by Onceing<Int>() /**/\nval Why.knightBoardWidth by Whying() /**/\nvar Box.knightBoardHeight by Inheritance<Int>() /**/\nval Once.knightBoardHeight by Onceing<Int>() /**/\nval Why.knightBoardHeight by Whying() /**/\nvar Box.knightCellSize by Inheritance<Double>() /**/\nval Once.knightCellSize by Onceing<Double>() /**/\nval Why.knightCellSize by Whying() /**/" "nested" #{}}} {"id" "ul_plotter" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "7 - a pen-plotter sheet" "_tombstone" false "frame" #afield/rect [60.0 2900.0 300.0 100.0] "code" #afield/file-inline {"path" "ul_plotter_code_.kt" "inline" "import afield.geometry.leaper.*\n\n// A plotter sheet: the longest uncrossed knight paths on a 6×6 rectangle, cylinder and torus,\n// with their labels, as stroke-only SVG (board squares left out, the joined edges kept as dashes).\nval n = 6\nval cell = 10.0\nval sheet = ArrayList<FLine>()\nBoardTopology.entries.forEachIndexed { c, t ->\n    val board = LeaperBoard(n, n, Leaper.KNIGHT, t)\n    val r = board.bestUncrossedPath(nodeBudget = 1_000_000)\n    val x = c * (n * cell + 20.0)\n    sheet += board.boardLines(cell, x, 0.0)\n    sheet += r.best!!.pathLine(cell, x, 0.0)\n    sheet += leaperLabel(\"${t.name.lowercase()}  ${r.length}${if (r.exhaustive) \"\" else \"?\"}\", x, n * cell + 10.0, 5.0)\n}\nval svg = plotterSvg(sheet, widthMm = 297.0, heightMm = 120.0, marginMm = 12.0)\nval file = java.io.File(System.getProperty(\"java.io.tmpdir\"), \"uncrossed_knights.svg\")\nfile.writeText(svg)\ndisplay(\"plotter sheet\", svg)\nprintln(\"${svg.lines().count { it.startsWith(\"<path\") }} pen paths, ${svg.length} bytes -> $file\")\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "ul_knight" #afield/box "ul_big" #afield/box "ul_cycles" #afield/box "ul_gallery" #afield/box "ul_sweep" #afield/box "ul_tours" #afield/box "ul_lines" #afield/box "ul_arcs" #afield/box "ul_plotter" #afield/box "ul_draw"} "parents" #{} "name" "root" "nested" #{} "drawing" "{\"type\":\"excalidraw\",\"version\":2,\"source\":\"field\",\"appState\":{\"viewBackgroundColor\":\"transparent\",\"gridSize\":null},\"files\":{},\"elements\":[{\"id\":\"ul_draw~board~0\",\"type\":\"rectangle\",\"x\":1120.0,\"y\":2900.0,\"width\":40.0,\"height\":40.0,\"angle\":0,\"strokeColor\":\"transparent\",\"backgroundColor\":\"#000b2a\",\"fillStyle\":\"solid\",\"strokeWidth\":1.0,\"strokeStyle\":\"solid\",\"roughness\":0.0,\"opacity\":100.0,\"groupIds\":[],\"frameId\":null,\"roundness\":null,\"seed\":867916667,\"isDeleted\":false,\"boundElements\":[],\"link\":null,\"locked\":false,\"customData\":{\"fieldOwner\":\"ul_draw\",\"fieldKey\":\"board\",\"fieldStroke\":\"transparent\",\"fieldFill\":\"#dbe4ff\"},\"version\":1,\"versionNonce\":1104422796,\"updated\":1794174625187},{\"id\":\"ul_draw~board~1\",\"type\":\"rectangle\",\"x\":1120.0,\"y\":2980.0,\"width\":40.0,\"height\":40.0,\"angle\":0,\"strokeColor\":\"transparent\",\"backgroundColor\":\"#000b2a\",\"fillStyle\":\"solid\",\"strokeWidth\":1.0,\"strokeStyle\":\"solid\",\"roughness\":0.0,\"opacity\":100.0,\"groupIds\":[],\"frameId\":null,\"roundness\":null,\"seed\":867916666,\"isDeleted\":false,\"boundElements\":[],\"link\":null,\"locked\":false,\"customData\":{\"fieldOwner\":\"ul_draw\",\"fieldKey\":\"board\",\"fieldStroke\":\"transparent\",\"fieldFill\":\"