{"version" 2 "boxes" [{"id" "fieldml-macromod-live" "properties" {"children" #{} "parents" #{#afield/box "fieldml-macromod-root"} "name" "the live parameter" "frame" #afield/rect [520.0 740.0 520.0 300.0] "code" #afield/file-inline {"path" "fieldml-macromod-live_code_.kt" "inline" "// THE LIVE PARAMETER. Run this while the scene above is spinning.\n//\n// `setRootProp` puts the slot on the *document root*, so every box in the document\n// shares the one value -- which is how a sibling box reaches the scene's `eachFrame`\n// body. That body reads it every frame, so the speed of a running Vulkan scene\n// changes without the scene box being re-run, re-compiled, or touched.\n//\n// Change the number and run this box again. Nothing else moves.\nlet _ = setRootProp \"spinRate\" 0.30\n\n{\n  spinRate = rootProp \"spinRate\" |> hostAsFloat\n  // ...and proof the loop is running: the scene box writes its frame number into a\n  // shared slot every frame, and this reads it. Run this box twice; the number grows.\n  framesDrawn = propOr \"framesDrawn\" 0 |> hostAsInt\n}"} "nested" #{} "customization" #afield/file-inline {"path" "fieldml-macromod-live_customization_.js" "inline" "const title = this.querySelector('.box-title-stack') || this;\nlet label = this.querySelector('[data-afield-language-label=\"true\"]');\nif (!label) {\n    label = document.createElement('div');\n    label.setAttribute('data-afield-language-label', 'true');\n    title.appendChild(label);\n}\nlabel.textContent = \"fieldml\";\nlabel.style.fontSize = \"9px\";\nlabel.style.lineHeight = \"1.1\";\nlabel.style.opacity = \"0.58\";\nlabel.style.fontWeight = \"500\";\nlabel.style.letterSpacing = \"0\";\nlabel.style.textTransform = \"none\";\nlabel.style.pointerEvents = \"none\";\nlabel.style.userSelect = \"none\";\nlabel.style.marginTop = \"1px\";\nthis.style.margin = \"\";"} "code_language" "fieldml" "preamble" "" "autorun" false}} {"id" "fieldml-macromod-root" "properties" {"children" #{#afield/box "fieldml-macromod-scene" #afield/box "fieldml-macromod-live"} "parents" #{#afield/box "root" #afield/box "fieldml-macromod-renderer"} "name" "FieldML — a scene built by a source macro" "frame" #afield/rect [40.0 360.0 420.0 90.0] "mainLanguage" "fieldml" "isFieldMLRoot" true "nested" #{} "preamble" "" "autorun" false}} {"id" "fieldml-macromod-scene" "properties" {"children" #{} "parents" #{#afield/box "fieldml-macromod-root"} "name" "moduleHere, from FieldML" "frame" #afield/rect [520.0 40.0 520.0 640.0] "code" #afield/file-inline {"path" "fieldml-macromod-scene_code_.kt" "inline" "// A WHOLE FIELD 4 SCENE BUILT BY A SOURCE MACRO, FROM FIELDML.\n//\n// The still-life and the moving demos next door hand-build their pipeline:\n// `parameters(renderer) { vertex = ...; fragment = ... }`, then `Module(params)`,\n// then `.pointer()`. This box does not. It calls Field's `moduleHere` -- the macro\n// a Kotlin graphics box actually uses -- which means the GLSL lives in this box's\n// own `vertex` and `fragment` properties, exactly where a Kotlin box keeps it, with\n// this box's include resolvers, source names and shader-error reporting attached.\n//\n// Mechanism A of dev_docs/FIELDML_HOST_BRIDGE.md. There is no hostAs anywhere here.\nlet ModuleKt = hostClass \"afield.graphics.render.ModuleKt\"\nlet Phased = hostClass \"afield.runtime.lifecycle.PhasedKt\"\nlet Pair = hostClass \"kotlin.Pair\"\n\nlet renderer = prop \"renderer\"\n\n// The shaders go into the box's properties, because that is what `moduleHere`\n// expands against: its expansion preprocesses and compiles both stages from these\n// and assigns the prepared result back onto the box.\nlet write name value = thisBox |> hostCall \"setPropertyRaw\" (name, value, false)\n\nlet _ = write \"vertex\" \"#version 450\\nlayout(push_constant) uniform Push { vec4 spin; } push;\\nvec2 verts[3] = vec2[3](vec2(-0.7,-0.6), vec2(0.7,-0.6), vec2(0.0,0.7));\\nvoid main() {\\n  vec2 p = verts[gl_VertexIndex];\\n  float c = cos(push.spin.x);\\n  float s = sin(push.spin.x);\\n  gl_Position = vec4(c*p.x - s*p.y, s*p.x + c*p.y, 0.0, 1.0);\\n}\"\nlet _ = write \"fragment\" \"#version 450\\nlayout(push_constant) uniform Push { vec4 spin; } push;\\nlayout(location = 0) out vec4 o;\\nvoid main() { o = vec4(0.5 + 0.5*cos(push.spin.x + vec3(0.0, 2.1, 4.2)), 1.0); }\"\n\nlet params = hostStaticCall \"parameters\" (renderer, fun p -> p |> hostSet \"name\" \"fieldmlMacroSpin\") ModuleKt\n\n// THE LINE THIS DEMO IS ABOUT. `moduleHere` is a source macro: it rewrites its call\n// site to `_moduleHere(...)` and does its real work while expanding. `hostMacro` runs\n// the expansion -- which compiles both stages above -- and then calls the `Box`\n// extension the rewrite names. A ModulePointer comes back, already this box's `_shader`.\nlet pointer = hostMacro \"moduleHere\" \"(params)\" (params)\n\nlet module = pointer |> hostGet \"current\"\nlet mesh = hostNew (renderer, pointer) (hostClass \"afield.graphics.render.Mesh\")\nlet _ = pointer |> hostCall1 \"plusAssign\" (hostNew (\"tri\", mesh) Pair)\nlet _ = mesh |> hostCall \"resize\" (3, 0, pointer)\nlet target = renderer |> hostCall1 \"renderTargetFor\" 0\nlet _ = target |> hostCall1 \"plusAssign_mp\" pointer\n\nlet spin = hostNew (0.0, 0.0, 0.0, 0.0) (hostClass \"afield.math.linalg.Vector4f\")\nlet _ = mesh |> hostGet \"push\" |> hostCall \"set\" (\"spin\", spin)\n\nlet animation =\n  hostStaticCall \"eachFrame\" (fun f ->\n    // The rate is read from the shared slot EVERY FRAME, so the box below can change\n    // the speed of a running Vulkan scene without this box being touched.\n    let rate = propOr \"spinRate\" 0.04 |> hostAsFloat in\n    let n = f |> hostGet \"frameNumber\" in\n    let _ = setRootProp \"framesDrawn\" n in\n    let t = (n |> toFloat) * rate in\n    spin |> hostCall \"set\" (t, 0.0, 0.0, 1.0)\n  ) Phased\n\nlet job = thisBox |> hostExt Phased \"launchFrames\" (animation, \"fieldml-macro-spin\", \"frames\", true)\n// A picture of the window in this box's `window` output, 60 frames from now.\nlet _ = thisBox |> hostExt (hostClass \"afield.graphics.vulkan.SnapshotWindowKt\") \"snapshotWindow\" (renderer, 60, \"window\", 640, false)\n\n{\n  builtBy = (hostMacroExpand \"moduleHere\" \"(params)\").call\n  vertices = mesh |> hostGet \"numVert\"\n  pushConstantBytes = module |> hostGet \"pushConstantSize\"\n  spinRate = propOr \"spinRate\" 0.04 |> hostAsFloat\n  animating = show job\n}"} "nested" #{} "preamble" "" "customization" #afield/file-inline {"path" "fieldml-macromod-scene_customization_.js" "inline" "const title = this.querySelector('.box-title-stack') || this;\nlet label = this.querySelector('[data-afield-language-label=\"true\"]');\nif (!label) {\n    label = document.createElement('div');\n    label.setAttribute('data-afield-language-label', 'true');\n    title.appendChild(label);\n}\nlabel.textContent = \"fieldml\";\nlabel.style.fontSize = \"9px\";\nlabel.style.lineHeight = \"1.1\";\nlabel.style.opacity = \"0.58\";\nlabel.style.fontWeight = \"500\";\nlabel.style.letterSpacing = \"0\";\nlabel.style.textTransform = \"none\";\nlabel.style.pointerEvents = \"none\";\nlabel.style.userSelect = \"none\";\nlabel.style.marginTop = \"1px\";\nthis.style.margin = \"\";"} "code_language" "fieldml" "autorun" false "vertex" #afield/file-inline {"path" "fieldml-macromod-scene_vertex_.glsl" "inline" "#version 450\nlayout(push_constant) uniform Push { vec4 spin; } push;\nvec2 verts[3] = vec2[3](vec2(-0.7,-0.6), vec2(0.7,-0.6), vec2(0.0,0.7));\nvoid main() {\n  vec2 p = verts[gl_VertexIndex];\n  float c = cos(push.spin.x);\n  float s = sin(push.spin.x);\n  gl_Position = vec4(c*p.x - s*p.y, s*p.x + c*p.y, 0.0, 1.0);\n}"} "fragment" #afield/file-inline {"path" "fieldml-macromod-scene_fragment_.glsl" "inline" "#version 450\nlayout(push_constant) uniform Push { vec4 spin; } push;\nlayout(location = 0) out vec4 o;\nvoid main() { o = vec4(0.5 + 0.5*cos(push.spin.x + vec3(0.0, 2.1, 4.2)), 1.0); }"}}} {"id" "fieldml-macromod-renderer" "properties" {"children" #{#afield/box "fieldml-macromod-root"} "parents" #{#afield/box "root"} "name" "window and renderer (Kotlin)" "frame" #afield/rect [40.0 40.0 420.0 260.0] "code" #afield/file-inline {"path" "fieldml-macromod-renderer_code_.kt" "inline" "// This Kotlin scaffold runs the suspend Renderer.run loop on the JVM.\n// Its FieldML child builds the scene through moduleHere and the shared renderer property.\nprop<Window>(window)\nprop<Renderer>(renderer)\nonce.renderer {\n    window = Window(\"FieldML - a scene built by moduleHere\")\n    Renderer(window)\n}\nprintln(\"renderer ready - now run the scene box\")\nstart(renderer::run)\n"} "nested" #{} "preamble" "import afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nval Why.window by Whying() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/\nval Why.renderer by Whying() /**/" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "fieldml-macromod-renderer" #afield/box "fieldml-macromod-root" #afield/box "fieldml-macromod-scene" #afield/box "fieldml-macromod-live"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "p