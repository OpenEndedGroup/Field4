{"version" 2 "boxes" [{"id" "fi_cloud" "properties" {"children" #{#afield/box "fi_islands"} "parents" #{#afield/box "root"} "name" "two moons, and a generator" "_tombstone" false "frame" #afield/rect [40.0 40.0 260.0 50.0] "code" #afield/file-inline {"path" "fi_cloud_code_.kt" "inline" "prop<List<Vec3>>(moonTarget)\nprop<List<Vec3>>(moonSamples)\n\n// Two half-moons that interlock without touching: a target in two separate pieces.\nval rnd = java.util.Random(3)\nfun moon(i: Int, upper: Boolean): Vec3 {\n    val a = PI * i / 99.0\n    val jitter = vec(rnd.nextDouble() - 0.5, rnd.nextDouble() - 0.5, 0.0) * 14.0\n    return if (upper) vec(100 * cos(a), 100 * sin(a), 0.0) + jitter\n    else vec(100 - 100 * cos(a), 40 - 100 * sin(a), 0.0) + jitter\n}\nmoonTarget = [true, false].flatMap { upper -> (0 until 100).map { moon(it, upper) } }\n\n// From a Gaussian to the moons, then 200 points that were never in the training data.\nval field = flowMatch(moonTarget, options = FlowMatchOptions(steps = 6000, seed = 11))\nmoonSamples = field.sample(200, seed = 12)\nprintln(\"${moonSamples.size} generated, chamfer to target ${chamferDistance(moonSamples, moonTarget).f2}\")\n"} "preamble" "var Box.moonTarget by Inheritance<List<Vec3>>() /**/\nval Once.moonTarget by Onceing<List<Vec3>>() /**/\nval Why.moonTarget by Whying() /**/\nvar Box.moonSamples by Inheritance<List<Vec3>>() /**/\nval Once.moonSamples by Onceing<List<Vec3>>() /**/\nval Why.moonSamples by Whying() /**/" "nested" #{}}} {"id" "fi_draw" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "fi_islands"} "name" "drawn by island" "_tombstone" false "frame" #afield/rect [40.0 420.0 260.0 50.0] "code" #afield/file-inline {"path" "fi_draw_code_.kt" "inline" "fun dots(points: List<Vec3>, size: Double, c: Vec4) = fline {\n    points.forEach { moveTo(it) }\n    pointed = true\n    pointSize = size\n    color = c\n}\n\nval island = islandModel.query(\"island(A, L)\").rows.associate { (it[0] as Long).toInt() to it[1] as Long }\nval labels = island.values.toSortedSet().toList()\nval palette = [vec(0.44, 0.83, 0.78, 1.0), vec(0.98, 0.80, 0.35, 1.0), vec(0.6, 0.5, 0.95, 1.0)]\nval strays = islandModel.query(\"stray(A)\").column(\"A\").map { moonSamples[(it as Long).toInt()] }\n\nval byIsland = labels.mapIndexed { k, label ->\n    dots(moonSamples.filterIndexed { i, _ -> island[i] == label }, 1.8, palette[k % palette.size])\n}\nlines(\n    buildList {\n        add(dots(moonTarget, 3.2, vec(0.45, 0.45, 0.52, 0.9)))\n        addAll(byIsland)\n        add(dots(strays, 2.6, vec(0.95, 0.30, 0.30, 1.0)))\n    },\n    w = 900.0,\n    h = 440.0,\n    fitToSize = true,\n)\nprintln(\"drawn: ${labels.size} islands and ${strays.size} strays\")\n"} "preamble" "import afield.data.query.datalog.Datalog\nvar Box.islandModel by Inheritance<Datalog>() /*from:fi_islands*/ /**/\nval Once.islandModel by Onceing<Datalog>() /*from:fi_islands*/ /**/\nval Why.islandModel by Whying() /*from:fi_islands*/ /**/\nvar Box.moonTarget by Inheritance<List<Vec3>>() /*from:fi_cloud*/ /**/\nval Once.moonTarget by Onceing<List<Vec3>>() /*from:fi_cloud*/ /**/\nval Why.moonTarget by Whying() /*from:fi_cloud*/ /**/\nvar Box.moonSamples by Inheritance<List<Vec3>>() /*from:fi_cloud*/ /**/\nval Once.moonSamples by Onceing<List<Vec3>>() /*from:fi_cloud*/ /**/\nval Why.moonSamples by Whying() /*from:fi_cloud*/ /**/" "nested" #{}}} {"id" "fi_islands" "properties" {"children" #{#afield/box "fi_draw"} "parents" #{#afield/box "root" #afield/box "fi_cloud"} "name" "islands, by Datalog" "_tombstone" false "frame" #afield/rect [40.0 120.0 260.0 50.0] "code" #afield/file-inline {"path" "fi_islands_code_.kt" "inline" "import afield.data.query.datalog.Datalog\n\nprop<Datalog>(islandModel)\n\nval rules =\n    \"\"\"\n    #datalog\n    % how many target points lie within 12 units of each generated one\n    support(A, N) :- pt(A, X, Y), N = count : { tgt(_, U, V), hypot(X - U, Y - V) < 12 }.\n    stray(A) :- support(A, 0).\n\n    % join kept points closer than 18, and label each piece by its smallest id\n    near(A, B) :- kept(A), kept(B), pt(A, X, Y), pt(B, U, V), A != B, hypot(X - U, Y - V) < 18.\n    reach(A, A) :- kept(A).\n    reach(A, C) :- reach(A, B), near(B, C).\n    island(A, L) :- kept(A), L = min B : { reach(A, B) }.\n    size(L, N) :- island(_, L), N = count : { island(B, L) }.\n\"\"\"\n\nfun model(keep: String): Datalog {\n    val d = Datalog()\n    d.facts(\"pt\", moonSamples.mapIndexed { i, p -> [i, p.x.toDouble(), p.y.toDouble()] })\n    d.facts(\"tgt\", moonTarget.mapIndexed { i, p -> [i, p.x.toDouble(), p.y.toDouble()] })\n    d.add(rules)\n    d.add(keep)\n    return d\n}\nfun sizes(d: Datalog) = d.query(\"size(L, N)\").rows.map { it[1] as Long }.sortedDescending()\n\nval everything = model(\"kept(A) :- pt(A, _, _).\")\nislandModel = model(\"kept(A) :- pt(A, _, _), !stray(A).\")\n\nval strays = islandModel.query(\"stray(A)\").size\nmarkdown(\n    \"islands\",\n    \"\"\"\n    ~~~\nstrays (no target point within 12)   $strays of ${moonSamples.size}\nevery point                          ${sizes(everything).size} islands, sizes ${sizes(everything)}\nstrays left out                      ${sizes(islandModel).size} islands, sizes ${sizes(islandModel)}\n    ~~~\n\"\"\",\n)\nprintln(\"islands counted: $strays strays\")\n"} "preamble" "import afield.data.query.datalog.Datalog\nvar Box.islandModel by Inheritance<Datalog>() /**/\nval Once.islandModel by Onceing<Datalog>() /**/\nval Why.islandModel by Whying() /**/\nvar Box.moonTarget by Inheritance<List<Vec3>>() /*from:fi_cloud*/ /**/\nval Once.moonTarget by Onceing<List<Vec3>>() /*from:fi_cloud*/ /**/\nval Why.moonTarget by Whying() /*from:fi_cloud*/ /**/\nvar Box.moonSamples by Inheritance<List<Vec3>>() /*from:fi_cloud*/ /**/\nval Once.moonSamples by Onceing<List<Vec3>>() /*from:fi_cloud*/ /**/\nval Why.moonSamples by Whying() /*from:fi_cloud*/ /**/" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "fi_cloud" #afield/box "fi_islands" #afield/box "fi_draw"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}