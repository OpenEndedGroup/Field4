{"version" 2 "boxes" [{"id" "path_trace_hidden_environment" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "path_trace_renderer"} "name" "environment lighting without a visible sky" "_tombstone" false "frame" #afield/rect [320.0 180.0 350.0 120.0] "code" #afield/file-inline {"path" "path_trace_hidden_environment_code_.kt" "inline" "import afield.graphics.scene.fabricated.*\nimport afield.graphics.vulkan.util.Camera\n\nprop<PathTracingRenderer>(tracer)\nval scene = PathTraceScene()\n// Colours are linear RGB; the sphere materials end with roughness.\nval floor = scene.material(PathTraceMaterial.diffuse(0.48f, 0.48f, 0.48f))\nval red = scene.material(PathTraceMaterial.plastic(0.65f, 0.055f, 0.025f, 0.22f))\nval gold = scene.material(PathTraceMaterial.metal(0.95f, 0.7f, 0.3f, 0.12f))\nval rough = scene.material(PathTraceMaterial.metal(0.55f, 0.65f, 0.8f, 0.55f))\n// A floor and three independently editable spheres.\nscene.quad(Vector3f(-15f, 0f, -15f), Vector3f(-15f, 0f, 15f), Vector3f(15f, 0f, 15f), Vector3f(15f, 0f, -15f), floor)\nscene.sphere(Vector3f(-1.7f, 0.8f, 0f), 0.8f, red, 48, 24)\nscene.sphere(Vector3f(0f, 0.8f, 0f), 0.8f, gold, 48, 24)\nscene.sphere(Vector3f(1.7f, 0.8f, 0f), 0.8f, rough, 48, 24)\nval camera = Camera(renderer).also {\n    it.at.set(3.5f, 2.4f, 7.5f)\n    it.target.set(0f, 0.65f, 0f)\n    it.p.fov = 0.62\n}\n\nval environment = PathTraceEnvironment.fromFile(\"public/docs/assets/fabricate_demo/venice_sunset_1k.exr\")\ntracer = PathTracingRenderer(\n    renderer,\n    scene,\n    environment,\n    width = 1280,\n    height = 720,\n    camera = camera,\n).install()\ntracer.samplesPerFrame = 1\ntracer.maxBounces = 5\ntracer.indirectClamp = 10f // Optional biased suppression of indirect fireflies.\ntracer.exposure = 1.5f\nprintln(\"${tracer.backend}: ${tracer.triangleCount} triangles, ${tracer.width} x ${tracer.height}\")\ntracer.showEnvironment = false\ntracer.blitToScreen()\n// This coroutine only announces capture readiness; the named scene owns the tracer.\nframes {\n    while (tracer.samples < 1024) {\n        frame()\n    }\n    println(\"hidden environment study converged: ${tracer.samples} samples\")\n}\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "path_trace_renderer" "properties" {"children" #{#afield/box "path_trace_hidden_environment"} "parents" #{#afield/box "root"} "name" "path tracing renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 320.0 110.0] "code" #afield/file-inline {"path" "path_trace_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nonce.renderer {\n    window = Window(\"Field · Path tracing\")\n    Renderer(window)\n}\nstart(renderer::run)\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "path_trace_hidden_environment" #afield/box "path_trace_renderer"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_sus