{"version" 2 "boxes" [{"id" "flow_lenia_collision" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 — Rings meet a cell (SAMPLED mixing)" "_tombstone" false "frame" #afield/rect [60.0 240.0 420.0 100.0] "code" #afield/file-inline {"path" "flow_lenia_collision_code_.kt" "inline" "val world = flowLeniaWorld(\n    96,\n    64,\n    [FlowLeniaPresets.rings(), FlowLeniaPresets.cell()],\n    positions = [38.0 to 32.0, 58.0 to 32.0],\n    mixing = FlowLeniaMixing.SAMPLED,\n)\n\nanimateEvolution(\n    world,\n    totalSteps = 1200,\n    seconds = 9.0,\n    columns = 2,\n    cellSide = 384,\n    step = { it.step() },\n    panels = { w, n ->\n        [\n            (\"step \" + n) to w.speciesImg().upscaleNearest(4),\n            (\"rings %.0f, cell %.0f\".format(w.speciesMass(0), w.speciesMass(1))) to w.massPlot(384, 256),\n        ]\n    },\n)\n"} "preamble" "" "nested" #{}}} {"id" "flow_lenia_drift" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 — The parameter field blending (MEAN mixing)" "_tombstone" false "frame" #afield/rect [560.0 240.0 420.0 100.0] "code" #afield/file-inline {"path" "flow_lenia_drift_code_.kt" "inline" "val world = flowLeniaWorld(\n    96,\n    64,\n    [FlowLeniaPresets.rings(), FlowLeniaPresets.cell()],\n    positions = [38.0 to 32.0, 58.0 to 32.0],\n)\n\nanimateEvolution(\n    world,\n    totalSteps = 1200,\n    seconds = 9.0,\n    columns = 2,\n    cellSide = 384,\n    step = { it.step() },\n    panels = { w, n ->\n        [\n            (\"step \" + n) to w.speciesImg().upscaleNearest(4),\n            (\"hybrid %.0f of %.0f\".format(w.mixedMass(), w.totalMass())) to\n                w.weightImg(0).colormap(\"viridis\", 0f, 0.4f).upscaleNearest(4),\n        ]\n    },\n)\n"} "preamble" "" "nested" #{}}} {"id" "flow_lenia_species" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 — Flow Lenia: three species, total mass flat" "_tombstone" false "frame" #afield/rect [560.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "flow_lenia_species_code_.kt" "inline" "val world = flowLeniaWorld(96, 96, [FlowLeniaPresets.wanderers(), FlowLeniaPresets.rings(), FlowLeniaPresets.cell()])\n\nanimateEvolution(\n    world,\n    totalSteps = 1200,\n    seconds = 9.0,\n    columns = 2,\n    cellSide = 384,\n    step = { it.step() },\n    panels = { w, n ->\n        [\n            (\"step \" + n) to w.speciesImg().upscaleNearest(4),\n            (\"total mass %.6f\".format(w.totalMass())) to w.massPlot(384, 384),\n        ]\n    },\n)\n"} "preamble" "" "nested" #{}}} {"id" "flow_lenia_conservation" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "0 — Flow Lenia: mass conserved over 200 steps" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "flow_lenia_conservation_code_.kt" "inline" "val world = flowLeniaWorld(\n    64,\n    64,\n    [FlowLeniaPresets.wanderers(), FlowLeniaPresets.rings(), FlowLeniaPresets.cell()],\n    seedRadius = 10.0,\n)\nval m0 = world.totalMass()\nvar worst = 0.0\nrepeat(200) {\n    world.step()\n    worst = maxOf(worst, kotlin.math.abs(world.totalMass() - m0) / m0)\n}\nprintln(world)\nprintln(\"worst relative change in total mass over 200 steps: \" + worst)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "flow_lenia_conservation" #afield/box "flow_lenia_species" #afield/box "flow_lenia_collision" #afield/box "flow_lenia_drift"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s