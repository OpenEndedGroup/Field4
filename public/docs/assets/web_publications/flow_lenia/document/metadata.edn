{"version" 2 "boxes" [{"id" "flow_lenia_collision" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 — Rings meet a cell (SAMPLED mixing)" "_tombstone" false "frame" #afield/rect [60.0 240.0 420.0 100.0] "code" #afield/file-inline {"path" "flow_lenia_collision_code_.kt" "inline" "val world = flowLeniaWorld(\n    288,\n    192,\n    [FlowLeniaPresets.rings(), FlowLeniaPresets.cell()],\n    positions = [38.0 to 32.0, 58.0 to 32.0],\n    mixing = FlowLeniaMixing.SAMPLED,\n    scale = 3,\n)\n\nanimateEvolution(\n    world,\n    totalSteps = 1200,\n    seconds = 9.0,\n    columns = 2,\n    cellSide = 480,\n    step = { it.step() },\n    panels = { w, n ->\n        [\n            (\"step \" + n) to w.speciesImg().resize(480, 320),\n            (\"rings %.0f, cell %.0f\".format(w.speciesMass(0), w.speciesMass(1))) to w.massPlot(480, 320),\n        ]\n    },\n)\n"} "preamble" "" "nested" #{}}} {"id" "flow_lenia_drift" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 — The parameter field blending (MEAN mixing)" "_tombstone" false "frame" #afield/rect [560.0 240.0 420.0 100.0] "code" #afield/file-inline {"path" "flow_lenia_drift_code_.kt" "inline" "val world = flowLeniaWorld(\n    288,\n    192,\n    [FlowLeniaPresets.rings(), FlowLeniaPresets.cell()],\n    positions = [38.0 to 32.0, 58.0 to 32.0],\n    scale = 3,\n)\n\nanimateEvolution(\n    world,\n    totalSteps = 1200,\n    seconds = 9.0,\n    columns = 2,\n    cellSide = 480,\n    step = { it.step() },\n    panels = { w, n ->\n        [\n            (\"step \" + n) to w.speciesImg().resize(480, 320),\n            (\"hybrid %.0f of %.0f\".format(w.mixedMass(), w.totalMass())) to\n                w.weightImg(0).colormap(\"viridis\", 0f, 0.4f).resize(480, 320),\n        ]\n    },\n)\n"} "preamble" "" "nested" #{}}} {"id" "flow_lenia_species" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 — Flow Lenia: three species, total mass flat" "_tombstone" false "frame" #afield/rect [560.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "flow_lenia_species_code_.kt" "inline" "val world = flowLeniaWorld(\n    288,\n    288,\n    [FlowLeniaPresets.wanderers(), FlowLeniaPresets.rings(), FlowLeniaPresets.cell()],\n    scale = 3,\n)\n\nanimateEvolution(\n    world,\n    totalSteps = 1200,\n    seconds = 9.0,\n    columns = 2,\n    cellSide = 480,\n    step = { it.step() },\n    panels = { w, n ->\n        [\n            (\"step \" + n) to w.speciesImg().resize(480, 480),\n            (\"total mass \" + w.totalMass().f3) to w.massPlot(480, 480),\n        ]\n    },\n)\n"} "preamble" "" "nested" #{}}} {"id" "flow_lenia_conservation" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "0 — Flow Lenia: mass conserved over 200 steps" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "flow_lenia_conservation_code_.kt" "inline" "val world = flowLeniaWorld(\n    64,\n    64,\n    [FlowLeniaPresets.wanderers(), FlowLeniaPresets.rings(), FlowLeniaPresets.cell()],\n    seedRadius = 10.0,\n)\nval m0 = world.totalMass()\nvar worst = 0.0\nrepeat(200) {\n    world.step()\n    worst = maxOf(worst, kotlin.math.abs(world.totalMass() - m0) / m0)\n}\nprintln(world)\nprintln(\"worst relative change in total mass over 200 steps: \" + worst)\n"} "preamble" "" "nested" #{}}} {"id" "flow_lenia_mutation" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5 — Mutation inside the world, against a neutral control" "_tombstone" false "frame" #afield/rect [560.0 420.0 420.0 100.0] "code" #afield/file-inline {"path" "flow_lenia_mutation_code_.kt" "inline" "val species = [FlowLeniaPresets.wanderers(), FlowLeniaPresets.rings(), FlowLeniaPresets.cell()]\nval neutral = flowLeniaWorld(192, 192, species, mixing = FlowLeniaMixing.SAMPLED, scale = 2)\nneutral.mutation = FlowLeniaMutation(rate = 0.05, radius = 12.0, scale = 0.0)\nval mutating = flowLeniaWorld(192, 192, species, mixing = FlowLeniaMixing.SAMPLED, scale = 2)\nmutating.mutation = FlowLeniaMutation(rate = 0.05, radius = 12.0, scale = 0.3)\n\nfun masses(w: FlowLeniaWorld) = w.speciesMasses().joinToString(\" \") { it.f0 }\n\nanimateEvolution(\n    neutral to mutating,\n    totalSteps = 2400,\n    seconds = 9.0,\n    columns = 2,\n    cellSide = 384,\n    step = { (a, b) ->\n        a.step()\n        b.step()\n        a to b\n    },\n    panels = { (a, b), n ->\n        [\n            (\"neutral \" + masses(a)) to vstack(a.lineageImg().resize(384, 384), a.massPlot(384, 128)),\n            (\"size 0.3 \" + masses(b)) to vstack(b.lineageImg().resize(384, 384), b.massPlot(384, 128)),\n        ]\n    },\n)\n"} "preamble" "" "nested" #{}}} {"id" "flow_lenia_crescent" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 — A crescent that travels, at three times the resolution" "_tombstone" false "frame" #afield/rect [60.0 420.0 420.0 100.0] "code" #afield/file-inline {"path" "flow_lenia_crescent_code_.kt" "inline" "// Noise seed 2 folds into the crescent; grow it to three times the resolution once it has formed.\nval world =\n    flowLeniaWorld(64, 64, [FlowLeniaPresets.crescent()], seedRadius = 6.0, randomSeed = 2L).steps(200).scaledCopy(3)\nval trail = FloatArray(world.width * world.height)\n\nanimateEvolution(\n    world,\n    totalSteps = 3000,\n    seconds = 9.0,\n    columns = 2,\n    cellSide = 480,\n    step = { it.step() },\n    panels = { w, n ->\n        val b = w.bodies().first()\n        for (c in trail.indices) trail[c] = maxOf(0.97f * trail[c], w.matter[c].toFloat())\n        [\n            (\"step %d: mass %.1f at (%.0f, %.0f)\".format(n, b.mass, b.x, b.y)) to w.speciesImg().resize(480, 480),\n            \"the path\" to Img(w.width, w.height, 1, trail.copyOf()).colormap(\"magma\", 0f, 1.2f).resize(480, 480),\n        ]\n    },\n)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "flow_lenia_conservation" #afield/box "flow_lenia_species" #afield/box "flow_lenia_collision" #afield/box "flow_lenia_drift" #afield/box "flow_lenia_crescent" #afield/box "flow_lenia_mutation"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}