{"version" 2 "boxes" [{"id" "dm_spread" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "spread" "_tombstone" false "frame" #afield/rect [20.0 1480.0 190.0 60.0] "code" #afield/file-inline {"path" "dm_spread_code_.kt" "inline" "// How big the in-between cloud is (RMS distance from its centre), for both pairings.\nval from = notation.named(\"from\")!!.points.resampleByLength(240, closed = true)\nval to = notation.named(\"to\")!!.points.resampleByLength(240, closed = true)\nval partner = matchPoints(from, to).reorder(to)\nval ts = (0..50).map { it / 50.0 }\nshowSignals(\n    \"matched\" to ts.map { spreadOf(morphBetween(from, partner, it)) },\n    \"by list index\" to ts.map { spreadOf(morphBetween(from, to, it)) },\n    x = ts,\n    title = \"how big the cloud is, through the morph\",\n    xTitle = \"t\",\n    yTitle = \"spread\",\n    channel = \"spread\",\n)\n"} "preamble" "" "nested" #{}}} {"id" "dm_play" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "play" "_tombstone" false "frame" #afield/rect [20.0 1960.0 190.0 60.0] "code" #afield/file-inline {"path" "dm_play_code_.kt" "inline" "// The morph out to the heart and back as 32 notes: MIDI 72 at the circle's size, an\n// octave lower for every halving. Edit the loop to change what you hear.\nval from = notation.named(\"from\")!!.points.resampleByLength(240, closed = true)\nval to = notation.named(\"to\")!!.points.resampleByLength(240, closed = true)\nval voice = patVoice(wave = PatWave.TRIANGLE, decay = 0.004, sustain = 0.6)\nfor ((label, partner) in [\"matched\" to matchPoints(from, to).reorder(to), \"by list index\" to to]) {\n    val notes = mutableListOf<TimedNote>()\n    val spread0 = spreadOf(from)\n    for (k in 0 until 32) {\n        val t = if (k < 16) k / 15.0 else (31 - k) / 15.0 // out to the heart, then back\n        val midi = 72 + 12 * log2(spreadOf(morphBetween(from, partner, t)) / spread0)\n        notes += TimedNote(k * 0.25, k * 0.25 + 0.25, midi)\n    }\n    println(\"$label: lowest note %.2f\".format(notes.minOf { it.note }))\n    showPatAudio(patTimed(notes, beats = 8.0), cycles = 2, cps = 0.25, voice = voice, channel = label)\n}\n"} "preamble" "" "nested" #{}}} {"id" "dm_shapes" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "shapes" "_tombstone" false "frame" #afield/rect [20.0 40.0 190.0 60.0] "code" #afield/file-inline {"path" "dm_shapes_code_.kt" "inline" "// Two strokes, drawn from code into the document's drawing: a circle named \"from\" and a\n// heart named \"to\". Running it again replaces them.\nnotation { morphShapes() }\n/*\nTo morph two strokes you drew yourself (Alt+D, P), delete the line above and use:\n  val mine = notation.strokes.filter { it.handDrawn }.takeLast(2)\n  notation.edit(mine[0]) { name = \"from\" }\n  notation.edit(mine[1]) { name = \"to\" }\n*/\nprintln(notation.strokes.map { \"${it.label}: ${it.points.size} points\" })\n"} "preamble" "" "nested" #{}}} {"id" "dm_paired" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "paired" "_tombstone" false "frame" #afield/rect [20.0 520.0 190.0 60.0] "code" #afield/file-inline {"path" "dm_paired_code_.kt" "inline" "// Read the strokes back, give each 240 evenly spaced points, and pair them.\nval from = notation.named(\"from\")!!.points.resampleByLength(240, closed = true)\nval to = notation.named(\"to\")!!.points.resampleByLength(240, closed = true)\nval match = matchPoints(from, to)\nval partner = match.reorder(to)\nval cx = from.sumOf { it.x.toDouble() } / from.size\nval cy = from.sumOf { it.y.toDouble() } / from.size\nfun chord(a: Vec2, b: Vec2, dx: Double) = FLine().moveTo(a.x + dx, a.y).lineTo(b.x + dx, b.y).also {\n    it.thickness = 0.8\n    it.color = okhsl(atan2(a.y - cy, a.x - cx) * 180 / PI + 360, 0.85, 0.6, 0.9)\n}\n// Left: the matching. Right: point i of one stroke to point i of the other.\nlines(\n    from.indices.map { chord(from[it], partner[it], -220.0) } + from.indices.map { chord(from[it], to[it], 220.0) },\n    w = 760.0,\n    h = 380.0,\n    fitToSize = true,\n)\nval byIndex =\n    from.indices.sumOf { (from[it].x - to[it].x).toDouble().pow(2) + (from[it].y - to[it].y).toDouble().pow(2) }\nprintln(\"squared travel: matched %.0f, by list index %.0f\".format(match.squaredCost, byIndex))\n"} "preamble" "" "nested" #{}}} {"id" "dm_morph" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "morph" "_tombstone" false "frame" #afield/rect [20.0 1000.0 190.0 60.0] "code" #afield/file-inline {"path" "dm_morph_code_.kt" "inline" "// Five steps of the morph: matched on top, by list index below.\nval from = notation.named(\"from\")!!.points.resampleByLength(240, closed = true)\nval to = notation.named(\"to\")!!.points.resampleByLength(240, closed = true)\nval partner = matchPoints(from, to).reorder(to)\nval cx = from.sumOf { it.x.toDouble() } / from.size\nval cy = from.sumOf { it.y.toDouble() } / from.size\nfun dot(p: Vec2, dx: Double, dy: Double, colour: Vec4) =\n    FLine().also { f ->\n        val x = (p.x - cx) * 0.5 + dx\n        val y = (p.y - cy) * 0.5 + dy\n        f.rect(x - 2, y - 2, 4, 4)\n        f.color = colour\n        f.filled = true\n        f.stroked = false\n    }\nval steps = [0.0, 0.25, 0.5, 0.75, 1.0]\nlines(\n    steps.indices.flatMap { s ->\n        morphBetween(from, partner, steps[s]).map { dot(it, s * 200.0, 0.0, vec(0.1, 0.45, 0.85, 1.0)) } +\n            morphBetween(from, to, steps[s]).map { dot(it, s * 200.0, 200.0, vec(0.88, 0.2, 0.2, 1.0)) }\n    },\n    w = 1000.0,\n    h = 400.0,\n    fitToSize = true,\n)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "dm_shapes" #afield/box "dm_paired" #afield/box "dm_morph" #afield/box "dm_spread" #afield/box "dm_play"} "parents" #{} "name" "root" "nested" #{} "drawing" "{\"type\":\"excalidraw\",\"version\":2,\"source\":\"field\",\"appState\":{\"viewBackgroundColor\":\"transparent\",\"gridSize\":null},\"files\":{},\"elements\":[{\