{"version" 2 "boxes" [{"id" "vr_ide_renderer" "properties" {"children" #{#afield/box "vr_ide_panel"} "parents" #{#afield/box "root"} "name" "1 - VR IDE renderer" "_tombstone" false "frame" #afield/rect [60.0 60.0 330.0 100.0] "code" #afield/file-inline {"path" "vr_ide_renderer_code_.kt" "inline" "import afield.graphics.vulkan.targets.OpenXRHmdTarget\nimport afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n// Start with the desktop companion. Connect WiVRn, set true and restart Field for VR.\nval useHeadset = false\nOptions.enableVR = useHeadset\nOptions.enableHDR = false\nonce.renderer {\n    window = Window(\"Field · VR IDE\", initialDimensions = Rect(80.0, 80.0, 1440.0, 800.0))\n    val created = Renderer(window)\n    if (useHeadset) created.openXRHmdTarget = OpenXRHmdTarget(created)\n    created\n}\nrenderer.render()\ndisplay(\n    \"guide\",\n    \"\"\"\n    <div style=\"width:420px;font:16px/1.6 system-ui\">\n    <b>Field in your headset</b><br>\n    Launch 1, then 2. The browser opens this same document.<br>\n    Point with either controller; trigger or A/X clicks, stick scrolls in both axes.<br>\n    Aim at the panel and hold grip to move and rotate it; release to leave it there.<br>\n    Hold both grips and spread your hands to resize the panel.<br>\n    With tracked hands, point the hand and pinch to click.<br>\n    Keyboard opens text and editing keys; Commands opens the palette.<br>\n    Select the Playground, edit its code, then Run box (Alt+Up).<br>\n    The bottom toolbar Recenter button brings the panel in front of you and keeps its size.<br>\n    The desktop companion accepts normal keyboard and mouse input when focused.<br>\n    Quest keyboard and mouse use WiVRn HID forwarding after setup; see the saved guide.<br>\n    Another browser can edit this same document with its own input focus.<br>\n    Stop box 2 to close the browser. Restart Field to switch VR mode or eye size.\n    </div>\n    \"\"\"\n        .trimIndent(),\n)\ndisplayOpen(\"guide\")\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "vr_ide_panel" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "vr_ide_renderer"} "name" "2 - Live IDE in VR" "_tombstone" false "frame" #afield/rect [580.0 60.0 350.0 100.0] "code" #afield/file-inline {"path" "vr_ide_panel_code_.kt" "inline" "import afield.media.browser.FieldUiBrowserTexture\nimport afield.media.browser.FieldVrWorkspace\nimport afield.media.browser.PuppetBrowser\n\nprop<PuppetBrowser>(browserControl)\nval ownedRenderer = renderer\nval vr = FieldVrWorkspace(\n    renderer = ownedRenderer,\n    url = FieldUiBrowserTexture.fieldDocumentUrl(thisBox),\n    width = 1600,\n    height = 1000,\n    readyBoxUid = thisBox.id,\n    widthMeters = 2.0f,\n    distanceMeters = 1.35f,\n)\nbrowserControl = vr.browser\nprintln(\"Live IDE: ${vr.url}; ${vr.stereo.eyeWidth} × ${vr.stereo.eyeHeight} per eye\")\n// Capture the renderer before entering the asynchronous scope.\nloop {\n    ownedRenderer.window.pollEvents()\n    ownedRenderer.render()\n    frame()\n}\n    .end { vr.close() }\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "vr_ide_playground" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Playground - edit and run from VR" "_tombstone" false "frame" #afield/rect [580.0 300.0 350.0 100.0] "code" #afield/file-inline {"path" "vr_ide_playground_code_.kt" "inline" "// Select this box, open its editor, change the colour or message, then Run box (Alt+Up).\nval colour = \"#237bc2\"\ndisplay(\n    \"hello\",\n    \"\"\"\n    <div style=\"width:320px;padding:24px;background:$colour;color:white;font:24px system-ui\">\n    Hello from inside Field VR!\n    </div>\n\"\"\"\n        .trimIndent(),\n)\ndisplayOpen(\"hello\")\nprintln(\"Code executed in the same Field document\")\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "vr_ide_renderer" #afield/box "vr_ide_panel" #afield/box "vr_ide_playground"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}