{"version" 2 "boxes" [{"id" "simulation_owner" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1. Simulation — launch / stop" "_tombstone" false "frame" #afield/rect [80.0 100.0 360.0 115.0] "code" #afield/file-inline {"path" "simulation_owner_code_.kt" "inline" "import kotlinx.coroutines.*\n\n// Use the ordinary box launch/stop controls. No simulation service is left running.\n// Exported for the replay assertion after Stop has cleaned up both children.\nprop<Int>(simulationCleanup)\nval runId = System.nanoTime()\nvar phase = 0.0\nvar pulse = 0.0\nvar checksum = 0.0\nvar childrenStopped = 0\nval reuse = true\nvar points = Array(2048) { vec(0f, 0f, 0f) }\nframes {\n    val budget = frameProfile(\"Playground\", targetFps = 60.0, allocationKiB = 128.0)\n    try {\n        withSimulationClock {\n            // Both waits use simulation time: sleep takes seconds, delay takes milliseconds.\n            launch(CoroutineName(\"Orbit\")) {\n                try {\n                    while (isActive) {\n                        phase += 0.045\n                        sleep(stepSeconds)\n                    }\n                } finally {\n                    childrenStopped++\n                }\n            }\n            launch(CoroutineName(\"Pulse\")) {\n                try {\n                    while (isActive) {\n                        pulse = 1.0\n                        delay(120)\n                        pulse = 0.0\n                        delay(350)\n                    }\n                } finally {\n                    childrenStopped++\n                }\n            }\n            runCurrent()\n            var last = AnimationClock.nowSeconds()\n            while (frame()) {\n                budget.beginFrame()\n                val now = AnimationClock.nowSeconds()\n                budget.measure(\"Simulation\") { advance((now - last).coerceAtLeast(0.0)) }\n                last = now\n                // Profiling workload: compare updating existing vectors with allocating new ones.\n                // The sine loop adds deliberate CPU work so the budget is easy to inspect.\n                budget.measure(\"Vectors\") {\n                    if (reuse) for (i in points.indices) points[i].set(i.toFloat(), phase.toFloat(), 0f)\n                    else points = Array(points.size) { vec(it.toFloat(), phase.toFloat(), 0f) }\n                    repeat(12000) { checksum += kotlin.math.sin(it.toDouble()) }\n                }\n                val x = 200 + 110 * kotlin.math.cos(phase)\n                val y = 125 + 70 * kotlin.math.sin(phase)\n                display(\n                    \"main\",\n                    \"\"\"\n                    <svg id=\"simulation-clock-view\" data-run=\"$runId\" data-time=\"$time\"\n                         width=\"420\" height=\"270\" viewBox=\"0 0 420 270\" style=\"background:black\">\n                      <ellipse cx=\"200\" cy=\"125\" rx=\"110\" ry=\"70\" fill=\"none\" stroke=\"#444\"/>\n                      <circle cx=\"$x\" cy=\"$y\" r=\"12\" fill=\"#48c9ff\"/>\n                      <circle cx=\"200\" cy=\"125\" r=\"${8+18*pulse}\" fill=\"#ddd\"/>\n                      <text x=\"20\" y=\"250\" fill=\"#aaa\" font-family=\"Iosevka,monospace\">\n                        simulation ${time.f2} s · ${pendingTimers} timers\n                      </text>\n                    </svg>\n                    \"\"\",\n                )\n            }\n        }\n    } finally {\n        budget.close()\n        display(\n            \"status\",\n            \"\"\"<div id=\"simulation-clock-status\" data-run=\"$runId\">$childrenStopped children cleaned up</div>\"\"\",\n        )\n        simulationCleanup = childrenStopped\n        println(\"SIMULATION_STOPPED: $childrenStopped children cleaned up\")\n    }\n}\n"} "preamble" "var Box.simulationCleanup by Inheritance<Int>() /**/\nval Once.simulationCleanup by Onceing<Int>() /**/\nval Why.simulationCleanup by Whying() /**/" "nested" #{}}} {"id" "simulation_capture" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2. Record and explore" "_tombstone" false "frame" #afield/rect [550.0 100.0 360.0 115.0] "code" #afield/file-inline {"path" "simulation_capture_code_.kt" "inline" "CoroutineProfiles.request(thisBox.inside.filename, CoroutineProfileRequest(\"start\", 3.0, stacks = true))\nthisBox.inBrowser(\"window.showProfilingTimeline(); document.getElementById('profile-tab-frames').click()\")\nprintln(\"Recording frames, scopes and named simulation coroutines\")\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "simulation_owner" #afield/box "simulation_capture"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet" "level" "lootRule" "lootFixtures"]}