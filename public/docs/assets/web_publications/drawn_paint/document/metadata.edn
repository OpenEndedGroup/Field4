{"version" 2 "boxes" [{"id" "dp_pencil" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "pencil" "_tombstone" false "frame" #afield/rect [1750.0 4200.0 190.0 60.0] "code" #afield/file-inline {"path" "dp_pencil_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n    // The strokes from `strokes` in a 6B pencil, on a 20 cm sheet, its pressure following the pen.\n    val region = Rect(40.0, 40.0, 1040.0, 400.0)\n    val canvas = PaintCanvas(900, aspect = 3.0, view = Rect(40.0, 40.0, 1040.0, 347.0), sizeMm = 200.0)\n    val pencil = canvas.pencil(\"6B\")\n    for (s in notation.strokes.filter { it.bounds.intersects(region) }) canvas.draw(\n        s.toFLine(),\n        pencil,\n        pressure = s.pressuresAlong(32).ifEmpty { [0.6] },\n    )\n    display(\"main\", canvas.png())\n}\n"} "preamble" "" "nested" #{}}} {"id" "dp_strokes" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "strokes" "_tombstone" false "frame" #afield/rect [1750.0 40.0 190.0 60.0] "code" #afield/file-inline {"path" "dp_strokes_code_.kt" "inline" "// Three pen strokes, drawn from code into the document's drawing, each with a pen pressure\n// (0..1) as a function of how far along the stroke the pen is. Running it again replaces them.\nnotation {\n    stroke(\n        FLine().moveTo(80, 300).cubicTo(200, 60, 330, 420, 420, 140),\n        name = \"S\",\n        pressure = { 0.15 + 0.85 * sin(PI * it) },\n    )\n    stroke(\n        FLine().moveTo(470, 110).cubicTo(560, 300, 700, 330, 820, 180),\n        name = \"sweep\",\n        pressure = { 1.0 - 0.85 * it },\n    )\n    stroke(\n        FLine().moveTo(880, 330).cubicTo(1060, 300, 1020, 60, 900, 120).cubicTo(820, 160, 880, 260, 960, 250),\n        name = \"loop\",\n        pressure = { 0.15 + 0.85 * it * it },\n    )\n}\n// Read back every stroke in this part of the drawing, with its pressure at 50 evenly spaced points.\nval strokes = notation.strokes.filter { it.bounds.intersects(Rect(40.0, 40.0, 1040.0, 400.0)) }\nshowSignals(\n    *strokes.map { (it.label ?: it.id) to it.pressuresAlong(50) }.toTypedArray(),\n    x = (0 until 50).map { it / 49.0 },\n    title = \"pen pressure along each stroke\",\n    xTitle = \"fraction of the way along\",\n    yTitle = \"pressure\",\n    channel = \"pressure\",\n)\nmarkdown(\n    \"table\",\n    \"| stroke | points | lightest | heaviest |\\n|---|---|---|---|\\n\" +\n        strokes.joinToString(\"\\n\") {\n            \"| ${it.label ?: \"drawn\"} | ${it.points.size} | %.2f | %.2f |\"\n                .format(it.pressures.minOrNull() ?: 0.0, it.pressures.maxOrNull() ?: 0.0)\n        },\n    width = 380,\n)\n"} "preamble" "" "nested" #{}}} {"id" "dp_paint" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "paint" "_tombstone" false "frame" #afield/rect [1750.0 900.0 190.0 60.0] "code" #afield/file-inline {"path" "dp_paint_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n    // Every stroke in the region `strokes` drew in, painted three times, one row each: the brush\n    // pressing as the pen did; the pen's pressure squared, so light strokes go lighter; one even pressure.\n    val region = Rect(40.0, 40.0, 1040.0, 400.0)\n    val strokes = notation.strokes.filter { it.bounds.intersects(region) }\n    val colours = [\n        mapOf(\"ultramarine blue\" to 2.0, \"bone black\" to 0.3),\n        mapOf(\"vermilion\" to 1.0),\n        mapOf(\"viridian\" to 1.0, \"chrome yellow\" to 0.6),\n    ]\n    val canvas = PaintCanvas(900, aspect = 0.9, view = Rect(40.0, 40.0, 1000.0, 1110.0))\n    val brush = canvas.brush(BrushKind.Round, width = 70.0)\n    fun lower(s: Mark, dy: Double) = s.toFLine() + vec(0.0, dy)\n    strokes.forEachIndexed { i, s ->\n        val pen = s.pressuresAlong(64)\n        brush.load(colours[i % 3], wipe = 1.0)\n        canvas.stroke(s.toFLine(), brush, pressure = 1.0..1.0, swell = pen)\n        brush.load(colours[i % 3], wipe = 1.0)\n        canvas.stroke(lower(s, 360.0), brush, pressure = 1.0..1.0, swell = pen.map { it * it })\n        brush.load(colours[i % 3], wipe = 1.0)\n        canvas.stroke(lower(s, 720.0), brush, pressure = 0.6..0.6)\n    }\n    display(\"main\", canvas.png())\n}\n"} "preamble" "" "nested" #{}}} {"id" "dp_drying" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "drying" "_tombstone" false "frame" #afield/rect [1750.0 2700.0 190.0 60.0] "code" #afield/file-inline {"path" "dp_drying_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n    // One yellow band, crossed in blue after longer and longer waits.\n    val hours = [0.0, 2.0, 10.0, 33.0, 100.0]\n    notation {\n        stroke(\n            FLine().moveTo(60, 1080).cubicTo(400, 1070, 700, 1090, 1020, 1080),\n            name = \"slow band\",\n            pressure = { 0.85 },\n        )\n        hours.indices.forEach { i ->\n            val x = 150.0 + i * 190\n            stroke(\n                FLine().moveTo(x, 960).lineTo(x + 20, 1200),\n                name = \"after $i\",\n                pressure = { 0.5 + 0.5 * sin(PI * it) },\n            )\n        }\n    }\n    val canvas = PaintCanvas(900, aspect = 3.2, view = Rect(40.0, 940.0, 1000.0, 312.0))\n    fun paint(name: String, brush: PaintBrush) = notation.named(name)!!.let {\n        canvas.stroke(it.toFLine(), brush, pressure = 1.0..1.0, swell = it.pressuresAlong(32), shake = 0.4)\n    }\n    paint(\"slow band\", canvas.brush(BrushKind.HogFlat, width = 80.0).load(mapOf(\"cadmium yellow\" to 1.0)))\n    var waited = 0.0\n    hours.forEachIndexed { i, h ->\n        canvas.wait((h - waited) * 60)\n        waited = h // simulated minutes\n        paint(\"after $i\", canvas.brush(BrushKind.HogFlat, width = 60.0).load(mapOf(\"ultramarine blue\" to 1.0)))\n    }\n    display(\"main\", canvas.png())\n    markdown(\n        \"times\",\n        \"crossed after \" + hours.joinToString(\", \") { \"${it.toInt()} h\" } + \" (left to right)\",\n        width = 500,\n    )\n}\n"} "preamble" "" "nested" #{}}} {"id" "dp_crossings" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "crossings" "_tombstone" false "frame" #afield/rect [1750.0 2100.0 190.0 60.0] "code" #afield/file-inline {"path" "dp_crossings_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n    // Four pairs of bands, yellow over red, each crossed by one vertical stroke.\n    notation {\n        for (k in 0 until 4) {\n            val x = 60.0 + k * 250\n            stroke(\n                FLine().moveTo(x, 560).cubicTo(x + 70, 545, x + 140, 575, x + 210, 560),\n                name = \"yellow $k\",\n                pressure = { 0.8 },\n            )\n            stroke(\n                FLine().moveTo(x, 760).cubicTo(x + 70, 745, x + 140, 775, x + 210, 760),\n                name = \"red $k\",\n                pressure = { 0.8 },\n            )\n            stroke(\n                FLine().moveTo(x + 95, 480).cubicTo(x + 120, 600, x + 90, 720, x + 115, 860),\n                name = \"across $k\",\n                pressure = { 0.5 + 0.5 * sin(PI * it) },\n            )\n        }\n    }\n    val canvas = PaintCanvas(900, aspect = 2.4, view = Rect(40.0, 460.0, 1000.0, 416.0))\n    fun paint(name: String, brush: PaintBrush) = notation.named(name)!!.let {\n        canvas.stroke(it.toFLine(), brush, pressure = 1.0..1.0, swell = it.pressuresAlong(32), shake = 0.5)\n    }\n    val band = canvas.brush(BrushKind.HogFlat, width = 70.0)\n    for (k in 0 until 4) {\n        paint(\"yellow $k\", band.load(mapOf(\"cadmium yellow\" to 1.0), wipe = 1.0))\n        paint(\"red $k\", band.load(mapOf(\"vermilion\" to 1.0), wipe = 1.0))\n    }\n    // 1: blue straight across the wet bands, so the colours mix where they meet\n    paint(\"across 0\", canvas.brush(BrushKind.HogFlat, width = 60.0).load(mapOf(\"ultramarine blue\" to 1.0)))\n    // 3: a clean, dry hog-hair brush dragged through them: no paint of its own, it smears theirs\n    paint(\"across 2\", canvas.brush(BrushKind.HogFlat, width = 60.0))\n    // 4: a clean badger blender, which only softens what is there\n    paint(\"across 3\", canvas.brush(BrushKind.Badger, width = 60.0))\n    // 2: the same blue, after everything has dried\n    canvas.dry()\n    paint(\"across 1\", canvas.brush(BrushKind.HogFlat, width = 60.0).load(mapOf(\"ultramarine blue\" to 1.0)))\n    display(\"main\", canvas.png())\n}\n"} "preamble" "" "nested" #{}}} {"id" "dp_meadow" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "meadow" "_tombstone" false "frame" #afield/rect [1750.0 3200.0 190.0 60.0] "code" #afield/file-inline {"path" "dp_meadow_code_.kt" "inline" "import kotlin.random.Random\n\nrun {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n    // A meadow at evening, from 560 pen strokes on the drawing. The strokes are drawn by code here\n    // (a seeded random hand) into the region below; draw your own there instead and paint those.\n    val region = Rect(40.0, 1460.0, 1600.0, 1000.0)\n    val X = region.x\n    val Y = region.y\n    val rnd = Random(7)\n    fun r(a: Double, b: Double) = rnd.nextDouble(a, b)\n    fun sweep(x: Double, y: Double, w: Double, dy: Double = 0.0) =\n        FLine()\n            .moveTo(X + x, Y + y)\n            .cubicTo(X + x + w * 0.3, Y + y - 20, X + x + w * 0.7, Y + y + 20, X + x + w, Y + y + dy)\n    notation {\n        for (i in 0 until 18) stroke(\n            sweep(r(-160.0, 0.0), 20.0 + i * 26 + r(-6.0, 6.0), 1760.0, r(-10.0, 10.0)), // sky\n            name = \"sky $i\",\n            pressure = { 0.5 + 0.5 * sin(PI * it) },\n        )\n        for (c in 0 until 5) { // clouds\n            val cx = r(150.0, 1350.0)\n            val cy = r(90.0, 300.0)\n            for (k in 0 until 7) stroke(\n                sweep(cx + r(-120.0, 80.0), cy + r(-35.0, 25.0), r(80.0, 220.0), 4.0),\n                name = \"cloud $c.$k\",\n                pressure = { 0.2 + 0.8 * sin(PI * it) },\n            )\n        }\n        for (i in 0 until 5) stroke(\n            sweep(-80.0, 500.0 + i * 10, 1760.0, -40.0), // far hills\n            name = \"hill $i\",\n            pressure = { 0.4 + 0.6 * sin(PI * it) },\n        )\n        for (i in 0 until 22) stroke(\n            sweep(-80.0, 540.0 + i * 22, 1760.0), // the field\n            name = \"field $i\",\n            pressure = { 0.7 + 0.3 * sin(PI * it) },\n        )\n        for (i in 0 until 420) { // grass\n            val y = r(560.0, 1000.0)\n            val d = (y - 540) / 460\n            val x = r(-20.0, 1620.0)\n            val h = r(40.0, 120.0) + 300 * d * d\n            val lean = r(-0.3, 0.5) * h\n            stroke(\n                FLine()\n                    .moveTo(X + x, Y + y)\n                    .cubicTo(\n                        X + x + lean * 0.1,\n                        Y + y - h * 0.5,\n                        X + x + lean * 0.5,\n                        Y + y - h * 0.9,\n                        X + x + lean,\n                        Y + y - h,\n                    ),\n                name = \"grass $i\",\n                pressure = { 1.0 - 0.95 * it },\n            ) // flicked up from the root\n        }\n        for (i in 0 until 60) { // poppies\n            val y = r(570.0, 990.0)\n            val x = r(40.0, 1560.0)\n            val s = 4.0 + 22 * (y - 540) / 460\n            stroke(\n                FLine()\n                    .moveTo(X + x - s, Y + y)\n                    .cubicTo(X + x - s * 0.3, Y + y - s, X + x + s * 0.5, Y + y - s * 0.8, X + x + s, Y + y + s * 0.2),\n                name = \"poppy $i\",\n                pressure = { 0.5 + 0.5 * sin(PI * it) },\n            )\n        }\n    }\n\n    val canvas = PaintCanvas(1200, aspect = 1.6, ground = PaintGround.OilRedGround, view = region)\n    val strokes = notation.strokes.filter { it.bounds.intersects(region) }\n    fun named(p: String) = strokes.filter { it.label?.startsWith(p) == true }\n    fun depth(s: Mark) = ((s.start!!.y - Y - 540) / 460).coerceIn(0.0, 1.0) // 0 at the horizon, 1 at the front\n    fun paint(s: Mark, b: PaintBrush, p: Double = 1.0, shake: Double = 1.0) =\n        canvas.stroke(s.toFLine(), b, pressure = p..p, swell = s.pressuresAlong(32), shake = shake)\n\n    val sky = canvas.brush(BrushKind.Filbert, width = 60.0)\n    named(\"sky\").forEachIndexed { i, s ->\n        val t = i / 17.0 // cobalt at the top, warming to Naples yellow and a little rose at the horizon\n        paint(\n            s,\n            sky.load(\n                mapOf(\n                    \"lead white\" to 3.0,\n                    \"cobalt blue\" to 2.0 * (1 - t) * (1 - t),\n                    \"Naples yellow\" to 2.5 * t * t,\n                    \"rose madder\" to 0.4 * t,\n                ),\n                wipe = 0.5,\n            ),\n        )\n    }\n    val cloud = canvas.brush(BrushKind.HogFlat, width = 34.0)\n    named(\"cloud\").forEach {\n        paint(\n            it,\n            cloud.load(\n                Tubes.mix(mapOf(\"lead white\" to 4.0, \"Naples yellow\" to 0.4, \"rose madder\" to 0.1)),\n                hiding = 0.5,\n                wipe = 0.3,\n            ),\n            shake = 0.8,\n        )\n    }\n    val hill = canvas.brush(BrushKind.HogFlat, width = 26.0)\n    named(\"hill\").forEachIndexed { i, s ->\n        paint(\n            s,\n            hill.load(\n                mapOf(\"lead white\" to 3.0 - i * 0.4, \"cobalt blue\" to 1.0, \"green earth\" to 1.0 + i * 0.4),\n                wipe = 0.6,\n            ),\n        )\n    }\n    val field = canvas.brush(BrushKind.HogFlat, width = 50.0)\n    named(\"field\").forEachIndexed { i, s ->\n        val t = i / 21.0\n        paint(\n            s,\n            field.load(\n                mapOf(\n                    \"green earth\" to 2.0,\n                    \"yellow ochre\" to 2.0 * (1 - t),\n                    \"raw umber\" to 1.5 * t,\n                    \"lead white\" to 1.0 * (1 - t),\n                ),\n                wipe = 0.5,\n            ),\n        )\n    }\n    canvas.wait(40.0) // let the field set a little before the grass goes into it\n    val grass = canvas.brush(BrushKind.Round, width = 10.0)\n    val greens = [\n        mapOf(\"viridian\" to 1.0, \"yellow ochre\" to 1.5),\n        mapOf(\"green earth\" to 2.0, \"chrome yellow\" to 1.0),\n        mapOf(\"viridian\" to 1.0, \"raw umber\" to 1.0),\n        mapOf(\"yellow ochre\" to 2.0, \"lead white\" to 1.0),\n        mapOf(\"Prussian blue\" to 0.2, \"chrome yellow\" to 2.0),\n        mapOf(\"Naples yellow\" to 2.0, \"green earth\" to 1.0),\n    ]\n    named(\"grass\")\n        .sortedBy { it.start!!.y }\n        .forEachIndexed { i, s ->\n            paint(s, grass.load(greens[i % greens.size], wipe = 0.5), 0.4 + 0.6 * depth(s), shake = 0.6)\n        }\n    val poppy = canvas.brush(BrushKind.Filbert, width = 24.0)\n    named(\"poppy\")\n        .sortedBy { it.start!!.y }\n        .forEach { s ->\n            paint(\n                s,\n                poppy.load(mapOf(\"vermilion\" to 3.0, \"cadmium red\" to 1.0, \"lead white\" to 0.2), wipe = 0.9),\n                0.3 + 0.7 * depth(s),\n            )\n        }\n    canvas.dry()\n    canvas.glaze(rgb(0.6, 0.45, 0.2), coats = 0.12) // a thin warm varnish over the whole thing\n    display(\"main\", canvas.png())\n}\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "dp_strokes" #afield/box "dp_paint" #afield/box "dp_crossings" #afield/box "dp_drying" #afield/box "dp_meadow" #afield/box "dp_pencil"} "parents" #{} "name" "root" "nested" #{} "drawing" "{\"type\":\"excalidraw\",\"version\":2,\"source\":\"field\",\"appState\":{