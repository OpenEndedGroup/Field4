{"version" 2 "boxes" [{"id" "analyse" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5 - Analyse what was said" "_tombstone" false "frame" #afield/rect [440.0 230.0 340.0 120.0] "code" #afield/file-inline {"path" "analyse_code_.kt" "inline" "// Analyse what was said: the LPC envelope of the stressed vowel in each word.\nval said = speak(\"Speak, analyse, and plot.\")\nval audio = said.resampled(48_000)\nval curves =\n    said.words.mapNotNull { w ->\n        val v = w.phones.firstOrNull { it.stress == 1 } ?: return@mapNotNull null\n        val mid = ((v.start + v.end) / 2 * 48_000).toInt()\n        \"${w.text} /${v.symbol}/\" to\n            Lpc.analyze(audio.copyOfRange(mid - 1024, mid + 1024), 52).envelopeDb(1025).take(214).toList()\n    }\nshowSignals(\n    *curves.toTypedArray(),\n    x = 214 { it * 48_000.0 / 2048 },\n    channel = \"main\",\n    xTitle = \"frequency (Hz)\",\n    yTitle = \"dB\",\n)\n"} "preamble" "" "nested" #{}}} {"id" "speak" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Speak" "_tombstone" false "frame" #afield/rect [60.0 60.0 340.0 120.0] "code" #afield/file-inline {"path" "speak_code_.kt" "inline" "val said = speak(\"Hello! I am a box in Field, and this is my voice.\")\ndisplayAudioSamples(said.samples, said.sampleRate, label = \"F2: ${said.words.size} words\")\nprint(said.h)\n"} "preamble" "" "nested" #{}}} {"id" "word_timing" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Word timing" "_tombstone" false "frame" #afield/rect [440.0 60.0 340.0 120.0] "code" #afield/file-inline {"path" "word_timing_code_.kt" "inline" "val said = speak(\"Every word arrives with its own start and end.\", voice = \"M2\")\nval hop = 240 // 10 ms at 24 kHz\nval loudness = (said.samples.size / hop) { i -> said.samples.slice(i * hop until (i + 1) * hop).maxOf { abs(it) } }\nshowSignals(\n    \"level\" to loudness,\n    x = loudness.indices.map { it * 0.01 },\n    marks = said.words.map { it.text to it.start },\n    channel = \"main\",\n    xTitle = \"seconds\",\n)\nsaid.words.forEach {\n    println(\"%-8s %.2f s  %s\".format(it.text, it.start, it.phones.joinToString(\" \") { p -> p.symbol }))\n}\n"} "preamble" "" "nested" #{}}} {"id" "sung" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - Sung on a pitch you choose (live)" "_tombstone" false "frame" #afield/rect [60.0 230.0 340.0 120.0] "code" #afield/file-inline {"path" "sung_code_.kt" "inline" "// The speech's envelope on a pulse whose pitch you choose: a sung contour.\nval said = speak(\"I can sing whatever pitch you give me.\", voice = \"M2\")\nval pitch = Param(110f).also { it.mod = SineOsc(0.5.p) * 30f }\nsaid.sungOn(Impulse(pitch)) * 0.5f\n"} "preamble" "" "nested" #{}}} {"id" "words_play_drums" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - Words play the drums" "_tombstone" false "frame" #afield/rect [820.0 60.0 340.0 120.0] "code" #afield/file-inline {"path" "words_play_drums_code_.kt" "inline" "// Stressed words strike a kick, the rest a hat, exactly on the words.\nval said = speak(\"Speech can play the drums, if you let it.\")\nval drums = said.pattern { if (it.stressed) \"bd\" else \"hh\" }\nval dirt = DirtRender.requirePinnedLibrary() // real kick and hat samples, one shot each\nval beat = patRenderStereoDirt(drums, 1, 1 / said.seconds, dirt, sampleRate = 48_000, strict = true).audio.mono\nval voice = said.resampled(48_000)\nval mix = (voice.size) { i -> 0.8f * voice[i] + 0.5f * beat.getOrElse(i) { 0f } }.toFloatArray()\ndisplayAudioSamples(\n    mix,\n    48_000,\n    label = \"words as a pattern: ${drums.events(PatArc(PatQ.ZERO, PatQ.ONE)).map { it.value }}\",\n)\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "speak" #afield/box "word_timing" #afield/box "words_play_drums" #afield/box "sung" #afield/box "analyse"} "parents" #{} "name" "root" "nested" #{}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isPostScriptRoot" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}