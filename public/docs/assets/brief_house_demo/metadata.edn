{:version 2
 :boxes [{:id "brief-house-demo"
          :properties {:name "Brief — change one weight, move the wall"
                       :frame #afield/rect [60.0 60.0 560.0 620.0]
                       :parents #{#afield/box "root"}
                       :children #{}
                       :code "// Brief \u2014 a weighted constraint notation. Change ONE WORD and watch the plan move.\n//\n// The `#brief` region below is a program in a small language (dev_docs/brief_notation.md)\n// that lowers to afield.stdlib.ceres.ConstraintScope and is solved by Ceres. Every\n// statement carries a weight: `whisper` is 1e-3, `prefer` is 1, `insist` is 1e3,\n// `demand` is 1e6. Hard-versus-soft is not a flag here, it is a number, and the solved\n// figure is the weighted least-squares compromise between everything you said.\n//\n// >>> THE THING TO CHANGE: the word `prefer` on the two `at 1/3 along` lines. <<<\n//\n//     prefer  ->  spine wall at x = 119.94   (the insisted 120 nearly wins)\n//     insist  ->  spine wall at x =  90.00   (dead even: (60 + 120) / 2, exactly)\n//     demand  ->  spine wall at x =  60.06   (the proportion nearly wins)\n//\n// Re-run the box after each change. The orange wall moves between the two faint\n// guides \u2014 blue is where the proportion wants it, red is where the length wants it \u2014\n// and the printed residuals move with it.\n//\n// Needs the native Ceres library, once:   ./gradlew buildCeresRedistributable\n\nimport afield.brief.compileBrief\nimport afield.brief.solve\n\nval plan = \"\"\"\n#brief\n# A two-bay plan, 180 x 60. The four corners are pinned. The spine wall between them\n# is under two instructions that cannot both hold, so what you get is the compromise.\n\npoint sw at (0, 0)\npoint se at (180, 0)\npoint ne at (180, 60)\npoint nw at (0, 60)\npoint spineS at (60, 0)\npoint spineN at (60, 60)\n\n1e10 fix sw se ne nw\n1e10 fix spineS spineN in yz\n\n# \"the spine stays a third of the way in\" \u2014 a relation over ELEMENTS\nprefer spineS at 1/3 along (sw, se)\nprefer spineN at 1/3 along (nw, ne)\n\n# \"the west room is 120 wide\" \u2014 a relation over a PROPERTY\ninsist distance(sw, spineS) = 120\ninsist distance(nw, spineN) = 120\n\"\"\"\n\nval solved = compileBrief(plan).solve()\nval P = { n: String -> solved[n] }\n\nval shell = fline {\n    moveTo(P(\"sw\").x, P(\"sw\").y)\n    lineTo(P(\"se\").x, P(\"se\").y)\n    lineTo(P(\"ne\").x, P(\"ne\").y)\n    lineTo(P(\"nw\").x, P(\"nw\").y)\n    close()\n    filled = true\n    stroked = true\n    thickness = 2.0\n    color = vec(0.70, 0.76, 0.84, 0.14)\n}\n\n// Where each of the two instructions would have put the wall on its own, so the\n// compromise reads as a compromise rather than as a number you have to trust.\nval wantedByProportion = fline {\n    moveTo(60.0, -14.0)\n    lineTo(60.0, 74.0)\n    stroked = true\n    thickness = 1.5\n    color = vec(0.35, 0.75, 1.0, 0.65)\n}\nval wantedByLength = fline {\n    moveTo(120.0, -14.0)\n    lineTo(120.0, 74.0)\n    stroked = true\n    thickness = 1.5\n    color = vec(1.0, 0.38, 0.48, 0.65)\n}\n\nval spine = fline {\n    moveTo(P(\"spineS\").x, P(\"spineS\").y)\n    lineTo(P(\"spineN\").x, P(\"spineN\").y)\n    stroked = true\n    thickness = 6.0\n    color = vec(1.0, 0.58, 0.20, 1.0)\n}\n\nprint(\"spine wall x = \" + \"%.3f\".format(P(\"spineS\").x))\nprint(\"west room    = \" + \"%.3f\".format(P(\"spineS\").x - P(\"sw\").x) + \" wide\")\nprint(\"east room    = \" + \"%.3f\".format(P(\"se\").x - P(\"spineS\").x) + \" wide\")\nprint(\"\")\nprint(solved.report())\n\nlines(listOf(shell, wantedByProportion, wantedByLength, spine), w = 460.0, h = 240.0, fitToSize = true)\n"}}]}
