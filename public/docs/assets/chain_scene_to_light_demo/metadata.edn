{"version" 2 "boxes" [{"id" "scene-sender" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1. Scene on the rig: RectSL to sACN (launch)" "frame" #afield/rect [60.0 60.0 380.0 70.0] "code" #afield/file-inline {"path" "scene-sender_code_.kt" "inline" "import afield.dmx.*\nimport afield.rectsl.*\n\n// A RectSL scene, drawn on the CPU, on a light rig. Edit the scene and launch again: the receiver\n// box shows what arrives. (Try the line's width, 0.25 ->wh below, or area = false further down.)\nval scene = RectSLImager(\"\"\"\n#rectsl\n->wall 16 8 abstract\n->background 0x0c1024\n->duration 4\n->fps 30\n\n\"sun\" rect\n  4 4 ->wh\n  0xff7a1a solid ->fill\n  '( 0=-5  2=5  4=-5 ) ->x\n  '( 0=0  4=3.14159 ) ->rot\n;\n\n\"band\" rect\n  16 1.5 ->wh\n  0 -3.25 ->xy\n  0x2a9df4 solid ->fill\n  '( 0=0.15  2=1  4=0.15 ) ->alpha\n;\n\n\"sweep\" rect\n  0.25 8 ->wh\n  0xffffff solid ->fill\n  '( 0=-8  4=8 ) linear ->x\n;\n\"\"\")\n\n// 16 x 8 RGB pixels in universe 1 and four RGBWA washes in universe 2: one fixture per wall unit.\nval rig = SceneOnARig.Rig()\n\n// sACN, unicast to this machine, on a port of its own so no lighting software here hears it.\nval out = sacnOut(\"127.0.0.1\", port = 35690)\n\n// On the sender's own 44 Hz clock: draw the scene at t, shrink it to one pixel per fixture\n// (area averaging), colour the fixtures, send. area = false samples the full frame at each\n// fixture instead, and the thin line flickers as it crosses the rig.\nrig.patch.animate(out) { t ->\n    rig.show(scene.frame(t % scene.duration, 256, 128), area = true)\n}\n\n// The look that is being sent, in the rig's layout, redrawn ten times a second.\nloop {\n    showPatch(rig.patch, channel = \"sent\", w = 480.0, h = 300.0)\n    delay(100)\n}\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "rig-receiver" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2. Receiver: the rig lit by what arrived (launch)" "frame" #afield/rect [1120.0 60.0 380.0 70.0] "code" #afield/file-inline {"path" "rig-receiver_code_.kt" "inline" "import afield.dmx.*\n\n// Field as an sACN node on the sender's port. It knows where the fixtures are (the same layout),\n// and nothing else: every colour drawn here was decoded from the universes that arrived.\nval node = sacnIn(port = 35690)\nval layout = SceneOnARig.Rig()\n\n// Redrawn ten times a second: the rig lit by what arrived, then universe 1 in wire order\n// (128 RGB pixels, then the unused slots).\nloop {\n    showReceived(layout.patch, node, channel = \"received\", w = 480.0, h = 300.0)\n    showUniverse(node, 1, cols = 16, w = 480.0, h = 300.0)\n    delay(100)\n}\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "rig-measure" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3. Measure: round trip and aliasing (run)" "frame" #afield/rect [60.0 560.0 380.0 70.0] "code" #afield/file-inline {"path" "rig-measure_code_.kt" "inline" "import afield.dmx.*\n\n// The page's measurements, on this machine: nine frames sent and received back on a port of their\n// own, and a thin line swept across the rig, sampled two ways.\nval trip = SceneOnARig.roundTrip(port = 35691)\nprintln(trip)\n\nval (point, area) = SceneOnARig.aliasing()\nprintln(\"point samples: dark in ${point.darkFrames} of ${point.total.size} frames, light on the rig ${\"%.2f\".format(point.min)}..${\"%.2f\".format(point.max)}\")\nprintln(\"area average:  dark in ${area.darkFrames} frames, light on the rig ${\"%.3f\".format(area.min)}..${\"%.3f\".format(area.max)} (the line is worth ${SceneOnARig.LINE_TRUTH})\")\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "scene-sender" #afield/box "rig-receiver" #afield/box "rig-measure"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}