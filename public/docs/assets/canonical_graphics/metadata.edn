st = true\n\nvar kc by keyCamera(camera=camera)\nloop {\n    m.set(3, 1) {\n        val z = Math.random()*0.0\n        pos.add(-3,1,-1+z, 1.0,-20.3,z, 3,3,z)\n        tri.add(0,1,2)\n    }\n    true\n}\n"} "fragment" #afield/file-inline {"path" "a8dfc9a7-3062-4eca-ab7e-a243ff8e7bde_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n    vec4 finalColor;\n} pc;\n\nlayout(set=0, binding = 0) uniform sampler2D otherView;\n\n\nvoid main()\n{\n    \n    vec2 tc = gl_FragCoord.xy / 1024.0;\n    vec4 c = texture(otherView, tc.xy + vec2(0.001));\n\n    // uFragColor = pc.finalColor;\n   uFragColor = vec4(c.gr+vec2(0.001),1,1);\n}"} "vertex" #afield/file-inline {"path" "a8dfc9a7-3062-4eca-ab7e-a243ff8e7bde_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n    vec4 finalColor;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n}"} "compute" #afield/file-inline {"path" "a8dfc9a7-3062-4eca-ab7e-a243ff8e7bde_compute_.glsl" "inline" ""} "metadata" #afield/file-inline {"path" "a8dfc9a7-3062-4eca-ab7e-a243ff8e7bde_metadata_.yaml" "inline" ""} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":9,\"column\":1},\"position\":{\"lineNumber\":9,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":42,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "preamble_editorState" "{\"cursorState\":[{\"inSelectionMode\":true,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":22,\"column\":41}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":22,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "fragment_editorState" "{\"cursorState\":[{\"inSelectionMode\":true,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":21,\"column\":2}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":21,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "vertex_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":7,\"column\":21},\"position\":{\"lineNumber\":7,\"column\":21}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":13,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "autorun" false "nested" #{}}} {"id" "57eb613c-90e0-46e1-b075-8e1578bc4934" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "6b. debugging / mapping - Texture probe example" "preamble" "" "frame" #afield/rect [1420 860 280 100] "code" #afield/file-inline {"path" "57eb613c-90e0-46e1-b075-8e1578bc4934_code_.kt" "inline" "prop<LoadedTexture>(bbc) = LoadedTexture(\"/Users/marc/Desktop/bbc.jpg\")\nbbc.transferNow()\n\nvar module = moduleHere {}\nvar m = Mesh()\n\nval probe = fieldProbeHere().display(\"probe\")\n\n\nval identityWarp = QuantileWarpState.identity01()\nval warp = AdaptiveQuantileWarp(\n    config = QuantileWarpConfig(\n        historyFrames = 8,\n        smoothingAlpha = 0.01\n    ),\n    target = TargetDistributions.Uniform01\n).reset(seed = identityWarp)\n\nval warper = fieldProbeQuantileWarp(\n    probe = probe,\n    warp = warp,\n    config = ShaderProbeQuantileWarpConfig(\n        minSamples = 256,\n        clipLower = 0.0,\n        clipUpper = 1.0,\n        displayChannel = null\n    ),\n    install = false\n) { nextWarp, _ ->\n    nextWarp.applyToPushConstants(setVec4 = { name, value ->\n        m.push.set(name, value)\n    })\n}\n\n\n\n\nmodule += \"mainMesh\" to m\nrenderer += \"boo\" to module\n\nval camera = Camera()\nm.p = camera.p \nm.m = camera.m \nm.warpStrength = { 1.0f} \nvar kc by keyCamera(camera=camera)\nval n = 100\nm.set(4*n, 2*n) {\n    n {\n        val z = it+0.0 \n\n        pos.add(0,0,0+z, \n                1.0,0.1,z, \n                1,1,z,\n            0,1,z)\n\n        tc.add(0,0,\n            1,0,\n            1,1,\n            0,1)\n\n        val b = it*4\n        tri.add(b+0,b+1,b+2)\n        tri.add(b+0,b+2,b+3)\n    }\n}\n\nloop {\n    warper.tick()\n}\n"} "fragment" #afield/file-inline {"path" "57eb613c-90e0-46e1-b075-8e1578bc4934_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 1) in vec2 ftc;\n\nlayout(set = 0, binding = 0) uniform sampler2D bbc;\n\n{% include \"fieldProbe\" %}\n{% include \"quantileWarp\" %}\n\nlayout(push_constant) uniform Controls {\n    mat4 p;\n    mat4 m;\n    float time;\n    float warpStrength;\n    vec4 warpXLo;\n    vec4 warpXHi;\n    vec4 warpYLo;\n    vec4 warpYHi;\n} pc;\n\nvoid main()\n{\n    vec4 c = texture(bbc, ftc.yx)/10.0;\n    //c.r = (sin(ftc.x*123.2313+ftc.y*1231.2312)+1)/2;\n    uFragColor = vec4(c.rgb/1.0, 1.0);\n\n    c.r += sin(ftc.x*10.0+ftc.y*123.3)*0.0001;\n\n    float r = fieldQuantileWarpMix(\n                            c.r,\n                            1,\n                            pc.warpXLo,\n                            pc.warpXHi,\n                            pc.warpYLo,\n                            pc.warpYHi\n                        );\n\n    if (length(fract(gl_FragCoord.xy*100.9123))<0.1)\n        fieldProbe(c.r);\n\n    uFragColor.rgb = vec3(r);\n}"} "vertex" #afield/file-inline {"path" "57eb613c-90e0-46e