ri = this ; builder() } } ;            };         }\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<org.joml.Matrix4f>()\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/" "frame" #afield/rect [60 860 280 100] "code" #afield/file-inline {"path" "954d64d5-ee3f-4cb7-8ac7-1e2cce8a9073_code_.kt" "inline" "/** this is a little example that draws a triangle (using more conventional vertex attributes and adds a keyboard controlled camera \n\nas usual we need a shader module and a mesh for the module:\n*/\nvar module = moduleHere()\nvar m = Mesh()\n\n/*\nThis gets us everything we need to start rendering things. In particular, we get a vertex shader:\n\n[[property vertex]]\n*/\n\n    // and a fragment shader:\n\n/*\n[[property fragment]]\n*/\n\n// and we connect these to together\nmodule += m named \"mainMesh\"\nrenderer += module\n\n/** now we make a camera. A Camera is really just a convient way of setting two matricies, `p` and `m`:\n\n* `p` is the _projection matrix_ and it converts from the 3d space of the world to the 2d space of the screen in ways that follow the laws of perspective (in particular, things further away are proprotionally smaller)\n\n* `m` is the _model_view` matrix_ and this accounts for the rotation and translation of the camera _and_ the model\n\n*/\nval camera = Camera()\nm.p =  camera.p  \nm.m =  camera.m \n\n/**\nhere's our triangle, written using vertex attributes. `3` vertices and `1` triangle\n*/\nm.set(3, 1) {\n    val z = 0.0\n    pos.add(0,0,0+z, 1.0,0.1,z, 1,1,z)\n    tri.add(0,1,2)\n}\n\n\n// and here's our handy keyboard control over the camera.\nvar kc by keyCamera(camera=camera)\n\n"} "fragment" #afield/file-inline {"path" "954d64d5-ee3f-4cb7-8ac7-1e2cce8a9073_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nvoid main()\n{\n    uFragColor = vec4(1.0, 0.8, 0.4, 1.0);\n}"} "vertex" #afield/file-inline {"path" "954d64d5-ee3f-4cb7-8ac7-1e2cce8a9073_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n}"} "metadata" #afield/file-inline {"path" "954d64d5-ee3f-4cb7-8ac7-1e2cce8a9073_metadata_.yaml" "inline" "docOrder: 1"} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":11,\"column\":19},\"position\":{\"lineNumber\":11,\"column\":19}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":16,\"column\":1},\"firstPositionDeltaTop\":-10},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":48,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "preamble_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":9,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "metadata_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":12},\"position\":{\"lineNumber\":1,\"column\":12}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\