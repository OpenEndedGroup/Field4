),0,10*Math.cos(tick))\n            tick += 0.01\n            m.set(3*n, 1*n) {\n                n {\n                    val z = 0.0 + it\n                    pos.put(0,0,-1+z, 1.0,0.1,z, 1,1,z)\n                    3 {\n                        col.put(10-it*0,it/3.0,1-it/3.0,1)\n                    }\n                    tri.put(0+3*it,1+3*it,2+3*it)\n                }\n            }\n            frame()\n        }\n    }\n    else {\n        tick += 0.01\n        frame()\n    }\n    true\n}\n"} "fragment" #afield/file-inline {"path" "b03c0eae-3f5e-435d-95e7-df567995bb22_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 0) in vec4 fcol;\nvoid main()\n{\n    uFragColor = vec4(fcol.rgb, 1.0);\n}"} "vertex" #afield/file-inline {"path" "b03c0eae-3f5e-435d-95e7-df567995bb22_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\nlayout (set =0, binding = 0) uniform camera {\n    mat4 p;\n    mat4 m;\n} cam;\n\nlayout (set = 0, binding = 1) uniform wiggle {\n    vec3 offset;\n} wig;\n\nvoid main()\n{\n    gl_Position = cam.p*cam.m*vec4(pos+wig.offset, 1);\n\n    fcol = col;\n}"} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":41,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "metadata" #afield/file-inline {"path" "b03c0eae-3f5e-435d-95e7-df567995bb22_metadata_.yaml" "inline" ""} "autorun" false "nested" #{} "_tombstone" true}} {"id" "f1d2cbea-b20d-4794-b9f7-37b847dcdeb6" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "4. mu