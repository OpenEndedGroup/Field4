riangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/\n/*start*/\n/*graphics-structure-type:foo:Foo*/\nclass Foo(\n    members: List<Introspected.Member> = FooLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var _data by Structure.FromStructure<org.joml.Vector4f>()\n}\nfun FooByteSize(): Long = 16L\nfun FooLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"_data\", 0, PrimitiveType.vec4.left(), 16, false),\n    )\nfun HasBuffer.asFoo(): Foo =\n    asStructure(Foo(), FooLayoutMembers())\nfun BufferParameters.asFoo(): Foo =\n    buffer.asFoo()\n/*end*/\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-structure:vertexData*/ var Structure.vertexData by Structure.FromStructure<Any>()\n/*graphics-pc-binding:vertexData*/ var Mesh.vertexData by Mesh.BoundFromStructure<afield.four.buffers.HasBuffer>()\n/*graphics-pc-binding-group:vertexData*/ var MeshGroup.vertexData by MeshGroup.BoundFromStructure<afield.four.buffers.HasBuffer>()\n/*graphics-pc-structure:d*/ var Structure.d by Structure.FromStructure<Any>()\n/*graphics-pc-binding:d*/ var Mesh.d by Mesh.BoundFromStructure<org.joml.Vector4f>()\n/*graphics-pc-binding-group:d*/ var MeshGroup.d by MeshGroup.BoundFromStructure<org.joml.Vector4f>()\n/*graphics-ssbo:foo*/ val ModulePointer.foo by FromUniform()" "frame" #afield/rect [1760 260 280 100] "code" #afield/file-inline {"path" "65bd0587-dbfa-451a-8f6a-e003ff3d1abf_code_.kt" "inline" "// First, we'll make a shader module associated with this box that draws filled triangles\nvar module = moduleHere { primitiveType = triangles }\n\n    // ... and make a mesh, which runs the shader with some data\nvar m = Mesh()\n\n    // Then we connect the mesh to the module under the name \"someMesh\"\nmodule += m named \"someMesh\"\n\n    // ... and connect the module to the renderer (under the name of this box)\nrenderer += module\n\n/*\nThis gets us everything we need to start rendering things. In particular, we get a vertex shader:\n\n[[property vertex]]\n*/\n\n    // and a fragment shader:\n\n/*\n[[property fragment]]\n*/\n\n// you can edit these by switching to these properties in the editor `f1` or `ctrl-P`\n\n//<hr>\n\n// Now we need a place to put our data \nvar vertexData = defaultBuffer { \n    perFrame = true \n    size = 3.vec4s\n}.buffer\n\n/* Two things:\n\n- we're free to guess the size we'll need (that's the `3.vec4s`), but if we're wrong, we'll get a dynamicly resizing buffer (I'm deliberately setting the size wrong on this buffer to make sure that the dynamic resizing works correctly. The size should be `30.vec4s`)\n\n- `perframe = true` means that we actually have a VulkanBuffer per frame-in-flight, so we can always write to a buffer (and GPU-read from it) without waiting.*/\n\n// now we connect this buffer to the mesh\n// `.vertexData` gets magically defined for us with the coorect type, because Field has read our vertex shader\nm.vertexData = { vertexData } \n\n// You'll note that we have not have written any data to any of the buffers buffer at this point, but this is ok, because we don't size the mesh until later. Or we could write in here before.\n\n//<hr>\n\n// Now a little demo, some triangles that move in circles\nvar t = 0.0\nfun polar(t : Double, r : Double) = vec(Math.sin(t), Math.cos(t)) * r.f\n\nloop {\n    t += 0.01\n    var num = 0\n\n    var numVertToWrite = (Math.sin(t*0.1)*20 + 30).i     // showing that we can add and remove verts in flight\n\n    vertexData.write {\n        for(x in 0 until numVertToWrite) {\n            val offset = vec(x*0.02, 0, 0)\n            put(vec(polar(t, 0.5), 0) + offset)\n            put(vec(polar(t+0.4, 0.4), 0) + offset)\n            put(vec(polar(t+0.9, 0.3), 0) + offset)\n\n            num += 3\n        }\n    }\n\n    // it's important that we tell the mesh how many \"vertices we want to draw\", but, other than that turning into triangles, what that means is entirely up to our vertex shader\n    m.resize(num)\n    \n    // loop forever:\n    true\n}\n\n// because `loop` is the last thing in this script, that code runs (once per animation frame) when you launch it (`alt-mouse-swipe` or `alt-up`)\n\n// ultimately, we get something that looks like this:\n\n// [[render_clip]]\n\n\n"} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":19,\"column\":30},\"position\":{\"lineNumber\":19,\"column\":30}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":2},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":84,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "fragment" #afield/file-inline {"path" "65bd0587-dbfa-451a-8f6a-e003ff3d1abf_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\n\n// location 0 here needs to match location 0 in the vertexShader\nlayout(location = 0) in vec4 localColor;\nvoid main()\n{\n    uFragColor = vec4(localColor.rgb*1, 0.3);\n}"} "vertex" #afield/file-inline {"path" "65bd0587-dbfa-451a-8f6a-e003