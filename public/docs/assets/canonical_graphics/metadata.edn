,-1+z, 1.0,0.1,z, 1,1,z)\n                    3 {\n                        col.add(10-it*0,it/3.0,1-it/3.0,1)\n                    }\n                    tri.add(0+3*it,1+3*it,2+3*it)\n                }\n            }\n            frame()\n        }\n    }\n    else {\n        tick += 0.01\n//        camera.at = vec(-10*Math.sin(tick),0,10*Math.cos(tick))\n        _print(tick)\n        frame()\n    }\n    true\n}\n"} "preamble" "" "fragment" #afield/file-inline {"path" "85e8478b-529b-406e-b835-7c00912848f2_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 0) in vec4 fcol;\nvoid main()\n{\n    uFragColor = vec4(fcol.rgb*2.0, 1.0);\n}"} "vertex" #afield/file-inline {"path" "85e8478b-529b-406e-b835-7c00912848f2_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\nlayout (set=0, binding = 0) uniform camera {\n    mat4 p;\n    mat4 m;\n} cam;\n\nvoid main()\n{\n    gl_Position = cam.p*cam.m*vec4(pos, 1);\n\n    fcol = col;\n}"} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":10,\"column\":1},\"position\":{\"lineNumber\":10,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":2},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":41,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "metadata" #afield/file-inline {"path" "85e8478b-529b-406e-b835-7c00912848f2_metadata_.yaml" "inline" ""} "preamble_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":14,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "vertex_editorState" "{\"cursorState\":[{\"inSelectionMode\":true,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":17,\"column\":2}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":17,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "fragment_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":6,\"column\":35},\"position\":{\"lineNumber\":6,\"column\":35}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":7,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":true}}" "autorun" false "nested" #{}}} {"id" "399c0e99-7d0c-47b0-a072-a373be35e01e" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [231.00001148744002 -114.54544664414493 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "a682ba18-b82b-4062-883b-472ec58241be" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [-701.140625 593.7578125 100.0 100.0] "preamble" "" "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":9,\"column\":10},\"position\":{\"lineNumber\":9,\"column\":10}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":122,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":true}}" "code" #afield/file-inline {"path" "a682ba18-b82b-4062-883b-472ec58241be_code_.kt" "inline" "/**\n * ComplexTest.kt\n * Demonstrates various Kotlin features for compiler testing.\n */\n\nimport kotlin.math.*\nimport kotlin.random.Random\n\n// Type alias\npublic typealias StringList = List<String>\n\n// Inline class\n@JvmInline\nvalue class Meter(val value: Double) {\n    operator fun plus(other: Meter) = Meter(this.value + other.value)\n    operator fun compareTo(other: Meter): Int = this.value.compareTo(other.value)\n    override fun toString() = \"${'$'}value m\"\n}\n\n// Sealed class hierarchy\nsealed class Expr {\n    data class Const(val number: Double): Expr()\n    data class Sum(val e1: Expr, val e2: Expr): Expr()\n    object NotANumber: Expr()\n}\n\n// Extension function\nfun Expr.evaluate(): Double = when (this) {\n    is Expr.Const    -> number\n    is Expr.Sum      -> e1.evaluate() + e2.evaluate()\n    Expr.NotANumber  -> Double.NaN\n}\n\n// Generic class with delegation\nclass CountingSet<T>(private val inner: MutableCollection<T> = mutableListOf()) : MutableCollection<T> by inner {\n    var objectsAdded = 0\n        private set\n\n    override fun add(element: T): Boolean {\n        objectsAdded++\n        return inner.add(element)\n    }\n\n    override fun addAll(elements: Collection<T>): Boolean {\n        objectsAdded += elements.size\n        return inner.addAll(elements)\n    }\n}\n\n// Higher-order inline function\ninline fun <T> measureTimeMillis(block: () -> T): Pair<T, Long> {\n    val start = System.currentTimeMillis()\n    val result = block()\n    val end = System.currentTimeMillis()\n    return result to (end - start)\n}\n\n// Data class with default parameters and named args\ndata class Person(\n    val name: String,\n    val age: Int = 0,\n    val nicknames: StringList = listOf()\n) {\n    fun greet(): String = \"Hello, my name is $name\" +\n        if (nicknames.isNotEmpty()) \" (also known as ${nicknames.joinToString()})\" else \"\"\n}\n\n// Object declaration\nobject Utils {\n    fun randomExpr(depth: Int): Expr = if (depth <= 0) {\n        Expr.Const(Random.nextDouble())\n    } else {\n        Expr.Sum(randomExpr(depth - 1), randomExpr(depth - 1))\n    }\n\n    tailrec fun gcd(a: Long, b: Long): Long = if (b == 0L) a else gcd(b, a % b)\n}\n\n// Main function demonstrating features\nfun main(args: Array<String>) {\n    // Inline class and operator\n    val d1 = Meter(1.0)\n    val d2 = Meter(2.5)\n    println(\"Sum: ${'$'}{d1 + d2}, comparison d1 < d2: ${'$'}{d1 < d2}\")\n\n    // Sealed class evaluation\n    val expr = Expr.Sum(Expr.Const(1.0), Expr.Sum(Expr.Const(2.0), Expr.Const(3.0)))\n    println(\"Expr: $expr = ${'$'}{expr.evaluate()}\")\n\n    // CountingSet\n    val cs = CountingSet<String>()\n    cs.addAll(listOf(\"a\", \"b\", \"c\"))\n    println(\"Added ${'$'}{cs.objectsAdded} items to CountingSet: $cs\")\n\n    // measureTimeMillis\n    val (person, time) = measureTimeMillis {\n        Person(name = \"Alice\", nicknames = listOf(\"Al\", \"Lee\"))\n    }\n    println(\"Created $person in $time ms\")\n\n    // Utils functions\n    println(\"Random Expr evaluation: ${'$'}{Utils.randomExpr(3).evaluate()}\")\n    println(\"GCD of 42 and 56: ${'$'}{Utils.gcd(42, 56)}\")\n\n    // Collection operations\n    val ints = (1..20).toList()\n    val evens = ints.filter { it % 2 == 0 }.map { it * it }\n    println(\"Squared evens: $evens\")\n\n    // Regex and destructuring\n    val regex = \"(\\\\w+)-(\\\\d+)\".toRegex()\n    val input = \"item-123\"\n    regex.matchEntire(input)?.destructured?.let { (word, number) ->\n        println(\"Destructured: word=$word, number=$number\")\n    }\n\n    // Sequence example\n    val fibs = generateSequence(Pair(0, 1)) { (a, b) -> Pair(b, a + b) }\n        .map { it.first }\n        .take(10)\n    println(\"Fibonacci: ${'$'}{fibs.toList()}\")\n}"} "metadata" #afield/file-inline {"path" "a682ba18-b82b-4062-883b-472ec58241be_metadata_.yaml" "inline" ""} "autorun" false "nested" #{} "_tombstone" true}} {"id" "2b622526-7a82-4ee2-97f9-0c2ea6f54d1a" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #af