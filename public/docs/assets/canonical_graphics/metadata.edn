f8-b84a-1cd1d8524510" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "5c. some more templating" "preamble" "" "frame" #afield/rect [1080 860 280 100] "code" #afield/file-inline {"path" "42056e8d-ec8b-4bf8-b84a-1cd1d8524510_code_.kt" "inline" "import afield.four.util.*\n\nclass MyPC(\n    var a : Vec4,\n    var b : Vec4,\n    var c : Vec4\n) : PushConstants<MyPC>()\n\nvar pc = MyPC(vec(1,0,0,1),vec(1,2,3,4),vec(1,2,3,4))\n\nshaderTemplate[\"pc\"] = mapOf(\"dec\" to Resolver { pc.glsl() })\n\npc.a.x=0.3f\npc.otherDeclarations = \"layout(offset=${pc.nextFreeOffset(16)}) uint foo;\"\n\n// then there's an exection break here\n//%- \nvar module = moduleHere {\n    primitiveType = triangle_strip\n}\n\nvar m  = Mesh()\n\nmodule += m named \"my mesh\"\nrenderer += module\n\nm.push.bindAll { pc }\nm.foo = { 10u }\n\nm.set(3, 3) {\n    pos.add(0,0,0, 0.5,0,0, 0.5,0.5,0)\n    tri.add(0,1,2)\n}\n"} "fragment" #afield/file-inline {"path" "42056e8d-ec8b-4bf8-b84a-1cd1d8524510_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 0) in vec4 fcol;\n\n{{ pc.dec }}\nvoid main()\n{\n    loadRegs();\n    \n    uFragColor = vec4(a());\n}"} "vertex" #afield/file-inline {"path" "42056e8d-ec8b-4bf8-b84a-1cd1d8524510_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\n// layout(push_constant) uniform matrices {\n//     mat4 projectionMatrix;\n//     mat4 modelMatrix;\n// } push_constants;\n\nvoid main()\n{\n    // gl_Position = push_constants.projectionMatrix * push_constants.modelMatrix * vec4(pos, 1);\n\n    fcol = col;\n    gl_Position = vec4(pos, 1);\n}"} "metadata" #afield/file-inline {"path" "42056e8d-ec8b-4bf8-b84a-1cd1d8524510_metadata_.yaml" "inline" ""} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":29,\"column\":1