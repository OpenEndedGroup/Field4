ionsState\":{\"editor.contrib.folding\":{\"lineCount\":25,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":true}}" "preamble_editorState" "{\"cursorState\":[{\"inSelectionMode\":true,\"selectionStart\":{\"lineNumber\":26,\"column\":1},\"position\":{\"lineNumber\":25,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":26,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "vertex_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":8,\"column\":12},\"position\":{\"lineNumber\":8,\"column\":12}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":16,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "fragment_editorState" "{\"cursorState\":[{\"inSelectionMode\":true,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":11,\"column\":3}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":11,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "autorun" false "nested" #{}}} {"id" "af0946dd-f25d-4355-984d-f0d24a43ee12" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "1. hello triangle" "preamble" "import afield.four.Renderer\nimport java.nio.*\nimport arrow.core.right\nimport arrow.core.left\nimport afield.four.modules.*\nimport afield.four.buffers.*\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;     this.resize(numVert, numTriangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\n/*start*/\n/*graphics-structure-type:vertexData:VertexData*/\nclass VertexData(\n    members: List<Introspected.Member> = VertexDataLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var positions by Structure.FromStructure<org.joml.Vector4f>()\n}\nfun VertexDataByteSize(): Long = 16L\nfun VertexDataLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"positions\", 0, PrimitiveType.vec4.left(), 16, false),\n    )\nfun HasBuffer.asVertexData(): VertexData =\n    asStructure(VertexData(), VertexDataLayoutMembers())\nfun BufferParameters.asVertexData(): VertexData =\n    buffer.asVertexData()\n/*end*/\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<org.joml.Matrix4f>()\n/*graphics-pc-structure:vertexData*/ var Structure.vertexData by Structure.FromStructure<Any>()\n/*graphics-pc-binding:vertexData*/ var Mesh.vertexData by Mesh.BoundFromStructure<afield.four.buffers.HasBuffer>()\n/*graphics-pc-binding-group:vertexData*/ var MeshGroup.vertexData by MeshGroup.BoundFromStructure<afield.four.buffers.HasBuffer>()\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/" "frame" #afield/rect [60 410 280 100] "code" #afield/file-inline {"path" "af0946dd-f25d-4355-984d-f0d24a43ee12_code_.kt" "inline" "// First, we'll make a shader module associated with this box that draws filled triangles\nvar module = moduleHere { primitiveType = triangles }\n\n    // ... and make a mesh, which runs the shader with some data\nvar m = Mesh()\n\n    // Then we connect the mesh to the module under the name \"someMesh\"\nmodule += m named \"someMesh\"\n\n    // ... and connect the module to the renderer (under the name of this box)\nrenderer += module\n\n/*\nThis gets us everything we need to start rendering things. In particular, we get a vertex shader:\n\n[[property vertex]]\n*/\n\n    // and a fragment shader:\n\n/*\n[[property fragment]]\n*/\n\n// you can edit these by switching to these properties in the editor `f1` or `ctrl-P`\n\n//<hr>\n\n// Now we need a place to put our data \nvar vertexData = defaultBuffer { \n    perFrame = true \n    size = 3.vec4s\n}.buffer\n\n/* Two things:\n\n- we're free to guess the size we'll need (that's the `3.vec4s`), but if we're wrong, we'll get a dynamicly resizing buffer (I'm deliberately setting the size wrong on this buffer to make sure that the dynamic resizing works correctly. The size should be `30.vec4s`)\n\n- `perframe = true` means that we actually have a VulkanBuffer per frame-in-flight, so we can always write to a buffer (and GPU-read from it) without waiting.*/\n\n// now we connect this buffer to the mesh\n// `.vertexData` gets magically defined for us with the coorect type, because Field has read our vertex shader\nm.vertexData = { vertexData } \n\n// You'll note that we have not have written any data to any of the buffers buffer at this point, but this is ok, because we don't size the mesh until later. Or we could write in here before.\n\n//<hr>\n\n// Now a little demo, some triangles that move in circles\nvar t = 0.0\nfun polar(t : Double, r : Double) 