          }\n            g_elements_out[binOffset + prefix] = element_in;\n            if (prefix == count - 1) {\n                atomicAdd(global_offsets[binID], count);\n            }\n        }\n\n        barrier();\n    }\n}"} "_tombstone" true "autorun" false "nested" #{}}} {"id" "2eba1e83-cee8-47da-8bb1-4947a905d237" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [-49.0 -16.0 100.0 100.0] "preamble" "" "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":2},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":1,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "code" #afield/file-inline {"path" "2eba1e83-cee8-47da-8bb1-4947a905d237_code_.kt" "inline" ""} "autorun" false "nested" #{} "_tombstone" true}} {"id" "892e1fab-7d21-41e5-9c42-7a4b14d5ebe0" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [-110.81817029133356 -18.63635640499058 100.0 100.0] "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "8689a39c-d327-49b6-8789-d8c04f96c170" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [188.00001148744002 -34.54544664414493 100.0 100.0] "preamble" "" "_tombstone" true "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":1,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "code" #afield/file-inline {"path" "8689a39c-d327-49b6-8789-d8c04f96c170_code_.kt" 