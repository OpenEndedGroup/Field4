 enable\n\nlayout(std430, buffer_reference) buffer vertexData\n{\n    vec4 positions[];\n};\n\nlayout(push_constant) uniform matrices {\n    mat4 p; \n    mat4 m; \n    vertexData vertexData;\n} pc;\n\nlayout(location=0) out vec4 localColor;\n\nfloat wrap(int a, int b) {\n    return (a%b)/(b-1);\n}\n\nvoid main()\n{\n    vec3 pos = pc.vertexData.positions[gl_VertexIndex].xyz;\n    gl_Position = vec4(pos, 1);\n\n    localColor = vec4(wrap(gl_VertexIndex,3),wrap(gl_VertexIndex,5),wrap(gl_VertexIndex,11),1.0);\n\n    if (gl_VertexIndex == 10) {\n        debugPrintfEXT(\"VS: index=%d, pos=(%f,%f)\",gl_VertexIndex, pos.x, pos.y);\n    }\n}"} "vertex_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":26,\"column\":1},\"position\":{\"lineNumber\":26,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":-1},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":32,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "fragment_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":9,\"column\":2},\"position\":{\"lineNumber\":9,\"column\":2}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":9,\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "preamble_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":14,\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "autorun" false "nested" #{}}} {"id" "8b8d3306-5c31-49aa-ab27-659a992ebd09" "proper