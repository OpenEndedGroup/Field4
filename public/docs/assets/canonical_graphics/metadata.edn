t : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"pos\") { pos = this ; mesh.write(\"col\") { col = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } } ;            };         }\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/" "frame" #afield/rect [60 260 280 100] "code" #afield/file-inline {"path" "cc81ab4e-6c43-4908-bfff-7c8f827c927c_code_.kt" "inline" "// this is almost as simple as drawing a triangle gets here. First a shader:\nvar module = moduleHere {\n    primitiveType = triangle_strip\n}\n\n    // then a mesh\nvar m  = Mesh()\n\n    // then some connection\nmodule += m named \"my mesh\"\nrenderer += module\n\n/*\nThis gets us everything we need to start rendering things. In particular, we get a vertex shader:\n\n[[property vertex]]\n*/\n\n    // and a fragment shader:\n\n/*\n[[property fragment]]\n*/\n\n// you can edit these by switching to these properties in the editor `f1` or `ctrl-P`.\n\n// and then 3 vertices and one triangle strip consisting of 3 indices\nm.set(3, 3) {\n    pos.add(0,0,0, 0.5,0,0, 0.5,0.5,0)\n\n    // for a flourish, we have some color as well\n    3 {\n        col.add(0,it/3.0,1-it/3.0,1)\n    }\n    tri.add(0,1,2)\n}\n"} "fragment" #afield/file-inline {"path" "cc81ab4e-6c43-4908-bfff-7c8f827c927c_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\n\nlayout(location = 0) in vec4 fcol;\nvoid main()\n{\n    uFragColor = vec4(1.0, 0.8, 0.4, 1.0)* fcol;\n}"} "vertex" #afield/file-inline {"path" "cc81ab4e-6c43-4908-bfff-7c8f827c927c_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\n// layout(push_constant) uniform matrices {\n//     mat4 projectionMatrix;\n//     mat4 modelMatrix;\n// } push_constants;\n\nvoid main()\n{\n    // gl_Position = push_constants.projectionMatrix * push_constants.modelMatrix * vec4(pos, 1);\n\n    fcol = col;\n    gl_Position = vec4(pos, 1);\n}"} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":11,\"column\":13},\"position\":{\"lineNumber\":11,\"column\":13}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":2},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":37,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":true}}" "metadata" #afield/file-inline {"path" "cc81ab4e-6c43-4908-bfff-7c8f827c927c_metadata_.yaml" "inline" ""} "preamble_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":11,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "vertex_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":18,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "autorun" false "nested" #{} "fragment_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":8,\"column\":2},\"position\":{\"lineNumber\":8,\"column\":2}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositi