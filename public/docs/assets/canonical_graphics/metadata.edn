) ||\n            isSolidAt(center + ivec2(0, probe), dims, push.solidThreshold) ||\n            isSolidAt(center + ivec2(0, -probe), dims, push.solidThreshold);\n\n        if (solidNeighbor) {\n            mode = 1u;\n            becameSolid = true;\n        } else {\n            positionPx = clamp(positionPx + randomWalkStep(rng, push.walkStepPx), vec2(0.0), maxPos);\n        }\n    }\n\n    push.particleBuffer.particles[gl_VertexIndex].positionPx = positionPx;\n    push.particleBuffer.particles[gl_VertexIndex].rngState = max(rng, 1u);\n    push.particleBuffer.particles[gl_VertexIndex].mode = mode;\n\n    vec2 uv = (positionPx + vec2(0.5)) / vec2(max(dims.x, 1), max(dims.y, 1));\n    vec2 clip = uv * 2.0 - 1.0;\n    gl_Position = vec4(clip.x, -clip.y, 0.0, 1.0);\n    gl_PointSize = push.pointSize;\n    vColor = becameSolid\n        ? vec4(push.stuckRed, 0.0, push.stuckBlue, 0.0)\n        : vec4(0.0, push.walkerGreen, 0.0, 0.0);\n}"} "fragment" #afield/file-inline {"path" "e39270ec-8faf-4d26-8f4e-ce4d23ec4af1_fragment_.glsl" "inline" "#version 450\n\nlayout(location = 0) in vec4 vColor;\nlayout(location = 0) out vec4 outColor;\n\nvoid main() {\n    outColor = vColor;\n}"} "vertex_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":69,\"column\":1},\"position\":{\"lineNumber\":69,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":60,\"column\":1},\"firstPositionDeltaTop\":-14},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":101,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "nested" #{} "fragment_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":2},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":8,\"pro