{"version" 2 "boxes" [{"id" "628f3f96-42d0-48dd-93ea-ea4d9f03b865" "properties" {"children" #{} "parents" #{"611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "5e. Slug filled paths" "frame" #afield/rect [1080 1160 280 100] "autorun" false "nested" #{} "code" #afield/file-inline {"path" "628f3f96-42d0-48dd-93ea-ea4d9f03b865_code_.kt" "inline" "import afield.RunScope\nimport afield.ReleasePolicy\nimport afield.four.Renderer\nimport afield.four.modules.*\nimport afield.graphics.FLine\nimport afield.graphics.slug.*\nimport afield.stdlib.linalg.*\nimport org.lwjgl.vulkan.VK10.*\nimport java.io.File\n\nname = \"5e. Slug filled paths\"\n// Build the optional helper once: bash native/field-slug/build.sh\nval renderer: Renderer = fromContext()\nval path = FLine().moveTo(-1, -1).lineTo(1, -1)\n    .cubicTo(vec(1.4, 0, 0), vec(0.8, 1.3, 0), vec(0, 1, 0))\n    .lineTo(-1, 1).close()\n// Clockwise inner contour cuts a hole in the counterclockwise outer contour.\npath.moveTo(-0.3, -0.3).lineTo(-0.3, 0.3).lineTo(0.3, 0.3).lineTo(0.3, -0.3).close()\nval prepared = SlugPath.compile(path, File(\"native/field-slug/build/field-slug\"))\n\n//%-\nval module = moduleHere {\n    primitiveType = triangles\n    srcAlpha = VK_BLEND_FACTOR_ONE\n    depthWrite = false\n}\nval mesh = Mesh()\nmodule += \"slug\" to mesh\nrenderer += module\nmesh.resize(6)\nval data = SlugBuffer(renderer, prepared)\n\nRunScope.current()!!.own(policy = ReleasePolicy.RUNNING) {\n    if (module.current.meshes[\"slug\"] === mesh) module.current.meshes.remove(\"slug\")\n    data.close()\n}\n\nmesh.slugData = { data }\nval camera = Camera()\ncamera.at = vec(0, 0, -4)\n\nmesh.mvp = { Matrix4f(camera.p.evaluateUniform()).mul(camera.modelView()) }\nmesh.viewport = {\n    val extent = renderer.swapChain.swapChainExtent\n    vec(extent.width(), extent.height())\n}\nvar tint = vec(0.9, 0.9, 0.9, 0.8)\nmesh.tint = { tint }\n\n// Focus the renderer window: WASD/arrows move, E/C rise/fall, R resets.\nvar kc by keyCamera(camera = camera)\n// Change tint or camera without preparing geometry again.\n// Geometry edits: prepare a new SlugPath, then data.replace(newPath) on the render thread.\n// Re-running/stopping this box removes its mesh before retiring the atlas.\n"} "vertex" #afield/file-inline {"path" "628f3f96-42d0-48dd-93ea-ea4d9f03b865_vertex_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\n// Adapted Slug core: Copyright (c) 2026 AlphaPixel LLC. See LICENSE-slughorn.\nlayout(std430, buffer_reference, buffer_reference_align = 4) readonly buffer SlugData { uint words[]; };\nlayout(push_constant) uniform SlugPC {\n    mat4 mvp;\n    SlugData slugData;\n    vec2 viewport;\n    vec4 tint;\n} pc;\nvec4 data4(uint at) {\n    return uintBitsToFloat(uvec4(pc.slugData.words[at], pc.slugData.words[at+1],\n        pc.slugData.words[at+2], pc.slugData.words[at+3]));\n}\nlayout(location=0) out vec2 emCoord;\nconst vec2 corners[6] = vec2[6](vec2(0,0), vec2(1,0), vec2(1,1), vec2(0,0), vec2(1,1), vec2(0,1));\nvoid main() {\n    vec4 bounds = data4(8u);\n    vec2 corner = corners[gl_VertexIndex % 6];\n    vec2 q = mix(bounds.xy, bounds.zw, corner);\n    vec2 normal = 2.0 * corner - 1.0;\n    mat4 matrix = pc.mvp;\n    vec4 position = matrix * vec4(q, 0.0, 1.0);\n    // Lengyel's perspective-dependent dilation, expressed in homogeneous vectors.\n    // normal is the corner bisector scaled so both incident sides expand equally.\n    vec4 direction = matrix * vec4(normalize(normal), 0.0, 0.0);\n    float s = position.w;\n    float t = direction.w;\n    vec2 uv = pc.viewport * (s*direction.xy - t*position.xy);\n    float denominator = length(uv) - s*t;\n    float distance = denominator > 1e-12 ? s*s / denominator : 0.0;\n    q += distance * normal;\n    emCoord = q;\n    gl_Position = matrix * vec4(q, 0.0, 1.0);\n}\n"} "fragment" #afield/file-inline {"path" "628f3f96-42d0-48dd-93ea-ea4d9f03b865_fragment_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\n// Adapted Slug core: Copyright (c) 2026 AlphaPixel LLC. See LICENSE-slughorn.\nlayout(std430, buffer_reference, buffer_reference_align = 4) readonly buffer SlugData { uint words[]; };\nlayout(push_constant) uniform SlugPC {\n    mat4 mvp;\n    SlugData slugData;\n    vec2 viewport;\n    vec4 tint;\n} pc;\nvec4 data4(uint at) {\n    return uintBitsToFloat(uvec4(pc.slugData.words[at], pc.slugData.words[at+1],\n        pc.slugData.words[at+2], pc.slugData.words[at+3]));\n}\nlayout(location=0) in vec2 emCoord;\nlayout(location=0) out vec4 fragColor;\n#define TEX_WIDTH 9\n#define SLUG_INDIRECTION_SIZE 32\nuvec4 bandFetch(ivec2 xy) {\n    uint i = pc.slugData.words[7] + uint(xy.y * 512 + xy.x);\n    uint pair = pc.slugData.words[i];\n    return uvec4(pair & 65535u, pair >> 16u, 0u, 0u);\n}\nvec4 curveFetch(ivec2 xy) {\n    uint i = pc.slugData.words[6] + 4u * uint(xy.y * 512 + xy.x);\n    return data4(i);\n}\nuint slug_CalcRootCode(float y1, float y2, float y3) {\n\tuint i1 = floatBitsToUint(y1) >> 31u;\n\tuint i2 = floatBitsToUint(y2) >> 30u;\n\tuint i3 = floatBitsToUint(y3) >> 29u;\n\n\tuint shift = (i2 & 2u) | (i1 & ~2u);\n\tshift = (i3 & 4u) | (shift & ~4u);\n\n\treturn ((0x2E74u >> shift) & 0x0101u);\n}\n\nvec2 slug_SolveHorizPoly(vec4 p12, vec2 p3) {\n\tvec2 a = p12.xy - p12.zw * 2.0 + p3;\n\tvec2 b = p12.xy - p12.zw;\n\tfloat ra = 1.0 / a.y;\n\tfloat rb = 0.5 / b.y;\n\tfloat d = sqrt(max(b.y * b.y - a.y * p12.y, 0.0));\n\tfloat t1 = (b.y - d) * ra;\n\tfloat t2 = (b.y + d) * ra;\n\tif(abs(a.y) < 1.0 / 65536.0) { t1 = p12.y * rb; t2 = t1; }\n\treturn vec2(\n\t\t(a.x * t1 - b.x * 2.0) * t1 + p12.x,\n\t\t(a.x * t2 - b.x * 2.0) * t2 + p12.x\n\t);\n}\n\nvec2 slug_SolveVertPoly(vec4 p12, vec2 p3) {\n\tvec2 a = p12.xy - p12.zw * 2.0 + p3;\n\tvec2 b = p12.xy - p12.zw;\n\tfloat ra = 1.0 / a.x;\n\tfloat rb = 0.5 / b.x;\n\tfloat d = sqrt(max(b.x * b.x - a.x * p12.x, 0.0));\n\tfloat t1 = (b.x - d) * ra;\n\tfloat t2 = (b.x + d) * ra;\n\tif(abs(a.x) < 1.0 / 65536.0) { t1 = p12.x * rb; t2 = t1; }\n\treturn vec2(\n\t\t(a.y * t1 - b.y * 2.0) * t1 + p12.y,\n\t\t(a.y * t2 - b.y * 2.0) * t2 + p12.y\n\t);\n}\n\nivec2 slug_CalcBandLoc(ivec2 glyphLoc, uint offset) {\n\tivec2 bandLoc = ivec2(glyphLoc.x + int(offset), glyphLoc.y);\n\tbandLoc.y += bandLoc.x >> TEX_WIDTH;\n\tbandLoc.x &= (1 << TEX_WIDTH) - 1;\n\treturn bandLoc;\n}\n\n// 2026-08-30: re-derive a curve's second texel location the same way slug_CalcBandLoc()\n// re-derives a band fetch's row, instead of flat-adding to curveLoc.x. Packing today always\n// aligns a curve's 2 texels to start at an even X so they never straddle a row, making this a\n// no-op -- but endpoint-shared curve packing (planned) removes that alignment, so a curve's\n// second texel CAN legitimately land at the start of the next row.\nivec2 slug_CalcCurveLoc(ivec2 curveLoc, int offset) {\n\tivec2 loc = ivec2(curveLoc.x + offset, curveLoc.y);\n\tloc.y += loc.x >> TEX_WIDTH;\n\tloc.x &= (1 << TEX_WIDTH) - 1;\n\treturn loc;\n}\n\nfloat slug_CalcCoverage(float xcov, float ycov, float xwgt, float ywgt) {\n\tfloat coverage = max(\n\t\tabs(xcov * xwgt + ycov * ywgt) / max(xwgt + ywgt, 1.0 / 65536.0),\n\t\tmin(abs(xcov), abs(ycov))\n\t);\n\treturn clamp(coverage, 0.0, 1.0);\n}\n\nfloat slug_Render(vec2 renderCoord, vec4 bandTransform, ivec2 glyphLoc, ivec2 bandMax) {\n\tvec2 emsPerPixel = fwidth(renderCoord);\n\tvec2 pixelsPerEm = 1.0 / emsPerPixel;\n\n\t// O(1) band index via indirection tables (2 fetches per axis).\n\tint qY = clamp(int(renderCoord.y * bandTransform.y + bandTransform.w), 0, SLUG_INDIRECTION_SIZE - 1);\n\tint qX = clamp(int(renderCoord.x * bandTransform.x + bandTransform.z), 0, SLUG_INDIRECTION_SIZE - 1);\n\tint bandY = int(bandFetch(ivec2(glyphLoc.x + qY, glyphLoc.y)).r);\n\tint bandX = int(bandFetch(ivec2(glyphLoc.x + SLUG_INDIRECTION_SIZE + qX, glyphLoc.y)).r);\n\n\t// Horizontal bands -- headers at glyphLoc + 2*IS + bandY\n\tfloat xcov = 0.0, xwgt = 0.0;\n\tuvec2 hbandData = bandFetch(ivec2(glyphLoc.x + 2 * SLUG_INDIRECTION_SIZE + bandY, glyphLoc.y)).xy;\n\n\tfor(int ci = 0; ci < int(hbandData.x); ci++) {\n\t\t// Re-derive this fetch's row every iteration (instead of computing hbandLoc once\n\t\t// and flat-adding ci to its X) so a band's curve-index list can span more than one\n\t\t// texture row -- removes the old \"count > texWidth\" hard limit on shape complexity.\n\t\t// Costs up to ~10us on complex scenes vs. the single-fetch version; worth it.\n\t\tivec2 hbandLoc = slug_CalcBandLoc(glyphLoc, hbandData.y + uint(ci));\n\t\tivec2 curveLoc = ivec2(bandFetch(hbandLoc).xy);\n\t\tvec4 p12 = curveFetch(curveLoc) - vec4(renderCoord, renderCoord);\n\n\t\t// 2026-08-31: same re-derive-per-fetch pattern as slug_CalcBandLoc above, now applied to\n\t\t// a curve's own second texel -- needed once packTextures() (slughorn.cpp) started\n\t\t// sharing texels between connected curves (Lengyel's Slug convention: a chain of N\n\t\t// connected curves costs N+1 texels instead of 2N), which packs densely with no\n\t\t// per-curve row alignment. Adds a handful of ALU ops per curve iteration; negligible\n\t\t// next to the texture fetch and sqrt-based polynomial solve already in this loop.\n\t\t// Shipped as the default (no opt-in flag) -- lossless, and verified bit-identical\n\t\t// against the pre-sharing renderer at real CJK-atlas scale.\n\t\tvec2 p3 = curveFetch(slug_CalcCurveLoc(curveLoc, 1)).xy - renderCoord;\n\n\t\tif(max(max(p12.x, p12.z), p3.x) * pixelsPerEm.x < -0.5) break;\n\n\t\tuint code = slug_CalcRootCode(p12.y, p12.w, p3.y);\n\t\tif(code != 0u) {\n\t\t\tvec2 r = slug_SolveHorizPoly(p12, p3) * pixelsPerEm.x;\n\t\t\tif((code & 1u) != 0u) { xcov += clamp(r.x + 0.5, 0.0, 1.0); xwgt = max(xwgt, clamp(1.0 - abs(r.x) * 2.0, 0.0, 1.0)); }\n\t\t\tif(code > 1u) { xcov -= clamp(r.y + 0.5, 0.0, 1.0); xwgt = max(xwgt, clamp(1.0 - abs(r.y) * 2.0, 0.0, 1.0)); }\n\t\t}\n\t}\n\n\t// Vertical bands -- headers at glyphLoc + 2*IS + numHBands + bandX\n\tfloat ycov = 0.0, ywgt = 0.0;\n\tuvec2 vbandData = bandFetch(ivec2(glyphLoc.x + 2 * SLUG_INDIRECTION_SIZE + bandMax.y + 1 + bandX, glyphLoc.y)).xy;\n\n\tfor(int ci = 0; ci < int(vbandData.x); ci++) {\n\t\t// See the matching comment in the horizontal-band loop above.\n\t\tivec2 vbandLoc = slug_CalcBandLoc(glyphLoc, vbandData.y + uint(ci));\n\t\tivec2 curveLoc = ivec2(bandFetch(vbandLoc).xy);\n\t\tvec4 p12 = curveFetch(curveLoc) - vec4(renderCoord, renderCoord);\n\n\t\t// See the matching endpoint-sharing tradeoff comment in the horizontal-band loop above.\n\t\tvec2 p3 = curveFetch(slug_CalcCurveLoc(curveLoc, 1)).xy - renderCoord;\n\n\t\tif(max(max(p12.y, p12.w), p3.y) * pixelsPerEm.y < -0.5) break;\n\n\t\tuint code = slug_CalcRootCode(p12.x, p12.z, p3.x);\n\t\tif(code != 0u) {\n\t\t\tvec2 r = slug_SolveVertPoly(p12, p3) * pixelsPerEm.y;\n\t\t\tif((code & 1u) != 0u) { ycov -= clamp(r.x + 0.5, 0.0, 1.0); ywgt = max(ywgt, clamp(1.0 - abs(r.x) * 2.0, 0.0, 1.0)); }\n\t\t\tif(code > 1u) { ycov += clamp(r.y + 0.5, 0.0, 1.0); ywgt = max(ywgt, clamp(1.0 - abs(r.y) * 2.0, 0.0, 1.0)); }\n\t\t}\n\t}\n\n\treturn slug_CalcCoverage(xcov, ycov, xwgt, ywgt);\n}\n\n\n// Replace this function with a Field procedural fill. Coverage remains independent.\nvec3 shade(vec2 q) { return pc.tint.rgb * (0.7 + 0.3*cos(vec3(0,2,4)+q.x*4.0+q.y*3.0)); }\nvoid main() {\n    ivec2 loc = ivec2(pc.slugData.words[16], pc.slugData.words[17]);\n    ivec2 bandMax = ivec2(pc.slugData.words[18], pc.slugData.words[19]);\n    float coverage = slug_Render(emCoord, data4(12u), loc, bandMax);\n    if (coverage <= 0.0) discard;\n    // Straight alpha; use a source-alpha blending pipeline. Convert explicitly for\n    // premultiplied-alpha targets. Neither atlas data nor coverage are sRGB colors.\n    fragColor = vec4(shade(emCoord), coverage * pc.tint.a);\n}\n"} "metadata" #afield/file-inline {"path" "628f3f96-42d0-48dd-93ea-ea4d9f03b865_metadata_.yaml" "inline" "# 5e. Slug filled paths\n# Requires optional native/field-slug helper.\n"} }} {"id" "b42d7b13-680e-4f9b-b789-8e6e7d8c4a21" "properties" {"children" #{} "parents" #{"611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "5d. GPU schema" "frame" #afield/rect [1080 1010 280 100] "autorun" false "nested" #{} "code" #afield/file-inline {"path" "b42d7b13-680e-4f9b-b789-8e6e7d8c4a21_code_.kt" "inline" "import afield.four.Renderer\nimport afield.four.buffers.*\nimport afield.four.modules.*\nimport afield.stdlib.linalg.*\n\n// Three position/color vertices form one triangle.\n// The schema shares their memory layout between Kotlin and GLSL.\nname = \"5d. GPU schema\"\n\n@GpuStruct\ndata class Vertex(\n    val position: Vector3f,\n    val color: Vector4f\n)\n\nval vertexSchema = gpuSchema<Vertex>()\nshaderTemplate[\"Vertex\"] = vertexSchema.template\n\nval vertices = listOf(\n    Vertex(vec(-0.8f, -0.6f, 0f), vec(1f, 0.15f, 0.1f, 1f)),\n    Vertex(vec( 0.8f, -0.6f, 0f), vec(0.1f, 0.9f, 0.3f, 1f)),\n    Vertex(vec( 0.0f,  0.7f, 0f), vec(0.2f, 0.4f, 1.0f, 1f))\n)\n\nval vertexData = defaultBuffer {\n    size = (vertices.size * vertexSchema.strideBytes).bytes\n}.buffer\n\nvertexData.mapAndWrite_bytes {\n    vertexSchema.writeArray(vertices, this)\n}\n\n//%-\nval renderer: Renderer = fromContext()\n\nvar module = moduleHere {\n    primitiveType = triangles\n}\n\nvar m = Mesh()\nmodule += m named \"gpu schema triangle\"\nrenderer += module\n\n// `vertices` is a reflected physical pointer. Field writes vertexData's device address into\n// the push constant; the array itself stays in the addressable buffer.\nm.vertices = { vertexData }\nm.count = { vertices.size.toUInt() }\n\nm.resize(vertices.size)\n"} "vertex" #afield/file-inline {"path" "b42d7b13-680e-4f9b-b789-8e6e7d8c4a21_vertex_.glsl" "inline" "#version 460\n\n{{ Vertex.all }}\n\nlayout(push_constant) uniform Push {\n    VertexArray vertices;\n    uint count;\n} pc;\n\nlayout(location = 0) out vec4 fcol;\n\nvoid main()\n{\n    uint i = uint(gl_VertexIndex);\n    Vertex vertex = pc.vertices.elements[i];\n\n    gl_Position = vec4(vertex.position, 1.0);\n    fcol = vertex.color * float(pc.count > 0u);\n}\n"} "fragment" #afield/file-inline {"path" "b42d7b13-680e-4f9b-b789-8e6e7d8c4a21_fragment_.glsl" "inline" "#version 460\n\nlayout(location = 0) in vec4 fcol;\nlayout(location = 0) out vec4 uFragColor;\n\nvoid main()\n{\n    uFragColor = fcol;\n}\n"} "metadata" #afield/file-inline {"path" "b42d7b13-680e-4f9b-b789-8e6e7d8c4a21_metadata_.yaml" "inline" "# 5d. GPU schema\n# Intentionally a separate lesson from 5c. some more templating / PushConstants<T>.\n"} }} {"id" "fc786cb0-d144-487b-999f-55e3d4d984a4" "properties" {"children" #{} "parents" #{} "name" "Untitled" "frame" #afield/rect [-399.81817029133356 -185.63635640499058 100.0 100.0] "code" #afield/file-inline {"path" "fc786cb0-d144-487b-999f-55e3d4d984a4_code_.kt" "inline" ""} "preamble" "" "_tombstone" true "autorun" false "nested" #{}}} {"id" "4ac4dcab-b0a7-4019-8279-3f406838becd" "properties" {"children" #{} "parents" #{} "name" "histo_1" "frame" #afield/rect [-172.359375 -20.6953125 123.2109375 82.75] "code" #afield/file-inline {"path" "4ac4dcab-b0a7-4019-8279-3f406838becd_code_.kt" "inline" ""} "preamble" "" "compute" #afield/file-inline {"path" "4ac4dcab-b0a7-4019-8279-3f406838becd_compute_.glsl" "inline" "#version 460\n\n#define WORKGROUP_SIZE 256 \n#define RADIX_SORT_BINS 256\n\nlayout (local_size_x = WORKGROUP_SIZE) in;\n\nlayout (push_constant, std430) uniform PushConstants {\n    uint g_num_elements;\n    uint g_shift;\n    uint g_num_workgroups;\n    uint g_num_blocks_per_workgroup;\n};\n\nlayout (std430, set = 0, binding = 0) buffer m_buffer0 {\n    uint unused[];\n};\n\nlayout (std430, set = 0, binding = 1) buffer m_buffer1 {\n    uint g_elements_in[];\n};\n\nlayout (std430, set = 1, binding = 0) buffer m_bufferHistogram {\n    // [histogram_of_workgroup_0 | histogram_of_workgroup_1 | ... ]\n    uint g_histograms[]; // |g_histograms| = RADIX_SORT_BINS * #WORKGROUPS\n};\n\nshared uint[RADIX_SORT_BINS] histogram;\n\nvoi