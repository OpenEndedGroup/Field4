ar m = Mesh()\nvar module = moduleHere()\n\nmodule += \"mainMesh\" to m\nrenderer += \"boo\" to module\n\nval camera = Camera()\ncamera.at = vec(-10,2,0)\n\nm.p = camera.p\nm.m = camera.m\n\nvar tick = 0.0\nloop {\n    camera.at = vec(-10*Math.sin(tick),0,10*Math.cos(tick))\n    if (tick<3) {\n        for(n in 1 .. 100) {\n            camera.at = vec(-10*Math.sin(tick),0,10*Math.cos(tick))\n            tick += 0.01\n            m.set(3*n, 1*n) {\n                n {\n                    val z = 0.0 + it\n                    pos.add(0,0,-1+z, 1.0,0.1,z, 1,1,z)\n                    3 {\n                        col.add(0,it/3.0,1-it/3.0,1)\n                    }\n                    tri.add(0+3*it,1+3*it,2+3*it)\n                }\n            }\n            frame()\n        }\n    }\n    else {\n        tick += 0.01\n        frame()\n    }\n    true\n}\n"} "fragment" #afield/file-inline {"path" "b2ba23e8-18e5-4f07-a709-2b89116a83b3_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nvoid main()\n{\n    uFragColor = vec4(1.0, 0.8, 0.4, 1.0);\n}"} "vertex" #afield/file-inline {"path" "b2ba23e8-18e5-4f07-a709-2b89116a83b3_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n\n    fcol = col;\n}"} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":20,\"column\":10},\"position\":{\"lineNumber\":20,\"column\":10}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":2,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":40,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "metadata" #afield/file-inline {"path" "b2ba23e8-18e5-4f07-a709-2b89116a83b3_me