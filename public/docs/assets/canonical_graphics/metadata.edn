t(location = 0) in vec4 fcol;\nvoid main()\n{\n    uFragColor = vec4({{ col.fixedColor }});\n}"} "vertex" #afield/file-inline {"path" "1103f132-7484-4440-8102-5bd159a29fbf_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\n// layout(push_constant) uniform matrices {\n//     mat4 projectionMatrix;\n//     mat4 modelMatrix;\n// } push_constants;\n\nvoid main()\n{\n    // gl_Position = push_constants.projectionMatrix * push_constants.modelMatrix * vec4(pos, 1);\n\n    fcol = col;\n    gl_Position = vec4(pos, 1);\n}"} "metadata" #afield/file-inline {"path" "1103f132-7484-4440-8102-5bd159a29fbf_metadata_.yaml" "inline" ""} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":15,\"column\":1},\"position\":{\"lineNumber\":15,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":2},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":20,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "fragment_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":7,\"column\":30},\"position\":{\"lineNumber\":7,\"column\":30}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":8,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":true}}" "autorun" false "nested" #{}}} {"id" "8323570b-87db-4623-95a2-bd61c7d0f6f7" "properties" {"children" #{#afield/box "1ae1daed-12d3-4629-8f81-66194c5b924c"} "parents" #{#afield/box "root" #afield/box "611072da-1af6-4d2d-85bf-07a9ba191aca"} "name" "6. RTT - sending" "preamble" "import afield.four.Renderer\nimport afield.four.stream.FieldRTTStreamer\nimport afield.four.targets.RenderToTexture\nim