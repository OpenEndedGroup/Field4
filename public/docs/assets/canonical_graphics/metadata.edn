().toFloat()-0.5)\n        this.add(Math.random().toFloat()-0.5)\n    }\n    this.clear()\n}\n\nframes {\n    while(true) {\n        fr++\n\n         module.InputBuffer.mapAndRead {\n            var s = \"${fr}:: \"\n            this.clear()\n            for(n in 0 until 2)\n                s+=this.get(n).toString()+\" \"\n            _print(s)\n        }   \n\n        frame()\n    }    \n}\n"} "vertex" #afield/file-inline {"path" "dde61a17-912c-4577-8128-681829c23fec_vertex_.glsl" "inline" ""} "compute" #afield/file-inline {"path" "dde61a17-912c-4577-8128-681829c23fec_compute_.glsl" "inline" "#version 450\nlayout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;\n\nlayout(set=0, binding = 0) buffer InputBuffer {\n    vec4 dat[];\n};\n\nvoid main() {\n    uint idx = gl_GlobalInvocationID.x;\n    float timeStep = 1.1;\n    dat[idx].xy += dat[idx].zw * timeStep;\n    dat[idx].zw *= 0.99;\n}"} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":29,\"column\":6},\"position\":{\"lineNumber\":29,\"column\":6}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":48,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "compute_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":1,\"column\":1},\"position\":{\"lineNumber\":1,\"column\":1}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsState\":{\"editor.contrib.folding\":{\"lineCount\":13,\"provider\":\"indent\",\"foldedImports\":false},\"editor.contrib.wordHighlighter\":false}}" "metadata" #afield/file-inline {"path" "dde61a17-912c-4577-8128-681829c23fec_metadata_.yaml" "inline" ""} "autorun" false "nested" #{} "_tombstone" true}} {"id" "459b9c54-6363-4c27-a033-2f145e017022" "propertie