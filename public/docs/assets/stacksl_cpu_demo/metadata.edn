{"version" 2 "boxes" [{"id" "stacksl-cpu-still" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "StackSL on the CPU — the emitter's own GLSL, interpreted" "frame" #afield/rect [60.0 60.0 560.0 620.0] "code" #afield/file-inline {"path" "stacksl-cpu-still_code_.kt" "inline" "// StackSL, running on the CPU. No GPU, no window, no graphics context, no AWT.\n//\n// Until this backend existed, a StackSL program could only be RUN on a GPU — so every claim about\n// what a word does was checked either by eye against a screenshot, or against a hand-written\n// Kotlin twin of the emitted GLSL. This box is the third option: the real compiler's real output,\n// interpreted.\n//\n// Note what is printed below the picture. That GLSL is not a description of what the CPU is about\n// to do — it IS what the CPU is about to do, and it is byte for byte what a GPU would be handed.\n// The CPU backend has no opinion about any StackSL word; it only knows GLSL.\n\nimport afield.stacksl.cpu.StackSLCpu\n\nrun {\n\n    val program = \"\"\"\n        p 6 kaleido\n        1.7 twist\n        3.0 *\n        fbm\n        palette\n        saturate\n    \"\"\".trimIndent()\n\n    // `StackSLCpu.compile` is the ordinary `stack.auto` compile: same options, same emitter.\n    val glsl = StackSLCpu.compile(program).glsl\n    println(\"The StackSL program:\")\n    println(program.prependIndent(\"    \"))\n    println()\n    println(\"compiles to ${glsl.lines().count { it.isNotBlank() }} lines of GLSL, which is what BOTH backends read:\")\n    println(glsl.prependIndent(\"    \"))\n\n    // 256 is a comfortable size for a box. This is an interpreter, not a renderer: expect a\n    // second or two here, and single-digit seconds for the docs' 512.\n    val started = System.nanoTime()\n    val raster = StackSLCpu.renderStill(program, dim = 256)\n    val seconds = (System.nanoTime() - started) / 1e9\n    println()\n    println(\"rendered ${raster.width}x${raster.height} on the CPU in %.2fs\".format(seconds))\n\n    // `display(ByteArray)` recognises PNG bytes and shows the picture inline, so this needs no\n    // image toolkit at all — `PngEncoder` is pure Kotlin.\n    display(raster.toPngBytes())\n\n    // Try it: change a number, or a word. `p 6 kaleido` -> `p 8 kaleido`, `fbm` -> `noise`,\n    // `palette` -> `ryb-paint`. Anything the language accepts, this will render.\n}\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "stacksl-cpu-feedback" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "StackSL feedback, ping-ponged on the CPU" "frame" #afield/rect [660.0 60.0 560.0 620.0] "code" #afield/file-inline {"path" "stacksl-cpu-feedback_code_.kt" "inline" "// A feedback StackSL program, ping-ponging on the CPU.\n//\n// The gallery's feedback entries are the ones a still cannot describe: the program samples the\n// PREVIOUS frame, so the image is the end of a loop rather than a function of the pixel. On the\n// GPU that is a `PingPongRenderToTexture`. Here it is two `CpuTexture2D` buffers and a `for` loop,\n// which is the whole point — the same program, the same emitted GLSL, no device.\n//\n// This box also shows the other half of the backend: the host shader is yours. `StackSLCpu`\n// renders whatever fragment shader you hand it, so the `{{ stack.auto.program }}` template below\n// is the same kind of thing a live module would carry, `sampler2D` and push constant included.\n\nimport afield.stacksl.cpu.CpuTexture2D\nimport afield.stacksl.cpu.StackSLCpu\n\nrun {\n\n    // The `diffusion-feedback` gallery program, verbatim: blur the previous frame, keep 97.5% of\n    // it, and add threshold-ed `fbm` blobs that drift with time. Chosen over the other feedback\n    // entry because `blur` is a NINE-TAP sampler — it proves the CPU texture path in a way a\n    // single `sample` does not — and because a diffusion accumulates spatial structure, so the\n    // frames below are visibly a history rather than four similar pictures.\n    val program = \"\"\"\n        0.004 blur\n        0.975 *\n        uv 5 * 0.25t + fbm 0.62 threshold 0.05 *\n        +\n        saturate\n    \"\"\".trimIndent()\n\n    val template = \"\"\"\n        #version 450\n        layout(location = 0) in vec2 fragUV;\n        layout(location = 0) out vec4 outColor;\n\n        layout(set = 0, binding = 0) uniform sampler2D source;\n        layout(push_constant) uniform Push { vec4 params; } pc;\n\n        {{ stack.auto.program }}\n\n        void main() {\n            vec4 stackInput = vec4(fragUV, 0.0, pc.params.x);\n            vec3 c = program(stackInput).rgb;\n            if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);\n            outColor = vec4(clamp(c, 0.0, 1.0), 1.0);\n        }\n    \"\"\".trimIndent()\n\n    val dim = 112\n    val frames = 72\n    val keepEvery = 12\n\n    // Frame zero's history is a cleared black target, exactly as the GPU harness starts.\n    var history = CpuTexture2D(dim, dim, FloatArray(dim * dim * 4) { if (it % 4 == 3) 1f else 0f })\n    val kept = mutableListOf<IntArray>()\n\n    val started = System.nanoTime()\n    for (frame in 0 until frames) {\n        val raster = StackSLCpu.renderProgram(\n            program = program,\n            template = template,\n            width = dim,\n            height = dim,\n            pushParams = floatArrayOf(frame / 12f, 0f, 0f, 0f),\n            samplers = history\n        )\n        history = CpuTexture2D(raster)          // the ping-pong swap, in one line\n        if (frame % keepEvery == keepEvery - 1) kept += raster.toArgb()\n    }\n    println(\"$frames CPU feedback frames at ${dim}x$dim in %.2fs\".format((System.nanoTime() - started) / 1e9))\n    println(\"frames shown: \" + (1..kept.size).joinToString(\", \") { \"${it * keepEvery}\" })\n\n    // Stitch the kept frames into one horizontal strip, with a two-pixel gutter.\n    val gutter = 2\n    val stripWidth = kept.size * dim + (kept.size - 1) * gutter\n    val strip = IntArray(stripWidth * dim) { 0xFF101014.toInt() }\n    kept.forEachIndexed { index, frame ->\n        val x0 = index * (dim + gutter)\n        for (y in 0 until dim) System.arraycopy(frame, y * dim, strip, y * stripWidth + x0, dim)\n    }\n    display(afield.util.PngEncoder.encode(strip, stripWidth, dim))\n\n    // The thing to notice: nothing in the program draws the smeared structure. It is the previous\n    // frame, read back through a nine-tap `blur`, faded by `0.975 *`, ninety-six times over. If\n    // `texture()` were being ignored you would see only the current frame's hard-edged blobs, the\n    // same in every panel.\n}\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "stacksl-cpu-still" #afield/box "stacksl-cpu-feedback"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}