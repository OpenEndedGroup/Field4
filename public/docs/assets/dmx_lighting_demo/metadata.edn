{"version" 2 "boxes" [{"id" "dmx-receiver" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1. Art-Net receiver: Field as a node (launch first)" "frame" #afield/rect [60.0 60.0 380.0 70.0] "code" #afield/file-inline {"path" "dmx-receiver_code_.kt" "inline" "import afield.dmx.*\n\n// Field as an Art-Net node: listen on UDP 6454, merge what arrives (HTP), answer ArtPoll.\n// Launch this first, then launch the sender. Stopping this box closes the socket.\nval input = artnetIn()\n\n// Redraw the two received universes as RGB cells whenever new data has arrived.\nvar seen = -1L\nloop {\n    val v = input.version(1) + input.version(2)\n    if (v != seen && frameNumber % 4 == 0) {\n        seen = v\n        showUniverse(input, 1)\n        showUniverse(input, 2)\n    }\n}\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "dmx-sender" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2. Pixel mapper: 200 px on a curve (launch)" "frame" #afield/rect [580.0 60.0 380.0 70.0] "code" #afield/file-inline {"path" "dmx-sender_code_.kt" "inline" "import afield.dmx.*\n\n// 200 RGB pixels of LED tape stuck along a curve. 170 fit in universe 1 (510 slots);\n// the patch rolls the other 30 into universe 2 by itself.\nval tape = FLine().moveTo(0, 0).cubicTo(x0 = 150, y0 = -160, x1 = 250, y1 = 160, x = 400, y = 0)\nval patch = Patch(startUniverse = 1)\npatch.stripAlong(tape, 200)\n\n// Art-Net to this machine; use a node's IP (or a broadcast address) to drive real lights.\nval out = artnetOut(\"127.0.0.1\")\n\n// A colour field over (x, y, t), evaluated on the DMX sender's own 44 Hz clock.\npatch.animate(out) { t ->\n    map(t) { x, y, time ->\n        vec(0.5 + 0.5 * sin(x * 0.03 - time * 2.0),\n            0.5 + 0.5 * sin(x * 0.03 - time * 2.0 + 2.1),\n            0.5 + 0.5 * sin(y * 0.03 + time))\n    }\n}\n\n// Draw the virtual fixtures in their current colours.\nloop {\n    if (frameNumber % 4 == 0) showPatch(patch)\n}\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "dmx-artpoll" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3. ArtPoll: who is out there (run)" "frame" #afield/rect [580.0 520.0 380.0 70.0] "code" #afield/file-inline {"path" "dmx-artpoll_code_.kt" "inline" "import afield.dmx.*\n\n// Art-Net discovery: send one ArtPoll and list every node that answers within a second.\n// With the receiver box running, Field itself answers. Try \"255.255.255.255\" on a real network.\nartPoll(\"127.0.0.1\").forEach { println(it) }\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "dmx-sacn-matrix" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4. sACN: an image on an RGBW matrix (launch)" "frame" #afield/rect [1200.0 60.0 380.0 70.0] "code" #afield/file-inline {"path" "dmx-sacn-matrix_code_.kt" "inline" "import afield.dmx.*\n\n// sACN (E1.31) out and back in, in one box: an image shown on a 16 x 8 matrix of RGBW fixtures.\n// 128 RGBW fixtures x 4 slots fill universe 10 exactly; the matrix is wired serpentine, as most are.\nval patch = Patch(startUniverse = 10)\npatch.grid(16, 8, spacing = 10.0, profile = FixtureProfile.RGBW, serpentine = true)\n\n// Any Img will do (imgFromFile(\"...\") for a file); here a small gradient made in place.\nval img = Img(64, 32, 3, FloatArray(64 * 32 * 3) { i ->\n    val x = (i / 3) % 64 / 63f\n    val y = (i / 3) / 64 / 31f\n    when (i % 3) {\n        0 -> x\n        1 -> y\n        else -> 1f - x\n    }\n})\n\nval out = sacnOut(\"127.0.0.1\")   // host = null sends to multicast 239.255.0.10 instead\nval node = sacnIn()              // Field as an sACN receiver on UDP 5568\n\n// On the sender's clock: sample the image, then sweep a wave of brightness across it.\npatch.animate(out) { t ->\n    mapImage(img)\n    fixtures.forEach { it.dimmer = 0.55 + 0.45 * sin(t * 3.0 - it.position.x * 0.05) }\n}\n\n// What we patched, and universe 10 as it came back over the network, decoded as RGBW fixtures in\n// wire order — every other row runs backwards, because the matrix is wired serpentine.\nloop {\n    if (frameNumber % 6 == 0) {\n        showPatch(patch, channel = \"matrix\", w = 480.0, h = 260.0)\n        showUniverse(node, 10, profile = FixtureProfile.RGBW, cols = 16, w = 480.0, h = 260.0)\n    }\n}\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "dmx-receiver" #afield/box "dmx-sender" #afield/box "dmx-artpoll" #afield/box "dmx-sacn-matrix"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}