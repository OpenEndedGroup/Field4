{"version" 2 "boxes" [{"id" "three-output-scene" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 — one scene, two kinds of thing" "frame" #afield/rect [60.0 60.0 480.0 100.0] "code" #afield/file-inline {"path" "three-output-scene_code_.kt" "inline" "// ONE SCENE, TWO KINDS OF THING.\n//\n// Before `Box.three { }`, a solid and the lines that annotate it could not share a\n// viewer: TriMeshes went to the CPU rasterizer and came back as a still picture, and\n// FLines went to the three.js viewer. This box is the thing that was impossible.\n//\n// A gyroid marched inside a finite box is an OPEN surface -- it leaves the sampling\n// window rather than closing inside it, and every place it does that is a boundary\n// loop. A shaded surface hides exactly that: the rim reads as a silhouette.\n\nval surface = marchingCubes(sdfGyroid(4.0, 0.3), boundsAround(radius = 1.0), 72)\nprintln(surface.summary())        // ... chi=-20, genus 4, open(20)\n\n// The rim, as FLines, in the mesh's own coordinates. One closed ring per hole.\nval rims = surface.toFLines(MeshLines.BOUNDARY).map { ring ->\n    ring.color = vec(1.0, 0.45, 0.12, 1.0)\n    ring.thickness = 2.6\n    ring\n}\nprintln(\"open boundary loops: \" + rims.size)\n\nthree(channel = \"gyroid\", height = 470, width = 760) {\n    mesh(surface, wireframe = false)\n    lines(rims)\n    camera(yaw = 32.0, pitch = 20.0, distance = 2.05)\n    title(\"marched gyroid, with its \" + rims.size + \" open boundary loops drawn in the same scene\")\n    caption(\"the solid and the annotation are one scene in model space, so orbiting moves both\")\n}\n\n// Now ORBIT it. The rings stay welded to the surface, because both are in model\n// space and there is one camera. The HUD's counts, top right, are the whole\n// scene's -- the drawables' triangles are added to the FLine half rather than\n// replacing it.\n//\n// Things to try:\n//   mesh(surface, wireframe = true)     // count the triangles\n//   helpers(true)                       // the grid and tripod, off by default for a mesh\n//   MeshLines.CREASES instead of BOUNDARY, for the feature lines a drawing would show\n"} "nested" #{}}} {"id" "three-output-grid" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 — a contact sheet: threeGrid" "frame" #afield/rect [60.0 200.0 480.0 100.0] "code" #afield/file-inline {"path" "three-output-grid_code_.kt" "inline" "// A CONTACT SHEET IS N VIEWPORTS, NOT N VIEWERS.\n//\n// The obvious way to draw four meshes side by side is four iframes, and it is wrong:\n// each iframe is its own WebGL context, Chrome caps live contexts at around sixteen\n// and silently evicts the oldest, and the evicted one comes back as a blank panel\n// with nothing in the console. So a ThreePanel is a VIEWPORT -- one context,\n// setScissorTest and a per-panel setViewport in the render loop.\n//\n// In a GRID each panel frames its OWN bounds, so a small mesh is not lost beside a\n// large one. (A turntable wants the opposite; see the next box.)\n\nval ball = marchingCubes(sdfSphere(1.0), boundsAround(radius = 1.3), 40)\nval drilled = marchingCubes(sdfSubtract(sdfSphere(1.0), sdfCylinder(0.34, 4.0)), boundsAround(radius = 1.3), 64)\nval twisted = marchingCubes(sdfBox(vec(1.2, 1.8, 0.4)).twisted(0.35), boundsAround(radius = 1.2), 72)\nval ring = torusMesh(64, 32, 0.62, 0.24)\n\nthreeGrid(\n    \"marched sphere, resolution 40\" to ball,\n    \"...drilled through: the drill added a handle\" to drilled,\n    \"sdfBox(...).twisted(0.35)\" to twisted,\n    \"torusMesh(64, 32) - genus 1 by construction\" to ring,\n    columns = 2,\n    facts = true,               // <- OFF by default, and showMeshGrid does not turn it on\n    cellWidth = 430,\n    height = 760,\n    channel = \"grid\",\n    view = MeshView(pitchDegrees = 44.0),\n)\n\n// Things to try:\n//   facts = false               // the fact line under each panel disappears; this is\n//                               // what `showMeshGrid(...)` gives you\n//   columns = 4                 // one WebGL context re-tiles itself\n//   view = MeshView(pitchDegrees = 12.0)   // the drilled bore leaves the frame\n"} "nested" #{}}} {"id" "three-output-turntable" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 — a turntable: one upload, four angles" "frame" #afield/rect [60.0 340.0 480.0 100.0] "code" #afield/file-inline {"path" "three-output-turntable_code_.kt" "inline" "// A TURNTABLE IS THE OPPOSITE OF A GRID, IN TWO WAYS.\n//\n//  * the mesh is added once with `panel = -1`, which means EVERY panel -- one upload\n//    of the buffer rather than the same buffer sent four times;\n//  * every panel frames the SAME bounds, so the shape does not appear to breathe as\n//    it rotates.\n//\n// Only the Kotlin side knows which of the two shapes it is building, which is why\n// ThreePanel.bounds is computed here and not in the viewer.\n\nval twisted = marchingCubes(sdfBox(vec(1.2, 1.8, 0.4)).twisted(0.35), boundsAround(radius = 1.2), 80)\nprintln(twisted.summary())\n\nthreeTurntable(twisted, channel = \"turntable\", height = 290)\n\n// Four viewpoints is usually the difference between \"that looks plausible\" and \"yes,\n// that is the shape\". This solid is a good advertisement: at yaw 0 and 180 it is a\n// narrow crescent, at 90 and 270 a broad S.\n//\n// Things to try:\n//   threeTurntable(twisted, views = MeshView.turntable(6, pitchDegrees = 40.0), height = 240)\n//   threeTurntable(twisted, wireframe = false)\n"} "nested" #{}}} {"id" "three-output-renderers" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 — the same mesh, both renderers" "frame" #afield/rect [60.0 480.0 480.0 100.0] "code" #afield/file-inline {"path" "three-output-renderers_code_.kt" "inline" "// WHICH RENDERER DREW THIS, AND WHY THE CPU ONE IS STILL HERE.\n//\n// `showMesh` defaults to MeshRenderer.GPU now -- the three.js viewer, orbitable. The\n// CPU z-buffer rasterizer in VisionGeometryPreview is not deprecated:\n//\n//   * it is DETERMINISTIC, which is why six test classes assert on its pixels\n//     (MeshDefectRenderTest, SolidSLRenderProofTest, MeshIoTest, MeshFromDiskTest,\n//     AssimpSceneBridgeTest, MeshVisualizerPixelTest). A GPU capture cannot be an\n//     oracle;\n//   * it needs no WebGL context, so it draws the inline value-visualizer card that\n//     appears when a box ends on a TriMesh -- an iframe per mesh in a list of values\n//     is a bad trade, and it is the same ~16-context ceiling ThreePanel dodges;\n//   * it renders into a PIXEL BUFFER (TriMesh.renderPixels), for compositing by hand.\n//\n// Run this and compare the two output channels.\n\nval solid = marchingCubes(\n    sdfSmoothUnion(sdfSphere(0.78), sdfBox(vec(2.1, 0.32, 0.32)), k = 0.28),\n    boundsAround(radius = 1.35), 64,\n)\nval view = MeshView(width = 520, height = 400, wireframe = true)\n\n// NOTE `height = view.height`. `showMesh`'s own `height` (default 430) sizes the\n// IFRAME; MeshView.height sizes the RASTER. Without this the two frames differ.\nshowMesh(solid, channel = \"three.js - the default\", view = view, height = view.height,\n         renderer = MeshRenderer.GPU, title = \"MeshRenderer.GPU - MeshStandardMaterial, orbitable\")\nshowMesh(solid, channel = \"the CPU rasterizer\", view = view,\n         renderer = MeshRenderer.CPU, title = \"MeshRenderer.CPU - two-light lambert, deterministic, still\")\n\n// The shading differs and is not meant to match. The INPUT is held identical:\n// toThreeDrawable mirrors toCapturedMesh step for step -- the same 35-degree crease\n// angle for missing normals, the same DEFAULT_SURFACE grey, back-face culling on so\n// a wrongly-wound face is MISSING in both. The fact line under each is the same\n// sentence, from one implementation.\n//\n// The framing is NOT identical, and that is deliberate: the viewer uses the camera\n// preset for DIRECTION only and then zoom-to-fits the frame it was actually handed,\n// so MeshView.distance becomes a padding factor, max(1.02, distance / 2.7 * 1.06).\n// Try distance = 1.0 and distance = 4.0 on the GPU half and watch only the second\n// one do anything.\n"} "nested" #{}}} {"id" "three-output-winding" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5 — the winding diagnostic, in both renderers" "frame" #afield/rect [60.0 620.0 480.0 100.0] "code" #afield/file-inline {"path" "three-output-winding_code_.kt" "inline" "// THE DIAGNOSTIC THAT HAD TO SURVIVE THE SWITCH.\n//\n// A face wound the wrong way is MISSING under back-face culling -- not dark, gone. The polytope and\n// typography docs pages both teach that as a winding test, so the move to the viewer was not allowed\n// to switch it off. `ThreeDrawStyle.surface(cullBackFaces = true)` is the default; MeshView's\n// cullBackFaces is the rasterizer's. Run this and look at both channels.\n//\n// Reverse the winding of one band of triangles. Not one vertex moves.\nval ball = icosphereMesh(3, 0.8)\nval idx = ball.indices.copyOf()\nvar reversed = 0\nfor (t in 0 until ball.triangleCount) {\n    val cy = (ball.position(ball.ia(t)).y + ball.position(ball.ib(t)).y + ball.position(ball.ic(t)).y) / 3.0\n    if (cy > 0.30) {\n        val b = idx[t * 3 + 1]; idx[t * 3 + 1] = idx[t * 3 + 2]; idx[t * 3 + 2] = b\n        reversed++\n    }\n}\nval holed = TriMesh(ball.positions.copyOf(), idx)\n\nprintln(\"reversed %d of %d triangles; not one vertex moved\".format(reversed, ball.triangleCount))\nprintln(\"volume  %.4f  ->  %.4f\".format(ball.signedVolume(), holed.signedVolume()))\nprintln(\"consistently oriented: \" + holed.topology().isConsistentlyOriented)\n\nval view = MeshView(width = 460, height = 380, yawDegrees = 18.0, pitchDegrees = 38.0, wireframe = true)\nshowMesh(holed, channel = \"three.js\", view = view, height = view.height, renderer = MeshRenderer.GPU,\n         title = \"the band is GONE, not dark\")\nshowMesh(holed, channel = \"the CPU rasterizer\", view = view,\n         renderer = MeshRenderer.CPU, title = \"...and gone here too, which is the whole point\")\n\n// ORBIT the three.js panel: you are looking through the shell at the inside of its far side.\n//\n// Then read the numbers against the picture. signedVolume is quietly, catastrophically wrong. The\n// fact line still says chi=2 genus 0 watertight, because chi counts vertices, edges and faces and\n// reversing a triangle changes none of them -- topology is not orientation. Only\n// topology().isConsistentlyOriented says so, and fixWinding() is the repair.\n//\n// Things to try:\n//   showMesh(holed.fixWinding(), ...)          // the hole closes and the volume comes back\n//   MeshView(..., cullBackFaces = false)       // the band returns, shaded inside-out\n//   the three.js wireframe is NOT culled, so the missing triangles' edges are still drawn\n"} "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isDatalogRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}