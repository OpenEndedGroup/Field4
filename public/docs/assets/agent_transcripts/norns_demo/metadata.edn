{"version" 2 "boxes" [{"id" "norns_root" "properties" {"children" #{#afield/box "norns_orbits" #afield/box "norns_orbits_render" #afield/box "norns_fetch" #afield/box "norns_noiz" #afield/box "norns_noiz_render" #afield/box "norns_anima_render"} "parents" #{#afield/box "root"} "name" "status — children of this box are Lua" "_tombstone" false "frame" #afield/rect [40.0 40.0 460.0 80.0] "mainLanguage" "lua" "code" #afield/file-inline {"path" "norns_root_code_.kt" "inline" "// This root stays Kotlin; its `mainLanguage` makes the boxes under it Lua.\nprintln(afield.lang.lua.LuaLibrary.describe())\n"}}} {"id" "norns_orbits_render" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "norns_root"} "name" "orbits, rendered" "_tombstone" false "frame" #afield/rect [280.0 180.0 200.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "norns_orbits_render_code_.kt" "inline" "-- Run (not launch): the \"orbits\" box's script, offline, in virtual time, for eight seconds.\n-- E2 speeds it up at 2 s, K3 rerolls the orbits at 4 s, E3 closes the filter at 5 s.\nlocal norns = require \"norns\"\nlocal heard = norns.render {\n  code = field.named(\"orbits\").code, name = \"orbits\", seconds = 8,\n  events = { { 2, \"enc\", 2, 30 }, { 4, \"key\", 3, 1 }, { 4.1, \"key\", 3, 0 }, { 5, \"enc\", 3, -60 } },\n  wav = os.getenv(\"HOME\") .. \"/.afield/norns/renders/orbits.wav\",\n  png = os.getenv(\"HOME\") .. \"/.afield/norns/renders/orbits.png\",\n}\nprint(string.format(\"%.1f s, peak %.2f, rms %.3f, %d onsets\", heard.seconds, heard.peak, heard.rms, heard.onsets))\nprint(\"tempo now\", params:get(\"tempo\"), \"cutoff\", math.floor(params:get(\"cutoff\")))\n"}}} {"id" "norns_orbits" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "norns_root"} "name" "orbits" "_tombstone" false "frame" #afield/rect [40.0 180.0 200.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "norns_orbits_code_.kt" "inline" "-- orbits: a norns script, written in this box\n-- E2 tempo, E3 brightness (filter cutoff)\n-- K2 play / stop, K3 new orbits\nlocal norns = require(\"norns\").reset()\nlocal musicutil = require \"musicutil\"\nengine.name = \"PolyPerc\"\n\nlocal scale = musicutil.generate_scale(48, \"Dorian\", 3)\nlocal planets, playing, flash = {}, true, 0\n\nlocal function reroll()\n  planets = {}\n  for i = 1, 5 do\n    planets[i] = { r = 6 + i * 5, a = math.random() * 2 * math.pi, steps = ({ 3, 4, 5, 6, 8 })[i], at = 0 }\n  end\nend\n\nfunction init()\n  math.randomseed(7)\n  params:add_control(\"cutoff\", \"cutoff\", controlspec.new(200, 6000, \"exp\", 0, 1200, \"hz\"))\n  params:set_action(\"cutoff\", function(v) engine.cutoff(v) end)\n  params:add_number(\"tempo\", \"tempo\", 40, 240, 110)\n  params:set_action(\"tempo\", function(v) params:set(\"clock_tempo\", v) end)\n  params:bang()\n  engine.release(0.6); engine.amp(0.4)\n  reroll()\n  clock.run(function()\n    while true do\n      clock.sync(1 / 4)\n      if playing then\n        for i, p in ipairs(planets) do\n          p.at = (p.at + 1) % p.steps\n          p.a = p.a + 2 * math.pi / (p.steps * 4)\n          if p.at == 0 then\n            engine.pan(math.cos(p.a) * 0.6)\n            engine.hz(musicutil.note_num_to_freq(scale[i * 2 + math.floor(p.a * 2) % 4]))\n            p.flash = 4\n          end\n        end\n      end\n    end\n  end)\n  local m = metro.init(function()\n    for _, p in ipairs(planets) do if (p.flash or 0) > 0 then p.flash = p.flash - 1 end end\n    redraw()\n  end, 1 / 15)\n  m:start()\nend\n\nfunction redraw()\n  screen.clear()\n  screen.aa(0)\n  screen.level(2)\n  for _, p in ipairs(planets) do screen.circle(40, 32, p.r); screen.stroke() end\n  screen.level(15); screen.circle(40, 32, 2); screen.fill()\n  for _, p in ipairs(planets) do\n    screen.level((p.flash or 0) > 0 and 15 or 6)\n    screen.circle(40 + p.r * math.cos(p.a), 32 + p.r * math.sin(p.a), (p.flash or 0) > 0 and 3 or 2)\n    screen.fill()\n  end\n  screen.level(10); screen.font_size(8)\n  screen.move(80, 12); screen.text(\"orbits\")\n  screen.level(4)\n  screen.move(80, 28); screen.text(\"bpm \" .. params:get(\"tempo\"))\n  screen.move(80, 38); screen.text(\"cut \" .. math.floor(params:get(\"cutoff\")))\n  screen.move(80, 54); screen.text(playing and \"playing\" or \"stopped\")\n  screen.update()\nend\n\nfunction enc(n, d)\n  if n == 2 then params:delta(\"tempo\", d) elseif n == 3 then params:delta(\"cutoff\", d) end\nend\n\nfunction key(n, z)\n  if z == 0 then return end\n  if n == 2 then playing = not playing elseif n == 3 then reroll() end\nend\n\nnorns.start()   -- launch this box\n"}}} {"id" "norns_noiz" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "norns_root"} "name" "noiz virus" "_tombstone" false "frame" #afield/rect [40.0 460.0 200.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "norns_noiz_code_.kt" "inline" "-- Launch: SPIKE the Percussionist's noiz virus, live. Fetch it first (the box above).\n-- K2 plays and stops, K3 back to the start, E1 virus, E2 window, E3 mutation (the buttons\n-- in the controls panel). The NoiZ Temple splash goes at the first key.\nfield.budget = 30\nrequire(\"norns\").run(os.getenv(\"HOME\") .. \"/.afield/norns/code/noiz_virus/noiz_virus.lua\")\n"}}} {"id" "norns_noiz_render" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "norns_root"} "name" "noiz virus, rendered" "_tombstone" false "frame" #afield/rect [280.0 460.0 200.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "norns_noiz_render_code_.kt" "inline" "-- Run: noiz virus offline for 12 s: skip the splash, K2 at 3 s to play, E1 to another virus at 8 s.\nfield.budget = 60\nlocal norns = require \"norns\"\nlocal renders = os.getenv(\"HOME\") .. \"/.afield/norns/renders/\"\nlocal heard = norns.render {\n  script = os.getenv(\"HOME\") .. \"/.afield/norns/code/noiz_virus/noiz_virus.lua\", seconds = 12,\n  events = { { 0.5, \"key\", 2, 1 }, { 0.6, \"key\", 2, 0 }, { 3, \"key\", 2, 1 }, { 3.1, \"key\", 2, 0 },\n             { 8, \"enc\", 1, 3 } },\n  screens = { { 0.2, renders .. \"noiz_virus_splash.png\" }, { 6, renders .. \"noiz_virus_6s.png\" } },\n  wav = renders .. \"noiz_virus.wav\", png = renders .. \"noiz_virus_end.png\",\n}\nprint(string.format(\"%.1f s, peak %.2f, rms %.3f, %d onsets\", heard.seconds, heard.peak, heard.rms, heard.onsets))\nlocal c = norns.coverage()\nprint(\"stubbed: \" .. table.concat(c.stubbed, \", \"))\nprint(\"missing: \" .. table.concat(c.missing, \", \"))\n"}}} {"id" "norns_anima_render" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "norns_root"} "name" "anima, rendered" "_tombstone" false "frame" #afield/rect [520.0 460.0 200.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "norns_anima_render_code_.kt" "inline" "-- Run: om-i-god's anima offline for 10 s, its petals growing on the golden angle.\nfield.budget = 60\nlocal norns = require \"norns\"\nlocal renders = os.getenv(\"HOME\") .. \"/.afield/norns/renders/\"\nlocal heard = norns.render {\n  script = os.getenv(\"HOME\") .. \"/.afield/norns/code/anima/anima.lua\", seconds = 10,\n  events = { { 1, \"enc\", 1, 4 }, { 3, \"key\", 2, 1 }, { 3.1, \"key\", 2, 0 } },\n  wav = renders .. \"anima.wav\", png = renders .. \"anima_end.png\",\n}\nprint(string.format(\"%.1f s, peak %.2f, rms %.3f, %d onsets\", heard.seconds, heard.peak, heard.rms, heard.onsets))\nlocal c = norns.coverage()\nprint(\"stubbed: \" .. table.concat(c.stubbed, \", \"))\nprint(\"missing: \" .. table.concat(c.missing, \", \"))\n"}}} {"id" "norns_fetch" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "norns_root"} "name" "fetch the scripts" "_tombstone" false "frame" #afield/rect [40.0 320.0 200.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "norns_fetch_code_.kt" "inline" "-- Fetch two norns scripts from their authors' GitHub repositories into ~/.afield/norns/code/.\n-- Neither repository states a licence, so Field does not ship them; this box clones them for you.\nfield.budget = 120\nlocal code = os.getenv(\"HOME\") .. \"/.afield/norns/code/\"\nos.execute('mkdir -p \"' .. code .. '\"')\nfor _, repo in ipairs { \"SPIKE-the-Percussionist/noiz_virus\", \"om-i-god/anima\" } do\n  local name = repo:match(\"/(.+)$\")\n  local dir = code .. name\n  local f = io.open(dir .. \"/\" .. name .. \".lua\")\n  if f then f:close(); print(name, \"already in\", dir)\n  else\n    local ok = os.execute('git clone -q --depth 1 https://github.com/' .. repo .. ' \"' .. dir .. '\"')\n    print(name, (ok == 0 or ok == true) and \"cloned into\" or \"could not be cloned into\", dir)\n  end\nend\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole" "mainLanguage"]}