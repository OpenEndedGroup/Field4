{"version" 2 "boxes" [{"id" "nonlinear_svf" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - ZdfSvf as an oscillator" "_tombstone" false "frame" #afield/rect [60.0 260.0 520.0 140.0] "code" #afield/file-inline {"path" "nonlinear_svf_code_.kt" "inline" "// A self-oscillating ZdfSvf band-pass: faint noise in, a sine-like tone at the cutoff out.\n// Its saturating damping holds the oscillation steady; the pitch slider glides over 40 ms.\nval pitch = Param(220f)\nval resonance = Param(1.05f)\nslider(\"pitch (Hz)\", min = 55.0, max = 1760.0, initialValue = 220.0) { pitch.base = it.toFloat() }\nslider(\"resonance\", min = 0.9, max = 1.2, initialValue = 1.05) { resonance.base = it.toFloat() }\nval voice = WhiteNoise() * 0.02f / ZdfSvf(SVFMode.BP, pitch.smoothed(0.04f), resonance.smoothed(0.04f))\naudio(voice, gain = 0.3f)\n"}}} {"id" "nonlinear_adaa" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - tanh with and without ADAA" "_tombstone" false "frame" #afield/rect [60.0 460.0 520.0 140.0] "code" #afield/file-inline {"path" "nonlinear_adaa_code_.kt" "inline" "/*\nA sine driven into tanh twice, once naive and once with ADAA; the crossfade slider picks\nbetween them. Raise the frequency past 3 kHz and listen for\nthe inharmonic tones under the naive one.\n*/\nval freq = Param(1000f)\nval mix = Param(0f)\nslider(\"frequency (Hz)\", min = 100.0, max = 8000.0, initialValue = 1000.0) { freq.base = it.toFloat() }\nslider(\"naive 0 … ADAA 1\", min = 0.0, max = 1.0, initialValue = 0.0) { mix.base = it.toFloat() }\nval sine = SineOsc(freq.smoothed(0.03f))\nval smoothMix = mix.smoothed(0.03f)\nval naive = sine / Waveshaper.tanh(6.p)\nval adaa = sine / AdaaShaper(AdaaShape.TANH, 6.p)\naudio(naive * (Param(1f) - smoothMix) + adaa * smoothMix, gain = 0.15f)\n"}}} {"id" "nonlinear_ladder" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - ZdfLadder with sliders" "_tombstone" false "frame" #afield/rect [60.0 60.0 520.0 140.0] "code" #afield/file-inline {"path" "nonlinear_ladder_code_.kt" "inline" "// A 55 Hz saw through the zero-delay-feedback ladder. The sliders write plain Params;\n// smoothed() glides each change over 30 ms so dragging a slider never clicks.\nval cutoff = Param(800f)\nval resonance = Param(0.7f)\nval drive = Param(1.5f)\nslider(\"cutoff (Hz)\", min = 60.0, max = 6000.0, initialValue = 800.0) { cutoff.base = it.toFloat() }\nslider(\"resonance (sings past 1)\", min = 0.0, max = 1.2, initialValue = 0.7) { resonance.base = it.toFloat() }\nslider(\"drive\", min = 0.2, max = 8.0, initialValue = 1.5) { drive.base = it.toFloat() }\nval voice = SawOsc(55.p) * 0.5f / ZdfLadder(cutoff.smoothed(0.03f), resonance.smoothed(0.03f), drive.smoothed(0.03f))\naudio(voice, gain = 0.3f)\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}