{"version" 2 "boxes" [{"id" "orca_duet" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "ORCA duet · run me" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 60.0] "code" #afield/file-inline {"path" "orca_duet_code_.kt" "inline" "// Two ORCAs and Kotlin in between. Lead plays a tune in twos; Kotlin hands each note to\n// Echo, which plays the last eight back in threes, an octave up; every eighth note Echo\n// plays, Kotlin moves one note of Lead's tune a step up the scale. Click a grid to join in.\nval synth = PatSynthBank()\nval lead = orca(\"lead\", cols = 40, rows = 9, grid = \"\"\"\n    #.LEAD.#\n    .\n    .2C8\n    D2.8TCDEGAGED\n    .:04\n    .\n    D8\n    .:12C\n\"\"\")\nval echo = orca(\"echo\", cols = 40, rows = 6, grid = \"\"\"\n    #.ECHO.#\n    .\n    .3C8\n    D3.8TCCCCCCCC\n    .:25\n\"\"\")\nval up = mapOf('C' to 'D', 'D' to 'E', 'E' to 'G', 'G' to 'A', 'A' to 'C')\nval heard = ArrayDeque(\"CCCCCCCC\".toList())\nvar echoes = 0\nvar nudged = \"none yet\"\n\nlead.onNote {\n    if (it.channel == 0) { heard.addLast(it.note[0]); heard.removeFirst() }\n    synth.play(it, pan = 0.35, wave = if (it.channel == 1) PatWave.SINE else PatWave.TRIANGLE)\n}\necho.onNote {\n    echoes++\n    synth.play(it, pan = 0.7, wave = PatWave.SQUARE, gain = 0.35, cutoffHz = 2400.0)\n}\n\ndisplayOpen(\"between\")\n// The go-between. A box launches what it ends with: here the synth, and this loop beside it.\nsynth + frames {\n    var seen = -1\n    while (frame()) {\n        if (lead.frame == seen) continue\n        seen = lead.frame\n        // Lead to Echo: Echo's track is always the last eight notes Lead played.\n        heard.forEachIndexed { i, note -> echo[5 + i, 3] = note }\n        // Echo to Lead: every eighth echo moves one note of Lead's tune up the scale.\n        if (echoes >= 8) {\n            echoes = 0\n            val x = 5 + seen % 8\n            val note = up[lead[x, 3]] ?: 'C'\n            nudged = \"lead[$x, 3] ${lead[x, 3]} → $note\"\n            lead[x, 3] = note\n        }\n        // The bass follows the tune: F under G and A, C under the rest.\n        lead[4, 7] = if (lead[4, 4] in \"GA\") 'F' else 'C'\n        markdown(\"between\", \"heard `${heard.joinToString(\"\")}` · last nudge `$nudged`\")\n    }\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_session" "fileManagerAccessHistory"]}