{"version" 2 "boxes" [{"id" "profile_capture" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4. Record and explore" "_tombstone" false "frame" #afield/rect [520.0 250.0 350.0 105.0] "code" #afield/file-inline {"path" "profile_capture_code_.kt" "inline" "// Run the three workload boxes first, then run this box. The macro does that for you.\n// Drag the overview, Zoom to selection, choose Allocated bytes, and click a lane.\n// Open current box code returns you to the code behind a measured coroutine.\n// Hot code adds sampled classes, methods and box lines, including background threads.\nCoroutineProfiles.request(thisBox.inside.filename, CoroutineProfileRequest(\"start\", 3.0, stacks = true))\nthisBox.inBrowser(\"window.showProfilingTimeline()\")\nprintln(\"Recording three seconds. The timeline will latch automatically.\")\n"}}} {"id" "profile_steady" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1. Steady work" "_tombstone" false "frame" #afield/rect [80.0 80.0 320.0 105.0] "code" #afield/file-inline {"path" "profile_steady_code_.kt" "inline" "// A small amount of CPU work at roughly 60 Hz. Increase iterations to widen the bars.\nval iterations = 18000\nvar checksum = 0.0\nloop {\n    repeat(iterations) { checksum += kotlin.math.sin(it.toDouble()) }\n    delay(16) // suspension should be a gap, not charged CPU time\n}\n"}}} {"id" "profile_bursts" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2. Periodic bursts" "_tombstone" false "frame" #afield/rect [80.0 250.0 320.0 105.0] "code" #afield/file-inline {"path" "profile_bursts_code_.kt" "inline" "// Sparse, longer CPU bars. Try 800000 iterations, or shorten the quiet interval.\nval iterations = 350000\nval quietMillis = 240\nvar checksum = 0.0\nframes {\n    while (frame()) {\n        repeat(iterations) { checksum += kotlin.math.cos(it.toDouble()) }\n        delay(quietMillis)\n    }\n}\n"}}} {"id" "profile_vectors" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3. Allocate or reuse" "_tombstone" false "frame" #afield/rect [80.0 420.0 320.0 105.0] "code" #afield/file-inline {"path" "profile_vectors_code_.kt" "inline" "// Flip reuse to true, relaunch, and record again. Both paths update the same vectors.\n// vec is Field's linalg constructor; set writes into an existing vector.\nval reuse = false\nval count = 8192\nvar positions = Array(count) { vec(0f, 0f, 0f) }\nvar phase = 0f\nloop {\n    phase += 0.01f\n    if (reuse) {\n        for (i in positions.indices) positions[i].set(i.toFloat(), phase, 0f)\n    } else {\n        positions = Array(count) { vec(it.toFloat(), phase, 0f) }\n    }\n    delay(16)\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}