{"version" 2 "boxes" [{"id" "surface" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - A performer's surface" "_tombstone" false "frame" #afield/rect [60.0 60.0 260.0 110.0] "code" #afield/file-inline {"path" "surface_code_.kt" "inline" "var cutoff = 800.0\nvar orbit = Vector2f(0.3f, 0.2f)\nvar armed = true\nvar title = \"orbit\"\nvar tint = Vector4f(0.05f, 0.78f, 0.93f, 1f)\nfun draw() {\n    val c = \"rgba(${(tint.x * 255).toInt()},${(tint.y * 255).toInt()},${(tint.z * 255).toInt()},${tint.w})\"\n    val r = 10 + 40 * kotlin.math.log10(cutoff / 20.0) / 3.0\n    val dot = if (armed) \"<circle cx='${150 + orbit.x * 120}' cy='${150 - orbit.y * 120}' r='${r.f1}' fill='$c'/>\" else \"\"\n    display(\"figure\", \"\"\"\n        <svg width=\"300\" height=\"300\" style=\"background:#05080a;border:1px solid #136178\">\n          <line x1=\"150\" y1=\"150\" x2=\"${150 + orbit.x * 120}\" y2=\"${150 - orbit.y * 120}\" stroke=\"#136178\"/>$dot\n        </svg>\n        <div style=\"font:18px Iosevka,monospace;color:#0cc8ed\">$title  cutoff ${cutoff.toInt()} Hz</div>\n    \"\"\".trimIndent())\n}\ncontrolGroup(\"controls\") {\n    slider(\"cutoff\", min = 20.0, max = 20000.0, initialValue = 800.0, law = ControlLaw.LOGARITHMIC) { cutoff = it; draw() }\n    vec2Control(\"orbit\", initialValue = Vector2f(0.3f, 0.2f), step = 0.01) { orbit = it; draw() }\n    checkbox(\"armed\", initialValue = true) { armed = it; draw() }\n    stringInput(\"title\", initialValue = \"orbit\") { title = it; draw() }\n    colorPicker(\"tint\", initialValue = Vector4f(0.05f, 0.78f, 0.93f, 1f)) { tint = it; draw() }\n}\ndisplayOpen(\"controls\")\ndraw()\ndisplayOpen(\"figure\")\n"}}} {"id" "rerender" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - A slider that rebuilds itself mid-drag" "_tombstone" false "frame" #afield/rect [680.0 60.0 260.0 110.0] "code" #afield/file-inline {"path" "rerender_code_.kt" "inline" "// Drag \"gain\" from left to right. When it passes 0.5 the callback rebuilds this group,\n// replacing the slider's DOM under the pointer; the drag continues on the new one.\nvar rebuilt = 0\nfun surface() {\n    controlGroup(\"controls\") {\n        slider(\"gain\", 0.0, 1.0, 0.01, 0.2) {\n            display(\"seen\", \"<div style='font:18px Iosevka,monospace;color:#0cc8ed'>gain ${it.f2}  rebuilt $rebuilt</div>\")\n            if (it > 0.5 && rebuilt == 0) { rebuilt++; surface() }\n            if (it < 0.3) rebuilt = 0\n        }\n    }\n}\nsurface()\ndisplayOpen(\"controls\")\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}