{"version" 2 "boxes" [{"id" "imgui_vr_panel" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "imgui_vr_renderer"} "name" "imgui vr panel" "_tombstone" false "frame" #afield/rect [300.0 140.0 300.0 100.0] "code" #afield/file-inline {"path" "imgui_vr_panel_code_.kt" "inline" "// ImGui as a VR panel.\n//\n// ImGuiVrPanelDemo wires the whole pipeline: an ImGuiRenderToTexture drawn into an RTT,\n// textured onto a world-space ImGuiPanel quad, rendered once per eye by\n// SideBySideStereoTarget, packed side-by-side, and blitted to the window. The panel is\n// interactive: the mock controller (here driven by the mouse) casts a ray, the hit is\n// converted to panel UV, and injected into ImGui.\n//\n// Move the mouse to aim the ray; left-click to press. To bind the panel to a hand instead\n// of a fixed point, call panel.place(handPos, handRight, handUp) each frame (see ImGuiPanel).\nimport afield.four.Renderer\nimport afield.four.modules.fromContext\nimport afield.four.targets.SideBySideStereoTarget\nimport afield.examples.four.ImGuiVrPanelDemo\n\nval renderer: Renderer = fromContext()\nval sbs = SideBySideStereoTarget(renderer)\nval demo = ImGuiVrPanelDemo(renderer.window, renderer, sbs)\ndemo.build()\n\n// Mouse drives the mock controller ray on the desktop (a real controller drives it in XR).\nsbs.enableMouseController(distanceMeters = 0.001f)\n\nprintln(\"imgui vr panel ready — move the mouse to aim the ray, click to press\")\n"}}} {"id" "imgui_vr_renderer" "properties" {"children" #{#afield/box "imgui_vr_panel"} "parents" #{#afield/box "root"} "name" "window + renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "imgui_vr_renderer_code_.kt" "inline" "import afield.four.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\n\nonce.renderer {\n    window = Window(\"ImGui VR panel\")\n    Renderer(window)\n}\n\nprintln(\"imgui vr renderer ready\")\nstart(renderer::run)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}