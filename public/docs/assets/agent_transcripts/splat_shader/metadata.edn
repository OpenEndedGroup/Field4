{"version" 2 "boxes" [{"id" "splat_fern_veins" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "splat_renderer"} "name" "fern veins" "_tombstone" false "frame" #afield/rect [40.0 1120.0 300.0 100.0] "code" #afield/file-inline {"path" "splat_fern_veins_code_.kt" "inline" "import afield.graphics.scene.fabricated.ProceduralSplats\nimport afield.graphics.scene.fabricated.SplatShader\nimport afield.graphics.scene.fabricated.showControls\n\n/*\nFern veins. The splats along the frond's midrib glow green and sway; away from it they\ndarken and thin, so the frond reads as veins in the dark.\n*/\nvar module = computeModuleHere {}\n\nval splats = SplatShader(module, ProceduralSplats.fernPlume())\nshowControls(splats)\n"} "compute" #afield/file-inline {"path" "splat_fern_veins_compute_.glsl" "inline" "#version 450\n#include \"splat/insert\"\n\nfloat rib = exp(-7.5 * abs(pos.x));\nfloat leaf = sat(1.0 - abs(pos.y) * 0.62);\nfloat flutter = sin(pos.y * 8.0 + pos.z * 5.0 + t * 1.1);\n\npos.x += 0.18 * rib * sin(pos.y * 6.5 + t * 0.9);\npos.z += 0.06 * flutter * leaf;\nrgba.rgb = mix(vec3(0.02, 0.07, 0.03), vec3(0.46, 1.0, 0.38), rib * leaf);\nrgba.a *= 0.16 + 0.84 * rib * leaf;\nscales.xy *= mix(0.48, 1.95, rib * leaf);\n\n#include \"splat/end\"\n"}}} {"id" "splat_pulse_rings" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "splat_renderer"} "name" "pulse rings" "_tombstone" false "frame" #afield/rect [40.0 660.0 300.0 100.0] "code" #afield/file-inline {"path" "splat_pulse_rings_code_.kt" "inline" "import afield.graphics.scene.fabricated.ProceduralSplats\nimport afield.graphics.scene.fabricated.SplatShader\nimport afield.graphics.scene.fabricated.showControls\n\n/*\nPulse rings. A wave travels out from the cloud's axis: each splat rides up and down on\nit, swings round a little, and lights up from cyan to ember as a crest passes.\n*/\nvar module = computeModuleHere {}\n\nval splats = SplatShader(module, ProceduralSplats.phyllotaxisBloom())\nshowControls(splats)\n"} "compute" #afield/file-inline {"path" "splat_pulse_rings_compute_.glsl" "inline" "#version 450\n#include \"splat/insert\"\n\nfloat r = length(pos.xz);\nfloat wave = sin(r * 18.0 - t * 3.5);\nfloat ring = smoothstep(0.92, 1.0, wave);\n\npos.y += wave * 0.045;\npos.xz *= rot2(0.12 * sin(t + r * 4.0));\n\nvec3 cyan = vec3(0.08, 0.85, 1.0);\nvec3 ember = vec3(1.0, 0.54, 0.16);\nrgba.rgb = mix(rgba.rgb, mix(cyan, ember, sat(pos.y * 0.55 + 0.5)), 0.55 + ring * 0.35);\nrgba.a *= 0.52 + ring * 0.48;\nscales *= 0.82 + ring * 1.45;\n\n#include \"splat/end\"\n"}}} {"id" "splat_xray_shell" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "splat_renderer"} "name" "xray shell" "_tombstone" false "frame" #afield/rect [1240.0 1120.0 300.0 100.0] "code" #afield/file-inline {"path" "splat_xray_shell_code_.kt" "inline" "import afield.graphics.scene.fabricated.ProceduralSplats\nimport afield.graphics.scene.fabricated.SplatShader\nimport afield.graphics.scene.fabricated.showControls\n\n/*\nXray shell. Colour by distance from the centre: the core goes dark, the outer shell\npale blue, and a shimmer runs outward through it, nudging the splats as it passes.\n*/\nvar module = computeModuleHere {}\n\nval splats = SplatShader(module, ProceduralSplats.nautilusShell())\nshowControls(splats)\n"} "compute" #afield/file-inline {"path" "splat_xray_shell_compute_.glsl" "inline" "#version 450\n#include \"splat/insert\"\n\nfloat radius = length(pos);\nfloat edge = smoothstep(0.2, 1.2, radius);\nfloat shimmer = 0.5 + 0.5 * sin(radius * 24.0 - t * 4.0);\n\npos += normalize(pos + vec3(0.001)) * shimmer * 0.035;\nrgba.rgb = mix(vec3(0.04, 0.08, 0.1), vec3(0.75, 0.96, 1.0), edge);\nrgba.a *= 0.16 + edge * shimmer * 0.84;\nscales *= vec3(0.55, 0.55, 1.8);\n\n#include \"splat/end\"\n"}}} {"id" "splat_passthrough" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "splat_renderer"} "name" "passthrough" "_tombstone" false "frame" #afield/rect [40.0 200.0 300.0 100.0] "code" #afield/file-inline {"path" "splat_passthrough_code_.kt" "inline" "import afield.graphics.scene.fabricated.ProceduralSplats\nimport afield.graphics.scene.fabricated.SplatSet\nimport afield.graphics.scene.fabricated.SplatShader\nimport afield.graphics.scene.fabricated.showControls\n\n/*\nA splat shader. Every frame, the lines in this box's compute tab run once for each of\nthe cloud's splats, on the GPU, and may change it: move it, recolour it, stretch it,\nfade it. The renderer then sorts the splats by depth and draws them where your lines\nleft them. This one changes nothing, so you see the cloud as it was built.\n\nThe other boxes are the demo's examples, each on a different cloud. Launch one and it\nreplaces this. Try another cloud here too: ProceduralSplats.fernPlume(), nautilusShell(),\ncoralBranches(), phyllotaxisBloom(), torusBraid(); or your own capture,\nSplatSet.fromPly(\"/path/to/splats.ply\"), or a mesh as one disc per vertex,\nSplatSet.fromGltf(\"/path/to/model.glb\").\n*/\nvar module = computeModuleHere {}\n\nval splats = SplatShader(module, ProceduralSplats.icosphereShell())\nshowControls(splats)\n"} "compute" #afield/file-inline {"path" "splat_passthrough_compute_.glsl" "inline" "#version 450\n#include \"splat/insert\"\n\n/*\n  Change these:\n    pos     vec3   the splat's centre\n    scales  vec3   its radii\n    rgba    vec4   its colour and opacity\n    quat    vec4   its rotation, a quaternion\n\n  Read these:\n    index   float  which splat, 0, 1, 2, ...\n    t       float  seconds since the box ran\n    pi\n\n  Helpers: sat(x), rot2(a), hash31(p), noise31(p)\n\n  Afterwards rgba is clamped to 0..1 and every scale kept above 0.0001.\n  This is a passthrough. Copy lines from the other boxes, or write your own.\n*/\n\n#include \"splat/end\"\n"}}} {"id" "splat_dissolve" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "splat_renderer"} "name" "dissolve" "_tombstone" false "frame" #afield/rect [640.0 660.0 300.0 100.0] "code" #afield/file-inline {"path" "splat_dissolve_code_.kt" "inline" "import afield.graphics.scene.fabricated.ProceduralSplats\nimport afield.graphics.scene.fabricated.SplatShader\nimport afield.graphics.scene.fabricated.showControls\n\n/*\nDissolve. A threshold sweeps through a noise field. Where the noise falls below it,\nsplats let go: they drift outward, shrink, burn orange and fade. Every few seconds the\nsweep starts again and the cloud comes back. The splats really do move, so the renderer\nsorts them where they drift to.\n*/\nvar module = computeModuleHere {}\n\nval splats = SplatShader(module, ProceduralSplats.icosphereShell())\nshowControls(splats)\n"} "compute" #afield/file-inline {"path" "splat_dissolve_compute_.glsl" "inline" "#version 450\n#include \"splat/insert\"\n\nfloat n = noise31(pos * 3.2 + vec3(0.0, t * 0.22, 0.0));\nfloat sweep = fract(t * 0.12);\nfloat keep = smoothstep(sweep - 0.08, sweep + 0.12, n);\n\nvec3 drift = normalize(pos + hash31(pos) * 0.4);\npos += drift * (1.0 - keep) * (0.45 + 0.25 * sin(t + index * 0.01));\nrgba.rgb = mix(vec3(1.0, 0.35, 0.12), rgba.rgb, keep);\nrgba.a *= keep;\nscales *= mix(0.18, 1.0, keep);\n\n#include \"splat/end\"\n"}}} {"id" "splat_renderer" "properties" {"children" #{#afield/box "splat_passthrough" #afield/box "splat_pulse_rings" #afield/box "splat_dissolve" #afield/box "splat_gravity_well" #afield/box "splat_fern_veins" #afield/box "splat_lichen_tangle" #afield/box "splat_xray_shell"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "splat_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nOptions.profiling = false\n// once: re-running this box keeps the existing window and renderer\nonce.renderer {\n    window = Window(\"Splat shader\", initialDimensions = Rect(80.0, 80.0, 900.0, 900.0))\n    Renderer(window)\n}\n// the frame loop runs as this box's coroutine; stopping the box stops rendering\nstart(renderer::run)\n"}}} {"id" "splat_lichen_tangle" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "splat_renderer"} "name" "lichen tangle" "_tombstone" false "frame" #afield/rect [640.0 1120.0 300.0 100.0] "code" #afield/file-inline {"path" "splat_lichen_tangle_code_.kt" "inline" "import afield.graphics.scene.fabricated.ProceduralSplats\nimport afield.graphics.scene.fabricated.SplatShader\nimport afield.graphics.scene.fabricated.showControls\n\n/*\nLichen tangle. Five octaves of folded noise grow a canopy over the coral: splats under\nit swell and turn pale green and are pushed a little outward, the rest sink into the\ndark.\n*/\nvar module = computeModuleHere {}\n\nval splats = SplatShader(module, ProceduralSplats.coralBranches())\nshowControls(splats)\n"} "compute" #afield/file-inline {"path" "splat_lichen_tangle_compute_.glsl" "inline" "#version 450\n#include \"splat/insert\"\n\nvec3 p = pos;\nfloat branch = 0.0;\nfloat amp = 0.58;\nfor (int i = 0; i < 5; i++) {\n  branch += amp * abs(noise31(p * 4.2) - 0.5);\n  p = p.yzx * 1.73 + vec3(0.19, -0.07, 0.11);\n  amp *= 0.6;\n}\n\nfloat canopy = sat(1.0 - branch * 1.7);\nvec3 dir = normalize(hash31(floor(pos * 9.0)) - 0.5 + vec3(0.0, 0.35, 0.0));\npos += dir * canopy * 0.12;\nrgba.rgb = mix(vec3(0.04, 0.03, 0.02), vec3(0.78, 0.96, 0.52), canopy);\nrgba.a *= 0.08 + 0.92 * canopy;\nscales *= mix(0.16, 1.85, canopy);\n\n#include \"splat/end\"\n"}}} {"id" "splat_gravity_well" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "splat_renderer"} "name" "gravity well" "_tombstone" false "frame" #afield/rect [1240.0 660.0 300.0 100.0] "code" #afield/file-inline {"path" "splat_gravity_well_code_.kt" "inline" "import afield.graphics.scene.fabricated.ProceduralSplats\nimport afield.graphics.scene.fabricated.SplatShader\nimport afield.graphics.scene.fabricated.showControls\n\n/*\nGravity well. Splats near the vertical axis are pulled harder: they spin faster round\nit, bob, swell and glow violet, while those far out stay faint.\n*/\nvar module = computeModuleHere {}\n\nval splats = SplatShader(module, ProceduralSplats.torusBraid())\nshowControls(splats)\n"} "compute" #afield/file-inline {"path" "splat_gravity_well_compute_.glsl" "inline" "#version 450\n#include \"splat/insert\"\n\nfloat r = length(pos.xz) + 0.001;\nfloat pull = 0.22 / (0.22 + r * r);\nfloat spin = t * 0.8 + pull * 3.0;\n\npos.xz *= rot2(spin);\npos.y -= pull * 0.45 * sin(t * 1.2 + r * 8.0);\nrgba.rgb = mix(rgba.rgb, vec3(0.88, 0.68, 1.0), pull);\nrgba.a *= 0.35 + sat(r * 1.4);\nscales *= 0.65 + pull * 2.4;\n\n#include \"splat/end\"\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}