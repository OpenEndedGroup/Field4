{"version" 2 "boxes" [{"id" "gpr_dimensions" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "what the pad drops" "_tombstone" false "frame" #afield/rect [1160.0 30.0 260.0 60.0] "code" #afield/file-inline {"path" "gpr_dimensions_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n    /*\n    One take, as a pen records it: an S across the pad, drawn slowly through its first 40%\n    (1.1 s) and flicked through the rest (0.25 s), pressing hard at the start and lifting\n    as it goes, the pen laid further over toward the end.\n    */\n    val take =\n        (0 until 160).map { i ->\n            val u = i / 159.0\n            val s = if (u < 0.75) 0.4 * u / 0.75 else 0.4 + 0.6 * (u - 0.75) / 0.25 // how far along\n            PenSample(\n                if (u < 0.75) 1.1 * u / 0.75 else 1.1 + 0.25 * (u - 0.75) / 0.25,\n                -0.8 + 1.6 * s,\n                0.4 * sin(2 * PI * s),\n                pressure = 1.0 - 0.95 * s,\n                tiltX = 10.0 + 50.0 * s,\n                tiltY = 0.0,\n            )\n        }\n    // The same path at an even pace: what is left if the recording kept no time.\n    val even = run {\n        val arc = take.zipWithNext { a, b -> hypot(b.x - a.x, b.y - a.y) }.runningFold(0.0) { acc, d -> acc + d }\n        take.mapIndexed { i, s -> s.copy(t = take.last().t * arc[i] / arc.last()) }\n    }\n    val ways = [\n        \"position and time, as a mouse records it\" to take.map { PenSample(it.t, it.x, it.y) },\n        \"with the pen's pressure\" to take.map { it.copy(tiltX = 0.0) },\n        \"with pressure and tilt\" to take,\n        \"everything but the time\" to even,\n    ]\n    val canvases = mutableListOf<PaintCanvas>()\n    try {\n        ways.forEach { (_, samples) ->\n            PaintCanvas(300, aspect = 1.0, groundColor = rgb(0.97, 0.96, 0.92), sizeMm = 120.0, seed = 5).also { c ->\n                canvases += c\n                c.stroke(\n                    c.gesture(samples),\n                    c.dynamicBrush(BrushKind.Filbert, 50.0, hairs = 32).load(rgb(0.15, 0.2, 0.35), stiff = 0.5),\n                    seed = 5,\n                )\n            }\n        }\n        display(\"main\", pngRow(canvases))\n    } finally {\n        canvases.forEach { it.close() }\n    }\n    markdown(\"ways\", ways.mapIndexed { i, (name, _) -> \"${i + 1}. $name\" }.joinToString(\"\\n\"))\n}\n"}}} {"id" "gpr_pad" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "pad to paint" "_tombstone" false "frame" #afield/rect [40.0 30.0 260.0 60.0] "code" #afield/file-inline {"path" "gpr_pad_code_.kt" "inline" "var p = Vector2f(0f, 0f)\nlateinit var pad: GestureHandle\n\n// A wave a pen might draw across the pad in 1.6 s: pressing hardest through the middle,\n// leaning right and toward you, with a little tremor.\nval rnd = java.util.Random(11)\nval wave =\n    (0 until 190).map { i ->\n        val u = i / 189.0\n        PenSample(\n            1.6 * u,\n            -0.85 + 1.7 * u + 0.006 * (rnd.nextDouble() - 0.5),\n            0.35 * sin(2 * PI * u) + 0.006 * (rnd.nextDouble() - 0.5),\n            pressure = 0.05 + 0.95 * sin(PI * u),\n            tiltX = 35.0,\n            tiltY = 20.0,\n        )\n    }\n\nval x = keyframes(\"lanes\", \"x\")\nval y = keyframes(\"lanes\", \"y\")\nval pressure = keyframes(\"lanes\", \"pressure\")\n\nfun bake() {\n    val (bx, by) = bakeGesture(pad, tolerance = 0.01, channel = \"lanes\")\n    pressure.setKeys(pad.penLane(\"pressure\", tolerance = 0.03))\n    println(\"baked ${pad.samples.size} samples: ${pad.fit(bx, by)}, pressure ${pressure.getKeyframeCount()} keys\")\n}\n\nfun show(paintIt: (PaintCanvas) -> TimedGesture) {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return\n    }\n    PaintCanvas(600, aspect = 1.0, groundColor = rgb(0.97, 0.96, 0.92), sizeMm = 200.0, seed = 4).use { c ->\n        val g = paintIt(c)\n        c.stroke(g, c.dynamicBrush(BrushKind.Round, 40.0, hairs = 32).load(rgb(0.25, 0.15, 0.1), stiff = 0.5), seed = 4)\n        println(\n            \"painted %.2f s, pressure %.2f to %.2f\"\n                .format(g.duration, g.samples.minOf { it.pressure }, g.samples.maxOf { it.pressure }),\n        )\n        display(\"main\", c.png(relief = 0.6))\n    }\n}\nfun paintLanes() = show { c -> c.gesture(x, y, pad.xRange, pad.yRange, pressureLane = pressure) }\nfun paintTake() = show { c -> c.gesture(pad) }\n\ncontrolGroup(\"gesture\") {\n    pad = gesture(\"pen\", pen = true) { p = it }\n    button(\"bake take\") {\n        if (it) {\n            bake()\n            paintLanes()\n        }\n    }\n    button(\"paint lanes\") { if (it) paintLanes() }\n    button(\"paint take\") { if (it) paintTake() }\n    button(\"replay lanes\") {\n        if (it) {\n            pad.setTake(x, y)\n            println(\"the pad plays the lanes: ${pad.samples.size} samples\")\n        }\n    }\n}\ndisplayOpen(\"gesture\")\n\nif (!pad.hasTake) pad.setTake(wave)\nif (x.isEmpty() || y.isEmpty()) bake() else println(\"lanes kept: ${pad.fit(x, y)}\")\npaintLanes()\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_contr