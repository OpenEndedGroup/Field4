{"version" 2 "boxes" [{"id" "paint_strokes_creature" "properties" {"children" #{#afield/box "paint_strokes_edit" #afield/box "paint_strokes_note" #afield/box "paint_strokes_sway"} "parents" #{#afield/box "root"} "name" "1 - A creature, stroke by stroke" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 100.0] "code" #afield/file-inline {"path" "paint_strokes_creature_code_.kt" "inline" "// points around an ellipse from angle a0 to a1 (radians), as [x0, y0, x1, y1, ...]\nfun arc(cx: Double, cy: Double, rx: Double, ry: Double, a0: Double, a1: Double, n: Int = 24) = (0..n).flatMap {\n    val a = a0 + (a1 - a0) * it / n\n    listOf(cx + rx * cos(a), cy + ry * sin(a))\n}\n\nval sheet = PaintStrokes(700, aspect = 1.4, seed = 3)\n// the body: rows of a hog flat, filling an ellipse\nfor (i in -5..5) {\n    val y = 400.0 + i * 26\n    val w = 190 * sqrt(1 - (i / 6.0).pow(2))\n    sheet.add(\n        listOf(500 - w, y, 500 + w, y + 6),\n        color = if (i % 2 == 0) \"#8a9a3a\" else \"#a0a848\",\n        brush = BrushKind.HogFlat,\n        width = 34.0,\n        group = \"body\",\n    )\n}\n// legs, and leaves sprouting from the head\nsheet.add(\n    listOf(430.0, 540.0, 420.0, 640.0),\n    color = \"#4a3a20\",\n    brush = BrushKind.HogFlat,\n    width = 26.0,\n    group = \"legs\",\n)\nsheet.add(\n    listOf(570.0, 540.0, 585.0, 640.0),\n    color = \"#4a3a20\",\n    brush = BrushKind.HogFlat,\n    width = 26.0,\n    group = \"legs\",\n)\nfor (a in listOf(-2.3, -1.9, -1.57, -1.25, -0.85)) {\n    val x = 500 + 60 * cos(a)\n    val y = 290 + 30 * sin(a)\n    sheet.add(\n        listOf(x, y, x + 60 * cos(a) - 12, y + 60 * sin(a), x + 120 * cos(a), y + 110 * sin(a)),\n        color = \"#2f6a2a\",\n        brush = BrushKind.Filbert,\n        width = 30.0,\n        pressure = 0.9 to 0.4,\n        group = \"leaves\",\n    )\n}\n// eyes, a smiling mouth and a pink smudge on one cheek\nfor (x in listOf(440.0, 560.0)) {\n    sheet.add(\n        listOf(x - 8, 360.0, x + 8, 362.0),\n        color = \"#f4f0e4\",\n        width = 44.0,\n        pressure = 1.0 to 1.0,\n        group = \"eyes\",\n    )\n    sheet.add(listOf(x, 364.0, x + 8, 365.0), color = \"#1a1a1a\", width = 16.0, pressure = 1.0 to 1.0, group = \"eyes\")\n}\nsheet.add(arc(500.0, 420.0, 70.0, 45.0, 0.4, PI - 0.4), color = \"#3a1a10\", width = 10.0, group = \"mouth\")\nsheet.add(\n    listOf(400.0, 440.0, 410.0, 445.0),\n    color = \"#e07080\",\n    brush = BrushKind.Badger,\n    width = 50.0,\n    hiding = 0.6,\n    group = \"smudge\",\n)\n\n// the records need no paint library; painting them does\nif (PaintCanvas.isAvailable) display(\"main\", sheet.png()) else markdown(PaintLibrary.describe())\nprintln(sheet.describe())\n"}}} {"id" "paint_strokes_sway" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "paint_strokes_creature"} "name" "4 - Swayed, one key per frame" "_tombstone" false "frame" #afield/rect [1500.0 780.0 340.0 100.0] "code" #afield/file-inline {"path" "paint_strokes_sway_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n    val sheet = fromContext<PaintStrokes>()\n    // one key per frame: how far the leaves sway and the legs step; every frame is the same records, moved\n    val keys = listOf(0.0, 30.0, 0.0, -30.0)\n    val frames = keys.map { k ->\n        val f = sheet.copy()\n        f.apply(\n            \"\"\"[{\"op\": \"move\", \"at\": \"@leaves\", \"dx\": $k},\n                    {\"op\": \"bend\", \"at\": \"@mouth\", \"dy\": ${abs(k) / 2}},\n                    {\"op\": \"move\", \"at\": \"@legs\", \"dy\": ${-abs(k) / 3}}]\"\"\",\n        )\n        f.render()\n    }\n    display(\"main\", pngRow(frames))\n}\n"}}} {"id" "paint_strokes_edit" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "paint_strokes_creature"} "name" "2 - Edited by address" "_tombstone" false "frame" #afield/rect [80.0 780.0 340.0 100.0] "code" #afield/file-inline {"path" "paint_strokes_edit_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n    val sheet = fromContext<PaintStrokes>()\n    val edited = sheet.copy()\n    edited.apply(\n        \"\"\"[\n      {\"op\": \"recolor\", \"at\": \"@leaves\", \"color\": \"#c0602a\"},\n      {\"op\": \"bend\", \"at\": \"@mouth\", \"dy\": -45},\n      {\"op\": \"move\", \"at\": \"@smudge\", \"dx\": 200}\n    ]\"\"\",\n    )\n    val before = sheet.render()\n    val after = edited.render()\n    // how much of the picture changed, and how much of that lies outside the edited strokes\n    val a = before.render()\n    val b = after.render()\n    val w = before.widthPx\n    val touched =\n        edited.select(\"@leaves, @mouth, @smudge\").flatMap { listOf(sheet[it]!!.bounds(), edited[it]!!.bounds()) }\n    fun inside(i: Int) = touched.any { r ->\n        val x = (i % w) * 1000.0 / w\n        val y = (i / w) * 1000.0 / w\n        x in r[0] - 20..r[2] + 20 && y in r[1] - 20..r[3] + 20\n    }\n    val changed = a.indices.filter { a[it] != b[it] }\n    println(\n        \"${changed.size} of ${a.size} pixels changed; ${changed.count { !inside(it) }} more than 20 units outside the edited strokes\",\n    )\n    display(\"main\", pngRow(listOf(before, after)))\n}\n"}}} {"id" "paint_strokes_note" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "paint_strokes_creature"} "name" "3 - A pinned note, for the AI" "_tombstone" false "frame" #afield/rect [1500.0 80.0 340.0 100.0] "code" #afield/file-inline {"path" "paint_strokes_note_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n    val original = fromContext<PaintStrokes>()\n    // the sheet the AI edits is kept on the box, so re-running the box keeps its edits\n    val sheet = thisBox.properties.getOrPut(\"strokes.sheet\") {\n        original.copy().also { it.pin(660.0, 430.0, \"more moss on this side\") }\n    } as PaintStrokes\n\n    fun show() {\n        display(\"main\", pngRow([original.render(), sheet.render()]))\n        markdown(\"status\", \"${sheet.strokes.size} strokes, ${sheet.notes.size} notes \" + sheet.notes.joinToString { \"\\\"${it.text}\\\"\" })\n    }\n\n    // the strokes_* tools: open this box's AI panel and ask it to act on the note\n    agentExtension(\"strokes\") { strokeTools(sheet = { sheet }, changed = { show() }) }\n    show()\n}\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}