{"version" 2 "boxes" [{"id" "ds_score" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "score" "_tombstone" false "frame" #afield/rect [20.0 40.0 190.0 60.0] "code" #afield/file-inline {"path" "ds_score_code_.kt" "inline" "// The score, drawn from code into the document's drawing: a frame named \"score\", a piano\n// roll, a glissando and a held note. Running it again replaces these marks; anything you\n// draw by hand in the frame is left alone and is read with them.\nnotation { drawnScore() }\nprintln(\"${notation.mine.size} marks drawn\")\n"}}} {"id" "ds_read" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "read" "_tombstone" false "frame" #afield/rect [20.0 500.0 190.0 60.0] "code" #afield/file-inline {"path" "ds_read_code_.kt" "inline" "// Eight beats across, MIDI 84 at the top down to 48 at the bottom.\nval score = notation.space(\"score\", x = 0.0..8.0, y = 84.0..48.0)\nprintln(score.notes().joinToString(\"\\n\") { n ->\n    \"beat %.3f to %.3f: MIDI %.2f (%s)\".format(n.start, n.end, n.pitch, n.event.mark.label ?: n.event.mark.kind.name.lowercase())\n})\n"}}} {"id" "ds_listen" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "listen back" "_tombstone" false "frame" #afield/rect [580.0 500.0 190.0 60.0] "code" #afield/file-inline {"path" "ds_listen_code_.kt" "inline" "// Render the reading again, then take the sound apart: an onset per strike, a pitch per note.\nval score = notation.space(\"score\", x = 0.0..8.0, y = 84.0..48.0)\nval notes = score.notes()\nval audio = patRenderStereo(score.toPattern(), cycles = 2, cps = 0.25, voice = DrawnScoreDocs.VOICE)\nval heard = DrawnScoreDocs.listen(audio, notes)\nval trace = heard.trace()\nshowSignals(\n    \"drawn\" to trace.map { it.third }, \"heard\" to trace.map { it.second },\n    x = trace.map { it.first }, title = \"pitch: drawn and heard\", xTitle = \"seconds\", yTitle = \"MIDI\",\n)\nprintln(\"${heard.onsetsDetected} onsets for ${heard.scheduled} notes, worst %.1f ms; worst pitch error %.3f semitones\"\n    .format(heard.maxOnsetErrorMs, heard.maxPitchError))\n"}}} {"id" "ds_play" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "play" "_tombstone" false "frame" #afield/rect [300.0 500.0 190.0 60.0] "code" #afield/file-inline {"path" "ds_play_code_.kt" "inline" "// The whole score is one cycle, so 0.25 cycles a second is 120 beats a minute.\nval score = notation.space(\"score\", x = 0.0..8.0, y = 84.0..48.0)\nshowPatAudio(score.toPattern(), cycles = 2, cps = 0.25, voice = DrawnScoreDocs.VOICE, channel = \"audio\")\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}