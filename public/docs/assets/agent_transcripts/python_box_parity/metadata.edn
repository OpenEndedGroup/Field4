{"version" 2 "boxes" [{"id" "parity_root" "properties" {"children" #{#afield/box "parity_error" #afield/box "parity_controls"} "parents" #{#afield/box "root"} "name" "Python root -- children of this box run as Python" "_tombstone" false "frame" #afield/rect [60.0 40.0 340.0 100.0] "mainLanguage" "python" "isPythonRoot" true "code" #afield/file-inline {"path" "parity_root_code_.kt" "inline" "// The language root stays Kotlin; its `mainLanguage` makes its children Python.\nprintln(\"the root stays Kotlin\")\n"}}} {"id" "parity_error" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "parity_root"} "name" "an error is marked where it happened" "_tombstone" false "frame" #afield/rect [60.0 1040.0 340.0 100.0] "code_language" "Python" "code" #afield/file-inline {"path" "parity_error_code_.kt" "inline" "# The marker lands on line 6, inside mean(), where the division failed --\n# not on line 1, and not on the call on line 8.\nreadings = []\n\ndef mean(values):\n    return sum(values) / len(values)\n\nmean(readings)\n"}}} {"id" "parity_controls" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "parity_root"} "name" "a slider and a checkbox, with Python callbacks" "_tombstone" false "frame" #afield/rect [60.0 2040.0 340.0 100.0] "code_language" "Python" "code" #afield/file-inline {"path" "parity_controls_code_.kt" "inline" "# The same controls a Kotlin box draws, calling back into Python.\nstate = {\"freq\": 3.0, \"square\": False}\n\ndef redraw():\n    f, sq = state[\"freq\"], state[\"square\"]\n    wave = \"square\" if sq else \"sine\"\n    display(\"main\", f\"<b>{wave}</b> at {f:.1f} Hz\")\n\n@slider(\"frequency\", min=1, max=10, step=0.1, value=3.0)\ndef on_freq(v):\n    state[\"freq\"] = v\n    redraw()\n\n@checkbox(\"square wave\")\ndef on_square(checked):\n    state[\"square\"] = checked\n    redraw()\n\nredraw()\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "mainLanguage"]}