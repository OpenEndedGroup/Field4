{"version" 2 "boxes" [{"id" "polytope_pick" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Point at a face" "_tombstone" false "frame" #afield/rect [80.0 80.0 320.0 100.0] "code" #afield/file-inline {"path" "polytope_pick_code_.kt" "inline" "val chain = canonicalConway(\"bD\")\nfun sceneWith(normals: NormalPolicy) =\n    chain.polyhedron.triangulate(normals = normals).let { geometry ->\n        pickScene { add(\"Beveled dodecahedron\", geometry.mesh, parts = PickParts.fromTriangulated(geometry)) }\n    }\nval flat = sceneWith(NormalPolicy.Flat)\nval smooth = sceneWith(NormalPolicy.Crease(180.0))\nval view = MeshView(width = 530, height = 340)\nval camera = view.rayCamera(flat.mergedMesh())\n\nvar x = view.width / 2.0\nvar y = view.height / 2.0\nvar smoothNormals = false\n\nfun drawPick() {\n    val scene = if (smoothNormals) smooth else flat\n    val hit = showPointer(scene, camera, vec(x, y), view)\n    val face = hit?.externalId?.let(::ElementId)\n    val source = face?.let { chain.sourceElements(it).single() }\n    val report = if (face == null || source == null) {\n        \"No face at this pixel.\"\n    } else {\n            val seedPart = when (source.rank) {\n                0 -> \"vertex\"\n                1 -> \"edge\"\n                else -> \"pentagon\"\n            }\n            val sides = chain.polyhedron.topology.faceCycle(face).size\n            \"$sides-sided face ${face.value} came from a seed $seedPart.\"\n        }\n    markdown(\"lineage\", report)\n    println(report)\n}\n\ncontrolGroup(\"Pointer\") {\n    slider(\"Horizontal pixel\", min = 0.0, max = view.width - 1.0, step = 1.0, initialValue = x) {\n        x = it\n        drawPick()\n    }\n    slider(\"Vertical pixel\", min = 0.0, max = view.height - 1.0, step = 1.0, initialValue = y) {\n        y = it\n        drawPick()\n    }\n    checkbox(\"Smooth normals\", smoothNormals) {\n        smoothNormals = it\n        drawPick()\n    }\n}\ndrawPick()\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}