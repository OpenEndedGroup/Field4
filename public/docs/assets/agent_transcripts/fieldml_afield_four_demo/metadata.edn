{"version" 2 "boxes" [{"id" "fieldml-four-live" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "fieldml-four-root"} "name" "A triangle on a real Vulkan device" "_tombstone" false "frame" #afield/rect [400.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "fieldml-four-live_code_.kt" "inline" "// A whole Field 4 scene, described from FieldML, with no hostAs in it.\n//\n// This box needs a live Vulkan device, so it does nothing useful unless an\n// ancestor box owns a running Field 4 Window and Renderer. The backdoor's\n// --graphics-context flag makes exactly that box and parents new boxes to it;\n// in an ordinary session, connect this box to whichever box owns your renderer.\n//\n// Verified on 2026-08-08: a light blue triangle in the native window, captured\n// with `field_backdoor.py --graphics-context ... native-screenshot`.\nlet read name box = box |> hostCall \"getPropertyRaw\" (name, hostNull)\n\nlet inherited name box =\n  let here = box |> read name in\n  if here != Unit then here\n  else box |> hostGet \"parents\" |> hostAsList\n         |> fold (fun found p -> if found != Unit then found else inherited name p) Unit\n\nlet renderer = thisBox |> inherited \"renderer\"\n\nlet vertexSource = \"#version 450\\nvec2 verts[3] = vec2[3](vec2(-0.7,-0.6), vec2(0.7,-0.6), vec2(0.0,0.7));\\nvoid main() { gl_Position = vec4(verts[gl_VertexIndex], 0.0, 1.0); }\"\nlet fragmentSource = \"#version 450\\nlayout(location = 0) out vec4 o;\\nvoid main() { o = vec4(0.35, 0.8, 1.0, 1.0); }\"\n\n// parameters(renderer) { vertex = ...; fragment = ...; name = ... } is\n// Module.kt:197. The receiver lambda's `p` is a Parameters, read straight off\n// the JVM signature -- so every member set below is checked at compile time.\n// There is no hostAs anywhere in this box.\nlet params =\n  hostStaticCall \"parameters\" (renderer, fun p ->\n    let _ = p |> hostSet \"vertex\" vertexSource in\n    let _ = p |> hostSet \"fragment\" fragmentSource in\n    p |> hostSet \"name\" \"fieldmlTriangle\"\n  ) (hostClass \"afield.graphics.render.ModuleKt\")\n\nlet module = hostNew (params) (hostClass \"afield.graphics.render.Module\")\nlet pointer = module |> hostExt (hostClass \"afield.graphics.render.ModuleKt\") \"pointer\" Unit\nlet mesh = hostNew (renderer, pointer) (hostClass \"afield.graphics.render.Mesh\")\nlet _ = pointer |> hostCall1 \"plusAssign\" (hostNew (\"tri\", mesh) (hostClass \"kotlin.Pair\"))\nlet _ = mesh |> hostCall \"resize\" (3, 0, pointer)\nlet target = renderer |> hostCall1 \"renderTargetFor\" 0\nlet _ = target |> hostCall1 \"plusAssign_module\" (hostNew (\"fieldmlTriangle\", module) (hostClass \"kotlin.Pair\"))\n\n{\n  renderer = show renderer\n  moduleName = params |> hostGet \"name\"\n  vertices = mesh |> hostGet \"numVert\"\n  attached = target |> hostGet \"modules\" |> show\n}"}}} {"id" "fieldml-four-root" "properties" {"children" #{#afield/box "fieldml-four-live"} "parents" #{#afield/box "root" #afield/box "fieldml-four-renderer"} "name" "FieldML — a live Field 4 scene" "_tombstone" false "frame" #afield/rect [40.0 170.0 300.0 100.0] "isFieldMLRoot" true "mainLanguage" "fieldml"}} {"id" "fieldml-four-renderer" "properties" {"children" #{#afield/box "fieldml-four-root"} "parents" #{#afield/box "root"} "name" "window and renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "fieldml-four-renderer_code_.kt" "inline" "// Scaffolding, and it is Kotlin for two reasons worth naming.\n//\n// `prop` and `once` are SOURCE MACROS -- mechanism A of dev_docs/FIELDML_HOST_BRIDGE.md.\n// They rewrite Kotlin source before it is compiled, so there is no JVM member for a\n// reflective bridge to reach. And `Renderer.run` is a `suspend` member: on the JVM it is\n// `run(Continuation)`, and FieldML can now *satisfy* a suspend function type but still\n// cannot *call into* one, because it has no continuation to pass and nowhere to resume.\n//\n// Everything that actually draws, and everything that moves, is in the FieldML box.\nprop<Window>(window)\nprop<Renderer>(renderer)\nonce.renderer {\n    window = Window(\"FieldML - a live Field 4 scene\")\n    Renderer(window)\n}\nprintln(\"renderer ready - now run the FieldML box\")\nstart(renderer::run)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "mainLanguage" "isFieldMLRoot"]}