{"version" 2 "boxes" [{"id" "pfr_worked" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "worked under each fill rule" "_tombstone" false "frame" #afield/rect [40.0 40.0 320.0 100.0] "code" #afield/file-inline {"path" "pfr_worked_code_.kt" "inline" "import afield.graphics.nile.*\n\nrun {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n\n    val canvas = PaintCanvas(900, aspect = 2.0, sizeMm = 300.0)\n\n    fun squares(dx: Double, rule: FillRule) =\n        FLine().rect(dx + 60.0, 60.0, 220.0, 220.0).rect(dx + 180.0, 180.0, 220.0, 220.0).also { it.fillRule = rule }\n\n    canvas.work(squares(0.0, FillRule.NON_ZERO), rgb(0.2, 0.4, 0.6), Handling.Body, angle = 0.5, clip = true)\n    canvas.work(squares(500.0, FillRule.EVEN_ODD), rgb(0.2, 0.4, 0.6), Handling.Body, angle = 0.5, clip = true)\n\n    display(\"main\", canvas.png())\n}\n"}}} {"id" "pfr_against_gezira" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "paint mask against Gezira" "_tombstone" false "frame" #afield/rect [40.0 180.0 320.0 100.0] "code" #afield/file-inline {"path" "pfr_against_gezira_code_.kt" "inline" "import afield.graphics.nile.*\n\nrun {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n\n    fun squares(k: Double, rule: FillRule) = FLine().rect(150.0 * k, 50.0 * k, 400.0 * k, 350.0 * k).rect(400.0 * k, 150.0 * k, 450.0 * k, 300.0 * k).also {\n        it.fillRule = rule\n    }\n\n    for (rule in [FillRule.NON_ZERO, FillRule.EVEN_ODD]) {\n        val canvas = PaintCanvas(400, aspect = 2.0)\n        canvas.glaze(rgb(0.05, 0.1, 0.6), squares(1.0, rule), coats = 4.0, hiding = 1.0)\n        val painted = canvas.render(wet = true).map { ((it shr 16) and 0xff) < 128 }\n        val reference = squares(0.4, rule).also {\n            it.filled = true\n            it.stroked = false\n        }\n        val gezira = GeziraFLine.render([reference], 400, 200).canvas\n        val differ = painted.indices.count { painted[it] != (gezira.alpha(it % 400, it / 400) > 0.5f) }\n        println(\n            \"$rule: $differ of ${painted.size} pixels differ from Gezira; overlap painted: ${painted[110 * 400 + 190]}\",\n        )\n    }\n}\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}