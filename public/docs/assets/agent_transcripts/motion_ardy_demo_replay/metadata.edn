{"version" 2 "boxes" [{"id" "motion_ardy_demo_replay" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "ARDY — the interactive skipping take" "_tombstone" false "frame" #afield/rect [80.0 80.0 600.0 110.0] "code" #afield/file-inline {"path" "motion_ardy_demo_replay_code_.kt" "inline" "import afield.animation.mocap.*\nval clip = MotionRecording(\"%docs/assets/motion_recordings/ardy-live-skip.f4motion\".path).clip()\nval started = AnimationClock.nowSeconds()\n\nloop {\n    val elapsed = AnimationClock.nowSeconds() - started\n    val duration = clip.endTime - clip.startTime\n    val snapshot = clip.sample(clip.startTime + elapsed % duration)\n    val pose = snapshot.frame.executed\n    val bones = pose.bones(clip.skeleton).apply {\n        color=vec(.94,.96,1.0,1.0); thickness=3.0\n        pointed=true; pointSize=.8\n    }\n    three(channel=\"motion\", height=480, width=700) {\n        lines(bones)\n        camera(yaw=35.0, pitch=12.0, padding=2.6) // Room for the whole skipping gesture.\n        followCamera(vec(pose.root[0], pose.root[1], pose.root[2]), halfLifeSeconds=.4,\n            epoch=\"${(elapsed/duration).toInt()}:${snapshot.frame.episode}\")\n        title(\"ARDY · skipping · ${\"%.2f\".format(snapshot.frame.time)} s\")\n        helpers(true)\n    }\n    markdown(\"status\", \"**ARDY · skipping**\\n\\n\" +\n        \"Six uninterrupted seconds from the interactive session. Prompt: A person skips forward. \" +\n        \"Four denoising steps; original poses and session timestamps retained.\")\n    displayOpen(\"motion\"); displayOpen(\"status\")\n    delay(16)\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}