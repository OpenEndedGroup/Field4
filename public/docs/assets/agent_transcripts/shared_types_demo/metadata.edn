{"version" 2 "boxes" [{"id" "shared_types_receive" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - Receive it, still typed" "_tombstone" false "frame" #afield/rect [380.0 140.0 280.0 50.0] "code" #afield/file-inline {"path" "shared_types_receive_code_.kt" "inline" "// _particle arrives from box 3. These lines only COMPILE because the type crossed\n// the box boundary: a box-declared class lands here as Any?, and .x does not\n// resolve on Any?.\nprintln(\"received: \" + _particle)\nprintln(\"x + y = \" + (_particle.x + _particle.y))\nprintln(\"momentum = \" + _particle.momentum)\n"}}} {"id" "shared_types_use" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Use it, with full fidelity" "_tombstone" false "frame" #afield/rect [380.0 40.0 280.0 50.0] "code" #afield/file-inline {"path" "shared_types_use_code_.kt" "inline" "// Named arguments, copy, destructuring and the data-class toString all work,\n// because shared.Particle is a real compiled class with real metadata -- not a\n// type name re-spelled as text.\nval p = shared.Particle(x = 3.0, y = 4.0, mass = 2.0)\nprintln(\"toString: \" + p)\nprintln(\"copy: \" + p.copy(mass = 10.0))\nval (x, y, m) = p\nprintln(\"destructured: $x $y $m\")\nprintln(\"momentum: \" + p.momentum)\n"}}} {"id" "shared_types_declare" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Declare shared types" "_tombstone" false "frame" #afield/rect [40.0 40.0 280.0 50.0] "code" #afield/file-inline {"path" "shared_types_declare_code_.kt" "inline" "// One publish, and every box in this document can name these types. They are\n// compiled as ordinary Kotlin into a directory on the shared classloader, NOT\n// declared in this box's snippet -- which is why they escape this box at all.\nprintln(sharedTypes(\"\"\"\npackage shared\n\ndata class Particle(val x: Double, val y: Double, val mass: Double) {\n    val momentum: Double get() = mass * kotlin.math.hypot(x, y)\n}\n\"\"\"))\n"}}} {"id" "shared_types_export" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - Export a value" "_tombstone" false "frame" #afield/rect [40.0 140.0 280.0 50.0] "code" #afield/file-inline {"path" "shared_types_export_code_.kt" "inline" "// @rootExported publishes the value to the document root, so any box can reach\n// it. Before shared types the *value* crossed but its type did not.\n@rootExported\nval particle = shared.Particle(x = 1.5, y = 2.5, mass = 4.0)\n\nprintln(\"exported: \" + particle)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory"]}