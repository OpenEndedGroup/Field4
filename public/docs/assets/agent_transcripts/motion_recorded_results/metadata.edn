{"version" 2 "boxes" [{"id" "motion_recorded_results" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Recorded motion — ARDY and CLoSD" "_tombstone" false "frame" #afield/rect [80.0 80.0 600.0 110.0] "code" #afield/file-inline {"path" "motion_recorded_results_code_.kt" "inline" "import afield.animation.mocap.*\n\n// Change to \"live\", \"closd\" or \"route\" to compare the other recordings.\nval experiment = \"ardy\"\nval sources = when (experiment) {\n    \"live\" -> listOf(\"Skip\" to \"ardy-live-skip\", \"Run\" to \"ardy-live-run\", \"Recoil\" to \"ardy-live-recoil\")\n    \"closd\" ->\n        listOf(\n            \"Baseline\" to \"closd-baseline-seed0\",\n            \"Weak tether\" to \"closd-weak-seed0\",\n            \"Strong tether\" to \"closd-capped-seed0\",\n        )\n    \"route\" -> listOf(\"4 steps\" to \"ardy-path\", \"10 steps\" to \"ardy-path-10steps\")\n    else -> listOf(\"Run\" to \"ardy-run-seed0\", \"Jump\" to \"ardy-jump-seed0\", \"Somersault\" to \"ardy-somersault-seed0\")\n}\nval takes = sources.map { (_, file) -> MotionRecording((\"%docs/assets/motion_recordings/$file.f4motion\").path) }\nval clips = takes.map { it.clip() }\nval logs = takes.map { it.events().toList() }\nval duration = clips.minOf { it.endTime - it.startTime }\nval started = AnimationClock.nowSeconds()\n\nloop {\n    val time = (AnimationClock.nowSeconds() - started) % duration\n    val bodies = clips.flatMapIndexed { i, clip ->\n        val frame = clip.sample(clip.startTime + time).frame\n        val root = frame.executed.root\n        // Translate each whole recording into a comparison lane. Never change joint poses.\n        val offset = vec((i - (clips.size - 1) / 2.0) * 2.8 - root[0], 0.0, -root[2])\n        val actual = (frame.executed.bones(clip.skeleton) + offset).apply {\n            color = vec(.94, .96, 1.0, 1.0)\n            thickness = 3.0\n        }\n        val reference = frame.intended?.bones(clip.skeleton)?.let {\n            (it + offset).apply {\n                color = vec(.15, .7, .85, .6)\n                thickness = 1.5\n            }\n        }\n        val tether =\n            logs[i].lastOrNull { it.optString(\"type\") == \"tetherPhysics\" && it.getDouble(\"time\") <= frame.time }\n        val spring = fline {\n            if (tether != null && frame.time in 2.0..4.0) {\n                val a = tether.getJSONArray(\"anchor\")\n                val p = tether.getJSONArray(\"point\")\n                moveTo(a.getDouble(0) + offset.x, a.getDouble(1), a.getDouble(2) + offset.z)\n                lineTo(p.getDouble(0) + offset.x, p.getDouble(1), p.getDouble(2) + offset.z)\n                val x = a.getDouble(0) + offset.x\n                val y = a.getDouble(1)\n                val z = a.getDouble(2) + offset.z\n                moveTo(x - .06, y, z)\n                lineTo(x + .06, y, z)\n                moveTo(x, y - .06, z)\n                lineTo(x, y + .06, z)\n                moveTo(x, y, z - .06)\n                lineTo(x, y, z + .06)\n            }\n            color = vec(1.0, .3, .4, 1.0)\n            thickness = 3.0\n        }\n        val force = fline {\n            if (tether != null && frame.time in 2.0..4.0) {\n                val p = tether.getJSONArray(\"point\")\n                val f = tether.getJSONArray(\"force\")\n                val scale = minOf(.00015, .6 / tether.getDouble(\"forceN\").coerceAtLeast(1e-9))\n                moveTo(p.getDouble(0) + offset.x, p.getDouble(1), p.getDouble(2) + offset.z)\n                lineTo(\n                    p.getDouble(0) + offset.x + f.getDouble(0) * scale,\n                    p.getDouble(1) + f.getDouble(1) * scale,\n                    p.getDouble(2) + offset.z + f.getDouble(2) * scale,\n                )\n            }\n            color = vec(1.0, .75, .2, 1.0)\n            thickness = 4.0\n        }\n        listOfNotNull(actual, reference, spring, force)\n    }\n    three(channel = \"motion\", height = 460, width = 900) {\n        lines(bodies)\n        camera(yaw = 10.0, pitch = 10.0, distance = 2.8)\n        title(sources.joinToString(\"                 \") { it.first })\n        helpers(true)\n    }\n    markdown(\n        \"status\",\n        \"**${sources.joinToString(\" · \") { it.first }}** · ${\"%.2f\".format(time)} s\\n\\n\" +\n            \"Actual recorded poses; horizontal root travel removed separately in each lane. White: executed. Cyan: reference. \" +\n            when (experiment) {\n                \"closd\" ->\n                    \"Strong: 8000 N/m, 120 N s/m, 2500 N cap. Attach at 2 s; release at 4 s. Red: anchor; amber: force (scaled).\"\n                \"route\" -> \"Both route trials slide; 10 steps is a comparison, not a fixed gait.\"\n                \"live\" -> \"Uninterrupted excerpts from the interactive session; original poses retained.\"\n                else -> \"The complete six-second batch takes include unsuccessful and nearly static output.\"\n            },\n    )\n    displayOpen(\"motion\")\n    displayOpen(\"status\")\n    delay(16)\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}