{"version" 2 "boxes" [{"id" "rw_terminate" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "isCallTo Termination" "_tombstone" false "frame" #afield/rect [60.0 340.0 300.0 100.0] "code" #afield/file-inline {"path" "rw_terminate_code_.kt" "inline" "import afield.macros.*\nfun wrap(v: Int) = v\nfun f(v: Int) = v + 1\nrewrite { x: Expr ->\n    from { f(x) }\n    where { !isCallTo(x, \"wrap\") }\n    to { f(wrap(x)) }\n}\nprintln(\"f(41) = \" + f(41))\n"}}} {"id" "rw_ambient_child" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "rw_ambient_parent"} "name" "Ambient Child (inherits it)" "_tombstone" false "frame" #afield/rect [460.0 200.0 300.0 100.0] "code" #afield/file-inline {"path" "rw_ambient_child_code_.kt" "inline" "println(\"boom(5) = \" + boom(5))\n"}}} {"id" "rw_negation" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Negation" "_tombstone" false "frame" #afield/rect [60.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "rw_negation_code_.kt" "inline" "import afield.macros.*\nrewrite { x: Expr -> from { neg(x) }; to { -x } }\nprintln(\"neg(10) = \" + neg(10))\n"}}} {"id" "rw_unquote" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Procedural unquote" "_tombstone" false "frame" #afield/rect [60.0 620.0 300.0 100.0] "code" #afield/file-inline {"path" "rw_unquote_code_.kt" "inline" "import afield.macros.*\nrewrite { x: Ident -> from { rev(x) }; to { unquote { \"\\\"\" + x.reversed() + \"\\\"\" } } }\nprintln(\"rev(hello) = \" + rev(hello))\n"}}} {"id" "rw_precedence" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Precedence Guard" "_tombstone" false "frame" #afield/rect [60.0 200.0 300.0 100.0] "code" #afield/file-inline {"path" "rw_precedence_code_.kt" "inline" "import afield.macros.*\nrewrite { x: Expr -> from { twice(x) }; to { x * 2 } }\nprintln(\"twice(3 + 4) = \" + twice(3 + 4))\n"}}} {"id" "rw_variadic" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Variadic Hole" "_tombstone" false "frame" #afield/rect [60.0 480.0 300.0 100.0] "code" #afield/file-inline {"path" "rw_variadic_code_.kt" "inline" "import afield.macros.*\nfun sink(vararg xs: Int) = xs.sum()\nrewrite { first: Expr, rest: Vararg ->\n    from { log(first, rest) }\n    to { sink(first, rest) }\n}\nprintln(\"log(1, 2, 3) = \" + log(1, 2, 3))\n"}}} {"id" "rw_ambient_parent" "properties" {"children" #{#afield/box "rw_ambient_child"} "parents" #{#afield/box "root"} "name" "Ambient Parent (holds the rule)" "_tombstone" false "frame" #afield/rect [460.0 60.0 320.0 100.0] "code" #afield/file-inline {"path" "rw_ambient_parent_code_.kt" "inline" "import afield.macros.*\nrewrite { x: Expr -> from { boom(x) }; to { -x } }\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory"]}