{"version" 2 "boxes" [{"id" "sg_tour" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "tour" "_tombstone" false "frame" #afield/rect [60.0 140.0 150.0 50.0] "code" #afield/file-inline {"path" "sg_tour_code_.kt" "inline" "// A four-step guide to this document. Run it, then follow the links in the note.\nval guide = thisBox\nval numbersBox = inside.boxes.values.first { it.name == \"numbers\" }\nval squaresBox = inside.boxes.values.first { it.name == \"squares\" }\nvar visits = 0\nvar stars = 0\n//%-\n\nval show = slideShow {\n    step(\"Welcome\") {\n        markdownNote(\n            \"\"\"\n            ## A tour of this document\n            This guide has four steps. Each one selects the box it is about.\n\n            [[next:Start →]]\n            \"\"\".trimIndent(),\n            animated = true\n        )\n        selectBox(guide)\n    }\n    step(\"numbers\") {\n        onEnter {\n            visits += 1\n            guide.properties[\"visits\"] = visits\n        }\n        markdownNote(\n            \"\"\"\n            ## `numbers` makes a list\n            The green line points at it. Visits to this step: **{{visits}}**.\n\n            [[back]] [[next]]\n            \"\"\".trimIndent()\n        )\n        selectBox(numbersBox)\n        annotate(id = \"numbers\", targetBox = numbersBox, color = \"rgba(128, 255, 164, 0.8)\", dashed = false)\n    }\n    step(\"squares\") {\n        markdownNote(\n            \"\"\"\n            ## Line 3 does the work\n            `squares` maps each number to its square.\n\n            [[back]] [[next]]\n            \"\"\".trimIndent()\n        )\n        selectBox(squaresBox, property = \"code\", line = 3, highlight = 3)\n        annotateToLine(id = \"line3\", targetBox = squaresBox, line = 3, color = \"rgba(255, 180, 100, 0.8)\", dashed = true)\n    }\n    step(\"Your turn\") {\n        markdownNote(\n            \"\"\"\n            ## Your turn\n            [Give this guide a star](#custom:star). Stars so far: **{{stars}}**.\n\n            [[home:Start again]] [[finish]]\n            \"\"\".trimIndent()\n        )\n        linkCallback(\"star\") {\n            stars += 1\n            here.properties[\"stars\"] = stars\n            show.goToStep(show.currentStepIndex)\n        }\n        selectBox(guide)\n    }\n}\n\nrunBlocking { show.start() }\n"}}} {"id" "sg_numbers" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "numbers" "_tombstone" false "frame" #afield/rect [60.0 320.0 150.0 50.0] "code" #afield/file-inline {"path" "sg_numbers_code_.kt" "inline" "// Ten numbers for squares to use.\nval numbers = (1..10).toList()\nprintln(numbers)\n"}}} {"id" "sg_squares" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "squares" "_tombstone" false "frame" #afield/rect [60.0 440.0 150.0 50.0] "code" #afield/file-inline {"path" "sg_squares_code_.kt" "inline" "// Squares of the numbers 1 to 10.\nval numbers = (1..10).toList()\nval squares = numbers.map { it * it }\nprintln(squares)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}