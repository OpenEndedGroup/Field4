{"version" 2 "boxes" [{"id" "fline-measure-cross" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - Crossings, bounds, orientation" "_tombstone" false "frame" #afield/rect [60.0 520.0 420.0 100.0] "code" #afield/file-inline {"path" "fline-measure-cross_code_.kt" "inline" "val loop = fline {\n    moveTo(60, 200)\n    cubicTo(420, 40, 0, 40, 340, 210)\n    thickness = 2.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\nval ring = fline {\n    circle(200, 130, 70)\n    thickness = 2.0\n    color = vec(0.6, 0.8, 1.0, 1.0)\n}\n\n// where the loop crosses the ring, and where it crosses itself\nval hits = [loop.crossings2D(ring), loop.selfCrossings2D()].flatten().map { it.point }\nval dots = polylineFrom(hits.map { it.v2 }).apply {\n    pointed = true\n    pointSize = 3.0\n    stroked = false\n    color = vec(1.0, 0.5, 0.2, 1.0)\n}\n\n// bounds that hug the curve, against the control-point bounds\nval tight = fline {\n    rect(loop.tightBounds2D())\n    thickness = 1.0\n    color = vec(0.4, 1.0, 0.6, 1.0)\n}\nval loose = fline {\n    rect(loop.fast2DBounds())\n    thickness = 1.0\n    color = vec(1.0, 1.0, 1.0, 0.25)\n}\n\nprint(\"${hits.size} crossings; clockwise on screen: ${ring.isClockwise2D()}\")\n\nlines(loose, tight, ring, loop, dots, w = 420.0, h = 260.0, fitToSize = true)\n"}}} {"id" "fline-measure-trim" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Trim and split by distance" "_tombstone" false "frame" #afield/rect [520.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "fline-measure-trim_code_.kt" "inline" "val curve = fline {\n    moveTo(40, 200)\n    cubicTo(100, 20, 220, 20, 250, 130)\n    lineTo(380, 60)\n    thickness = 1.0\n    color = vec(1.0, 1.0, 1.0, 0.35)\n}\n\nval total = curve.length()\n\n// from a quarter to 60% of the way, by distance, drawn over the original\nval middle = curve.trim(0.25f * total, 0.6f * total).apply {\n    thickness = 5.0\n    color = vec(0.4, 0.9, 1.0, 1.0)\n}\n\n// cut at 100 units: two pieces whose lengths add up to the whole\nval (head, tail) = curve.splitAt(100f)\nhead.apply {\n    thickness = 2.0\n    color = vec(1.0, 0.6, 0.2, 1.0)\n}\n\nprint(\"total ${\"%.1f\".format(total)} = ${\"%.1f\".format(head.length())} + ${\"%.1f\".format(tail.length())}\")\n\nlines(curve, head, middle, w = 420.0, h = 260.0, fitToSize = true)\n"}}} {"id" "fline-measure-helix" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5 - A 3D frame along a helix" "_tombstone" false "frame" #afield/rect [60.0 980.0 420.0 100.0] "code" #afield/file-inline {"path" "fline-measure-helix_code_.kt" "inline" "// a helix of radius 80 rising 30 units per turn, one cubic per quarter turn\nval r = 80.0\nval rise = 30.0\nval k = 0.5522847 * r\nval helix = fline {\n    moveTo(r, 0, 0)\n    for (q in 0 until 12) {\n        val a0 = q * PI / 2\n        val a1 = a0 + PI / 2\n        val z0 = rise * q / 4\n        val z1 = rise * (q + 1) / 4\n        cubicTo(\n            r * cos(a0) - k * sin(a0),\n            r * sin(a0) + k * cos(a0),\n            z0 + (z1 - z0) / 3,\n            r * cos(a1) + k * sin(a1),\n            r * sin(a1) - k * cos(a1),\n            z0 + 2 * (z1 - z0) / 3,\n            r * cos(a1),\n            r * sin(a1),\n            z1,\n        )\n    }\n}\n\n// look at it from the side and a little above: x across, z up, y into the page\nfun view(p: Vec3) = vec(p.x + 0.35 * p.y, -p.z - 0.35 * p.y)\n\nval projected = helix.sampleByNumber(400).map(::view)\nval drawn = fline {\n    data(\"m l+\", projected)\n    thickness = 1.5\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\n// the 3D frame at 16 evenly spaced places: tangent orange, normal blue, binormal green\nfun tick(p: Vec3, d: Vec3?, c: Vec4) = fline {\n    if (d != null) {\n        moveTo(view(p))\n        lineTo(view(p + d * 18.0))\n    }\n    thickness = 2.0\n    color = c\n}\nval frames =\n    (0..15).flatMap { i ->\n        val loc = helix.locationAtFraction(i / 15f)!!\n        [\n            tick(loc.point, loc.tangent, vec(1.0, 0.6, 0.2, 1.0)),\n            tick(loc.point, loc.normal, vec(0.4, 0.8, 1.0, 1.0)),\n            tick(loc.point, loc.binormal, vec(0.5, 1.0, 0.5, 1.0)),\n        ]\n    }\n\n// a helix has constant curvature r / (r^2 + c^2), with c the rise per radian\nval c = rise / (2 * PI)\nval mid = helix.locationAtFraction(0.5f)!!\nprintln(\"curvature %.5f, a true helix %.5f\".format(mid.curvature, r / (r * r + c * c)))\nprintln(\"normal points at the axis: %.3f\".format(mid.normal!!.dot(vec(-mid.point.x, -mid.point.y, 0.0).normalize())))\n\nlines([drawn] + frames, w = 420.0, h = 260.0, fitToSize = true)\n"}}} {"id" "fline-measure-fill" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - Fill rules that follow the curve" "_tombstone" false "frame" #afield/rect [520.0 520.0 420.0 100.0] "code" #afield/file-inline {"path" "fline-measure-fill_code_.kt" "inline" "// two circles drawn the same way round: a ring\nfun ring(dx: Double) = fline {\n    circle(110 + dx, 120, 95)\n    circle(110 + dx, 120, 40)\n    thickness = 2.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\n// dots that are inside under each fill rule: non-zero on the left, even-odd on the right\nfun insideDots(dx: Double, rule: FLineFillRule) = fline {\n    val shape = ring(dx)\n    for (i in 0..24) for (j in 0..24) {\n        val p = Vec2((15 + dx + i * 8).toFloat(), (25 + j * 8).toFloat())\n        if (shape.contains2D(p, rule)) {\n            moveTo(p.x, p.y)\n            lineTo(p.x + 0.01, p.y)\n        }\n    }\n    pointed = true\n    pointSize = 0.7\n    stroked = false\n    color = vec(1.0, 0.6, 0.2, 1.0)\n}\n\nlines(\n    ring(0.0),\n    ring(240.0),\n    insideDots(0.0, FLineFillRule.NonZero),\n    insideDots(240.0, FLineFillRule.EvenOdd),\n    w = 460.0,\n    h = 240.0,\n    fitToSize = true,\n)\n"}}} {"id" "fline-measure-locate" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Locations along a line" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "fline-measure-locate_code_.kt" "inline" "val curve = fline {\n    moveTo(40, 210)\n    cubicTo(90, 30, 230, 30, 260, 140)\n    cubicTo(280, 220, 360, 230, 390, 90)\n    thickness = 2.0\n    color = vec(1.0, 1.0, 1.0, 1.0)\n}\n\n// thirteen locations, evenly spaced by distance\nval stops = (0..12).mapNotNull { curve.locationAtFraction(it / 12f) }\n\nval normals = stops.map { loc ->\n    fline {\n        moveTo(loc.point.x, loc.point.y)\n        lineTo(loc.point.x + loc.normal2D.x * 22, loc.point.y + loc.normal2D.y * 22)\n        thickness = 1.5\n        color = vec(0.4, 0.9, 1.0, 1.0)\n    }\n}\n\n// the circle that matches the bend, at three of them\nval bends =\n    [stops[3], stops[7], stops[10]].map { loc ->\n        val r = 1.0 / loc.signedCurvature2D\n        fline {\n            circle(loc.point.x + loc.normal2D.x * r, loc.point.y + loc.normal2D.y * r, kotlin.math.abs(r))\n            thickness = 1.0\n            color = vec(1.0, 0.6, 0.2, 0.8)\n        }\n    }\n\nlines([curve] + normals + bends, w = 420.0, h = 260.0, fitToSize = true)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}