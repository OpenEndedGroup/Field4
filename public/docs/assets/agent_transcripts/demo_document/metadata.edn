{"version" 2 "boxes" [{"id" "demo_gyroid" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "gyroid" "_tombstone" false "frame" #afield/rect [1300.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "demo_gyroid_code_.kt" "inline" "// A marched gyroid and its open rims, as one three.js scene in the output panel.\nval surface = marchingCubes(sdfGyroid(4.0, 0.3), boundsAround(radius = 1.0), 56)\nval rims =\n    surface.toFLines(MeshLines.BOUNDARY).map { ring ->\n        ring.color = vec(1.0, 0.45, 0.12, 1.0)\n        ring.thickness = 2.6\n        ring\n    }\nthree(channel = \"gyroid\", height = 420, width = 640) {\n    mesh(surface, wireframe = false)\n    lines(rims)\n    camera(yaw = 32.0, pitch = 20.0, padding = 1.02)\n}\n"}}} {"id" "demo_cue_1" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "cue 1" "_tombstone" false "frame" #afield/rect [4420.0 80.0 260.0 100.0] "code" #afield/file-inline {"path" "demo_cue_1_code_.kt" "inline" "// Runs while the time slider is over it.\ndisplay(\"main\", \"<div style='width:300px;height:26px;border-radius:4px;background:linear-gradient(90deg,#1971c2,#4dabf7)'></div>\")\ndisplayOpen(\"main\")\nloop { }\n"}}} {"id" "demo_bud" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "demo_sketch"} "name" "bud" "_tombstone" false "frame" #afield/rect [20.0 110.0 200.0 60.0] "code" #afield/file-inline {"path" "demo_bud_code_.kt" "inline" "println(\"a nested bud\")\n"} "nestedIn" #afield/box "demo_sketch"}} {"id" "demo_particles" "properties" {"children" #{#afield/box "demo_draw"} "parents" #{#afield/box "root" #afield/box "demo_renderer"} "name" "probed particles" "_tombstone" false "frame" #afield/rect [3300.0 40.0 300.0 100.0] "compute" #afield/file-inline {"path" "demo_particles_compute_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\nlayout(local_size_x = 64) in;\nlayout(std430, buffer_reference) buffer inData {\n    vec4 a[];\n};\nlayout(std430, buffer_reference) buffer outData {\n    vec4 a[];\n};\nlayout(push_constant) uniform dat {\n    inData inData;\n    outData outData;\n    float something;\n    uint particleCount;\n} pc;\n{% property \"fieldProbe\" %}\nvoid main() {\n    uint idx = gl_GlobalInvocationID.x;\n    if (idx >= pc.particleCount) return;\n    vec4 seed = pc.inData.a[idx];\n    float phaseZ = pc.something * seed.z;\n    float phaseW = pc.something * seed.w;\n    vec2 moved = vec2(\n    seed.x * cos(phaseZ) + seed.y * sin(phaseW),\n    -seed.x * sin(phaseW) + seed.y * cos(phaseZ * 0.03)\n    );\n    pc.outData.a[idx] = vec4(moved, seed.zw);\n    fieldProbe(length(moved - seed.xy));\n}\n"} "code" #afield/file-inline {"path" "demo_particles_code_.kt" "inline" "// A compute shader moves 100,000 particles; the probe plots how far each one moved.\nvar module = computeModuleHere {}\nvar m = ComputeMesh()\nmodule += \"step\" to m\nrenderer += \"compute\" to module\nval N = 100000\nvar inData = defaultBuffer { size = N.vec4s }.buffer\nvar outData = defaultBuffer { size = N.vec4s }.buffer\nm.inData = { inData }\nm.outData = { outData }\nm.particleCount = { N }\nm.something = { (AnimationClock.nowSeconds() * 0.6).f }\nfieldProbeHere(samples = 100000).display(\"probe\")\ndisplayOpen(\"probe\")\nprop<FrameBufferGroup>(outputPositions) = outData\nm.x = (N + 63) / 64\nm.y = 1\nm.z = 1\nval seeded = kotlin.random.Random(0x4f1e1d)\ninData.write {\n    for (i in 0 until N) {\n        put(vec(seeded.nextDouble(), seeded.nextDouble(), seeded.nextDouble(), seeded.nextDouble()))\n    }\n}\nprintln(\"compute launched, N=\" + N)\n"}}} {"id" "demo_cue_3" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "cue 3" "_tombstone" false "frame" #afield/rect [4860.0 520.0 260.0 100.0] "code" #afield/file-inline {"path" "demo_cue_3_code_.kt" "inline" "// Runs while the time slider is over it.\ndisplay(\"main\", \"<div style='width:300px;height:26px;border-radius:4px;background:linear-gradient(90deg,#e8590c,#ffc078)'></div>\")\ndisplayOpen(\"main\")\nloop { }\n"}}} {"id" "demo_cue_2" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "cue 2" "_tombstone" false "frame" #afield/rect [4640.0 300.0 260.0 100.0] "code" #afield/file-inline {"path" "demo_cue_2_code_.kt" "inline" "// Runs while the time slider is over it.\ndisplay(\"main\", \"<div style='width:300px;height:26px;border-radius:4px;background:linear-gradient(90deg,#2f9e44,#8ce99a)'></div>\")\ndisplayOpen(\"main\")\nloop { }\n"}}} {"id" "demo_swatch" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "demo_palette"} "name" "swatch" "_tombstone" false "frame" #afield/rect [40.0 330.0 300.0 100.0] "code" #afield/file-inline {"path" "demo_swatch_code_.kt" "inline" "markdown(\"A flower with \" + petals + \" petals: \" + \"✿\".repeat(petals))\ndisplayOpen(\"main\")\n"}}} {"id" "demo_cue_4" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "cue 4" "_tombstone" false "frame" #afield/rect [5080.0 740.0 260.0 100.0] "code" #afield/file-inline {"path" "demo_cue_4_code_.kt" "inline" "// Runs while the time slider is over it.\ndisplay(\"main\", \"<div style='width:300px;height:26px;border-radius:4px;background:linear-gradient(90deg,#ae3ec9,#e599f7)'></div>\")\ndisplayOpen(\"main\")\nloop { }\n"}}} {"id" "demo_timeline" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "t" "_tombstone" false "frame" #afield/rect [4300.0 40.0 40.0 1400.0] "code" #afield/file-inline {"path" "demo_timeline_code_.kt" "inline" "// A time slider: drag it sideways and it starts each box it enters and stops each box it leaves.\nrootProp<Box>(execution) = thisBox\n\nonViewportChange +=\n    \"lock_x\" to\n        { inside, a, b ->\n            frame = frame.copy(y = -b.y - 100, h = b.h * 2 - 50, w = 40.0)\n        }\n\nonFrameChange +=\n    \"lock_x\" to\n        { inside, a, b ->\n            // The boxes under the line before the move, swept by it, and under it after.\n            val all = root.children - thisBox\n            val before = all.filter { it.frame.intersects(a.x) }\n            val swept = all.filter { it.frame.intersects(a.x, b.x) }\n            val after = all.filter { it.frame.intersects(b.x) }\n            (after - before).forEach(Box::begin)\n            (before - after).forEach(Box::end)\n            // Crossed in one move: start it and stop it again.\n            (swept - (before + after)).forEach {\n                inMain {\n                    it.begin()\n                    yield()\n                    it.end()\n                }\n            }\n            b.copy(y = -inside.viewport.y - 100, w = 40.0)\n        }\n\nframe = frame.copy(w = 40.0)\n\ncustomization =\n    \"\"\"\n    this.style.border = \"0px solid transparent\"\n    this.style.borderLeft = \"3px solid red\"\n    this.style.background = \"transparent\"\n    this.style.marginTop = \"0px\"\n    this.style.paddingTop = \"0px\"\n    this.style.setProperty(\"--box-border\", \"0\")\n    this.style.fontStyle = \"italic\"\n    this.style.color = \"white\"\n    this.lock_w = true\n    this.lock_h = true\n\"\"\"\n"}}} {"id" "demo_notes" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "notes" "_tombstone" false "frame" #afield/rect [1300.0 1500.0 300.0 100.0] "code" #afield/file-inline {"path" "demo_notes_code_.kt" "inline" "// Marks on the drawing layer (alt/option-D), owned by this box and redrawn when it reruns.\nval byName = inside.boxes.values.associateBy { it.name }\nnotation {\n    stroke = \"#1971c2\"\n    ellipse(10, 10, 360, 160)\n    text(\"one value, pushed down\", 40, -30)\n    arrow(from = byName.getValue(\"palette\"), to = byName.getValue(\"gyroid\"), label = \"and beside it, 3D\")\n    stroke = \"#e8590c\"\n    rect(2270, 10, 740, 700, label = \"Vulkan, streamed into the page\")\n    arrow(from = byName.getValue(\"probed particles\"), to = byName.getValue(\"streamed spiral\"), label = \"probed\")\n    stroke = \"#2f9e44\"\n    rect(4380, 40, 1000, 860, label = \"a timeline to scrub\")\n    stroke((0..80).map { k -> vec(1300 + k * 12.0, 1440 + 30 * sin(k / 5.0)) }, stroke = \"#2f9e44\")\n}\nmarkdown(\"marks\", \"\" + notation.mine.size + \" marks drawn on the drawing layer\")\n"}}} {"id" "demo_leaf" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "demo_sketch"} "name" "leaf" "_tombstone" false "frame" #afield/rect [20.0 20.0 200.0 60.0] "code" #afield/file-inline {"path" "demo_leaf_code_.kt" "inline" "println(\"a nested leaf, \" + petals + \" petals above it\")\n"} "nestedIn" #afield/box "demo_sketch"}} {"id" "demo_brightness" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "brightness" "_tombstone" false "frame" #afield/rect [2300.0 860.0 300.0 100.0] "code" #afield/file-inline {"path" "demo_brightness_code_.kt" "inline" "// A keyframe curve with its playhead running, and a meter it drives.\nval brightness = keyframes(name = \"brightness\", defaults = [vec(0.0, 0.1), vec(1.0, 0.9), vec(2.5, 0.4), vec(4.0, 0.1)])\n\nlateinit var level: MeterHandle\ncontrolGroup(\"level\") { level = meter(\"brightness\") }\ndisplayOpen(\"level\")\n\nval start = System.nanoTime()\nloop {\n    val t = ((System.nanoTime() - start) / 1e9) % 4.0\n    brightness.setTime(t)\n    level.set(brightness.evaluateValueAt(t))\n}\n"}}} {"id" "demo_draw" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "demo_particles"} "name" "draw particles" "_tombstone" false "frame" #afield/rect [3300.0 680.0 300.0 100.0] "vertex" #afield/file-inline {"path" "demo_draw_vertex_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\nlayout(std430, buffer_reference) buffer inData {\n    vec4 pos[];\n};\nlayout(location = 0) out vec2 tc;\nlayout(push_constant) uniform push {\n    inData inData;\n    float aspectRatio;\n} pc;\nconst vec3[6] part = vec3[6](vec3(0,0,0),vec3(1,0,0),vec3(1,1,0),vec3(0,0,0),vec3(1,1,0),vec3(0,1,0));\nvoid main() {\n    float scale = 1.0 * pc.inData.pos[gl_VertexIndex/6].w;\n    vec3 p = (part[gl_VertexIndex%6]-vec3(0.5,0.5,0))*scale;\n    p.xy += pc.inData.pos[gl_VertexIndex/6].xy*10.0;\n    p.xy *= vec2(1/pc.aspectRatio, 1);\n    gl_Position = vec4(p*0.04, 1);\n    tc = part[gl_VertexIndex%6].xy;\n}\n"} "fragment" #afield/file-inline {"path" "demo_draw_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 0) in vec2 tc;\nvoid main() {\n    float d = max(0.0, 0.5-length(tc-vec2(0.5)));\n    float w = fwidth(d);\n    d = smoothstep(0.1, 0.1+w, d)*smoothstep(0.14+w, 0.14, d);\n    uFragColor = vec4(1.0, 0.8, 0.4, d*0.2);\n    if (d<0.01) discard;\n}\n"} "code" #afield/file-inline {"path" "demo_draw_code_.kt" "inline" "// Draws the particles the compute box publishes as `outputPositions`, in the renderer's window.\nvar module = moduleHere { primitiveType = triangles }\nvar m = Mesh()\nmodule += \"mesh\" to m\nrenderer += \"draw\" to module\nval N = 100000\nm.inData = { outputPositions }\nm.aspectRatio = { window.width / window.height.toFloat() }\nm.set(N * 2 * 3, 0) {}\nprintln(\"draw launched\")\n"}}} {"id" "demo_rosette" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "demo_palette"} "name" "rosette" "_tombstone" false "frame" #afield/rect [640.0 330.0 300.0 100.0] "code" #afield/file-inline {"path" "demo_rosette_code_.kt" "inline" "// The same `petals`, drawn as FLines.\nval rings =\n    (0 until petals).map { i ->\n        val a = i * 2 * PI / petals\n        fline {\n            color = vec(0.35 + 0.6 * i / petals, 0.7, 1.0 - 0.5 * i / petals, 0.8)\n            thickness = 1.5\n            moveTo(vec(0.0, 0.0, 0.0))\n            cubicTo(\n                vec(120 * cos(a - 0.5), 120 * sin(a - 0.5), 0.0),\n                vec(160 * cos(a + 0.5), 160 * sin(a + 0.5), 0.0),\n                vec(0.0, 0.0, 0.0),\n            )\n        }\n    }\nlines(rings, w = 300.0, h = 300.0, fitToSize = true)\n"}}} {"id" "demo_flower" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "editable flower" "_tombstone" false "frame" #afield/rect [1300.0 760.0 300.0 100.0] "code" #afield/file-inline {"path" "demo_flower_code_.kt" "inline" "// Click a point and drag it: the edit changes these FLines.\nval petal = fline {\n    moveTo(0, -120)\n    cubicTo(90, -100, 140, -20, 0, 120)\n    cubicTo(-140, -20, -90, -100, 0, -120)\n    close()\n    filled = true\n    stroked = true\n    thickness = 1.0\n    color = vec(0.95, 0.42, 0.6, 0.34)\n}\nval stem = fline {\n    moveTo(0, 120)\n    cubicTo(10, 180, -20, 230, 0, 300)\n    thickness = 1.0\n    color = vec(0.45, 0.95, 0.62, 1.0)\n}\nlines(petal, stem, w = 420.0, h = 420.0, fitToSize = true, editable = true)\ndisplayOpen(\"lines\")\n"}}} {"id" "demo_spiral" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "demo_renderer"} "name" "streamed spiral" "_tombstone" false "frame" #afield/rect [2300.0 240.0 300.0 100.0] "vertex" #afield/file-inline {"path" "demo_spiral_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\nlayout (location = 1) in vec2 tc;\n\nlayout (location = 1) out vec2 ftc;\n\nvoid main()\n{\n    gl_Position = vec4(pos, 1);\n    ftc = tc;\n}\n"} "fragment" #afield/file-inline {"path" "demo_spiral_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 1) in vec2 ftc;\n\nlayout(push_constant) uniform constants {\n    float time;\n} pc;\n\nvoid main()\n{\n    vec2 p = ftc * 2.0 - 1.0;\n    float r = length(p);\n    float rings = 0.5 + 0.5 * sin(24.0 * r - 3.0 * pc.time + 5.0 * atan(p.y, p.x));\n    vec3 col = mix(vec3(0.05, 0.10, 0.30), vec3(1.0, 0.65, 0.25), rings);\n    uFragColor = vec4(col, 1.0);\n}\n"} "code" #afield/file-inline {"path" "demo_spiral_code_.kt" "inline" "import afield.media.stream.ElectronRTTView\n\n// Drawn by Vulkan, streamed into this box's output panel.\nval view = ElectronRTTView(640, 360)\nval started = AnimationClock.nowSeconds()\n\nview += \"content\" to moduleHere {\n    +view\n    +Mesh(\"square\") {\n        set(4, 2) {\n            pos.add(-1, -1, 0, 1, -1, 0, 1, 1, 0, -1, 1, 0)\n            tc.add(0, 0, 1, 0, 1, 1, 0, 1)\n            tri.add(0, 1, 2)\n            tri.add(0, 2, 3)\n        }\n        time = { AnimationClock.nowSeconds() - started }\n    }\n}\n\ndisplay(\"main\", view.html())\ndisplayOpen(\"main\")\n"}}} {"id" "demo_renderer" "properties" {"children" #{#afield/box "demo_spiral" #afield/box "demo_particles"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [2300.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "demo_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nOptions.profiling = false\nonce.renderer {\n    window = Window(\"Field demo document\")\n    Renderer(window)\n}\nprintln(\"renderer ready\")\nstart(renderer::run)\n"}}} {"id" "demo_sketch" "properties" {"children" #{#afield/box "demo_leaf" #afield/box "demo_bud"} "parents" #{#afield/box "root" #afield/box "demo_palette"} "name" "sketch" "_tombstone" false "frame" #afield/rect [40.0 760.0 300.0 100.0] "code" #afield/file-inline {"path" "demo_sketch_code_.kt" "inline" "// Two helpers are nested inside this box: open its \"nested\" panel to see them.\nmarkdown(\"sketch holds \" + nested.size + \" nested helpers, and \" + petals + \" petals from above\")\ndisplayOpen(\"main\")\ndisplayOpen(\"nested\")\n"} "nested" #{#afield/box "demo_leaf" #afield/box "demo_bud"}}} {"id" "demo_palette" "properties" {"children" #{#afield/box "demo_swatch" #afield/box "demo_rosette" #afield/box "demo_sketch"} "parents" #{#afield/box "root"} "name" "palette" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "demo_palette_code_.kt" "inline" "// Everything connected beneath this box sees `petals`, and reruns when it changes.\npropDown<Int>(petals) = 7\nmarkdown(\"Pushing **\" + petals + \" petals** down to every box connected beneath this one.\")\ndisplayOpen(\"main\")\n"}}} {"id" "demo_metrics" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "metrics" "_tombstone" false "frame" #afield/rect [3300.0 860.0 300.0 100.0] "code" #afield/file-inline {"path" "demo_metrics_code_.kt" "inline" "// Open this box's editor, then launch it: the three calls draw beside their own lines.\nvar tick = 0.0\nvar visualizerFrame = 0\n\nprintln(\"inline metrics ready\")\n\nloop {\n    tick += 0.4\n    visualizerFrame += 1\n\n    if (visualizerFrame % 2 == 0) {\n        val value = sin(tick * 0.22) * 0.7 + cos(tick * 0.11) * 0.2 + tick * 0.01\n\n        __m(\"histogram\").histogram(value, dur = 120)\n        __m(\"trail\").history(value, dur = 48)\n        __m(\"summary\").stats(value, dur = 48)\n    }\n    frame()\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}