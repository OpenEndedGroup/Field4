{"version" 2 "boxes" [{"id" "mp_contrast" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - contrast profile" "_tombstone" false "frame" #afield/rect [60.0 2160.0 300.0 100.0] "code" #afield/file-inline {"path" "mp_contrast_code_.kt" "inline" "import afield.math.matrixprofile.*\nimport kotlin.math.*\n\n// Every example has a sine bump at 100. Only the positive ones have a step at 400.\nval rnd = java.util.Random(14)\nfun example(withStep: Boolean) = 600 { i ->\n    rnd.nextGaussian() * 0.3 +\n        (if (i in 100 until 140) 3 * sin(2 * PI * (i - 100) / 40) else 0.0) +\n        (if (withStep && i in 400 until 440) (if (i < 420) 3.0 else -3.0) else 0.0)\n}.toDoubleArray()\n\nval cp = contrastProfile([example(true), example(true)], [example(false), example(false)], m = 40)\nval platos = cp.platos(2)\nval plato = platos.first()\n\nshowSignals(\n    \"positives\" to cp.positive.toList(), \"contrast\" to cp.profile,\n    regions = platos.map { SignalRegion(\"plato\", it.index, it.index + cp.m, \"#ffe066\") },\n    title = \"plato in example ${plato.example} at ${plato.offset}, contrast ${\"%.2f\".format(plato.contrast)}\",\n    channel = \"main\", normalize = true, width = 1000, height = 420, floatingLegend = true,\n)\n"}}} {"id" "mp_motifs" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - motifs" "_tombstone" false "frame" #afield/rect [60.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "mp_motifs_code_.kt" "inline" "import afield.math.matrixprofile.*\nimport kotlin.math.*\n\n// A slow random walk with the same wiggle hidden in it three times.\nval rnd = java.util.Random(4)\nvar level = 0.0\nval series = 3000 { level += rnd.nextGaussian() * 0.1; level }.toMutableList()\nfor (at in [500, 1400, 2500]) for (k in 0 until 60) series[at + k] += 2 * sin(2 * PI * k / 60)\n\nval mp = matrixProfile(series, m = 60)\nval motif = mp.motifs(1).first()\n\nshowSignals(\n    \"series\" to series, \"matrix profile\" to mp.profile,\n    regions = motif.indices.map { SignalRegion(\"motif\", it, it + mp.m, \"#8fff9a\") },\n    title = \"motif at ${motif.indices}, pair distance ${\"%.2f\".format(motif.pairDistance)}\",\n    channel = \"main\", normalize = true, width = 1000, height = 420, floatingLegend = true,\n)\n"}}} {"id" "mp_multidimensional" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - several channels (mSTAMP)" "_tombstone" false "frame" #afield/rect [60.0 1460.0 300.0 100.0] "code" #afield/file-inline {"path" "mp_multidimensional_code_.kt" "inline" "import afield.math.matrixprofile.*\nimport kotlin.math.*\n\n// Four channels of noise. A 40-sample gesture appears in channels 1 and 3, at two times.\nval rnd = java.util.Random(13)\nval channels = 4 { 1500 { rnd.nextGaussian() }.toMutableList() }\nfor (at in [300, 1000]) for (k in 0 until 40) {\n    channels[1][at + k] += 4 * sin(2 * PI * k / 40)\n    channels[3][at + k] -= 4 * sin(2 * PI * k / 40)\n}\n\nval mmp = multiMatrixProfile(channels, m = 40)\nval motif = mmp.motifs(k = 2, count = 1).first()\n\nshowSignals(\n    *Array(4) { k -> \"${k + 1} channel(s)\" to mmp.profile(k + 1) },\n    regions = motif.indices.map { SignalRegion(\"motif\", it, it + mmp.m, \"#8fff9a\") },\n    title = \"two-channel motif at ${motif.indices}, channels ${motif.channels.sorted()}\",\n    channel = \"main\", width = 1000, height = 420, floatingLegend = true,\n)\n"}}} {"id" "mp_discords" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - discords" "_tombstone" false "frame" #afield/rect [60.0 760.0 300.0 100.0] "code" #afield/file-inline {"path" "mp_discords_code_.kt" "inline" "import afield.math.matrixprofile.*\nimport kotlin.math.*\n\n// 40 beats of 80 samples. Beat 21 has a doubled, late pulse.\nval rnd = java.util.Random(15)\nfun bump(t: Double, at: Double, w: Double) = exp(-((t - at) / w).pow(2))\nval beats = (40 * 80) { i ->\n    val t = (i % 80).toDouble()\n    val pulse = if (i / 80 == 21) 2 * (bump(t, 35.0, 3.0) + bump(t, 50.0, 3.0)) else 3 * bump(t, 30.0, 3.0)\n    pulse - 0.6 * bump(t, 45.0, 6.0) + rnd.nextGaussian() * 0.05\n}\n\nval mp = matrixProfile(beats, m = 80)\nval discord = mp.discords(1).first()\n\nshowSignals(\n    \"beats\" to beats, \"matrix profile\" to mp.profile,\n    regions = [SignalRegion(\"discord\", discord.index, discord.index + mp.m, \"#ff7a9e\")],\n    title = \"discord at ${discord.index} (beat ${discord.index / 80}), distance ${\"%.2f\".format(discord.distance)}\",\n    channel = \"main\", normalize = true, width = 1000, height = 420, floatingLegend = true,\n)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}