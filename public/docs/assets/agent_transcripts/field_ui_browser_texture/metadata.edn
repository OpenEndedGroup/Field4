{"version" 2 "boxes" [{"id" "field_ui_texture_panel" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "field_ui_texture_renderer"} "name" "Field's UI — live Chromium texture" "_tombstone" false "frame" #afield/rect [460.0 180.0 330.0 55.0] "code" #afield/file-inline {"path" "field_ui_texture_panel_code_.kt" "inline" "import afield.four.browser.FieldUiBrowserTexture\nimport afield.four.modules.fromContext\n\nval renderer: Renderer = fromContext()\nval browser = FieldUiBrowserTexture(\n    renderer = renderer,\n    url = FieldUiBrowserTexture.fieldDocumentUrl(thisBox),\n    width = 1280,\n    height = 720,\n    readyBoxUid = thisBox.id\n)\nrenderer.renderList.preTargets[\"field-ui-browser-upload\"] =\n    afield.four.Target { command, _ -> browser.prepareSampledImagesFor(command) }\n\nval material = moduleHere {\n    textures(\"fieldUi\" to browser)\n}\nval panel = Mesh()\nmaterial += \"field-ui-panel\" to panel\nrenderer += \"field-ui-browser-texture\" to material\n\npanel.set(4, 2) {\n    pos.add(\n        -0.96, -0.96, 0.0,\n         0.96, -0.96, 0.0,\n         0.96,  0.96, 0.0,\n        -0.96,  0.96, 0.0\n    )\n    tc.add(0, 0, 1, 0, 1, 1, 0, 1)\n    tri.add(0, 1, 2, 0, 2, 3)\n}\n\nvar announced = false\nloop {\n    if (!announced && browser.pageReady) {\n        announced = true\n        println(\"Field UI browser texture is live: ${browser.presentedFrame}\")\n    }\n    frame()\n}.end {\n    renderer.renderList.modules.remove(\"field-ui-browser-texture\")\n    renderer.renderList.preTargets.remove(\"field-ui-browser-upload\")\n    browser.close()\n}\n"} "vertex" #afield/file-inline {"path" "field_ui_texture_panel_vertex_.glsl" "inline" "#version 450\nlayout(location = 0) in vec3 pos;\nlayout(location = 1) in vec2 tc;\nlayout(location = 1) out vec2 ftc;\n\nvoid main() {\n    gl_Position = vec4(pos, 1.0);\n    ftc = tc;\n}\n"} "fragment" #afield/file-inline {"path" "field_ui_texture_panel_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 color;\nlayout(location = 1) in vec2 ftc;\nlayout(set = 0, binding = 0) uniform sampler2D fieldUi;\n\nvoid main() {\n    color = vec4(texture(fieldUi, vec2(ftc.x, 1.0 - ftc.y)).rgb, 1.0);\n}\n"}}} {"id" "field_ui_texture_renderer" "properties" {"children" #{#afield/box "field_ui_texture_panel"} "parents" #{#afield/box "root"} "name" "renderer — Field UI texture" "_tombstone" false "frame" #afield/rect [140.0 180.0 250.0 55.0] "code" #afield/file-inline {"path" "field_ui_texture_renderer_code_.kt" "inline" "import afield.four.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\nOptions.profiling = false\n\nonce.renderer {\n    window = Window(\"Field UI on a texture\")\n    Renderer(window)\n}\n\nprintln(\"Field UI texture renderer ready\")\nstart(renderer::run)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory"]}