{"version" 2 "boxes" [{"id" "field_ui_texture_panel" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "field_ui_texture_renderer"} "name" "Field's UI — live Chromium texture" "_tombstone" false "frame" #afield/rect [560.0 180.0 430.0 105.0] "code" #afield/file-inline {"path" "field_ui_texture_panel_code_.kt" "inline" "import afield.four.browser.FieldUiBrowserTexture\nimport afield.four.browser.PuppetBrowser\nimport afield.four.browser.PuppetBrowserUvInput\nimport afield.four.browser.PuppetBrowserWindowInput\nimport afield.four.modules.fromContext\nimport kotlinx.serialization.json.JsonElement\nimport kotlinx.serialization.json.buildJsonObject\nimport kotlinx.serialization.json.put\nimport java.util.concurrent.CompletableFuture\n\nval renderer: Renderer = fromContext()\nprop<afield.four.browser.PuppetBrowser>(browserControl)\nval browser = FieldUiBrowserTexture(\n    renderer = renderer,\n    url = FieldUiBrowserTexture.fieldDocumentUrl(thisBox),\n    width = 1280,\n    height = 720,\n    readyBoxUid = thisBox.id,\n    // Linux: Chromium's shared-texture export never fills the buffer (electron#53271).\n    cpuBitmapFallback = FieldUiBrowserTexture.cpuBitmapFallbackRequired\n)\nbrowserControl = browser\nval interaction = PuppetBrowserWindowInput(browser, renderer.window)\nval scriptedInput = PuppetBrowserUvInput(browser)\nval removeReadyBridge = browser.onPageRequest(\"field-ready\") { payload ->\n    println(\"Field UI page called Field: $payload\")\n    CompletableFuture.completedFuture<JsonElement>(buildJsonObject {\n        put(\"accepted\", true)\n        put(\"echo\", payload)\n    })\n}\nrenderer.renderList.preTargets[\"field-ui-browser-upload\"] =\n    afield.four.Target { command, _ -> browser.prepareSampledImagesFor(command) }\n\nval material = moduleHere {\n    textures(\"fieldUi\" to browser)\n}\nval panel = Mesh()\nmaterial += \"field-ui-panel\" to panel\nrenderer += \"field-ui-browser-texture\" to material\n\npanel.set(4, 2) {\n    pos.add(\n        -0.96, -0.96, 0.0,\n         0.96, -0.96, 0.0,\n         0.96,  0.96, 0.0,\n        -0.96,  0.96, 0.0\n    )\n    tc.add(0, 0, 1, 0, 1, 1, 0, 1)\n    tri.add(0, 1, 2, 0, 2, 3)\n}\n\nvar announced = false\nloop {\n    if (!announced && browser.pageReady) {\n        announced = true\n        println(\"Field UI browser texture is live: ${browser.presentedFrame}\")\n        browser.evaluate(\"\"\"\n            new Promise((resolve, reject) => {\n                const deadline = Date.now() + 10000\n                const prepare = () => {\n                    if (typeof window.fieldBackdoorPrepareWindowScreenshot !== \"function\") {\n                        if (Date.now() < deadline) return setTimeout(prepare, 100)\n                        return reject(new Error(\"Field screenshot preparation API did not appear\"))\n                    }\n                    const result = JSON.parse(window.fieldBackdoorPrepareWindowScreenshot({\n                        uid: \"field_ui_texture_panel\",\n                        property: \"code\",\n                        showEditor: true,\n                        panIntoView: true,\n                        openOutputs: false,\n                        padding: 18\n                    }))\n                    if (result.success) resolve(result)\n                    else if (Date.now() < deadline) setTimeout(prepare, 100)\n                    else reject(new Error(result.message || \"could not open the selected box editor\"))\n                }\n                prepare()\n            })\n        \"\"\").thenCompose {\n            browser.evaluate(\"\"\"\n            (() => {\n                const probe = document.createElement(\"input\")\n                probe.id = \"field-puppet-input-probe\"\n                probe.style.cssText = \"position:fixed;left:8px;top:8px;width:280px;height:40px;z-index:2147483647;opacity:.01\"\n                document.body.appendChild(probe)\n                return true\n            })()\n            \"\"\")\n        }.thenCompose {\n            scriptedInput.move(40.0 / scriptedInput.cssWidth, 28.0 / scriptedInput.cssHeight)\n            scriptedInput.down()\n            scriptedInput.up()\n            browser.insertText(\"always available in VR\")\n            browser.flushInput()\n        }.thenCompose {\n            browser.evaluate(\"\"\"\n                (() => {\n                    const probe = document.getElementById(\"field-puppet-input-probe\")\n                    const input = probe.value\n                    probe.remove()\n                    return window.fieldPuppet.request(\"field-ready\", {\n                        title: document.title,\n                        location: location.href,\n                        input\n                    })\n                })()\n            \"\"\")\n        }.whenComplete { result, error ->\n            if (error == null) println(\"Puppet page/Field/JavaScript round trip: ${result.value}\")\n            else error.printStackTrace()\n        }\n    }\n    frame()\n}.end {\n    renderer.renderList.modules.remove(\"field-ui-browser-texture\")\n    renderer.renderList.preTargets.remove(\"field-ui-browser-upload\")\n    removeReadyBridge()\n    interaction.close()\n    browser.close()\n}\n"} "vertex" #afield/file-inline {"path" "field_ui_texture_panel_vertex_.glsl" "inline" "#version 450\nlayout(location = 0) in vec3 pos;\nlayout(location = 1) in vec2 tc;\nlayout(location = 1) out vec2 ftc;\n\nvoid main() {\n    gl_Position = vec4(pos, 1.0);\n    ftc = tc;\n}\n"} "fragment" #afield/file-inline {"path" "field_ui_texture_panel_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 color;\nlayout(location = 1) in vec2 ftc;\nlayout(set = 0, binding = 0) uniform sampler2D fieldUi;\n\nvoid main() {\n    color = vec4(texture(fieldUi, vec2(ftc.x, 1.0 - ftc.y)).rgb, 1.0);\n}\n"}}} {"id" "field_ui_texture_renderer" "properties" {"children" #{#afield/box "field_ui_texture_panel"} "parents" #{#afield/box "root"} "name" "renderer — Field UI texture" "_tombstone" false "frame" #afield/rect [140.0 180.0 350.0 105.0] "code" #afield/file-inline {"path" "field_ui_texture_renderer_code_.kt" "inline" "import afield.four.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\nOptions.profiling = false\n\nonce.renderer {\n    window = Window(\"Field UI on a texture\")\n    Renderer(window)\n}\n\nprintln(\"Field UI texture renderer ready\")\nstart(renderer::run)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}