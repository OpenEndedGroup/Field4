{"version" 2 "boxes" [{"id" "fire_starter" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "fire_forest"} "name" "fire starter" "_tombstone" false "frame" #afield/rect [340.0 160.0 300.0 100.0] "code" #afield/file-inline {"path" "fire_starter_code_.kt" "inline" "/*\nDraws into the fire's ignition texture: two points that burn for ever, one red\nand one green. Each relights its neighbourhood as soon as the trees recover, so\neach sends out a train of rings, and where the trains meet one kind takes over.\n*/\nfire.clearFireInput()\nfire.clearState()\n\nvar module = moduleHere(fire.fireInputParameters(\"starter\"))\nfire.addFireInput(\"starter\", module)\n\nval quad = fullscreenTriangle(module)\nmodule += \"quad\" to quad\n\n// positions are in trees, so place them as fractions of the forest's size\nval w = fire.settings.width.toFloat()\nval h = fire.settings.height.toFloat()\nquad.red = { vec(w * 0.33f, h * 0.5f) }\nquad.green = { vec(w * 0.68f, h * 0.5f) }\nquad.radius = { 4f }\n"} "vertex" #afield/file-inline {"path" "fire_starter_vertex_.glsl" "inline" "#version 450\n\n// one triangle that covers the whole target; positions come from the vertex index\nvec2 fullscreenVertex(uint index) {\n    if (index == 0u) return vec2(-1.0, -1.0);\n    if (index == 1u) return vec2(3.0, -1.0);\n    return vec2(-1.0, 3.0);\n}\n\nvoid main() {\n    gl_Position = vec4(fullscreenVertex(uint(gl_VertexIndex)), 0.0, 1.0);\n}\n"} "fragment" #afield/file-inline {"path" "fire_starter_fragment_.glsl" "inline" "#version 450\n\nlayout(push_constant) uniform Push {\n    vec2 red;\n    vec2 green;\n    float radius;\n} push;\n\nlayout(location = 0) out vec4 outColor;\n\n// one kind of fire per channel; additive, so writing 1 into a channel lights that kind here\nvoid main() {\n    vec2 p = gl_FragCoord.xy;\n    outColor = vec4(0.0);\n    if (distance(p, push.red) < push.radius) outColor.r = 1.0;\n    if (distance(p, push.green) < push.radius) outColor.g = 1.0;\n}\n"}}} {"id" "fire_renderer" "properties" {"children" #{#afield/box "fire_forest"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "fire_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nOptions.profiling = false\n// once: re-running this box keeps the existing window and renderer\nonce.renderer {\n    window = Window(\"Forest fire\", initialDimensions = Rect(80.0, 80.0, 768.0, 768.0))\n    Renderer(window)\n}\nprintln(\"renderer ready\")\n// the frame loop runs as this box's coroutine; stopping the box stops rendering\nstart(renderer::run)\n"}}} {"id" "fire_forest" "properties" {"children" #{#afield/box "fire_starter"} "parents" #{#afield/box "root" #afield/box "fire_renderer"} "name" "forest" "_tombstone" false "frame" #afield/rect [340.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "fire_forest_code_.kt" "inline" "/*\nA forest fire: a fixed scatter of trees, and four kinds of fire (red, green, blue,\nmagenta) that compete for them. Burnt trees recover, so a fire front can be\nfollowed by another. Nothing burns until something is lit; the box beneath this\none lights it.\nThe forest is 768 trees high and as wide as the window's shape needs, so it fills\nthe window without being stretched.\n*/\nval treesHigh = 768\nprop<ShaderForestFireSystem>(fire) = ShaderForestFireSystem() {\n    height = treesHigh\n    width = treesHigh * window.width / window.height\n    treeDensity = 0.6f\n}\n\n// this installs the editable spreading rule in this box's fragment tab\nfire.installInto()\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}