{"version" 2 "boxes" [{"id" "kratos_structural" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Kratos structural playground" "_tombstone" false "frame" #afield/rect [60.0 220.0 400.0 100.0] "code" #afield/file-inline {"path" "kratos_structural_code_.kt" "inline" "import afield.geometry.mesh.tetgen.Tetgen\nimport afield.geometry.mesh.tetgen.TetgenLibrary\nimport afield.geometry.solid.manifold.ManifoldLibrary\nimport afield.simulation.kratos.*\nimport java.util.concurrent.atomic.AtomicReference\n\n/*\nLaunch (Alt-R). Drag a slider to reshape the bracket — that part is instant.\nPress Solve to mesh and run Kratos; a solve is seconds, so it is a button.\nInstall once: uv sync --project optional/kratos --frozen\n  (or, where Kratos has no wheels: podman build --platform linux/amd64\n   -t field-kratos:10.4.0 optional/kratos)\n  plus: python3 tools/build_tetgen_native.py\nSI units: metres, newtons, pascals. +Y is up, which is also the mesh viewer's up.\n*/\n\n// A queued request keeps the physical inputs from the button press, including its load.\ndata class SolveRequest(\n    val arm: Double,\n    val elementSize: Double,\n    val order: Int,\n    val loadKN: Double,\n    val epoch: Long,\n) {\n    val meshKey\n        get() = Triple(arm, elementSize, order)\n\n    val comparisonKey\n        get() = Triple(arm, elementSize, loadKN)\n}\ndata class PendingSolve(\n    val request: SolveRequest,\n    val future: java.util.concurrent.CompletableFuture<SimulationResult?>,\n)\n\n// arm length, element size, element order, tip load (kN), deflection exaggeration\nval settings = AtomicReference([0.24, 0.025, 2.0, 3.0, 300.0])\n/*\n\"compare\" on launch, not \"solve\": the first thing this box should put on screen is both\norders side by side, because that comparison is the whole point of it. It costs two\nworker starts, so it is also the slowest thing here — the status line narrates.\n*/\nval action = AtomicReference(\"compare\")\nfun change(index: Int, value: Double) {\n    settings.updateAndGet { old -> old.mapIndexed { i, v -> if (i == index) value else v } }\n}\ncontrolGroup(\"controls\") {\n    slider(\"Arm length (m)\", min = 0.12, max = 0.36, step = 0.01, initialValue = 0.24) { change(0, it) }\n    slider(\"Element size (m)\", min = 0.015, max = 0.05, step = 0.005, initialValue = 0.025) { change(1, it) }\n    slider(\"Element order (1 linear, 2 quadratic)\", min = 1.0, max = 2.0, step = 1.0, initialValue = 2.0) {\n        change(2, it)\n    }\n    slider(\"Tip load (kN, downward)\", min = 0.0, max = 8.0, step = 0.25, initialValue = 3.0) { change(3, it) }\n    slider(\"Deflection exaggeration\", min = 0.0, max = 800.0, step = 25.0, initialValue = 300.0) { change(4, it) }\n    button(\"Solve\") { if (it) action.set(\"solve\") }\n    button(\"Compare orders\") { if (it) action.set(\"compare\") }\n    button(\"Cancel\") { if (it) action.set(\"cancel\") }\n}\ndisplayOpen(\"controls\")\n\nfun safe(value: Any?): String = value.toString().replace(\"&\", \"&amp;\").replace(\"<\", \"&lt;\").replace(\">\", \"&gt;\")\n// Diagnostics arrive as full-precision doubles; a status line wants three figures.\nfun num(value: Any?, digits: Int = 3): String =\n    (value as? Number)?.let { \"%.${digits}f\".format(it.toDouble()) } ?: safe(value)\nfun mm(value: Any?): String = num(1000.0 * ((value as? Number)?.toDouble() ?: 0.0), 3)\nfun status(text: String) {\n    display(\"status\", \"<div id='kratos-structural-status' style='padding:12px;max-width:820px'>$text</div>\")\n    displayOpen(\"status\")\n}\n\n/*\nSteel, and a bracket 60 mm square in section, standing in +Y because that is the mesh\nviewer's up. The re-entrant corner where the arm meets the post is the whole reason\nthis route is body-fitted: a level set rounds that edge by ~0.4 of a background cell at\nevery resolution, and it is exactly where the stress peaks.\n*/\nval SECTION = 0.06\nval POST = 0.30\nfun bracket(arm: Double): SimulationGeometry = SimulationCSG(\n    \"bracket\",\n    SimulationBox(\"post\", SimulationBounds(0.0, 0.0, 0.0, SECTION, POST, SECTION)),\n    SimulationBox(\"arm\", SimulationBounds(0.0, POST - SECTION, 0.0, arm, POST, SECTION)),\n)\n\nfun loads(arm: Double, kilonewtons: Double) = StructuralParameters(\n    youngModulus = 2.1e11,\n    poissonRatio = 0.3,\n    density = 7850.0,\n    gravity = Triple(0.0, -9.81, 0.0),\n    // The foot of the post is fully fixed; the load hangs off the end face of the arm.\n    clamp = SimulationBounds(-1.0, -1e-6, -1.0, 1.0, 1e-6, 1.0),\n    loadRegion = SimulationBounds(arm - 1e-6, -1.0, -1.0, arm + 1e-6, 1.0, 1.0),\n    load = Triple(0.0, -1000.0 * kilonewtons, 0.0),\n)\n\nstatus(\"Checking the optional environment…\")\n\nframes {\n    if (!ManifoldLibrary.isAvailable) {\n        status(\"Manifold unavailable: ${safe(ManifoldLibrary.describe())}\")\n        return@frames\n    }\n    if (!TetgenLibrary.isAvailable) {\n        status(\"TetGen unavailable: ${safe(TetgenLibrary.describe())}\")\n        return@frames\n    }\n    val config = KratosConfig.candidates().first()\n    var session: KratosSession? = null\n    var meshed: Triple<Double, Double, Int>? = null\n    var cells = 0\n    var shownGeometry = -1.0\n    var opening: java.util.concurrent.CompletableFuture<KratosSession>? = null\n    var pending: PendingSolve? = null\n    // Compare orders copies one snapshot; later slider edits cannot mix its two loads or shapes.\n    val queue = ArrayDeque<SolveRequest>()\n    /*\n    Finished results by nodes-per-tetrahedron, so the two orders accumulate on screen\n    rather than replacing each other. A result holds its own mesh and arrays, so it\n    stays drawable after its session is closed.\n    */\n    val results = LinkedHashMap<Int, SimulationResult>()\n    var comparison: Triple<Double, Double, Double>? = null\n    var requestEpoch = 0L\n    var publications = 0L\n    var latestRequest: SolveRequest? = null\n    var drawnFor: Pair<Double, Long>? = null\n    fun request(values: List<Double>, order: Int) = SolveRequest(values[0], values[1], order, values[3], requestEpoch)\n    fun isCurrent(request: SolveRequest): Boolean {\n        val now = settings.get()\n        return action.get() != \"cancel\" &&\n            request.epoch == requestEpoch &&\n            request.comparisonKey == Triple(now[0], now[1], now[3])\n    }\n    var resultText = \"Meshing…\"\n    var previous = \"\"\n\n    try {\n        while (true) {\n            val values = settings.get()\n            val command = action.getAndSet(\"\")\n\n            // Geometry preview is Manifold only and costs nothing, so it follows the\n            // slider. Meshing and solving do not.\n            if (values[0] != shownGeometry) {\n                showMeshGrid(\n                    \"Bracket · drag to orbit\" to bracket(values[0]).surface(),\n                    channel = \"geometry\",\n                    cellWidth = 380,\n                    view = MeshView(yawDegrees = -28.0, pitchDegrees = 12.0),\n                )\n                displayOpen(\"geometry\")\n                shownGeometry = values[0]\n            }\n            // Arm, mesh size and load define a comparison. Clear the picture when any changes.\n            val currentComparison = Triple(values[0], values[1], values[3])\n            if (currentComparison != comparison) {\n                comparison = currentComparison\n                requestEpoch++\n                queue.clear()\n                if (pending != null) session?.cancel()\n                results.clear()\n                latestRequest = null\n                publications++\n                drawnFor = null\n                displayClear(\"stress\")\n                resultText = \"Settings changed. Press <b>Solve</b> or <b>Compare orders</b>.\"\n            }\n\n            when (command) {\n                \"cancel\" -> {\n                    requestEpoch++\n                    session?.cancel()\n                    queue.clear()\n                    // Keep the future until it settles, so a new solve cannot overlap this worker.\n                    resultText = \"Cancelled. Press <b>Solve</b> to run again.\"\n                }\n                \"solve\" -> queue.addLast(request(values, values[2].toInt()))\n                \"compare\" -> {\n                    queue.clear()\n                    val first = request(values, 1)\n                    queue.addLast(first)\n                    queue.addLast(first.copy(order = 2))\n                }\n            }\n\n            if (pending == null && queue.isNotEmpty()) {\n                val submitted = queue.removeFirst()\n                if (!isCurrent(submitted)) continue\n                val order = submitted.order\n                val key = submitted.meshKey\n                if (key != meshed) {\n                    /*\n                    A body-fitted formulation solves the mesh it was given, so changing\n                    the geometry or the discretisation means a new mesh and therefore a\n                    new session. That is the invariant the embedded formulations keep\n                    and this one does not; meshing is ~0.2 s, which is what makes\n                    paying it per edit affordable. `order = 2` asks for 10-node\n                    tetrahedra, which is what stops the element locking in bending.\n                    */\n                    session?.close()\n                    session = null\n                    meshed = null\n                    status(\"Meshing at h = ${num(submitted.elementSize, 3)} m, order $order…\")\n                    val built = Tetgen.tetrahedralize(\n                        bracket(submitted.arm).surface(),\n                        targetEdgeLength = submitted.elementSize,\n                        order = order,\n                    )\n                    cells = built.cellCount\n                    status(\"Meshed to $built. Starting a worker…\")\n                    val starting = KratosSession.openMeshAsync(built, config)\n                    opening = starting\n                    while (!starting.isDone) frame()\n                    session = starting.get()\n                    opening = null\n                    meshed = key\n                }\n                if (!isCurrent(submitted)) continue\n                pending = PendingSolve(submitted, session!!.solveAsync(loads(submitted.arm, submitted.loadKN)))\n                resultText =\n                    \"Solving $cells tetrahedra at order $order\" +\n                        (if (queue.isEmpty()) \"…\" else \" (${queue.size} more queued)…\")\n            }\n\n            val ready = pending\n            if (ready != null && ready.future.isDone) {\n                pending = null\n                try {\n                    val result = ready.future.get()\n                    if (isCurrent(ready.request)) {\n                        if (result == null) {\n                            resultText = \"Solve completed without a result.\"\n                        } else {\n                            results[result.domain.nodesPerCell] = result\n                            latestRequest = ready.request\n                            // A replacement under the same order is still a new publication.\n                            publications++\n                        }\n                    }\n                } catch (failure: Exception) {\n                    if (isCurrent(ready.request)) {\n                        queue.clear()\n                        resultText = \"Solve failed: ${safe(failure.cause?.message ?: failure.message)}\"\n                    }\n                }\n            }\n\n            // Every accepted result redraws, even when it replaces the same element order.\n            // Exaggeration changes the view without another solve.\n            val stamp = values[4] to publications\n            if (results.isNotEmpty() && stamp != drawnFor) {\n                drawnFor = stamp\n                val displayed = checkNotNull(latestRequest)\n                val scale = values[4]\n                val panels = ArrayList<Pair<String, TriMesh>>()\n                for (width in [4, 10]) results[width]?.let {\n                    panels +=\n                        \"${if (width == 4) \"4-node\" else \"10-node\"} deflected \" +\n                            \"x${scale.toInt()} · ${mm(it.diagnostics[\"displacementMax\"])} mm\" to\n                            it.deformedMesh(displacementScale = scale)\n                }\n                panels += \"Undeformed, von Mises\" to results.values.last().boundaryMesh(\"vonMises\")\n                showMeshGrid(\n                    *panels.toTypedArray(),\n                    channel = \"stress\",\n                    columns = panels.size,\n                    cellWidth = 340,\n                    view = MeshView(yawDegrees = -28.0, pitchDegrees = 12.0, wireframe = false),\n                )\n                displayOpen(\"stress\")\n\n                val newest = results.values.last()\n                val d = newest.diagnostics\n                val comparison =\n                    [4, 10]\n                        .mapNotNull { w ->\n                            results[w]?.let {\n                                \"${if (w == 4) \"4-node\" else \"10-node\"} \" +\n                                    \"${mm(it.diagnostics[\"displacementMax\"])} mm\"\n                            }\n                        }\n                        .joinToString(\" · \")\n                val ratio =\n                    results[4]?.let { linear ->\n                        results[10]?.let { quad ->\n                            \" — the linear element reaches \" +\n                                num(\n                                    100.0 * (linear.diagnostics[\"displacementMax\"] as Number).toDouble() /\n                                        (quad.diagnostics[\"displacementMax\"] as Number).toDouble(),\n                                    0,\n                                ) +\n                                \"% of the quadratic one's deflection on the same mesh size\"\n                        }\n                    } ?: \"\"\n                resultText =\n                    \"<span id='kratos-structural-result' \" +\n                        \"data-background='${newest.domain.id}' \" +\n                        \"data-nodespercell='${newest.domain.nodesPerCell}' \" +\n                        \"data-arm='${displayed.arm}' \" +\n                        \"data-load-kn='${displayed.loadKN}' \" +\n                        \"data-element-size='${displayed.elementSize}' \" +\n                        \"data-displacementmax='${safe(d[\"displacementMax\"])}'>\" +\n                        \"${safe(d[\"element\"])} · ${safe(d[\"nodeCount\"])} nodes · \" +\n                        \"${safe(d[\"cellCount\"])} tetrahedra<br>\" +\n                        \"Peak von Mises ${num(1e-6 * (d[\"vonMisesMax\"] as Number).toDouble(), 1)} MPa · \" +\n                        \"clamped ${safe(d[\"clampedNodes\"])} · loaded ${safe(d[\"loadedNodes\"])} · \" +\n                        \"residual ${safe(d[\"relativeLinearResidual\"])}<br>\" +\n                        \"Assembly ${num(d[\"assemblyMs\"], 0)} ms · solve ${num(d[\"solveMs\"], 0)} ms · \" +\n                        \"stress ${num(d[\"stressRecoveryMs\"], 0)} ms<br>\" +\n                        \"<b>Same load, same element size: $comparison</b>$ratio</span>\"\n            }\n\n            val worker = session\n            val head =\n                if (worker == null) \"<b>no session</b>\"\n                else\n                    \"<b>${worker.state}</b> · ${worker.formulation} · revision ${worker.revision}<br>\" +\n                        \"Mesh ${worker.domain.id} · ${worker.domain.nodeCount} nodes · \" +\n                        \"${worker.domain.cellCount} tetrahedra of ${worker.domain.nodesPerCell} nodes\"\n            val text =\n                head +\n                    \"<br>\" +\n                    resultText +\n                    \"<br><i>Changing the load reuses this mesh and this worker. Changing the arm, \" +\n                    \"the element size or the order cannot: a body-fitted mesh is the geometry, so \" +\n                    \"it is remeshed and a new session opened.</i>\"\n            if (text != previous) {\n                status(text)\n                previous = text\n            }\n            frame()\n        }\n    } catch (failure: Exception) {\n        status(\"Unavailable: ${safe(failure.cause?.message ?: failure.message)}\")\n    } finally {\n        // Stop can arrive while a worker is opening; close it when that future completes.\n        opening?.whenComplete { late, _ -> late?.close() }\n        session?.close()\n    }\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}