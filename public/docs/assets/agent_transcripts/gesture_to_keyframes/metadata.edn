{"version" 2 "boxes" [{"id" "gk_bake" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "gesture to keyframes" "_tombstone" false "frame" #afield/rect [40.0 30.0 320.0 60.0] "code" #afield/file-inline {"path" "gk_bake_code_.kt" "inline" "var p = Vector2f(0f, 0f)\nlateinit var pad: GestureHandle\n\n// A figure eight drawn by a slightly unsteady hand: 240 samples over two seconds.\nval rnd = java.util.Random(7)\nval eight = 240 { i ->\n    val a = i / 239.0 * 2 * Math.PI\n    val wobble = { 0.008 * (rnd.nextDouble() - 0.5) }\n    i / 239.0 * 2.0 to Vector2f((0.7 * Math.sin(a) + wobble()).toFloat(), (0.5 * Math.sin(2 * a) + wobble()).toFloat())\n}\n\nval x = keyframes(\"lanes\", \"x\")\nval y = keyframes(\"lanes\", \"y\")\n\nfun bake() {\n    val (bx, by) = bakeGesture(pad, tolerance = 0.02, channel = \"lanes\")\n    println(\"baked: ${pad.fit(bx, by)}\")\n}\n\ncontrolGroup(\"gesture\") {\n    pad = gesture(\"take\", initialTake = eight) { p = it }\n    button(\"bake take\") { if (it) bake() }\n    button(\"replay lanes\") { if (it) { pad.setTake(x, y); println(\"pad now plays the lanes: ${pad.samples.size} samples\") } }\n}\ndisplayOpen(\"gesture\")\n\nif (x.isEmpty() || y.isEmpty()) bake() else println(\"lanes kept: ${pad.fit(x, y)}\")\n\nval start = System.nanoTime()\nloop {\n    val d = pad.duration\n    if (d > 0) {\n        val t = ((System.nanoTime() - start) / 1e9) % d\n        pad.at(t)?.let { p = it }\n        pad.playhead(t)\n        x.setTime(t)\n        y.setTime(t)\n    }\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_session" "fileManagerAccessHistory"]}