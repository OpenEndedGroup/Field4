{"version" 2 "boxes" [{"id" "contrast_bands" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "ramps as area fills" "_tombstone" false "frame" #afield/rect [80.0 360.0 380.0 100.0] "code" #afield/file-inline {"path" "contrast_bands_code_.kt" "inline" "val white = vec(1.0, 1.0, 1.0, 1.0)\nval blues = contrastScale(colorHex(\"#3b82f6\"), white)\nval ambers = contrastScale(colorHex(\"#eab308\"), white)\n\nfun bands(scale: ContrastScale, x0: Double, phase: Double): List<FLine> =\n    (0 until 6)\n        .map { k ->\n            val top = { x: Double -> 260.0 - k * 34.0 - 26.0 * sin(x * 0.018 + phase + k * 0.5) }\n            fline {\n                moveTo(x0, 300.0)\n                for (i in 0..100) {\n                    val x = x0 + i * 5.0\n                    lineTo(x, top(x))\n                }\n                lineTo(x0 + 500.0, 300.0)\n                lineTo(x0, 300.0)\n                filled = true\n                color = scale.colors[k]\n            }\n        }\n        .reversed()\n\nfun edges(scale: ContrastScale, x0: Double, phase: Double): List<FLine> =\n    (0 until 6).map { k ->\n        fline {\n            for (i in 0..100) {\n                val x = x0 + i * 5.0\n                val y = 260.0 - k * 34.0 - 26.0 * sin(x * 0.018 + phase + k * 0.5)\n                if (i == 0) moveTo(x, y) else lineTo(x, y)\n            }\n            stroked = true\n            color = scale.colors[k + 4]\n            thickness = 1.5\n        }\n    }\n\nlines(\n    bands(blues, 20.0, 0.0) + edges(blues, 20.0, 0.0) + bands(ambers, 560.0, 1.3) + edges(ambers, 560.0, 1.3),\n    channel = \"contrast-bands\",\n    w = 1080.0,\n    h = 320.0,\n    fitToSize = true,\n)\n"}}} {"id" "contrast_swatches" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "contrastScale on white and near-black" "_tombstone" false "frame" #afield/rect [80.0 80.0 380.0 100.0] "code" #afield/file-inline {"path" "contrast_swatches_code_.kt" "inline" "val seeds = [\"#3b82f6\", \"#ef4444\", \"#22c55e\", \"#eab308\"].map { colorHex(it) }\nval white = vec(1.0, 1.0, 1.0, 1.0)\nval nearBlack = colorHex(\"#0a0a0a\")\n\nfun css(c: Vec4) = \"rgb(${(c.x * 255).roundToInt()},${(c.y * 255).roundToInt()},${(c.z * 255).roundToInt()})\"\n\nfun panel(background: Vec4): String {\n    val rows =\n        seeds.joinToString(\"\") { seed ->\n            val scale = contrastScale(seed, background)\n            val cells =\n                scale.colors.indices.joinToString(\"\") { i ->\n                    val step = contrastScaleSteps[i]\n                    val ring =\n                        if (step == scale.seedStep) \"outline:2px solid ${css(scale.textOn[i])};outline-offset:-4px;\"\n                        else \"\"\n                    \"<div style='width:52px;height:52px;background:${css(scale.colors[i])};color:${css(scale.textOn[i])};$ring\" +\n                        \"font:600 11px system-ui;padding:5px;box-sizing:border-box'>$step<br>${scale.swatches[i].achieved.f1}</div>\"\n                }\n            \"<div style='display:flex;gap:3px;margin:5px 0'>$cells</div>\"\n        }\n    return \"<div style='background:${css(background)};padding:12px'>$rows</div>\"\n}\n\ndisplay(\"contrast-scale\", \"<div style='display:flex;gap:12px'>${panel(white)}${panel(nearBlack)}</div>\")\n"}}} {"id" "contrast_picker" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "pick a seed, see its scale" "_tombstone" false "frame" #afield/rect [80.0 220.0 380.0 100.0] "code" #afield/file-inline {"path" "contrast_picker_code_.kt" "inline" "var seed = colorHex(\"#3b82f6\")\nvar dark = false\n\nfun css(c: Vec4) = \"rgb(${(c.x * 255).roundToInt()},${(c.y * 255).roundToInt()},${(c.z * 255).roundToInt()})\"\n\nfun redraw() {\n    val background = if (dark) colorHex(\"#0a0a0a\") else vec(1.0, 1.0, 1.0, 1.0)\n    val scale = contrastScale(seed, background)\n    val cells =\n        scale.colors.indices.joinToString(\"\") { i ->\n            val step = contrastScaleSteps[i]\n            val ring =\n                if (step == scale.seedStep) \"outline:2px solid ${css(scale.textOn[i])};outline-offset:-4px;\" else \"\"\n            \"<div style='width:60px;height:60px;background:${css(scale.colors[i])};color:${css(scale.textOn[i])};$ring\" +\n                \"font:600 11px system-ui;padding:6px;box-sizing:border-box'>$step<br>${scale.swatches[i].achieved.f2}</div>\"\n        }\n    display(\"scale\", \"<div style='background:${css(background)};padding:12px;display:flex;gap:3px'>$cells</div>\")\n}\n\ncolorPicker(\"seed\", Vector4f(seed.x, seed.y, seed.z, 1f)) { c ->\n    seed = vec(c.x, c.y, c.z, 1.0)\n    redraw()\n}\ncheckbox(\"dark background\", dark) { on ->\n    dark = on\n    redraw()\n}\nredraw()\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}