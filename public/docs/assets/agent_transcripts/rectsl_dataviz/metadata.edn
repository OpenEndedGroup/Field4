{"version" 2 "boxes" [{"id" "dataviz_figure" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "dataviz_renderer"} "name" "rectsl dataviz" "_tombstone" false "frame" #afield/rect [300.0 140.0 300.0 100.0] "code" #afield/file-inline {"path" "dataviz_figure_code_.kt" "inline" "/*\nRectSL data-visualization demo.\n\nThe #rectsl program draws a viridis colour-bar legend (array + colormap)\nand a bar chart bound to a data list (data / normalize / bars), animated in\nwith a staggered eased `->alpha`. Edit `rectsl` and re-run to change it live.\nSee rectsl_cheatsheet.md (\"Data visualization\") / rectsl_examples.md.\n*/\nimport afield.lang.rectsl.RECT_ANIMATION_VERTEX_SHADER\nimport afield.lang.rectsl.RectAnimationOracle\nimport afield.lang.rectsl.rectMaterialShaderCode\nimport afield.lang.rectsl.worldToClip\nimport afield.lang.rectsl.writeFrameToMesh\n\nval rectsl =\n    \"\"\"\n#rectsl\n->wall 20 10 meters\n->duration 6\n->fps 30\n\n# colour legend across the top: 40 swatches sweeping viridis\n\"leg\" rect  0.5 0.8 ->wh\n  40 '( fc 9.6 *  4.3 ->offset  \"viridis\" f colormap solid ->fill ) array\n;\n\n# bar chart from data, viridis by value, staggered grow-in\n'( 4 7 2 9 5 8 3 6 1 6 5 9 4 7 3 8 ) data  normalize  \"viridis\" bars\n  '( '( 0=0 0.7=1 ) ease-out ->alpha ) each\n  0.05 ->stagger-time\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader = rectMaterialShaderCode(program)\n\n/*\nRefresh the generated fragment on every run before `moduleHere {}`; the\n`//%-` fragment break makes this fragment execute first (see the playground\ntranscript for the why).\n*/\nonce.vertex { RECT_ANIMATION_VERTEX_SHADER }\nfragment = shader.exampleFragmentShader!!\n\n//%-\n\nval module = moduleHere {\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl-dataviz\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = program.wall.worldToClip()\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nval duration = program.duration.toDouble()\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"}}} {"id" "dataviz_renderer" "properties" {"children" #{#afield/box "dataviz_figure"} "parents" #{#afield/box "root"} "name" "window + renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "dataviz_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\n\nonce.renderer {\n    window = Window(\"RectSL — data visualization\")\n    Renderer(window)\n}\n\nprintln(\"dataviz renderer ready\")\nstart(renderer::run)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}