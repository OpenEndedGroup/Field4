{"version" 2 "boxes" [{"id" "syphon_receive" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Syphon — receive a server's frames" "_tombstone" false "frame" #afield/rect [80.0 960.0 340.0 100.0] "code" #afield/file-inline {"path" "syphon_receive_code_.kt" "inline" "import afield.syphon.*\n\n// without the library this stops here and says how to build it\ncheck(Syphon.isAvailable) { Syphon.describe() }\n\n// a server's name, app name or uuid; \"\" takes the first one announced\nval inp = syphonClient(\"Field pattern\")\n\nloop {\n    inp.png()?.let { display(\"main\", it) }\n    delay(250)\n}\n"}}} {"id" "syphon_publish" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Syphon — publish an animated picture" "_tombstone" false "frame" #afield/rect [80.0 520.0 340.0 100.0] "code" #afield/file-inline {"path" "syphon_publish_code_.kt" "inline" "import afield.syphon.*\nimport java.awt.BasicStroke\nimport java.awt.Color\nimport java.awt.RenderingHints\nimport java.awt.image.BufferedImage\n\n// without the library this stops here and says how to build it\ncheck(Syphon.isAvailable) { Syphon.describe() }\n\n// other applications list this as \"java — Field pattern\" (or Field's app name)\nval out = syphonServer(\"Field pattern\")\nval img = BufferedImage(640, 360, BufferedImage.TYPE_INT_ARGB)\nvar t = 0.0\n\nloop {\n    t += 1.0 / 60\n    val g = img.createGraphics()\n    g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON)\n    g.color = Color(20, 24, 40)\n    g.fillRect(0, 0, 640, 360)\n    g.stroke = BasicStroke(6f)\n    for (i in 0 until 12) {\n        val a = t + i * Math.PI / 6\n        g.color = Color.getHSBColor((i / 12.0 + t * 0.05).toFloat() % 1f, 0.7f, 1f)\n        val x = 320 + (cos(a) * 140).toInt()\n        val y = 180 + (sin(a * 2) * 110).toInt()\n        g.drawOval(x - 30, y - 30, 60, 60)\n    }\n    g.color = Color.WHITE\n    g.drawString(\"Field over Syphon  frame ${out.framesPublished}\", 16, 340)\n    g.dispose()\n    out.publish(img)\n}\n"}}} {"id" "syphon_servers" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Syphon — servers on this machine" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 100.0] "code" #afield/file-inline {"path" "syphon_servers_code_.kt" "inline" "import afield.syphon.*\n\nrun {\nif (!Syphon.isAvailable) {\n    markdown(Syphon.describe())\n    return@run\n}\n\nval servers = Syphon.servers(waitMs = 1000)\nmarkdown(if (servers.isEmpty()) \"No Syphon servers are running.\"\n         else servers.joinToString(\"\\n\") { \"- **${it.appName}** ${it.name}\" })\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_session" "fileManagerAccessHistory"]}