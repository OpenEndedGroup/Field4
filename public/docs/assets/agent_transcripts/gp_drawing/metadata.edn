{"version" 2 "boxes" [{"id" "gp_field2d" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - A field over the plane" "_tombstone" false "frame" #afield/rect [3400.0 40.0 340.0 100.0] "code" #afield/file-inline {"path" "gp_field2d_code_.kt" "inline" "// A scalar field pinned at four points: the mean, two whole-field draws on one colour scale,\n// and the standard deviation, dark at the observations. Change the values or the seeds and run again.\nval points = listOf(vec(-0.8, -0.5), vec(0.55, -0.5), vec(-0.3, 0.65), vec(0.65, 0.55))\nval field = gp2D(points, doubleArrayOf(0.9, -0.7, -0.8, 0.65),\n    kernel = GpKernels.matern(1.5, doubleArrayOf(0.55, 0.8)), noiseStd = 0.04)\nval side = 40\nval queries = Array(side * side) { i ->\n    doubleArrayOf(-1.2 + 2.4 * (i % side) / (side - 1),\n                  -1.2 + 2.4 * (i / side) / (side - 1))\n}\nval joint = field.posterior(queries)\nfun grid(values: DoubleArray) = Array(side) { row -> DoubleArray(side) { col -> values[row * side + col] } }\n\n// panels side by side, separated by a thin gap\nfun row(vararg panels: Array<DoubleArray>, gap: Double) = Array(side) { r ->\n    panels.flatMapIndexed { i, p -> (if (i > 0) List(2) { gap } else emptyList()) + p[r].toList() }.toDoubleArray()\n}\n\n// the mean and two whole-field draws share one colour scale; then the standard deviation\nshowHeatmap(row(grid(joint.mean), grid(joint.sample(seed = 57)), grid(joint.sample(seed = 58)), gap = 0.0),\n    vmin = -2.5, vmax = 2.5, normalize = false, colormap = \"coolwarm\", width = 720, channel = \"mean, two draws\")\nshowHeatmap(grid(joint.variance.map { sqrt(it) }.toDoubleArray()),\n    vmin = 0.0, normalize = false, colormap = \"magma\", width = 240, channel = \"standard deviation\")\n"}}} {"id" "gp_loop" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - A closed loop through six pins" "_tombstone" false "frame" #afield/rect [60.0 40.0 340.0 100.0] "code" #afield/file-inline {"path" "gp_loop_code_.kt" "inline" "// Six pins around a loop. Drag any pin's control below and the loop redraws: the orange mean\n// and six blue draws, all closed, all passing near every pin. Edit `start` to keep a shape.\nval start = listOf(vec(1.0, 0.0), vec(0.45, 0.8), vec(-0.5, 0.95),\n                   vec(-1.1, 0.0), vec(-0.4, -0.75), vec(0.6, -0.9))\nval pins = start.map { vec(it.x, it.y, 0) }.toMutableList()\nvar lengthScale = 0.6\n\nfun plot(line: FLine) = line.transform { vec(it.x * 200, -it.y * 200, 0) }\n\nfun redraw() {\n    // each pin's place on a parameter that runs once round the loop, 0 up to 1\n    val at = DoubleArray(pins.size) { it.toDouble() / pins.size }\n    // period 1: t = 0 and t = 1 are the same point, so every draw closes without a seam\n    val loop = gpCurve(at, pins,\n        kernel = GpKernels.periodic(period = 1.0, lengthScale = lengthScale, variance = 0.04),\n        noiseStd = DoubleArray(pins.size) { 0.01 }, dimensions = 2)\n    val distribution = loop.posterior(DoubleArray(201) { it / 200.0 })\n    val draws = (0L..5L).map { seed ->\n        plot(distribution.sampleLine(seed)).apply { color = vec(0.3, 0.65, 0.9, 0.8); thickness = 1.5 }\n    }\n    val mean = plot(distribution.meanLine()).apply { color = vec(1, 0.5, 0.2, 1); thickness = 3.0 }\n    val dots = plot(FLine().apply { pins.forEach { moveTo(it.x, it.y) } }).apply {\n        stroked = false; pointed = true; pointSize = 3.0; color = vec(1, 1, 1, 1)\n    }\n    // a fixed frame, so the picture does not rescale as pins move\n    val frame = plot(FLine().moveTo(-1.6, -1.4).lineTo(1.6, -1.4).lineTo(1.6, 1.4).lineTo(-1.6, 1.4).close())\n        .apply { color = vec(0.3, 0.3, 0.3, 1); thickness = 1.0 }\n    lines(listOf(frame) + draws + mean + dots, w = 520.0, h = 460.0, fitToSize = true)\n}\n\n// one panel of controls; running the box puts them back at `start`\ncontrolGroup(\"pins\", columns = 3) {\n    pins.indices.forEach { i ->\n        vec2Control(\"pin ${i + 1}\", Vector2f(pins[i].x, pins[i].y), xRange = -1.5 to 1.5, yRange = -1.3 to 1.3) { v ->\n            pins[i] = vec(v.x, v.y, 0); redraw()\n        }.set(Vector2f(pins[i].x, pins[i].y))\n    }\n    slider(\"length scale\", min = 0.1, max = 1.5, initialValue = lengthScale) { lengthScale = it; redraw() }\n        .set(lengthScale)\n}\nredraw()\n"}}} {"id" "gp_conditioning" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Four measurements, two sliders" "_tombstone" false "frame" #afield/rect [2200.0 40.0 340.0 100.0] "code" #afield/file-inline {"path" "gp_conditioning_code_.kt" "inline" "// Four measurements and a smoothness assumption: five draws (blue), the mean (orange) and the\n// 95% pointwise interval (thin orange). Move the sliders: a longer length scale makes stiffer\n// functions; a noisier third measurement lets the draws pass further from it.\nval xs = doubleArrayOf(-1.2, -0.35, 0.1, 0.95)\nval ys = doubleArrayOf(-0.7, 0.8, 0.35, -0.4)\nvar lengthScale = 0.48\nvar thirdNoise = 0.22\n\nfun plot(line: FLine) = line.transform { vec(it.x * 180, -it.y * 120, 0) }\n\nfun redraw() {\n    val gp = gp1D(xs, ys,\n        noiseStd = doubleArrayOf(0.06, 0.06, thirdNoise, 0.06),\n        kernel = GpKernels.rbf(lengthScale = lengthScale))\n    val grid = DoubleArray(181) { -1.8 + 3.6 * it / 180 }\n    val posterior = gp.posterior(grid)\n    val draws = (0L..4L).map { seed ->\n        plot(posterior.sampleFLine(grid, seed)).apply { color = vec(0.3, 0.65, 0.9, 0.7); thickness = 1.5 }\n    }\n    val (lower, upper) = posterior.intervalFLines(grid)\n    val band = listOf(lower, upper).map { plot(it).apply { color = vec(1, 0.5, 0.2, 0.5); thickness = 1.0 } }\n    val mean = plot(posterior.meanFLine(grid)).apply { color = vec(1, 0.5, 0.2, 1); thickness = 3.0 }\n    val pins = plot(FLine().apply { xs.indices.forEach { moveTo(xs[it], ys[it]) } }).apply {\n        stroked = false; pointed = true; pointSize = 3.0; color = vec(1, 1, 1, 1)\n    }\n    val frame = plot(FLine().moveTo(-1.8, -2.5).lineTo(1.8, -2.5).lineTo(1.8, 2.5).lineTo(-1.8, 2.5).close())\n        .apply { color = vec(0.3, 0.3, 0.3, 1); thickness = 1.0 }\n    lines(listOf(frame) + draws + band + mean + pins, w = 700.0, h = 420.0, fitToSize = true)\n}\n\n// running the box puts the sliders back at the values above\ncontrolGroup(\"controls\") {\n    slider(\"length scale\", min = 0.1, max = 1.5, initialValue = lengthScale) { lengthScale = it; redraw() }\n        .set(lengthScale)\n    slider(\"noise of the third measurement\", min = 0.01, max = 0.8, initialValue = thirdNoise) { thirdNoise = it; redraw() }\n        .set(thirdNoise)\n}\nredraw()\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}