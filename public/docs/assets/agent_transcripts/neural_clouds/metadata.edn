{"version" 2 "boxes" [{"id" "cloud_compare" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "cloud_train"} "name" "compare against the path tracer" "_tombstone" false "frame" #afield/rect [380.0 200.0 320.0 100.0] "code" #afield/file-inline {"path" "cloud_compare_code_.kt" "inline" "import afield.graphics.volume.*\nimport java.io.File\nimport java.util.Base64\n\nval view = CloudScene.Camera(doubleArrayOf(4.6, 0.35, 3.6), doubleArrayOf(0.0, 1.05, 0.0), 40.0)\nval w = 200\nval h = 125\nval none = CloudScene.InScatter { _, _, _, _, into -> into.fill(0.0) }\n\nval reference = cloudScene.render(view, w, h, cloudScene.reference(48))\nval single = cloudScene.render(view, w, h, none)\nval ambient = cloudScene.render(view, w, h, cloudAmbient)\nval neural = cloudScene.render(view, w, h, cloudNet.inScatter)\n\n// Pixels the cloud touches: where an absurd in-scatter changes the picture.\nval mask = cloudScene.render(view, w, h, CloudScene.InScatter { _, _, _, _, into -> into.fill(1e3) })\n\nval file = File.createTempFile(\"neural_clouds\", \".png\")\nwriteCloudComparison(file, reference, [single, ambient, neural])\nval png = Base64.getEncoder().encodeToString(file.readBytes())\nval rows =\n    [\"single scatter\" to single, \"fitted ambient\" to ambient, \"network\" to neural].joinToString(\"\") { (name, image) ->\n        val e = cloudError(image, reference, mask)\n        \"<tr><td>$name</td><td>${e.relativeMeanAbs.f3}</td><td>${e.rmse.f3}</td></tr>\"\n    }\ndisplay(\n    \"compare\",\n    \"<img style='width:100%' src='data:image/png;base64,$png'>\" +\n        \"<div>reference | single scatter | fitted ambient | network; below, |error| x4</div>\" +\n        \"<table><tr><th></th><th>relative MAE</th><th>RMSE</th></tr>$rows</table>\",\n)\n"}}} {"id" "cloud_renderer" "properties" {"children" #{#afield/box "cloud_train"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "cloud_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nOptions.profiling = false\nonce.renderer {\n    window = Window(\"Neural clouds\")\n    Renderer(window)\n}\nprintln(\"renderer ready\")\nstart(renderer::run)\n"}}} {"id" "cloud_view" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "cloud_train"} "name" "neural cloud shader" "_tombstone" false "frame" #afield/rect [740.0 40.0 320.0 100.0] "code" #afield/file-inline {"path" "cloud_view_code_.kt" "inline" "// A fullscreen triangle; the fragment shader does all the work.\nval module = moduleHere {\n    depthTest = false\n    depthWrite = false\n    blend = false\n}\nmodule += \"fullscreen\" to fullscreenTriangle(module)\nrenderer += module\n"} "vertex" #afield/file-inline {"path" "cloud_view_vertex_.glsl" "inline" "#version 460\nlayout(location=0) out vec2 uv;\nvoid main() {\n    vec2 p = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);\n    uv = vec2(p.x, 1 - p.y);\n    gl_Position = vec4(p * 2 - 1, 0, 1);\n}"} "fragment" #afield/file-inline {"path" "cloud_view_fragment_.glsl" "inline" "#version 460\n// cloudNetwork / cloudAmbient (weights as constants) and the raymarcher, from cloud_train\n#include \"cloud/network\"\n#include \"cloud/scene\"\nlayout(location=0) in vec2 uv;\nlayout(location=0) out vec4 color;\n\nvoid main() {\n    // Top: fitted ambient | network | single scatter.\n    // Bottom: predicted in-scatter | sun transmittance | sky visibility.\n    vec2 grid = vec2(uv.x * 3.0, uv.y * 2.0);\n    vec2 st = fract(grid);\n    int panel = int(grid.y) * 3 + int(grid.x);\n    int modes[6] = int[](1, 2, 0, 3, 4, 5);\n    int mode = modes[min(panel, 5)];\n\n    // window aspect from the pixel footprint, then one panel's share of it\n    float aspect = fwidth(uv.y) / fwidth(uv.x) * 2.0 / 3.0;\n    vec2 ndc = vec2(st.x * 2.0 - 1.0, 1.0 - st.y * 2.0);\n    vec3 c = cloudRender(vec3(4.6, 0.35, 3.6), vec3(0.0, 1.05, 0.0), 40.0, ndc, aspect, mode);\n\n    if (mode < 3) c = 1.0 - exp(-c * 1.2); // the tone curve writeCloudComparison uses\n    if (min(st.x, st.y) < 0.004) c = vec3(0.0);\n    color = vec4(c, 1.0);\n}"}}} {"id" "cloud_train" "properties" {"children" #{#afield/box "cloud_compare" #afield/box "cloud_view"} "parents" #{#afield/box "root" #afield/box "cloud_renderer"} "name" "train the in-scatter network" "_tombstone" false "frame" #afield/rect [380.0 40.0 320.0 100.0] "code" #afield/file-inline {"path" "cloud_train_code_.kt" "inline" "import afield.graphics.volume.*\n\n// Published for the boxes below.\nprop<CloudScene>(cloudScene)\nprop<NeuralCloud>(cloudNet)\nprop<AmbientFit>(cloudAmbient)\n\ncloudScene = CloudScene()\n\n// Training points are drawn where these cameras see cloud. cloud_compare's view is not one of them.\nval cameras = [\n    CloudScene.Camera(doubleArrayOf(0.0, 1.2, 7.5), doubleArrayOf(0.0, 0.95, 0.0)),\n    CloudScene.Camera(doubleArrayOf(-5.5, 2.4, 4.5), doubleArrayOf(0.0, 0.9, 0.0)),\n    CloudScene.Camera(doubleArrayOf(4.0, 0.6, -6.0), doubleArrayOf(0.0, 1.0, 0.0)),\n]\n\n// Each label is the mean of 8 path-traced estimates: noisy, and the network averages the noise out.\nval samples = NeuralCloud.samples(cloudScene, cameras, count = 12000, pathsPerSample = 8)\ncloudNet = NeuralCloud.train(samples, hidden = intArrayOf(16, 16), steps = 8000)\ncloudAmbient = NeuralCloud.ambient(samples)\n\n// #include \"cloud/network\" and \"cloud/scene\" in this box's descendants now mean these.\ncloudHere(cloudNet, cloudAmbient, cloudScene)\n\nprintln(\"${samples.size} samples, ${cloudNet.weights}, loss ${cloudNet.trainingLoss.takeLast(200).average().f4}\")\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}