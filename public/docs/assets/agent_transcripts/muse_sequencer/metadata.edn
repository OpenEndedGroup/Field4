{"version" 2 "boxes" [{"id" "muse_lock" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "lock" "_tombstone" false "frame" #afield/rect [20.0 1500.0 300.0 100.0] "code" #afield/file-inline {"path" "muse_lock_code_.kt" "inline" "val muse = PatMuse(seed = 3)\nval free = muse.rightPattern()\nmuse.lock(8, atCycle = 4)\nshowPatRollOf(\n    \"free\" to free,\n    \"locked\" to muse.rightPattern(),\n    title = \"right hand: free, then the last 8 events before cycle 4, locked\",\n    cycles = 8,\n    pitched = true,\n)\n"}}} {"id" "muse_live" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "live" "_tombstone" false "frame" #afield/rect [760.0 2100.0 300.0 100.0] "code" #afield/file-inline {"path" "muse_live_code_.kt" "inline" "// On the audio engine: the left hand locked and plain, the right hand locked and improvising.\nval muse = PatMuse(seed = 3).lock(8, atCycle = 4)\nmuse.rightLoop!!.improvise = 0.4\nval piano = Piano()\npiano.play(muse.pattern(), cycles = 32, cps = 0.5, velocity = 1.0)\naudio(piano, gain = 1f)\n"}}} {"id" "muse_edit" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "edit" "_tombstone" false "frame" #afield/rect [20.0 2100.0 300.0 100.0] "code" #afield/file-inline {"path" "muse_edit_code_.kt" "inline" "// A locked loop corrected by hand: the third event becomes a triad on the octave, the last a rest.\nval loop = PatMuseChannel(seed = 3).lock(8, atCycle = 4)\nval before = loop.pattern()\nloop.set(2, degrees = [7, 9, 11], velocity = 0.8)\nloop.set(7, degrees = [])\nshowPatRollOf(\n    \"as locked\" to before,\n    \"edited\" to loop.pattern(),\n    title = \"editing a locked loop\",\n    cycles = 4,\n    pitched = true,\n)\nprintln(loop)\n"}}} {"id" "muse_ornaments" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "ornaments" "_tombstone" false "frame" #afield/rect [760.0 1500.0 300.0 100.0] "code" #afield/file-inline {"path" "muse_ornaments_code_.kt" "inline" "val muse = PatMuse(seed = 3).lock(8, atCycle = 4)\nval loop = muse.rightLoop!!\nval plain = loop.pattern()\nloop.improvise = 0.4\nshowPatRollOf(\n    \"locked\" to plain,\n    \"improvise 0.4\" to loop.pattern(),\n    title = \"the same loop, plain and improvising\",\n    cycles = 8,\n    pitched = true,\n)\n"}}} {"id" "muse_sliders" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "muse" "_tombstone" false "frame" #afield/rect [20.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "muse_sliders_code_.kt" "inline" "// Two hands drawn from weights. Move a slider and the roll redraws; re-run the box to hear the\n// current settings through the piano (every slider keeps its value across runs).\nval muse = PatMuse(seed = 3)\nvar seed = 3.0\nvar lockLength = 0.0\nvar lockAt = 4.0\nvar start = 0.0\nvar end = 64.0\nvar direction = 0.0\nvar improvise = 0.0\n\nfun hands(): PatMuse {\n    muse.left.seed = seed.toLong()\n    muse.right.seed = seed.toLong()\n    muse.release()\n    if (lockLength >= 1) {\n        muse.lock(lockLength.toInt(), atCycle = lockAt)\n        for (loop in [muse.leftLoop!!, muse.rightLoop!!]) {\n            loop.start = start.toInt()\n            loop.end = end.toInt()\n            loop.direction = PatLoopDirection.entries[direction.toInt()]\n            loop.improvise = improvise\n            loop.seed = seed.toLong()\n        }\n    }\n    return muse\n}\n\nfun redraw() {\n    val m = hands()\n    val state = if (lockLength >= 1) \"locked: ${m.rightLoop}\" else \"free\"\n    showPatRollOf(\n        \"left\" to m.leftPattern(),\n        \"right\" to m.rightPattern(),\n        title = \"PatMuse(seed = ${seed.toInt()})\",\n        subtitle = state,\n        cycles = 8,\n        pitched = true,\n        channel = \"roll\",\n    )\n}\n\ncontrolGroup(\"loop\", columns = 4) {\n    slider(\"seed\", 1.0, 64.0, 1.0, seed) {\n        seed = it\n        redraw()\n    }\n    slider(\"lock length (0 = free)\", 0.0, 64.0, 1.0, lockLength) {\n        lockLength = it\n        redraw()\n    }\n    slider(\"lock at cycle\", 1.0, 16.0, 1.0, lockAt) {\n        lockAt = it\n        redraw()\n    }\n    slider(\"improvise\", 0.0, 1.0, 0.05, improvise) {\n        improvise = it\n        redraw()\n    }\n    slider(\"start\", 0.0, 63.0, 1.0, start) {\n        start = it\n        redraw()\n    }\n    slider(\"end\", 1.0, 64.0, 1.0, end) {\n        end = it\n        redraw()\n    }\n    slider(\"direction\", 0.0, 2.0, 1.0, direction) {\n        direction = it\n        redraw()\n    }\n}\ncontrolGroup(\"right hand\", columns = 4) {\n    weights(\"degree\", muse.right.degree) { redraw() }\n    weights(\"chord\", muse.right.chord) { redraw() }\n    weights(\"length\", muse.right.rhythm) { redraw() }\n}\ncontrolGroup(\"left hand\", columns = 4) {\n    weights(\"degree\", muse.left.degree) { redraw() }\n    weights(\"chord\", muse.left.chord) { redraw() }\n    weights(\"length\", muse.left.rhythm) { redraw() }\n}\nredraw()\nval r = pianoRender(17.0, Piano(sampleRate = 44_100)) {\n    play(hands().pattern(), cycles = 8, cps = 0.5, velocity = 1.0, startFrame = 0)\n}\nshowPianoAudio(r, \"listen\")\n[\"loop\", \"roll\", \"listen\"].forEach { displayOpen(it) }\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "