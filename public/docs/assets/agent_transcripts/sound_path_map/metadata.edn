{"version" 2 "boxes" [{"id" "sound_map_paths" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 · The map" "_tombstone" false "frame" #afield/rect [60.0 60.0 520.0 150.0] "code" #afield/file-inline {"path" "sound_map_paths_code_.kt" "inline" "// The map, printed from the code rather than from a page: what makes samples, what carries\n// them out, what brings them in, and which of them meet the one `render` seam.\nSoundPathMap.Role.values().forEach { role ->\n    println(\"${role.label}:\")\n    SoundPathMap.PATHS.filter { it.role == role }\n        .forEach { p ->\n            println(\n                \"  %-20s %-19s %s  needs: %s\"\n                    .format(\n                        p.id,\n                        p.timing.label,\n                        if (p.onSeam) \"[on the seam]\" else \"[off the seam]\",\n                        p.needs,\n                    ),\n            )\n            println(\"      ${p.what}\")\n            println(\"      ${p.file} — ${p.entryPoint}${if (p.page == null) \"   (NO PAGE DOCUMENTS THIS)\" else \"\"}\")\n        }\n}\nprintln()\nprintln(\n    \"${SoundPathMap.PATHS.count { it.onSeam }} of ${SoundPathMap.PATHS.size} paths meet AudioPatchSpec.Renderer.render(outL, outR, numFrames, ctx)\",\n)\nprintln(\"no published page mentions: ${SoundPathMap.PATHS.filter { it.page == null }.map { it.id }}\")\n"}}} {"id" "sound_map_compare" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 · One buffer, three paths" "_tombstone" false "frame" #afield/rect [60.0 240.0 520.0 150.0] "code" #afield/file-inline {"path" "sound_map_compare_code_.kt" "inline" "/*\nOne buffer, three paths. The dry beat is a real kick, snare and closed hat from Tidal's\nDirt-Samples, mixed offline by patRenderStereoDirt. Then it is lowpassed at 900 Hz twice:\nby the Signal graph's own ChamberlinLowpass, and by a Faust program compiled at runtime.\nThree players, a brightness plot, and the seam claim as a number.\n\nThe samples are a pinned, checksummed download of a few Dirt-Samples folders. Run\n`./gradlew fetchDocsDirtSamples` once; without them this box stops and says so, rather\nthan playing a synth stand-in.\n\nThe first run pays 13-22s of Truffle warm-up for the Faust compile. The second does not.\n*/\nshowSoundPathComparison()\ndisplayOpen(\"path0\")\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}