{"version" 2 "boxes" [{"id" "eagle_flow_live" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Two frames of reference" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 120.0] "code" #afield/file-inline {"path" "eagle_flow_live_code_.kt" "inline" "import afield.geometry.topology.vectorfield.*\n\n// The eagle's flow (one grid of 4-pixel cells per frame) and the film it was tracked from.\nval flow = loadParticleFlow(\"public/docs/assets/vector_field_topology/eagle.flow.gz\")\nval film = videoFrames(\"public/docs/assets/vector_field_topology/eagle.mp4\", width = 480).toList()\nval cameras = CameraMotion.entries\nvar frame = 270; var camera = CameraMotion.KEEP; var minSpeed = 0.0\n\n// Streamlines, separatrices and critical points of one frame's flow, over the darkened film.\nfun show() {\n    val topology = VectorFieldTopology.compute(flow.at(frame, window = 1, camera = camera), minStrength = 0.02, maxLength = 300.0)\n    val lines = topology.streamlines(spacing = 1.5, length = 14.0, minSpeed = minSpeed) + topology.toFLines() + topology.criticalPointsFLine(6.0)\n    val picture = film[frame]\n    val dark = Img(picture.width, picture.height, 3, FloatArray(picture.width * picture.height * 3))\n    showImgGrid(\"frame $frame, camera ${camera.name.lowercase()}\" to\n        picture.overlay(dark, 0.55).drawFLines(lines.map { it * flow.cell.toDouble() }, scale = 2.0), columns = 1, cellSide = 960)\n}\n// camera: 0 keeps the camera's motion, 1 removes its median shift, 2 its fitted affine motion.\n// min speed: draw streamlines only where the flow is faster than this, in pixels per frame.\ncontrolGroup(\"eagle\") {\n    slider(\"frame\", min = 0.0, max = flow.frameCount - 1.0, step = 1.0, initialValue = 270.0) { frame = it.toInt(); show() }\n    slider(\"camera\", min = 0.0, max = 2.0, step = 1.0, initialValue = 0.0) { camera = cameras[it.toInt()]; show() }\n    slider(\"min speed\", min = 0.0, max = 3.0, step = 0.1, initialValue = 0.0) { minSpeed = it; show() }\n}\nshow()\n"}}} {"id" "eagle_flow_movie" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - The whole clip as a movie" "_tombstone" false "frame" #afield/rect [560.0 60.0 420.0 120.0] "code" #afield/file-inline {"path" "eagle_flow_movie_code_.kt" "inline" "import afield.geometry.topology.vectorfield.*\nimport afield.tools.docs.FFMPEG\nimport java.io.File\n\n// Launch this one: every frame drawn in the raw look, encoded at the film's 18 frames per second.\nval flow = loadParticleFlow(\"public/docs/assets/vector_field_topology/eagle.flow.gz\")\nval out = File(\"build/eagle_flow/eagle_flow_raw.mp4\")\n\nsuspend fun render() {\n    val pngs = File(out.parentFile, \"frames\").apply { deleteRecursively(); mkdirs() }\n    for ((frame, picture) in videoFrames(\"public/docs/assets/vector_field_topology/eagle.mp4\", width = 480).withIndex()) {\n        if (frame >= flow.frameCount) break\n        val topology = VectorFieldTopology.compute(flow.at(frame, window = 1, camera = CameraMotion.KEEP), minStrength = 0.02, maxLength = 300.0)\n        val lines = topology.streamlines(spacing = 1.5, length = 14.0) + topology.toFLines() + topology.criticalPointsFLine(6.0)\n        val dark = Img(picture.width, picture.height, 3, FloatArray(picture.width * picture.height * 3))\n        picture.overlay(dark, 0.55).drawFLines(lines.map { it * flow.cell.toDouble() }, scale = 2.0).savePng(File(pngs, \"%03d.png\".format(frame)).path)\n        if (frame % 30 == 0) println(\"frame $frame of ${flow.frameCount}\")\n    }\n    val encode = ProcessBuilder(FFMPEG, \"-v\", \"error\", \"-y\", \"-framerate\", \"18\", \"-i\", File(pngs, \"%03d.png\").path,\n        \"-c:v\", \"libx264\", \"-preset\", \"slow\", \"-crf\", \"28\", \"-pix_fmt\", \"yuv420p\", out.path).inheritIO().start()\n    check(encode.waitFor() == 0) { \"ffmpeg failed\" }\n    println(\"wrote ${out.absolutePath}\")\n}\nstart(::render)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}