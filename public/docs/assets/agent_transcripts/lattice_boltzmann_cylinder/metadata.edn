{"version" 2 "boxes" [{"id" "lbm_renderer" "properties" {"children" #{#afield/box "lbm_fluid"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "lbm_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nOptions.profiling = false\n// once: re-running this box keeps the existing window and renderer\nonce.renderer {\n    window =\n        Window(\"Lattice Boltzmann - a cylinder in a wind tunnel\", initialDimensions = Rect(80.0, 80.0, 1000.0, 600.0))\n    Renderer(window)\n}\nprintln(\"renderer ready\")\n// the frame loop runs as this box's coroutine; stopping the box stops rendering\nstart(renderer::run)\n"}}} {"id" "lbm_fluid" "properties" {"children" #{#afield/box "lbm_cylinder"} "parents" #{#afield/box "root" #afield/box "lbm_renderer"} "name" "fluid" "_tombstone" false "frame" #afield/rect [340.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "lbm_fluid_code_.kt" "inline" "/*\nA lattice Boltzmann fluid in a wind tunnel: a wind blows left to right and the\nlattice wraps, so what leaves on the right comes back on the left.\nOn its own it is uniform wind and shows nothing; the box beneath this one puts\nsomething in its way.\n*/\nprop<ShaderLatticeBoltzmannSystem>(lbm) = ShaderLatticeBoltzmannSystem() {\n    width = 800\n    height = 480\n    baseVelocity = Vector2f(0.08f, 0f)\n    // a thin fluid (viscosity about 0.014) so the wake sheds vortices\n    relaxation = 1.85f\n    // nothing pulls the fluid back toward the wind, so the wake travels;\n    // the inlet that 10b draws at the left edge keeps the wind blowing\n    driveBlend = 0f\n    stepsPerFrame = 8\n    dyeDecayPerFrame = 0.001f\n    // vorticity: orange turns one way, blue the other. Try COMPOSITE, DYE or SPEED\n    previewMode = FluidVisualizationMode.CURL\n}\n\n// this installs the editable collision-and-streaming rule in this box's fragment tab\nlbm.installInto()\n"}}} {"id" "lbm_cylinder" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "lbm_fluid"} "name" "cylinder" "_tombstone" false "frame" #afield/rect [340.0 160.0 300.0 100.0] "code" #afield/file-inline {"path" "lbm_cylinder_code_.kt" "inline" "/*\nDraws into the fluid's control texture: a solid disc, walls top and bottom, and\nstripes of dye released at the left edge. The controls persist from frame to\nframe, so clear them first or a re-run leaves the old drawing behind.\n*/\nlbm.clearControls()\n\nvar module = moduleHere(lbm.controlsParameters(\"cylinder\"))\nlbm.addControls(\"cylinder\", module)\n\nval quad = fullscreenTriangle(module)\nmodule += \"quad\" to quad\n\nquad.center = { vec(160f, 236f) }\nquad.radius = { 24f }\nquad.height = { 480f }\n"} "vertex" #afield/file-inline {"path" "lbm_cylinder_vertex_.glsl" "inline" "#version 450\n\n// one triangle that covers the whole target; positions come from the vertex index\nvec2 fullscreenVertex(uint index) {\n    if (index == 0u) return vec2(-1.0, -1.0);\n    if (index == 1u) return vec2(3.0, -1.0);\n    return vec2(-1.0, 3.0);\n}\n\nvoid main() {\n    gl_Position = vec4(fullscreenVertex(uint(gl_VertexIndex)), 0.0, 1.0);\n}\n"} "fragment" #afield/file-inline {"path" "lbm_cylinder_fragment_.glsl" "inline" "#version 450\n\nlayout(push_constant) uniform Push {\n    vec2 center;\n    float radius;\n    float height;\n} push;\n\nlayout(location = 0) out vec4 outColor;\n\n// red: solid; green and blue: a push; alpha: a dye source.\n// The blend is additive and the controls carry over, so this is a drawing, not a frame.\nvoid main() {\n    vec2 p = gl_FragCoord.xy;\n    outColor = vec4(0.0);\n\n    if (distance(p, push.center) < push.radius) outColor.r = 1.0;\n    if (p.y < 3.0 || p.y > push.height - 3.0) outColor.r = 1.0;\n\n    if (p.x < 4.0 && mod(floor(p.y / 12.0), 2.0) == 0.0) outColor.a = 1.0;\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}