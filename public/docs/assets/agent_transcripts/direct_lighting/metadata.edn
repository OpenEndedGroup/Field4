{"version" 2 "boxes" [{"id" "direct_light_lab" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "agent_graphics_context"} "name" "direct lighting" "_tombstone" false "frame" #afield/rect [400.0 160.0 340.0 90.0] "code" #afield/file-inline {"path" "direct_light_lab_code_.kt" "inline" "import afield.graphics.render.lighting.*\nimport afield.graphics.scene.fabricated.rtxdiSettings\n\nprop<DirectLightingDemo>(lab)\n// Re-executing this box replaces the experiment at a frame boundary.\nfromContextWithNameOrNull<DirectLightingDemo>(\"lab\")?.close()\nlab = DirectLightingDemo(renderer, 1280, 720)\nvar cameraControl by keyCamera(renderer, lab.bundle.scene.camera)\n\nval restir = lab.bundle.rtxdiSettings()\nval sdkReady =\n    lab.visibility.available &&\n        runCatching {\n            lab.lighting.enableRtxdi(RtxdiProgram.load(), restir).getOrThrow()\n        }\n            .onFailure { println(\"Optional RTXDI unavailable: ${it.message}\") }\n            .isSuccess\nvar useRtxdi = sdkReady\nvar reference = false\nvar temporal = true\nvar neighbors = 8\nvar lightCount = 16\nvar reset = false\nvar source = false\nvar shadows = lab.visibility.available\nvar animate = true\nvar budget = 16\nvar reconstruct = true\nvar weight = 1f\nvar power = 60f\nvar phase = 0.0\nvar diagnostic = 0\ncontrolGroup(\"lighting\") {\n    checkbox(\"Original renderer\", initialValue = source) { source = it }\n    checkbox(\"Ray-query shadows\", initialValue = shadows) { shadows = it }\n    if (sdkReady) {\n        checkbox(\"RTXDI\", initialValue = useRtxdi) { useRtxdi = it }\n        checkbox(\"Reference estimator\", initialValue = reference) { reference = it }\n        checkbox(\"Reconstruct lighting\", initialValue = reconstruct) { reconstruct = it }\n        checkbox(\"Temporal reuse\", initialValue = temporal) { temporal = it }\n        slider(\"Spatial neighbors\", min = 0.0, max = 16.0, step = 1.0, initialValue = neighbors.toDouble()) {\n            neighbors = it.toInt()\n        }\n        slider(\"Area lights\", min = 1.0, max = 128.0, step = 1.0, initialValue = lightCount.toDouble()) {\n            lightCount = it.toInt()\n        }\n        button(\"Reset history\") { if (it) reset = true }\n    }\n    checkbox(\"Animate light\", initialValue = animate) { animate = it }\n    slider(\"Samples\", min = 1.0, max = 128.0, step = 1.0, initialValue = budget.toDouble()) { budget = it.toInt() }\n    slider(\"Effect weight\", initialValue = weight.toDouble()) { weight = it.toFloat() }\n    slider(\"Radiance\", min = 0.0, max = 150.0, initialValue = power.toDouble()) { power = it.toFloat() }\n    slider(\"Light phase\", min = 0.0, max = 6.283, initialValue = phase) { phase = it }\n    slider(\n        \"View (0: lit, 9: raw)\",\n        min = 0.0,\n        max = if (sdkReady) 9.0 else 4.0,\n        step = 1.0,\n        initialValue = diagnostic.toDouble(),\n    ) {\n        diagnostic = it.toInt()\n    }\n}\ndisplayOpen(\"lighting\")\nprintln(\"Direct lighting ready: use the lighting controls and arrow-key camera.\")\n// Controls publish values; Vulkan changes happen here, between frames.\nframes {\n    var seconds = 0.0\n    while (true) {\n        restir.denoisePasses = if (reconstruct) 3 else 0\n        restir.temporal = temporal\n        restir.spatialSamples = neighbors\n        restir.shadows = shadows\n        if (reset) {\n            restir.resetHistory()\n            reset = false\n        }\n        if (sdkReady)\n            restir.commitLights(\n                List(lightCount) { i ->\n                    val a = i * 2.0 * PI / lightCount + seconds + phase\n                    IdentifiedAreaLight(\n                        100 + i,\n                        AreaEmitter(\n                            Vector3f(\n                                (cos(a) * 3.0 + sin(seconds + phase) * 1.5).toFloat(),\n                                4.5f,\n                                (sin(a) * 2.0).toFloat(),\n                            ),\n                            Vector3f(0.6f, 0f, 0f),\n                            Vector3f(0f, 0f, 0.6f),\n                            Vector3f(power * 3f / lightCount),\n                        ),\n                    )\n                },\n            )\n        lab.lighting.mode =\n            if (source) DirectLighting.Mode.SOURCE\n            else if (useRtxdi && sdkReady) {\n                if (reference) DirectLighting.Mode.RTXDI_REFERENCE else DirectLighting.Mode.RTXDI\n            } else if (shadows && lab.visibility.available) DirectLighting.Mode.RAY_QUERY\n            else DirectLighting.Mode.UNSHADOWED\n        lab.lighting.view = DirectLighting.View.entries[diagnostic]\n        lab.lighting.samples = budget\n        lab.lighting.effectWeight = weight\n        lab.lighting.emitter.radiance.set(power)\n        lab.animate(seconds + phase)\n        if (animate) seconds += 1.0 / 60.0\n        frame()\n    }\n}\n"}}} {"id" "agent_graphics_context" "properties" {"children" #{#afield/box "direct_light_lab"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "agent_graphics_context_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableVR = false\nOptions.enableHDR = false\nOptions.profiling = false\n\nonce.renderer {\n    window = Window(\"Field\")\n    Renderer(window)\n}\n\nprintln(\"agent graphics renderer ready\")\nstart(renderer::run)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}