{"version" 2 "boxes" [{"id" "recstl_playground" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "recstl_renderer"} "name" "recstl" "_tombstone" false "frame" #afield/rect [300.0 140.0 300.0 100.0] "code" #afield/file-inline {"path" "recstl_playground_code_.kt" "inline" "// RectSL playground.\n//\n// Edit the `rectsl` program below and re-run this box to change it live.\n// The transport controls in this box's output area drive the clock:\n//   play  — advance time every frame and loop the animation\n//   loop  — wrap at the end (off = run once and hold on the last frame)\n//   speed — playback rate multiplier\n//   time  — scrub to a frame (while paused); moving it freezes the clock there\n//\n// See the \"RectSL examples\" docs page / rectsl_cheatsheet.md for the language.\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\n->wall 16 9 meters\n->duration 6\n->fps 30\n\nmaterial spectrum '(\n  uv 3.0 * time 0.5 * + fbm palette\n)\n\n\"bar\" rect\n  0 0 ->xy\n  0.9 1 ->wh\n  '( 0 0.6  0.75 6.5  1.5 0.6 ) 1.5 loop-time ->h\n  0xffffff solid ->fill\n  spectrum ->material\n;\n\n16 '(\n  \"bar\" ->select clone\n    i 7.5 - 1.2 * 0 ->xy\n    i 0.14 * ->delay-all-time\n) repeat\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\n// Seed this box's shader-source properties before `moduleHere {}` runs.\n// moduleHere builds its module from the box's `vertex`/`fragment` properties\n// (not from assignments in the lambda); `once.vertex`/`once.fragment` set them\n// once. Fragments separated by `//%-` run one at a time, each expanded only after the\n// previous one ran, so this fragment executes first and the moduleHere fragment then\n// prepares its shaders from what was set here.\nonce.vertex { RECT_ANIMATION_VERTEX_SHADER }\nonce.fragment { shader.exampleFragmentShader!! }\n\n//%-\n\nval module = moduleHere {\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\n// --- transport state, driven by the controls below ---\nval duration = program.duration.toDouble()\nvar playing = true\nvar looping = true\nvar speed = 1.0\nvar t = 0.0\n\ncontrolGroup(\"transport\") {\n    checkbox(\"play\", initialValue = playing) { playing = it }\n    checkbox(\"loop\", initialValue = looping) { looping = it }\n    slider(\"speed\", min = 0.0, max = 3.0, step = 0.05, initialValue = speed) { speed = it }\n    slider(\"time\", min = 0.0, max = duration, step = 0.01, initialValue = 0.0) {\n        // Scrubbing the timeline while paused sets the clock; while playing it is ignored.\n        if (!playing) t = it\n    }\n}\n\nloop {\n    if (playing) {\n        t += (1.0 / 60.0) * speed\n        if (t > duration) t = if (looping) t - duration else duration\n    }\n    val sampleTime = if (looping) t % duration else t.coerceIn(0.0, duration)\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(sampleTime, m)\n    true\n}\n"}}} {"id" "recstl_renderer" "properties" {"children" #{#afield/box "recstl_playground"} "parents" #{#afield/box "root"} "name" "window + renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "recstl_renderer_code_.kt" "inline" "import afield.four.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\n\nonce.renderer {\n    window = Window(\"RectSL playground\")\n    Renderer(window)\n}\n\nprintln(\"recstl renderer ready\")\nstart(renderer::run)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}