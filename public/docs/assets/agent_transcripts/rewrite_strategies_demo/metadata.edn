{"version" 2 "boxes" [{"id" "rw_baseline" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Baseline (global fixpoint)" "_tombstone" false "frame" #afield/rect [60.0 60.0 300.0 140.0] "code" #afield/file-inline {"path" "rw_baseline_code_.kt" "inline" "fun p(v: Int) = v\nfun A(v: Int) = v * 10\nrule(\"p2a\") { x: Expr -> from { p(x) }; to { A(x) } }\nval r = p(1) + p(2)\nprintln(\"baseline (global fixpoint): r = $r  -> both p() rewritten to A(1)+A(2)\")\ncheck(r == 30) { \"baseline expected 30, got $r\" }\n"}}} {"id" "rw_bottomup" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "bottomup (inner)" "_tombstone" false "frame" #afield/rect [400.0 260.0 300.0 150.0] "code" #afield/file-inline {"path" "rw_bottomup_code_.kt" "inline" "fun f(v: Int) = v * 2\nfun g(v: Int) = v + 100\nrule(\"fg\") { x: Expr -> from { f(x) }; to { g(x) } }\nstrategy { bottomup(\"fg\") }\nval r = f(f(1))\nprintln(\"bottomup: r = $r  -> inner f rewritten: f(g(1)) = f(101) = 202\")\ncheck(r == 202) { \"bottomup expected 202, got $r\" }\n"}}} {"id" "rw_topdown" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "topdown (outer)" "_tombstone" false "frame" #afield/rect [60.0 260.0 300.0 150.0] "code" #afield/file-inline {"path" "rw_topdown_code_.kt" "inline" "fun f(v: Int) = v * 2\nfun g(v: Int) = v + 100\nrule(\"fg\") { x: Expr -> from { f(x) }; to { g(x) } }\nstrategy { topdown(\"fg\") }\nval r = f(f(1))\nprintln(\"topdown: r = $r  -> outer f rewritten: g(f(1)) = g(2) = 102\")\ncheck(r == 102) { \"topdown expected 102, got $r\" }\n"}}} {"id" "rw_repeat" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "repeat (bounded)" "_tombstone" false "frame" #afield/rect [400.0 470.0 320.0 160.0] "code" #afield/file-inline {"path" "rw_repeat_code_.kt" "inline" "fun f(v: Int) = v * 2\nfun g(v: Int) = v + 100\nrule(\"fg\") { x: Expr -> from { f(x) }; to { g(x) } }\nstrategy { repeat(topdown(\"fg\"), 2) }\nval r = f(f(f(1)))\nprintln(\"repeat(topdown, 2): r = $r  -> two outer steps, inner f(1) left: g(g(f(1))) = 202\")\ncheck(r == 202) { \"repeat bounded expected 202, got $r\" }\n"}}} {"id" "rw_seq" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "then (sequence)" "_tombstone" false "frame" #afield/rect [740.0 260.0 300.0 160.0] "code" #afield/file-inline {"path" "rw_seq_code_.kt" "inline" "fun p(v: Int) = v\nfun q(v: Int) = v\nfun r0(v: Int) = v * 1000\nrule(\"p2q\") { x: Expr -> from { p(x) }; to { q(x) } }\nrule(\"q2r\") { x: Expr -> from { q(x) }; to { r0(x) } }\nstrategy { \"p2q\" then \"q2r\" }\nval out = p(5)\nprintln(\"then: out = $out  -> p -> q -> r0(5) = 5000\")\ncheck(out == 5000) { \"then expected 5000, got $out\" }\n"}}} {"id" "rw_choice" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "choice (first applicable)" "_tombstone" false "frame" #afield/rect [60.0 470.0 300.0 160.0] "code" #afield/file-inline {"path" "rw_choice_code_.kt" "inline" "fun pick(v: Int) = v\nfun X(v: Int) = v + 1\nfun Y(v: Int) = v + 2\nrule(\"toX\") { x: Expr -> from { pick(x) }; to { X(x) } }\nrule(\"toY\") { x: Expr -> from { pick(x) }; to { Y(x) } }\nstrategy { choice(\"toY\", \"toX\") }\nval r = pick(10)\nprintln(\"choice: r = $r  -> prefers toY though toX is declared first: Y(10) = 12\")\ncheck(r == 12) { \"choice expected 12, got $r\" }\n"}}} {"id" "rw_subset" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "subset (name one rule)" "_tombstone" false "frame" #afield/rect [740.0 60.0 300.0 160.0] "code" #afield/file-inline {"path" "rw_subset_code_.kt" "inline" "fun p(v: Int) = v\nfun q(v: Int) = v\nfun A(v: Int) = v * 10\nfun B(v: Int) = v * 100\nrule(\"p2a\") { x: Expr -> from { p(x) }; to { A(x) } }\nrule(\"q2b\") { x: Expr -> from { q(x) }; to { B(x) } }\nstrategy { \"p2a\" }\nval r = p(1) + q(2)\nprintln(\"subset: r = $r  -> only p2a fires: A(1) + q(2); q2b left alone\")\ncheck(r == 12) { \"subset expected 12, got $r\" }\n"}}} {"id" "rw_once" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "once (single site)" "_tombstone" false "frame" #afield/rect [400.0 60.0 300.0 140.0] "code" #afield/file-inline {"path" "rw_once_code_.kt" "inline" "fun p(v: Int) = v\nfun A(v: Int) = v * 10\nrule(\"p2a\") { x: Expr -> from { p(x) }; to { A(x) } }\nstrategy { once(\"p2a\") }\nval r = p(1) + p(2)\nprintln(\"once: r = $r  -> only the first p() rewritten: A(1) + p(2)\")\ncheck(r == 12) { \"once expected 12, got $r\" }\n"}}} {"id" "rw_nested" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "nested pattern (two levels deep)" "_tombstone" false "frame" #afield/rect [740.0 470.0 340.0 170.0] "code" #afield/file-inline {"path" "rw_nested_code_.kt" "inline" "fun f(v: Int) = v * 2\nfun g(v: Int) = v + 100\nrule(\"fg\") { x: Expr -> from { f(f(x)) }; to { g(x) } }\nstrategy { repeat(topdown(\"fg\"), 2) }\nval r = f(f(f(f(1))))\nprintln(\"nested pattern: r = $r  -> each step eats TWO f's: g(g(1)) = g(101) = 201\")\ncheck(r == 201) { \"nested pattern expected 201, got $r\" }\nr\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory"]}