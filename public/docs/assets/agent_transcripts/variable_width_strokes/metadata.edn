{"version" 2 "boxes" [{"id" "swept-o" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Pill, trapezoid pill, swept spline" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "swept-o_code_.kt" "inline" "// A quick hand-written \"o\": fourteen pen samples, pressure rising and falling.\nval w = 20.0\nval knots =\n    (0..13).map { i ->\n        val a = 2.2 + 2 * PI * i / 12.5\n        val p = 0.3 + 0.7 * sin(PI * i / 13)\n        val r = w * p.pow(1.75)\n        vec(90 + 70 * cos(a) * (1 + 0.04 * i), 100 + 80 * sin(a), r)\n    }\n\nfun ink(f: FLine, dx: Double) = (f + vec(dx, 0.0)).apply {\n    filled = true\n    stroked = false\n    color = vec(0.95, 0.95, 0.9, 1.0)\n}\n\n// pill: each span at its mean radius\nval pills = knots.zipWithNext { a, b ->\n    val m = (a.z + b.z) / 2\n    sweptCircleStroke([vec(a.x, a.y, m), vec(b.x, b.y, m)]).shell\n}\n// trapezoid pill: each span straight, radius linear from end to end\nval trapezoids = knots.zipWithNext { a, b -> sweptCircleStroke([a, b]).shell }\n// swept spline: cubic Béziers in (x, y, r) through every sample\nval spline = sweptCircleStroke(knots).shell\n\nval samples = knots.map { k ->\n    fline {\n        moveTo(k.x, k.y)\n        lineTo(k.x + 0.01, k.y)\n    }\n        .apply {\n            pointed = true\n            pointSize = 1.5\n            color = vec(1.0, 0.4, 0.3, 1.0)\n        }\n}\n\nlines(\n    pills.map { ink(it, 0.0) } +\n        trapezoids.map { ink(it, 220.0) } +\n        ink(spline, 440.0) +\n        samples +\n        samples.map { it + vec(220.0, 0.0) } +\n        samples.map { it + vec(440.0, 0.0) },\n    w = 900.0,\n    h = 300.0,\n    fitToSize = true,\n)\n"}}} {"id" "swept-cubic" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Envelope of one cubic" "_tombstone" false "frame" #afield/rect [1200.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "swept-cubic_code_.kt" "inline" "// One cubic whose radius swells from 2 to about 17 and back to 2: the envelope against the plain ribbon.\nval centre = fline {\n    moveTo(0, 0)\n    cubicTo(40, 45, 80, -30, 120, 20)\n}\nval radius = parameterFromLambda { t, _ -> 2f + 26f * t * t * (1f - t) * 4f }\n\nval swept = centre.bySweptCircleEnveloping(radius, samples = 200, flatness = 0.02)\nval ribbon = centre.byVariableRibboning(parameterFromLambda { t, p -> 2f * radius.evaluate(t, p) }, samples = 200)\n// reference: the union of 1500 discs along the line\nval reference = centre.byJtsVariableBuffering(\n    numSamples = 1500,\n    distance = { t -> radius.evaluate(t.toFloat(), vec(0f, 0f, 0f)).toDouble() },\n)\n\nprintln(\"swept envelope: %.3f from the union of discs\".format(swept.shell.outlineDistanceTo(reference)))\nprintln(\"byVariableRibboning: %.3f\".format(ribbon.outlineDistanceTo(reference)))\n\nval circles =\n    (0..16).map { i ->\n        val s = centre.sampleSeries(17)[i]\n        val r = radius.evaluate(s.t, s.point).toDouble()\n        fline { circle(s.point.x.toDouble(), s.point.y.toDouble(), r) }\n            .apply {\n                thickness = 0.8\n                color = vec(1.0, 1.0, 1.0, 0.35)\n            }\n    }\nlines(\n    circles +\n        listOf(\n            centre.copy().apply { color = vec(1.0, 1.0, 1.0, 0.5) },\n            ribbon.copy().apply {\n                color = vec(1.0, 0.45, 0.3, 1.0)\n                thickness = 1.5\n            },\n            swept.left.copy().apply {\n                color = vec(0.4, 0.9, 1.0, 1.0)\n                thickness = 2.0\n            },\n            swept.right.copy().apply {\n                color = vec(0.4, 0.9, 1.0, 1.0)\n                thickness = 2.0\n            },\n        ),\n    w = 900.0,\n    h = 380.0,\n    fitToSize = true,\n)\n"}}} {"id" "swept-notation" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - A pressure stroke from the drawing layer" "_tombstone" false "frame" #afield/rect [3480.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "swept-notation_code_.kt" "inline" "// Write a pressure stroke onto the drawing layer, then read it back as pen samples.\nnotation {\n    stroke(\n        (0..40).map { i -> vec(-300.0 + 9.0 * i, 420.0 + 40.0 * sin(i / 5.0)) },\n        name = \"ink\",\n        pressure = { 0.15 + 0.85 * sin(PI * it).pow(0.7) },\n    )\n}\nval mark = notation.named(\"ink\")!!\nval knots = mark.points.zip(mark.pressures) { p, pressure -> vec(p.x, p.y, 12.0 * pressure.pow(1.75)) }\nval outline = sweptCircleStroke(knots)\nprintln(\"${knots.size} pen samples, ${sweptCircleDegenerateSpans(knots).size} spans without an envelope\")\nlines(\n    outline.shell.copy().apply {\n        filled = true\n        stroked = false\n        color = vec(0.95, 0.95, 0.9, 1.0)\n    },\n    w = 900.0,\n    h = 260.0,\n    fitToSize = true,\n)\n"}}} {"id" "swept-degenerate" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - Where there is no envelope" "_tombstone" false "frame" #afield/rect [2340.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "swept-degenerate_code_.kt" "inline" "// The pen nearly stops and presses: around the middle sample the radius changes faster than\n// the centre moves, and the circle swallows itself.\nval knots = listOf(\n    vec(0.0, 0.0, 4.0),\n    vec(60.0, 20.0, 7.0),\n    vec(66.0, 22.0, 30.0),\n    vec(72.0, 20.0, 8.0),\n    vec(150.0, 0.0, 4.0),\n)\nval spans = sweptCircleDegenerateSpans(knots)\nprintln(\"no envelope on \" + spans.joinToString { \"%.4f..%.4f\".format(it.start, it.endInclusive) })\n\nval outline = sweptCircleStroke(knots)\nval beziers = sweptCircleBeziers(knots)\nval path = fline {\n    moveTo(beziers[0][0].x, beziers[0][0].y)\n    for (b in beziers) cubicTo(b[1].x, b[1].y, b[2].x, b[2].y, b[3].x, b[3].y)\n}\nlines(\n    outline.shell.copy().apply {\n        filled = true\n        stroked = false\n        color = vec(0.95, 0.95, 0.9, 0.35)\n    },\n    outline.left.copy().apply {\n        color = vec(0.4, 0.9, 1.0, 1.0)\n        thickness = 2.0\n    },\n    outline.right.copy().apply {\n        color = vec(0.4, 0.9, 1.0, 1.0)\n        thickness = 2.0\n    },\n    path.copy().apply { color = vec(1.0, 1.0, 1.0, 0.6) },\n    w = 900.0,\n    h = 320.0,\n    fitToSize = true,\n)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}