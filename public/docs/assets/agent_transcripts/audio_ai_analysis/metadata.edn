{"version" 2 "boxes" [{"id" "analysis_guide" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 · analysis guide and jobs" "_tombstone" false "frame" #afield/rect [40.0 40.0 440.0 100.0] "code" #afield/file-inline {"path" "analysis_guide_code_.kt" "inline" "markdown(\n    \"guide\",\n    \"\"\"\n    ## Beat and pitch analysis\n\n    **librosa** supplies the onset envelope, multi-scale tempograms, beat grid and monophonic pYIN track. **Basic Pitch** supplies polyphonic note events, activations, pitch bends and MIDI. Essentia is not loaded by this worker.\n\n    Run box 2 for real cached beat and pitch previews of Nancy from 18–42 seconds. Run box 3 for the complete live path: filename lookup → source window → three submitted jobs → WebSocket progress → durable results → synchronized analysis board. The source player and every analysis lane share hover, zoom and playback time; click any plot to seek the recording. Re-running unchanged requests is a cache hit.\"\"\".trimIndent(),\n    width = 1040,\n)\ndisplay(\"all durable jobs\", fieldAudioJobMonitor(heightPixels = 430))\n"}}} {"id" "analysis_visualizer_gallery" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 · real cached beat and pitch results" "_tombstone" false "frame" #afield/rect [520.0 40.0 440.0 100.0] "code" #afield/file-inline {"path" "analysis_visualizer_gallery_code_.kt" "inline" "import java.io.File\n\nval folder = File(\"public/docs/assets/audio_ai_analysis\")\nval previews =\n    [\"beats\", \"pitch_mono\", \"pitch_poly\"].map { label ->\n        FieldAudioClient.json.decodeFromString<AnalysisPreview>(\n            File(folder, \"$label-preview.json\").readText(),\n        )\n    }\nmarkdown(\"source\", \"Nancy · 18–42 s · saved librosa and Basic Pitch results\")\ndisplay(\n    \"analysis board\",\n    analysisPreviewDashboardHtml(\n        previews,\n        width = 1040,\n        panelHeight = 250,\n        syncGroup = \"nancy-cached-analysis\",\n    ),\n)\n"}}} {"id" "analyse_nancy" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 · submit, monitor, await, visualize Nancy" "_tombstone" false "frame" #afield/rect [40.0 190.0 440.0 100.0] "code" #afield/file-inline {"path" "analyse_nancy_code_.kt" "inline" "import java.util.concurrent.CancellationException\nimport java.util.concurrent.CompletableFuture\n\nval client = cached { FieldAudioClient() }\nval start = 18.0\nval duration = 24.0\nval timeSync = \"nancy-analysis\"\ndisplay(\"all jobs\", fieldAudioJobMonitor(heightPixels = 330))\n\nrunAsync(\n    onResult = { results: List<AnalysisResult> ->\n        displayClear(\"all jobs\")\n        for (label in [\"beats\", \"monophonic pitch\", \"polyphonic pitch\"]) displayClear(\"$label job\")\n        displayOpen(\"source\")\n        display(\n            \"analysis\",\n            analysisDashboardHtml(\n                results,\n                width = 1040,\n                panelHeight = 250,\n                syncGroup = timeSync,\n                timeOffsetSeconds = start,\n            ),\n        )\n        displayOpen(\"analysis\")\n    },\n    onError = { failure ->\n        markdown(\"analysis error\", \"Analysis failed: ${(failure.message ?: failure.toString()).md}\")\n    },\n) {\n    val showSource = progress<String> { display(\"source\", it) }\n    // HTTP continuations run elsewhere; every analysis still belongs to this box run.\n    val run = RunScope.current()\n    val lookup = client.assetByFilename(\"*Nancy*\")\n    onCancel { lookup.cancel(true) }\n    lookup.thenCompose { source ->\n        if (future.isDone) throw CancellationException(\"run ended\")\n\n        val region = AssetRegion(source.id, start, duration)\n        val canonical =\n            source.representations.firstOrNull { it.role == \"canonical_project\" }\n                ?: source.representations.first { it.mediaType in [\"audio/wav\", \"audio/x-wav\"] }\n        showSource(\n            canonical.audioVisualizerHtml(\n                label = \"Nancy · 18–42 s\",\n                options = AudioVisualizerOptions(\n                    width = 1040,\n                    waveformHeight = 110,\n                    initialStartSeconds = start,\n                    initialDurationSeconds = duration,\n                    initialPositionSeconds = start,\n                    syncGroup = timeSync,\n                ),\n            ),\n        )\n\n        val requests = [\n            \"beats\" to multiScaleBeatAnalysis(region, requestedBy = \"field:analysis-example\"),\n            \"monophonic pitch\" to monophonicPitchAnalysis(region, requestedBy = \"field:analysis-example\"),\n            \"polyphonic pitch\" to polyphonicPitchAnalysis(region, requestedBy = \"field:analysis-example\"),\n        ]\n        val analyses = requests.map { (label, request) ->\n            RunScope.withCurrent(run) {\n                    client.trackAnalysis(\n                        request,\n                        onAccepted = { display(\"$label job\", fieldAudioJobStatusHtml(it)) },\n                        onProgress = { job, event -> display(\"$label job\", fieldAudioJobStatusHtml(job, event)) },\n                        onCompleted = { display(\"$label job\", fieldAudioJobStatusHtml(it)) },\n                        onError = {}, // The outer operation reports failure once.\n                    )\n                }\n                .also { pending -> onCancel { pending.cancel(true) } }\n        }\n        CompletableFuture.allOf(*analyses.toTypedArray()).thenApply { analyses.map { it.join() } }\n    }\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}