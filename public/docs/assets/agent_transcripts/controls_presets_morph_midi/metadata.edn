{"version" 2 "boxes" [{"id" "controls_presets_demo" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Presets · morph · record · run me" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 60.0] "code" #afield/file-inline {"path" "controls_presets_demo_code_.kt" "inline" "// Each control is a local delegated to `keys`, so a preset is a key of that scope.\nval keys = KeyframeScope()\nvar size by keys.slider(0.4, 0.1..1.0)\nvar offset by keys.vec2(Vector2f(0f, 0f))\nvar tint by keys.color(Vector4f(0.2f, 0.6f, 1f, 1f))\nvar ring by keys.checkbox(false)\n\nfun draw() {\n    val r = (20 + size * 60).toInt()\n    val cx = 110 + (offset.x * 60).toInt()\n    val cy = 90 - (offset.y * 50).toInt()\n    val fill = \"rgba(${(tint.x * 255).toInt()},${(tint.y * 255).toInt()},${(tint.z * 255).toInt()},${tint.w})\"\n    val stroke = if (ring) \"stroke='white' stroke-width='6'\" else \"\"\n    display(\"main\", \"<svg width='220' height='180' style='background:#222'><circle cx='$cx' cy='$cy' r='$r' fill='$fill' $stroke/></svg>\")\n}\n\nkeys.onChange { draw() }\n\nval dir = presetDirectory(\"look\")\n\n// Two keys to start from, written once; after that the stored ones are used.\nif (keys.savedKeyNames(dir).isEmpty()) {\n    keys.Key(\"size\" to 0.25, \"offset\" to Vector2f(-0.5f, 0.3f), \"tint\" to Vector4f(0.2f, 0.6f, 1f, 1f), \"ring\" to 0f)\n        .save(dir.resolve(\"calm\"), \"seeded by the demo\")\n    keys.Key(\"size\" to 0.95, \"offset\" to Vector2f(0.6f, -0.4f), \"tint\" to Vector4f(1f, 0.25f, 0.1f, 1f), \"ring\" to 1f)\n        .save(dir.resolve(\"storm\"), \"seeded by the demo\")\n}\n\nvar presets: PresetBar? = null\ncontrolGroup(\"look\") {\n    keys.controls()\n    presets = presetBar(keys)\n    recordToggle(\"size\")\n    midiLearnButton()\n}\n\ndraw()\nprintln(\"presets: ${presets!!.names} in $dir\")\n"}}} {"id" "controls_midi_demo" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "MIDI learn · run me" "_tombstone" false "frame" #afield/rect [80.0 200.0 300.0 60.0] "code" #afield/file-inline {"path" "controls_midi_demo_code_.kt" "inline" "var cutoff = 1000.0\nvar bright = false\ncontrolGroup(\"synth\") {\n    slider(\"cutoff\", 20.0, 20000.0, initialValue = cutoff, law = ControlLaw.LOGARITHMIC) { cutoff = it }\n    checkbox(\"bright\", bright) { bright = it }\n    midiLearnButton()\n}\nval midi = midiLearn(\"synth\")\nmidi.bind(\"cutoff\", cc = 74)\nmidi.bind(\"bright\", cc = 64)\n// What a knob sends; with hardware, midi.attach(MidiDevices.openInput(MidiDevices.inputs().first())).\nfor (v in [0, 32, 64, 96, 127]) {\n    midi.feed(0, 74, v)\n    println(\"CC74 = $v  ->  cutoff ${\"%.1f\".format(cutoff)}\")\n}\nmidi.feed(0, 64, 127)\nmidi.feed(0, 74, 80)\nprintln(\"bright = $bright, bindings = ${midi.bindings}\")\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}