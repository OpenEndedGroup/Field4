{"version" 2 "boxes" [{"id" "moving_lights" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "8 — moving lights (launch it)" "_tombstone" false "frame" #afield/rect [1440.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "moving_lights_code_.kt" "inline" "val still = [Light(60.0, 60.0), Light(180.0, 70.0), Light(120.0, 180.0), Light(200.0, 200.0)]\nval moving = still.mapIndexed { k, l -> l.copy(vx = 0.1 * cos(k * 1.7), vy = 0.1 * sin(k * 1.7)) }\nval p = VehicleParams(neuron = NeuronParams(bias = -1.0))\n\nval trained = VehicleWorld.random(80, still, seed = 5L)\ntrained.stepTimes(p.copy(plasticity = PlasticityParams(learningRate = 3.0)), 15000)\nval learned = trained.withLights(moving, seed = 11L)\nval lovers = VehicleWorld.random(80, still, wiring = VehicleWorld.LOVER, seed = 5L).withLights(moving, seed = 11L)\nval canvasA = VehicleCanvas(learned, scale = 1.2, fade = 0.98f)\nval canvasB = VehicleCanvas(lovers, scale = 1.2, fade = 0.98f)\n\nanimateEvolution(\n    Unit,\n    totalSteps = 3000,\n    seconds = 12.0,\n    framesTarget = 240,\n    columns = 2,\n    cellSide = 300,\n    step = {\n        learned.step(p)\n        lovers.step(p)\n        canvasA.record()\n        canvasB.record()\n    },\n    panels = { _, n ->\n        [\n            \"learned \" + n + \": \" + learned.meanLight().f2 to canvasA.image(),\n            \"lovers \" + n + \": \" + lovers.meanLight().f2 to canvasB.image(),\n        ]\n    },\n)\n"}}} {"id" "orbits" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5 — BUMP vehicles circle at a set distance" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "orbits_code_.kt" "inline" "val lights = [Light(60.0, 60.0), Light(180.0, 70.0), Light(120.0, 180.0), Light(200.0, 200.0)]\nval panels = mutableListOf<Pair<String, Img>>()\nval groups = mutableListOf<Pair<String, List<Double>>>()\nfor (d in [8.0, 12.0, 16.0, 20.0]) {\n    val p = VehicleParams(\n        neuron = NeuronParams(activation = Activation.BUMP, gain = 4.0, tauMembrane = 1.0, bias = orbitBias(d)),\n    )\n    val world = VehicleWorld.random(60, lights, wiring = VehicleWorld.AGGRESSOR, seed = 3L)\n    val canvas = VehicleCanvas(world, scale = 1.2, fade = 0.99f)\n    world.stepTimes(p, 6000)\n    val radii = OrbitRadii()\n    repeat(2000) {\n        world.step(p)\n        radii.observe(world)\n        canvas.record()\n    }\n    println(\n        \"tuned ${d.f2}: median ${radii.median().f2}, middle half ${radii.quantile(0.25).f2} to ${radii.quantile(0.75).f2}\",\n    )\n    panels += (\"tuned \" + d.f2 + \": median \" + radii.median().f2) to canvas.image()\n    groups += (\"tuned \" + d.f2) to radii.distances(every = 40)\n}\nshowImg(montage(panels, columns = 2, cellSide = 300))\ndisplay(\n    \"radii\",\n    violin(*groups.toTypedArray(), references = [8.0, 12.0, 16.0, 20.0], yRange = 0.0..60.0, yTitle = \"distance to nearest lamp\"),\n)\n"}}} {"id" "combined" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "7 — learning and homeostasis together" "_tombstone" false "frame" #afield/rect [980.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "combined_code_.kt" "inline" "val lights = [Light(60.0, 60.0), Light(180.0, 70.0), Light(120.0, 180.0), Light(200.0, 200.0)]\nval base = VehicleParams(neuron = NeuronParams(bias = -1.0))\n\nfun arm(name: String, adaptation: Double, learning: Double): Pair<String, Img> {\n    val p = base.copy(\n        neuron = base.neuron.copy(adaptationRate = adaptation),\n        plasticity = PlasticityParams(learningRate = learning),\n    )\n    val world = VehicleWorld.random(80, lights, seed = 5L)\n    val canvas = VehicleCanvas(world, scale = 1.2, fade = 0.998f)\n    world.stepTimes(p, 15000)\n    val visits = LightVisits(world)\n    var light = 0.0\n    repeat(5000) {\n        world.step(p)\n        visits.observe(world)\n        canvas.record()\n        light += world.meanLight() / 5000\n    }\n    println(name + \": light \" + light.f3 + \", lights visited \" + visits.mean().f2)\n    return (name + \": \" + light.f2) to canvas.image()\n}\n\nshowImg(\n    montage(\n        [\n            arm(\"neither\", 0.0, 0.0),\n            arm(\"homeostasis\", 0.002, 0.0),\n            arm(\"learning\", 0.0, 3.0),\n            arm(\"both\", 0.002, 3.0),\n        ],\n        columns = 2,\n        cellSide = 300,\n    ),\n)\n"}}} {"id" "speed_cost" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "6 — a price on speed" "_tombstone" false "frame" #afield/rect [520.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "speed_cost_code_.kt" "inline" "val lights = [Light(60.0, 60.0), Light(180.0, 70.0), Light(120.0, 180.0), Light(200.0, 200.0)]\nval panels = mutableListOf<Pair<String, Img>>()\nfor (cost in [0.0, 0.2, 0.5, 1.0]) {\n    val p = VehicleParams(\n        neuron = NeuronParams(bias = -1.0),\n        plasticity = PlasticityParams(learningRate = 3.0, speedCost = cost),\n    )\n    val world = VehicleWorld.random(80, lights, seed = 5L)\n    val canvas = VehicleCanvas(world, scale = 1.2)\n    world.stepTimes(p, 15000)\n    var light = 0.0\n    var speed = 0.0\n    repeat(2000) {\n        world.step(p)\n        canvas.record()\n        light += world.meanLight() / 2000\n        speed += world.meanSpeed() / 2000\n    }\n    println(\n        \"speedCost ${cost.f2}: light ${light.f3}, speed ${speed.f3}, summed weight ${(world.w.sum() / world.count).f2}\",\n    )\n    panels += (\"cost \" + cost.f2 + \": \" + speed.f2) to canvas.image()\n}\nshowImg(montage(panels, columns = 4, cellSide = 240))\n"}}} {"id" "evolved_wiring" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "9 — searching for a wiring" "_tombstone" false "frame" #afield/rect [1900.0 60.0 420.0 100.0] "code" #afield/file-inline {"path" "evolved_wiring_code_.kt" "inline" "val lights = [Light(60.0, 60.0), Light(180.0, 70.0), Light(120.0, 180.0), Light(200.0, 200.0)]\nval ops = VehicleWiringGenome()\nval objective = vehicleForageObjective(lights)\n\nval control = PopulationSearch.random(ops, objective, 300, seed = 13L, label = \"random\")\nval evolved =\n    PopulationSearch.evolve(ops, objective, 300, seed = 13L, mu = 6, lambda = 12, crossoverRate = 0.3, label = \"evolve\")\nprintln(control.summary())\nprintln(evolved.summary())\nprintln(\"lover \" + objective.evaluate(VehicleWorld.LOVER).fitness.f3)\nval best = evolved.best!!.genome\nprintln(\"evolved wiring \" + best.joinToString { it.f2 })\n\nfun trails(name: String, wiring: DoubleArray): Pair<String, Img> {\n    val world = VehicleWorld.random(30, lights, wiring = wiring, seed = 1L)\n    val canvas = VehicleCanvas(world, scale = 1.2)\n    repeat(3000) {\n        world.step(VehicleParams(neuron = NeuronParams(bias = -1.0)))\n        canvas.record()\n    }\n    return (name + \": \" + world.meanLight().f2) to canvas.image()\n}\nshowImg(montage([trails(\"lover\", VehicleWorld.LOVER), trails(\"evolved\", best)], columns = 2, cellSide = 300))\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" 