{"version" 2 "boxes" [{"id" "shadertrinket_star_tunnel" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "shadertrinket_renderer"} "name" "Star Tunnel" "_tombstone" false "frame" #afield/rect [380.0 360.0 300.0 100.0] "code" #afield/file-inline {"path" "shadertrinket_star_tunnel_code_.kt" "inline" "// Star Tunnel: launch to show it in the window. mainImage is in this box's `fragment`.\nval canvas = shadertoyCanvas()\ncanvas += shadertoyHere {\n    +canvas.rtt\n}\n"} "fragment" #afield/file-inline {"path" "shadertrinket_star_tunnel_fragment_.glsl" "inline" "{{ shadertoy.image }}\n\nfloat hash(vec2 p) {\n  p = fract(p * vec2(234.34, 435.35));\n  p += dot(p, p + 34.23);\n  return fract(p.x * p.y);\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = (2.0 * fragCoord - iResolution.xy) / iResolution.y;\n  float t = iTime * 0.55;\n  float a = atan(uv.y, uv.x);\n  float r = length(uv);\n  vec3 col = vec3(0.002, 0.004, 0.009);\n\n  for (int i = 0; i < 48; i++) {\n    float fi = float(i);\n    float lane = floor(fi / 6.0);\n    float spoke = mod(fi, 6.0);\n    float z = fract(t + fi * 0.071);\n    float rr = mix(1.55, 0.05, z);\n    float aa = spoke * 1.047 + lane * 0.38 + t * 1.7 + sin(lane) * 0.5;\n    vec2 pos = vec2(cos(aa), sin(aa)) * rr;\n    float star = pow(max(0.0, 1.0 - length(uv - pos) / (0.015 + z * 0.035)), 8.0);\n    vec3 tint = 0.55 + 0.45 * cos(vec3(0.2, 1.8, 4.1) + fi * 0.7);\n    col += star * tint * (0.25 + z * 2.2);\n  }\n\n  float warp = sin(a * 9.0 - r * 7.0 + t * 8.0);\n  col += vec3(0.03, 0.08, 0.15) * smoothstep(0.95, 0.0, abs(warp)) * smoothstep(1.5, 0.2, r);\n  col *= 1.0 - smoothstep(1.15, 1.75, r);\n  fragColor = vec4(col, 1.0);\n}\n"}}} {"id" "shadertrinket_renderer" "properties" {"children" #{#afield/box "shadertrinket_lead" #afield/box "shadertrinket_classic_plasma" #afield/box "shadertrinket_star_tunnel" #afield/box "shadertrinket_mandelbrot_glow" #afield/box "shadertrinket_sdf_sphere_trace" #afield/box "shadertrinket_camera"} "parents" #{#afield/box "root"} "name" "ShaderTrinket window + renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "shadertrinket_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\nOptions.enableVR = false\n\nonce.renderer {\n    window = Window(\"ShaderTrinket\", initialDimensions = Rect(80.0, 80.0, 960.0, 540.0))\n    Renderer(window)\n}\n\nprintln(\"ShaderTrinket window ready\")\nstart(renderer::run)\n"}}} {"id" "shadertrinket_mandelbrot_glow" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "shadertrinket_renderer"} "name" "Mandelbrot Glow" "_tombstone" false "frame" #afield/rect [720.0 360.0 300.0 100.0] "code" #afield/file-inline {"path" "shadertrinket_mandelbrot_glow_code_.kt" "inline" "// Mandelbrot Glow: launch to show it in the window. mainImage is in this box's `fragment`.\nval canvas = shadertoyCanvas()\ncanvas += shadertoyHere {\n    +canvas.rtt\n}\n"} "fragment" #afield/file-inline {"path" "shadertrinket_mandelbrot_glow_fragment_.glsl" "inline" "{{ shadertoy.image }}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = (2.0 * fragCoord - iResolution.xy) / iResolution.y;\n  float zoom = 0.72 + 0.18 * sin(iTime * 0.18);\n  vec2 c = uv * zoom + vec2(-0.68, 0.0);\n  c += vec2(0.08 * sin(iTime * 0.21), 0.05 * cos(iTime * 0.17));\n  vec2 z = vec2(0.0);\n  float iter = 0.0;\n  float trap = 10.0;\n\n  for (int i = 0; i < 96; i++) {\n    z = vec2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + c;\n    trap = min(trap, abs(z.x * z.y));\n    if (dot(z, z) > 16.0) {\n      iter = float(i);\n      break;\n    }\n  }\n\n  float m = iter / 96.0;\n  vec3 col = 0.5 + 0.5 * cos(vec3(0.4, 2.2, 4.2) + m * 8.0 + iTime * 0.25);\n  col *= smoothstep(0.0, 0.04, m);\n  col += exp(-trap * 45.0) * vec3(0.25, 0.9, 1.15);\n  fragColor = vec4(col, 1.0);\n}\n"}}} {"id" "shadertrinket_sdf_sphere_trace" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "shadertrinket_renderer"} "name" "SDF Sphere Trace" "_tombstone" false "frame" #afield/rect [1060.0 360.0 300.0 100.0] "code" #afield/file-inline {"path" "shadertrinket_sdf_sphere_trace_code_.kt" "inline" "// SDF Sphere Trace: launch to show it in the window. mainImage is in this box's `fragment`.\nval canvas = shadertoyCanvas()\ncanvas += shadertoyHere {\n    +canvas.rtt\n}\n"} "fragment" #afield/file-inline {"path" "shadertrinket_sdf_sphere_trace_fragment_.glsl" "inline" "{{ shadertoy.image }}\n\nfloat sdSphere(vec3 p, float r) {\n  return length(p) - r;\n}\n\nfloat mapScene(vec3 p) {\n  float ca = cos(iTime * 0.7);\n  float sa = sin(iTime * 0.7);\n  p.xz = mat2(ca, -sa, sa, ca) * p.xz;\n  float s = sdSphere(p, 0.82);\n  float rings = abs(length(p.xz) - 0.98) - 0.025;\n  float band = abs(p.y + 0.08 * sin(atan(p.z, p.x) * 5.0 + iTime * 2.0)) - 0.035;\n  return min(s, max(rings, band));\n}\n\nvec3 calcNormal(vec3 p) {\n  vec2 e = vec2(0.001, 0.0);\n  return normalize(vec3(\n    mapScene(p + e.xyy) - mapScene(p - e.xyy),\n    mapScene(p + e.yxy) - mapScene(p - e.yxy),\n    mapScene(p + e.yyx) - mapScene(p - e.yyx)\n  ));\n}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = (2.0 * fragCoord - iResolution.xy) / iResolution.y;\n  vec3 ro = vec3(0.0, 0.0, 3.1);\n  vec3 rd = normalize(vec3(uv, -1.75));\n  vec3 col = vec3(0.005, 0.007, 0.01);\n  float t = 0.0;\n  float glow = 0.0;\n\n  for (int i = 0; i < 96; i++) {\n    vec3 p = ro + rd * t;\n    float d = mapScene(p);\n    glow += 0.018 / (0.03 + abs(d));\n    if (d < 0.001 || t > 8.0) break;\n    t += d * 0.78;\n  }\n\n  if (t < 8.0) {\n    vec3 p = ro + rd * t;\n    vec3 n = calcNormal(p);\n    vec3 l = normalize(vec3(-0.5, 0.7, 0.9));\n    float diff = max(0.0, dot(n, l));\n    float fres = pow(1.0 + dot(rd, n), 4.0);\n    col = vec3(0.08, 0.16, 0.20) + diff * vec3(0.34, 0.88, 0.76) + fres * vec3(0.9, 0.35, 1.0);\n  }\n\n  col += glow * vec3(0.03, 0.22, 0.45);\n  fragColor = vec4(col, 1.0);\n}\n"}}} {"id" "shadertrinket_classic_plasma" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "shadertrinket_renderer"} "name" "Classic Plasma" "_tombstone" false "frame" #afield/rect [40.0 360.0 300.0 100.0] "code" #afield/file-inline {"path" "shadertrinket_classic_plasma_code_.kt" "inline" "// Classic Plasma: launch to show it in the window. mainImage is in this box's `fragment`.\nval canvas = shadertoyCanvas()\ncanvas += shadertoyHere {\n    +canvas.rtt\n}\n"} "fragment" #afield/file-inline {"path" "shadertrinket_classic_plasma_fragment_.glsl" "inline" "{{ shadertoy.image }}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n  vec2 p = (2.0 * fragCoord - iResolution.xy) / iResolution.y;\n  float t = iTime * 0.75;\n\n  float v = sin(p.x * 7.0 + t);\n  v += sin((p.y + sin(t * 0.7)) * 8.0);\n  v += sin((p.x + p.y) * 5.0 + t * 1.7);\n  v += sin(length(p + vec2(sin(t), cos(t * 0.6))) * 11.0 - t * 2.0);\n\n  vec3 col = 0.5 + 0.5 * cos(vec3(0.0, 1.7, 3.4) + v + t);\n  col *= 0.65 + 0.35 * smoothstep(1.2, 0.0, length(p));\n  col += pow(max(0.0, 1.0 - length(uv - 0.5) * 1.35), 4.0) * vec3(0.35, 0.48, 0.65);\n  fragColor = vec4(col, 1.0);\n}\n"}}} {"id" "shadertrinket_lead" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "shadertrinket_renderer"} "name" "Flat Rings (start here)" "_tombstone" false "frame" #afield/rect [40.0 200.0 300.0 100.0] "code" #afield/file-inline {"path" "shadertrinket_lead_code_.kt" "inline" "// ShaderTrinket in Field. This box's `fragment` property is a ShaderToy Image pass: mainImage\n// gets fragCoord in pixels (y up) and the ShaderToy uniforms (iResolution, iTime, iMouse, iDate,\n// iChannel0..3). Edit it and press alt-R to recompile; a mistake is marked on its own line.\n//\n// Every shader box below draws into the same canvas, so launching one replaces the picture, the\n// way choosing a preset does. Launch this box again to come back to Flat Rings.\nval canvas = shadertoyCanvas()\ncanvas += shadertoyHere { +canvas.rtt }\n"} "fragment" #afield/file-inline {"path" "shadertrinket_lead_fragment_.glsl" "inline" "{{ shadertoy.image }}\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = (2.0 * fragCoord - iResolution.xy) / iResolution.y;\n  float t = iTime * 0.7;\n  vec3 col = vec3(0.015, 0.018, 0.018);\n\n  float grid = mod(floor((uv.x + 2.0) * 9.0) + floor((uv.y + 2.0) * 9.0), 2.0);\n  if (grid < 0.5) col = vec3(0.025, 0.03, 0.03);\n\n  for (int i = 0; i < 8; i++) {\n    float fi = float(i);\n    vec2 c = vec2(cos(t + fi * 1.35), sin(t * 0.8 + fi * 1.1)) * 0.42;\n    float r = 0.17 + 0.035 * step(0.5, mod(fi, 2.0));\n    float ring = 1.0 - step(0.018, abs(length(uv - c) - r));\n    float dotMask = 1.0 - step(0.035, length(uv - c));\n\n    if (ring > 0.5) {\n      if (mod(fi, 3.0) < 1.0) col = vec3(0.16, 0.72, 0.62);\n      else if (mod(fi, 3.0) < 2.0) col = vec3(0.95, 0.74, 0.25);\n      else col = vec3(0.35, 0.50, 0.95);\n    }\n    if (dotMask > 0.5) col = vec3(0.92, 0.96, 0.90);\n  }\n\n  fragColor = vec4(col, 1.0);\n}\n"}}} {"id" "shadertrinket_camera" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "shadertrinket_renderer"} "name" "Camera Input Demo" "_tombstone" false "frame" #afield/rect [40.0 520.0 300.0 100.0] "code" #afield/file-inline {"path" "shadertrinket_camera_code_.kt" "inline" "// Camera Input Demo: launch to show it in the window. mainImage is in this box's `fragment`.\nval canvas = shadertoyCanvas()\ncanvas += shadertoyHere {\n    +canvas.rtt\n    textures(\"iChannel0\" to webcam())\n}\n"} "fragment" #afield/file-inline {"path" "shadertrinket_camera_fragment_.glsl" "inline" "{{ shadertoy.image }}\n\n// Camera Input Demo: iChannel0 is the camera (ShaderTrinket's Camera button is the\n// textures(\"iChannel0\" to webcam()) line in this box's code). With no camera it samples black and\n// you get a quiet prompt-like field.\n\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n  vec2 uv = fragCoord / iResolution.xy;\n\n  // Mirror the camera so it behaves like a familiar preview.\n  vec2 cameraUv = vec2(1.0 - uv.x, uv.y);\n  vec3 camera = texture(iChannel0, cameraUv).rgb;\n  float luma = dot(camera, vec3(0.299, 0.587, 0.114));\n\n  vec2 p = (2.0 * fragCoord - iResolution.xy) / iResolution.y;\n  float rings = 0.5 + 0.5 * sin(length(p) * 28.0 - iTime * 4.0 + luma * 5.0);\n  float scan = smoothstep(0.92, 1.0, sin(uv.y * iResolution.y * 0.75 + iTime * 12.0));\n  vec3 tint = mix(vec3(0.02, 0.16, 0.18), vec3(0.94, 0.72, 0.22), rings);\n\n  // If the camera is off, iChannel0 samples black and you get a quiet prompt-like field.\n  vec3 color = mix(camera, tint, 0.34);\n  color += scan * vec3(0.16, 0.55, 0.52) * (0.25 + luma);\n  color *= 0.78 + 0.55 * luma;\n  fragColor = vec4(color, 1.0);\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}