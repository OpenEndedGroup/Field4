{"version" 2 "boxes" [{"id" "lp3_fan" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "a fan of central paths, turning" "_tombstone" false "frame" #afield/rect [80.0 640.0 420.0 120.0] "code" #afield/file-inline {"path" "lp3_fan_code_.kt" "inline" "val random = kotlin.random.Random(11)\nval cloud = List(70) {\n    vec(random.nextDouble(-1.6, 1.6), random.nextDouble(-1.0, 1.0), random.nextDouble(-1.0, 1.0))\n}\nval polytope = LpPolytope.hull(cloud)\nval directions = 120\nval fan = polytope.centralFan(directions = directions, samples = 80)\n\nthree(name = \"fan\", width = 700, height = 470) {\n    mesh(polytope.toMesh(), wireframe = false, opacity = 0.12, cullBackFaces = false)\n    lines(polytope.toFLine())\n    lines(fan.toFLines(alpha = 0.85, thickness = 1.2))\n    camera(yaw = 32.0, pitch = 24.0)\n    title(\"${fan.size} central paths over a ${polytope.constraintCount}-face hull\")\n    turntable(degreesPerSecond = 20.0)\n}\n\"${fan.size} paths\"\n"}}} {"id" "lp3_routes" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "every route to one vertex, in 3-D" "_tombstone" false "frame" #afield/rect [80.0 80.0 420.0 120.0] "code" #afield/file-inline {"path" "lp3_routes_code_.kt" "inline" "val random = kotlin.random.Random(11)\nval cloud = List(70) {\n    vec(random.nextDouble(-1.6, 1.6), random.nextDouble(-1.0, 1.0), random.nextDouble(-1.0, 1.0))\n}\nval polytope = LpPolytope.hull(cloud)\nval c = vec(1.0, 0.5, 0.3)\nval far = polytope.vertices.indexOf(polytope.optimalVertex(vec(-1.0, -0.5, -0.3)))\n\nval central = polytope.centralPath(c)\nval pd = polytope.primalDual(c)\nval walk = polytope.simplexWalk(c, startVertex = far)\nval spiral = polytope.pdhg(c, iterations = 800, tau = 0.25, sigma = 0.25)\n\nthree(name = \"routes\", width = 760, height = 470) {\n    mesh(polytope.toMesh(), wireframe = false, opacity = 0.1, cullBackFaces = false)\n    lines(polytope.toFLine(vec(0.62, 0.70, 0.80, 0.5)))\n    lines(\n        central.toFLine(vec(1.0, 0.72, 0.32, 1.0), 2.4),\n        pd.toFLine(vec(0.55, 0.9, 0.6, 1.0), 1.6),\n        walk.toFLine(vec(0.6, 0.75, 1.0, 1.0), 3.0),\n        spiral.trajectory.toFLine(vec(1.0, 0.55, 0.85, 0.8), 1.0),\n    )\n    camera(yaw = 20.0, pitch = 20.0)\n    title(\"${polytope.vertices.size} hull vertices, ${polytope.constraintCount} faces\")\n    caption(\n        \"orange: central path · green: primal-dual, ${pd.samples.size - 1} steps · blue: simplex, ${walk.samples.size - 1} pivots · pink: PDHG\",\n    )\n}\n\"every route ends at ${polytope.optimalVertex(c)}\"\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}