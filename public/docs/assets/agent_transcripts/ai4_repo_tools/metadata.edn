{"version" 2 "boxes" [{"id" "ai4-repo-tools-scope" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "repo tools on a toy checkout" "_tombstone" false "frame" #afield/rect [60.0 60.0 520.0 160.0] "code" #afield/file-inline {"path" "ai4-repo-tools-scope_code_.kt" "inline" "// A throwaway checkout: two docs pages, a generated file, and a secret beside the root.\nval outer = java.nio.file.Files.createTempDirectory(\"repo-tools-demo\")\nval root = java.nio.file.Files.createDirectories(outer.resolve(\"repo\"))\nfun put(path: String, text: String) {\n    val p = root.resolve(path)\n    java.nio.file.Files.createDirectories(p.parent)\n    java.nio.file.Files.writeString(p, text)\n}\nput(\"docs/page.md\", \"# Toy\\n\\nThe recieve function returns teh value.\\n\")\nput(\"docs/other.md\", \"Nothing to fix here.\\n\")\nput(\"gen/Table.kt\", \"// DO NOT EDIT — generated by tools/table-generator\\nval table = 1\\n\")\njava.nio.file.Files.writeString(outer.resolve(\"secret.txt\"), \"not yours\\n\")\njava.nio.file.Files.createSymbolicLink(root.resolve(\"docs/escape.txt\"), outer.resolve(\"secret.txt\"))\n\n// What a job may touch: read docs and gen, write one page and gen.\nval scope = afield.ai.tools.RepoScope(root, [\"docs/**\", \"gen/**\"], [\"docs/page.md\", \"gen/**\"])\nval tools = afield.ai.tools.RepoFileTools(scope)\n\nprintln(tools.search(afield.ai.tools.RepoSearchRequest(\"re(ci|ie)ve\", regex = true)).matches)\nprintln(\n    tools\n        .patch(\n            afield.ai.tools.RepoPatchFileRequest(\n                \"docs/page.md\",\n                \"recieve function returns teh\",\n                \"receive function returns the\",\n            ),\n        )\n        .message,\n)\nprintln(tools.read(afield.ai.tools.RepoReadFileRequest(\"docs/page.md\", 3, 3)).text)\n\n// Refusals: each comes back as success=false with the reason the model would read.\nfor (path in [\"../secret.txt\", \"docs/escape.txt\", \".git/config\", \"src/Main.kt\"]) println(\n    \"$path -> \" + tools.read(afield.ai.tools.RepoReadFileRequest(path)).message,\n)\nprintln(\n    \"docs/other.md (read-only) -> \" +\n        tools.patch(afield.ai.tools.RepoPatchFileRequest(\"docs/other.md\", \"Nothing\", \"Everything\")).message,\n)\nprintln(\"gen/Table.kt -> \" + tools.patch(afield.ai.tools.RepoPatchFileRequest(\"gen/Table.kt\", \"1\", \"2\")).message)\nprintln(\"wrote: \" + tools.written)\nouter.toFile().deleteRecursively()\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}