{"version" 2 "boxes" [{"id" "ggw_raster" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "ggw_renderer"} "name" "gezira on the gpu" "_tombstone" false "frame" #afield/rect [40.0 200.0 340.0 100.0] "code" #afield/file-inline {"path" "ggw_raster_code_.kt" "inline" "import afield.graphics.nile.*\n\nval W = 120\nval H = 48\n// Three shapes where the two fill rules differ, in pixel units.\nval shape =\n    GeziraGpu.pentagram(22.3, 25.4, 21.0) +\n        Gezira.circle(54.2, 21.7, 13.0) +\n        Gezira.circle(66.6, 27.3, 13.0) +\n        GeziraGpu.holedSquare(84.3, 7.6, 32.0, 14.0, sameWay = true)\n\n// The probe owns the buffers and the shader; one dispatch per fill rule.\nval probe = GpuProbe(renderer, \"gezira-gpu-demo\")\nval stage = GeziraGpu.stage(probe)\nval jobs = FillRule.entries.map { GeziraGpu.dispatch(probe, stage, shape, W, H, it, it.name) }\n\n// One picture, 2 x 3: a row per fill rule; GPU, CPU, and their difference x 100,000.\nval gap = 4\nval cw = 3 * W + 2 * gap\nval white = DoubleArray(cw * (2 * H + gap))\nval red = DoubleArray(white.size)\nfun place(into: DoubleArray, c: DoubleArray, col: Int, row: Int) {\n    for (y in 0 until H) for (x in 0 until W) {\n        into[(row * (H + gap) + y) * cw + col * (W + gap) + x] = c[y * W + x]\n    }\n}\nframes {\n    try {\n        probe.arm(*jobs.map { it.coverage }.toTypedArray())\n        while (probe.stillWaiting()) frame()\n        for ((n, job) in jobs.withIndex()) {\n            val rule = job.packed.rule\n            val gpu = job.read()\n            val cpu = Gezira.rasterize(shape, W, H, rule)\n            val (worst, mean) = Gezira.error(gpu, cpu)\n            println(\"$rule: largest |gpu - cpu| %.2e, mean %.2e over the covered pixels\".format(worst, mean))\n            place(white, gpu, 0, n)\n            place(white, cpu, 1, n)\n            place(red, DoubleArray(gpu.size) { Math.abs(gpu[it] - cpu[it]) * 1e5 }, 2, n)\n        }\n        lines(\n            Gezira.pixels(white, cw, 4.0) + Gezira.pixels(red, cw, 4.0, 1.0, 0.25, 0.2),\n            channel = \"gpu, cpu, difference\",\n        )\n    } finally {\n        probe.close()\n    }\n}\n"}}} {"id" "ggw_renderer" "properties" {"children" #{#afield/box "ggw_raster"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "ggw_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nOptions.profiling = false\nonce.renderer {\n    window = Window(\"gezira on the gpu\", initialDimensions = Rect(80.0, 80.0, 400.0, 300.0))\n    Renderer(window)\n}\nprintln(\"renderer ready\")\nstart(renderer::run)\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}