{"version" 2 "boxes" [{"id" "heatmap_spectrogram" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "spectrogram (magma)" "_tombstone" false "frame" #afield/rect [820.0 80.0 300.0 100.0] "code" #afield/file-inline {"path" "heatmap_spectrogram_code_.kt" "inline" "// A synthetic [frame][bin] magnitude spectrogram with a rising ridge. transpose=true puts\n// time on x and frequency on y; flipY keeps low frequency at the bottom; logScale gives a\n// dB-like view. This is exactly the shape the spectral docs hand-rolled by hand before.\nval frames = 120; val bins = 80\nval spec = Array(frames) { f ->\n    DoubleArray(bins) { bin ->\n        val ridge = (bins * (0.15 + 0.7 * f / frames)).toInt()\n        val d = (bin - ridge).toDouble()\n        (0.001 + exp(-d * d / 12.0)) * (1.0 + 0.3 * sin(f * 0.3))\n    }\n}\nshowHeatmap(spec, colormap = \"magma\", width = 900, transpose = true, flipY = true, logScale = true)\n"}}} {"id" "heatmap_diverging" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "diverging (coolwarm)" "_tombstone" false "frame" #afield/rect [80.0 500.0 300.0 100.0] "code" #afield/file-inline {"path" "heatmap_diverging_code_.kt" "inline" "// A sin*sin field in [-1,1]. A fixed vmin/vmax with normalize=false anchors the coolwarm\n// white midpoint at zero, so blue = negative, red = positive.\nval field = Array(48) { row ->\n    DoubleArray(64) { col -> sin(col * 0.18) * sin(row * 0.22) }\n}\nshowHeatmap(field, colormap = \"coolwarm\", width = 640, vmin = -1.0, vmax = 1.0, normalize = false)\n"}}} {"id" "heatmap_gaussian" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "gaussian (viridis)" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 100.0] "code" #afield/file-inline {"path" "heatmap_gaussian_code_.kt" "inline" "// A smooth 2-D Gaussian bump -> viridis heatmap. showHeatmap min-max normalizes,\n// bilinear-upsamples the coarse grid, and displays the PNG inline in one call.\nval bump = Array(48) { row ->\n    DoubleArray(64) { col ->\n        val dx = (col - 32) / 16.0\n        val dy = (row - 24) / 12.0\n        exp(-(dx * dx + dy * dy))\n    }\n}\nshowHeatmap(bump, colormap = \"viridis\", width = 640)\n"}}} {"id" "heatmap_image" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "image (showImage)" "_tombstone" false "frame" #afield/rect [820.0 540.0 300.0 100.0] "code" #afield/file-inline {"path" "heatmap_image_code_.kt" "inline" "// showImage displays a ready-made ARGB IntArray directly (encode + display), for when you\n// already have a pixel buffer rather than a scalar field.\nval w = 512; val h = 256\nval px = IntArray(w * h)\nfor (y in 0 until h) for (x in 0 until w) {\n    val r = x * 255 / (w - 1)\n    val b = y * 255 / (h - 1)\n    px[x + y * w] = (0xFF shl 24) or (r shl 16) or (0x40 shl 8) or b\n}\nshowImage(px, w, h)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory"]}