{"version" 2 "boxes" [{"id" "evieve_korg_sweep" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Korg35 swept at audio rate" "_tombstone" false "frame" #afield/rect [60.0 260.0 520.0 140.0] "code" #afield/file-inline {"path" "evieve_korg_sweep_code_.kt" "inline" "// A 55 Hz saw through Korg35. The cutoff is a Param whose mod is a Signal, so it moves per sample:\n// a slow 0.5 Hz sweep plus a 110 Hz wobble that puts sidebands on the resonance.\nval cutoff = Param(1200f).also { it.mod = SineOsc(0.5.p) * 900f + SineOsc(110.p) * 250f }\nval voice = SawOsc(55.p) / Korg35(cutoff, 0.9.p, drive = 2.p)\naudio(voice, gain = 0.15f)\n"}}} {"id" "evieve_korg_response" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Korg35 measured response" "_tombstone" false "frame" #afield/rect [60.0 60.0 520.0 140.0] "code" #afield/file-inline {"path" "evieve_korg_response_code_.kt" "inline" "// The Korg35 (MS-20) lowpass at 1 kHz, measured: one second of impulse response, then an FFT, so\n// bin k is k Hz. The tiny amplitude keeps its tanh linear, so this is the small-signal response.\nfun responseDb(filter: SignalProcessor) =\n    fft(impulseResponse(filter, 48_000, amplitude = 1e-4f), 48_000.0).magnitudeDbOneSided().take(5000)\n\nshowSignals(\n    \"resonance 0.1\" to responseDb(Korg35(1000.p, 0.1.p)),\n    \"resonance 0.5\" to responseDb(Korg35(1000.p, 0.5.p)),\n    \"resonance 0.95\" to responseDb(Korg35(1000.p, 0.95.p)),\n    \"highpass 0.8\" to responseDb(Korg35(1000.p, 0.8.p, Korg35Mode.HP)),\n    channel = \"main\",\n    xTitle = \"frequency (Hz)\",\n)\n"}}} {"id" "evieve_resonator" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - Resonators: response and sound" "_tombstone" false "frame" #afield/rect [60.0 460.0 520.0 140.0] "code" #afield/file-inline {"path" "evieve_resonator_code_.kt" "inline" "// Three Resonators on white noise, each frequency drifting on its own slow sine,\n// with the 1 kHz resonator's response at three decays plotted beside it.\nfun responseDb(filter: SignalProcessor) =\n    fft(impulseResponse(filter, 48_000), 48_000.0).magnitudeDbOneSided().take(5000)\n\nshowSignals(\n    \"decay 0.02 s\" to responseDb(Resonator(1000.p, 0.02.p)),\n    \"decay 0.1 s\" to responseDb(Resonator(1000.p, 0.1.p)),\n    \"decay 0.5 s\" to responseDb(Resonator(1000.p, 0.5.p)),\n    channel = \"main\",\n    xTitle = \"frequency (Hz)\",\n)\nval noise = WhiteNoise() * 0.3f\nfun band(f: Float, drift: Float, rate: Float, decay: Float) =\n    noise / Resonator(Param(f).also { it.mod = SineOsc(rate.p) * drift }, decay.p)\naudio(band(300f, 80f, 0.2f, 0.6f) + band(750f, 150f, 0.45f, 0.4f) + band(2100f, 300f, 0.7f, 0.3f), gain = 0.5f)\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}