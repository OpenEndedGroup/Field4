{"version" 2 "boxes" [{"id" "oidn_raster_renderer" "properties" {"children" #{#afield/box "oidn_raster_particles"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 110.0] "code" #afield/file-inline {"path" "oidn_raster_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nonce.renderer {\n    window = Window(\"Field · Denoising a raster render\")\n    Renderer(window)\n}\nstart(renderer::run)\n"}}} {"id" "oidn_raster_particles" "properties" {"children" #{#afield/box "oidn_raster_denoise"} "parents" #{#afield/box "root" #afield/box "oidn_raster_renderer"} "name" "particles, stochastic transparency" "_tombstone" false "frame" #afield/rect [320.0 180.0 340.0 120.0] "code" #afield/file-inline {"path" "oidn_raster_particles_code_.kt" "inline" "import afield.graphics.vulkan.targets.RenderToTexture\nimport org.lwjgl.vulkan.VK10.VK_FORMAT_R32G32B32A32_SFLOAT\n\n// A 640 x 360 float target, drawn every frame.\nprop<RenderToTexture>(particleImage) = RenderToTexture {\n    width = 640\n    height = 360\n    useDepth = false\n    format = VK_FORMAT_R32G32B32A32_SFLOAT\n}\nrenderer.renderList += \"oidn particles\" to particleImage\n\n// 3000 soft discs on a three-armed spiral. Each fragment is kept with probability equal to\n// the disc's opacity there, and drawn opaque: stochastic transparency, one sample a pixel.\nval module = Module(\n    parameters(renderer) {\n        name = \"oidn-particles\"\n        +particleImage\n        depthTest = false\n        depthWrite = false\n        blend = false\n        vertex =\n            \"\"\"#version 450\n        layout(location=0) out vec2 tc;\n        layout(location=1) flat out int id;\n        layout(location=2) flat out vec3 col;\n        const vec2 corner[6] = vec2[](vec2(0,0), vec2(1,0), vec2(1,1), vec2(0,0), vec2(1,1), vec2(0,1));\n        float h(float n) { return fract(sin(n) * 43758.5453); }\n        void main() {\n            int i = gl_VertexIndex / 6;\n            float f = float(i) + 1.0;\n            id = i;\n            tc = corner[gl_VertexIndex % 6];\n            float r = 0.08 + 0.8 * h(f * 5.3);\n            float a = r * 5.0 + floor(h(f * 3.1) * 3.0) * 2.0944 + (h(f * 7.7) - 0.5) * 0.7;\n            float s = 0.03 + 0.09 * h(f * 9.1);\n            col = mix(vec3(1.0, 0.5, 0.15), vec3(0.25, 0.55, 1.0), r) * (0.5 + h(f * 11.3));\n            vec2 p = vec2(cos(a), sin(a)) * r + (tc - 0.5) * s;\n            gl_Position = vec4(p.x * 360.0 / 640.0, p.y, 0.5, 1.0);\n        }\"\"\"\n        fragment =\n            \"\"\"#version 450\n        layout(location=0) in vec2 tc;\n        layout(location=1) flat in int id;\n        layout(location=2) flat in vec3 col;\n        layout(location=0) out vec4 color;\n        float hash(uvec3 v) {\n            v = v * 1664525u + 1013904223u;\n            v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;\n            v ^= v >> 16u;\n            v.x += v.y * v.z;\n            return float(v.x) / 4294967295.0;\n        }\n        void main() {\n            float d = length(tc * 2.0 - 1.0);\n            float opacity = d < 1.0 ? 0.6 * exp(-4.0 * d * d) : 0.0;\n            if (hash(uvec3(gl_FragCoord.xy, id)) >= opacity) discard;\n            color = vec4(col, 1.0);\n        }\"\"\"\n    },\n)\nval discs = Mesh(renderer, module.pointer())\ndiscs.resize(3000 * 6, 0, module.pointer())\nmodule.meshes[\"discs\"] = discs\nparticleImage.modules[\"discs\"] = module.pointer()\nprintln(\"drawing 3000 particles into ${particleImage.width} x ${particleImage.height}\")\n"}}} {"id" "oidn_raster_denoise" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "oidn_raster_particles"} "name" "denoise the raster image" "_tombstone" false "frame" #afield/rect [320.0 340.0 340.0 120.0] "code" #afield/file-inline {"path" "oidn_raster_denoise_code_.kt" "inline" "import afield.media.image.util.PngEncoder\nimport afield.media.reconstruction.OidnComputeDenoiser\nimport afield.media.reconstruction.OidnImageSource\n\n// Copy the particle render into an image source and denoise it once, with flat guides.\nval image = OidnImageSource(renderer, 640, 360).upload(particleImage)\nval denoiser = OidnComputeDenoiser(image)\nval denoised = denoiser.denoiseImage()\nval noisy = denoiser.read(image.radiance)\n\n// The middle 400 columns of each, noisy on the left and denoised on the right, as sRGB.\nfun srgb(x: Float) =\n    (255 * (if (x <= 0.0031308f) 12.92f * x else 1.055f * x.pow(1 / 2.4f) - 0.055f)).toInt().coerceIn(0, 255)\nval pixels =\n    IntArray(800 * 360) { k ->\n        val x = k % 800\n        val y = k / 800\n        val src = if (x < 400) noisy else denoised\n        val i = (y * 640 + 120 + x % 400) * 4\n        (255 shl 24) or (srgb(src[i]) shl 16) or (srgb(src[i + 1]) shl 8) or srgb(src[i + 2])\n    }\ndisplay(\"main\", PngEncoder.encode(pixels, 800, 360))\nprintln(\"denoised ${image.width} x ${image.height} in ${denoiser.lastDenoiseMs.f0} ms\")\ndenoiser.close()\nimage.close()\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers