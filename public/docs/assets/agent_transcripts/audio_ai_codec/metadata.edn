{"version" 2 "boxes" [{"id" "encodec_reconstruction_microscope" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "EnCodec reconstruction microscope" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 100.0] "code" #afield/file-inline {"path" "encodec_reconstruction_microscope_code_.kt" "inline" "import afield.stdlib.noir.audioai.*\n\nval sampleRate = 8000\nval seconds = 4.0\nval source = FloatArray((sampleRate * seconds).toInt()) { i ->\n    val t = i / sampleRate.toDouble()\n    val chirp = sin(2.0 * PI * (180.0 * t + 110.0 * t * t))\n    val room = 0.28 * sin(2.0 * PI * 720.0 * t) * exp(-0.16 * t)\n    (0.62 * chirp + room + 0.025 * sin(2.0 * PI * 3100.0 * t)).toFloat()\n}\nval reconstruction = FloatArray(source.size) { i ->\n    source[i] * 0.91f +\n        (0.008 * sin(i * 0.173) + 0.004 * sin(i * 0.037)).toFloat()\n}\nval tokenFrames = (seconds * 50).toInt()\nval tokenValues = LongArray(4 * tokenFrames) { i ->\n    val codebook = i / tokenFrames\n    val frame = i % tokenFrames\n    ((frame * (31 + codebook * 8) + 173 * codebook + 97 * sin(frame * 0.11)).toLong() and 2047)\n}\nval data = CodecVisualizationData(\n    source, reconstruction, sampleRate,\n    NpyIntTensor(intArrayOf(1, 4, tokenFrames), tokenValues),\n    ReconstructionMetrics(0.0123, 18.7, 0.143),\n    50.0, 2048, \"EnCodec 32 kHz · deterministic documentation fixture\",\n)\ndisplay(\"main\", CodecVisualization.renderHtml(data, width = 1100))\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute