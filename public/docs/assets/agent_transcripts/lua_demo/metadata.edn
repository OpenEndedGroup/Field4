{"version" 2 "boxes" [{"id" "lua_hello" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "lua_root"} "name" "hello" "_tombstone" false "frame" #afield/rect [40.0 180.0 160.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "lua_hello_code_.kt" "inline" "-- Run the box, or select one line and run just that.\nlocal greeting = \"hello from \" .. field.version\nprint(greeting)\nx = 6 * 7\nprint(\"x is\", x)\n"}}} {"id" "lua_runaway" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "lua_root"} "name" "runaway" "_tombstone" false "frame" #afield/rect [230.0 320.0 160.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "lua_runaway_code_.kt" "inline" "-- A loop that never ends is stopped after field.budget seconds (5 unless you say).\nfield.budget = 1\nlocal n = 0\nwhile true do n = n + 1 end\n"}}} {"id" "lua_error" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "lua_root"} "name" "an error" "_tombstone" false "frame" #afield/rect [800.0 180.0 160.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "lua_error_code_.kt" "inline" "local t = {}\nprint(\"before the error\")\nprint(t.missing.field)\nprint(\"never printed\")\n"}}} {"id" "lua_jit" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "lua_root"} "name" "jit" "_tombstone" false "frame" #afield/rect [420.0 180.0 160.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "lua_jit_code_.kt" "inline" "-- The JIT starts off so the runaway guard works. Turn it on for code you trust to finish.\nlocal function work(n) local s = 0 for i = 1, n do s = s + i % 7 end return s end\nlocal t0 = os.clock(); work(3e7); local interpreted = os.clock() - t0\njit.on()\nt0 = os.clock(); work(3e7); local compiled = os.clock() - t0\njit.off()\nprint(string.format(\"interpreted %.3f s, compiled %.3f s: %.0fx\", interpreted, compiled, interpreted / compiled))\n"}}} {"id" "lua_root" "properties" {"children" #{#afield/box "lua_hello" #afield/box "lua_thisbox" #afield/box "lua_drawing" #afield/box "lua_wave" #afield/box "lua_spawned" #afield/box "lua_error" #afield/box "lua_runaway" #afield/box "lua_jit" #afield/box "lua_accumulate" #afield/box "lua_controls" #afield/box "lua_sequencer"} "parents" #{#afield/box "root"} "name" "status — children of this box are Lua" "_tombstone" false "frame" #afield/rect [40.0 40.0 460.0 80.0] "mainLanguage" "lua" "code" #afield/file-inline {"path" "lua_root_code_.kt" "inline" "// This root stays Kotlin; its `mainLanguage` makes the boxes under it Lua.\nprintln(afield.lua.LuaLibrary.describe())\n"}}} {"id" "lua_drawing" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "lua_root"} "name" "drawing" "_tombstone" false "frame" #afield/rect [40.0 460.0 160.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "lua_drawing_code_.kt" "inline" "-- FLines from Lua: line() builds one, lines(...) draws them in the box's output.\nlocal shapes = {}\nfor k = 0, 23 do\n  local a = k * math.pi / 12\n  local r = (k % 2 == 0) and 130 or 80\n  shapes[#shapes + 1] = line()\n    :moveTo(200, 150)\n    :lineTo(200 + r * math.cos(a), 150 + r * math.sin(a))\n    :color(k / 23, 0.45, 1 - k / 23)\n    :width(3)\nend\nshapes[#shapes + 1] = line():circle(200, 150, 42):color(1, 0.8, 0.2, 0.9):fill()\nshapes[#shapes + 1] = line():rect(20, 20, 360, 260):color(0.6, 0.6, 0.6):width(1)\nlines(shapes, {w = 400, h = 300})\n"}}} {"id" "lua_wave" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "lua_root"} "name" "wave" "_tombstone" false "frame" #afield/rect [560.0 460.0 160.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "lua_wave_code_.kt" "inline" "-- Launch this box: update(dt) runs every frame until you stop it.\nlocal t = 0\nfunction update(dt)\n  t = t + dt\n  local l = line()\n  for i = 0, 100 do\n    local x, y = i * 4, 100 + 60 * math.sin(i / 8 + t * 3)\n    if i == 0 then l:moveTo(x, y) else l:lineTo(x, y) end\n  end\n  lines(l:color(0.3, 0.8, 1):width(2), {w = 400, h = 200})\nend\n"}}} {"id" "lua_spawned" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "lua_root"} "name" "spawned" "_tombstone" false "frame" #afield/rect [40.0 320.0 160.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "lua_spawned_code_.kt" "inline" "-- Launch this box: spawn runs a function as a coroutine, wait(s) pauses it.\nspawn(function()\n  for i = 1, 4 do\n    print(\"tick\", i, \"frame\", field.frame())\n    wait(0.5)\n  end\n  print(\"done\")\nend)\n"}}} {"id" "lua_thisbox" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "lua_root"} "name" "this box" "_tombstone" false "frame" #afield/rect [230.0 180.0 160.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "lua_thisbox_code_.kt" "inline" "-- box is this box; its properties read and write by name. Run it twice.\nbox.counter = (box.counter or 0) + 1\nprint(\"run\", box.counter, \"of\", tostring(box))\nfor _, parent in ipairs(box.parents) do print(\"a parent:\", parent.name, \"with\", #parent.children, \"children\") end\nprint(\"the drawing box is at x =\", field.named(\"drawing\").frame.x)\n"}}} {"id" "lua_sequencer" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "lua_root"} "name" "sequencer" "_tombstone" false "frame" #afield/rect [40.0 900.0 160.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "lua_sequencer_code_.kt" "inline" "-- Lua makes the notes, Field's pattern voice plays them (the norns shape). Run it to hear the\n-- sequence loop; run it again for new notes, stop the box for silence.\nlocal scale = {0, 2, 3, 5, 7, 8, 10}\nlocal notes = {}\nfor i = 1, 8 do notes[i] = 57 + scale[math.random(#scale)] + (i % 4 == 0 and 12 or 0) end\nprint(\"notes\", table.concat(notes, \" \"))\nlocal heard = field.render(notes, {cps = 0.5, wave = \"triangle\", decay = 0.3})\nprint(string.format(\"%.0f s, peak %.2f, rms %.3f\", heard.seconds, heard.peak, heard.rms))\nplay(notes, {cps = 0.5, wave = \"triangle\", decay = 0.3})\n"}}} {"id" "lua_accumulate" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "lua_root"} "name" "accumulates" "_tombstone" false "frame" #afield/rect [610.0 180.0 160.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "lua_accumulate_code_.kt" "inline" "-- One Lua state per box, kept across runs. Select line 2 and run it, then line 3.\nfunction greet(who) return \"hello, \" .. who end\ngreet(\"Field\")\n"}}} {"id" "lua_controls" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "lua_root"} "name" "controls" "_tombstone" false "frame" #afield/rect [990.0 180.0 160.0 80.0] "code_language" "Lua" "code" #afield/file-inline {"path" "lua_controls_code_.kt" "inline" "-- A slider made from Lua: move it and the circle follows. slider() returns its first value.\nlocal function draw(r)\n  local frame = line():rect(0, 0, 300, 200):color(0.5, 0.5, 0.5):width(1)\n  lines(frame, line():circle(150, 100, r):color(1, 0.5, 0.2):fill(), {w = 300, h = 200})\nend\ndraw(slider(\"radius\", 5, 90, 40, draw))\n"}}} {"id" "lua_notes" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "line notes" "_tombstone" false "frame" #afield/rect [420.0 320.0 160.0 80.0] "code" #afield/file-inline {"path" "lua_notes_code_.kt" "inline" "// Kotlin: what Field recorded for each line of \"hello\" when it last ran. Run \"hello\" first.\nval hello = root.children.first { it.name == \"hello\" }\nval code = hello.getPropertyRaw(\"code\") as String\ncode.lines().forEachIndexed { i, _ ->\n    afield.stdlib.LineNotes.note(hello, \"code\", code, i + 1)?.let { println(\"line ${i + 1}: ${it.caption}\") }\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "at