{"version" 2 "boxes" [{"id" "motion_recording_probe" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Motion — coordinate probe" "_tombstone" false "frame" #afield/rect [80.0 80.0 600.0 110.0] "code" #afield/file-inline {"path" "motion_recording_probe_code_.kt" "inline" "import afield.animation.mocap.MotionExamples\nimport java.util.concurrent.atomic.AtomicBoolean\nimport java.util.concurrent.atomic.AtomicReference\n\n// A known coordinate probe: this clip contains no learned or simulated motion.\n// Replace it with MotionRecording(Path.of(\"your.f4motion\")).clip() to inspect a recording.\nval clip = MotionExamples.contractClip()\nval play = AtomicBoolean(false)\nval scrub = AtomicReference(1.35)\ncontrolGroup {\n    slider(\"Session time (seconds)\", 0.0, 4.0, initialValue=1.35) { scrub.set(it) }\n    checkbox(\"Play recording\", initialValue=false) { play.set(it) }\n}\nval started = AnimationClock.nowSeconds()\n\nloop {\n    val time = if (play.get()) (AnimationClock.nowSeconds() - started) % 4.0 else scrub.get()\n    val snapshot = clip.sample(time)\n    val pose = snapshot.frame.executed\n    val drawing = fline {\n        clip.skeleton.parents.forEachIndexed { i, parent ->\n            if (parent >= 0) {\n                val a = pose.position(parent)\n                val b = pose.position(i)\n                moveTo(300.0 + 180 * a.x, 250.0 - 180 * a.y)\n                lineTo(300.0 + 180 * b.x, 250.0 - 180 * b.y)\n            }\n        }\n        color = if (snapshot.frame.episode == 0L) vec(0.25, 0.7, 1.0, 1.0) else vec(1.0, 0.5, 0.2, 1.0)\n        thickness = 5.0\n    }\n    val points = fline {\n        repeat(clip.skeleton.size) { i ->\n            val p = pose.position(i)\n            circle(300.0 + 180 * p.x, 250.0 - 180 * p.y, 7.0)\n        }\n        color = vec(0.85, 0.9, 1.0, 1.0)\n        filled = true\n    }\n    val border = fline { rect(0.0, 0.0, 600.0, 300.0); color = vec(0.2, 0.25, 0.3, 1.0) }\n    lines(border, drawing, points, w=600.0, h=300.0, channel=\"motion\")\n    markdown(\"status\", \"**Coordinate probe** · no network inference\\n\\n\" +\n        \"Time ${time.f2} s · episode ${snapshot.frame.episode} · \" +\n        if (snapshot.held) \"holding before reset\" else \"recorded pose\")\n    displayOpen(\"motion\")\n    displayOpen(\"status\")\n    delay(16) // Yield without flooding the UI transport.\n\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}