{"version" 2 "boxes" [{"id" "lp_continue" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - continue a line" "_tombstone" false "frame" #afield/rect [60.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "lp_continue_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n// A few strokes of our own, in canvas pixels. The pen is shown all of them, then carries on\n// from where the last one ends. Change the seed for a different continuation.\nval start = fline {\n    moveTo(0, 0)\n    cubicTo(6, -26, 22, -26, 20, -4)\n    cubicTo(18, 8, 30, 10, 38, -2)\n    lineTo(46, -14)\n    color = vec(1.0, 0.85, 0.3, 1.0)\n    thickness = 2.0\n}\nval more = start.continueWith(steps = 500, seed = 3).apply { color = vec(0.85, 0.9, 1.0, 1.0) }\nlines(start, more, w = 520.0, h = 260.0, fitToSize = true)\n"}}} {"id" "lp_cells" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "6 - which cell? (launch)" "_tombstone" false "frame" #afield/rect [60.0 4760.0 300.0 100.0] "code" #afield/file-inline {"path" "lp_cells_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n// The pen writes 500 points once, remembering every cell's output at every point. Drag the\n// slider to colour the line by a cell: blue where it is low, orange where it is high. The\n// \"liveliest\" line lists the cells that changed most, the ones worth trying first.\nval start = fline { moveTo(0, 0); cubicTo(4, -14, 12, -14, 12, 0); cubicTo(12, 8, 20, 8, 24, 0) }\nval writer = PenLine(start, seed = 4, recordMemory = true)\nwriter.grow(500)\nval lively = writer.liveliestCells(12)\nmarkdown(\"liveliest\", \"liveliest cells: ${lively.joinToString(\", \")}\")\nvar cell = lively[0]\nvar shown = -1\nslider(\"cell\", min = 0.0, max = 499.0, step = 1.0, initialValue = cell.toDouble()) { cell = it.toInt() }\nframes {\n    while (frame()) {\n        if (cell == shown) continue\n        shown = cell\n        lines(writer.coloredByCell(cell, thickness = 2.0), channel = \"cell\", w = 520.0, h = 200.0, fitToSize = true)\n    }\n}\n"}}} {"id" "lp_cell" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - one memory cell" "_tombstone" false "frame" #afield/rect [60.0 2560.0 300.0 100.0] "code" #afield/file-inline {"path" "lp_cell_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n// The same pen, the same seed, written three times. The middle row holds one memory cell at\n// +4 the whole way, the bottom row at -4. Which cell does what is something to find out:\n// try other cells (0 until 500) and values.\nval cell = 136\nfun row(value: Double?, y: Double): FLine {\n    val writer = PenLine(start = vec(0.0, y, 0.0), seed = 11)\n    repeat(400) {\n        if (value != null) (writer.pen as Pen).setCell(cell, value)\n        writer.grow()\n    }\n    return writer.line\n}\nlines(row(null, 0.0), row(4.0, 140.0).apply { color = vec(0.5, 1.0, 0.6, 1.0) },\n    row(-4.0, 280.0).apply { color = vec(1.0, 0.55, 0.6, 1.0) }, w = 520.0, h = 340.0, fitToSize = true)\n"}}} {"id" "lp_draw" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - draw, and it writes on (launch)" "_tombstone" false "frame" #afield/rect [60.0 1060.0 300.0 100.0] "code" #afield/file-inline {"path" "lp_draw_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n// Launch, and the pen writes on from the yellow stroke in \"pen\". Draw a stroke of your own in\n// \"draw here\" and it starts again from yours. The sliders change how it samples as it goes.\nvar temperature = 0.65\nvar noise = 0.65\ncontrolGroup(\"pen controls\") {\n    slider(\"temperature\", min = 0.05, max = 2.0, initialValue = temperature) { temperature = it }\n    slider(\"noise\", min = 0.0, max = 1.5, initialValue = noise) { noise = it }\n}\n\nval border = fline { moveTo(0, 0); lineTo(500, 0); lineTo(500, 240); lineTo(0, 240); lineTo(0, 0); color = vec(1, 1, 1, 0.2) }\nval starter = fline { moveTo(30, 120); cubicTo(36, 96, 52, 96, 50, 116); cubicTo(48, 128, 60, 130, 68, 118); color = vec(1.0, 0.85, 0.3, 1.0); thickness = 2.0 }\nval canvas = lines(border, starter, channel = \"draw here\", w = 520.0, h = 260.0, editable = true, drawing = true)!!\nvar primer = starter\nvar writer: PenLine? = null\nvar seen = 1\nframes {\n    while (frame()) {\n        val drawn = canvas.currentLines()\n        if (drawn.size > seen) {\n            seen = drawn.size\n            primer = drawn.last().copy().apply { color = vec(1.0, 0.85, 0.3, 1.0); thickness = 2.0 }\n            writer = PenLine(primer)\n        }\n        val w = writer ?: continue\n        w.controls = PenControls(temperature = temperature, noise = noise)\n        // four points a frame, until it writes off the right-hand edge\n        val x = w.drawn.currentPoint?.x ?: 0f\n        if (x < 490f) w.grow(4)\n        lines(border, primer, w.drawn.apply { color = vec(0.85, 0.9, 1.0, 1.0) }, channel = \"pen\", w = 520.0, h = 260.0)\n    }\n}\n"}}} {"id" "lp_futures" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - futures" "_tombstone" false "frame" #afield/rect [60.0 560.0 300.0 100.0] "code" #afield/file-inline {"path" "lp_futures_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n// Twelve things the pen might do next, from the same line, each drawn beside its own copy\n// of the line. They share the pen's reading of the yellow stroke and differ only in the\n// random choices after it.\nval start = fline {\n    moveTo(0, 0)\n    cubicTo(4, -14, 12, -14, 12, 0)\n    cubicTo(12, 8, 20, 8, 24, 0)\n    color = vec(1.0, 0.85, 0.3, 1.0)\n    thickness = 1.5\n}\nval futures = start.futuresWith(count = 12, steps = 80)\nval grid = mutableListOf<FLine>()\nfutures.forEachIndexed { k, future ->\n    val at = vec(k % 3 * 170.0, k / 3 * 60.0, 0.0)\n    grid += start + at\n    grid += (future + at).apply { color = vec(0.75, 0.85, 1.0, 1.0) }\n}\nlines(grid, w = 520.0, h = 260.0, fitToSize = true)\n"}}} {"id" "lp_expects" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5 - what it expects (launch)" "_tombstone" false "frame" #afield/rect [60.0 3060.0 300.0 100.0] "code" #afield/file-inline {"path" "lp_expects_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n// Launch, and the pen writes two points a frame. \"page\" draws its line thick where it is sure\n// to stay on the paper and thin where it expects to lift. \"tip\" is a magnifier on the last\n// dozen points, with an ellipse for each of its guesses about where the next point will land.\nval start = fline { moveTo(0, 0); cubicTo(4, -14, 12, -14, 12, 0); cubicTo(12, 8, 20, 8, 24, 0); color = vec(1.0, 0.85, 0.3, 1.0); thickness = 2.0 }\nvar noise = 1.0\nslider(\"noise\", min = 0.1, max = 1.5, initialValue = noise) { noise = it }\nval writer = PenLine(start, seed = 9)\nframes {\n    while (frame()) {\n        if (writer.history.size > 600) continue\n        writer.controls = PenControls(noise = noise)\n        writer.grow(2)\n        lines([start] + writer.widthByLift(), channel = \"page\", w = 520.0, h = 200.0, fitToSize = true)\n        lines(writer.closeUp(12).lines(), channel = \"tip\", w = 520.0, h = 260.0, fitToSize = true)\n    }\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}