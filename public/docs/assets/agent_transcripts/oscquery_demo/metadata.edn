{"version" 2 "boxes" [{"id" "oscq-mirror" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4. Mirror as sliders (run)" "_tombstone" false "frame" #afield/rect [60.0 220.0 380.0 70.0] "autorun" false "code" #afield/file-inline {"path" "oscq-mirror_code_.kt" "inline" "import afield.io.osc.query.*\n\n// A slider or checkbox for every number and boolean the remote publishes. Moving one sets the\n// remote; when the remote moves (box 5 animates /demo/lfo), the slider follows over LISTEN.\nval remote = oscQueryRemote(\"127.0.0.1\", 9020).refresh()\noscQueryMirror(remote, \"mirror\") { it.path.startsWith(\"/demo\") }\n"}}} {"id" "oscq-controls" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2. Field controls, published (run)" "_tombstone" false "frame" #afield/rect [520.0 60.0 380.0 70.0] "autorun" false "code" #afield/file-inline {"path" "oscq-controls_code_.kt" "inline" "import afield.io.osc.query.*\n\n// Field controls that are also OSCQuery parameters, under /surface. Drag them here and every\n// listening remote sees the change; set them from a remote and the Field control moves.\nvar gain = 0.5\nvar mute = false\noscQuery(\"Field demo\").controls(\"/surface\") {\n    slider(\"gain\", 0.0, 1.0, initialValue = gain) { gain = it }\n    checkbox(\"mute\", mute) { mute = it }\n}\n"}}} {"id" "oscq-remote" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3. Read it back as a remote (run)" "_tombstone" false "frame" #afield/rect [980.0 60.0 380.0 70.0] "autorun" false "code" #afield/file-inline {"path" "oscq-remote_code_.kt" "inline" "import afield.io.osc.query.*\n\n// The other direction: read an OSCQuery service as a remote. Here it is this Field's own,\n// so run box 1 first; point it at TouchDesigner or Chataigne by changing the host and port.\nval remote = oscQueryRemote(\"127.0.0.1\", 9020).refresh()\nremote[\"/demo/cutoff\"].set(2500.0) // sent as OSC over UDP to the service's OSC_PORT\nremote[\"/demo/scene\"].set(\"night\")\n\nmarkdown(\n    \"**${remote.name}** — OSC on port ${remote.oscPort}, LISTEN: ${remote.supportsListen}\\n\\n\" +\n        remote.params.joinToString(\"\\n\") { \"- `${it.path}` ${it.type} ${it.range} ${it.description ?: \"\"}\" },\n)\n"}}} {"id" "oscq-lfo" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5. Animate /demo/lfo (launch)" "_tombstone" false "frame" #afield/rect [520.0 220.0 380.0 70.0] "autorun" false "code" #afield/file-inline {"path" "oscq-lfo_code_.kt" "inline" "import afield.io.osc.query.*\n\n// A value Field changes by itself: every listener (box 4's slider, TouchDesigner) follows it.\nval q = oscQuery(\"Field demo\")\nval lfo = q.float(\"/demo/lfo\", 0.0..1.0, 0.5, \"a slow sine, written by Field\", access = OscAccess.READ)\nval start = AnimationClock.nowSeconds()\nloop {\n    lfo.set(0.5 + 0.5 * sin(AnimationClock.nowSeconds() - start))\n    delay(50)\n}\n"}}} {"id" "oscq-publish" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1. Publish parameters (run first)" "_tombstone" false "frame" #afield/rect [60.0 60.0 380.0 70.0] "autorun" false "code" #afield/file-inline {"path" "oscq-publish_code_.kt" "inline" "import afield.io.osc.query.*\n\n/*\nPublish four parameters as an OSCQuery service on http port 9020 (OSC UDP on 9021),\nadvertised over DNS-SD so TouchDesigner, Max, Chataigne and VDMX list it as \"Field demo\".\nThe callbacks run here, on Field's main loop, whenever one of them sets a value.\n*/\nval q = oscQuery(\"Field demo\")\nq.describe(\"/demo\", \"parameters published by the OSCQuery demo document\")\n\nfun show() = markdown(\n    \"values\",\n    q.server.all.values\n        .sortedBy { it.path }\n        .joinToString(\"\\n\") { \"- `${it.path}` (${it.type}) = **${it.value.joinToString(\", \")}**\" },\n)\n\nq.float(\"/demo/cutoff\", 20.0..20000.0, 1000.0, \"filter cutoff in Hz\") { show() }\nq.bool(\"/demo/on\", true, \"sound on\") { show() }\nq.menu(\"/demo/scene\", [\"dawn\", \"dusk\", \"night\"], \"dusk\") { show() }\nq.vector(\"/demo/xy\", [0.5, 0.5], description = \"a point on a pad\") { show() }\n\nshow()\nmarkdown(\"Browse **http://localhost:${q.httpPort}/** for the namespace, or **?HOST_INFO** for the service.\")\n"}}} {"id" "oscq-discover" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "6. Discover on the network (run)" "_tombstone" false "frame" #afield/rect [980.0 220.0 380.0 70.0] "autorun" false "code" #afield/file-inline {"path" "oscq-discover_code_.kt" "inline" "import afield.io.osc.query.*\n\n// OSCQuery services announcing themselves on this network (DNS-SD _oscjson._tcp), this Field's\n// included once box 1 has run. Each one can be opened with oscQueryRemote(address, port).\nval found = oscQueryDiscover(2000)\nmarkdown(\n    if (found.isEmpty()) \"No OSCQuery services answered.\"\n    else found.joinToString(\"\\n\") { \"- **${it.instance}** at `${it.address}:${it.port}`\" },\n)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}