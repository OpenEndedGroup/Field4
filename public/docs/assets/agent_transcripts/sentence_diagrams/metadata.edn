{"version" 2 "boxes" [{"id" "sentence_both" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 · A sentence, two structures" "_tombstone" false "frame" #afield/rect [0.0 0.0 450.0 100.0] "code" #afield/file-inline {"path" "sentence_both_code_.kt" "inline" "import afield.graphics.text.sentences.*\n\nval d = SentenceDiagram().use(Sentences.example(2))\nd.wordFont = font(\"Serif\", 30.0)\nd.heights = Heights.Flat()\nd.wordGap = 50.0\nd.layerGap = 50.0\nd.tagFontSize = 12.0\nd.labelFontSize = 11.0\n// Constituents above, collapsed dependencies below; both share the same token row.\nval svg = d.svg()\n\nval figureId = \"sentence-figure-${thisBox.id}\"\ndisplay(\n    \"diagram\",\n    \"\"\"\n    <div id=\"$figureId\" style=\"width:760px;background:#f4f0e6;padding:24px;box-sizing:border-box\">\n    <style>#$figureId svg { width:100%; height:auto; display:block; }</style>\n    $svg\n    </div>\n    <script>\n    (() => {\n        const svg = document.getElementById(\"$figureId\")?.querySelector(\"svg\");\n        if (svg) svg.setAttribute(\"viewBox\", \"0 0 \" + svg.getAttribute(\"width\") + \" \" + svg.getAttribute(\"height\"));\n    })();\n    </script>\n\"\"\",\n)\ndisplayOpen(\"diagram\")\n"}}} {"id" "sentence_undertow" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 · Dependency arcs and decorations" "_tombstone" false "frame" #afield/rect [1800.0 0.0 450.0 100.0] "code" #afield/file-inline {"path" "sentence_undertow_code_.kt" "inline" "import afield.graphics.text.sentences.*\n\nval d = SentenceDiagram().use(Sentences.example(3))\nd.wordFont = font(\"Serif\", 32.0)\nd.heights = Heights.Wandering(seed = 17, amplitude = 20.0)\nd.wordGap = 48.0\nd.labelFontSize = 11.0\nd.arcSpanRatio = .43\nval marks = decorations {\n    arc { dot(it.pointAt(.5), 3.0).also { f -> f.color = vec(.7, .3, .1, 1) } }\n    underline { ring(it.left, 3.0).also { f -> f.color = vec(.7, .3, .1, 1) } }\n}\nval f = d.flines(decorate = marks)\nval undertow = f.copy(\n    treeEdges = emptyList(),\n    wordEdges = emptyList(),\n    texts = f.texts.filter { it.kind != TextKind.TAG },\n)\nval svg = afield.ui.visualization.drawToSVG(undertow.everything(style = DiagramStyle.onWhite), -1.0, -1.0)\n\nval figureId = \"sentence-figure-${thisBox.id}\"\ndisplay(\n    \"diagram\",\n    \"\"\"\n    <div id=\"$figureId\" style=\"width:760px;background:#f4f0e6;padding:24px;box-sizing:border-box\">\n    <style>#$figureId svg { width:100%; height:auto; display:block; }</style>\n    $svg\n    </div>\n    <script>\n    (() => {\n        const svg = document.getElementById(\"$figureId\")?.querySelector(\"svg\");\n        if (svg) svg.setAttribute(\"viewBox\", \"0 0 \" + svg.getAttribute(\"width\") + \" \" + svg.getAttribute(\"height\"));\n    })();\n    </script>\n\"\"\",\n)\ndisplayOpen(\"diagram\")\n"}}} {"id" "sentence_canopy" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 · The constituency canopy" "_tombstone" false "frame" #afield/rect [900.0 0.0 450.0 100.0] "code" #afield/file-inline {"path" "sentence_canopy_code_.kt" "inline" "import afield.graphics.text.sentences.*\n\nval d = SentenceDiagram().use(Sentences.example(2))\nd.wordFont = font(\"Serif\", 32.0)\nd.heights = Heights.ByTreeDepth(jitter = 0.0)\nd.layerGap = 55.0\nd.wordGap = 36.0\nd.tagFontSize = 13.0\nval marks = decorations {\n    node { if (!it.node.leaf) ring(it.position, 3.5).also { f -> f.color = vec(.7, .3, .1, 1) } else null }\n}\nval f = d.flines(decorate = marks)\nval canopy = f.copy(arcs = emptyList(), texts = f.texts.filter { it.kind != TextKind.RELATION })\nval svg = afield.ui.visualization.drawToSVG(canopy.everything(style = DiagramStyle.onWhite), -1.0, -1.0)\n\nval figureId = \"sentence-figure-${thisBox.id}\"\ndisplay(\n    \"diagram\",\n    \"\"\"\n    <div id=\"$figureId\" style=\"width:760px;background:#f4f0e6;padding:24px;box-sizing:border-box\">\n    <style>#$figureId svg { width:100%; height:auto; display:block; }</style>\n    $svg\n    </div>\n    <script>\n    (() => {\n        const svg = document.getElementById(\"$figureId\")?.querySelector(\"svg\");\n        if (svg) svg.setAttribute(\"viewBox\", \"0 0 \" + svg.getAttribute(\"width\") + \" \" + svg.getAttribute(\"height\"));\n    })();\n    </script>\n\"\"\",\n)\ndisplayOpen(\"diagram\")\n"}}} {"id" "sentence_furniture" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 · Reed-Kellogg sentence furniture" "_tombstone" false "frame" #afield/rect [2700.0 0.0 450.0 100.0] "code" #afield/file-inline {"path" "sentence_furniture_code_.kt" "inline" "import afield.graphics.text.sentences.*\n\nval d = SentenceDiagram().use(Sentences.example(4))\nd.wordFont = font(\"Serif\", 32.0)\n// Here grammar places words on shelves/slants; it is a different layout, not a style on the arc tree.\nval config = KelloggConfig(\n    slantAngle = 30.0,\n    nestAngleStep = 10.0,\n    maxSlantAngle = 48.0,\n    fontSize = 32.0,\n    metrics = Java2DMetrics(d.wordFont!!),\n    modifierSize = 23.0,\n    modifierMetrics = Java2DMetrics(d.wordFont!!.deriveFont(23f)),\n)\nval svg = d.kelloggSvg(kelloggConfig = config)\n\nval figureId = \"sentence-figure-${thisBox.id}\"\ndisplay(\n    \"diagram\",\n    \"\"\"\n    <div id=\"$figureId\" style=\"width:760px;background:#f4f0e6;padding:24px;box-sizing:border-box\">\n    <style>#$figureId svg { width:100%; height:auto; display:block; }</style>\n    $svg\n    </div>\n    <script>\n    (() => {\n        const svg = document.getElementById(\"$figureId\")?.querySelector(\"svg\");\n        if (svg) svg.setAttribute(\"viewBox\", \"0 0 \" + svg.getAttribute(\"width\") + \" \" + svg.getAttribute(\"height\"));\n    })();\n    </script>\n\"\"\",\n)\ndisplayOpen(\"diagram\")\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}