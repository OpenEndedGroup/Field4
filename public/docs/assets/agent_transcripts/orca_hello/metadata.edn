{"version" 2 "boxes" [{"id" "orca_hello" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "ORCA · run me" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 60.0] "code" #afield/file-inline {"path" "orca_hello_code_.kt" "inline" "// Click the grid to type into ORCA. Space plays and pauses; Cmd-G shows every operator.\nval synth = PatSynthBank()\nval o = orca(rows = 12, grid = \"\"\"\n    #.ORCA.IN.FIELD.#\n    .\n    .2C8\n    D2.8TCDEGAGED\n    .:04\n    .\n    D8\n    .:12C\n\"\"\")\no.onNote {\n    synth.play(it)\n    markdown(\"heard\", \"`${it.note}${it.octave}` on channel ${it.channel}, MIDI ${it.midi}\")\n}\ndisplayOpen(\"heard\")\n// Ask AI4 (Cmd-4) to change the tune: it can read, write and command this ORCA.\no.exposeTools()\nsynth\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory"]}