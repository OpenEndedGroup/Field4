{"version" 2 "boxes" [{"id" "tetra" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "tetra — start here" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 100.0] "code" #afield/file-inline {"path" "tetra_code_.kt" "inline" "// Four pictures, embedded by CLIP, drawn as the one tetrahedron whose six edges are\n// their six distances.\n//\n// CLIP turns each picture into 512 numbers: a point in a 512-dimensional space where\n// pictures of similar things land close together. Any four points of such a space fit\n// exactly in three dimensions, so this tetrahedron loses nothing: its edges ARE the\n// distances. Drop your own pictures on the slots, or drag one up from the tray.\nval inputs = mediaSlots {\n    image(\"public/docs/assets/madp_tetra/tabby_cat.jpg\")\n    image(\"public/docs/assets/madp_tetra/labrador.jpg\")\n    image(\"public/docs/assets/madp_tetra/tiger.jpg\")\n    image(\"public/docs/assets/madp_tetra/toyota_sports_800.jpg\")\n    tray(\"public/docs/assets/madp_tetra\")\n}\nval view = simplexView()\n\n// Runs now, and again whenever a slot changes.\ninputs.onChange { slots ->\n    view.dim(\"processing current embeddings\")\n    val vectors = slots.map { it.clip() }        // one unit-length 512-vector per slot\n    val simplex = embeddingSimplex(vectors, slots.map { it.label })\n    view.show(simplex, colors = slots.map { it.color })\n}\n"}}} {"id" "tetra2" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "tetra2 — three pictures and a sentence" "_tombstone" false "frame" #afield/rect [1100.0 80.0 300.0 100.0] "code" #afield/file-inline {"path" "tetra2_code_.kt" "inline" "// Three pictures and a sentence, in the one space CLIP puts both in.\n//\n// The sentence sits far from every picture, even the one it describes: CLIP's pictures\n// and its sentences occupy different regions of the space (the \"modality gap\"). The\n// diamonds rank each point's three edges: green the closest, orange, red the furthest.\n// Which picture is the sentence closest to? Type something else and see.\nval inputs = mediaSlots {\n    image(\"public/docs/assets/madp_tetra/tabby_cat.jpg\")\n    image(\"public/docs/assets/madp_tetra/labrador.jpg\")\n    image(\"public/docs/assets/madp_tetra/tiger.jpg\")\n    text(\"a photo of a cat\")\n    tray(\"public/docs/assets/madp_tetra\")\n}\nval view = simplexView()\n\ninputs.onChange { slots ->\n    view.dim(\"processing current embeddings\")\n    val vectors = slots.map { it.clip() }        // pictures and text, one space\n    val simplex = embeddingSimplex(vectors, slots.map { it.label })\n    view.show(simplex, colors = slots.map { it.color }, flags = true)\n}\n"}}} {"id" "swap_one_picture" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "swap one picture" "_tombstone" false "frame" #afield/rect [80.0 1250.0 300.0 100.0] "code" #afield/file-inline {"path" "swap_one_picture_code_.kt" "inline" "// tetra with one picture swapped: the car is now a wolf.\n//\n// Compare the shape with tetra's. There, the car's three edges were the three longest:\n// its point stood off on its own. Four animals make a nearly even tetrahedron, every\n// edge within a fifth of the others. Drag the bicycle from the tray onto slot 4 and see\n// where it lands.\nval inputs = mediaSlots {\n    image(\"public/docs/assets/madp_tetra/tabby_cat.jpg\")\n    image(\"public/docs/assets/madp_tetra/labrador.jpg\")\n    image(\"public/docs/assets/madp_tetra/tiger.jpg\")\n    image(\"public/docs/assets/madp_tetra/grey_wolf.jpg\")\n    tray(\"public/docs/assets/madp_tetra\")\n}\nval view = simplexView()\n\ninputs.onChange { slots ->\n    view.dim(\"processing current embeddings\")\n    val simplex = embeddingSimplex(slots.map { it.clip() }, slots.map { it.label })\n    view.show(simplex, colors = slots.map { it.color })\n}\n"}}} {"id" "five_points" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "five points do not fit" "_tombstone" false "frame" #afield/rect [1100.0 1250.0 300.0 100.0] "code" #afield/file-inline {"path" "five_points_code_.kt" "inline" "// Five points do not fit in three dimensions.\n//\n// Four points always sit exactly in 3D; five in general need four. The picture is now\n// classical MDS's best 3D fit, its drawn edges no longer quite the distances in the\n// table, and the note under it gives the stress: how far the fit is off, 0 being exact.\nval inputs = mediaSlots {\n    image(\"public/docs/assets/madp_tetra/tabby_cat.jpg\")\n    image(\"public/docs/assets/madp_tetra/labrador.jpg\")\n    image(\"public/docs/assets/madp_tetra/tiger.jpg\")\n    image(\"public/docs/assets/madp_tetra/grey_wolf.jpg\")\n    image(\"public/docs/assets/madp_tetra/toyota_sports_800.jpg\")\n    tray(\"public/docs/assets/madp_tetra\")\n}\nval view = simplexView()\n\ninputs.onChange { slots ->\n    view.dim(\"processing current embeddings\")\n    val simplex = embeddingSimplex(slots.map { it.clip() }, slots.map { it.label })\n    view.show(simplex, colors = slots.map { it.color })\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}