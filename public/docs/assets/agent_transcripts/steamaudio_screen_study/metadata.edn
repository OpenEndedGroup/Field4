{"version" 2 "boxes" [{"id" "steam_screen" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "A screen between source and listener" "_tombstone" false "frame" #afield/rect [80.0 80.0 370.0 100.0] "code" #afield/file-inline {"path" "steam_screen_code_.kt" "inline" "import afield.audio.spatial.steamaudio.Material\nimport afield.examples.steamaudio.SteamAudioScreenStudy\nimport afield.ui.visualization.AudioVisualizerOptions\nimport afield.ui.visualization.LinesFraming\nimport afield.ui.visualization.displayAudioBytes\nimport java.util.Locale\n\nval scene = SteamAudioScreenStudy\nval listener = scene.listenerPosition\nval source = scene.sourcePosition\nval material = Material.WOOD\nval metre = 80.0\nval player = AudioVisualizerOptions(width = 500, waveformHeight = 65)\n\nfun draw(offset: Float) {\n    val take = scene.render(offset, material)\n    val centre = (listener.x + source.x) / 2f + offset\n    val z = scene.SCREEN_DEPTH * metre\n    val transmission = take.transmission.joinToString(\" / \") { \"%.3f\".format(Locale.ROOT, it) }\n    val ray = fline {\n        moveTo(listener.x * metre, listener.z * metre)\n        lineTo(source.x * metre, source.z * metre)\n        color = if (take.occlusion > 0.5f) vec(0.32, 0.82, 0.75, 1.0) else vec(0.93, 0.64, 0.30, 1.0)\n        thickness = 2.0\n    }\n    val screen = fline {\n        moveTo((centre - scene.SCREEN_HALF_WIDTH) * metre, z)\n        lineTo((centre + scene.SCREEN_HALF_WIDTH) * metre, z)\n        color = vec(0.68, 0.73, 0.84, 1.0)\n        thickness = 7.0\n    }\n    val markers =\n        [listener, source].map { point ->\n            fline {\n                circle(point.x * metre, point.z * metre, 7.0)\n                filled = true\n                color = vec(0.83, 0.90, 1.0, 1.0)\n            }\n        }\n    lines(\n        [ray, screen] + markers,\n        w = 420.0,\n        h = 245.0,\n        fitToSize = true,\n        framing = LinesFraming.Fixed(-220.0, -265.0, 575.0, 290.0),\n    )\n    val visibility = \"%.2f\".format(Locale.ROOT, take.occlusion)\n    markdown(\"direct path\", \"**Occlusion $visibility** · transmission low / mid / high: $transmission\", width = 500)\n    displayAudioBytes(take.wav(), channel = \"screen take\", label = \"Current screen position\", options = player)\n    println(\"Screen take ready: occlusion $visibility\")\n}\n\ndisplayAudioBytes(\n    scene.render(scene.CLEAR_OFFSET, material).wav(),\n    channel = \"clear reference\",\n    label = \"Clear path\",\n    options = player,\n)\nslider(\"Screen offset (m)\", min = -2.4, max = 2.4, step = 0.05, initialValue = 0.0) {\n    draw(it.toFloat())\n}\ndraw(0f)\ndisplayOpen(\"controls\")\ndisplayOpen(\"lines\")\ndisplayClose(\"clear reference\")\ndisplayClose(\"screen take\")\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}