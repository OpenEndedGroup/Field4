{"version" 2 "boxes" [{"id" "ffr_every_renderer" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "one fill rule, every renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 320.0 100.0] "code" #afield/file-inline {"path" "ffr_every_renderer_code_.kt" "inline" "import afield.graphics.nile.*\n\n// A pentagram crosses itself (winding 2 in its centre); the squares nest, wound the same way.\nfun shape(dx: Double, rule: FillRule): FLine {\n    val f = FLine()\n    for (k in 0..5) {\n        val a = Math.PI * (-0.5 + 0.8 * k)\n        val x = dx + 45 + 38 * Math.cos(a)\n        val y = 50 + 38 * Math.sin(a)\n        if (k == 0) f.moveTo(x, y) else f.lineTo(x, y)\n    }\n    f.close()\n    f.moveTo(dx + 100, 15).lineTo(dx + 170, 15).lineTo(dx + 170, 85).lineTo(dx + 100, 85).close()\n    f.moveTo(dx + 118, 33).lineTo(dx + 152, 33).lineTo(dx + 152, 67).lineTo(dx + 118, 67).close()\n    f.filled = true\n    f.stroked = false\n    f.color = vec(0.25, 0.55, 0.95, 1.0)\n    f.fillRule = rule\n    return f\n}\n\nval nonZero = shape(0.0, FillRule.NON_ZERO)\nval evenOdd = shape(190.0, FillRule.EVEN_ODD)\n\n// Field's own line renderer: the left pair non-zero, the right pair even-odd.\nlines([nonZero, evenOdd], w = 380.0, h = 100.0, channel = \"field\")\n\n// Gezira's winding rasteriser reads the same attribute.\nval g = GeziraFLine.render([nonZero, evenOdd], 380, 100)\ndisplay(\"gezira\", GeziraSvg.png(g.canvas.rgba, 380, 100))\n\n// The triangles the Vulkan fill is made of, drawn as outlines.\nval triangles = FLine()\nfor (f in [nonZero, evenOdd]) f.tessellate { v, idx ->\n    for (t in idx.indices step 3) {\n        val (a, b, c) = Triple(idx[t], idx[t + 1], idx[t + 2])\n        triangles.moveTo(v[3 * a], v[3 * a + 1]).lineTo(v[3 * b], v[3 * b + 1]).lineTo(v[3 * c], v[3 * c + 1]).close()\n    }\n}\ntriangles.color = vec(0.95, 0.6, 0.2, 1.0)\nlines([triangles], w = 380.0, h = 100.0, channel = \"triangles\")\n\nfor ((name, f) in [\"non-zero\" to nonZero, \"even-odd\" to evenOdd]) {\n    val dx = if (f === nonZero) 0f else 190f\n    println(\n        \"$name: contains2D star centre ${f.contains2D(Vec2(dx + 45f, 50f))}, inner square ${f.contains2D(Vec2(dx + 135f, 50f))}\",\n    )\n}\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}