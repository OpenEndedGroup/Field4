{"version" 2 "boxes" [{"id" "viz_signed" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "signed dx — diverging, zero fixed" "_tombstone" false "frame" #afield/rect [430.0 60.0 240.0 50.0] "code" #afield/file-inline {"path" "viz_signed_code_.kt" "inline" "// sobel().dx is two-signed: positive on a dark->bright edge, negative on bright->dark.\n// A min..max normalisation puts zero at an arbitrary grey; the diverging policy pins it.\nval src = Img.generate(240, 180) { x, y ->\n    if (x in 30..90 && y in 26..76) 0.9f\n    else if (hypot(x - 172.0, y - 62.0) <= 30.0) 0.7f\n    else 0.15f + 0.1f * (y / 179f)\n}\nsrc.sobel().dx\n"}}} {"id" "viz_gradient" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Gradient — dx, dy, magnitude, direction" "_tombstone" false "frame" #afield/rect [430.0 400.0 270.0 50.0] "code" #afield/file-inline {"path" "viz_gradient_code_.kt" "inline" "val src = Img.generate(240, 180) { x, y ->\n    if (x in 30..90 && y in 26..76) 0.9f\n    else if (hypot(x - 172.0, y - 62.0) <= 30.0) 0.7f\n    else 0.15f + 0.1f * (y / 179f)\n}\nsrc.sobel()\n"}}} {"id" "viz_flow" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "FlowField — quiver, failures included" "_tombstone" false "frame" #afield/rect [800.0 740.0 260.0 50.0] "code" #afield/file-inline {"path" "viz_flow_code_.kt" "inline" "// The second frame is the first rotated 0.06 rad about its centre, so the arrows should\n// trace a rotation field: little motion near the middle, tangential motion at the edges.\nval a = Img.generateRGB(240, 180) { x, y ->\n    val chk = if (x in 24..200 && y in 20..160 && ((x / 8 + y / 8) % 2 == 0)) 1f else 0f\n    Triple(0.15f + 0.7f * chk, 0.18f + 0.5f * chk, 0.30f + 0.4f * chk)\n}.luma()\nval b = a.rotate(0.06)\nopticalFlowLK(a, b, a.goodFeaturesToTrack(maxCount = 80, minDistance = 12).map { it.toVec2() }, levels = 3)\n"}}} {"id" "viz_corners" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "List<Corner> — scatter by strength" "_tombstone" false "frame" #afield/rect [60.0 740.0 240.0 50.0] "code" #afield/file-inline {"path" "viz_corners_code_.kt" "inline" "// The rectangle is x 30..90, y 26..76, so the four strongest corners should read back as\n// (30, 26), (89, 26), (30, 75), (89, 75) — check the disclosure against those numbers.\nval src = Img.generate(240, 180) { x, y ->\n    if (x in 30..90 && y in 26..76) 0.9f\n    else if (x in 150..152 || y in 140..142) 0.98f\n    else 0.15f\n}\nsrc.harrisCorners(minDistance = 8, maxCount = 40)\n"}}} {"id" "viz_pyramid" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "GaussianPyramid — rungs at true scale" "_tombstone" false "frame" #afield/rect [800.0 400.0 260.0 50.0] "code" #afield/file-inline {"path" "viz_pyramid_code_.kt" "inline" "// Each rung is drawn at its real fraction of the base resolution, bottom-aligned, so the\n// halving is the visible fact rather than a number in a caption.\nImg.generateRGB(240, 180) { x, y ->\n    val disc = if (hypot(x - 172.0, y - 62.0) <= 30.0) 1f else 0f\n    val rect = if (x in 30..90 && y in 26..76) 1f else 0f\n    Triple(\n        (0.10f + 0.30f * (x / 239f) + 0.8f * rect).coerceIn(0f, 1f),\n        (0.12f + 0.22f * (y / 179f) + 0.7f * rect + 0.6f * disc).coerceIn(0f, 1f),\n        (0.34f - 0.20f * (x / 239f) + 0.8f * disc).coerceIn(0f, 1f)\n    )\n}.gaussianPyramid(5)\n"}}} {"id" "viz_autoranged" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "auto-ranged — the true range printed" "_tombstone" false "frame" #afield/rect [800.0 60.0 250.0 50.0] "code" #afield/file-inline {"path" "viz_autoranged_code_.kt" "inline" "// Edge magnitude x25 lands far outside 0..1. Clamping would show a flat white rectangle;\n// the visualizer rescales for display and prints the range it rescaled from.\nval src = Img.generate(240, 180) { x, y ->\n    if (x in 30..90 && y in 26..76) 0.9f\n    else if (hypot(x - 172.0, y - 62.0) <= 30.0) 0.7f\n    else 0.15f\n}\nsrc.sobelMagnitude() * 25f\n"}}} {"id" "viz_scene" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Img — thumbnail, channels, histogram" "_tombstone" false "frame" #afield/rect [60.0 60.0 250.0 50.0] "code" #afield/file-inline {"path" "viz_scene_code_.kt" "inline" "// A synthetic scene with something for every detector: a bright rectangle (corners), a\n// disc (a Hough circle), two rulings (Hough lines), a checker patch (flow texture).\n// The value of the box IS the image, so the inline visualizer is what you see below.\nImg.generateRGB(240, 180) { x, y ->\n    var r = 0.10f + 0.30f * (x / 239f)\n    var g = 0.12f + 0.22f * (y / 179f)\n    var b = 0.34f - 0.20f * (x / 239f)\n    if (x in 30..90 && y in 26..76) { r = 0.94f; g = 0.86f; b = 0.42f }\n    if (hypot(x - 172.0, y - 62.0) <= 30.0) { r = 0.30f; g = 0.80f; b = 0.92f }\n    if (x in 150..152 || y in 140..142) { r = 0.98f; g = 0.98f; b = 0.98f }\n    if (x in 24..104 && y in 104..164 && ((x / 8 + y / 8) % 2 == 0)) {\n        r = 0.88f; g = 0.30f; b = 0.55f\n    }\n    Triple(r, g, b)\n}\n"}}} {"id" "viz_components" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "ComponentLabelling — one hue per blob" "_tombstone" false "frame" #afield/rect [60.0 1080.0 260.0 50.0] "code" #afield/file-inline {"path" "viz_components_code_.kt" "inline" "// Adjacent label ids get unrelated hues (golden-ratio rotation), which is what makes two\n// touching blobs distinguishable at thumbnail size.\nImg.generate(240, 180) { x, y ->\n    val a = x in 20..70 && y in 20..70\n    val b = hypot(x - 150.0, y - 50.0) <= 32.0\n    val c = x in 40..90 && y in 110..160\n    val d = x in 170..220 && y in 120..150\n    if (a || b || c || d) 1f else 0f\n}.connectedComponents()\n"}}} {"id" "viz_non_finite" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "NaN + infinity — counted and magenta" "_tombstone" false "frame" #afield/rect [60.0 400.0 250.0 50.0] "code" #afield/file-inline {"path" "viz_non_finite_code_.kt" "inline" "// Non-finite samples are excluded from the range and the statistics, and painted magenta.\n// The old behaviour: one NaN poisoned min()/max(), normalized() produced an all-NaN\n// image, the PNG quantiser turned NaN into 0, and the thumbnail went silently black.\nImg.generate(160, 120) { x, y ->\n    when {\n        x in 60..75 && y in 40..55 -> Float.NaN\n        x == 120 && y == 30 -> Float.POSITIVE_INFINITY\n        else -> (x + y) / 278f\n    }\n}\n"}}} {"id" "viz_hough" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "List<HoughLine> — geometry + accumulator" "_tombstone" false "frame" #afield/rect [430.0 740.0 280.0 50.0] "code" #afield/file-inline {"path" "viz_hough_code_.kt" "inline" "// Two rulings planted at x=151 and y=141; the peaks should come back as rho~149 theta=0\n// and rho~139 theta=pi/2. A HoughLine is infinite, so the left panel has to invent a\n// canvas — it says which one, and points at linesToFLines for the in-place version.\nval src = Img.generate(240, 180) { x, y ->\n    if (x in 150..152 || y in 140..142) 0.98f\n    else if (x in 30..90 && y in 26..76) 0.9f\n    else 0.12f\n}\nhoughLines(src.canny(0.10, 0.25), maxLines = 8, threshold = 40)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory"]}