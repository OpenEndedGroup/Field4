{"version" 2 "boxes" [{"id" "agent_visionos_start" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "agent_visionos_start_root"} "name" "visionOS Starter" "_tombstone" false "frame" #afield/rect [90.0 150.0 300.0 100.0] "code" #afield/file-inline {"path" "agent_visionos_start_code_.kt" "inline" "// {{ visionmetal uniforms=phase,amount,tint }}\n// Open Live Metal in Field4Vision. Launch again after editing to hot-reload.\n// The shader lives in this box's `msl` property — edit it and press alt-r to\n// recompile on the headset without restarting any of this.\nonStart {\n    // Geometry is built here, in the headset, and handed to Metal in one call.\n    geometry {\n        color(1.0, 0.35, 0.15)\n        cube(0.18, cx = 0.45, cz = -1.2, tintFaces = true)\n    }\n\n    uniform(\"amount\", 0.025)\n    uniform(\"tint\", 0.1, 0.8, 1.0, 0.35)\n\n    onFrame { frame ->\n        uniform(\"phase\", frame.time * 3.0)\n    }\n\n    onStop {\n        println(\"visionOS starter stopped\")\n    }\n\n    println(\"visionOS starter running\")\n}\n"} "msl" #afield/file-inline {"path" "agent_visionos_start_msl_.metal" "inline" "// Uniforms are read by name: the head generates `#define u_phase frame.user[0]`\n// and so on from the `uniforms=` list on the marker in the code property.\nvertex FieldVarying field_vertex(\n    uint vertexID [[vertex_id]], ushort viewID [[amplification_id]],\n    const device FieldVertex *vertices [[buffer(0)]],\n    constant FieldFrame &frame [[buffer(1)]])\n{\n    FieldVertex v = vertices[vertexID];\n    float phase = u_phase.x;\n    float amount = u_amount.x;\n    float3 centre = float3(0.45, 0.0, -1.2);\n    float3 p = v.position.xyz\n        + v.normal.xyz * sin(phase + v.position.y * 18.0) * amount\n        - centre;\n    float3 n = v.normal.xyz;\n\n    float angle = phase * 0.18 + 0.55;\n    float c = cos(angle), s = sin(angle);\n    p.xz = float2(c * p.x + s * p.z, -s * p.x + c * p.z);\n    n.xz = float2(c * n.x + s * n.z, -s * n.x + c * n.z);\n\n    float4 world = frame.modelMatrix * float4(p + centre, 1.0);\n    FieldVarying out;\n    out.position = frame.viewProjection[min(uint(viewID), 1u)] * world;\n    out.worldPosition = world.xyz;\n    out.normal = n;\n    out.color = v.color;\n    out.uv = v.uv.xy;\n    return out;\n}\n\nfragment half4 field_fragment(\n    FieldVarying in [[stage_in]],\n    constant FieldFrame &frame [[buffer(1)]])\n{\n    float3 rgb = mix(in.color.rgb, u_tint.rgb, u_tint.a);\n    return half4(half3(rgb), half(in.color.a));\n}\n"}}} {"id" "agent_visionos_start_root" "properties" {"children" #{#afield/box "agent_visionos_start"} "parents" #{#afield/box "root"} "name" "KotlinJS → visionOS" "_tombstone" false "frame" #afield/rect [50.0 50.0 300.0 100.0] "mainLanguage" "kotlinjs" "isKotlinJsRoot" true}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "mainLanguage" "isKotlinJsRoot"]}