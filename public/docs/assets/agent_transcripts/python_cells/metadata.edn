{"version" 2 "boxes" [{"id" "python_plotly" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "python_root"} "name" "fig.show() lands in the box" "_tombstone" false "frame" #afield/rect [60.0 4040.0 340.0 100.0] "code_language" "Python" "code" #afield/file-inline {"path" "python_plotly_code_.kt" "inline" "# plotly's default renderer starts a one-shot local server and asks the OS to open a\n# browser. Field intercepts that and embeds the page in this box's \"browser\" channel.\nimport numpy as np\nimport plotly.graph_objects as go\n\nt = np.linspace(0, 4 * np.pi, 400)\nfig = go.Figure(go.Scatter(x=t, y=np.sin(t) * np.exp(-t / 10), mode=\"lines\"))\nfig.update_layout(template=\"plotly_dark\", margin=dict(l=55, r=20, t=25, b=40))\nfig.show()\n"}}} {"id" "python_hello" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "python_root"} "name" "print, inline and in a block" "_tombstone" false "frame" #afield/rect [60.0 1040.0 340.0 100.0] "code_language" "Python" "code" #afield/file-inline {"path" "python_hello_code_.kt" "inline" "# A single-line print appears inline, beside the line that made it.\nimport platform\nimport numpy as np\n\nprint(\"python\", platform.python_version())\n\n# A multi-line one gets a block of its own, and keeps its columns.\na = np.arange(12).reshape(3, 4)\nprint(a)\n"}}} {"id" "python_interop" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "python_root"} "name" "the JVM is importable" "_tombstone" false "frame" #afield/rect [60.0 3040.0 340.0 100.0] "code_language" "Python" "code" #afield/file-inline {"path" "python_interop_code_.kt" "inline" "# JEP embeds CPython *in-process*, so java.lang -- and anything else on Field's\n# classpath -- is just another module, and this cell can reach its own Box.\nfrom java.lang import System\nfrom afield.python import PythonInterface\n\nbox = PythonInterface.thisBox\n\nprint(\"\\n\".join([\n    f\"JVM       {System.getProperty('java.version')}\",\n    f\"this box  {box.getName()}\",\n]))\n"}}} {"id" "python_shared" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "python_root"} "name" "the namespace is shared with cell 1" "_tombstone" false "frame" #afield/rect [60.0 2040.0 340.0 100.0] "code_language" "Python" "code" #afield/file-inline {"path" "python_shared_code_.kt" "inline" "# There is one interpreter for the whole Field process, and one global namespace.\n# `a` was never defined here -- it is still bound from cell 1. Run cell 1 first.\nprint(\"a is still here:\", a.shape, a.sum())\n\n# Which also means state survives between runs of this cell.\ncounter = globals().get(\"counter\", 0) + 1\nprint(\"this cell has run\", counter, \"time(s)\")\n"}}} {"id" "python_root" "properties" {"children" #{#afield/box "python_hello" #afield/box "python_shared" #afield/box "python_interop" #afield/box "python_plotly"} "parents" #{#afield/box "root"} "name" "Python root -- children of this box run as Python" "_tombstone" false "frame" #afield/rect [60.0 40.0 340.0 100.0] "mainLanguage" "python" "isPythonRoot" true "code" #afield/file-inline {"path" "python_root_code_.kt" "inline" "// This box is the language ROOT, and is itself still Kotlin -- the toggle swaps the\n// execution on a root's CHILDREN, never on the root (LanguageRuntimeSupport.kt:56-69).\n// Its `mainLanguage` property is what makes the four boxes below Python.\nprintln(\"the root stays Kotlin\")\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "com