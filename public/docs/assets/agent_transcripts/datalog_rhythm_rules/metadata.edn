{"version" 2 "boxes" [{"id" "datalog_rhythm_why" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 · why" "_tombstone" false "frame" #afield/rect [60.0 390.0 300.0 100.0] "code" #afield/file-inline {"path" "datalog_rhythm_why_code_.kt" "inline" "val r = datalog(\n    \"\"\"\n    event(kick, 36, 100, T)  :- euc(T, 4, 16, 0).\n    event(snare, 38, 90, T)  :- within(T, 16, 64), every(T, 8, 4).\n    \"\"\",\n).rhythm()\nprintln(r.why(\"event(kick, 36, 100, 20)\")?.render() ?: \"no kick at 20\")\nprintln(\n    \"snare at step 4: \" +\n        (r.why(\"event(snare, 38, 90, 4)\")?.render() ?: \"did not play — within(T, 16, 64) starts at bar 1\"),\n)\n"}}} {"id" "datalog_rhythm_rules" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 · rules" "_tombstone" false "frame" #afield/rect [60.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "datalog_rhythm_rules_code_.kt" "inline" "val song = datalog(\n    \"\"\"\n    event(kick, 36, 100, T)  :- euc(T, 4, 16, 0).\n    event(snare, 38, 90, T)  :- within(T, 16, 64), every(T, 8, 4).\n    event(hh, 42, 45, T)     :- within(T, 32, 64), every(T, 2, 1).\n    event(lead, N, 80, T)    :- euc(T, 5, 16, 2), D = (T div 3) mod 5, scale(48, minor_pent, D, 1, N).\n    \"\"\",\n)\nval r = song.rhythm()\nval text = (0L until 4L).joinToString(\"\\n\\n\") { \"bar $it\\n\" + r.grid(it) }\nprintln(text)\ndisplay(\"grid\", \"<pre>$text</pre>\")\nshowPatAudio(r.pattern(), cycles = 4, cps = 0.5)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersecti