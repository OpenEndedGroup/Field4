{"version" 2 "boxes" [{"id" "tb_renderer" "properties" {"children" #{#afield/box "tb_compute"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 160.0 90.0] "code" #afield/file-inline {"path" "tb_renderer_code_.kt" "inline" "import afield.four.util.Options\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nOptions.profiling = false\nonce.renderer {\n    window = Window(\"Field three-box\")\n    Renderer(window)\n}\nprintln(\"renderer ready\")\nstart(renderer::run)\n"}}} {"id" "tb_draw" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "tb_compute"} "name" "draw particles" "_tombstone" false "frame" #afield/rect [440.0 40.0 160.0 90.0] "vertex" #afield/file-inline {"path" "tb_draw_vertex_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\nlayout(std430, buffer_reference) buffer inData { vec4 pos[]; };\nlayout(location = 0) out vec2 tc;\nlayout(push_constant) uniform push {\n    inData inData;\n    float aspectRatio;\n} pc;\nconst vec3[6] part = vec3[6](vec3(0,0,0),vec3(1,0,0),vec3(1,1,0),vec3(0,0,0),vec3(1,1,0),vec3(0,1,0));\nvoid main() {\n    float scale = 1.0 * pc.inData.pos[gl_VertexIndex/6].w;\n    vec3 p = (part[gl_VertexIndex%6]-vec3(0.5,0.5,0))*scale;\n    p.xy += pc.inData.pos[gl_VertexIndex/6].xy*10.0;\n    p.xy *= vec2(1/pc.aspectRatio, 1);\n    gl_Position = vec4(p*0.04, 1);\n    tc = part[gl_VertexIndex%6].xy;\n}\n"} "fragment" #afield/file-inline {"path" "tb_draw_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 0) in vec2 tc;\nvoid main() {\n    float d = max(0.0, 0.5-length(tc-vec2(0.5)));\n    float w = fwidth(d);\n    d = smoothstep(0.1, 0.1+w, d)*smoothstep(0.14+w, 0.14, d);\n    uFragColor = vec4(1.0, 0.8, 0.4, d*0.2);\n    if (d<0.01) discard;\n}\n"} "code" #afield/file-inline {"path" "tb_draw_code_.kt" "inline" "var module = moduleHere { primitiveType = triangles }\nvar m = Mesh()\nmodule += \"mesh\" to m\nrenderer += \"draw\" to module\nval N = 100000\nm.inData = { outputPositions }\nm.aspectRatio = { window.width/window.height.toFloat() }\nm.set(N*2*3, 0) {}\nprintln(\"draw launched\")\n"}}} {"id" "tb_compute" "properties" {"children" #{#afield/box "tb_draw"} "parents" #{#afield/box "root" #afield/box "tb_renderer"} "name" "compute particles" "_tombstone" false "frame" #afield/rect [240.0 40.0 160.0 90.0] "compute" #afield/file-inline {"path" "tb_compute_compute_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\nlayout(local_size_x = 64) in;\nlayout(std430, buffer_reference) buffer inData { vec4 a[]; };\nlayout(std430, buffer_reference) buffer outData { vec4 a[]; };\nlayout(push_constant) uniform dat {\n    inData inData;\n    outData outData;\n    float something;\n} pc;\n{% include \"fieldProbe\" %}\nvoid main() {\n    uint idx = gl_GlobalInvocationID.x;\n    pc.outData.a[idx].x = pc.inData.a[idx].x*cos(pc.something*pc.inData.a[idx].z) + pc.inData.a[idx].y*sin(pc.something*pc.inData.a[idx].w);\n    pc.outData.a[idx].y = -pc.inData.a[idx].x*sin(pc.something*pc.inData.a[idx].w) + pc.inData.a[idx].y*cos(pc.something*pc.inData.a[idx].z*0.03);\n    pc.outData.a[idx].zw = pc.inData.a[idx].zw;\n    vec2 delta = pc.outData.a[idx].xy - pc.inData.a[idx].xy;\n    fieldProbe(length(delta));\n}\n"} "code" #afield/file-inline {"path" "tb_compute_code_.kt" "inline" "var module = computeModuleHere {}\nvar m = ComputeMesh()\nmodule += \"step\" to m\nrenderer += \"compute\" to module\nval N = 100000\nvar inData = defaultBuffer { size = N.vec4s }.buffer\nvar outData = defaultBuffer { size = N.vec4s }.buffer\nm.inData = { inData }\nm.outData = { outData }\nvar x = 0.0\nm.something = { x += 0.01; x.f }\nfieldProbeHere(samples = 4096).display(\"probe\")\ndisplayOpen(\"probe\")   // mark the channel open so the card starts expanded when it arrives\nprop<FrameBufferGroup>(outputPositions) = outData\nm.x = N / 64; m.y = 1; m.z = 1\ninData.write { for (i in 0 until N) put(vec(Math.random(), Math.random(), Math.random(), Math.random())) }\nprintln(\"compute launched, N=\" + N)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory"]}