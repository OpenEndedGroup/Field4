{"version" 2 "boxes" [{"id" "orca_jam" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "ORCA jam · run me" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 60.0] "code" #afield/file-inline {"path" "orca_jam_code_.kt" "inline" "// Run this, open its AI Chat with Cmd-4 and ask it to play. AI4 writes into the grid while the\n// music runs; rewinding the chat puts the board back. Channels: 0 lead, 1 bass, 2 hat, 3 square.\nval synth = PatSynthBank(voices = 24)\nval o = orca(rows = 16, grid = \"\"\"\n    #.JAM.#\n    .\n    .4C4\n    D4.4TCEGE\n    .:03\n\"\"\")\no.onNote {\n    when (it.channel) {\n        0 -> synth.play(it, pan = 0.4, wave = PatWave.TRIANGLE)\n        1 -> synth.play(it, pan = 0.5, wave = PatWave.SINE)\n        2 -> synth.play(it, pan = 0.65, wave = PatWave.NOISE, gain = 0.3, cutoffHz = 9000.0)\n        else -> synth.play(it, pan = 0.6, wave = PatWave.SQUARE, gain = 0.4, cutoffHz = 3000.0)\n    }\n}\no.exposeTools(about = \"Channel 0 is a soft triangle lead, 1 a sine bass (octaves 2 and 3 suit it), \" +\n    \"2 a noise hi-hat (any note works), 3 a bright square for a second melody.\")\nsynth\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory"]}