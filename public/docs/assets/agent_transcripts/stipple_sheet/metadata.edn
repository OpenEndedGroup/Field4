{"version" 2 "boxes" [{"id" "stipple_sheet" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "stipple sheet" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 100.0] "code" #afield/file-inline {"path" "stipple_sheet_code_.kt" "inline" "// Run this in a Field box. The small portable model needs no Python at runtime.\nval field = loadStippleTransport(\"public/docs/assets/stipple_transport/two-images.json\")\nval canonical = field.sourceParticles(400, seed = 44)\nval lattice =\n    (0..6).flatMap { row ->\n        val v = -1.0 + row / 3.0\n        [\n            (0..24).map { vec(-1.0 + it / 12.0, v, 0.0) },\n            (0..24).map { vec(v, -1.0 + it / 12.0, 0.0) },\n        ]\n    }\nvar transportTime = 1.0\nvar movieTime = 0.5\nvar integrationSteps = 24\n\nfun drawSheet() {\n    // Always deform canonical coordinates, so particle i retains its identity.\n    val particles = field.transport(canonical, transportTime, movieTime, integrationSteps)\n    val dots = FLine()\n    particles.forEach { dots.moveTo(it * 180.0) }\n    dots.pointed = true\n    dots.pointSize = 2.5\n    dots.color = vec(0.45, 0.85, 0.8, 1.0)\n    val warped = lattice.map { row ->\n        val f = FLine()\n        f.breakNext()\n        field.transport(row, transportTime, movieTime, integrationSteps).forEach { p ->\n            f.lineTo(p * 180.0)\n        }\n        f.color = vec(0.55, 0.65, 0.8, 0.65)\n        f.thickness = 0.65\n        f\n    }\n    lines(warped + dots, w = 800.0, h = 540.0, fitToSize = true)\n    markdown(\n        \"times\",\n        \"transport time **$transportTime** · movie time **$movieTime** · $integrationSteps integration steps\",\n    )\n}\n\ncontrolGroup(\"transport plane\") {\n    // Experimental ranges remain accessible; extrapolation is not trained.\n    slider(\"transport time\", min = -0.25, max = 1.4, step = 0.025, initialValue = transportTime) {\n        transportTime = it\n        drawSheet()\n    }\n    slider(\"movie time\", min = -0.25, max = 1.25, step = 0.025, initialValue = movieTime) {\n        movieTime = it\n        drawSheet()\n    }\n    slider(\"integration steps\", min = 1.0, max = 64.0, step = 1.0, initialValue = integrationSteps.toDouble()) {\n        integrationSteps = it.toInt()\n        drawSheet()\n    }\n}\ndrawSheet()\nprintln(\"stipple sheet ready: ${field.parameterCount} parameters; independent transport/movie controls\")\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}