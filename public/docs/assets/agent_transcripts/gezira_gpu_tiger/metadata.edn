{"version" 2 "boxes" [{"id" "ggt_tiger" "properties" {"children" #{#afield/box "ggt_draw"} "parents" #{#afield/box "root" #afield/box "ggt_renderer"} "name" "tiger on the gpu" "_tombstone" false "frame" #afield/rect [40.0 200.0 340.0 100.0] "code" #afield/file-inline {"path" "ggt_tiger_code_.kt" "inline" "import afield.graphics.nile.*\nimport afield.graphics.vulkan.util.GpuProbe\n\nval N = 900\nval doc = GeziraSvg.parse(GeziraSvg.tiger())\n// Every fill and every stroke outline, in paint order, uploaded once.\nval fit = doc.fit(N, N)\nval probe = GpuProbe(renderer, \"gezira-gpu-tiger\")\nval scene = GeziraGpuScene.of(probe, doc.lines, N, N, fit)\n\nprop<FrameBufferGroup>(tigerImage) = scene.image\nprop<Int>(tigerSize) = N\nprintln(\"${scene.paths.size} paths, ${scene.curveCount} curves\")\n\n// Turn and breathe about the middle: only the six numbers of the transform change per frame.\nvar frames = 0\nvar last = System.nanoTime()\nloop {\n    val t = frames / 60.0\n    val zoom = 1.0 + 0.35 * Math.sin(t * 0.7)\n    val about =\n        SvgTransform.translate(N / 2.0, N / 2.0) *\n            SvgTransform.rotate(12.0 * Math.sin(t * 0.5)) *\n            SvgTransform.scale(zoom) *\n            SvgTransform.translate(-N / 2.0, -N / 2.0)\n    scene.transform = about * fit\n    frames++\n    if (frames % 120 == 0) {\n        val now = System.nanoTime()\n        display(\"rate\", \"%.1f ms a frame\".format((now - last) / 1e6 / 120))\n        last = now\n    }\n    frame()\n}\n    .end { probe.close() }\n"}}} {"id" "ggt_compare" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "ggt_renderer"} "name" "gpu beside cpu" "_tombstone" false "frame" #afield/rect [460.0 200.0 340.0 100.0] "code" #afield/file-inline {"path" "ggt_compare_code_.kt" "inline" "import afield.graphics.nile.*\nimport afield.graphics.vulkan.util.GpuProbe\n\nval n = 300\nval svg = GeziraSvg.tiger()\nval doc = GeziraSvg.parse(svg)\nval probe = GpuProbe(renderer, \"gezira-gpu-tiger-compare\")\nval scene = GeziraGpuScene.of(probe, doc.lines, n, n, doc.fit(n, n))\n\nframes {\n    try {\n        probe.arm(scene.image)\n        while (probe.stillWaiting()) frame()\n        // a written image is not a finished chain: let all five stages run whole\n        while (probe.stageList.any { !it.valid }) frame()\n        repeat(4) { frame() }\n        // the renderer runs on its own thread: hold the picture still before reading it\n        scene.hold = true\n        repeat(3) { frame() }\n        val gpu = scene.read()\n        scene.hold = false\n        val cpuStart = System.nanoTime()\n        val cpu = GeziraSvg.render(doc, n, n).canvas.rgba\n        val cpuMs = (System.nanoTime() - cpuStart) / 1e6\n        // Field's frames over a second, with this scene and the live tiger box both drawing.\n        val frameStart = System.nanoTime()\n        repeat(60) { frame() }\n        val frameMs = (System.nanoTime() - frameStart) / 1e6 / 60\n        var worst = 0.0\n        var sum = 0.0\n        for (i in gpu.indices) {\n            val d = Math.abs(gpu[i] - cpu[i]).toDouble()\n            worst = maxOf(worst, d)\n            sum += d\n        }\n        println(\"gpu vs cpu: largest %.4f, mean %.2e per channel\".format(worst, sum / gpu.size))\n        val diff = GeziraSvg.difference(gpu, cpu, 10.0)\n\n        // Three panels side by side: the GPU, the CPU, and the difference times ten.\n        val gap = 12\n        val w = 3 * n + 2 * gap\n        val sheet = FloatArray(4 * w * n)\n        for ((k, img) in listOf(gpu, cpu, diff).withIndex()) {\n            for (y in 0 until n) for (x in 0 until n) {\n                val s = 4 * (y * n + x)\n                val d = 4 * (y * w + k * (n + gap) + x)\n                for (c in 0..3) sheet[d + c] = img[s + c]\n            }\n        }\n        display(\"gpu | cpu | difference x10\", GeziraSvg.png(sheet, w, n))\n        display(\n            \"readout\",\n            \"<pre style='margin:0'>\" +\n                \"${scene.paths.size} paths, ${scene.curveCount} curves, ${n} x ${n}\\n\" +\n                \"gpu vs cpu per channel: largest %.4f, mean %.1e\\n\".format(worst, sum / gpu.size) +\n                \"frame, both scenes on the gpu: %.1f ms\\n\".format(frameMs) +\n                \"cpu GeziraSvg.render: %.0f ms\".format(cpuMs) +\n                \"</pre>\",\n        )\n    } finally {\n        probe.close()\n    }\n}\n"}}} {"id" "ggt_renderer" "properties" {"children" #{#afield/box "ggt_tiger" #afield/box "ggt_compare"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "ggt_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nOptions.profiling = false\nOptions.vsync = false\nonce.renderer {\n    window = Window(\"the tiger, through Gezira on the GPU\", initialDimensions = Rect(80.0, 80.0, 900.0, 900.0))\n    Renderer(window)\n}\nprintln(\"renderer ready\")\nstart(renderer::run)\n"}}} {"id" "ggt_draw" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "ggt_tiger"} "name" "draw the tiger" "_tombstone" false "frame" #afield/rect [40.0 360.0 340.0 100.0] "vertex" #afield/file-inline {"path" "ggt_draw_vertex_.glsl" "inline" "#version 450\n\n// one triangle that covers the window; positions come from the vertex index\nvec2 fullscreenVertex(uint index) {\n    if (index == 0u) return vec2(-1.0, -1.0);\n    if (index == 1u) return vec2(3.0, -1.0);\n    return vec2(-1.0, 3.0);\n}\n\nvoid main() {\n    gl_Position = vec4(fullscreenVertex(uint(gl_VertexIndex)), 0.0, 1.0);\n}\n"} "fragment" #afield/file-inline {"path" "ggt_draw_fragment_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\n\n// The scene's image: premultiplied rgba per pixel, row-major, y down.\nlayout(std430, buffer_reference) buffer Image {\n    vec4 p[];\n};\n\nlayout(push_constant) uniform Push {\n    Image image;\n    int n;\n    int win;\n} pc;\n\nlayout(location = 0) out vec4 outColor;\n\nfloat srgbToLinear(float c) {\n    return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4);\n}\n\nvoid main() {\n    // the image fills the window's width, whatever its pixel density\n    ivec2 q = ivec2(gl_FragCoord.xy * float(pc.n) / float(max(pc.win, 1)));\n    vec4 c = q.x < pc.n && q.y < pc.n ? pc.image.p[q.y * pc.n + q.x] : vec4(0.0);\n    // over white\n    vec3 col = c.rgb + (1.0 - c.a) * vec3(1.0);\n    outColor = vec4(srgbToLinear(col.r), srgbToLinear(col.g), srgbToLinear(col.b), 1.0);\n}\n"} "code" #afield/file-inline {"path" "ggt_draw_code_.kt" "inline" "var drawModule = moduleHere { primitiveType = triangles }\nrenderer += \"gezira-tiger-draw\" to drawModule\nval quad = fullscreenTriangle(drawModule)\ndrawModule += \"quad\" to quad\n\nquad.image = { tigerImage }\nquad.n = { tigerSize }\nquad.win = { window.width }\nprintln(\"drawing the tiger\")\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_na