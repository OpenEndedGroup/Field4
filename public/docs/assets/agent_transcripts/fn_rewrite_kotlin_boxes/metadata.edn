{"version" 2 "boxes" [{"id" "fnrw_host" "properties" {"children" #{#afield/box "fnrw_working"} "parents" #{#afield/box "root"} "name" "Host" "_tombstone" false "frame" #afield/rect [60.0 60.0 400.0 150.0] "code" #afield/file-inline {"path" "fnrw_host_code_.kt" "inline" "// An ordinary, idle box. Its only job is to own a live Kotlin engine that somebody else\n// can compile in. Executing it once is what brings that engine up.\nprintln(\"host engine ready\")\n"}}} {"id" "fnrw_working" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "fnrw_host"} "name" "Two boxes - works" "_tombstone" false "frame" #afield/rect [60.0 250.0 560.0 170.0] "code" #afield/file-inline {"path" "fnrw_working_code_.kt" "inline" "// WORKS. `rewriteFn` names the box to compile the `@{...}` snippets in, and that box is\n// idle, so hydrating there replays nothing. One pass, and the sampled signal really moves.\nval spec = [\n    \"#fnrewrite\",\n    \"sin/*/saw => op=triangle\",\n    \"sin/**/[tag=number][value>0.15] => *= @{1.0 + depth * 0.08}\",\n    \"**/[role=amplitude] => *= @{if (parentOp == \\\"sin\\\") 0.75 else 1.0}\",\n].joinToString(\"\\n\")\n\n/*\nThe host comes from TOPOLOGY, not from a hard-coded id: whatever this box is connected\nbeneath is where the `@{...}` snippets get compiled. Drag a different parent in and the\nrewrite follows it.\n\n*/\nval host = parents.lastOrNull() ?: throw IllegalStateException(\"connect this box under a box to compile the @{...} in\")\nprintln(\"compiling in parent: \" + host.name)\n\nwith(Functions) {\n    val base = (sin(sin(saw(0.18))) * 0.45) over (0.0..3.0)\n    val changed = host.rewriteFn(base, spec)\n    println(\"before  f(1.0) = \" + base.eval(1.0))\n    println(\"after   f(1.0) = \" + changed.eval(1.0))\n    base.withName(\"before\").plot(0.0..3.0, channel = \"before\", heightPx = 200, title = \"before rewrite\")\n    changed.withName(\"after\").plot(0.0..3.0, channel = \"after\", heightPx = 200, title = \"after rewrite\")\n}\n"}}} {"id" "fnrw_broken" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "One box - does not work" "_tombstone" false "frame" #afield/rect [60.0 460.0 560.0 170.0] "code" #afield/file-inline {"path" "fnrw_broken_code_.kt" "inline" "/*\nIntentionally wrong: source hydration would compile in this running box's own engine.\nThe runtime refuses before replaying the body. Run this box to see that refusal;\ncopy the two-box example above, whose parent host is idle.\n*/\nval spec = [\n    \"#fnrewrite\",\n    \"sin/*/saw => op=triangle\",\n    \"sin/**/[tag=number][value>0.15] => *= @{1.0 + depth * 0.08}\",\n    \"**/[role=amplitude] => *= @{if (parentOp == \\\"sin\\\") 0.75 else 1.0}\",\n].joinToString(\"\\n\")\n\nprintln(\"one box: body entered\")\n\nwith(Functions) {\n    val base = (sin(sin(saw(0.18))) * 0.45) over (0.0..3.0)\n    base.rewriteKotlin(spec)\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}