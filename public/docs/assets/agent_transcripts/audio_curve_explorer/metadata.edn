{"version" 2 "boxes" [{"id" "audio_curve_voice" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 · a film voice as a moving 3D curve — play or scrub" "_tombstone" false "frame" #afield/rect [40.0 40.0 460.0 100.0] "code" #afield/file-inline {"path" "audio_curve_voice_code_.kt" "inline" "val wav = \"%docs/assets/subharmonic_sound/notld-barbara-source.wav\".path\nval curve = audioCurves(wav, AudioCurveSettings(dimensions = 3)).first()\nval scale = 100 / curve.extent()\n\n// The player keeps the audio clock and tells this box where it is, or where you are scrubbing.\nvar t = 0.0\ndisplayAudioBytes(wav.toFile().readBytes(), options = AudioVisualizerOptions(onTime = { t = it }))\n\n// A faint cube around where the curve lives, so the view holds still while you orbit.\nval room = fline {\n    for (z in [-80, 80]) {\n        moveTo(-80, -80, z)\n        lineTo(80, -80, z)\n        lineTo(80, 80, z)\n        lineTo(-80, 80, z)\n        lineTo(-80, -80, z)\n    }\n    for (x in [-80, 80]) for (y in [-80, 80]) {\n        moveTo(x, y, -80)\n        lineTo(x, y, 80)\n    }\n    color = vec(1, 1, 1, 0.12)\n}\n\nvar shown = Double.NaN\nloop {\n    // Before the first complete window, show the first curve.\n    val frame = curve.frameAt(t) ?: curve.frame(0)\n    if (frame.timeSeconds != shown) {\n        shown = frame.timeSeconds\n        threeLines(frame.flines(scale, bands = 16, centered = true) + room, channel = \"curve\", height = 560)\n    }\n}\n    .end { curve.close() }\n"}}} {"id" "audio_curve_music" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 · stereo music, one curve per channel" "_tombstone" false "frame" #afield/rect [1240.0 40.0 460.0 100.0] "code" #afield/file-inline {"path" "audio_curve_music_code_.kt" "inline" "val wav = \"%docs/assets/audio_ai_muscriptor/source.wav\".path\nval curves = audioCurves(wav)\nval colors = [vec(0.39, 0.78, 0.86, 1.0), vec(0.96, 0.70, 0.36, 1.0)]\n\nvar t = 3.0\ndisplayAudioBytes(\n    wav.toFile().readBytes(),\n    options = AudioVisualizerOptions(initialPositionSeconds = t, onTime = { t = it }),\n)\n\nvar shown = Double.NaN\nloop {\n    val frames = curves.map { it.frameAt(t) }\n    val time = frames.firstOrNull()?.timeSeconds\n    if (time != null && time != shown) {\n        shown = time\n        // Left channel on the left, right on the right; each channel has its own axes.\n        val lines = frames.flatMapIndexed { i, frame ->\n            val offset = vec(if (i == 0) -110.0 else 110.0, 0.0, 0.0)\n            frame!!.flines(80 / curves[i].extent(), depth = 150.0, color = colors[i]).map { it + offset }\n        }\n        threeLines(lines, channel = \"curves\", height = 520)\n    }\n}\n    .end { curves.forEach { it.close() } }\n"}}} {"id" "audio_curve_ema" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 · averages from one hop to 20 s instead of a window" "_tombstone" false "frame" #afield/rect [3640.0 40.0 460.0 100.0] "code" #afield/file-inline {"path" "audio_curve_ema_code_.kt" "inline" "val wav = \"%docs/assets/subharmonic_sound/notld-barbara-source.wav\".path\n// 48 running averages of the spectrum, from one hop up to 20 seconds, longest first.\nval settings = AudioCurveSettings(dimensions = 3, history = 48, emaLongestSeconds = 20.0)\nval curve = audioCurves(wav, settings).first()\nval scale = 100 / curve.extent()\n\nvar t = 0.0\ndisplayAudioBytes(wav.toFile().readBytes(), options = AudioVisualizerOptions(onTime = { t = it }))\n\nvar shown = Double.NaN\nloop {\n    val frame = curve.frameAt(t)\n    if (frame != null && frame.timeSeconds != shown) {\n        shown = frame.timeSeconds\n        threeLines(frame.flines(scale, bands = 16), channel = \"curve\", height = 560)\n    }\n}\n    .end { curve.close() }\n"}}} {"id" "audio_curve_maps" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5 · the sounds heard so far, remembered on a sheet and a lattice" "_tombstone" false "frame" #afield/rect [4840.0 40.0 460.0 100.0] "code" #afield/file-inline {"path" "audio_curve_maps_code_.kt" "inline" "val wav = \"%docs/assets/subharmonic_sound/notld-barbara-source.wav\".path\n// A sheet of 12 × 12 prototypes and a lattice of 6 × 6 × 6, each learning with a 0.5 s time constant.\nval sheet = audioCurves(wav, AudioCurveSettings(dimensions = 3, somLearnSeconds = 0.5, somGrid = [12, 12])).first()\nval lattice = audioCurves(wav, AudioCurveSettings(dimensions = 3, somLearnSeconds = 0.5, somGrid = [6, 6, 6])).first()\n\n// Start six seconds in, so a learned map shows before you press play.\nvar t = 6.0\ndisplayAudioBytes(\n    wav.toFile().readBytes(),\n    options = AudioVisualizerOptions(initialPositionSeconds = t, onTime = { t = it }),\n)\n\n// A faint room around each map, so the view holds still while the maps turn.\nfun room(cx: Double) = fline {\n    for (z in [-80.0, 80.0]) {\n        moveTo(cx - 80, -80.0, z)\n        lineTo(cx + 80, -80.0, z)\n        lineTo(cx + 80, 80.0, z)\n        lineTo(cx - 80, 80.0, z)\n        lineTo(cx - 80, -80.0, z)\n    }\n    for (x in [cx - 80, cx + 80]) for (y in [-80.0, 80.0]) {\n        moveTo(x, y, -80.0)\n        lineTo(x, y, 80.0)\n    }\n    color = vec(1, 1, 1, 0.1)\n}\nval rooms = [room(-100.0), room(100.0)]\n\n// Turn a map slowly about the vertical axis as the sound plays, then move it into its room.\nfun place(lines: List<FLine>, turn: Double, cx: Double) = lines.map { line ->\n    line.transform { p -> vec(p.x * cos(turn) + p.z * sin(turn) + cx, p.y, -p.x * sin(turn) + p.z * cos(turn)) }\n}\n\nvar shown = Double.NaN\nvar first = true\nloop {\n    val a = sheet.frameAt(t) ?: sheet.frame(0)\n    if (a.timeSeconds != shown) {\n        shown = a.timeSeconds\n        val b = lattice.frameAt(t) ?: lattice.frame(0)\n        val turn = 0.3 * t\n        val left = place(\n            a.flines(55 / a.spread(), centered = true, stretch = true, trail = sheet.recentMatches(t, 0.5)),\n            turn,\n            -100.0,\n        )\n        val right = place(\n            b.flines(55 / b.spread(), centered = true, stretch = true, trail = lattice.recentMatches(t, 0.5)),\n            turn,\n            100.0,\n        )\n        // Frame the view once; after that the rooms hold it still while the maps turn.\n        threeLines(left + right + rooms, channel = \"maps\", height = 560, autoFrame = first)\n        first = false\n    }\n}\n    .end {\n        sheet.close()\n        lattice.close()\n    }\n"}}} {"id" "audio_curve_dense" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 · finer hop, longer memory" "_tombstone" false "frame" #afield/rect [2440.0 40.0 460.0 100.0] "code" #afield/file-inline {"path" "audio_curve_dense_code_.kt" "inline" "val wav = \"%docs/assets/subharmonic_sound/notld-barbara-source.wav\".path\n// A curve every 256 samples (5.3 ms at 48 kHz) that remembers 384 spectra (2 s).\nval curve = audioCurves(wav, AudioCurveSettings(hopSize = 256, history = 384)).first()\nval scale = 100 / curve.extent()\n\nvar t = 2.0\ndisplayAudioBytes(\n    wav.toFile().readBytes(),\n    options = AudioVisualizerOptions(initialPositionSeconds = t, onTime = { t = it }),\n)\n\nvar shown = Double.NaN\nloop {\n    val frame = curve.frameAt(t)\n    if (frame != null && frame.timeSeconds != shown) {\n        shown = frame.timeSeconds\n        threeLines(frame.flines(scale, depth = 300.0, bands = 16), channel = \"curve\", height = 560)\n    }\n}\n    .end { curve.close() }\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}