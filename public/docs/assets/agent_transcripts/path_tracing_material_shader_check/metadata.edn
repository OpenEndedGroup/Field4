{"version" 2 "boxes" [{"id" "path_trace_material_check" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "path_trace_renderer"} "name" "editable-material-check" "_tombstone" false "frame" #afield/rect [320.0 180.0 360.0 120.0] "compute" #afield/file-inline {"path" "path_trace_material_check_compute_.glsl" "inline" "{{ pathTracing.preamble }}\n{% property \"editable-material-check.pathTracePaint\" %}\n{{ pathTracing.integrator }}\n"} "code" #afield/file-inline {"path" "path_trace_material_check_code_.kt" "inline" "import afield.graphics.scene.fabricated.*\nimport afield.graphics.vulkan.util.Camera\nimport kotlinx.coroutines.delay\n\nval scene = PathTraceScene().apply {\n    val m = material(PathTraceMaterial.emissive(0f, 0f, 0f))\n    quad(Vector3f(-20f, -20f, 0f), Vector3f(20f, -20f, 0f), Vector3f(20f, 20f, 0f), Vector3f(-20f, 20f, 0f), m)\n}\nval camera = Camera(renderer).also {\n    it.at.set(0f, 0f, 3f)\n    it.target.set(0f, 0f, 0f)\n}\nprop<PathTracingRenderer>(tracer)\ntracer = pathTracingHere(\n    scene,\n    PathTraceEnvironment.constant(0f),\n    width = 32,\n    height = 24,\n    camera = camera,\n    name = \"editable-study\",\n)\ntracer.materialMesh.gain = { 2f }\ntracer.maxBounces = 1\ntracer.blitToScreen()\nfun afield.document.graph.Box.ownerForTest() = this\nval owner = ownerForTest()\nval verify: suspend () -> Unit = {\n    PathTraceGpuSmoke.awaitSamples(tracer, 8)\n    tracer.paused = true\n    check(kotlin.math.abs(tracer.readLinear()[0] - 2f) < 1e-5) { \"Initial box material hook was not evaluated\" }\n    val original = tracer.materialModule.current\n    owner.setPropertyRaw(\"pathTracePaint\", \"invalid GLSL\")\n    check(!reloadComputeShader(owner))\n    check(tracer.materialModule.current === original) { \"Failed reload replaced the working pipeline\" }\n    owner.setPropertyRaw(\n        \"pathTracePaint\",\n        \"\"\"\n        layout(push_constant) uniform PaintPC { float gain; float bias; } pc;\n        Material shadeMaterial(Material material, PathTraceSurface surface) {\n            material.base.rgb = vec3(0);\n            material.emission.rgb = vec3(pc.gain + pc.bias, 0, 0);\n            return material;\n        }\n    \"\"\"\n            .trimIndent(),\n    )\n    check(reloadComputeShader(owner))\n    check(tracer.materialModule.current !== original)\n    check(tracer.materialModule.current.ci.pushConstants.single().members.map { it.name } == listOf(\"gain\", \"bias\"))\n    tracer.materialMesh.push[\"bias\"] = 1f\n    tracer.paused = false\n    delay(100)\n    PathTraceGpuSmoke.awaitSamples(tracer, 4)\n    tracer.paused = true\n    check(kotlin.math.abs(tracer.readLinear()[0] - 3f) < 1e-5) {\n        \"Reload retained old accumulation or failed to preserve push values\"\n    }\n    println(\n        \"PASS EDITABLE MATERIAL BOX: seeded templates, includes, reflected push constants, changed ABI, last-valid reload, accumulation reset\",\n    )\n    tracer.close()\n}\nstart(verify)\n"}}} {"id" "path_trace_renderer" "properties" {"children" #{#afield/box "path_trace_material_check"} "parents" #{#afield/box "root"} "name" "path tracing renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 320.0 110.0] "code" #afield/file-inline {"path" "path_trace_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nonce.renderer {\n    window = Window(\"Field · Path tracing\")\n    Renderer(window)\n}\nstart(renderer::run)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "rayg