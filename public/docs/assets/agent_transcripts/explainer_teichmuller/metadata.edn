{"version" 2 "boxes" [{"id" "etm_ellipse" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "ellipse" "_tombstone" false "frame" #afield/rect [1540.0 140.0 150.0 50.0] "code" #afield/file-inline {"path" "etm_ellipse_code_.kt" "inline" "import afield.geometry.conformal.*\n\n// One small circle under the map z ↦ z + μ·z̄, the simplest map with a given μ.\n// The size of μ sets how long the ellipse is; its angle sets which way it points.\nvar size = 0.4\nvar degrees = 30.0\n\nfun draw() {\n    val angle = degrees * PI / 180\n    val mr = size * cos(angle)\n    val mi = size * sin(angle)\n    // z + μ z̄ for z = x + iy.\n    fun map(x: Double, y: Double) = doubleArrayOf(x + mr * x + mi * y, y + mi * x - mr * y)\n    fun sx(x: Double) = 320 + 110 * x\n    fun sy(y: Double) = 180 - 110 * y\n    fun curve(thick: Double, isGuide: Boolean, at: (Double) -> DoubleArray) = fline {\n        for (s in 0..96) {\n            val p = at(2 * PI * s / 96)\n            if (s == 0) moveTo(sx(p[0]), sy(p[1])) else lineTo(sx(p[0]), sy(p[1]))\n        }\n        thickness = thick\n        color = if (isGuide) vec(1.0, 1.0, 1.0, 0.35) else vec(0.4, 0.9, 1.0, 1.0)\n    }\n    val drawn = mutableListOf(\n        curve(1.5, true) { doubleArrayOf(cos(it), sin(it)) },\n        curve(3.0, false) { map(cos(it), sin(it)) },\n    )\n    // The direction stretched most, and the one squeezed most: half the angle of μ, and a right angle from it.\n    val long = map(cos(angle / 2), sin(angle / 2))\n    val short = map(-sin(angle / 2), cos(angle / 2))\n    drawn += fline {\n        moveTo(sx(-long[0]), sy(-long[1]))\n        lineTo(sx(long[0]), sy(long[1]))\n        thickness = 2.0\n        color = vec(1.0, 0.6, 0.2, 1.0)\n    }\n    drawn += fline {\n        moveTo(sx(-short[0]), sy(-short[1]))\n        lineTo(sx(short[0]), sy(short[1]))\n        thickness = 1.0\n        color = vec(1.0, 0.6, 0.2, 0.6)\n    }\n    lines(drawn, channel = \"circle\", w = 640.0, h = 360.0, framing = LinesFraming.fixed(0.0, 0.0, 640.0, 360.0))\n    markdown(\n        \"readout\",\n        \"μ = ${size.f2} at ${degrees.f0}°: stretched by **${(1 + size).f2}**, squeezed to **${(1 - size).f2}**, ratio K = **${dilatation(size).f2}**\",\n    )\n}\n\ndraw()\ncontrolGroup {\n    slider(\"size\", 0.0, 0.9, initialValue = size) {\n        size = it\n        draw()\n    }\n    slider(\"angle\", 0.0, 360.0, step = 1.0, initialValue = degrees) {\n        degrees = it\n        draw()\n    }\n}\n"}}} {"id" "etm_leaf_compare" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "leaf_compare" "_tombstone" false "frame" #afield/rect [3020.0 140.0 150.0 50.0] "code" #afield/file-inline {"path" "etm_leaf_compare_code_.kt" "inline" "import afield.geometry.conformal.*\nimport afield.media.image.util.PngEncoder\n\n/*\nTwo leaf outlines and the Teichmüller map from the first to the second. Six landmarks\nmatch: tip, base, and the margin a third and two thirds of the way up on each side. The\noutline between landmarks is free to slide. Colour is |μ| of the map: the distortion field.\n*/\nval names = [\"elliptic\", \"lanceolate\", \"ovate\", \"heart-shaped\", \"round\"]\n\n// Each leaf as a distance from its middle in every direction; the tip points up.\nfun oval(a: Double, b: Double, t: Double) = a * b / sqrt((b * cos(t)).pow(2) + (a * sin(t)).pow(2))\nfun leaf(kind: Int): (Double) -> Double = { t ->\n    when (kind) {\n        0 -> oval(0.5, 1.0, t)\n        1 -> oval(0.27, 1.0, t) * (1 + 0.15 * max(0.0, sin(t)).pow(6))\n        2 -> oval(0.62 * (1 - 0.22 * sin(t)), 0.95, t)\n        3 ->\n            oval(0.75 * (1 - 0.15 * sin(t)), 0.9, t) *\n                (1 + 0.2 * max(0.0, sin(t)).pow(8)) *\n                (1 - 0.45 * exp(-(1 + sin(t)) / 0.024)) // the notch at the base, the same however t wraps\n        else -> oval(0.85, 0.95, t)\n    }\n}\n\nvar first = 0\nvar second = 3\n\nfun draw() {\n    // The map is mirror-symmetric, so it is computed on the right halves and drawn twice.\n    val c = MirrorShapeComparison(leaf(first), leaf(second))\n    val mesh = c.half\n    val picture = MeshPicture(640, 360, -2.2, -1.24, 2.2, 1.24)\n    val colours = IntArray(mesh.triangleCount) { MeshPicture.distortionColor(c.map.moduli[it], 0.6) }\n    for (side in [1.0, -1.0]) {\n        picture.mesh(mesh, DoubleArray(mesh.vertexCount) { side * mesh.x[it] - 1.1 }, mesh.y, colours, edgeAlpha = 0.25)\n        picture.mesh(\n            mesh,\n            DoubleArray(mesh.vertexCount) { side * c.map.u[it] + 1.1 },\n            c.map.v,\n            colours,\n            edgeAlpha = 0.25,\n        )\n        for (k in 0 until 4) {\n            picture.dot(side * mesh.x[c.landmarks[k]] - 1.1, mesh.y[c.landmarks[k]], 4.0, 0xFFFF9933.toInt())\n            picture.dot(side * c.targetLandmarks[k][0] + 1.1, c.targetLandmarks[k][1], 4.0, 0xFFFF9933.toInt())\n        }\n    }\n    display(\"leaves\", PngEncoder.encode(picture.pixels, 640, 360))\n    markdown(\n        \"readout\",\n        \"**${names[first]} → ${names[second]}**: Teichmüller distance **${c.distance.f2}** (K = ${exp(2 * c.distance).f2}); \" +\n            \"|μ| is ${c.map.medianModulus.f2} over half the leaf, ${c.map.minModulus.f2} to ${c.map.maxModulus.f2} at the extremes\",\n    )\n}\n\ndraw()\ncontrolGroup {\n    slider(\"first leaf\", 0.0, 4.0, step = 1.0, initialValue = 0.0) {\n        first = it.toInt()\n        draw()\n    }\n    slider(\"second leaf\", 0.0, 4.0, step = 1.0, initialValue = 3.0) {\n        second = it.toInt()\n        draw()\n    }\n}\n"}}} {"id" "etm_deck" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "deck" "_tombstone" false "frame" #afield/rect [60.0 140.0 150.0 50.0] "code" #afield/file-inline {"path" "etm_deck_code_.kt" "inline" "import kotlinx.html.*\n\n// The talk. Every figure is a box beside this one, named as in figureBeside(...).\npresentation(title = \"Teichmüller maps\") {\n    step(\"Teichmüller maps\", id = \"opening\") {\n        audience {\n            +\"\"\"\n                # Teichmüller maps\n\n                How different are two leaves? One answer: bend one onto the other, and\n                measure how much the bending had to distort it. Teichmüller maps are the\n                bendings that distort as little as possible.\n\n                This talk builds the idea from nothing: maps that keep angles, maps that\n                turn circles into ellipses, the map with the least distortion, and the\n                distance between shapes that comes out of it.\"\"\".md\n            p(classes = \"muted\") {\n                +\"After the work of Gary P. T. Choi, L. Mahadevan, Lok Ming Lui and co-authors. Words and figures made in Field.\"\n            }\n        }\n        markdownNote(\"Where we are going: a number for how different two outlines are. [[next]]\")\n    }\n\n    section(\"Conformal maps\") {\n        step(\"Maps that keep angles\", id = \"conformal\") {\n            audience {\n                figureBeside(\"circles\") {\n                    +\"\"\"\n                        ## Maps that keep angles\n\n                        A map moves every point of the plane somewhere else. This one bends\n                        the grid, yet wherever two grid lines cross, they still cross at a\n                        right angle.\n\n                        A map that keeps every angle is called **conformal**. Look closely and\n                        each small circle is still a circle: it has grown or shrunk and turned,\n                        but kept its shape.\"\"\".md\n                }\n            }\n            control(\"circles\", \"map\", 0.0)\n            control(\"circles\", \"amount\", 0.0)\n            cue(\"Bend\") { control(\"circles\", \"amount\", 0.9, glideMs = 2000) }\n            markdownNote(\"Next bends the plane with z + a·z². The circles stay round and blue. [[back]] [[next]]\")\n        }\n    }\n\n    section(\"Quasi-conformal maps\") {\n        step(\"Circles become ellipses\", id = \"stretch\") {\n            audience {\n                figureBeside(\"circles\") {\n                    +\"\"\"\n                        ## Circles become ellipses\n\n                        Most maps are not conformal. Stretch the plane sideways and every\n                        small circle becomes an ellipse.\n\n                        Seen closely enough, any smooth map is a stretch: a small enough\n                        circle always comes out as an ellipse. A map whose ellipses never get\n                        infinitely thin is **quasi-conformal**.\"\"\".md\n                }\n            }\n            control(\"circles\", \"map\", 1.0)\n            control(\"circles\", \"amount\", 0.0)\n            cue(\"Stretch\") { control(\"circles\", \"amount\", 0.8, glideMs = 2000) }\n            cue(\"Twist\") {\n                control(\"circles\", \"map\", 2.0)\n                control(\"circles\", \"amount\", 0.8)\n            }\n            markdownNote(\n                \"Next stretches; the one after twists the middle, where the ellipses differ from place to place. [[back]] [[next]]\",\n            )\n        }\n        step(\"The Beltrami coefficient\", id = \"beltrami\") {\n            audience {\n                figureBeside(\"ellipse\") {\n                    +\"\"\"\n                        ## The Beltrami coefficient\n\n                        One complex number says which ellipse a map makes at a point: the\n                        **Beltrami coefficient** μ. Writing the map as f(z),\n                        μ = (∂f/∂z̄) ÷ (∂f/∂z).\n\n                        Its size, between 0 and 1, sets the shape: the ellipse is\n                        K = (1 + |μ|) ÷ (1 − |μ|) times as long as it is wide. Its angle sets\n                        the direction: half of it. μ = 0 is a circle, a conformal map.\"\"\".md\n                }\n            }\n            control(\"ellipse\", \"size\", 0.0)\n            control(\"ellipse\", \"angle\", 30.0)\n            cue(\"Grow μ\") { control(\"ellipse\", \"size\", 0.6, glideMs = 1500) }\n            cue(\"Turn μ\") { control(\"ellipse\", \"angle\", 210.0, glideMs = 2500) }\n            markdownNote(\n                \"Next grows |μ| to 0.6 (K = 4); then turning μ by 180° turns the ellipse by 90°. [[back]] [[next]]\",\n            )\n        }\n        step(\"A μ at every point\", id = \"field\") {\n            audience {\n                figureBeside(\"circles\") {\n                    +\"\"\"\n                        ## A μ at every point\n\n                        The twist has a different μ at every point. The colours are its\n                        size: blue where circles stay round, orange where they stretch.\n\n                        The remarkable fact runs the other way. Choose any μ, anywhere below 1,\n                        and there is a map with exactly those ellipses, unique once you fix\n                        where three points go. μ is a complete description of the map.\"\"\".md\n                }\n            }\n            control(\"circles\", \"map\", 2.0)\n            control(\"circles\", \"amount\", 0.9)\n            markdownNote(\"The measurable Riemann mapping theorem, in one sentence. [[back]] [[next]]\")\n        }\n    }\n\n    section(\"Teichmüller maps\") {\n        step(\"From μ back to a map\", id = \"solver\") {\n            audience {\n                figureBeside(\"landmark\") {\n                    +\"\"\"\n                        ## From μ back to a map\n\n                        On a computer the plane is a mesh of triangles and a map moves each\n                        vertex. Given μ on every triangle, the **linear Beltrami solver**\n                        finds the map: each coordinate solves one sparse linear system.\n\n                        Here the square's edges are held and one point inside is dragged.\n                        The left map asks for μ = 0, as conformal as it can be.\"\"\".md\n                }\n            }\n            control(\"landmark\", \"landmark x\", 0.3)\n            control(\"landmark\", \"landmark y\", 0.5)\n            cue(\"Drag the point\") {\n                control(\"landmark\", \"landmark x\", 0.65, glideMs = 2000)\n                control(\"landmark\", \"landmark y\", 0.6, glideMs = 2000)\n            }\n            markdownNote(\"Starts undisturbed; Next drags the white point to the orange one. [[back]] [[next]]\")\n        }\n        step(\"No conformal map exists\", id = \"harmonic\") {\n            audience {\n                figureBeside(\"landmark\") {\n                    +\"\"\"\n                        ## No conformal map exists\n\n                        Fix the edges and move a point, and no map can keep every angle.\n                        The μ = 0 request gives the harmonic map on the left. Its\n                        distortion piles up around the dragged point, and where |μ| passes 1\n                        triangles turn over: the map folds.\n\n                        So ask a better question: of all maps that move the point there,\n                        which has the smallest worst ellipse?\"\"\".md\n                }\n            }\n            control(\"landmark\", \"landmark x\", 0.65)\n            control(\"landmark\", \"landmark y\", 0.6)\n            markdownNote(\"Point out the orange ring round the landmark on the left. [[back]] [[next]]\")\n        }\n        step(\"Spread the distortion evenly\", id = \"teichmuller\") {\n            audience {\n                figureBeside(\"landmark\") {\n                    +\"\"\"\n                        ## Spread the distortion evenly\n\n                        That map is the **extremal** map, and Teichmüller showed it usually\n                        has the same |μ| everywhere: only the direction of stretch changes.\n                        Such a map is a **Teichmüller map**.\n\n                        The right map is found by iterating: solve, measure μ, smooth it,\n                        give every triangle the mean size, solve again (Lui, Lam, Yau and\n                        Gu, 2014). Its colour is even, and its worst |μ| is lower.\"\"\".md\n                }\n            }\n            control(\"landmark\", \"landmark x\", 0.65)\n            control(\"landmark\", \"landmark y\", 0.6)\n            cue(\"Further\") {\n                control(\"landmark\", \"landmark x\", 0.7, glideMs = 2000)\n                control(\"landmark\", \"landmark y\", 0.38, glideMs = 2000)\n            }\n            markdownNote(\"Compare the two readouts. Next drags the landmark further. [[back]] [[next]]\")\n        }\n    }\n\n    section(\"Comparing shapes\") {\n        step(\"A distance between shapes\", id = \"distance\") {\n            audience {\n                figureBeside(\"ellipse\") {\n                    +\"\"\"\n                        ## A distance between shapes\n\n                        A Teichmüller map has one number, K, its ellipses' shape. The\n                        **Teichmüller distance** between two shapes is ½ log K of the\n                        Teichmüller map from one to the other.\n\n                        It is a true distance: zero only for shapes one conformal map\n                        apart, the same both ways, and never shorter than going via a third\n                        shape. Growing or shrinking a shape is conformal, so size is free.\"\"\".md\n                }\n            }\n            control(\"ellipse\", \"size\", 0.33)\n            control(\"ellipse\", \"angle\", 0.0)\n            markdownNote(\"|μ| = 0.33 means K = 2 and distance ½ log 2 ≈ 0.35. [[back]] [[next]]\")\n        }\n        step(\"Two leaves\", id = \"leaves\") {\n            audience {\n                figureBeside(\"leaf_compare\") {\n                    +\"\"\"\n                        ## Two leaves\n\n                        Choi and Mahadevan compare planar shapes this way: leaves, insect\n                        wings, the outlines of organs. Mark matching landmarks, let the\n                        outline slide between them, find the Teichmüller map.\n\n                        Here the landmarks are the tip, the base, and the margin a third and\n                        two thirds of the way up. The colour is even: the same stretch\n                        everywhere, only its direction changes. Choose two leaves.\"\"\".md\n                }\n            }\n            control(\"leaf_compare\", \"first leaf\", 0.0)\n            control(\"leaf_compare\", \"second leaf\", 3.0)\n            cue(\"Lanceolate\") { control(\"leaf_compare\", \"second leaf\", 1.0) }\n            markdownNote(\"Elliptic to heart-shaped; Next compares elliptic with lanceolate. [[back]] [[next]]\")\n        }\n        step(\"A table of distances\", id = \"table\") {\n            audience {\n                figureBeside(\"leaf_distances\") {\n                    +\"\"\"\n                        ## A table of distances\n\n                        Every pair of five leaves. With distances in hand, the usual tools\n                        apply: nearest neighbours, clusters, a tree of similarity.\n\n                        Biologists can compare outlines without choosing a coordinate\n                        system or a scale, and see where on the shape the difference\n                        lies.\"\"\".md\n                }\n            }\n            markdownNote(\"The table takes a few seconds to compute on first show. [[back]] [[next]]\")\n        }\n        step(\"What this version leaves out\", id = \"caveats\") {\n            audience {\n                +\"\"\"\n                    ## What this version leaves out\n\n                    - Our leaves are mirror-symmetric, and we use it: the best map is then\n                      symmetric too, each half is a four-cornered region, and the map between\n                      two of those goes through rectangles, with an exact distance. Leaves\n                      that are not symmetric need the general sliding-boundary iteration.\n                    - With only four landmarks, tip, base and one pair, every symmetric leaf\n                      is at distance zero from every other: the landmarks decide what the\n                      distance can see.\n                    - Our outlines are formulas; real ones come from photographs.\n                    - The same machinery works on point clouds without a mesh (Choi, Liu\n                      and Lui) and, with density instead of angle, gives density-equalizing\n                      maps (Choi and Rycroft).\"\"\".md\n            }\n            markdownNote(\"Questions for Gary go here. [[back]] [[next]]\")\n        }\n    }\n\n    step(\"Further reading\", id = \"further-reading\") {\n        audience {\n            +\"\"\"\n                ## Further reading\n\n                - Gary P. T. Choi and L. Mahadevan, “Planar morphometrics using Teichmüller maps”, *Proc. R. Soc. A* 474 (2018), doi 10.1098/rspa.2017.0905.\n                - Lok Ming Lui, Ka Chun Lam, Shing-Tung Yau and Xianfeng Gu, “Teichmüller mapping (T-map) and its applications to landmark matching registration”, *SIAM J. Imaging Sciences* 7 (2014), doi 10.1137/120900186.\n                - Gary P. T. Choi, Yechen Liu and Lok Ming Lui, “Free-boundary conformal parameterization of point clouds”, *J. Sci. Comput.* 90 (2022), doi 10.1007/s10915-021-01641-6.\n                - Gary P. T. Choi and Chris H. Rycroft, “Density-equalizing maps for simply connected open surfaces”, *SIAM J. Imaging Sciences* 11 (2018), doi 10.1137/17M1124796.\"\"\".md\n            p(classes = \"muted\") {\n                +\"After the work of Gary P. T. Choi, L. Mahadevan, Lok Ming Lui and co-authors. Words and figures made in Field.\"\n            }\n        }\n        markdownNote(\"The end. [[back]] [[finish]]\")\n    }\n}.arrangeBoxes().present()\n"}}} {"id" "etm_circles" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "circles" "_tombstone" false "frame" #afield/rect [800.0 140.0 150.0 50.0] "code" #afield/file-inline {"path" "etm_circles_code_.kt" "inline" "import afield.geometry.conformal.*\n\n// A grid of small circles pushed through a map. Each comes out as a small ellipse,\n// coloured by |μ|: dark blue is still a circle, orange is a long ellipse.\nvar which = 0\nvar amount = 0.6\nval names = [\"z + a·z², conformal\", \"a stretch along x\", \"a twist near the middle\"]\n\nfun map(x: Double, y: Double): DoubleArray = when (which) {\n    0 -> doubleArrayOf(x + 0.35 * amount * (x * x - y * y), y + 0.35 * amount * 2 * x * y)\n    1 -> doubleArrayOf(x * (1 + amount), y)\n    else -> {\n        val turn = 1.8 * amount * exp(-1.5 * (x * x + y * y))\n        doubleArrayOf(x * cos(turn) - y * sin(turn), x * sin(turn) + y * cos(turn))\n    }\n}\n\n// |μ| = |f_z̄| / |f_z|, from the map's derivatives at (x, y).\nfun distortion(x: Double, y: Double): Double {\n    val h = 1e-5\n    val a = map(x + h, y)\n    val b = map(x - h, y)\n    val c = map(x, y + h)\n    val d = map(x, y - h)\n    val ux = (a[0] - b[0]) / (2 * h)\n    val vx = (a[1] - b[1]) / (2 * h)\n    val uy = (c[0] - d[0]) / (2 * h)\n    val vy = (c[1] - d[1]) / (2 * h)\n    return hypot(ux - vy, vx + uy) / hypot(ux + vy, vx - uy)\n}\n\nfun colour(argb: Int) =\n    vec(((argb shr 16) and 255) / 255.0, ((argb shr 8) and 255) / 255.0, (argb and 255) / 255.0, 1.0)\n// World coordinates to the 640 × 360 picture, y up.\nfun sx(x: Double) = 300 + 175 * x\nfun sy(y: Double) = 180 - 175 * y\n\nfun draw() {\n    val drawn = mutableListOf<FLine>()\n    // The square grid the circles sit on, carried by the map.\n    for (k in -5..5) for (vertical in [true, false]) drawn += fline {\n        for (s in 0..60) {\n            val t = -1.0 + 2.0 * s / 60\n            val p = if (vertical) map(0.2 * k, 0.7 * t) else map(t, 0.14 * k)\n            if (s == 0) moveTo(sx(p[0]), sy(p[1])) else lineTo(sx(p[0]), sy(p[1]))\n        }\n        thickness = 1.0\n        color = vec(1.0, 1.0, 1.0, 0.35)\n    }\n    var largest = 0.0\n    for (i in -5..5) for (j in -3..3) {\n        val cx = 0.2 * i\n        val cy = 0.2 * j\n        val k = distortion(cx, cy)\n        largest = max(largest, k)\n        drawn += fline {\n            for (s in 0..32) {\n                val p = map(cx + 0.07 * cos(2 * PI * s / 32), cy + 0.07 * sin(2 * PI * s / 32))\n                if (s == 0) moveTo(sx(p[0]), sy(p[1])) else lineTo(sx(p[0]), sy(p[1]))\n            }\n            thickness = 2.0\n            color = colour(MeshPicture.distortionColor(k, 0.6))\n        }\n    }\n    lines(drawn, channel = \"map\", w = 640.0, h = 360.0, framing = LinesFraming.fixed(0.0, 0.0, 640.0, 360.0))\n    markdown(\n        \"readout\",\n        \"**${names[which]}**: largest |μ| = ${largest.f2}, so the longest ellipse is ${dilatation(min(largest, 0.99)).f2} times as long as it is wide\",\n    )\n}\n\ndraw()\ncontrolGroup {\n    slider(\"map\", 0.0, 2.0, step = 1.0, initialValue = 0.0) {\n        which = it.toInt()\n        draw()\n    }\n    slider(\"amount\", 0.0, 1.0, initialValue = amount) {\n        amount = it\n        draw()\n    }\n}\n"}}} {"id" "etm_landmark" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "landmark" "_tombstone" false "frame" #afield/rect [2280.0 140.0 150.0 50.0] "code" #afield/file-inline {"path" "etm_landmark_code_.kt" "inline" "import afield.geometry.conformal.*\nimport afield.media.image.util.PngEncoder\n\n/*\nA square whose edges stay put while one point inside is dragged somewhere else.\nLeft: the harmonic map (the solver with μ = 0). Right: the Teichmüller map, found by\nthe quasi-conformal iteration. Colour is |μ| on each triangle.\n*/\nval mesh = PlanarMesh.grid(20)\nval solver = LinearBeltramiSolver(mesh)\nval pinned = mesh.nearest(0.3, 0.5)\nvar toX = 0.6\nvar toY = 0.55\n\nfun draw() {\n    val fixed = mesh.boundaryIdentity() + (pinned to doubleArrayOf(toX, toY))\n    val harmonic = harmonicMap(mesh, fixed, solver)\n    val teich = teichmullerMap(mesh, fixed, iterations = 150, solver = solver)\n    val picture = MeshPicture(640, 320, -0.05, -0.05, 2.15, 1.05)\n    for ((offset, m) in [0.0 to harmonic, 1.1 to teich]) {\n        val shifted = DoubleArray(mesh.vertexCount) { m.u[it] + offset }\n        picture.mesh(\n            mesh,\n            shifted,\n            m.v,\n            IntArray(mesh.triangleCount) { MeshPicture.distortionColor(m.moduli[it], 0.5) },\n        )\n        picture.dot(mesh.x[pinned] + offset, mesh.y[pinned], 3.0, 0xFFFFFFFF.toInt())\n        picture.dot(toX + offset, toY, 5.0, 0xFFFF9933.toInt())\n    }\n    display(\"maps\", PngEncoder.encode(picture.pixels, 640, 320))\n    markdown(\n        \"readout\",\n        \"harmonic, left: |μ| from ${harmonic.minModulus.f2} to **${harmonic.maxModulus.f2}**, ${harmonic.flipped} triangles turned over · \" +\n            \"Teichmüller, right: |μ| from ${teich.minModulus.f2} to **${teich.maxModulus.f2}**, K = ${teich.dilatation.f2} after ${teich.iterations} iterations\",\n    )\n}\n\ndraw()\ncontrolGroup {\n    slider(\"landmark x\", 0.15, 0.85, initialValue = toX) {\n        toX = it\n        draw()\n    }\n    slider(\"landmark y\", 0.15, 0.85, initialValue = toY) {\n        toY = it\n        draw()\n    }\n}\n"}}} {"id" "etm_leaf_distances" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "leaf_distances" "_tombstone" false "frame" #afield/rect [3760.0 140.0 150.0 50.0] "code" #afield/file-inline {"path" "etm_leaf_distances_code_.kt" "inline" "import afield.geometry.conformal.*\nimport afield.media.image.util.PngEncoder\n\n// Every pair of five leaves, compared by Teichmüller distance with the same six landmarks.\n// A shape scaled up is the same shape: scaling is conformal, so it costs nothing.\nval names = [\"elliptic\", \"lanceolate\", \"ovate\", \"heart-shaped\", \"round\"]\nfun oval(a: Double, b: Double, t: Double) = a * b / sqrt((b * cos(t)).pow(2) + (a * sin(t)).pow(2))\nfun leaf(kind: Int): (Double) -> Double = { t ->\n    when (kind) {\n        0 -> oval(0.5, 1.0, t)\n        1 -> oval(0.27, 1.0, t) * (1 + 0.15 * max(0.0, sin(t)).pow(6))\n        2 -> oval(0.62 * (1 - 0.22 * sin(t)), 0.95, t)\n        3 ->\n            oval(0.75 * (1 - 0.15 * sin(t)), 0.9, t) *\n                (1 + 0.2 * max(0.0, sin(t)).pow(8)) *\n                (1 - 0.45 * exp(-(1 + sin(t)) / 0.024)) // the notch at the base, the same however t wraps\n        else -> oval(0.85, 0.95, t)\n    }\n}\n\nval d = Array(5) { DoubleArray(5) }\nfor (a in 0 until 5) for (b in a + 1 until 5) {\n    d[a][b] = MirrorShapeComparison(leaf(a), leaf(b)).distance\n    d[b][a] = d[a][b]\n}\n\n// The five leaves in a row, then the table of distances.\nval picture = MeshPicture(640, 150, 0.0, -0.7, 6.0, 0.7)\nfor (k in 0 until 5) {\n    val n = 200\n    val r = leaf(k)\n    val mesh = PlanarMesh.outline(\n        DoubleArray(n) { 0.6 * r(2 * PI * it / n) * cos(2 * PI * it / n) + 0.6 + 1.2 * k },\n        DoubleArray(n) { 0.6 * r(2 * PI * it / n) * sin(2 * PI * it / n) },\n        0.04,\n    )\n    picture.mesh(mesh, colors = IntArray(mesh.triangleCount) { 0xFF2E8BBF.toInt() }, edgeAlpha = 0.0)\n}\ndisplay(\"row\", PngEncoder.encode(picture.pixels, 640, 150))\nval table = StringBuilder(\"| | \" + names.joinToString(\" | \") + \" |\\n|---\" + \"|---\".repeat(5) + \"|\\n\")\nfor (a in 0 until 5) table.append(\n    \"| **${names[a]}** | \" + (0 until 5).joinToString(\" | \") { if (it == a) \"·\" else d[a][it].f2 } + \" |\\n\",\n)\nmarkdown(\"readout\", table.toString())\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragm