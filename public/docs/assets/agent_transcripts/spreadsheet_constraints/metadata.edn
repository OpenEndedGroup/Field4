{"version" 2 "boxes" [{"id" "spreadsheet_constraints_temperature" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Temperature · run me" "_tombstone" false "frame" #afield/rect [80.0 80.0 420.0 60.0] "code" #afield/file-inline {"path" "spreadsheet_constraints_temperature_code_.kt" "inline" "// B1 and B2 are variables; B4 says how they are related.\n// Type 37 into B1 and Fahrenheit follows; type 451 into B2 and Celsius follows.\nsheet(height = 200) {\n    rows = 4\n    cols = 2\n    columnWidth(\"A\", 140)\n    this[\"A1\"] = \"Celsius\"\n    formula(\"B1\", \"free(100)\")\n    this[\"A2\"] = \"Fahrenheit\"\n    formula(\"B2\", \"free(212)\")\n    this[\"A3\"] = \"Kelvin\"\n    formula(\"B3\", \"B1 + 273.15\")\n    this[\"A4\"] = \"F from C\"\n    formula(\"B4\", \"B2 eq B1 * 9.0 / 5.0 + 32.0\")\n}\n"}}} {"id" "spreadsheet_constraints_rectangle" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Rectangle · run me" "_tombstone" false "frame" #afield/rect [80.0 380.0 420.0 60.0] "code" #afield/file-inline {"path" "spreadsheet_constraints_rectangle_code_.kt" "inline" "/*\nWidth and height are variables; area and perimeter are ordinary formulas over them.\nThe two assertions hold the area at 40 and the width at no more than 6.\nType 8 into the width: the sheet stops it at 6 and the height takes up the area.\n*/\nsheet(height = 260) {\n    rows = 6\n    cols = 2\n    columnWidth(\"A\", 140)\n    this[\"A1\"] = \"width\"\n    formula(\"B1\", \"free(4)\")\n    this[\"A2\"] = \"height\"\n    formula(\"B2\", \"free(5)\")\n    this[\"A3\"] = \"area\"\n    formula(\"B3\", \"B1 * B2\")\n    this[\"A4\"] = \"perimeter\"\n    formula(\"B4\", \"2 * (B1 + B2)\")\n    this[\"A5\"] = \"area is 40\"\n    formula(\"B5\", \"B3 eq 40\")\n    this[\"A6\"] = \"no wider than 6\"\n    formula(\"B6\", \"B1 le 6\")\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}