{"version" 2 "boxes" [{"id" "sdf_circles" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - sample circles before and after" "_tombstone" false "frame" #afield/rect [60.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "sdf_circles_code_.kt" "inline" "// Two discs joined with min: exact outside, only a bound inside.\nfun disc(cx: Double, cy: Double, r: Double) = { x: Double, y: Double -> hypot(x - cx, y - cy) - r }\nval left = disc(-0.4, 0.0, 0.6)\nval right = disc(0.4, 0.0, 0.6)\nval union = { x: Double, y: Double -> min(left(x, y), right(x, y)) }\n\nval pseudo = sdfGrid2D(xMin = -1.2, yMin = -1.0, xMax = 1.2, yMax = 1.0, n = 13, field = union)\nval fixed = pseudo.repaired()\nprintln(\"pseudo   ${pseudo.consistency()}\")\nprintln(\"repaired ${fixed.consistency()}\")\nval scale = 120.0\nfun circles(grid: SdfGrid2D, dx: Double) = buildList {\n    val nearest = grid.nearestSurfaceDistances()\n    for (j in 0 until grid.ny) for (i in 0 until grid.nx) {\n        val d = grid[i, j]\n        val miss = nearest[j * grid.nx + i] - abs(d) // > 0 falls short, < 0 swallows surface\n        val c = (abs(miss) / grid.h).coerceIn(0.0, 1.0)\n        add(\n            fline { circle((grid.x(i) + dx) * scale, grid.y(j) * scale, abs(d) * scale) }\n                .apply {\n                    color = if (d < 0) vec(0.15 + 0.85 * c, 0.3, 0.7 - 0.5 * c, 0.8) else vec(0.6, 0.6, 0.6, 0.15)\n                },\n        )\n    }\n    val s = grid.surfacePoints()\n    for (k in 0 until s.size / 2) {\n        add(\n            fline { circle((s[2 * k] + dx) * scale, s[2 * k + 1] * scale, 2.0) }\n                .apply {\n                    filled = true\n                    color = vec(1.0, 0.67, 0.0, 1.0)\n                },\n        )\n    }\n}\nlines(circles(pseudo, 0.0) + circles(fixed, 2.6), channel = \"circles\", w = 640.0, h = 260.0, fitToSize = true)\n"}}} {"id" "sdf_offsets" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - offsets from a bound vs a distance" "_tombstone" false "frame" #afield/rect [60.0 420.0 300.0 100.0] "code" #afield/file-inline {"path" "sdf_offsets_code_.kt" "inline" "// A box with a disc cut from its corner by max: the zero set is right, the values beside it are\n// only bounds, so offset curves drawn from them come out in the wrong place.\nfun disc(cx: Double, cy: Double, r: Double) = { x: Double, y: Double -> hypot(x - cx, y - cy) - r }\nfun rect(hx: Double, hy: Double) = { x: Double, y: Double ->\n    val qx = abs(x) - hx\n    val qy = abs(y) - hy\n    hypot(max(qx, 0.0), max(qy, 0.0)) + min(max(qx, qy), 0.0)\n}\nval square = rect(0.8, 0.6)\nval hole = disc(0.8, 0.6, 0.5)\nval cut = { x: Double, y: Double -> max(square(x, y), -hole(x, y)) }\n\nval pseudo = sdfGrid2D(xMin = -1.5, yMin = -1.5, xMax = 1.5, yMax = 1.5, n = 121, field = cut)\nval fixed = pseudo.repaired()\nprintln(\"pseudo   ${pseudo.consistency()}\")\nprintln(\"repaired ${fixed.consistency()}\")\n\n// Offsets at +-0.2 and +-0.4 from each grid; orange is the shape itself.\nval scale = 120.0\nfun offsets(grid: SdfGrid2D, dx: Double) = buildList {\n    for (iso in [-0.4, -0.2, 0.0, 0.2, 0.4]) {\n        val contours = generateIsoContours(grid::bilinear, -1.5, 1.5, -1.5, 1.5, 240, 240, iso)\n        for (c in contours) {\n            add(\n                fline {\n                    moveTo((c[0].x + dx) * scale, c[0].y * scale)\n                    for (p in c) lineTo((p.x + dx) * scale, p.y * scale)\n                    lineTo((c[0].x + dx) * scale, c[0].y * scale)\n                }\n                    .apply {\n                        color = if (iso == 0.0) vec(1.0, 0.67, 0.0, 1.0) else vec(0.0, 0.67, 1.0, 0.8)\n                    },\n            )\n        }\n    }\n}\nlines(offsets(pseudo, 0.0) + offsets(fixed, 3.2), channel = \"offsets\", w = 640.0, h = 300.0, fitToSize = true)\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}