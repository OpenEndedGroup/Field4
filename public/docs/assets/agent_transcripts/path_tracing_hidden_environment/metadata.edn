{"version" 2 "boxes" [{"id" "path_trace_hidden_environment" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "path_trace_renderer"} "name" "environment lighting without a visible sky" "_tombstone" false "frame" #afield/rect [320.0 180.0 350.0 120.0] "code" #afield/file-inline {"path" "path_trace_hidden_environment_code_.kt" "inline" "import afield.four.fabricated.PathTraceDemo\nimport afield.four.fabricated.PathTracingRenderer\nimport afield.four.modules.fromContext\nimport java.io.File\nval renderer: Renderer = fromContext()\nprop<PathTracingRenderer>(tracer)\ntracer = PathTraceDemo.install(renderer,\n    File(\"public/docs/assets/fabricate_demo/venice_sunset_1k.exr\").absolutePath)\ntracer.samplesPerFrame = 1\ntracer.maxBounces = 5\ntracer.indirectClamp = 10f // Optional biased suppression of indirect fireflies.\ntracer.exposure = 1.5f\nprintln(\"${tracer.backend}: ${tracer.triangleCount} triangles, ${tracer.width} x ${tracer.height}\")\ntracer.showEnvironment = false\ntracer.blitToScreen()\n// This coroutine only announces capture readiness; the named scene owns the tracer.\nframes {\n    while (tracer.samples < 1024) { frame() }\n    println(\"hidden environment study converged: ${tracer.samples} samples\")\n}\n"}}} {"id" "path_trace_renderer" "properties" {"children" #{#afield/box "path_trace_hidden_environment"} "parents" #{#afield/box "root"} "name" "path tracing renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 320.0 110.0] "code" #afield/file-inline {"path" "path_trace_renderer_code_.kt" "inline" "import afield.four.util.Options\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nonce.renderer {\n    window = Window(\"Field · Path tracing\")\n    Renderer(window)\n}\nstart(renderer::run)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "intr