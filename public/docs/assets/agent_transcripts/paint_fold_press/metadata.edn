{"version" 2 "boxes" [{"id" "paint_press" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Paint — press a plate and peel it off" "_tombstone" false "frame" #afield/rect [80.0 2400.0 340.0 100.0] "code" #afield/file-inline {"path" "paint_press_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n\n    val canvas = PaintCanvas(900, aspect = 1.4, seed = 8)\n    canvas.work(FLine().rect(150, 150, 700, 420), rgb(0.12, 0.3, 0.55), handling = Handling.Broad, stiff = 0.5)\n    val brush = canvas.brush(BrushKind.HogFlat, width = 90.0)\n    brush.load(rgb(0.95, 0.85, 0.7), amount = 4.0, stiff = 0.5)\n    canvas.stroke(FLine().moveTo(200, 360).lineTo(800, 360), brush, pressure = 1.0..1.0)\n    display(\"before\", canvas.png(wet = true, light = PaintLight.Raking))\n\n    val wet = canvas.wetMm3\n    // a palm-sized plate pressed down left of centre, peeled off toward the right\n    val left = canvas.press(330.0, 360.0, radius = 150.0, pressure = 0.9, take = 0.5, peel = 0.8, ridge = 12.0)\n    // and a lighter press on the right, peeled upward\n    val right = canvas.press(680.0, 360.0, radius = 110.0, pressure = 0.6, dx = 0.0, dy = -1.0, take = 0.4, peel = 0.6)\n    display(\"main\", canvas.png(wet = true, light = PaintLight.Raking))\n    markdown(\"plates lifted %.2f and %.2f mm³; wet paint %.2f mm³ before, %.2f after\".format(\n        left.liftedMm3, right.liftedMm3, wet, canvas.wetMm3))\n}\n"}}} {"id" "paint_fold" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Paint — fold the canvas and open it" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 100.0] "code" #afield/file-inline {"path" "paint_fold_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n\n    val canvas = PaintCanvas(900, aspect = 1.4, seed = 7)\n    val brush = canvas.brush(BrushKind.HogFlat, width = 70.0)\n    val blobs = listOf(\n        rgb(0.75, 0.1, 0.08) to FLine().moveTo(300, 150).cubicTo(380, 200, 440, 260, 500, 290),\n        rgb(0.1, 0.2, 0.6) to FLine().moveTo(230, 360).cubicTo(330, 320, 420, 400, 490, 430),\n        rgb(0.95, 0.75, 0.15) to FLine().moveTo(340, 560).lineTo(500, 520),\n    )\n    for ((color, line) in blobs) {\n        brush.load(color, amount = 4.0, stiff = 0.5)\n        canvas.stroke(line, brush, pressure = 1.0..1.0)\n    }\n    display(\"before\", canvas.png(wet = true, light = PaintLight.Raking))\n\n    val wet = canvas.wetMm3\n    // fold down the middle (the line x = 500, running down), press, open it again\n    val fold = canvas.fold(500.0, 0.0, pressure = 0.9, spread = 0.5, peel = 0.8, ridge = 18.0)\n    display(\"main\", canvas.png(wet = true, light = PaintLight.Raking))\n    markdown(\"fold moved %.1f mm³; wet paint %.2f mm³ before, %.2f after\".format(fold.movedMm3, wet, canvas.wetMm3))\n}\n"}}} {"id" "paint_rub" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Paint — rub a thumb through wet paint" "_tombstone" false "frame" #afield/rect [80.0 4700.0 340.0 100.0] "code" #afield/file-inline {"path" "paint_rub_code_.kt" "inline" "run {\n    if (!PaintCanvas.isAvailable) {\n        markdown(PaintLibrary.describe())\n        return@run\n    }\n\n    val canvas = PaintCanvas(900, aspect = 1.4, seed = 9)\n    val brush = canvas.brush(BrushKind.HogFlat, width = 60.0)\n    for ((i, color) in listOf(rgb(0.8, 0.15, 0.1), rgb(0.95, 0.75, 0.15), rgb(0.1, 0.25, 0.6)).withIndex()) {\n        brush.load(color, amount = 3.0, stiff = 0.4)\n        canvas.stroke(FLine().moveTo(180 + i * 70, 150).lineTo(180 + i * 70, 560), brush, pressure = 1.0..1.0)\n    }\n    display(\"before\", canvas.png(wet = true, light = PaintLight.Raking))\n\n    val wet = canvas.wetMm3\n    // three rubs across the stripes: light, firm, and a curve\n    val light = canvas.rub(FLine().moveTo(120, 220).lineTo(820, 230), radius = 30.0, pressure = 0.4)\n    val firm = canvas.rub(FLine().moveTo(120, 360).lineTo(820, 350), radius = 40.0, pressure = 0.9)\n    val curve = canvas.rub(FLine().moveTo(120, 500).cubicTo(400, 420, 600, 600, 860, 480), radius = 35.0, pressure = 0.7)\n    display(\"main\", canvas.png(wet = true, light = PaintLight.Raking))\n    markdown(\"rubs moved %.1f mm³; wet paint %.2f mm³ before, %.2f after\".format(\n        light.movedMm3 + firm.movedMm3 + curve.movedMm3, wet, canvas.wetMm3))\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}