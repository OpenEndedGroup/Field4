{"version" 2 "boxes" [{"id" "sp_meet" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "meet" "_tombstone" false "frame" #afield/rect [20.0 500.0 190.0 60.0] "code" #afield/file-inline {"path" "sp_meet_code_.kt" "inline" "// Each named stroke is a track; the tracks change only where two playheads meet.\nval strokes = notation.strokes.filter { it.name != null }.associate { it.name!! to it.points }\nval tracks = StrokePlayheadsDocs.tracks(strokes) // the three tracks and their settings\nval run = StrokePlayheads(tracks, MeetingRule.Crossing(windowBeats = 1.0), seed = 4).run(beats = 32.0)\nnotation(\"meetings\") {\n    stroke = \"#f08c00\"\n    for (m in run.meetings) ellipse(m.where.x - 14.0, m.where.y - 14.0, 28.0, 28.0)\n}\nprintln(run.meetings.joinToString(\"\\n\") { \"beat %.2f: %s meets %s\".format(it.beat, it.a, it.b) })\n"}}} {"id" "sp_listen" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "listen back" "_tombstone" false "frame" #afield/rect [580.0 500.0 190.0 60.0] "code" #afield/file-inline {"path" "sp_listen_code_.kt" "inline" "// Each track rendered alone, its onsets and pitches found; the wave's heard transposition.\nval run = StrokePlayheadsDocs.run(StrokePlayheadsDocs.readStrokes(thisBox))\nval heard = StrokePlayheadsDocs.listen(run)\nval shift = StrokePlayheadsDocs.heardTranspositions(run, heard.first { it.track == \"wave\" })\nshowSignals(\n    \"heard transposition\" to shift,\n    x = run.notes.filter { it.track == \"wave\" }.map { it.start },\n    marks = run.meetings.map { \"%s/%s\".format(it.a, it.b) to it.beat },\n    title = \"wave: transposition heard, meetings marked\",\n    xTitle = \"beats\",\n    yTitle = \"semitones\",\n)\nprintln(heard.joinToString(\"\\n\") { it.describe() })\n"}}} {"id" "sp_play" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "play" "_tombstone" false "frame" #afield/rect [300.0 500.0 190.0 60.0] "code" #afield/file-inline {"path" "sp_play_code_.kt" "inline" "// The notes as a pattern: a piano roll per track, and all three in an audio player.\nval run = StrokePlayheadsDocs.run(StrokePlayheadsDocs.readStrokes(thisBox))\nval timed = run.timedNotes()\nval rolls =\n    [\"wave\", \"rise\", \"arc\"].map { name ->\n        name to\n            patTimed(\n                run.notes.filter { it.track == name }.map { TimedNote(it.start, it.end, it.note, it.gain) },\n                beats = 32.0,\n            )\n    }\nshowPatRollOf(*rolls.toTypedArray(), title = \"three playheads\", cycles = 1, pitched = true, channel = \"roll\")\nval voice = patVoice(wave = PatWave.TRIANGLE, decay = 0.004, sustain = 0.4)\nshowPatAudio(patTimed(timed, beats = 32.0), cycles = 1, cps = 1.0 / 16.0, voice = voice, channel = \"audio\")\n"}}} {"id" "sp_strokes" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "strokes" "_tombstone" false "frame" #afield/rect [20.0 40.0 190.0 60.0] "code" #afield/file-inline {"path" "sp_strokes_code_.kt" "inline" "// Three crossing strokes in a frame named \"anima\": wave, rise and arc.\nnotation { threeStrokes() }\nprintln(\"${notation.strokes.size} strokes drawn\")\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "