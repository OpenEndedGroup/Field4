{"version" 2 "boxes" [{"id" "motion_resistance_replay" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "CLoSD — resistance and release" "_tombstone" false "frame" #afield/rect [80.0 80.0 600.0 110.0] "code" #afield/file-inline {"path" "motion_resistance_replay_code_.kt" "inline" "import afield.animation.mocap.*\nimport kotlin.time.Duration.Companion.seconds\n\nval take = MotionRecording(\"%docs/assets/motion_recordings/closd-resistance.f4motion\".path)\nframes {\n    var loop = 0\n    while (true) {\n        MotionSession.replay(take).use { dancer ->\n            playMotion(dancer, 9.seconds) { snapshot ->\n                val t = dancer.telemetry.tether(\"tether\")\n                showMotion(snapshot.frame, dancer.skeleton, follow=true, followHalfLife=.4,\n                    followEpoch=\"${loop}:${snapshot.frame.episode}\", overlays=t?.overlays() ?: emptyList())\n                val action = if (t?.active == true) \"TETHERED · ${\"%.1f\".format(t.stretchMetres*100)} cm · ${\"%.0f\".format(t.forceN)} N\"\n                    else if (snapshot.frame.time >= 4.0) \"RELEASED\" else \"WALKING\"\n                markdown(\"status\", \"**$action** · ${\"%.2f\".format(snapshot.frame.time)} s\\n\\n\" +\n                    \"Recorded CLoSD physics. White: executed · cyan: reference · red: anchor · amber: submitted force (scaled). \" +\n                    \"8000 N/m, 120 N s/m, 2500 N cap. The prompt stays unchanged. Follow camera half-life: 0.4 s.\")\n                displayOpen(\"motion\"); displayOpen(\"status\")\n            }\n        }\n        loop++\n    }\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}