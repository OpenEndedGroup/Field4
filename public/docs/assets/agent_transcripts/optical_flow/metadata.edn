{"version" 2 "boxes" [{"id" "optical_flow" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "agent_graphics_context"} "name" "optical flow" "_tombstone" false "frame" #afield/rect [400.0 160.0 420.0 100.0] "code" #afield/file-inline {"path" "optical_flow_code_.kt" "inline" "import afield.controlGroup\nimport afield.displayOpen\nimport afield.four.vision.*\nimport afield.four.modules.fromContextWithNameOrNull\n\nprop<OpticalFlowDemo>(lab)\nfromContextWithNameOrNull<OpticalFlowDemo>(\"lab\")?.close()\n// AUTO: the VK_NV_optical_flow engine where the device has one, portable pyramidal Lucas–Kanade everywhere else.\nlab=OpticalFlowDemo(renderer,backend=OpticalFlowBackend.AUTO)\nprintln(\"Optical flow backend: ${lab.flow.backend}\")\nvar gain=1f\nvar damping=.98f\n// The two backends report cost on different scales, so the rejection threshold starts at the demo's per-backend default.\nvar cost=lab.costThreshold\nvar deform=true\nvar reset=false\ncontrolGroup(\"optical flow\") {\n    slider(\"Advection gain\",min=0.0,max=3.0,initialValue=1.0) { gain=it.toFloat() }\n    slider(\"Feedback retention\",min=0.0,max=.995,initialValue=.98) { damping=it.toFloat() }\n    slider(\"Reject cost above\",min=0.0,max=6.0*lab.costDisplayRange,initialValue=lab.costThreshold.toDouble()) { cost=it.toFloat() }\n    checkbox(\"Consecutive-frame wiggle\",initialValue=true) { deform=it;reset=true }\n    button(\"Reset feedback and motion hints\") { if(it)reset=true }\n}\ndisplayOpen(\"optical flow\")\nprintln(\"Top: consecutive frames. Below: motion/cost and advected feedback. Turn off wiggle for the (+12, -8) translation check.\")\nframes {\n    var time=0f\n    while(true) {\n        lab.dx=if(deform)0f else 12f;lab.dy=if(deform)0f else -8f;lab.displayRange=if(deform)3f else 20f;lab.gain=gain;lab.damping=damping;lab.costThreshold=cost;lab.deformation=deform\n        lab.update(time,reset);reset=false;time+=lab.pairStep\n        frame()\n    }\n}.end { lab.close() }\n"}}} {"id" "agent_graphics_context" "properties" {"children" #{#afield/box "optical_flow"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "agent_graphics_context_code_.kt" "inline" "import afield.four.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableVR = false\nOptions.enableHDR = false\nOptions.profiling = false\n\nonce.renderer {\n    window = Window(\"Field\")\n    Renderer(window)\n}\n\nprintln(\"agent graphics renderer ready\")\nstart(renderer::run)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}