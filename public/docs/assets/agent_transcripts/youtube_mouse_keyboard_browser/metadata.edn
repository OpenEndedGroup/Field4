{"version" 2 "boxes" [{"id" "youtube_desktop_renderer" "properties" {"children" #{#afield/box "youtube_desktop_panel"} "parents" #{#afield/box "root"} "name" "16:9 window + renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 330.0 100.0] "code" #afield/file-inline {"path" "youtube_desktop_renderer_code_.kt" "inline" "import afield.Rect\nimport afield.four.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\nOptions.enableVR = false\nOptions.profiling = false\n\nonce.renderer {\n    window = Window(\n        \"YouTube · mouse + keyboard\",\n        initialDimensions = Rect(80.0, 80.0, 1280.0, 720.0)\n    )\n    Renderer(window)\n}\n\nprintln(\"YouTube mouse + keyboard renderer ready\")\nstart(renderer::run)\n"}}} {"id" "youtube_desktop_panel" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "youtube_desktop_renderer"} "name" "YouTube — direct mouse + keyboard" "_tombstone" false "frame" #afield/rect [330.0 140.0 420.0 100.0] "code" #afield/file-inline {"path" "youtube_desktop_panel_code_.kt" "inline" "import afield.four.Target\nimport afield.four.browser.FieldUiBrowserTexture\nimport afield.four.browser.PuppetBrowserWindowPanel\nimport afield.four.modules.fromContext\n\nval renderer: Renderer = fromContext()\nprop<afield.four.browser.PuppetBrowser>(browserControl)\n\nval browser = FieldUiBrowserTexture(\n    renderer = renderer,\n    url = \"https://www.youtube.com/watch?v=aqz-KE-bpKQ\",\n    width = 1280,\n    height = 720,\n    // Linux: Chromium's shared-texture export never fills the buffer (electron#53271).\n    cpuBitmapFallback = FieldUiBrowserTexture.cpuBitmapFallbackRequired\n)\nbrowserControl = browser\n\nrenderer.renderList.preTargets[\"youtube-desktop-browser-upload\"] =\n    Target { command, _ -> browser.prepareSampledImagesFor(command) }\n\n// This is direct window input, not a synthetic controller ray. The panel letterboxes if\n// the window is resized and uses that same fitted rectangle for its mouse hit test.\nval screen = PuppetBrowserWindowPanel(renderer, browser, \"youtube-desktop-browser\")\nscreen.build(takeFocus = true)\n\nvar announced = false\nloop {\n    if (!announced && browser.pageReady) {\n        announced = true\n        println(\"YouTube is live: click, scroll and type directly in the Chromium page\")\n    }\n    frame()\n}.end {\n    renderer.renderList.preTargets.remove(\"youtube-desktop-browser-upload\")\n    screen.close()\n    browser.close()\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}