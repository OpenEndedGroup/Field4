{"version" 2 "boxes" [{"id" "cs_offline" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "offline sine" "_tombstone" false "frame" #afield/rect [40.0 160.0 160.0 80.0] "code" #afield/file-inline {"path" "cs_offline_code_.kt" "inline" "// One second of a 440 Hz sine, rendered without an audio device, then measured.\nval (left, right) = csoundOffline(\"\"\"\ninstr 1\n  aenv linen 0.25, 0.01, p3, 0.05\n  a1 oscili aenv, 440\n  outs a1, a1\nendin\n\"\"\", \"i1 0 1\", wav = java.io.File(System.getProperty(\"java.io.tmpdir\"), \"csound_sine.wav\"))\nval ups = (1 until 48000).count { left[it - 1] < 0f && left[it] >= 0f }\nval peak = left.maxOf { abs(it) }\nprintln(\"$ups upward zero crossings in the first second, peak ${\"%.3f\".format(peak)}, channels equal: ${left.contentEquals(right)}\")\n"}}} {"id" "cs_status" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "status" "_tombstone" false "frame" #afield/rect [40.0 40.0 420.0 80.0] "code" #afield/file-inline {"path" "cs_status_code_.kt" "inline" "println(afield.csound.CsoundLibrary.describe())\n"}}} {"id" "cs_error" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "an error" "_tombstone" false "frame" #afield/rect [610.0 160.0 160.0 80.0] "code" #afield/file-inline {"path" "cs_error_code_.kt" "inline" "// oscilx is not an opcode (oscili is). Run it: the error is marked on line 4.\ncsoundOffline(\"\"\"\ninstr 1\n  a1 oscilx 0.2, 440\n  outs a1, a1\nendin\n\"\"\", \"i1 0 1\")\n"}}} {"id" "cs_drone" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "drone" "_tombstone" false "frame" #afield/rect [230.0 160.0 160.0 80.0] "code" #afield/file-inline {"path" "cs_drone_code_.kt" "inline" "// Launch it, then move the sliders. chn_k declares each channel's default and range.\nval drone = csound(\"\"\"\nchn_k \"pitch\", 1, 2, 110, 55, 440\nchn_k \"cutoff\", 1, 2, 1200, 200, 6000\ninstr 1\n  kf chnget \"pitch\"\n  kc chnget \"cutoff\"\n  kf port kf, 0.05\n  kc port kc, 0.05\n  a1 vco2 0.12, kf\n  a1 moogladder a1, kc, 0.3\n  outs a1, a1\n  printks \"level %.3f\\n\", 1, rms(a1)\nendin\n\"\"\", \"i1 0 z\")\ncsoundControls(drone)\ndrone\n"}}} {"id" "cs_events" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "events" "_tombstone" false "frame" #afield/rect [420.0 160.0 160.0 80.0] "code" #afield/file-inline {"path" "cs_events_code_.kt" "inline" "// Launch it: Kotlin writes the score, one note every quarter second.\nval cs = csound(\"\"\"\ninstr 1\n  aenv expseg 0.001, 0.005, 0.2, p3, 0.001\n  a1 oscili aenv, cpsmidinn(p4)\n  outs a1, a1\n  prints \"note %d\\n\", p4\nendin\n\"\"\")\nval notes = listOf(57, 60, 64, 67, 69, 67, 64, 60)\nvar i = 0\ncs.every(0.25) { event('i', 1, 0, 0.4, notes[i++ % notes.size]) }\ncs\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}