{"version" 2 "boxes" [{"id" "cs_keys" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "keys" "_tombstone" false "frame" #afield/rect [230.0 320.0 160.0 80.0] "code" #afield/file-inline {"path" "cs_keys_code_.kt" "inline" "// Launch \"pluck\" first, then launch this: MIDI notes into its massign'ed instr Key.\nval pluck = csoundOf(\"pluck\").csound\nval notes = listOf(62, 65, 69, 72, 69, 65)\nvar i = 0\nloop {\n    val note = notes[i++ % notes.size]\n    pluck.noteOn(0, note, 90)\n    delay(220)\n    pluck.noteOff(0, note)\n    delay(30)\n}\n"}}} {"id" "cs_table" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "a table from Kotlin" "_tombstone" false "frame" #afield/rect [610.0 180.0 160.0 80.0] "code" #afield/file-inline {"path" "cs_table_code_.kt" "inline" "// A wavetable computed in Kotlin, copied into ftable 1, played by poscil, and read back.\nval cs = afield.csound.CsoundInstance(\"\"\"\ngiWave  ftgen  1, 0, 4096, 10, 1\ninstr Play\n  asig  poscil  0.3, 220, giWave\n  outs    asig, asig\nendin\n\"\"\", \"i \\\"Play\\\" 0 0.1\")\nval partials = listOf(1.0, 0.0, 0.33, 0.0, 0.2, 0.0, 0.14)     // odd harmonics: a square-ish wave\nval wave = DoubleArray(cs.tableLength(1)) { i ->\n    val ph = 2 * PI * i / 4096\n    partials.withIndex().sumOf { (k, a) -> a * sin((k + 1) * ph) }\n}\ncs.writeTable(1, wave)\nval back = cs.table(1)!!\nval (left, _) = cs.renderOffline()\ncs.close()\nprintln(\"wrote ${wave.size} values; read back equal: ${wave.contentEquals(back)}; rendered ${left.size} frames, peak ${\"%.3f\".format(left.maxOf { abs(it) })}\")\nshowSignals(\"ftable 1, read back\" to (0 until 4096 step 8).map { back[it] }, channel = \"table\", title = \"ftable 1, written from Kotlin\")\nshowSignals(\"poscil 220 Hz\" to (0 until 480).map { left[it] }, channel = \"played\", title = \"what poscil plays from it\")\n"}}} {"id" "cs_typo" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "cs_root"} "name" "typo" "_tombstone" false "frame" #afield/rect [420.0 180.0 160.0 80.0] "code_language" "Csound" "code" #afield/file-inline {"path" "cs_typo_code_.kt" "inline" "<CsoundSynthesizer>\n<CsInstruments>\ninstr Beep\n  asig  oscilx  0.2, 440       ; there is no oscilx: Csound's error lands on this line\n  outs    asig, asig\nendin\n</CsInstruments>\n<CsScore>\ni \"Beep\" 0 1\n</CsScore>\n</CsoundSynthesizer>\n"}}} {"id" "cs_root" "properties" {"children" #{#afield/box "cs_pluck" #afield/box "cs_fx" #afield/box "cs_typo"} "parents" #{#afield/box "root"} "name" "csound — children of this box are Csound" "_tombstone" false "frame" #afield/rect [40.0 40.0 420.0 80.0] "mainLanguage" "csound" "code" #afield/file-inline {"path" "cs_root_code_.kt" "inline" "// This root stays Kotlin; its `mainLanguage` makes the boxes under it Csound.\nprintln(afield.csound.CsoundLibrary.describe())\n"}}} {"id" "cs_pluck" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "cs_root"} "name" "pluck" "_tombstone" false "frame" #afield/rect [40.0 180.0 160.0 80.0] "code_language" "Csound" "code" #afield/file-inline {"path" "cs_pluck_code_.kt" "inline" "<CsoundSynthesizer>\n<CsOptions>\n-m0\n</CsOptions>\n<CsInstruments>\n; sr, ksmps, nchnls and 0dbfs come from Field: 48000, 32, 2 and 1.\n\nchn_k \"cutoff\", 1, 3, 2400, 200, 8000   ; written by Field, read here\nchn_k \"level\",  2                       ; written here, read by Field\nchn_S \"voice\",  3\n\nmassign 0, \"Key\"                        ; MIDI notes, from any channel\n\ninstr Pluck                             ; p4 MIDI note, p5 level in dBFS\n  icps  =         cpsmidinn(p4)\n  asig  pluck     ampdbfs(p5), icps, icps, 0, 1\n  kcut  chnget    \"cutoff\"\n  kcut  port      kcut, 0.02\n  asig  butterlp  asig, kcut\n  aenv  linsegr   1, p3, 1, 0.3, 0\n  asig  =         asig * aenv\n  chnmix    asig * 0.25, \"reverb\"\n  outs      asig, asig\nendin\n\ninstr Key\n  inote notnum\n  prints    \"Key %d\\n\", inote\n  icps  cpsmidi\n  iamp  ampmidi   0.3\n  asig  pluck     iamp, icps, icps, 0, 1\n  aenv  madsr     0.005, 0.1, 0.6, 0.4\n  chnmix    asig * aenv * 0.25, \"reverb\"\n  outs      asig * aenv, asig * aenv\nendin\n\ninstr Reverb\n  ain     chnget    \"reverb\"\n  aL, aR  reverbsc  ain, ain, 0.85, 10000\n  outs      aL, aR\n  chnclear  \"reverb\"\n  krms    rms       aL + ain\n  chnset    krms, \"level\"\n  outvalue  \"level\", krms\n  Svoice  chnget    \"voice\"\n  outvalue  \"said\", Svoice\nendin\n</CsInstruments>\n<CsScore>\ni \"Reverb\" 0 z\ni \"Pluck\"  0    0.5  57  -12\ni .        +    .    60  .\ni .        +    .    64  .\ni .        +    1.5  67  -9\n; Alt-Enter one of these while the box plays:\ni \"Pluck\"  0    1    69  -9\ni \"Pluck\"  0    2    45  -6\n</CsScore>\n</CsoundSynthesizer>\n"}}} {"id" "cs_fx" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "cs_root"} "name" "fx" "_tombstone" false "frame" #afield/rect [230.0 180.0 160.0 80.0] "code_language" "Csound" "code" #afield/file-inline {"path" "cs_fx_code_.kt" "inline" "<CsoundSynthesizer>\n<CsInstruments>\n; The a-rate channel \"in\" is fed by Field: launch \"Field into fx\".\nchn_a \"in\",  1\nchn_a \"wet\", 2\n\ninstr Space\n  ain     chnget    \"in\"\n  aL, aR  reverbsc  ain, ain, 0.9, 8000\n  outs      ain * 0.5 + aL * 0.5, ain * 0.5 + aR * 0.5\n  chnset    aL, \"wet\"\nendin\n</CsInstruments>\n<CsScore>\ni \"Space\" 0 z\n</CsScore>\n</CsoundSynthesizer>\n"}}} {"id" "cs_talk" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "talk to pluck" "_tombstone" false "frame" #afield/rect [40.0 320.0 160.0 80.0] "code" #afield/file-inline {"path" "cs_talk_code_.kt" "inline" "// Launch \"pluck\" first. Every line here talks to the Csound it is playing.\nval pluck = csoundOf(\"pluck\").csound\n\npluck.setChannel(\"cutoff\", 900)                 // chnget \"cutoff\" reads it next k-cycle\npluck.setStringChannel(\"voice\", \"from Kotlin\")  // an S channel; Reverb outvalues it back\nprintln(\"level now: ${\"%.4f\".format(pluck.channel(\"level\"))}\")\n\n// Every channel the orchestra allocated, with the range chn_k declared for it.\npluck.channels().forEach { c -> println(\"${c.name}: ${c.hints?.let { \"${it.default} in ${it.min}..${it.max}\" } ?: \"no hints\"}\") }\n\n// Score events with p-fields from Kotlin values: a rising arpeggio, half a second apart.\nlistOf(57, 60, 64, 69).forEachIndexed { k, note ->\n    pluck.event(\"i \\\"Pluck\\\" ${k * 0.5} 0.5 $note -12\")\n}\n\n// outvalue calls back on Field's main thread.\npluck.onOutvalue(\"said\") { println(\"Csound said: $it\") }\nvar n = 0\npluck.onOutvalue(\"level\") { v -> if (n++ % 40 == 0) display(\"level\", \"<div style='padding:8px'>Reverb rms ${\"%.4f\".format(v as Double)}</div>\") }\n"}}} {"id" "cs_into_fx" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Field into fx" "_tombstone" false "frame" #afield/rect [420.0 320.0 160.0 80.0] "code" #afield/file-inline {"path" "cs_into_fx_code_.kt" "inline" "// Launch \"fx\" first. A Field sawtooth goes into its a-rate channel \"in\"; the reverb's\n// left channel, chnset into \"wet\", comes back as a Field signal that Field plays.\nval fx = csoundOf(\"fx\")\nval saw = SawOsc(Param(110f)) * Param(0.15f)\nfx.node.connect(\"in\", saw)\nfx.node.audioOut(\"wet\").pan(-0.5f)\n"}}} {"id" "cs_measured" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "through Csound, measured" "_tombstone" false "frame" #afield/rect [610.0 320.0 160.0 80.0] "code" #afield/file-inline {"path" "cs_measured_code_.kt" "inline" "// Offline: a Field 1 kHz sine through Csound's butterlp at 500 Hz, and back.\nval cs = afield.csound.CsoundInstance(\"\"\"\ninstr Filter\n  ain   chnget    \"in\"\n  alow  butterlp  ain, 500\n  chnset    alow, \"low\"\nendin\n\"\"\", \"i \\\"Filter\\\" 0 z\")\nval node = cs.node(audioIn = mapOf(\"in\" to SineOsc(Param(1000f))))\nval (dry, low) = renderSignalsOffline(0.5, SineOsc(Param(1000f)), node.audioOut(\"low\"))\ncs.close()\n\nfun rms(x: FloatArray) = sqrt(x.drop(4800).sumOf { it.toDouble() * it } / (x.size - 4800))\nval expected = 1.0 / sqrt(1.0 + 16.0)    // a 2nd-order Butterworth at twice its cutoff\nprintln(\"in rms ${\"%.4f\".format(rms(dry))}, out rms ${\"%.4f\".format(rms(low))}: gain ${\"%.4f\".format(rms(low) / rms(dry))}, Butterworth says ${\"%.4f\".format(expected)}\")\nval window = 4800 until 5040\nshowSignals(\"Field sine\" to window.map { dry[it] }, \"after Csound's butterlp\" to window.map { low[it] },\n    x = window.map { it / 48.0 }, channel = \"signals\", title = \"1 kHz in, butterlp 500 Hz, back to Field\", xTitle = \"ms\")\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "mainLanguage"]}