{"version" 2 "boxes" [{"id" "rectsl_region" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "RectSL: protect the rest of the wall" "_tombstone" false "frame" #afield/rect [70.0 80.0 400.0 100.0] "code" #afield/file-inline {"path" "rectsl_region_code_.kt" "inline" "import afield.lang.rectsl.study.RectSLStudy\nimport afield.study.source.SourceStudy\nimport kotlin.io.path.createTempDirectory\n\nval scene =\n    \"\"\"\n    ->wall 16 9 meters\n    ->duration 4\n    ->background 0x161e2e\n\n    \"sun\" rect\n      -4 1 ->xy\n      3 ->square\n      0xeab962 solid ->fill\n    ;\n\n    \"moon\" rect\n      4 -1 ->xy\n      2 ->square\n      0xabbceb solid ->fill\n      '( 0=4  4=5 ) ->x\n    ;\"\"\".trimIndent()\nval moonFill = \"0xabbceb\"\nval sunFill = \"0xeab962\"\nval localEdit = scene.replace(moonFill, \"0x93e5bb\")\nval spillEdit = localEdit.replace(sunFill, \"0xdb756f\")\nval allowed = listOf(2.5, -2.5, 6.5, 0.5) // x0, y0, x1, y1 in metres\nval times = listOf(0.0, 2.0, 3.5)\n\nval folder = createTempDirectory(\"rectsl-region-\").toFile()\ntry {\n    var source = scene\n    val study =\n        RectSLStudy(folder, { source }) { expected, replacement ->\n            if (source != expected) false\n            else {\n                source = replacement\n                true\n            }\n        }\n    val baseline = study.checkIn(\"Original wall\").revision\n    for ((label, candidate) in [(\"Moon only\" to localEdit), (\"Moon and sun\" to spillEdit)]) {\n        val revision = study.edit(study.currentId(), SourceStudy.hash(source), candidate, label).revision\n        val report = study.compare(baseline, revision, seconds = times, region = allowed, size = 192)\n        val held = report.facts[\"preservedOutsideRegion\"] == true\n        val verdict = if (held) \"pass\" else \"changed outside the allowed rectangle\"\n        display(label, \"<p><strong>$verdict</strong></p>\" + report.h)\n        displayOpen(label)\n        println(\"$label: $verdict\")\n    }\n} finally {\n    folder.deleteRecursively()\n}\n"}}} {"id" "stacksl_region" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "StackSL: protect the left half" "_tombstone" false "frame" #afield/rect [980.0 80.0 385.0 100.0] "code" #afield/file-inline {"path" "stacksl_region_code_.kt" "inline" "import afield.lang.stacksl.study.StackSLStudy\nimport afield.study.source.SourceStudy\nimport kotlin.io.path.createTempDirectory\n\nval program = \"uv saturate\"\nval localEdit = \"$program\\nwhite 0.5 uv x step mix\"\nval spillEdit = \"$program\\nwhite 0.35 uv x step mix\"\nval allowed = listOf(0.5, 0.0, 1.0, 1.0) // x0, y0, x1, y1 in UV space\nval times = listOf(0.0)\n\nval folder = createTempDirectory(\"stacksl-region-\").toFile()\ntry {\n    var source = program\n    val study =\n        StackSLStudy(folder, { source }) { expected, replacement ->\n            if (source != expected) false\n            else {\n                source = replacement\n                true\n            }\n        }\n    val baseline = study.checkIn(\"Original shader\").revision\n    for ((label, candidate) in [(\"Right half\" to localEdit), (\"Mask crosses the midpoint\" to spillEdit)]) {\n        val revision = study.edit(study.currentId(), SourceStudy.hash(source), candidate, label).revision\n        val report = study.compare(baseline, revision, seconds = times, region = allowed, size = 128)\n        val held = report.facts[\"preservedOutsideRegion\"] == true\n        val verdict = if (held) \"pass\" else \"changed outside the allowed rectangle\"\n        display(label, \"<p><strong>$verdict</strong></p>\" + report.h)\n        displayOpen(label)\n        println(\"$label: $verdict\")\n    }\n} finally {\n    folder.deleteRecursively()\n}\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}