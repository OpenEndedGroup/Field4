{"version" 2 "boxes" [{"id" "rig_measure" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3. Measure: round trip and aliasing (run)" "_tombstone" false "frame" #afield/rect [60.0 560.0 380.0 70.0] "code" #afield/file-inline {"path" "rig_measure_code_.kt" "inline" "import afield.io.dmx.*\nimport afield.lang.rectsl.*\n\n/*\nThe page's measurements, on this machine: nine frames sent and received back on a free port the\nsystem picks (so this can run beside boxes 1 and 2), and a thin line swept across the rig,\nsampled two ways.\n*/\nval trip = SceneOnARig.roundTrip()\nprintln(trip)\n\nval frameCount = 121\nval lineWidth = 0.25\nval frameWidth = 256\nval frameHeight = 128\nval line = RectSLImager(\n    \"\"\"\n    #rectsl\n    ->wall 16 8 abstract\n    ->background 0x000000\n    ->duration 4\n    ->fps 30\n\n    \"sweep\" rect\n      $lineWidth 8 ->wh\n      0xffffff solid ->fill\n      '( 0=-8  4=8 ) linear ->x\n    ;\"\"\".trimIndent(),\n)\nval sampleRig = SceneOnARig.Rig()\nval point = SceneOnARig.SamplingTrace(\"point\", DoubleArray(frameCount), DoubleArray(frameCount))\nval area = SceneOnARig.SamplingTrace(\"area\", DoubleArray(frameCount), DoubleArray(frameCount))\nval lineTruth = lineWidth * SceneOnARig.ROWS\n\n// Keep the line wholly on the wall; compare both routes at exactly the same times.\nfor (k in 0 until frameCount) {\n    val t = 0.5 + 3.0 * k / (frameCount - 1.0)\n    val image = line.frame(t, frameWidth, frameHeight, linear = true)\n    for ((trace, averageFirst) in [point to false, area to true]) {\n        val sampled = if (averageFirst) image.resize(SceneOnARig.COLS, SceneOnARig.ROWS) else image\n        sampleRig.patch.mapImage(sampled, only = sampleRig.grid)\n        var total = 0.0\n        var peak = 0.0\n        for (fixture in sampleRig.grid) {\n            // A fully white fixture contributes one unit of light.\n            val brightness = (fixture.color.x + fixture.color.y + fixture.color.z) / 3.0\n            total += brightness\n            peak = maxOf(peak, brightness)\n        }\n        trace.total[k] = total\n        trace.peak[k] = peak\n    }\n}\nprintln(\n    \"point samples: dark in ${point.darkFrames} of ${point.total.size} frames, light on the rig ${point.min.f2}..${point.max.f2}\",\n)\nprintln(\n    \"area average:  dark in ${area.darkFrames} frames, light on the rig ${area.min.f3}..${area.max.f3} (the line is worth ${lineTruth})\",\n)\n"}}} {"id" "rig_receiver" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2. Receiver: the rig lit by what arrived (launch)" "_tombstone" false "frame" #afield/rect [1120.0 60.0 380.0 70.0] "code" #afield/file-inline {"path" "rig_receiver_code_.kt" "inline" "import afield.io.dmx.*\n\n/*\nField as an sACN node on the sender's port (35690, fixed so the two boxes agree; change both\ntogether). It knows where the fixtures are (the same layout),\nand nothing else: every colour drawn here was decoded from the universes that arrived.\n*/\nval node = sacnIn(port = 35690)\nval layout = SceneOnARig.Rig()\n\n// Redrawn ten times a second: the rig lit by what arrived, then universe 1 in wire order\n// (128 RGB pixels, then the unused slots).\nloop {\n    showReceived(layout.patch, node, channel = \"received\", w = 480.0, h = 300.0)\n    showUniverse(node, 1, cols = 16, w = 480.0, h = 300.0)\n    delay(100)\n}\n"}}} {"id" "scene_sender" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1. Scene on the rig: RectSL to sACN (launch)" "_tombstone" false "frame" #afield/rect [60.0 60.0 380.0 70.0] "code" #afield/file-inline {"path" "scene_sender_code_.kt" "inline" "import afield.io.dmx.*\nimport afield.lang.rectsl.*\n\n// A RectSL scene, drawn on the CPU, on a light rig. Edit the scene and launch again: the receiver\n// box shows what arrives. (Try the line's width, 0.25 ->wh below, or area = false further down.)\nval scene = RectSLImager(\n    \"\"\"\n#rectsl\n->wall 16 8 abstract\n->background 0x0c1024\n->duration 4\n->fps 30\n\n\"sun\" rect\n  4 4 ->wh\n  0xff7a1a solid ->fill\n  '( 0=-5  2=5  4=-5 ) ->x\n  '( 0=0  4=3.14159 ) ->rot\n;\n\n\"band\" rect\n  16 1.5 ->wh\n  0 -3.25 ->xy\n  0x2a9df4 solid ->fill\n  '( 0=0.15  2=1  4=0.15 ) ->alpha\n;\n\n\"sweep\" rect\n  0.25 8 ->wh\n  0xffffff solid ->fill\n  '( 0=-8  4=8 ) linear ->x\n;\n\"\"\",\n)\n\n// 16 x 8 RGB pixels in universe 1 and four RGBWA washes in universe 2: one fixture per wall unit.\nval rig = SceneOnARig.Rig()\n\n// sACN, unicast to this machine. The port is fixed at 35690 on purpose, so that box 2 can listen on\n// the same number without the two boxes having to find each other; change both if it is taken.\nval out = sacnOut(\"127.0.0.1\", port = 35690)\n\n/*\nOn the sender's own 44 Hz clock: draw the scene at t, shrink it to one pixel per fixture\n(area averaging), colour the fixtures, send. area = false samples the full frame at each\nfixture instead, and the thin line flickers as it crosses the rig.\n*/\nrig.patch.animate(out) { t ->\n    rig.show(scene.frame(t % scene.duration, 256, 128), area = true)\n}\n\n// The look that is being sent, in the rig's layout, redrawn ten times a second.\nloop {\n    showPatch(rig.patch, channel = \"sent\", w = 480.0, h = 300.0)\n    delay(100)\n}\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}