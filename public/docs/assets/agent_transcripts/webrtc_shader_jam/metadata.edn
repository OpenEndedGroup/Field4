{"version" 2 "boxes" [{"id" "webrtc_publish_shader" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "webrtc_renderer"} "name" "publish a shader" "_tombstone" false "frame" #afield/rect [40.0 200.0 300.0 100.0] "code" #afield/file-inline {"path" "webrtc_publish_shader_code_.kt" "inline" "import afield.media.webrtc.webrtcSink\n\n// Published as login/field-shader: your aaaframe login, or this computer's user name on\n// Field's own relay. A browser ShaderTrinket receives it by that name. To join a class,\n// run WebRTCNetwork.join(\"https://<your aaaframe>\") once; Field asks you to sign in.\n@exported val sink = webrtcSink(\"field-shader\", 640, 360)\n\nval module = moduleHere { +sink }\nval quad = Mesh()\nmodule += \"quad\" to quad\nsink += \"content\" to module\n\nquad.clock = { vec(System.nanoTime() / 1e9, 0.0, 0.0, 0.0) }\nquad.set(4, 2) {\n    pos.add(-1, -1, 0)\n    pos.add(1, -1, 0)\n    pos.add(1, 1, 0)\n    pos.add(-1, 1, 0)\n    tri.add(0, 1, 2)\n    tri.add(0, 2, 3)\n}\n\ndisplay(\"main\", sink.html())\n"} "vertex" #afield/file-inline {"path" "webrtc_publish_shader_vertex_.glsl" "inline" "#version 450\nlayout(location = 0) in vec3 pos;\n\nvoid main() {\n    gl_Position = vec4(pos.xy, 0.0, 1.0);\n}\n"} "fragment" #afield/file-inline {"path" "webrtc_publish_shader_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 color;\n\nlayout(push_constant) uniform constants {\n    vec4 clock;\n} pc;\n\nvoid main() {\n    vec2 uv = (gl_FragCoord.xy - vec2(320.0, 180.0)) / 180.0;\n    float t = pc.clock.x;\n    float r = length(uv);\n    float a = atan(uv.y, uv.x);\n    float rings = 0.5 + 0.5 * sin(10.0 * r - 3.0 * t + 4.0 * sin(3.0 * a + t));\n    vec3 tint = 0.5 + 0.5 * cos(vec3(0.0, 2.1, 4.2) + t + 2.0 * r);\n    color = vec4(tint * rings * smoothstep(1.6, 0.2, r), 1.0);\n}\n"}}} {"id" "webrtc_renderer" "properties" {"children" #{#afield/box "webrtc_publish_shader" #afield/box "webrtc_receive_stream"} "parents" #{#afield/box "root"} "name" "WebRTC window + renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "webrtc_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\nOptions.enableVR = false\n\nonce.renderer {\n    window = Window(\"WebRTC shader jam\", initialDimensions = Rect(80.0, 80.0, 960.0, 540.0))\n    Renderer(window)\n}\n\nprintln(\"WebRTC renderer ready\")\nstart(renderer::run)\n"}}} {"id" "webrtc_receive_stream" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "webrtc_renderer"} "name" "receive a stream as a texture" "_tombstone" false "frame" #afield/rect [640.0 200.0 340.0 100.0] "code" #afield/file-inline {"path" "webrtc_receive_stream_code_.kt" "inline" "import afield.media.webrtc.webrtcPublishers\nimport afield.media.webrtc.webrtcSource\n\n// Until you pick someone, show the first publisher on the network (on Field's own relay,\n// that is the box beside this one).\nval publishers = webrtcPublishers()\nval source = webrtcSource(publishers.names.firstOrNull() ?: \"nobody\", 640, 360)\npublishers.onChange { names ->\n    if (source.target == \"nobody\" && names.isNotEmpty()) source.watch(names.first())\n}\npublishers.onPick { name -> source.watch(name) }\ndisplay(\"publishers\", publishers.html { source.target })\n\nval material = moduleHere { textures(\"remote\" to source) }\nval screen = Mesh()\nmaterial += \"screen\" to screen\nrenderer += \"webrtc-remote\" to material\n\nscreen.set(4, 2) {\n    pos.add(-0.9, -0.9, 0.0)\n    pos.add(0.9, -0.9, 0.0)\n    pos.add(0.9, 0.9, 0.0)\n    pos.add(-0.9, 0.9, 0.0)\n    tc.add(0, 0, 1, 0, 1, 1, 0, 1)\n    tri.add(0, 1, 2, 0, 2, 3)\n}\n\nvar said = \"\"\nloop {\n    val line = \"@${source.target}: ${source.status}\"\n    if (line != said) println(line)\n    said = line\n    frame()\n}\n"} "vertex" #afield/file-inline {"path" "webrtc_receive_stream_vertex_.glsl" "inline" "#version 450\nlayout(location = 0) in vec3 pos;\nlayout(location = 1) in vec2 tc;\nlayout(location = 1) out vec2 ftc;\n\nvoid main() {\n    gl_Position = vec4(pos, 1.0);\n    ftc = tc;\n}\n"} "fragment" #afield/file-inline {"path" "webrtc_receive_stream_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 color;\nlayout(location = 1) in vec2 ftc;\nlayout(set = 0, binding = 0) uniform sampler2D remote;\n\nvoid main() {\n    color = vec4(texture(remote, vec2(ftc.x, 1.0 - ftc.y)).rgb, 1.0);\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}