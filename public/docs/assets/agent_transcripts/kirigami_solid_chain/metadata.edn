{"version" 2 "boxes" [{"id" "kirigami_deployed" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "the same solid, opened" "_tombstone" false "frame" #afield/rect [60.0 1600.0 420.0 90.0] "code" #afield/file-inline {"path" "kirigami_deployed_code_.kt" "inline" "import afield.examples.chain.KirigamiSolidChain\nimport kotlin.math.cos\nimport kotlin.math.sin\n\nval closed = KirigamiSolidChain.measure(angle = 0.0)\nval stages = listOf(0.0, 15.0, 30.0, 45.0).map { it to KirigamiSolidChain.measure(angle = Math.toRadians(it)) }\nfor ((deg, m) in stages) {\n    val s = cos(m.angle) + sin(m.angle)\n    println(\n        \"%4.0f deg  genus %d  parts %d  hull area x%.3f  (cos+sin)^2 %.3f  hinge gap %.0e\".format(\n            deg, m.genus, m.parts, m.hullArea / closed.hullArea, s * s, m.hingeGap,\n        ),\n    )\n}\n\nshowImgGrid(\n    *stages\n        .map { (deg, m) ->\n            \"${deg.toInt()} deg, genus ${m.genus}\" to\n                imgFromBytes(m.mesh.renderPng(MeshView(yawDegrees = 0.0, pitchDegrees = 55.0, width = 520, height = 520)))\n        }\n        .toTypedArray(),\n    columns = 4,\n    cellSide = 300,\n)\n"}}} {"id" "kirigami_cut_plate" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "the closed sheet, cut with hinges you can make" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 90.0] "code" #afield/file-inline {"path" "kirigami_cut_plate_code_.kt" "inline" "import afield.examples.chain.KirigamiSolidChain\n\n// gap: half a slit's width. bridge: how far each hinge bar runs along its cut.\nval n = 8\nval gap = 0.04\nval bridge = 0.12\nval plate = KirigamiSolidChain.measure(n, angle = 0.0, thickness = 0.1, gap = gap, bridge = bridge)\n\nval report = listOf(\n    \"${plate.tiles} tiles, ${plate.hinges} hinges\",\n    \"genus ${plate.genus}, and hinges - tiles + 1 = ${plate.predictedGenus}\",\n    \"${plate.parts} part, watertight=${plate.watertight}\",\n    \"volume %.6f = area %.6f x thickness 0.1\".format(plate.volume, plate.sectionArea),\n)\nreport.forEach { println(it) }\ndisplay(\"numbers\", \"<pre>${report.joinToString(\"\\n\")}</pre>\")\ndisplay(\n    \"render\",\n    imgFromBytes(plate.mesh.renderPng(MeshView(yawDegrees = 0.0, pitchDegrees = 70.0, width = 760, height = 620))),\n)\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}