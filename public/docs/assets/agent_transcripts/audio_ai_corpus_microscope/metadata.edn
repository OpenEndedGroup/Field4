{"version" 2 "boxes" [{"id" "index_and_explore_corpus" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 · index Nancy and Candlestick, then explore" "_tombstone" false "frame" #afield/rect [520.0 40.0 440.0 100.0] "code" #afield/file-inline {"path" "index_and_explore_corpus_code_.kt" "inline" "import java.util.concurrent.CancellationException\nimport java.util.concurrent.CompletableFuture\n\nval client = FieldAudioClient()\nval sourceNames = [\"*Nancy*\", \"*Candlestick Park*\"]\nval queryStartSeconds = 18.0\nval queryDurationSeconds = 6.0\nval neighbourCount = 12\nval weights = CorpusDistanceWeights(harmony = 0.8, pitch = 0.55, texture = 1.35, rhythm = 0.7, dynamics = 0.35)\n\ndisplay(\"job monitor\", fieldAudioJobMonitor(heightPixels = 330))\nrunAsync<Pair<AudioAsset, CorpusPreview>>(\n    onResult = { (nancy, preview) ->\n        val canonical = nancy.representations.first { it.role == \"canonical_project\" }\n        display(\"corpus microscope\", corpusMicroscopeHtml(preview, canonical, width = 1100, cardWidth = 510))\n    },\n    onError = { failure -> markdown(\"corpus error\", \"Analysis failed: ${(failure.message ?: failure.toString()).md}\") },\n) {\n    // Preserve ownership when a future continuation starts the next tracked job.\n    val run = RunScope.current()\n    val tracked: (String, ModelOperation) -> CompletableFuture<AnalysisResult> = { label, request ->\n        RunScope.withCurrent(run) {\n                client.trackAnalysis(\n                    request,\n                    onAccepted = { display(\"$label job\", fieldAudioJobStatusHtml(it)) },\n                    onProgress = { job, event -> display(\"$label job\", fieldAudioJobStatusHtml(job, event)) },\n                    onCompleted = { display(\"$label job\", fieldAudioJobStatusHtml(it)) },\n                    onError = {}, // The outer operation reports failure once.\n                )\n            }\n            .also { pending -> onCancel { pending.cancel(true) } }\n    }\n    val lookups = sourceNames.map { client.assetByFilename(it) }\n    onCancel { lookups.forEach { it.cancel(true) } }\n    CompletableFuture.allOf(*lookups.toTypedArray())\n        .thenCompose {\n            if (future.isDone) throw CancellationException(\"run ended\")\n            val assets = lookups.map { it.join() }\n            val indexes = assets.mapIndexed { index, asset ->\n                val duration = requireNotNull(asset.durationSeconds) { \"asset has no duration\" }\n                val whole = AssetRegion(asset.id, 0.0, duration)\n                tracked(\n                    \"source ${index + 1} segments\",\n                    segmentCorpus(\n                        whole,\n                        requestedBy = \"field:corpus-microscope/index\",\n                    ),\n                ).thenCompose {\n                    tracked(\n                        \"source ${index + 1} descriptors\",\n                        embedCorpus(\n                            whole,\n                            requestedBy = \"field:corpus-microscope/index\",\n                        ),\n                    )\n                }\n            }\n            CompletableFuture.allOf(*indexes.toTypedArray()).thenApply { assets.first() }\n        }\n        .thenCompose { nancy ->\n            if (future.isDone) throw CancellationException(\"run ended\")\n            val query = AssetRegion(nancy.id, startSeconds = queryStartSeconds, durationSeconds = queryDurationSeconds)\n            tracked(\n                \"Nancy neighbour query\",\n                findCorpusNeighbours(\n                    query,\n                    limit = neighbourCount,\n                    includeSameAsset = false,\n                    weights = weights,\n                    requestedBy = \"field:corpus-microscope/query\",\n                ),\n            ).thenCompose { result ->\n                if (future.isDone) throw CancellationException(\"run ended\")\n                client\n                    .corpusPreview(result.id)\n                    .also { pending -> onCancel { pending.cancel(true) } }\n                    .thenApply { preview -> nancy to preview }\n            }\n        }\n}\n"}}} {"id" "corpus_microscope_guide" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 · corpus microscope guide and jobs" "_tombstone" false "frame" #afield/rect [40.0 40.0 440.0 100.0] "code" #afield/file-inline {"path" "corpus_microscope_guide_code_.kt" "inline" "markdown(\n    \"guide\",\n    \"\"\"\n    ## Corpus microscope\n\n    Run box 2 for the complete path: resolve Nancy and Candlestick by filename; submit and await multi-scale segmentation and grouped descriptor jobs; query a six-second Nancy window; then audition the nearest windows and automatic source-to-neighbour splices.\n\n    Every descriptor is an immutable NPZ asset. Retrieval weights remain visible and editable: harmony, pitch, texture, rhythm and dynamics. Players from different files share relative time, so hover, zoom, seek and the playback cursor line up without pretending that their file timestamps are the same.\"\"\".trimIndent(),\n    width = 1040,\n)\ndisplay(\"all durable jobs\", fieldAudioJobMonitor(heightPixels = 410))\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}