{"version" 2 "boxes" [{"id" "plot_figure" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "plot_renderer"} "name" "rectsl plot + axes" "_tombstone" false "frame" #afield/rect [300.0 140.0 300.0 100.0] "code" #afield/file-inline {"path" "plot_figure_code_.kt" "inline" "// RectSL plotting-layer demo.\n//\n// The #rectsl program sets ONE shared domain (`->domain` + `->frame`), draws\n// `axes` (rules, nice-number ticks, numeric rect-numeral labels, gridlines),\n// then overlays three series in that domain (`area`, `line`, `points`) and\n// finishes with a `colorbar` and a discrete swatch `legend`. Edit `rectsl`\n// and re-run to change it live. See rectsl_cheatsheet.md (\"Plotting layer\")\n// / rectsl_examples.md (\"A plotted figure\").\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\n->wall 16 10 abstract\n->duration 3\n->fps 30\n\n# shared coordinate frame: explicit ->domain + auto ->margins, then axes underneath\n0 10  0 1  ->domain\n->frame\naxes\n\n# three series overlaid in the ONE shared domain\n0 10 40 linspace  dup '( 0.7 * sin 1 + 2 / ) data-map   \"viridis\" area\n0 10 40 linspace  dup '( 0.55 * cos 1 + 2 / ) data-map  \"plasma\"  line\n0 10 12 linspace  dup '( 0.9 * sin 1 + 2 / ) data-map   \"turbo\"   points\n\n# a colour-bar legend (numeric labels) and a discrete swatch key\n\"viridis\" colorbar\n5 \"turbo\" legend\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\n// Seed this box's shader-source properties before `moduleHere {}` runs; the\n// `//%-` fragment break makes this fragment execute first (see the playground\n// transcript for the why).\nonce.vertex { RECT_ANIMATION_VERTEX_SHADER }\nonce.fragment { shader.exampleFragmentShader!! }\n\n//%-\n\nval module = moduleHere {\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl-plot-axes\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nval duration = program.duration.toDouble()\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"}}} {"id" "plot_renderer" "properties" {"children" #{#afield/box "plot_figure"} "parents" #{#afield/box "root"} "name" "window + renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "plot_renderer_code_.kt" "inline" "import afield.four.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\n\nonce.renderer {\n    window = Window(\"RectSL — plotting layer\")\n    Renderer(window)\n}\n\nprintln(\"plot renderer ready\")\nstart(renderer::run)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}