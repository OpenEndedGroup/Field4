{"version" 2 "boxes" [{"id" "exposure_rule" "properties" {"children" #{#afield/box "exposure_meters"} "parents" #{#afield/box "root" #afield/box "exposure_slider" #afield/box "exposure_fieldml"} "name" "Map light to opacity" "_tombstone" false "frame" #afield/rect [60.0 250.0 255.0 85.0] "code" #afield/file-inline {"path" "exposure_rule_code_.kt" "inline" "let measured = propDown \"lightLevel\" |> hostAsFloat\nlet mapped = 0.1 + 0.9 * measured * measured\nsetPropDown \"mappedOpacity\" mapped\n"}}} {"id" "exposure_meters" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "exposure_rule"} "name" "Compare the values" "_tombstone" false "frame" #afield/rect [60.0 430.0 255.0 85.0] "code" #afield/file-inline {"path" "exposure_meters_code_.kt" "inline" "prop<Double>(mappedOpacity)\n\nval measured = lightLevel\nval mapped = mappedOpacity\nval track = 320\n\nfun row(label: String, value: Double, color: String): String {\n    val width = (track * value).toInt()\n    return \"\"\"\n        <p>$label ${value.f3}</p>\n        <div style=\"width:${track}px;background:#29303c\">\n            <div style=\"width:${width}px;height:12px;background:$color\"></div>\n        </div>\"\"\".trimIndent()\n}\n\ndisplay(\"values\", row(\"Light level\", measured, \"#c4d5e7\") + row(\"Mapped opacity\", mapped, \"#8ed2b3\"))\ndisplayOpen(\"values\")\nprintln(\"Light ${measured.f3} · opacity ${mapped.f3}\")\n"}}} {"id" "exposure_slider" "properties" {"children" #{#afield/box "exposure_rule"} "parents" #{#afield/box "root"} "name" "Light level" "_tombstone" false "frame" #afield/rect [60.0 60.0 255.0 70.0] "code" #afield/file-inline {"path" "exposure_slider_code_.kt" "inline" "propDown<Double>(lightLevel)\nsyncToProperty(\"lightLevel\", 0.5, min = 0.0, max = 1.0)\ndisplayOpen(\"controls\")\n"}}} {"id" "exposure_fieldml" "properties" {"children" #{#afield/box "exposure_rule"} "parents" #{#afield/box "root"} "name" "FieldML" "_tombstone" false "frame" #afield/rect [390.0 60.0 1