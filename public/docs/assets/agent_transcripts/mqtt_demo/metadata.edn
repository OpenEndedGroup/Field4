{"version" 2 "boxes" [{"id" "mqtt-plot" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3. Plot the recent values (launch)" "_tombstone" false "frame" #afield/rect [60.0 220.0 380.0 70.0] "autorun" false "code" #afield/file-inline {"path" "mqtt-plot_code_.kt" "inline" "import afield.mqtt.*\n\n// Keep the latest value and recent history of everything under sensors/, and plot it twice a second.\n// `series` holds the last 512 numbers per topic; `number(topic, \"temp\")` reads a field out of JSON.\nmqtt.track(\"sensors/#\")\nloop {\n    showSignals(\n        \"kitchen\" to mqtt.series(\"sensors/kitchen/temp\"),\n        \"hall\" to mqtt.series(\"sensors/hall/temp\"),\n        \"garden\" to mqtt.series(\"sensors/garden/env\", \"temp\"),\n        title = \"Temperatures (°C)\",\n    )\n    markdown(\"info\", \"garden: %.1f °C, %.0f %% humidity\".format(\n        mqtt.number(\"sensors/garden/env\", \"temp\"), mqtt.number(\"sensors/garden/env\", \"humidity\")))\n    delay(500)\n}\n"}}} {"id" "mqtt-retained" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4. Retained scene message (run)" "_tombstone" false "frame" #afield/rect [980.0 60.0 380.0 70.0] "autorun" false "code" #afield/file-inline {"path" "mqtt-retained_code_.kt" "inline" "import afield.mqtt.*\n\n// A retained message stays on the broker: anything that subscribes later gets it straight away.\n// This is how a device learns the current scene when it boots.\nmqtt.publish(\"installation/scene\", mapOf(\"name\" to \"dusk\", \"brightness\" to 0.4), qos = 1, retain = true)\n\nmqtt.subscribe(\"installation/#\") { topic, message ->\n    markdown(\"`$topic`: **${message.string(\"name\")}** at ${message.number(\"brightness\")} (retained: ${message.retained})\")\n}\nmqtt\n"}}} {"id" "mqtt-listen" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2. Listen: sensors/+/temp (run)" "_tombstone" false "frame" #afield/rect [520.0 60.0 380.0 70.0] "autorun" false "code" #afield/file-inline {"path" "mqtt-listen_code_.kt" "inline" "import afield.mqtt.*\n\n// Every temperature, whichever room it comes from: `+` stands for one level of the topic.\n// The callback runs on Field's main loop, so it can update outputs directly.\n// Re-running this box replaces the callback rather than adding a second one.\nvar count = 0\nmqtt.subscribe(\"sensors/+/temp\") { topic, message ->\n    count++\n    markdown(\"**$topic** = ${\"%.2f\".format(message.number)}  _(message $count)_\")\n}\n"}}} {"id" "mqtt-sensors" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1. Pretend sensors (launch first)" "_tombstone" false "frame" #afield/rect [60.0 60.0 380.0 70.0] "autorun" false "code" #afield/file-inline {"path" "mqtt-sensors_code_.kt" "inline" "import afield.mqtt.*\n\n// Three pretend sensors publishing to the embedded broker ten times a second.\n// The kitchen and hall send plain numbers; the garden sends JSON, as many ESP32 sketches do.\n// Point real devices at this machine's broker instead and delete this box.\nval start = AnimationClock.nowSeconds()\nloop {\n    val t = AnimationClock.nowSeconds() - start\n    mqtt.publish(\"sensors/kitchen/temp\", 21.0 + sin(t * 0.7) * 1.5)\n    mqtt.publish(\"sensors/hall/temp\", 18.0 + sin(t * 0.3 + 1.0) * 2.0)\n    mqtt.publish(\"sensors/garden/env\", mapOf(\"temp\" to 12.0 + sin(t * 0.2) * 4.0, \"humidity\" to 60 + 20 * cos(t * 0.5)))\n    delay(100)\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}