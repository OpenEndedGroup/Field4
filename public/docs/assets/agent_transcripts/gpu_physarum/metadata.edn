{"version" 2 "boxes" [{"id" "physarum_slime" "properties" {"children" #{#afield/box "physarum_weather" #afield/box "physarum_reset"} "parents" #{#afield/box "root" #afield/box "physarum_renderer"} "name" "slime" "_tombstone" false "frame" #afield/rect [340.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "physarum_slime_code_.kt" "inline" "/*\nA million agents on a 1024 x 1024 trail. Each one looks at the trail three ways ahead,\nturns toward the strongest, steps a pixel and leaves a mark; the trail blurs and fades\nby itself. The defaults are the CPU PhysarumParams defaults, so this is the same model\nas the page's 6000-agent swarm at about 170 times the population.\n*/\nprop<ShaderPhysarumSystem>(physarum) = ShaderPhysarumSystem() {\n    width = 1024\n    height = 1024\n    agentCount = 1_000_000\n    speciesCount = 2\n}\n\n// steps once a frame and draws the trail, one colour per species\nphysarum.installInto()\nprintln(\"${physarum.settings.agentCount} agents, ${physarum.settings.speciesCount} species\")\n"}}} {"id" "physarum_renderer" "properties" {"children" #{#afield/box "physarum_slime"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "physarum_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nOptions.profiling = false\n// once: re-running this box keeps the existing window and renderer\nonce.renderer {\n    window = Window(\"Physarum\", initialDimensions = Rect(80.0, 80.0, 768.0, 768.0))\n    Renderer(window)\n}\nprintln(\"renderer ready\")\n// the frame loop runs as this box's coroutine; stopping the box stops rendering\nstart(renderer::run)\n"}}} {"id" "physarum_weather" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "physarum_slime"} "name" "weather" "_tombstone" false "frame" #afield/rect [340.0 160.0 300.0 100.0] "code" #afield/file-inline {"path" "physarum_weather_code_.kt" "inline" "/*\nEverything here is read every frame, so re-run this box with other numbers and the\nrunning network responds: wind drags the whole trail (pixels per frame), a longer\nhalf-life makes thicker, slower roads, and jitter makes agents wander off them.\n*/\nphysarum.trail.settings.windPx = Vector2f(0.25f, 0f)\nphysarum.trail.settings.halfLifeFrames = vec(12f, 12f, 12f, 12f)\nphysarum.settings.jitter = 0.05f\nprintln(\"wind ${physarum.trail.settings.windPx}, decay per frame ${physarum.trail.decayFactors()}\")\n"}}} {"id" "physarum_reset" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "physarum_slime"} "name" "reset" "_tombstone" false "frame" #afield/rect [340.0 280.0 300.0 100.0] "code" #afield/file-inline {"path" "physarum_reset_code_.kt" "inline" "// empty the trail and scatter the agents again, with a new seed each time\nphysarum.trail.clear()\nphysarum.resetAgents(System.nanoTime())\nprintln(\"reset\")\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}