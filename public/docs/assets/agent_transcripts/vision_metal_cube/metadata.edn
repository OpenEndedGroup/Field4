{"version" 2 "boxes" [{"id" "agent_vision_metal_cube" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Vision Metal Cube" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 100.0] "code" #afield/file-inline {"path" "agent_vision_metal_cube_code_.kt" "inline" "import afield.graphics.VisionMetalGeometryOrigin\nimport afield.graphics.visionMetal\nimport afield.graphics.visionMetalExampleScript\nimport afield.graphics.visionMetalExampleShader\n\n// `geometry` is explicit: there is no fallback to the head's cube, so a program that\n// neither ships vertices nor builds them in Kotlin/JS would draw nothing. This one asks\n// for the built-in cube by name.\nvisionMetal(\n    shader = visionMetalExampleShader,\n    script = visionMetalExampleScript,\n    uniforms = listOf(\"phase\", \"amount\", \"tint\"),\n    geometry = VisionMetalGeometryOrigin.BUILTIN,\n).onStatus {\n    println(\"vision-metal ${it.phase}: ${it.message}\")\n}\nprintln(\"vision-metal cube published\")\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}