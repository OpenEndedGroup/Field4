{"version" 2 "boxes" [{"id" "gezira_svg_flines" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "tiger as flines" "_tombstone" false "frame" #afield/rect [1900.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "gezira_svg_flines_code_.kt" "inline" "import afield.graphics.nile.*\n\n// The tiger as Field FLines, drawn by Field's own line renderer.\nval outlines = GeziraSvg.flines(GeziraSvg.tiger())\nprintln(\"${outlines.size} FLines\")\nlines(outlines, channel = \"flines\")\n"}}} {"id" "gezira_svg_tiger" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "tiger beside skia" "_tombstone" false "frame" #afield/rect [760.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "gezira_svg_tiger_code_.kt" "inline" "import afield.graphics.nile.*\n\n// The Ghostscript tiger through Gezira's kernels, then through Skia's SVG renderer.\nval n = 300\nval text = GeziraSvg.tiger()\nval doc = GeziraSvg.parse(text)\nval r = GeziraSvg.render(doc, n, n)\nval skia = GeziraSvg.skia(text, n, n)\nval diff = GeziraSvg.difference(r.canvas.rgba, skia, 10.0)\nval (worst, mean) = r.canvas.error(skia)\nval readout = listOf(\n    \"%d SVG elements, %d segments, read into %d FLines\".format(doc.elements, doc.segments, doc.lines.size),\n    r.toString(),\n    \"Gezira vs Skia per channel: max |diff| %.3f, mean %.4f\".format(worst, mean),\n).joinToString(\"\\n\")\nprintln(readout)\ndisplay(\"readout\", \"<pre style='margin:0; white-space:pre-wrap'>$readout</pre>\")\n\n// Three panels side by side: Gezira, Skia, and the difference times ten (white where they agree).\nval gap = 12\nval w = 3 * n + 2 * gap\nval sheet = FloatArray(4 * w * n)\nfor ((k, img) in listOf(r.canvas.rgba, skia, diff).withIndex()) {\n    for (y in 0 until n) for (x in 0 until n) {\n        val s = 4 * (y * n + x)\n        val d = 4 * (y * w + k * (n + gap) + x)\n        for (c in 0..3) sheet[d + c] = img[s + c]\n    }\n}\ndisplay(\"gezira | skia | difference x10\", GeziraSvg.png(sheet, w, n))\n"}}} {"id" "gezira_fline_paint" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "flines through gezira" "_tombstone" false "frame" #afield/rect [40.0 1200.0 300.0 100.0] "code" #afield/file-inline {"path" "gezira_fline_paint_code_.kt" "inline" "import afield.graphics.nile.*\n\n// Ordinary FLines, painted by their own color, filled, stroked, thickness and fillRule.\nfun circle(cx: Double, cy: Double, r: Double): FLine {\n    val k = 0.5522847498 * r\n    return FLine()\n        .moveTo(cx + r, cy)\n        .cubicTo(cx + r, cy + k, 0.0, cx + k, cy + r, 0.0, cx, cy + r, 0.0)\n        .cubicTo(cx - k, cy + r, 0.0, cx - r, cy + k, 0.0, cx - r, cy, 0.0)\n        .cubicTo(cx - r, cy - k, 0.0, cx - k, cy - r, 0.0, cx, cy - r, 0.0)\n        .cubicTo(cx + k, cy - r, 0.0, cx + r, cy - k, 0.0, cx + r, cy, 0.0)\n        .close()\n}\nfun FLine.square(x: Double, y: Double, s: Double) =\n    moveTo(x, y).lineTo(x + s, y).lineTo(x + s, y + s).lineTo(x, y + s).close()\n\nval disc = circle(70.0, 60.0, 40.0)\ndisc.filled = true\ndisc.stroked = false\ndisc.color = vec(0.95, 0.55, 0.15, 1.0)\nval ring = circle(70.0, 60.0, 40.0)\nring.thickness = 6.0\nring.color = vec(0.2, 0.15, 0.1, 1.0)\nval frame = FLine().square(120.0, 20.0, 80.0).square(140.0, 40.0, 40.0)\nframe.filled = true\nframe.stroked = false\nframe.fillRule = FillRule.EVEN_ODD\nframe.color = vec(0.25, 0.5, 0.85, 0.8)\nval wave = FLine().moveTo(20.0, 110.0).cubicTo(60.0, 70.0, 0.0, 100.0, 150.0, 0.0, 200.0, 110.0, 0.0)\nwave.thickness = 3.0\nwave.color = vec(0.8, 0.1, 0.3, 1.0)\nval shapes = [disc, ring, frame, wave]\nval r = GeziraFLine.render(shapes, 220, 130)\nprintln(r)\ndisplay(\"gezira\", GeziraSvg.png(r.canvas.rgba, 220, 130))\nlines(shapes, channel = \"field\")\n"}}} {"id" "gezira_svg_reader" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "svg reader" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "gezira_svg_reader_code_.kt" "inline" "import afield.graphics.nile.*\n\n// A group with a transform and inherited paint, an arc, and an even-odd path with a hole.\nval svg =\n    \"\"\"\n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 120 60\">\n      <g fill=\"#e8a33c\" stroke=\"#3a2a1a\" stroke-width=\"2\" transform=\"translate(10 10)\">\n        <path d=\"M0 40 A20 20 0 0 1 40 40 Z\"/>\n        <path fill-rule=\"evenodd\" fill=\"#4a7fd0\" d=\"M50 0h40v40h-40z M60 10h20v20h-20z\"/>\n        <circle cx=\"20\" cy=\"30\" r=\"6\" style=\"fill:white; stroke:none\" opacity=\"0.8\"/>\n      </g>\n    </svg>\"\"\".trimIndent()\nval doc = GeziraSvg.parse(svg)\nprintln(doc)\nfor (l in doc.lines) {\n    val what = if (l.filled) \"fill ${l.fillRule}\" else \"stroke ${l.thickness}\"\n    println(\"${l.svgId ?: \"-\"}: ${Gezira.subpaths(l).size} subpath(s), $what, colour ${l.color}\")\n}\nval r = GeziraSvg.render(doc, 360, 180)\ndisplay(\"gezira\", GeziraSvg.png(r.canvas.rgba, 360, 180))\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat