{"version" 2 "boxes" [{"id" "datalog_rhythm_why_drawn" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 · why" "_tombstone" false "frame" #afield/rect [60.0 380.0 300.0 100.0] "code" #afield/file-inline {"path" "datalog_rhythm_why_drawn_code_.kt" "inline" "val drums = notation.space(\"drums\", x = 0.0..16.0, y = 0.0..3.0)\nval r =\n    datalog(\"event(V, 36, 100, T) :- hit(P, V, _), pos(T, P).\").rhythm().notationHits(drums, [\"kick\", \"snare\", \"hh\"])\nprintln(r.grid(0))\nprintln(r.why(\"event(snare, 36, 100, 4)\")?.render() ?: \"no snare at step 4 — nothing drawn there\")\n"}}} {"id" "datalog_rhythm_draw" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 · draw the bar" "_tombstone" false "frame" #afield/rect [60.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "datalog_rhythm_draw_code_.kt" "inline" "// (step, lane): lane 0 is kick, 1 snare, 2 hh. Edit and run again to redraw.\nval notes = [0 to 0, 6 to 0, 10 to 0, 4 to 1, 12 to 1, 2 to 2, 14 to 2]\nnotation {\n    rect(400, 60, 480, 90, name = \"drums\")\n    for ((step, lane) in notes) rect(400 + step * 30 + 4, 60 + lane * 30 + 8, 14, 14, name = \"n$step.$lane\")\n}\nprintln(\"drew ${notes.size} marks in 'drums'\")\n"}}} {"id" "datalog_rhythm_play" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 · play it — launch me" "_tombstone" false "frame" #afield/rect [60.0 220.0 300.0 100.0] "code" #afield/file-inline {"path" "datalog_rhythm_play_code_.kt" "inline" "val drums = notation.space(\"drums\", x = 0.0..16.0, y = 0.0..3.0)\nval r = datalog(\n    \"\"\"\n    event(V, 36, 100, T) :- hit(P, V, _), pos(T, P).\n    event(hh, 42, 40, T) :- every(T, 2, 1), pos(T, P), span(hh, A, B, _), P >= A, P < B.\n    \"\"\",\n).rhythm()\n    .notationHits(drums, [\"kick\", \"snare\", \"hh\"])\nprintln(r.grid(0))\npatSynth(r.pattern(), cps = 0.5)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}