{"version" 2 "boxes" [{"id" "syphon_gpu_publish" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "syphon_gpu_renderer"} "name" "Syphon — publish a render target from the GPU" "_tombstone" false "frame" #afield/rect [40.0 480.0 340.0 100.0] "code" #afield/file-inline {"path" "syphon_gpu_publish_code_.kt" "inline" "import afield.syphon.*\n\n// without the library this stops here and says how to build it\ncheck(Syphon.isAvailable) { Syphon.describe() }\n\nprop<RenderToTexture>(syphonTarget) = RenderToTexture {\n    width = 640\n    height = 360\n}\nrenderer.renderList += \"syphonTarget\" to syphonTarget\n\n// a quad over the whole target, coloured by its texture coordinates\nval module = moduleHere()\nval quad = Mesh()\nmodule += \"quad\" to quad\nsyphonTarget += \"gradient\" to module\nquad.set(4, 2) {\n    pos.add(-1, -1, 0, 1, -1, 0, 1, 1, 0, -1, 1, 0)\n    tc.add(0, 0, 1, 0, 1, 1, 0, 1)\n    tri.add(0, 1, 2)\n    tri.add(0, 2, 3)\n}\n\n// every frame syphonTarget renders goes to Syphon, copied on the GPU\nsyphonServer(\"Field GPU\").followOnGpu(syphonTarget)\n"} "vertex" #afield/file-inline {"path" "syphon_gpu_publish_vertex_.glsl" "inline" "#version 450\nlayout(location = 0) in vec3 pos;\nlayout(location = 1) in vec2 tc;\nlayout(location = 1) out vec2 ftc;\nvoid main() {\n    gl_Position = vec4(pos.xy, 0.5, 1.0);\n    ftc = tc;\n}\n"} "fragment" #afield/file-inline {"path" "syphon_gpu_publish_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 color;\nlayout(location = 1) in vec2 ftc;\nvoid main() {\n    // red grows to the right, green upwards; bottom-left is dark blue\n    color = vec4(ftc.x, ftc.y, 0.3, 1.0);\n}\n"}}} {"id" "syphon_gpu_receive" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "syphon_gpu_renderer"} "name" "Syphon — receive into a texture" "_tombstone" false "frame" #afield/rect [40.0 920.0 340.0 100.0] "code" #afield/file-inline {"path" "syphon_gpu_receive_code_.kt" "inline" "import afield.syphon.*\n\n// without the library this stops here and says how to build it\ncheck(Syphon.isAvailable) { Syphon.describe() }\n\n// a server's name, app name or uuid\nval inp = syphonClient(\"Field GPU\")\nprop<SyphonTexture>(syphonIn) = inp.texture()\n\nval module = moduleHere()\nval quad = Mesh()\nmodule += \"quad\" to quad\nrenderer += \"syphonView\" to module\nquad.set(4, 2) {\n    pos.add(-1, -1, 0, 1, -1, 0, 1, 1, 0, -1, 1, 0)\n    // the texture's v = 0 is the top of the picture, so the top corners get v = 0\n    tc.add(0, 1, 1, 1, 1, 0, 0, 0)\n    tri.add(0, 1, 2)\n    tri.add(0, 2, 3)\n}\ninp\n"} "vertex" #afield/file-inline {"path" "syphon_gpu_receive_vertex_.glsl" "inline" "#version 450\nlayout(location = 0) in vec3 pos;\nlayout(location = 1) in vec2 tc;\nlayout(location = 1) out vec2 ftc;\nvoid main() {\n    gl_Position = vec4(pos.xy, 0.5, 1.0);\n    ftc = tc;\n}\n"} "fragment" #afield/file-inline {"path" "syphon_gpu_receive_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 color;\nlayout(location = 1) in vec2 ftc;\nlayout(set = 0, binding = 0) uniform sampler2D syphonIn;\nvoid main() {\n    color = vec4(texture(syphonIn, ftc).rgb, 1.0);\n}\n"}}} {"id" "syphon_gpu_renderer" "properties" {"children" #{#afield/box "syphon_gpu_publish" #afield/box "syphon_gpu_receive"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "syphon_gpu_renderer_code_.kt" "inline" "import afield.four.util.Options\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nOptions.profiling = false\nonce.renderer {\n    window = Window(\"Syphon\")\n    Renderer(window)\n}\nprintln(\"renderer ready\")\nstart(renderer::run)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}