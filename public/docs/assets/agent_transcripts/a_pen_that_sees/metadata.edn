{"version" 2 "boxes" [{"id" "ps_hatch" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - beside a line, seeing and blind" "_tombstone" false "frame" #afield/rect [60.0 560.0 300.0 100.0] "code" #afield/file-inline {"path" "ps_hatch_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n// The same yellow line continued three times by the seeing Michaux pen (white) and twice by\n// its blind twin (red), trained on the same drawings without sight.\nval yours = fline {\n    breakNext()\n    for (i in 0..120) {\n        val y = i * 2.0\n        val x = 14 * sin(y / 40) + 5 * sin(y / 13)\n        lineTo(x, y)\n    }\n}\nfun beside(model: String, seed: Long) = [\n    yours.copy().apply {\n        color = vec(1.0, 0.85, 0.3, 1.0)\n        thickness = 1.5\n    },\n    yours.continueWith(PenModel.bundled(model), steps = 1500, seed = seed).apply {\n        color = if (model.endsWith(\"blind\")) vec(1.0, 0.6, 0.6, 1.0) else vec(0.9, 0.92, 1.0, 1.0)\n        thickness = 1.0\n    },\n]\nlines(\n    sideBySide(\n        [\n            beside(\"michaux\", 1),\n            beside(\"michaux\", 2),\n            beside(\"michaux\", 3),\n            beside(\"michaux-blind\", 1),\n            beside(\"michaux-blind\", 2),\n        ],\n        gap = 30.0,\n    ),\n    w = 520.0,\n    h = 440.0,\n    fitToSize = true,\n)\n"}}} {"id" "ps_draw" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "6 - hatch beside your line (launch)" "_tombstone" false "frame" #afield/rect [60.0 2560.0 300.0 100.0] "code" #afield/file-inline {"path" "ps_draw_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n/*\nLaunch, and the seeing Michaux pen hatches beside the yellow line in \"pen\". Draw a line of\nyour own in \"draw here\", top to bottom works best, and it starts again beside yours,\nseeing everything else you have drawn as well.\n*/\nval border = fline {\n    moveTo(0, 0)\n    lineTo(500, 0)\n    lineTo(500, 300)\n    lineTo(0, 300)\n    lineTo(0, 0)\n    color = vec(1, 1, 1, 0.2)\n}\nval starter = fline {\n    moveTo(120, 30)\n    cubicTo(150, 100, 100, 170, 130, 270)\n    color = vec(1.0, 0.85, 0.3, 1.0)\n    thickness = 2.0\n}\nval canvas = lines(border, starter, channel = \"draw here\", w = 520.0, h = 320.0, editable = true, drawing = true)!!\nval michaux = PenModel.bundled(\"michaux\")\nvar writer: PenLine? = null\nvar shown = listOf<FLine>()\nvar seen = 1\nframes {\n    while (frame()) {\n        val drawn = canvas.currentLines()\n        if (drawn.size > seen) {\n            seen = drawn.size\n            val yours = drawn.last().copy().apply {\n                color = vec(1.0, 0.85, 0.3, 1.0)\n                thickness = 2.0\n            }\n            shown = drawn.drop(1).dropLast(1).map { it.copy().apply { color = vec(1.0, 0.85, 0.3, 0.6) } } + yours\n            writer = PenLine(yours, model = michaux, seed = seen.toLong(), surroundings = drawn.drop(1).dropLast(1))\n        }\n        val w = writer ?: continue\n        // six points a frame; it runs past the end of your line before it turns back\n        if (w.history.size < 2400) w.grow(6)\n        lines(\n            [border] +\n                shown +\n                w.drawn.apply {\n                    color = vec(0.9, 0.92, 1.0, 1.0)\n                    thickness = 1.0\n                },\n            channel = \"pen\",\n            w = 520.0,\n            h = 320.0,\n        )\n    }\n}\n"}}} {"id" "ps_shape" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "7 - cracks in your shape (launch)" "_tombstone" false "frame" #afield/rect [60.0 3760.0 300.0 100.0] "code" #afield/file-inline {"path" "ps_shape_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n// Launch, and the seeing cracks pen fills the yellow shape in \"pen\" with cracks that stop\n// where they meet a line. Draw a closed shape of your own in \"draw here\" and it cracks yours.\nval border = fline {\n    moveTo(0, 0)\n    lineTo(500, 0)\n    lineTo(500, 300)\n    lineTo(0, 300)\n    lineTo(0, 0)\n    color = vec(1, 1, 1, 0.2)\n}\nval starter = fline {\n    breakNext()\n    for (i in 0..24) {\n        val a = i * 2 * PI / 24\n        val r = 90 * (1 + 0.15 * sin(3 * a) + 0.08 * cos(5 * a))\n        lineTo(250 + cos(a) * r, 150 + sin(a) * r)\n    }\n}\n    .apply {\n        color = vec(1.0, 0.85, 0.3, 1.0)\n        thickness = 2.0\n    }\nval canvas = lines(border, starter, channel = \"draw here\", w = 520.0, h = 320.0, editable = true, drawing = true)!!\nval cracks = PenModel.bundled(\"cracks\")\nvar writer: PenLine? = null\nvar shape = starter\nvar seen = 1\nframes {\n    while (frame()) {\n        val drawn = canvas.currentLines()\n        if (drawn.size > seen) {\n            seen = drawn.size\n            shape = drawn.last().copy().apply {\n                color = vec(1.0, 0.85, 0.3, 1.0)\n                thickness = 2.0\n            }\n            writer = PenLine(shape, model = cracks, seed = seen.toLong(), liftAtEnd = true)\n        }\n        val w = writer ?: continue\n        if (w.history.size < 1200) w.grow(4)\n        lines(\n            border,\n            shape,\n            w.drawn.apply {\n                color = vec(0.9, 0.92, 1.0, 1.0)\n                thickness = 1.0\n            },\n            channel = \"pen\",\n            w = 520.0,\n            h = 320.0,\n        )\n    }\n}\n"}}} {"id" "ps_field" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - a field of lines" "_tombstone" false "frame" #afield/rect [60.0 1560.0 300.0 100.0] "code" #afield/file-inline {"path" "ps_field_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n// One short wavering stroke, then five thousand points from the seeing Michaux pen: columns\n// of trembling lines, each pass following the one before it.\nval first = fline {\n    breakNext()\n    for (i in 0..60) {\n        val y = i * 2.5\n        val x = 6 * sin(y / 25)\n        lineTo(x, y)\n    }\n}\nval writer = PenLine(first, model = PenModel.bundled(\"michaux\"), seed = 7)\nwriter.grow(5000)\nlines(\n    writer.line.apply {\n        color = vec(0.9, 0.92, 1.0, 1.0)\n        thickness = 0.8\n    },\n    w = 520.0,\n    h = 320.0,\n    fitToSize = true,\n)\n"}}} {"id" "ps_doodle" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "9 - hatch your drawing (launch)" "_tombstone" false "frame" #afield/rect [60.0 5460.0 300.0 100.0] "code" #afield/file-inline {"path" "ps_doodle_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n// Launch, and the pen hatches around the drawing in \"draw here\", stroke by stroke, as you\n// watch. Draw more and it starts again around everything. The checkbox switches the pen's hand.\nval border = fline {\n    moveTo(0, 0)\n    lineTo(500, 0)\n    lineTo(500, 300)\n    lineTo(0, 300)\n    lineTo(0, 0)\n    color = vec(1, 1, 1, 0.2)\n}\nval starter = [\n    fline {\n        moveTo(90, 60)\n        cubicTo(200, 20, 260, 220, 400, 160)\n    },\n    fline {\n        moveTo(150, 250)\n        cubicTo(180, 150, 300, 300, 330, 230)\n    },\n].onEach {\n    it.color = vec(1.0, 0.85, 0.3, 1.0)\n    it.thickness = 2.0\n}\nval canvas = lines([border] + starter, channel = \"draw here\", w = 520.0, h = 320.0, editable = true, drawing = true)!!\nval hands = [\"echoes\", \"michaux\"]\nvar hand = 0\nvar choice = 0\ncheckbox(\"Michaux's hand\", channel = \"hand\") { choice = if (it) 1 else 0 }\nvar hatcher: Hatcher? = null\nvar drawing = listOf<FLine>()\nvar seen = -1\nframes {\n    while (frame()) {\n        val drawn = canvas.currentLines().drop(1)\n        if (drawn.size != seen || choice != hand) {\n            seen = drawn.size\n            hand = choice\n            drawing = drawn.map {\n                it.copy().apply {\n                    color = vec(1.0, 0.85, 0.3, 1.0)\n                    thickness = 2.0\n                }\n            }\n            hatcher = Hatcher(drawing, PenModel.bundled(hands[hand]), passes = 8, gap = 4.0, seed = seen.toLong())\n        }\n        val h = hatcher ?: continue\n        if (!h.done) h.grow(24)\n        lines(\n            [border] +\n                drawing +\n                h.hatching.map {\n                    it.apply {\n                        color = vec(0.9, 0.92, 1.0, 1.0)\n                        thickness = 0.8\n                    }\n                },\n            channel = \"pen\",\n            w = 520.0,\n            h = 320.0,\n        )\n    }\n}\n"}}} {"id" "ps_sees" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - what it sees" "_tombstone" false "frame" #afield/rect [60.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "ps_sees_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n/*\nThe seeing Michaux pen hatching beside a wavering line, stopped at four moments. At each,\nthe faint circle is as far as it can see and each orange ray runs to the nearest ink in one\nof its sixteen directions, brighter the closer it is.\n*/\nval yours = fline {\n    breakNext()\n    for (i in 0..120) {\n        val y = i * 2.0\n        val x = 14 * sin(y / 40) + 5 * sin(y / 13)\n        lineTo(x, y)\n    }\n}\nval writer = PenLine(yours, model = PenModel.bundled(\"michaux\"), seed = 1)\nval moments =\n    [60, 180, 320, 520].map { until ->\n        writer.grow(until - writer.history.size)\n        [\n            yours.copy().apply {\n                color = vec(1.0, 0.85, 0.3, 1.0)\n                thickness = 1.5\n            },\n            writer.drawn.copy().apply {\n                color = vec(0.9, 0.92, 1.0, 1.0)\n                thickness = 1.0\n            },\n        ] + writer.seeing()\n    }\nlines(sideBySide(moments, gap = 40.0), w = 520.0, h = 300.0, fitToSize = true)\n"}}} {"id" "ps_cracks" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - cracks that stop at a line" "_tombstone" false "frame" #afield/rect [60.0 1060.0 300.0 100.0] "code" #afield/file-inline {"path" "ps_cracks_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n// A wobbling outline handed to the seeing cracks pen three times and its blind twin twice.\n// liftAtEnd = true: after a finished outline, the next thing in its corpus is a new stroke.\nval outline = fline {\n    breakNext()\n    for (i in 0..90) {\n        val a = i * 2 * PI / 90\n        val r = 60 * (1 + 0.15 * sin(3 * a) + 0.08 * cos(5 * a))\n        lineTo(cos(a) * r, sin(a) * r)\n    }\n}\nfun inside(model: String, seed: Long) = [\n    outline.copy().apply {\n        color = vec(1.0, 0.85, 0.3, 1.0)\n        thickness = 1.5\n    },\n    outline.continueWith(PenModel.bundled(model), steps = 700, seed = seed, liftAtEnd = true).apply {\n        color = if (model.endsWith(\"blind\")) vec(1.0, 0.6, 0.6, 1.0) else vec(0.9, 0.92, 1.0, 1.0)\n        thickness = 1.0\n    },\n]\nlines(\n    sideBySide(\n        [\n            inside(\"cracks\", 1),\n            inside(\"cracks\", 2),\n            inside(\"cracks\", 3),\n            inside(\"cracks-blind\", 1),\n            inside(\"cracks-blind\", 2),\n        ],\n        gap = 30.0,\n    ),\n    w = 520.0,\n    h = 300.0,\n    fitToSize = true,\n)\n"}}} {"id" "ps_measure" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5 - seeing against blind, measured" "_tombstone" false "frame" #afield/rect [60.0 2060.0 300.0 100.0] "code" #afield/file-inline {"path" "ps_measure_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n// following: the share of the pen's points with older ink within 8 pixels. joins: the share\n// of its strokes that end on ink. Twenty seeds each, the same primers as boxes 2 and 3.\nval yours = fline {\n    breakNext()\n    for (i in 0..120) {\n        val y = i * 2.0\n        val x = 14 * sin(y / 40) + 5 * sin(y / 13)\n        lineTo(x, y)\n    }\n}\nval outline = fline {\n    breakNext()\n    for (i in 0..90) {\n        val a = i * 2 * PI / 90\n        val r = 60 * (1 + 0.15 * sin(3 * a) + 0.08 * cos(5 * a))\n        lineTo(cos(a) * r, sin(a) * r)\n    }\n}\nfun mean(f: (Long) -> Double) = ((0 until 20).map { f(it.toLong()) }.average()).f2\nval hatching = { m: String -> mean { s -> following(yours.continueWith(PenModel.bundled(m), steps = 1500, seed = s)) } }\nval cracking = { m: String ->\n    mean { s -> joins(outline.continueWith(PenModel.bundled(m), steps = 700, seed = s, liftAtEnd = true)) }\n}\nmarkdown(\n    \"measures\",\n    \"\"\"\n| | seeing | blind |\n|---|---|---|\n| Michaux beside a line: following | ${hatching(\"michaux\")} | ${hatching(\"michaux-blind\")} |\n| cracks in an outline: joins | ${cracking(\"cracks\")} | ${cracking(\"cracks-blind\")} |\n\"\"\"\n        .trimIndent(),\n)\n"}}} {"id" "ps_word" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "8 - hatching around a word" "_tombstone" false "frame" #afield/rect [60.0 4960.0 300.0 100.0] "code" #afield/file-inline {"path" "ps_word_code_.kt" "inline" "import afield.ai.learning.pen.*\n\n/*\nEvery stroke of the word gets ten passes of the echoes pen's trembling line, each kept\n3.5 pixels from the ink beside it. The pen proposes 32 next points at a time and a\nFollowGuide picks the one that keeps the gap without crossing anything. Try \"michaux\".\n*/\nval word = HersheyFont.load(\"futural\").text(\"FIELD\", size = 90.0).apply {\n    color = vec(1.0, 0.85, 0.3, 1.0)\n    thickness = 2.0\n}\nval hatching = Hatcher([word], PenModel.bundled(\"echoes\"), passes = 10, gap = 3.5, seed = 1).finish()\nhatching.forEach {\n    it.color = vec(0.9, 0.92, 1.0, 1.0)\n    it.thickness = 0.7\n}\nlines([word] + hatching, w = 520.0, h = 220.0, fitToSize = true)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}