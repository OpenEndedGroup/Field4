{"version" 2 "boxes" [{"id" "splat_tiles_timing" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - naive against balanced" "_tombstone" false "frame" #afield/rect [740.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "splat_tiles_timing_code_.kt" "inline" "import afield.graphics.render.SplatRaster\nimport afield.graphics.render.SplatTiles\nimport afield.math.linalg.Vector3f\n\nval count = 200_000\nval cloud = SplatTiles.clusteredCloud(count)\n// A small image is 36 tiles for 10 workers, and the core's tiles hold most of the work:\n// the case where whoever gets a heavy tile last holds up the frame.\nval view = SplatRaster.View.lookAt(\n    eye = Vector3f(0f, 0.3f, 2.6f),\n    target = Vector3f(0f, 0f, 0f),\n    width = 96,\n    height = 96,\n)\nval binning = SplatTiles.bin(cloud, count, view)\nprintln(binning)\nfor (cutoff in listOf(1e-4f, 0f)) {\n    println(\"transmittance cutoff $cutoff\")\n    for (row in SplatTiles.compare(binning, repeats = 9, transmittanceCutoff = cutoff)) println(\"  $row\")\n}\n"}}} {"id" "splat_tiles_heat" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - splats per tile" "_tombstone" false "frame" #afield/rect [400.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "splat_tiles_heat_code_.kt" "inline" "import afield.graphics.render.SplatRaster\nimport afield.graphics.render.SplatTiles\nimport afield.math.linalg.Vector3f\n\nval count = 40_000\nval cloud = SplatTiles.clusteredCloud(count)\nval view = SplatRaster.View.lookAt(\n    eye = Vector3f(0f, 0f, 4.2f),\n    target = Vector3f(0f, 0f, 0f),\n    width = 480,\n    height = 320,\n)\nval binning = SplatTiles.bin(cloud, count, view)\n\n// One cell per 16x16 tile, row 0 at the top like the image. Log scale: the core is\n// hundreds of times heavier than the halo.\nshowHeatmap(binning.countRows(), colormap = \"inferno\", width = 360, logScale = true, smooth = false, flipY = false)\nprintln(\n    \"heaviest tile ${binning.maxCount} splats, 99th percentile ${binning.quantile(0.99)}, median ${binning.quantile(0.5)}\",\n)\n"}}} {"id" "splat_tiles_image" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - binned against the reference" "_tombstone" false "frame" #afield/rect [60.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "splat_tiles_image_code_.kt" "inline" "import afield.graphics.render.SplatRaster\nimport afield.graphics.render.SplatTiles\nimport afield.math.linalg.Vector3f\n\n// A dense core inside a sparse halo, in the renderer's 16-float layout.\nval count = 40_000\nval cloud = SplatTiles.clusteredCloud(count)\nval view = SplatRaster.View.lookAt(\n    eye = Vector3f(0f, 0f, 4.2f),\n    target = Vector3f(0f, 0f, 0f),\n    width = 480,\n    height = 320,\n)\n\nval reference = SplatRaster.rasterize(cloud, count, view).image.toArgb()\nval binning = SplatTiles.bin(cloud, count, view)\nval tiled = SplatTiles.render(binning).image.toArgb()\n\nvar worst = 0\nfor (i in reference.indices) for (shift in listOf(16, 8, 0)) {\n    worst = max(worst, abs(((reference[i] shr shift) and 255) - ((tiled[i] shr shift) and 255)))\n}\nprintln(binning)\nprintln(\"largest difference from SplatRaster: $worst of 255\")\nshowImage(tiled, view.width, view.height)\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJ