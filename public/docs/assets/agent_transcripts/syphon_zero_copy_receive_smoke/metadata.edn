{"version" 2 "boxes" [{"id" "syphon_zero_copy_renderer" "properties" {"children" #{#afield/box "syphon_zero_copy_smoke"} "parents" #{#afield/box "root"} "name" "syphon zero-copy renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 320.0 100.0] "code" #afield/file-inline {"path" "syphon_zero_copy_renderer_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\nOptions.profiling = false\n\nonce.renderer {\n    window = Window(\"Syphon zero-copy receive smoke\")\n    Renderer(window)\n}\n\nprintln(\"syphon zero-copy renderer ready\")\nstart(renderer::run)\n"}}} {"id" "syphon_zero_copy_smoke" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "syphon_zero_copy_renderer"} "name" "Syphon receive, zero-copy, exact pixels" "_tombstone" false "frame" #afield/rect [320.0 180.0 350.0 100.0] "code" #afield/file-inline {"path" "syphon_zero_copy_smoke_code_.kt" "inline" "import afield.io.syphon.*\nimport java.io.ByteArrayInputStream\nimport java.util.Base64\nimport javax.imageio.ImageIO\nimport org.lwjgl.vulkan.VK10.*\n\ncheck(Syphon.isAvailable) { Syphon.describe() }\nval probePath =\n    SyphonLibrary.probePath ?: throw IllegalStateException(\"field_syphon_probe is missing: ./gradlew buildSyphonNative\")\nval device = renderer.device\nprintln(\n    \"syphon-zero-copy driver=${device.physicalDevice.driverName} metalObjects=${device.supportsMetalObjects} externalMemoryHost=${device.supportsExternalMemoryHost}\",\n)\n\n// 64x48 for the first half of 14 s, then 96x64\nval name = \"FieldZeroCopySmoke-${ProcessHandle.current().pid()}\"\nval proc =\n    ProcessBuilder(probePath.toString(), \"serve\", name, \"14\", \"64\", \"48\", \"96\", \"64\").redirectErrorStream(true).start()\nval inp = syphonClient(name, 8000)\nval tex = inp.texture()\nprop<SyphonTexture>(syphonIn) = tex\nval copiesBefore = Syphon.cpuCopies\nprintln(\"syphon-zero-copy path=${tex.path} size=${tex.width}x${tex.height} fallback='${tex.fallbackReason}'\")\nrequire(tex.path != SyphonTexture.Path.CPU_COPY) { \"fell back to copying: ${tex.fallbackReason}\" }\n\nprop<RenderToTexture>(syphonProbeTarget) = RenderToTexture {\n    width = 96\n    height = 64\n}\nrenderer.renderList += \"syphonProbeTarget\" to syphonProbeTarget\nval module = moduleHere()\nval quad = Mesh()\nmodule += \"quad\" to quad\nsyphonProbeTarget += \"sample\" to module\nquad.set(4, 2) {\n    pos.add(-1, -1, 0, 1, -1, 0, 1, 1, 0, -1, 1, 0)\n    tc.add(0, 0, 1, 0, 1, 1, 0, 1)\n    tri.add(0, 1, 2)\n    tri.add(0, 2, 3)\n}\n\nfun check(w: Int, h: Int) {\n    val html: String = TexturePreviewCache.capture(\n        renderer,\n        syphonProbeTarget.colorImageHandles[0],\n        syphonProbeTarget.colorFormats[0],\n        96,\n        64,\n        VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,\n        96,\n    ) ?: throw IllegalStateException(\"readback failed\")\n    val png =\n        Regex(\"base64,([^']+)\").find(html)?.groupValues?.get(1) ?: throw IllegalStateException(\"PNG payload missing\")\n    val image = ImageIO.read(ByteArrayInputStream(Base64.getDecoder().decode(png)))\n    val points = listOf(1 to 1, w / 4 to h / 4, 3 * w / 4 to h / 4, w / 4 to 3 * h / 4, 3 * w / 4 to 3 * h / 4)\n    val want =\n        listOf(listOf(17, 34, 51), listOf(255, 0, 0), listOf(0, 255, 0), listOf(0, 0, 255), listOf(255, 255, 255))\n    val got = points.map { (x, y) ->\n        image.getRGB(x, y).let { listOf((it ushr 16) and 255, (it ushr 8) and 255, it and 255) }\n    }\n    println(\"syphon-zero-copy ${w}x$h path=${tex.path} imports=${tex.imports} frames=${tex.frames} pixels=$got\")\n    require(got == want) { \"${w}x$h: expected $want, sampled $got\" }\n}\n\nvar ticks = 0\nvar phase = 0\nloop {\n    ticks++\n    require(ticks < 1500) { \"timed out in phase $phase: $tex\" }\n    if (phase == 0 && ticks > 60 && tex.width == 64) {\n        check(64, 48)\n        phase = 1\n    } else if (phase == 1 && tex.width == 96) {\n        phase = 2\n        ticks = 1000\n    } else if (phase == 2 && ticks > 1060) {\n        check(96, 64)\n        val copies = Syphon.cpuCopies - copiesBefore\n        println(\n            \"syphon-zero-copy frames=${tex.frames} imports=${tex.imports} cpuCopies(texture)=${tex.cpuCopies} cpuCopies(jvm)=$copies\",\n        )\n        require(tex.imports == 2L) { \"expected one import per surface size, got ${tex.imports}\" }\n        require(tex.cpuCopies == 0L && copies == 0L) { \"frames went through memory: ${tex.cpuCopies} / $copies\" }\n        require(tex.frames > 100) { \"only ${tex.frames} frames arrived\" }\n        println(\"syphon-zero-copy PASS\")\n        end()\n    }\n    frame()\n}\n    .end {\n        renderer.renderList.others.remove(\"syphonProbeTarget\")\n        tex.close()\n        inp.close()\n        proc.destroy()\n    }\n"} "vertex" #afield/file-inline {"path" "syphon_zero_copy_smoke_vertex_.glsl" "inline" "#version 450\nlayout(location = 0) in vec3 pos;\nlayout(location = 1) in vec2 tc;\nvoid main() {\n    gl_Position = vec4(pos.xy, 0.5, 1.0);\n}\n"} "fragment" #afield/file-inline {"path" "syphon_zero_copy_smoke_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 color;\nlayout(set = 0, binding = 0) uniform sampler2D syphonIn;\nvoid main() {\n    // texel (x, y) of the received frame, y down from its top row, into pixel (x, y)\n    color = texelFetch(syphonIn, ivec2(gl_FragCoord.xy), 0);\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}