{"version" 2 "boxes" [{"id" "dataframe_typed" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Typed columns, no strings" "_tombstone" false "frame" #afield/rect [40.0 40.0 380.0 100.0] "code" #afield/file-inline {"path" "dataframe_typed_code_.kt" "inline" "import org.jetbrains.kotlinx.dataframe.api.*\n\n// No @DataSchema, no generated accessors checked into the project. The plugin reads this\n// call at compile time and types the result by the columns it produces.\nval people = dataFrameOf(\"name\", \"age\")(\n    \"Alice\",\n    15,\n    \"Bob\",\n    30,\n    \"Cara\",\n    45,\n)\n\nprintln(\"names: \" + people.name.toList())\nprintln(\"ages: \" + people.age.toList())\nprintln(\"mean age: \" + people.age.toList().average())\n"}}} {"id" "dataframe_derived" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - A schema that changes" "_tombstone" false "frame" #afield/rect [480.0 40.0 380.0 100.0] "code" #afield/file-inline {"path" "dataframe_derived_code_.kt" "inline" "import org.jetbrains.kotlinx.dataframe.api.*\n\n/*\n`decade` is not in the source data and is not a string lookup: `add` returns a NEW\nschema, and the plugin worked out what that schema is. `age` resolving inside both\nlambdas is the same mechanism one step earlier.\n*/\nval adults = dataFrameOf(\"name\", \"age\")(\n    \"Alice\",\n    15,\n    \"Bob\",\n    30,\n    \"Cara\",\n    45,\n).filter { age >= 18 }\n    .add(\"decade\") { age / 10 }\n\nprintln(\"kept: \" + adults.name.toList())\nprintln(\"decade: \" + adults.decade.toList())\n"}}} {"id" "dataframe_live" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - Typed across the boundary" "_tombstone" false "frame" #afield/rect [480.0 190.0 380.0 100.0] "code" #afield/file-inline {"path" "dataframe_live_code_.kt" "inline" "import org.jetbrains.kotlinx.dataframe.api.*\n\n/*\ntyped() reads the loaded columns and writes a named schema into this box's preamble:\n@DataSchema interface Peach { val name: String; val age: Int }\nThat named type lets later fragments use the columns as Kotlin properties.\n*/\nval people = dataFrameOf(\"name\", \"age\")(\n    \"Alice\",\n    15,\n    \"Bob\",\n    30,\n    \"Cara\",\n    45,\n).typed(\"Peach\")\n\n/*\nKeep this break: the first fragment writes Peach, then Field reloads the preamble\nbefore compiling the fragment below. Once loaded, select and run the lines below\nrepeatedly to query the same frame without reloading its data.\n*/\n//%-\nval p = people.cast<Peach>()\nprintln(\"ages: \" + p.age.toList())\nprintln(\"adults: \" + p.filter { age >= 18 }.name.toList())\n"}}} {"id" "dataframe_one_pass" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - The whole chain in one pass" "_tombstone" false "frame" #afield/rect [40.0 190.0 380.0 100.0] "code" #afield/file-inline {"path" "dataframe_one_pass_code_.kt" "inline" "import org.jetbrains.kotlinx.dataframe.api.*\n\n// The shape that works: derive and consume inside a single execution, so the refined\n// type never has to outlive the expression that created it.\nval summary = dataFrameOf(\"name\", \"age\")(\n    \"Alice\",\n    15,\n    \"Bob\",\n    30,\n    \"Cara\",\n    45,\n).add(\"adult\") { age >= 18 }\n    .let { d -> d.name.toList().zip(d.adult.toList()) }\n\nprintln(summary)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" 