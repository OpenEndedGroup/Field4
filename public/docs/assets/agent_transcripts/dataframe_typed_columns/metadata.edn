{"version" 2 "boxes" [{"id" "dataframe_typed" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Typed columns, no strings" "_tombstone" false "frame" #afield/rect [40.0 40.0 440.0 270.0] "code" #afield/file-inline {"path" "dataframe_typed_code_.kt" "inline" "import org.jetbrains.kotlinx.dataframe.api.*\n\n// No @DataSchema, no generated accessors checked into the project. The plugin reads this\n// call at compile time and types the result by the columns it produces.\nval people = dataFrameOf(\"name\", \"age\")(\n    \"Alice\", 15,\n    \"Bob\", 30,\n    \"Cara\", 45,\n)\n\nprintln(\"names: \" + people.name.toList())\nprintln(\"ages: \" + people.age.toList())\nprintln(\"mean age: \" + people.age.toList().average())\n"}}} {"id" "dataframe_derived" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - A schema that changes" "_tombstone" false "frame" #afield/rect [510.0 40.0 440.0 270.0] "code" #afield/file-inline {"path" "dataframe_derived_code_.kt" "inline" "import org.jetbrains.kotlinx.dataframe.api.*\n\n// `decade` is not in the source data and is not a string lookup: `add` returns a NEW\n// schema, and the plugin worked out what that schema is. `age` resolving inside both\n// lambdas is the same mechanism one step earlier.\nval adults = dataFrameOf(\"name\", \"age\")(\n    \"Alice\", 15,\n    \"Bob\", 30,\n    \"Cara\", 45,\n)\n    .filter { age >= 18 }\n    .add(\"decade\") { age / 10 }\n\nprintln(\"kept: \" + adults.name.toList())\nprintln(\"decade: \" + adults.decade.toList())\n"}}} {"id" "dataframe_boundary" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - The limit (do not run)" "_tombstone" false "frame" #afield/rect [510.0 340.0 440.0 250.0] "code" #afield/file-inline {"path" "dataframe_boundary_code_.kt" "inline" "import org.jetbrains.kotlinx.dataframe.api.*\n\n// MEASURED LIMIT — this box is here to be read, not run. Executing it fails with\n//   <empty compile time schema>\n//   Unresolved reference 'age' on receiver of type 'DataFrame<Any>'\n//\n// The plugin rewrites a refined call into `run { class Token; ...; call() as\n// DataFrame<Token> }` with LOCAL classes, because its extension point works at\n// body-resolve and cannot create top-level declarations. A local class cannot appear in\n// the type of a snippet's property, so the refinement is erased at the boundary.\n//\n// Naming a @DataSchema does not rescue it either: the type then survives as\n// DataFrame<Person> with a known schema, but TopLevelExtensionsGenerator finds schemas\n// through K2's predicate-based provider, which is source-only — so a schema compiled\n// elsewhere generates no accessors. The designed route is the plugin's `schemasPath`\n// option plus ImportedSchemasGenerator, which Field does not wire yet.\nval df = dataFrameOf(\"name\", \"age\")(\"Alice\", 15)\n// ... then, in a LATER execution of this same box:\n// df.age.toList()      // <- does not compile\n"}}} {"id" "dataframe_one_pass" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - The whole chain in one pass" "_tombstone" false "frame" #afield/rect [40.0 340.0 440.0 250.0] "code" #afield/file-inline {"path" "dataframe_one_pass_code_.kt" "inline" "import org.jetbrains.kotlinx.dataframe.api.*\n\n// The shape that works: derive and consume inside a single execution, so the refined\n// type never has to outlive the expression that created it.\nval summary = dataFrameOf(\"name\", \"age\")(\n    \"Alice\", 15,\n    \"Bob\", 30,\n    \"Cara\", 45,\n)\n    .add(\"adult\") { age >= 18 }\n    .let { d -> d.name.toList().zip(d.adult.toList()) }\n\nprintln(summary)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory"]}