{"version" 2 "boxes" [{"id" "squircle_morph" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Squircles by gauge (slider)" "_tombstone" false "frame" #afield/rect [60.0 60.0 360.0 136.0] "code" #afield/file-inline {"path" "squircle_morph_code_.kt" "inline" "val styles = [\n    SquircleStyle.Superellipse,\n    SquircleStyle.SuperellipseCubic,\n    SquircleStyle.Chromium,\n    SquircleStyle.Figma,\n    SquircleStyle.Clothoid,\n]\nval colors = [\n    vec(1.0, 1.0, 1.0, 1.0),\n    vec(1.0, 0.55, 0.45, 1.0),\n    vec(1.0, 0.8, 0.3, 1.0),\n    vec(0.7, 0.6, 1.0, 1.0),\n    vec(0.5, 0.8, 1.0, 1.0),\n]\n\n// every shape, and its curvature round one corner, at one gauge\nfun draw(gauge: Double) {\n    val drawn = ArrayList<FLine>()\n    for ((i, style) in styles.withIndex()) {\n        val left = 20.0 + i * 130\n        drawn +=\n            squircleFrom(vec(left + 55, 70), 50.0, gauge = gauge, style = style).apply {\n                thickness = 3.0\n                color = colors[i]\n            }\n        val profile = squircleCurvatureProfile(style, gauge)\n        val length = profile.last().x\n        drawn +=\n            polylineFrom(profile.map { vec(left + it.x / length * 110, 260 - it.y * 15) }).apply {\n                thickness = 2.0\n                color = colors[i]\n            }\n        drawn += polylineFrom([vec(left, 260), vec(left + 110, 260)]).apply { color = vec(1.0, 1.0, 1.0, 0.3) }\n    }\n    lines(drawn, w = 660.0, h = 280.0, fitToSize = true)\n    print(\"gauge ${gauge.f3} = superellipse n ${squircleExponent(gauge).f2}\")\n}\n\nval start = squircleGauge(3.0)\nslider(\"Gauge\", min = 0.708, max = 0.95, initialValue = start) { draw(it) }\ndraw(start)\n"}}} {"id" "squircle_rect" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Rounded rectangles with squircle corners" "_tombstone" false "frame" #afield/rect [60.0 260.0 360.0 136.0] "code" #afield/file-inline {"path" "squircle_rect_code_.kt" "inline" "val circular = squircleRectFrom(20.0, 20.0, 380.0, 160.0, radius = 70.0, gauge = Math.sqrt(0.5)).apply {\n    thickness = 1.5\n    color = vec(1.0, 1.0, 1.0, 0.8)\n}\nval figma = squircleRectFrom(20.0, 20.0, 380.0, 160.0, radius = 70.0, gauge = 0.79, style = SquircleStyle.Figma).apply {\n    thickness = 3.0\n    color = vec(0.7, 0.6, 1.0, 1.0)\n}\nval clothoid = squircleRectFrom(20.0, 20.0, 380.0, 160.0, radius = 70.0, gauge = 0.79, style = SquircleStyle.Clothoid).apply {\n    thickness = 3.0\n    color = vec(0.5, 0.8, 1.0, 1.0)\n}\nval figmaComb = figma.curvatureComb(scale = 600.0, samples = 400).apply { color = vec(0.7, 0.6, 1.0, 0.45) }\nval clothoidComb = clothoid.curvatureComb(scale = 600.0, samples = 400).apply { color = vec(0.5, 0.8, 1.0, 0.45) }\n\nlines(figmaComb, clothoidComb, circular, figma, clothoid, w = 420.0, h = 200.0, fitToSize = true)\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "