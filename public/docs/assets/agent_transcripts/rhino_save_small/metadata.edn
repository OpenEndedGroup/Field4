{"version" 2 "boxes" [{"id" "rhino_save_small_draw" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "saved meshes vs evaluated" "_tombstone" false "frame" #afield/rect [40.0 40.0 420.0 120.0] "code" #afield/file-inline {"path" "rhino_save_small_draw_code_.kt" "inline" "import afield.geometry.rhino.*\n\n// A \"Save Small\" .3dm: NURBS Breps and SubDs with no render meshes, drawn as Rhino's saved\n// meshes alone would give them, then tessellated from their exact surfaces\nif (!Rhino3dm.isAvailable) {\n    println(Rhino3dm.describe())\n} else {\n    val dir = java.nio.file.Files.createTempDirectory(\"rhino-nurbs\").toFile()\n    val file = Rhino3dm.writeNurbsSample(java.io.File(dir, \"save_small.3dm\"))\n    val saved = Rhino3dm.load(file, meshing = RhinoBrepMeshing.SAVED)\n    val evaluated = Rhino3dm.load(file)\n    println(evaluated)\n    three(channel = \"saved\", name = \"saved\", height = 360) { rhino(saved) }\n    three(channel = \"evaluated\", name = \"evaluated\", height = 360) { rhino(evaluated) }\n    dir.deleteRecursively()\n}\n"}}} {"id" "rhino_save_small_measure" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "area against the exact shapes" "_tombstone" false "frame" #afield/rect [40.0 200.0 420.0 120.0] "code" #afield/file-inline {"path" "rhino_save_small_measure_code_.kt" "inline" "import afield.geometry.rhino.*\n\n// How close the tessellations are to the shapes the file describes: area against the analytic\n// value, at the default tolerance and at a ten times finer one\nif (!Rhino3dm.isAvailable) {\n    println(Rhino3dm.describe())\n} else {\n    val dir = java.nio.file.Files.createTempDirectory(\"rhino-nurbs\").toFile()\n    val file = Rhino3dm.writeNurbsSample(java.io.File(dir, \"save_small.3dm\"))\n    val exact = mapOf(\n        \"sphere\" to 4 * PI * 100,\n        \"capped cylinder\" to 2 * PI * 5 * 20 + 2 * PI * 25,\n        \"plate with hole\" to 400 - PI * 25,\n        \"creased SubD\" to 600.0,\n    )\n    for (tolerance in [null, 0.003]) {\n        val model = Rhino3dm.load(file, tolerance = tolerance)\n        println(\"tolerance ${tolerance ?: \"default\"}\")\n        for ((name, area) in exact) {\n            val mesh = model.meshes.single { it.name == name }.mesh\n            val error = (mesh.surfaceArea() - area) / area * 100\n            println(\n                \"  ${name.padEnd(16)} ${mesh.triangleCount.toString().padStart(6)} triangles, area off by ${error.f3}%\",\n            )\n        }\n    }\n    dir.deleteRecursively()\n}\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}