{"version" 2 "boxes" [{"id" "mqtt_route_model" "properties" {"children" #{#afield/box "mqtt_route_source"} "parents" #{#afield/box "root"} "name" "1 · Derive and draw the routes" "_tombstone" false "frame" #afield/rect [590.0 80.0 330.0 90.0] "code" #afield/file-inline {"path" "mqtt_route_model_code_.kt" "inline" "import afield.io.mqtt.mqtt\nimport java.util.UUID\n\nprop<String>(routingTopic)\nroutingTopic = \"field/routing/${UUID.randomUUID()}\"\n\nval direct = \"direct\" to (\"console\" to \"screen\")\nval send = \"send\" to (\"console\" to \"relay\")\nval forward = \"forward\" to (\"relay\" to \"screen\")\nval links = [direct, send, forward]\nval positions = mapOf(\"console\" to vec(30, 55, 0), \"relay\" to vec(210, 165, 0), \"screen\" to vec(390, 55, 0))\nval teal = vec(0.23, 0.83, 0.74, 1.0)\nval grey = vec(0.35, 0.4, 0.47, 1.0)\n\nval model = Datalog()\nmodel.add(\n    \"\"\"\n    reach(A, B) :- link(A, B).\n    reach(A, C) :- reach(A, B), link(B, C).\n    \"\"\",\n)\n\nfun showSnapshot(active: Set<String>) {\n    val routes = model.rowsOf(\"reach\")\n    val proof = model.why(\"reach(console, screen)\")\n    val reachable = routes.filter { it[0] == \"console\" }.map { it[1] }.toSet() + \"console\"\n    val diagram = buildList {\n        links.forEach { (name, endpoints) ->\n            val (from, to) = endpoints\n            add(\n                fline {\n                    moveTo(positions.getValue(from))\n                    lineTo(positions.getValue(to))\n                    color = if (name in active) teal else grey\n                    thickness = if (name in active) 4.0 else 1.0\n                },\n            )\n        }\n        positions.forEach { (name, at) ->\n            add(\n                fline {\n                    circle(at.x.toDouble(), at.y.toDouble(), 9.0)\n                    filled = true\n                    color = if (name in reachable) teal else grey\n                },\n            )\n        }\n    }\n    lines(diagram, w = 480.0, h = 170.0, fitToSize = true)\n    val status = if (proof == null) \"Screen unreachable\" else \"Screen reachable\"\n    val detail = proof?.render() ?: \"No live route from the console.\"\n    markdown(\"route\", \"### $status\\n\\nConsole (left), relay (bottom), screen (right).\\n\\n~~~\\n$detail\\n~~~\")\n    println(status)\n}\n\nmarkdown(\"route\", \"Waiting for a routing snapshot.\")\nvar hasSnapshot = false\nmqtt.subscribe(routingTopic, key = \"routing\") { _, message ->\n    val flags = links.mapNotNull { (name, _) ->\n        message.number(name)?.takeIf { it == 0.0 || it == 1.0 }?.let { name to it }\n    }\n    if (flags.size == links.size) {\n        val active = flags.filter { it.second == 1.0 }.map { it.first }.toSet()\n        val changed = model.replaceFacts(\n            \"link\",\n            links.filter { it.first in active }.map { (_, endpoints) -> [endpoints.first, endpoints.second] },\n        )\n        if (!hasSnapshot || changed) showSnapshot(active)\n        hasSnapshot = true\n    }\n}\n"}}} {"id" "mqtt_route_source" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "mqtt_route_model"} "name" "2 · Switch the connections" "_tombstone" false "frame" #afield/rect [80.0 80.0 330.0 90.0] "code" #afield/file-inline {"path" "mqtt_route_source_code_.kt" "inline" "import afield.io.mqtt.mqtt\n\nprop<String>(routingTopic)\nvar direct = false\nvar send = true\nvar forward = true\n\ncontrolGroup(\"Links\") {\n    checkbox(\"Direct: console to screen\", direct) { direct = it }\n    checkbox(\"Console to relay\", send) { send = it }\n    checkbox(\"Relay to screen\", forward) { forward = it }\n}\n\nloop {\n    mqtt.publish(\n        routingTopic,\n        mapOf(\n            \"direct\" to if (direct) 1 else 0,\n            \"send\" to if (send) 1 else 0,\n            \"forward\" to if (forward) 1 else 0,\n        ),\n    )\n    delay(400)\n}\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}