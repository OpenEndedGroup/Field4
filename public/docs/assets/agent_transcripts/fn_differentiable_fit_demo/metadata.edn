{"version" 2 "boxes" [{"id" "fn_fit_demo" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "differentiable Fn fit" "_tombstone" false "frame" #afield/rect [80.0 60.0 300.0 100.0] "code" #afield/file-inline {"path" "fn_fit_demo_code_.kt" "inline" "import afield.stdlib.Functions\nimport afield.stdlib.fitBest\n\nwith(Functions) {\n    val target = cos(2) * sin(1.5, amplitude = 0.8, offset = 0.2)\n    val seed   = cos(3.4) * sin(1.0, amplitude = 2.0)\n\n    // fitBest = jittered restarts; escapes the frequency local-minimum a single\n    // fitGradient would stall in. domain defaults to 0..1; no Functions.Domain(...) needed.\n    val run = fitBest(target, seed, restarts = 16)\n\n    plot(target,     channel = \"1 target\", title = \"target  cos·sin\")\n    plot(run.fitted, channel = \"2 fitted\", title = \"gradient-fitted (best of 16 restarts)\")\n\n    run   // Field renders the FnFitRun: RMSE before -> after + a loss sparkline\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}