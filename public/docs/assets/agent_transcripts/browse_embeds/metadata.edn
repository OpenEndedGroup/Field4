{"version" 2 "boxes" [{"id" "column_box" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - column(): Finder columns" "_tombstone" false "frame" #afield/rect [620.0 60.0 440.0 60.0] "code" #afield/file-inline {"path" "column_box_code_.kt" "inline" "// The same kind of value as Finder-style columns: choosing a row opens it in the next column.\ndata class Layer(val name: String, val visible: Boolean, val points: IntArray)\n\nval document = linkedMapOf(\n    \"layers\" to [Layer(\"dots\", true, intArrayOf(2, 4, 8, 16)), Layer(\"lines\", false, intArrayOf())],\n    \"camera\" to mapOf(\"x\" to 10, \"y\" to 20, \"zoom\" to 1.5),\n    \"title\" to \"a document\\nwith two lines\",\n)\ncolumn(\"columns\", document)\n"}}} {"id" "logs_box" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - logs(): one channel, with find" "_tombstone" false "frame" #afield/rect [620.0 760.0 440.0 60.0] "code" #afield/file-inline {"path" "logs_box_code_.kt" "inline" "// logs(...) streams Field's log into a panel; this one only shows the \"demo\" channel.\n// Type in its find box (or press /) to narrow it; scroll up and new rows wait behind \"↓ N new\".\nlogs(\"logs\") { channel(\"demo\") }\n\nval log = afield.ai.diagnostics.LogDispatcher\nlog.log(\n    afield.ai.diagnostics.LogEvent(\n        \"demo\",\n        \"starting a job\",\n        blockId = \"job (1)\",\n        boundary = afield.ai.diagnostics.BlockBoundary.BEGIN,\n    ),\n)\nfor (i in 1..3) log.log(afield.ai.diagnostics.LogEvent(\"demo\", \"step $i of 3\", blockId = \"job (1)\"))\nlog.log(\n    afield.ai.diagnostics.LogEvent(\n        \"demo\",\n        \"done\",\n        blockId = \"job (1)\",\n        boundary = afield.ai.diagnostics.BlockBoundary.END,\n    ),\n)\nlog.log(afield.ai.diagnostics.LogEvent(\"demo warning\", \"a warning row is coloured\"))\n"}}} {"id" "live_box" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - a tree that follows the value" "_tombstone" false "frame" #afield/rect [60.0 760.0 440.0 60.0] "code" #afield/file-inline {"path" "live_box_code_.kt" "inline" "// Open rows follow the value. This box keeps running and adds a reading every half second;\n// open \"readings\" in the tree and watch its size and last rows change without re-running.\nval readings = mutableListOf<Double>()\nval state = linkedMapOf<String, Any?>(\"readings\" to readings, \"last\" to null)\ntree(\"live\", state)\n\nframes {\n    var next = System.currentTimeMillis()\n    while (frame()) {\n        if (System.currentTimeMillis() >= next && readings.size < 120) {\n            next += 500\n            readings += Math.round(Math.sin(readings.size * 0.3) * 1000) / 1000.0\n            state[\"last\"] = readings.last()\n        }\n    }\n}\n"}}} {"id" "tree_box" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - tree(): any value, lazily" "_tombstone" false "frame" #afield/rect [60.0 60.0 440.0 60.0] "code" #afield/file-inline {"path" "tree_box_code_.kt" "inline" "// Any value can go into tree(...): maps, lists, arrays, data classes, your own classes.\n// Each row shows name, type and a one-line summary; click a triangle (or use the arrow keys) to open.\n// Type **/tag into the filter: it runs scene.graphPaths(\"**/tag\") and lists the matching paths.\n// Press p on a row to copy its path, e.g. particle/age, then scene.graphPath(\"particle/age\") reads it.\ndata class Particle(val position: Vec3, val age: Double, val tag: String)\nclass Node(val name: String) {\n    var next: Node? = null\n}\n\nval a = Node(\"a\")\nval b = Node(\"b\")\na.next = b\nb.next = a // a loop: shown with ↺, not opened forever\n\nval scene = linkedMapOf(\n    \"particle\" to Particle(Vec3(1f, 2f, 0.5f), 0.25, \"spark\"),\n    \"weights\" to doubleArrayOf(0.1, 0.4, 0.5),\n    \"many\" to List(5000) { it * it }, // arrives 200 rows at a time\n    \"byKey\" to\n        mapOf(\n            Particle(Vec3(0f, 0f, 0f), 0.0, \"origin\") to \"an object as a key\",\n            1 to \"one\",\n            \"1\" to \"the string one\",\n        ),\n    \"ring\" to a,\n    \"missing\" to null,\n)\ntree(\"tree\", scene)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}