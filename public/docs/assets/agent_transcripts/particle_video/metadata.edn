{"version" 2 "boxes" [{"id" "particle_video_track" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 · track a movie" "_tombstone" false "frame" #afield/rect [920.0 40.0 400.0 70.0] "code" #afield/file-inline {"path" "particle_video_track_code_.kt" "inline" "val tracker = particleTracker()\nsuspend fun process() {\n    val run = tracker.track(\n        \"public/docs/assets/particle_video/source.mkv\",\n        ParticleTrackingOptions(particles = 24000, colorLimit = 1.0),\n    )\n    println(\"cached=${run.cacheHit}; tracks=${run.tracksFile}\")\n    particleVideoView(run.load(), stride = 16)\n}\nstart(::process)\n"}}} {"id" "particle_video_reader" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 · scrub recorded particles" "_tombstone" false "frame" #afield/rect [480.0 40.0 400.0 70.0] "code" #afield/file-inline {"path" "particle_video_reader_code_.kt" "inline" "val video = loadParticleVideo(\"public/docs/assets/particle_video/example.pvt.gz\")\nparticleVideoView(video, initialSeconds = 7.2, scale = 1, pointRadius = 1.5)\n"}}} {"id" "particle_video_guide" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 · video particles" "_tombstone" false "frame" #afield/rect [40.0 40.0 400.0 70.0] "code" #afield/file-inline {"path" "particle_video_guide_code_.kt" "inline" "markdown(\"guide\", \"\"\"\n# Video particles\nBox 2 scrubs recorded tracks without Python. Its portable example retains complete\ntrajectories from a representative subset of the 24,000-particle dance run.\n\nPrepare the optional environment before launching box 3, or set\n`FIELD_PARTICLE_TRACKER_PYTHON` to an existing Torch/Torchvision interpreter.\nReplace the movie filename to track your own footage. Width 0 retains native resolution.\n\n[Video tracking and setup](https://openendedgroup.com/Field4/particle_video/)\n\"\"\".trimIndent())\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "f