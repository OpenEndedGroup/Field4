{"version" 2 "boxes" [{"id" "pd_typo" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "pd_root"} "name" "typo" "_tombstone" false "frame" #afield/rect [420.0 180.0 160.0 80.0] "code_language" "Pd" "code" #afield/file-inline {"path" "pd_typo_code_.kt" "inline" "// [osc 440] is not a Pd object ([osc~ 440] is). Launch: the error is on its line.\n#N canvas 0 0 400 250 12;\n#X obj 20 20 osc 440;\n#X obj 20 60 dac~;\n#X connect 0 0 1 0;\n"}}} {"id" "pd_effect" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "as an effect" "_tombstone" false "frame" #afield/rect [230.0 320.0 160.0 80.0] "code" #afield/file-inline {"path" "pd_effect_code_.kt" "inline" "// A Field sawtooth through a Pd lowpass: `input` feeds the patch's [adc~]. Launch it.\nval fx = pd(\"\"\"\n#X obj 20 20 adc~;\n#X obj 20 60 lop~ 600;\n#X obj 20 100 *~ 0.15;\n#X obj 20 140 dac~;\n#X obj 160 100 env~ 8192;\n#X obj 160 140 s level;\n#X connect 0 0 1 0;\n#X connect 1 0 2 0;\n#X connect 2 0 3 0;\n#X connect 2 0 3 1;\n#X connect 2 0 4 0;\n#X connect 4 0 5 0;\n\"\"\", input = SawOsc(Param(110f)).pan())\nvar n = 0\nfx.receive(\"level\") { m ->\n    if (n++ % 10 == 0) display(\"level\", \"<div style='padding:8px'>after the lowpass: ${\"%.1f\".format(m.float ?: 0f)} dB</div>\")\n}\nfx\n"}}} {"id" "pd_root" "properties" {"children" #{#afield/box "pd_drone" #afield/box "pd_roundtrip" #afield/box "pd_typo"} "parents" #{#afield/box "root"} "name" "status — children of this box are Pure Data" "_tombstone" false "frame" #afield/rect [40.0 40.0 420.0 80.0] "mainLanguage" "pd" "code" #afield/file-inline {"path" "pd_root_code_.kt" "inline" "// This root stays Kotlin; its `mainLanguage` makes the three boxes under it Pd.\nprintln(afield.pd.PdLibrary.describe())\n"}}} {"id" "pd_kotlin" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "from Kotlin" "_tombstone" false "frame" #afield/rect [40.0 320.0 160.0 80.0] "code" #afield/file-inline {"path" "pd_kotlin_code_.kt" "inline" "// A Pd patch as a Kotlin value. Launch it; move the Pitch slider.\nval patch = pd(\"\"\"\n#N canvas 0 0 520 300 12;\n#X obj 20 20 hsl 128 15 55 440 0 0 empty pitch Pitch -2 -8 0 10 #fcfcfc #000000 #000000 0 1;\n#X msg 20 50 \\$1 40;\n#X obj 20 80 line~;\n#X obj 20 110 tabosc4~ wave;\n#X obj 20 140 *~ 0.1;\n#X obj 20 180 dac~;\n#X obj 220 20 table wave 2051;\n#X obj 220 140 env~ 8192;\n#X obj 220 180 s level;\n#X connect 0 0 1 0;\n#X connect 1 0 2 0;\n#X connect 2 0 3 0;\n#X connect 3 0 4 0;\n#X connect 4 0 5 0;\n#X connect 4 0 5 1;\n#X connect 4 0 7 0;\n#X connect 7 0 8 0;\n\"\"\")\n\n// tabosc4~ wants 2^n + 3 points: one guard point before, two after.\nval partials = listOf(1.0, 0.5, 0.33, 0.25, 0.2, 0.16)\nval wave = FloatArray(2051) { i ->\n    val phase = 2 * PI * (i - 1) / 2048\n    (partials.withIndex().sumOf { (k, a) -> a * sin((k + 1) * phase) } * 0.4).toFloat()\n}\npatch.writeArray(\"wave\", wave)\nprintln(\"wrote ${patch.arraySize(\"wave\")} points into [table wave]\")\n\npdControls(patch)          // one slider, from the patch's own hsl\npatch.send(\"pitch\", 110)\n\nvar n = 0\npatch.receive(\"level\") { m ->\n    // env~ reports in dB, 100 = full scale; this lambda runs on Field's main thread.\n    if (n++ % 10 == 0) display(\"level\", \"<div style='padding:8px'>[s level] ${\"%.1f\".format(m.float ?: 0f)} dB</div>\")\n}\npatch\n"}}} {"id" "pd_offline" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "offline" "_tombstone" false "frame" #afield/rect [610.0 320.0 160.0 80.0] "code" #afield/file-inline {"path" "pd_offline_code_.kt" "inline" "// No audio device: render one second, measure it, read back what Pd recorded.\nval text = \"\"\"\n#N canvas 0 0 400 260 12;\n#X obj 20 20 osc~ 440;\n#X obj 20 60 *~ 0.25;\n#X obj 20 100 dac~;\n#X obj 160 100 tabwrite~ scope;\n#X obj 160 20 loadbang;\n#X obj 260 60 table scope 240;\n#X connect 0 0 1 0;\n#X connect 1 0 2 0;\n#X connect 1 0 2 1;\n#X connect 1 0 3 0;\n#X connect 4 0 3 0;\n\"\"\"\nval pd = afield.pd.PdInstance(sampleRate = 48000)\npd.openPatchText(text)\n// Not `val (left, _) = …`: a top-level `_` in a destructuring never completes in a box.\nval (left, right) = pd.renderOffline(1.0)\nval scope = pd.readArray(\"scope\")\npd.close()\n\nval ups = (1 until left.size).count { left[it - 1] < 0f && left[it] >= 0f }\nval peak = left.maxOf { abs(it) }\nprintln(\"$ups upward zero crossings in 1 s, peak ${\"%.4f\".format(peak)}, channels equal: ${left.contentEquals(right)}\")\nshowSignals(\"tabwrite~ scope\" to scope.toList(), channel = \"scope\", title = \"[table scope], recorded by Pd\")\nlines(afield.pd.PdPatchGraph.parse(text).toFLines(), channel = \"patch\", w = 420.0, h = 200.0, fitToSize = true)\n"}}} {"id" "pd_drone" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "pd_root"} "name" "drone" "_tombstone" false "frame" #afield/rect [40.0 180.0 160.0 80.0] "code_language" "Pd" "code" #afield/file-inline {"path" "pd_drone_code_.kt" "inline" "// This text is the patch. Launch the box, then run one of these lines on its own:\nfreq 110\nfreq 330\ncutoff 400\ncutoff 3000\n#N canvas 0 0 500 320 12;\n#X obj 20 20 r freq;\n#X msg 20 50 \\$1 200;\n#X obj 20 80 line~;\n#X obj 20 110 phasor~;\n#X obj 20 140 lop~ 1200;\n#X obj 140 110 r cutoff;\n#X obj 20 170 *~ 0.08;\n#X obj 20 210 dac~;\n#X obj 240 20 loadbang;\n#X msg 240 50 220;\n#X obj 240 80 print drone;\n#X connect 0 0 1 0;\n#X connect 1 0 2 0;\n#X connect 2 0 3 0;\n#X connect 3 0 4 0;\n#X connect 5 0 4 1;\n#X connect 4 0 6 0;\n#X connect 6 0 7 0;\n#X connect 6 0 7 1;\n#X connect 8 0 9 0;\n#X connect 9 0 1 0;\n#X connect 9 0 10 0;\n"}}} {"id" "pd_roundtrip" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "pd_root"} "name" "round trip" "_tombstone" false "frame" #afield/rect [230.0 180.0 160.0 80.0] "code_language" "Pd" "code" #afield/file-inline {"path" "pd_roundtrip_code_.kt" "inline" "// Launch, then run \"in 41\": [+ 1] sends 42 to [s out] and [print] prints it.\nin 41\nin 99\n#N canvas 0 0 400 250 12;\n#X obj 20 20 r in;\n#X obj 20 60 + 1;\n#X obj 20 100 s out;\n#X obj 120 100 print out;\n#X connect 0 0 1 0;\n#X connect 1 0 2 0;\n#X connect 1 0 3 0;\n"}}} {"id" "pd_send" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "to drone, from Kotlin" "_tombstone" false "frame" #afield/rect [420.0 320.0 160.0 80.0] "code" #afield/file-inline {"path" "pd_send_code_.kt" "inline" "// Send numbers to a [r] in another Pd box, found by its name. Launch \"drone\" first.\n// Run one of these lines on its own:\npdBox(\"drone\").pdSend(\"freq\", 330)\npdBox(\"drone\").pdSend(\"freq\", 110)\npdBox(\"drone\").pdSend(\"cutoff\", 3000)\n\n// Or launch this box: an arpeggio into [r freq], one Int a quarter second, until you stop it.\nval drone = pdBox(\"drone\")\nval notes = listOf(110, 165, 220, 330, 440, 330, 220, 165)\nvar i = 0\nloop {\n    drone.pdSend(\"freq\", notes[i++ % notes.size])\n    delay(250)\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory" "mainLanguage"]}