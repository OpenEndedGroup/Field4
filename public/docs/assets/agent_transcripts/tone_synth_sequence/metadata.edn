{"version" 2 "boxes" [{"id" "agent_tone_synth_sequence" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "agent_tone_synth_sequence_root"} "name" "Tone Synth Sequence" "_tombstone" false "frame" #afield/rect [120.0 690.0 300.0 100.0] "code" #afield/file-inline {"path" "agent_tone_synth_sequence_code_.kt" "inline" "// {{ tone }}\n// A tiny chord arpeggio played through a reverb, scheduled on the Transport.\n// Tone is installed as the global `Tone` in the RemoteAR head; every name below is\n// bound by afield.graphics.ToneKotlinJs and grounded against the vendored Tone.js.\nonStart {\n    val synth = Tone.PolySynth()\n    val reverb = Tone.Reverb(2.5)\n    reverb.toDestination()\n    synth.connect(reverb)\n    synth.volume.value = -8.0\n\n    val transport = Tone.getTransport()\n    transport.bpm.value = 96.0\n\n    val chord = arrayOf(\"C4\", \"E4\", \"G4\", \"B4\")\n    var step = 0\n    val event = transport.scheduleRepeat({ time ->\n        val note = chord[step % chord.size]\n        synth.triggerAttackRelease(note, \"8n\", time)\n        step += 1\n    }, \"8n\")\n\n    // Tone.start() resumes the AudioContext; this follows the click inside the head.\n    Tone.start()\n    transport.start()\n    log(\"tone: arpeggio scheduled at \" + transport.bpm.value + \" bpm\")\n\n    onStop {\n        transport.clear(event)\n        transport.stop()\n        synth.dispose()\n        reverb.dispose()\n    }\n}\n"}}} {"id" "agent_tone_head" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "RemoteAR Head (open me — then click to enable audio)" "_tombstone" false "frame" #afield/rect [80.0 80.0 450.0 100.0] "code" #afield/file-inline {"path" "agent_tone_head_code_.kt" "inline" "// The head that plays the sound. It loads Tone.js and connects over the RemoteJS\n// transport; the // {{ tone }} box below compiles to JS and runs in here.\ndisplay(\"tone-head\", \"\"\"\n<iframe\n  src=\"/extensions/remote_ar/index.html?debug=1\"\n  allow=\"xr-spatial-tracking; fullscreen; autoplay\"\n  data-afield-autosize=\"off\"\n  style=\"display:block; width:640px; height:400px; border:0; background:#000\">\n</iframe>\n\"\"\".trimIndent())\ndisplayOpen(\"tone-head\")\n"}}} {"id" "agent_tone_synth_sequence_root" "properties" {"children" #{#afield/box "agent_tone_synth_sequence"} "parents" #{#afield/box "root"} "name" "KotlinJS → Tone" "_tombstone" false "frame" #afield/rect [80.0 580.0 300.0 100.0] "mainLanguage" "kotlinjs" "isKotlinJsRoot" true}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory" "mainLanguage" "isKotlinJsRoot"]}