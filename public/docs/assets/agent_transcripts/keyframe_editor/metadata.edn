{"version" 2 "boxes" [{"id" "kf_shape" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "shape" "_tombstone" false "frame" #afield/rect [760.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "kf_shape_code_.kt" "inline" "// Run this box: one key of each type. Right-click a key to change its type.\nval shape = keyframes(name = \"shape\", keys = listOf(\n    Keyframe(0.0, 0.1, \"linear\"),\n    Keyframe(1.0, 0.8, \"hold\"),\n    Keyframe(2.0, 0.3, \"bezierFlat\"),\n    Keyframe(3.0, 0.9, \"bezierContinuous\"),\n    Keyframe(4.0, 0.5, \"bezierFree\"),\n    Keyframe(5.0, 0.2, \"linear\"),\n))\n"}}} {"id" "kf_smoothed" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "smoothed" "_tombstone" false "frame" #afield/rect [40.0 520.0 300.0 100.0] "code" #afield/file-inline {"path" "kf_smoothed_code_.kt" "inline" "// Run this box, then edit the curve: the dashed overlay is a smoothed copy of it, and\n// onChange redraws it after every edit.\nval wobble = keyframes(name = \"wobble\", defaults = listOf(\n    vec(0.0, 0.2), vec(0.5, 0.9), vec(1.0, 0.1), vec(1.5, 0.8), vec(2.0, 0.3)\n))\n\nval smooth = { keys: List<Keyframe> -> with(Functions) { gaussianSmooth(fromKeyframeEditor(keys), sigma = 0.15) } }\nwobble.setOverlay(smooth(wobble.getKeyframes()))\nwobble.onChange = smooth\n"}}} {"id" "kf_brightness" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "brightness" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "kf_brightness_code_.kt" "inline" "// Launch this box to play the curve: the playhead sweeps it every four seconds and the\n// meter shows its value. Edit the curve while it plays; your edits are saved with the box.\nval brightness = keyframes(name = \"brightness\", defaults = listOf(vec(0.0, 0.1), vec(1.0, 0.9), vec(2.5, 0.4), vec(4.0, 0.1)))\n\nlateinit var level: MeterHandle\ncontrolGroup(\"level\") { level = meter(\"brightness\") }\ndisplayOpen(\"level\")\n\nval start = System.nanoTime()\nloop {\n    val t = ((System.nanoTime() - start) / 1e9) % 4.0\n    brightness.setTime(t)\n    level.set(brightness.evaluateValueAt(t))\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_session" "fileManagerAccessHistory"]}