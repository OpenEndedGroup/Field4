"} "name" "Stop stops launch loops" "_tombstone" false "frame" #afield/rect [60.0 2840.0 420.0 100.0] "code" #afield/file-inline {"path" "rparity_spin_code_.kt" "inline" "// Run this, then Stop it: the counter in the head freezes.\nwindow.spins = 0\nlaunch(() => { window.spins++ }, \"spinner\", false)\nprint(\"spinning\")\n"}}} {"id" "rparity_print" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "rparity_root"} "name" "print and console.log beside their lines" "_tombstone" false "frame" #afield/rect [60.0 640.0 420.0 100.0] "code" #afield/file-inline {"path" "rparity_print_code_.kt" "inline" "// Both appear beside the line that called them; the last value is shown too.\nprint(\"from print\")\nconsole.log(\"from console.log\", {answer: 6 * 7})\nconst now = new Date().getFullYear()\nnow > 2000\n"}}} {"id" "rparity_late" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "rparity_root"} "name" "output printed after the run finished" "_tombstone" false "frame" #afield/rect [60.0 2340.0 420.0 100.0] "code" #afield/file-inline {"path" "rparity_late_code_.kt" "inline" "// The run ends at once; this line prints half a second later, beside line 3.\nsetTimeout(() => {\n  print(\"half a second later\")\n}, 500)\nprint(\"the run is over\")\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" 