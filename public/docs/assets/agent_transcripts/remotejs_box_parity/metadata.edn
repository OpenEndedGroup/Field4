{"version" 2 "boxes" [{"id" "kparity_error" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "kparity_root"} "name" "Kotlin: an exception is marked on its line" "_tombstone" false "frame" #afield/rect [560.0 1140.0 420.0 100.0] "code" #afield/file-inline {"path" "kparity_error_code_.kt" "inline" "// {{ remoteAR }}\n// The marker lands on line 5, the throw inside mean.\nfun mean(values: List<Double>): Double {\n    if (values.isEmpty()) throw IllegalArgumentException(\"mean of nothing\")\n    return values.sum() / values.size\n}\n\nprintln(mean(emptyList()))\n"}}} {"id" "kparity_print" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "kparity_root"} "name" "Kotlin: println and console.log beside their lines" "_tombstone" false "frame" #afield/rect [560.0 640.0 420.0 100.0] "code" #afield/file-inline {"path" "kparity_print_code_.kt" "inline" "// {{ remoteAR }}\nprintln(\"from println\")\nconsole.log(\"from console.log\", 6 * 7)\n"}}} {"id" "rparity_late" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "rparity_root"} "name" "output printed after the run finished" "_tombstone" false "frame" #afield/rect [60.0 2340.0 420.0 100.0] "code" #afield/file-inline {"path" "rparity_late_code_.kt" "inline" "// The run ends at once; this line prints half a second later, beside line 3.\nsetTimeout(() => {\n  print(\"half a second later\")\n}, 500)\nprint(\"the run is over\")\n"}}} {"id" "rparity_root" "properties" {"children" #{#afield/box "rparity_print" #afield/box "rparity_error" #afield/box "rparity_controls" #afield/box "rparity_late" #afield/box "rparity_spin" #afield/box "kparity_root"} "parents" #{#afield/box "root"} "name" "RemoteJS root -- children of this box run as Javascript in the head below" "_tombstone" false "frame" #afield/rect [60.0 40.0 420.0 100.0] "mainLanguage" "remotejs" "isRemoteJSRoot" true "code" #afield/file-inline {"path" "rparity_root_code_.kt" "inline" "// This box stays Kotlin. It opens the browser head on the canvas; its children run there.\nremoteAr(debug = true, width = 480, height = 270)\n"}}} {"id" "rparity_error" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "rparity_root"} "name" "an error is marked where it happened" "_tombstone" false "frame" #afield/rect [60.0 1140.0 420.0 100.0] "code" #afield/file-inline {"path" "rparity_error_code_.kt" "inline" "// The marker lands on line 4, inside mean, where reduce failed --\n// not on line 7, where mean was called.\nfunction mean(values) {\n  return values.reduce((a, b) => a + b) / values.length\n}\n\nmean([])\n"}}} {"id" "rparity_controls" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "rparity_root"} "name" "display, a slider and a checkbox" "_tombstone" false "frame" #afield/rect [60.0 1640.0 420.0 100.0] "code" #afield/file-inline {"path" "rparity_controls_code_.kt" "inline" "// The same output channel and controls a Kotlin box draws, calling back into the head.\nconst state = {freq: 3.0, square: false}\n\nfunction redraw() {\n  display(\"main\", `<b>${state.square ? \"square\" : \"sine\"}</b> at ${state.freq.toFixed(1)} Hz`)\n}\n\nslider(\"frequency\", v => { state.freq = v; redraw() }, {min: 1, max: 10, step: 0.1, value: 3.0})\ncheckbox(\"square wave\", v => { state.square = v; redraw() })\nredraw()\n"}}} {"id" "rparity_spin" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "rparity_root"} "name" "Stop stops launch loops" "_tombstone" false "frame" #afield/rect [60.0 2840.0 420.0 100.0] "code" #afield/file-inline {"path" "rparity_spin_code_.kt" "inline" "// Run this, then Stop it: the counter in the head freezes.\nwindow.spins = 0\nlaunch(() => { window.spins++ }, \"spinner\", false)\nprint(\"spinning\")\n"}}} {"id" "rparity_print" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "rparity_root"} "name" "print and console.log beside their lines" "_tombstone" false "frame" #afield/rect [60.0 640.0 420.0 100.0] "code" #afield/file-inline {"path" "rparity_print_code_.kt" "inline" "// Both appear beside the line that called them; the last value is shown too.\nprint(\"from print\")\nconsole.log(\"from console.log\", {answer: 6 * 7})\nconst now = new Date().getFullYear()\nnow > 2000\n"}}} {"id" "kparity_controls" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "kparity_root"} "name" "Kotlin: display, a slider and a checkbox" "_tombstone" false "frame" #afield/rect [560.0 1640.0 420.0 100.0] "code" #afield/file-inline {"path" "kparity_controls_code_.kt" "inline" "// {{ remoteAR }}\nvar freq = 3.0\nvar square = false\n\nfun redraw() {\n    display(\"main\", \"<b>${if (square) \"square\" else \"sine\"}</b> at ${freq.asDynamic().toFixed(1)} Hz\")\n}\n\nslider(\"frequency\", min = 1.0, max = 10.0, step = 0.1, initialValue = 3.0) {\n    freq = it\n    redraw()\n}\ncheckbox(\"square wave\") {\n    square = it\n    redraw()\n}\nredraw()\n"}}} {"id" "kparity_late" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "kparity_root"} "name" "Kotlin: output printed after the run finished" "_tombstone" false "frame" #afield/rect [560.0 2340.0 420.0 100.0] "code" #afield/file-inline {"path" "kparity_late_code_.kt" "inline" "// {{ remoteAR }}\n// The run ends at once; line 4 prints half a second later.\nsetTimeout(\n    {\n        println(\"half a second later\")\n    },\n    500,\n)\nprintln(\"the run is over\")\n"}}} {"id" "kparity_root" "properties" {"children" #{#afield/box "kparity_print" #afield/box "kparity_error" #afield/box "kparity_controls" #afield/box "kparity_late" #afield/box "kparity_spin"} "parents" #{#afield/box "root" #afield/box "rparity_root"} "name" "Kotlin → head root -- children of this box are Kotlin compiled to Javascript" "_tombstone" false "frame" #afield/rect [560.0 40.0 420.0 100.0] "mainLanguage" "kotlinjs" "isKotlinJsRoot" true "code" #afield/file-inline {"path" "kparity_root_code_.kt" "inline" "// Nothing to run here. Boxes under this one are Kotlin, compiled to Javascript and sent\n// to the same browser head as the Javascript boxes on the left.\n"}}} {"id" "kparity_spin" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "kparity_root"} "name" "Kotlin: Launch, then Stop, a frame loop" "_tombstone" false "frame" #afield/rect [560.0 2840.0 420.0 100.0] "code" #afield/file-inline {"path" "kparity_spin_code_.kt" "inline" "// {{ remoteAR }}\n// Launch this, then Stop it: the frame count stops changing.\nonStart {\n    onFrame { frame ->\n        if (frame.frameNumber % 30 == 0) display(\"main\", \"frame ${frame.frameNumber}\")\n    }\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole" "mainLanguage" "isKotlinJsRoot"]}