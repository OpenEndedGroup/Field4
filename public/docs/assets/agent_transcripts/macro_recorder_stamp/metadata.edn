{"version" 2 "boxes" [{"id" "mr_steps" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "steps" "_tombstone" false "frame" #afield/rect [80.0 640.0 300.0 100.0] "code" #afield/file-inline {"path" "mr_steps_code_.kt" "inline" "// Step through \"stamp\" one operation at a time, as the panel's Step button does.\nval document = thisBox.inside.filename\n(0 until 3).forEach { step ->\n    val run = OperationTranscript.runMacro(\n        document,\n        \"stamp\",\n        replay = OperationTranscript.MacroReplayOptions(step = step),\n    )\n    println(\"step ${step + 1}: ${run.message}\" + run.errors.joinToString(\"\") { \" \" + it })\n}\nprintln(\"the original pair is wired: ${thisBox.inside.boxes[\"stamp_source\"]?.children?.map { it.name }}\")\n"}}} {"id" "mr_stamp" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "stamp" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 100.0] "code" #afield/file-inline {"path" "mr_stamp_code_.kt" "inline" "// A macro is YAML. This one is what the recorder writes when you make a box with code,\n// make another, and connect them with `g`.\nval stamp =\n    \"\"\"\n    name: stamp\n    operations:\n      - create:\n          box: stamp_source\n          name: Source\n          frame: { x: 520.0, y: 80.0, w: 300.0, h: 100.0 }\n          properties:\n            code: |\n              println(\"source\")\n      - create:\n          box: stamp_sink\n          name: Sink\n          frame: { x: 880.0, y: 80.0, w: 300.0, h: 100.0 }\n      - connect:\n          parent: stamp_source\n          child: stamp_sink\n    \"\"\"\n        .trimIndent()\nval saved = OperationTranscript.writeMacro(thisBox.inside.filename, \"stamp\", stamp)\nprintln(\"${saved.message} ${saved.operationCount} operations\")\n"}}} {"id" "mr_copies" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "copies" "_tombstone" false "frame" #afield/rect [80.0 360.0 300.0 100.0] "code" #afield/file-inline {"path" "mr_copies_code_.kt" "inline" "// Replay \"stamp\" as a copy three times, each 140 lower: the boxes it creates get new\n// identities on every run, so each run makes another connected pair.\nval document = thisBox.inside.filename\n(1..3).forEach { i ->\n    val run = OperationTranscript.runMacro(\n        document,\n        \"stamp\",\n        replay = OperationTranscript.MacroReplayOptions(asCopy = true, offsetY = 140.0 * i),\n    )\n    println(run.message + run.errors.joinToString(\"\") { \" \" + it })\n}\nval sources = thisBox.inside.boxes.values.filter { it.name == \"Source\" }\nprintln(\n    \"${sources.size} Source boxes; Sinks wired to each: ${sources.map { s -> s.children.count { it.name == \"Sink\" } }}\",\n)\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}