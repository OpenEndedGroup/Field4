{"version" 2 "boxes" [{"id" "agent_remotear_start_root" "properties" {"children" #{#afield/box "agent_remotear_start"} "parents" #{#afield/box "root"} "name" "KotlinJS → RemoteAR" "_tombstone" false "frame" #afield/rect [50.0 50.0 300.0 100.0] "mainLanguage" "kotlinjs" "isKotlinJsRoot" true}} {"id" "agent_remotear_start" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "agent_remotear_start_root"} "name" "RemoteAR Starter" "_tombstone" false "frame" #afield/rect [90.0 150.0 300.0 100.0] "code" #afield/file-inline {"path" "agent_remotear_start_code_.kt" "inline" "// {{ remoteAR }}\n// Open /extensions/remote_ar/index.html?debug=1 on the browser or headset.\n// Edit this box and Launch it again to replace the running scene.\nonStart {\n    val cube = addBox(\"starter-cube\", 0.3).mesh\n    cube.position.set(0.0, 1.2, -1.5)\n\n    onFrame { frame ->\n        cube.rotation.x = frame.time * 0.35\n        cube.rotation.y = frame.time\n    }\n\n    onStop {\n        SCENE.remove(cube)\n        println(\"RemoteAR starter stopped\")\n    }\n\n    println(\"RemoteAR starter running\")\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory" "mai