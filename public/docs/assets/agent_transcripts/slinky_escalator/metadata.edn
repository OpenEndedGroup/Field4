{"version" 2 "boxes" [{"id" "slinky_walk" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "a slinky walking down stairs" "_tombstone" false "frame" #afield/rect [80.0 80.0 360.0 100.0] "code" #afield/file-inline {"path" "slinky_walk_code_.kt" "inline" "import afield.simulation.physics.*\n\n// Lengths are in coil diameters. The slow-motion factor changes only how fast the picture runs.\nvar run = 1.5f\nvar rise = 1.1f\nvar stiffness = 32000f\nvar stepPeriod = 0f\nvar slowMotion = 5\n\nfun start() = SlinkyOnStairs(run = run, rise = rise, stiffness = stiffness, stepPeriod = stepPeriod)\nvar scene = start()\n\ncontrolGroup(\"slinky\") {\n    slider(\"tread depth\", min = 1.2, max = 2.6, step = 0.05, initialValue = 1.5) {\n        run = it.toFloat()\n        scene = start()\n    }\n    slider(\"step rise\", min = 0.6, max = 3.0, step = 0.05, initialValue = 1.1) {\n        rise = it.toFloat()\n        scene = start()\n    }\n    slider(\"spring constant\", min = 8000.0, max = 48000.0, step = 1000.0, initialValue = 32000.0) {\n        stiffness = it.toFloat()\n        scene = start()\n    }\n    // The escalator: 0 is still stairs; about 0.09 matches the default walk.\n    slider(\"seconds per step\", min = 0.0, max = 0.3, step = 0.005, initialValue = 0.0) {\n        stepPeriod = it.toFloat()\n        scene = start()\n    }\n    slider(\"slow motion\", min = 1.0, max = 10.0, step = 1.0, initialValue = 5.0) { slowMotion = it.toInt() }\n    button(\"start again\") { down -> if (down) scene = start() }\n}\n\n// One frame of the picture every sixtieth of a second, each a slowMotion-th of a sixtieth of the walk.\nval clock = AnimationClock.nowSeconds()\nvar shown = 0.0\nloop {\n    val now = AnimationClock.nowSeconds() - clock\n    var catchUp = 0\n    while (shown < now && catchUp++ < 4) {\n        scene.step(1f / 60f / slowMotion)\n        shown += 1.0 / 60.0\n    }\n    shown = maxOf(shown, now - 0.1)\n\n    val c = scene.slinky.centroid()\n    val carried = scene.stairsTravelled - scene.stepsDescended\n    showPlane(\n        scene.lines(),\n        window = Rect(c.x - 5.0, c.y - 3.5, 10.0, 7.0),\n        width = 720,\n        height = 504,\n        title = \"a slinky walking down stairs · 1/$slowMotion speed\",\n        caption = \"t = ${scene.time.f2} s · ${scene.flips} flips · ${scene.stepsDescended.f1} steps down\" +\n            (if (scene.stepPeriod > 0f) \" · carried up ${carried.f1}\" else \"\"),\n    )\n}\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}