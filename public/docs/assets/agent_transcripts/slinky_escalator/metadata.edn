{"version" 2 "boxes" [{"id" "slinky_walk" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "slinky on an up escalator" "_tombstone" false "frame" #afield/rect [80.0 80.0 360.0 100.0] "code" #afield/file-inline {"path" "slinky_walk_code_.kt" "inline" "import afield.simulation.physics.*\n\n// The three things worth turning: the escalator's speed, as seconds per step; the step height;\n// and the spring constant between neighbouring coils. Lengths are in coil diameters.\nvar stepPeriod = 0.575f\nvar rise = 1.5f\nvar stiffness = 16000f\n\nfun start() = SlinkyOnStairs(stepPeriod = stepPeriod, rise = rise, stiffness = stiffness)\nvar scene = start()\n\ncontrolGroup(\"escalator\") {\n    slider(\"seconds per step\", min = 0.2, max = 1.5, step = 0.005, initialValue = 0.575) {\n        stepPeriod = it.toFloat()\n        scene.stepPeriod = stepPeriod\n    }\n    slider(\"step rise\", min = 0.8, max = 2.5, step = 0.05, initialValue = 1.5) {\n        rise = it.toFloat()\n        scene.stairs.rise = rise\n    }\n    slider(\"spring constant\", min = 4000.0, max = 30000.0, step = 500.0, initialValue = 16000.0) {\n        stiffness = it.toFloat()\n        scene.slinky.stiffness = stiffness\n    }\n    button(\"start again\") { down -> if (down) scene = start() }\n}\n\n// The loop can come round far more often than 60 times a second; the physics keeps to the clock.\nval clock = System.nanoTime()\nvar simulated = 0.0\nloop {\n    val now = (System.nanoTime() - clock) / 1e9\n    var catchUp = 0\n    while (simulated < now && catchUp++ < 4) {\n        scene.step()\n        simulated += 1.0 / 60.0\n    }\n    simulated = maxOf(simulated, now - 0.1)\n\n    // Follow the slinky, so a walk that keeps pace stays put and one that loses it drifts off.\n    val c = scene.slinky.centroid()\n    val behind = scene.stairsTravelled - scene.stepsDescended\n    showPlane(\n        scene.lines(),\n        window = Rect(c.x - 5.0, c.y - 4.0, 10.0, 7.0),\n        width = 720,\n        height = 504,\n        title = \"slinky on an up escalator · ${scene.stepPeriod.f3} s per step\",\n        caption =\n            \"t = ${scene.time.f1} s · walked ${scene.stepsDescended.f1} steps · \" +\n                \"escalator ${scene.stairsTravelled.f1} · behind by ${behind.f1}\",\n    )\n}\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "textRunAnchor" "textRunSources" "textFrameReview" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "watchdog" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole"]}