{"version" 2 "boxes" [{"id" "agent_graphics_context" "properties" {"children" #{#afield/box "triangle" #afield/box "browse_renderer"} "parents" #{#afield/box "root"} "name" "renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 300.0 100.0] "code" #afield/file-inline {"path" "agent_graphics_context_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\nOptions.profiling = false\n\nonce.renderer {\n    window = Window(\"Field\")\n    Renderer(window)\n}\n\nprintln(\"agent graphics renderer ready\")\nstart(renderer::run)\n"}}} {"id" "browse_renderer" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "agent_graphics_context"} "name" "browse the renderer" "_tombstone" false "frame" #afield/rect [380.0 40.0 820.0 100.0] "code" #afield/file-inline {"path" "browse_renderer_code_.kt" "inline" "/*\n`renderer` is the parent box's Renderer. column(...) opens it as Finder-style columns:\nrender (the main target, its passes in draw order), compute, windows, cpu (CPU span timings),\ndevice. Each node with children starts with a `summary` row: its card.\n*/\ncolumn(\"renderer\", renderer, width = 1100)\n\n// The same value as an indented tree.\ntree(\"renderer tree\", renderer)\n"}}} {"id" "triangle" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "agent_graphics_context"} "name" "triangle" "_tombstone" false "frame" #afield/rect [40.0 180.0 320.0 100.0] "vertex" #afield/file-inline {"path" "triangle_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\nvoid main()\n{\n    fcol = col;\n    gl_Position = vec4(pos, 1);\n}\n"} "fragment" #afield/file-inline {"path" "triangle_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\n\nlayout(location = 0) in vec4 fcol;\nvoid main()\n{\n    uFragColor = vec4(1.0, 0.8, 0.4, 1.0) * fcol;\n}\n"} "code" #afield/file-inline {"path" "triangle_code_.kt" "inline" "// A module is one draw pipeline: this box's `vertex` and `fragment` shaders plus the meshes it\n// draws. `renderer` is inherited from the renderer parent box, and `+=` puts the module on screen.\nrenderer += moduleHere {\n    primitiveType = triangle_strip\n\n    // A mesh holds vertex buffers whose names come from the vertex shader's `in` attributes\n    // (`pos`, `col`), plus the index buffer `tri`. Re-running the box replaces it by name.\n    +Mesh(\"my mesh\") {\n        // Room for 3 vertices and 3 indices; inside, `pos`, `col` and `tri` append data.\n        set(3, 3) {\n            // x, y, z for each of the three corners, in clip space (-1..1)\n            pos.add(0, 0, 0, 0.5, 0, 0, 0.5, 0.5, 0)\n\n            // one RGBA colour per vertex, `it` running 0, 1, 2\n            3 {\n                col.add(0, it / 3.0, 1 - it / 3.0, 1)\n            }\n            tri.add(0, 1, 2)\n        }\n    }\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4