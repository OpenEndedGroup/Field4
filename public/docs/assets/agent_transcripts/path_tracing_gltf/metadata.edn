{"version" 2 "boxes" [{"id" "path_trace_renderer" "properties" {"children" #{#afield/box "path_trace_gltf"} "parents" #{#afield/box "root"} "name" "path tracing renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 320.0 110.0] "code" #afield/file-inline {"path" "path_trace_renderer_code_.kt" "inline" "import afield.four.util.Options\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nonce.renderer {\n    window = Window(\"Field · Path tracing\")\n    Renderer(window)\n}\nstart(renderer::run)\n"}}} {"id" "path_trace_gltf" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "path_trace_renderer"} "name" "textured glTF path tracing" "_tombstone" false "frame" #afield/rect [320.0 180.0 350.0 120.0] "code" #afield/file-inline {"path" "path_trace_gltf_code_.kt" "inline" "import afield.four.fabricated.*\nimport afield.four.util.Camera\nimport afield.stdlib.linalg.Matrix4f\nimport afield.stdlib.linalg.Vector3f\nval scene = PathTraceScene()\nval model = scene.importGltf(\"public/docs/assets/fabricate_demo/ToyCar.glb\", Matrix4f().scale(20f))\nval center = Vector3f(model.boundsMin).add(model.boundsMax).mul(0.5f)\nval radius = model.boundsMin.distance(model.boundsMax)*0.5f\nval floor = scene.material(PathTraceMaterial.diffuse(0.35f,0.35f,0.35f))\nval y=model.boundsMin.y-radius*0.003f\nval d=radius*4f\nscene.quad(Vector3f(center.x-d,y,center.z-d),Vector3f(center.x-d,y,center.z+d),Vector3f(center.x+d,y,center.z+d),Vector3f(center.x+d,y,center.z-d),floor)\nval camera = Camera(renderer).also {\n it.target.set(center)\n it.at.set(center).add(radius*1.7f,radius*1.05f,radius*2f)\n it.p.fov=0.55\n}\nval tracer = PathTracingRenderer(renderer,scene,\n PathTraceEnvironment.fromFile(\"public/docs/assets/fabricate_demo/venice_sunset_1k.exr\"),\n width=1280,height=720,camera=camera).install()\ntracer.maxBounces=8\ntracer.samplesPerFrame=4\ntracer.rayEpsilon=(radius*0.00001f).coerceAtLeast(0.0000001f)\ntracer.showEnvironment=false\ntracer.indirectClamp=10f\ntracer.exposure=1.5f\ntracer.blitToScreen()\nframes {\n while(tracer.samples<1024) frame()\n println(\"glTF study converged: ${tracer.samples} samples; ${model.triangleCount} imported triangles\")\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}