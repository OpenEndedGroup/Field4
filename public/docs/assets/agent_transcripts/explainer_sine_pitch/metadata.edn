{"version" 2 "boxes" [{"id" "esp_sine" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "sine" "_tombstone" false "frame" #afield/rect [380.0 140.0 150.0 50.0] "code" #afield/file-inline {"path" "esp_sine_code_.kt" "inline" "// One sine wave, drawn and heard. How often it repeats is its pitch.\nval pitch = Param(220f)\nval loudness = Param(0f)\n\n// Twenty milliseconds of the wave, 640 pixels wide.\nfun draw(hz: Double) = lines(\n    fline {\n        moveTo(0.0, 120.0)\n        for (x in 1..640) lineTo(x.toDouble(), 120.0 - 90.0 * sin(2 * PI * hz * 0.02 * x / 640))\n        thickness = 2.0\n        color = vec(0.4, 0.9, 1.0, 1.0)\n    },\n    channel = \"wave\",\n    w = 640.0,\n    h = 240.0,\n)\n\ndraw(220.0)\ncontrolGroup {\n    slider(\"frequency\", 110.0, 880.0, step = 1.0, initialValue = 220.0, law = ControlLaw.LOGARITHMIC) {\n        pitch.base = it.toFloat()\n        draw(it)\n    }\n    checkbox(\"sound\") { loudness.base = if (it) 0.15f else 0f }\n}\n\naudio(SineOsc(pitch), gain = loudness)\n"}}} {"id" "esp_deck" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "deck" "_tombstone" false "frame" #afield/rect [60.0 140.0 150.0 50.0] "code" #afield/file-inline {"path" "esp_deck_code_.kt" "inline" "import kotlinx.html.*\n\n// Four slides: prose, a live figure and its slider, a cue that moves the slider, and\n// the same figure heard. \"sine\" is the box that draws and plays the wave.\npresentation(title = \"A sine wave and its pitch\") {\n        step(\"A sine wave and its pitch\", id = \"opening\") {\n            audience {\n                +\"\"\"\n                # A sine wave and its pitch\n\n                A sound is air pushed back and forth against your ear. The smoothest\n                push is a sine wave: one even swing, repeated.\n\n                How often the swing repeats is what you hear as pitch.\"\"\".md\n                p(classes = \"muted\") {\n                    +\"After “Sound” by Bartosz Ciechanowski, ciechanow.ski/sound. Words and figures made in Field.\"\n                }\n            }\n            markdownNote(\"The question: what makes one note higher than another? [[next]]\")\n        }\n        step(\"How often it repeats\", id = \"wave\") {\n            audience {\n                figureBeside(\"sine\") {\n                    +\"\"\"\n                    ## How often it repeats\n\n                    The line is twenty milliseconds of the wave. Drag **frequency**:\n                    as the number rises, more swings fit into the same time.\n\n                    Frequency counts swings per second, in hertz.\"\"\".md\n                }\n            }\n            control(\"sine\", \"frequency\", 220.0)\n            control(\"sine\", \"sound\", false)\n            markdownNote(\"Let someone drag the slider. [[back]] [[next]]\")\n        }\n        step(\"Twice as often\", id = \"octave\") {\n            audience {\n                figureBeside(\"sine\") {\n                    +\"\"\"\n                    ## Twice as often\n\n                    220 Hz is the A below middle C. Doubling the frequency fits\n                    twice as many swings in, and we hear the same note an octave up.\"\"\".md\n                }\n            }\n            control(\"sine\", \"frequency\", 220.0)\n            control(\"sine\", \"sound\", false)\n            cue(\"Up an octave\") { control(\"sine\", \"frequency\", 440.0, glideMs = 1500) }\n            markdownNote(\"Next glides the slider from 220 to 440 Hz. [[back]] [[next]]\")\n        }\n        step(\"Hear it\", id = \"listen\") {\n            audience {\n                figureBeside(\"sine\") {\n                    +\"\"\"\n                    ## Hear it\n\n                    Tick **sound**, then drag **frequency**. The wave you see is the\n                    tone you hear: one box draws it and plays it.\"\"\".md\n                }\n            }\n            cue(\"Sound on\") { control(\"sine\", \"sound\", true) }\n            markdownNote(\"Next turns the sound on; leaving the talk stops it. [[back]] [[finish]]\")\n        }\n    }\n    .present()\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "fileManagerAccessHistory" "kitRole"]}