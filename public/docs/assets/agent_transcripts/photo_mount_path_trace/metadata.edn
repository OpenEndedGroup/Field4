{"version" 2 "boxes" [{"id" "chain_renderer" "properties" {"children" #{#afield/box "photo_mount_trace"} "parents" #{#afield/box "root"} "name" "path tracing renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 220.0 60.0] "code" #afield/file-inline {"path" "chain_renderer_code_.kt" "inline" "import afield.four.util.Options\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nonce.renderer {\n    window = Window(\"Field · photo_mount_path_trace\")\n    Renderer(window)\n}\nstart(renderer::run)\n"}}} {"id" "photo_mount_trace" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "chain_renderer"} "name" "photo_mount_path_trace" "_tombstone" false "frame" #afield/rect [320.0 140.0 300.0 70.0] "code" #afield/file-inline {"path" "photo_mount_trace_code_.kt" "inline" "import afield.four.fabricated.*\nimport afield.four.util.Camera\nimport afield.manifold.*\nimport afield.stdlib.linalg.Vector3f\nimport afield.stdlib.polytope.*\nimport afield.examples.chain.PhotoToSolidChain\nimport java.io.File\nprop<PathTracingRenderer>(tracer)\nrequire(ManifoldLibrary.isAvailable) { ManifoldLibrary.describe() }\nval scene = PathTraceScene()\nval mounted = PhotoToSolidChain.mount()\nval relief = scene.material(PathTraceMaterial.plastic(0.67f, 0.42f, 0.19f, 0.4f))\nval frameMaterial = scene.material(PathTraceMaterial.plastic(0.18f, 0.22f, 0.27f, 0.28f))\nscene.importTriMesh(mounted.relief, relief)\nscene.importTriMesh(mounted.frame, frameMaterial)\nprintln(mounted.summary())\nval floor = scene.material(PathTraceMaterial.plastic(0.55f, 0.56f, 0.58f, 0.55f))\nscene.quad(Vector3f(-6f, -0.16f, -6f), Vector3f(6f, -0.16f, -6f), Vector3f(6f, -0.16f, 6f), Vector3f(-6f, -0.16f, 6f), floor)\nval environment = PathTraceEnvironment.fromFile(File(\"public/docs/assets/fabricate_demo/venice_sunset_1k.exr\").absolutePath)\nval camera = Camera(renderer).also {\n    it.at.set(2.2f, 2.25f, 2.6f)\n    it.target.set(0f, 0.1f, 0f)\n    it.p.fov = 0.52\n}\ntracer = PathTracingRenderer(renderer, scene, environment, 1000, 614, camera).install()\ntracer.samplesPerFrame = 4\ntracer.maxBounces = 8\ntracer.exposure = 1.35f\ntracer.environmentRotation = 2.1f\ntracer.indirectClamp = 10f\ntracer.blitToScreen()\nprintln(\"${tracer.backend}: ${tracer.triangleCount} triangles\")\nframes {\n    while (tracer.samples < 900) { frame() }\n    println(\"photo_mount_trace study converged: ${tracer.samples} samples\")\n}\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "ai4_session" "fileManagerAccessHistory"]}