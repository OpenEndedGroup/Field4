#rectsl
wall 16 8 meters
duration 8
fps 30

material tint '(
  uv 4.0 * sin abs
)

"orbit" group
  "cell" rect
    0 0 xy
    1.5 square
    "petal" tag
    '( 0 0  4 3.14159  8 6.28318 ) rot
    0xffffff solid fill
    tint material
  ;
  0 7 '(
    "cell" select
      clone
      i 2.2 * 6.6 - 0 xy
      tint material
  ) range
end-group
