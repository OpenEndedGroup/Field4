#rectsl
wall 22 8 meters
duration 3
fps 30

"bar" rect
  0 -3 xy
  0.42 1 wh
  0xffd23c solid fill
  33 '(
    ic 0.62 * 0 offset
    '( 0 0.12  0.5 1  1 0.12 ) 1 loop-time  gaussian f sample 6.5 * value*  h
    7 noise f sample 0.45 *  0 translate
    gaussian f sample 0.25 +  sat  alpha
  ) array
  0.05 stagger-time
;
