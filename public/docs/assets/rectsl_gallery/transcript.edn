{"version" 1 "entries" [{"timestamp" "2026-07-11T20:48:32.252Z" "timestampMillis" 1783802912252 "event" "launch" "entrypoint" "launch-all" "document" "/Users/marc/field4/public/docs/assets/rectsl_gallery" "fieldLaunchId" "2026-07-11T20:48:20.348Z#66069" "fieldLaunchStartedAt" 1783802900348 "box" {"id" "spectrum-bars" "name" "spectrum-bars" "frame" {"x" 0.0 "y" 270.0 "w" 260.0 "h" 150.0}} "language" "Kotlin" "type" "launch" "line" 0 "strand" "default" "singleLine" false "code" "// RectSL example: spectrum-bars\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 20 8 meters\nduration 6\nfps 30\n\nmaterial spectrum '(\n  uv 3.0 * time 0.5 * + fbm palette\n)\n\n\"bar\" rect\n  0 0 xy\n  0.9 1 wh\n  '( 0 0.6  0.75 6.5  1.5 0.6 ) 1.5 loop-time h\n  0xffffff solid fill\n  spectrum material\n;\n\n16 '(\n  \"bar\" select clone\n    i 7.5 - 1.2 * 0 xy\n    i 0.14 * delay-all-time\n) repeat\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n" "properties" {"code" "// RectSL example: spectrum-bars\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 20 8 meters\nduration 6\nfps 30\n\nmaterial spectrum '(\n  uv 3.0 * time 0.5 * + fbm palette\n)\n\n\"bar\" rect\n  0 0 xy\n  0.9 1 wh\n  '( 0 0.6  0.75 6.5  1.5 0.6 ) 1.5 loop-time h\n  0xffffff solid fill\n  spectrum material\n;\n\n16 '(\n  \"bar\" select clone\n    i 7.5 - 1.2 * 0 xy\n    i 0.14 * delay-all-time\n) repeat\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "index" 0} {"timestamp" "2026-07-11T20:48:32.288Z" "timestampMillis" 1783802912288 "event" "property-change" "entrypoint" "setPropertyRaw" "d