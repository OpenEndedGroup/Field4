 "name" "spectrum-bars" "frame" #afield/rect [0.0 270.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "spectrum-bars_code_.kt" "inline" "// RectSL example: spectrum-bars\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 20 8 meters\nduration 6\nfps 30\n\nmaterial spectrum '(\n  uv 3.0 * time 0.5 * + fbm palette\n)\n\n\"bar\" rect\n  0 0 xy\n  0.9 1 wh\n  '( 0 0.6  0.75 6.5  1.5 0.6 ) 1.5 loop-time h\n  0xffffff solid fill\n  spectrum material\n;\n\n16 '(\n  \"bar\" select clone\n    i 7.5 - 1.2 * 0 xy\n    i 0.14 * delay-all-time\n) repeat\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "spectrum-bars_rectsl_.rectsl" "inline" "#rectsl\nwall 20 8 meters\nduration 6\nfps 30\n\nmaterial spectrum '(\n  uv 3.0 * time 0.5 * + fbm palette\n)\n\n\"bar\" rect\n  0 0 xy\n  0.9 1 wh\n  '( 0 0.6  0.75 6.5  1.5 0.6 ) 1.5 loop-time h\n  0xffffff solid fill\n  spectrum material\n;\n\n16 '(\n  \"bar\" select clone\n    i 7.5 - 1.2 * 0 xy\n    i 0.14 * delay-all-time\n) repeat\n"}}} {"id" "phase-fan" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "phase-fan" "frame" #afield/rect [-300.0 460.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "phase-fan_code_.kt" "inline" "// RectSL example: phase-fan\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\n\"blade\" rect\n  0 0 xy\n  0.35 4.5 wh\n  '( 0 -1.0  1 1.0  2 -1.0 ) 2 loop-time rot\n  0xff3caa solid fill\n;\n\n24 '(\n  \"blade\" select clone\n    i 11.5 - 0.72 * 0 xy\n    i 0.11 * delay-all-time\n) repeat\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "phase-fan_rectsl_.rectsl" "inline" "#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\n\"blade\" rect\n  0 0 xy\n  0.35 4.5 wh\n  '( 0 -1.0  1 1.0  2 -1.0 ) 2 loop-time rot\n  0xff3caa solid fill\n;\n\n24 '(\n  \"blade\" select clone\n    i 11.5 - 0.72 * 0 xy\n    i 0.11 * delay-all-time\n) repeat\n"}}} {"id" "wave-lattice" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "wave-lattice" "frame" #afield/rect [0.0 460.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "wave-lattice_code_.kt" "inline" "// RectSL example: wave-lattice\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 18 9 meters\nduration 8\nfps 30\n\n\"tile\" rect\n  0 0 xy\n  1.0 square\n  '( 0 0.15  1 1.15  2 0.15 ) 2 loop-time scale\n  '( 0 0  2 6.28318 ) 2 loop-time rot\n  0x66ffcc solid fill\n;\n\n60 '(\n  \"tile\" select clone\n    i 10 mod 4.5 - 1.7 *\n    i 10 / floor 2.5 - 1.7 *\n    xy\n    i 10 mod i 10 / floor + 0.14 * delay-all-time\n) repeat\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "wave-lattice_rectsl_.rectsl" "inline" "#rectsl\nwall 18 9 meters\nduration 8\nfps 30\n\n\"tile\" rect\n  0 0 xy\n  1.0 square\n  '( 0 0.15  1 1.15  2 0.15 ) 2 loop-time scale\n  '( 0 0  2 6.28318 ) 2 loop-time rot\n  0x66ffcc solid fill\n;\n\n60 '(\n  \"tile\" select clone\n    i 10 mod 4.5 - 1.7 *\n    i 10 / floor 2.5 - 1.7 *\n    xy\n    i 10 mod i 10 / floor + 0.14 * delay-all-time\n) repeat\n"}}}]}