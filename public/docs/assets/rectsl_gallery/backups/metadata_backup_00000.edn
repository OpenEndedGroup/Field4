{"version" 2 "boxes" [{"id" "mirrored-orbit" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "mirrored-orbit" "frame" #afield/rect [-300.0 -300.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "mirrored-orbit_code_.kt" "inline" "// RectSL example: mirrored-orbit\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 16 9 meters\nduration 6\nfps 30\n\n\"left\" rect\n  -4 0 xy\n  2.2 square\n  0xff5a3c solid fill\n  '( 0 -4  3 0  6 4 ) x\n  '( 0 -2  1.5 2  3 -2  4.5 2  6 -2 ) y\n  '( 0 0  6 6.28318 ) rot\n;\n\ndup \"right\" rename\n  mirror-x\n  0x3c8cff solid fill\n;\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "mirrored-orbit_rectsl_.rectsl" "inline" "#rectsl\nwall 16 9 meters\nduration 6\nfps 30\n\n\"left\" rect\n  -4 0 xy\n  2.2 square\n  0xff5a3c solid fill\n  '( 0 -4  3 0  6 4 ) x\n  '( 0 -2  1.5 2  3 -2  4.5 2  6 -2 ) y\n  '( 0 0  6 6.28318 ) rot\n;\n\ndup \"right\" rename\n  mirror-x\n  0x3c8cff solid fill\n;\n"}}} {"id" "rising-bars" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "rising-bars" "frame" #afield/rect [0.0 -300.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "rising-bars_code_.kt" "inline" "// RectSL example: rising-bars\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\nlinear-track \"rise\" '( 0 -2.6   3 0   6 2.6 )\nhold-track \"pulse\" '( 0 0.2   2 1.0   4 0.45 )\n\n\"bar-template\" rect\n  0 -1.6 xy\n  0.9 2.2 wh\n  \"rise\" track-ref y\n  \"pulse\" track-ref smooth alpha\n  0xeeeeee solid fill\n;\n\n8 '(\n  \"bar-template\" select\n    clone\n    i layer\n    i 0.1 * z\n    i 3.5 - 2.0 * x\n) repeat\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "rising-bars_rectsl_.rectsl" "inline" "#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\nlinear-track \"rise\" '( 0 -2.6   3 0   6 2.6 )\nhold-track \"pulse\" '( 0 0.2   2 1.0   4 0.45 )\n\n\"bar-template\" rect\n  0 -1.6 xy\n  0.9 2.2 wh\n  \"rise\" track-ref y\n  \"pulse\" track-ref smooth alpha\n  0xeeeeee solid fill\n;\n\n8 '(\n  \"bar-template\" select\n    clone\n    i layer\n    i 0.1 * z\n    i 3.5 - 2.0 * x\n) repeat\n"}}} {"id" "orbit-petals" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "orbit-petals" "frame" #afield/rect [-300.0 -110.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "orbit-petals_code_.kt" "inline" "// RectSL example: orbit-petals\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 18 8 meters\nduration 8\nfps 30\n\nmaterial bands '(\n  uv 6.0 * sin abs\n)\n\n\"row\" group\n  \"petal\" rect\n    0 0 xy\n    1.7 square\n    '( 0 0   4 3.14159   8 6.28318 ) rot\n    0xffffff solid fill\n    bands material\n  ;\n\n  0 7 '(\n    \"petal\" select\n      clone\n      i 3 - 2.4 * 0 xy\n      bands material\n  ) range\nend-group\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "orbit-petals_rectsl_.rectsl" "inline" "#rectsl\nwall 18 8 meters\nduration 8\nfps 30\n\nmaterial bands '(\n  uv 6.0 * sin abs\n)\n\n\"row\" group\n  \"petal\" rect\n    0 0 xy\n    1.7 square\n    '( 0 0   4 3.14159   8 6.28318 ) rot\n    0xffffff solid fill\n    bands material\n  ;\n\n  0 7 '(\n    \"petal\" select\n      clone\n      i 3 - 2.4 * 0 xy\n      bands material\n  ) range\nend-group\n"}}} {"id" "gradient-sweep" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "gradient-sweep" "frame" #afield/rect [0.0 -110.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "gradient-sweep_code_.kt" "inline" "// RectSL example: gradient-sweep\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\n\"panel\" rect\n  0 0 xy\n  15 6 wh\n  0xff2d55 0x2d7bff  -7.5 -3  7.5 3  linear fill\n  '( 0 -0.3  3 0.3  6 -0.3 ) rot\n  '( 0 0.7