\"blade\" select\n    clone\n    i tau * 16 /\n    dup dup cos 7.0 * swap sin 3.0 * xy\n    rot\n    '( 0 0  6 6.28318 ) rotate\n) range\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "pinwheel_rectsl_.rectsl" "inline" "#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\n\"blade\" rect\n  0 0 xy\n  1.2 square\n  0xffd23c solid fill\n;\n\n0 16 '(\n  \"blade\" select\n    clone\n    i tau * 16 /\n    dup dup cos 7.0 * swap sin 3.0 * xy\n    rot\n    '( 0 0  6 6.28318 ) rotate\n) range\n"}}} {"id" "lissajous-swarm" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "lissajous-swarm" "frame" #afield/rect [0.0 80.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "lissajous-swarm_code_.kt" "inline" "// RectSL example: lissajous-swarm\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 18 9 meters\nduration 8\nfps 30\n\nmaterial glow '(\n  uv 5.0 * time 0.6 * + fbm palette\n)\n\n\"dot\" rect\n  0 0 xy\n  0.8 square\n  '( 0 -7  1 0  2 7  3 0  4 -7 ) 4 loop-time x\n  '( 0 -3.5  0.5 0  1 3.5  1.5 0  2 -3.5 ) 2 loop-time y\n  0xffffff solid fill\n  glow material\n;\n\n16 '(\n  \"dot\" select clone\n    i 0.25 * delay-all-time\n) repeat\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "lissajous-swarm_rectsl_.rectsl" "inline" "#rectsl\nwall 18 9 meters\nduration 8\nfps 30\n\nmaterial glow '(\n  uv 5.0 * time 0.6 * + fbm palette\n)\n\n\"dot\" rect\n  0 0 xy\n  0.8 square\n  '( 0 -7  1 0  2 7  3 0  4 -7 ) 4 loop-time x\n  '( 0 -3.5  0.5 0  1 3.5  1.5 0  2 -3.5 ) 2 loop-time y\n  0xffffff solid fill\n  glow material\n;\n\n16 '(\n  \"dot\" select clone\n    i 0.25 * delay-all-time\n) repeat\n"}}} {"id" "strobe-columns" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "strobe-columns" "frame" #afield/rect [-300.0 270.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "strobe-columns_code_.kt" "inline" "// RectSL example: strobe-columns\n//\n// The `#rectsl` program below is compiled to a sce