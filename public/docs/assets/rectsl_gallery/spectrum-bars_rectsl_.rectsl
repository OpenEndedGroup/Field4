#rectsl
wall 20 8 meters
duration 6
fps 30

material spectrum '(
  uv 3.0 * time 0.5 * + fbm palette
)

"bar" rect
  0 0 xy
  0.9 1 wh
  '( 0 0.6  0.75 6.5  1.5 0.6 ) 1.5 loop-time h
  0xffffff solid fill
  spectrum material
;

16 '(
  "bar" select clone
    i 7.5 - 1.2 * 0 xy
    i 0.14 * delay-all-time
) repeat
