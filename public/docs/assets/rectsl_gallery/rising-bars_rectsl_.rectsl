#rectsl
wall 18 8 meters
duration 6
fps 30

linear-track "rise" '( 0 -2.6   3 0   6 2.6 )
hold-track "pulse" '( 0 0.2   2 1.0   4 0.45 )

"bar-template" rect
  0 -1.6 xy
  0.9 2.2 wh
  "rise" track-ref y
  "pulse" track-ref smooth alpha
  0xeeeeee solid fill
;

8 '(
  "bar-template" select
    clone
    i layer
    i 0.1 * z
    i 3.5 - 2.0 * x
) repeat
