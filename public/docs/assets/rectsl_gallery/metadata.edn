.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "inline-functions_rectsl_.rectsl" "inline" "#rectsl\nwall 22 8 meters\nduration 3\nfps 30\n\n\"bar\" rect\n  0 0 xy\n  0.42 1 wh\n  0x38e1b0 solid fill\n  32 '(\n    ic 0.66 * 0 offset\n    '( 0 0.15  0.5 1.15  1 0.15 ) 1 loop-time\n    {{ (gaussian(0.5, 0.2) + fbm(9) * 0.4).eval(f) }}  5.5 *  0.25 +  value*\n    h\n  ) array\n  0.05 stagger-time\n;\n"}}} {"id" "easing-ladder" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "easing-ladder" "frame" #afield/rect [-300.0 900.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "easing-ladder_code_.kt" "inline" "// RectSL example: easing-ladder\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 12 8 meters\nduration 4\nfps 30\nfit contain\n\n\"linear\" rect\n  -4.5 0 xy  1.1 square  0xff5a3c solid fill\n  '( 0 -3  2 3  4 -3 ) 4 loop-time y ;\n\n\"ease-in\" rect\n  -1.5 0 xy  1.1 square  0xffd23c solid fill\n  '( 0 -3  2 3  4 -3 ) ease-in 4 loop-time y ;\n\n\"ease-out\" rect\n  1.5 0 xy  1.1 square  0x38e1b0 solid fill\n  '( 0 -3  2 3  4 -3 ) ease-out 4 loop-time y ;\n\n\"ease-inout\" rect\n  4.5 0 xy  1.1 square  0x3c8cff solid fill\n  '( 0 -3  2 3  4 -3 ) ease-in-out 4 loop-time y ;\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"}}} {"id" "time-canon" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "time-canon" "frame" #afield/rect [-300.0 1075.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "time-canon_code_.kt" "inline" "// RectSL example: time-canon\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 20 12 meters\nduration 6\nfps 30\n\n\"plain\" rect  -8 5 xy  1 square  0xff5a3c solid fill\n  '( 0 -8  3 0  6 8 ) x ;\n\"delayed\" rect  -8 3.4 xy  1 square  0xff8c3c solid fill\n  '( 0 -8  3 0  6 8 ) 1.5 delay-time x ;\n\"stretched\" rect  -8 1.8 xy  1 square  0xffd23c solid fill\n  '( 0 -8  3 0  6 8 ) 0.5 scale-time x ;\n\"shifted\" rect  -8 0.2 xy  1 square  0xa6e22e solid fill\n  '( 0 -8  3 0  6 8 ) 1 time+ x ;\n\"faster\" rect  -8 -1.4 xy  1 square  0x38e1b0 solid fill\n  '( 0 -8  3 0  6 8 ) 1.4 time* x ;\n\"reversed\" rect  -8 -3 xy  1 square  0x3c8cff solid fill\n  '( 0 -8  3 0  6 8 ) reverse-time x ;\n\"pinged\" rect  -8 -4.6 xy  1 square  0xb45cff solid fill\n  '( 0 -8  1.5 8  3 -8 ) 3 pingpong-time x ;\n\"snapped\" rect  -8 -6 xy  1 square  0xff5ab4 solid fill\n  '( 0 -8  1.2 -2  2.4 4  3.6 8 ) 1 snap-time x ;\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"}}} {"id" "key-lenses" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "key-lenses" "frame" #afield/rect [-300.0 1250.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "key-lenses_code_.kt" "inline" "// RectSL example: key-lenses\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 16 10 meters\nduration 4\nfps 30\n\ntrack named-wobble '( 0 -1  1 1  2 -1  3 1  4 -1 )\n\n\"lx\" rect  -7 4 xy  1 square  0xff5a3c solid fill\n  '( 0 -2  4 2 ) x\n  x-track  3 value+  x ;\n\"ly\" rect  -5 4 xy  1 square  0xffd23c solid fill\n  '( 0 -4  2 4  4 -4 ) y\n  y-track  -2 2 clamp-values  y ;\n\"lw\" rect  -3 4 xy  2 1 wh  0x38e1b0 solid fill\n  '( 0 0.5  2 3  4 0.5 ) w\n  w-track  2 keys-before  w ;\n\"lh\" rect  -1 4 xy  1 2 wh  0x3c8cff solid fill\n  '( 0 0.5  2 3  4 0.5 ) h\n  h-track  2 keys-after  h ;\n\"lr\" rect  1 4 xy  1.4 square  0xb45cff solid fill\n  '( 0 0  2 3.14159  4 6.28318 ) rot\n  rot-track  1 3 keys-between  rot ;\n\"ls\" rect  3 4 xy  1.2 square  0xff5ab4 solid fill\n  '( 0 0.6  2 1.6  4 0.6 )  '( 0 1.4  2 0.6  4 1.4 ) scale-xy\n  scale-x-track  1.1 value*  scale-y-track  scale-xy ;\n\"la\" rect  5 4 xy  1.4 square  0xffffff solid fill\n  '( 0 0.15  2 1  4 0.15 ) alpha\n  alpha-track  0.2 value+  0 1 clamp-values  alpha ;\n\"lz\" rect  0 -1 xy  3 square  0x224466 solid fill\n  '( 0 0  4 2 ) z\n  z-track  1 value+  z\n  layer-track  0 4 keys-between  layer ;\n\"modes-tcb\" rect  -6 -4 xy  0.9 square  0xff5a3c solid fill\n  \"named-wobble\" track-ref  1.5 value*  y\n  '( 0 0.6  2 1.6  4 0.6 ) tcb  -0.4 0 0 tcb!  scale ;\n\"modes-hold\" rect  -4 -4 xy  0.9 square  0xffd23c solid fill\n  '( 0 -3  1 -1  2 -3  3 1  4 3 ) hold y ;\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"}}} {"id" "selection-logic" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "selection-logic" "frame" #afield/rect [-300.0 1425.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "selection-logic_code_.kt" "inline" "// RectSL example: selection-logic\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 20 10 meters\nduration 4\nfps 30\n\n\"strip\" group\n  8 '(\n    \"cell\" rect\n      i 3.5 - 2.2 *  0  xy\n      1.3 square\n      \"cell\" tag\n      0x2e5a86 solid fill\n      i 2 >=  i 6 <=  and  not   0.55 *  0.45 +   alpha\n      i 3 <  i 4 >  or   i 5 != and   0.25 *  0.85 +   scale\n      '( 0 -0.2  2 0.2  4 -0.2 ) 4 loop-time rot\n  ) times\nend\n\n\"decor\" group\n  \"dot-a\" rect  -8 3.5 xy  0.6 square  0xffd23c solid fill  \"spark\" tag ;\n  \"dot-b\" rect   8 3.5 xy  0.6 square  0xffd23c solid fill  \"spark\" tag ;\nend\n\nall rects  '( 0.85 opacity* ) each ;\nall  '( \"spark\" tagged? ) filter  '( 1.4 scale ) map ;\nall  '( rect? ) filter  '( ) each ;\nall  '( group? ) filter  '( ) each ;\nall groups  '( ) each ;\nall  \"spark\" tagged  '( ) map ;\nall rects  '( id \"cell\" = ) filter  '( 0xff5a3c solid fill ) each ;\nall rects  '( id \"cell\" != ) filter  '( ) each ;\nroots  '( ) each ;\n\"strip\" select selected  '( ) each ;\n\"strip\" select children  '( 0.95 opacity* ) each ;\n\"strip\" select descendants rects  '( ) each ;\n\"strip\" select copy-deep \"strip2\" rename ;\n\"strip2\" select  0 -4 translate ;\nall rects  '( \"spark\" tagged? ) filter  \"sparks\" group-selected ;\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"}}} {"id" "all-time" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "all-time" "frame" #afield/rect [-300.0 1600.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "all-time_code_.kt" "inline" "// RectSL example: all-time\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 20 10 meters\nduration 6\nfps 30\n\n\"loopy\" rect  -6 2.5 xy  1.6 square  0xff5a3c solid fill\n  '( 0 0  3 6.28318 ) rot  '( 0 0.6  1.5 1.5  3 0.6 ) scale\n  2 loop-all-time ;\n\"pongy\" rect  -2 2.5 xy  1.6 square  0xffd23c solid fill\n  '( 0 0  3 6.28318 ) rot  '( 0 0.6  1.5 1.5  3 0.6 ) scale\n  2 pingpong-all-time ;\n\"revvy\" rect  2 2.5 xy  1.6 square  0x38e1b0 solid fill\n  '( 0 -6  6 6 ) x  '( 0 0  6 6.28318 ) rot\n  reverse-all-time ;\n\"slowy\" rect  6 2.5 xy  1.6 square  0x3c8cff solid fill\n  '( 0 0  3 6.28318 ) rot  '( 0 0.6  1.5 1.5  3 0.6 ) scale\n  0.5 scale-all-time ;\n\n\"fan\" rect  0 -3 xy  0.7 square  0xffffff solid fill\n  '( 0 0  6 6.28318 ) rot\n  9 '( fc abs 0.7 *  0.3 +  alpha ) array\n  1.7 0 stagger ;\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"}}} {"id" "kaleidoscope" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "kaleidoscope" "frame" #afield/rect [-300.0 1775.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "kaleidoscope_code_.kt" "inline" "// RectSL example: kaleidoscope\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 14 14 abstract\nbackground 0x101018\nduration 6\nfps 30\n\n\"seed\" rect\n  -3.5 -3.5 xy  2.4 square  0xff5a3c solid fill\n  '( 0 0  6 6.28318 ) rot\n  '( 0 -4.5  3 -2.5  6 -4.5 ) x ;\n\n\"seed\" select clone \"mx\" rename\n  3.5 mirror-x-at  0x38e1b0 solid fill  front ;\n\"seed\" select clone \"my\" rename\n  0 mirror-y-at  0xffd23c solid fill  back ;\n\"seed\" select clone \"myy\" rename\n  mirror-y  0x3c8cff solid fill ;\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"}}} {"id" "grid-field" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "grid-field" "frame" #afield/rect [-300.0 1950.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "grid-field_code_.kt" "inline" "// RectSL example: grid-field\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 1600 900 pixels\nfit cover\nduration 4\nfps 30\n\n12 7 '(\n  \"c\" rect\n    colc 110 *  rowc 110 *  xy\n    76 square\n    colc dup *  rowc dup *  +  sqrt\n    dup  0 5 smoothstep  neg 1 +  0.05 max  0 1 clamp  0.9 *  0.1 +  alpha\n    5 min  neg 5 +  5 /  0.4 pow  40 *  40 +  w\n    col cols 1 - /  row rows 1 - /  over  +  0.5 *  swap drop\n    4 *  ceil  4 /  pi *  rot\n  ) grid\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"}}} {"id" "curve-transforms" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "curve-transforms" "frame" #afield/rect [-300.0 2125.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "curve-transforms_code_.kt" "inline" "// RectSL example: curve-transforms\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 22 8 meters\nduration 3\nfps 30\n\n\"bar\" rect  0 -3 xy  0.5 1 wh  0x38e1b0 solid fill\n  24 '(\n    ic 0.85 * 0 offset\n    '( 0 0.15  1.5 1.1  3 0.15 ) 3 loop-time\n    gaussian 3 tile  f sample  5.5 *  value*\n    h\n    7 noise reflect  f sample  0.3 *  0 translate\n  ) array\n;\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"}}} {"id" "paint-kit" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "paint-kit" "frame" #afield/rect [-300.0 2300.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "paint-kit_code_.kt" "inline" "// RectSL example: paint-kit\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 12 8 meters\nbackground 0x0a0a12\nfit stretch\nduration 4\nfps 30\n\nmaterial chip '(\n  uv 3.0 * time 0.6 * + fbm palette\n)\n\n\"panel\" rect\n  0.5 0.5 nxy\n  0.9 0.5 nwh\n  rgb 0.12 0.34 0.62 solid fill\n  '( 0 -0.2  2 0.2  4 -0.2 ) rot ;\n\n6 '(\n  \"chip\" rect\n    i loop-count 1 - /  fract  4.5 *  2.25 -  -2.2 xy\n    0.7 square\n    rgba 0.9 0.4 0.2 0.85 solid fill\n    i 0.15 *  0.2  0.5  0  shader\n    chip material\n    '( 0.9 opacity* ) apply\n    '( ) defer drop\n) times\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"}}} {"id" "auto-orient" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "auto-orient" "frame" #afield/rect [0.0 1350.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "auto-orient_code_.kt" "inline" "// RectSL example: auto-orient\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 12 12 abstract\nduration 6\nfps 30\n\n\"dart\" rect\n  1.1 0.26 wh\n  0xffcc33 solid fill\n  '( 0=-5  3=0  6=5 ) x\n  '( 0=-4  1.5=3  3=-3  4.5=3  6=-4 ) y\n  face-travel\n;\n\n\"pip\" rect\n  0.7 0.24 wh\n  0x66ccff solid fill\n  16 '(\n    '( 0=0.6  3=5.4  6=0.6 )  f 6.28318 * cos  value*  x\n    '( 0=0.6  3=5.4  6=0.6 )  f 6.28318 * sin  value*  y\n    1.5708 face-travel-at\n    0.3 1 f mix alpha\n  ) array\n;\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"}}} {"id" "emitter-stream" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "emitter-stream" "frame" #afield/rect [300.0 1350.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "emitter-stream_code_.kt" "inline" "// RectSL example: emitter-stream\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 16 9 abstract\nduration 6\nfps 30\n\n\"beacon\" rect\n  0 3 xy\n  0.6 square\n  0xff2266 solid fill\n  1 appear\n  4 vanish\n;\n\n\"bullet\" rect\n  0.42 square\n  0xffcc33 solid fill\n  '( 0=-8  2.5=8 ) x\n  24 '(\n    -3 f 6 * + y\n    i 0.18 *  2.5  live\n  ) array\n;\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"}}} {"id" "shell-split" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "shell-split" "frame" #afield/rect [600.0 1350.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "shell-split_code_.kt" "inline" "// RectSL example: shell-split\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimpor