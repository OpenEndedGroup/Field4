{"version" 2 "boxes" [{"id" "renderer" "properties" {"children" #{#afield/box "mirrored-orbit" #afield/box "rising-bars" #afield/box "orbit-petals" #afield/box "gradient-sweep" #afield/box "pinwheel" #afield/box "lissajous-swarm" #afield/box "strobe-columns" #afield/box "spectrum-bars" #afield/box "phase-fan" #afield/box "wave-lattice" #afield/box "two-mirrored" #afield/box "named-tracks" #afield/box "groups-material" #afield/box "radial-bloom" #afield/box "grid-ripple" #afield/box "stagger-cascade" #afield/box "spiral-shards" #afield/box "gaussian-comb" #afield/box "eased-orbit" #afield/box "inline-functions" #afield/box "easing-ladder" #afield/box "time-canon" #afield/box "key-lenses" #afield/box "selection-logic" #afield/box "all-time" #afield/box "kaleidoscope" #afield/box "grid-field" #afield/box "curve-transforms" #afield/box "paint-kit" #afield/box "auto-orient" #afield/box "emitter-stream" #afield/box "shell-split" #afield/box "array-mandala"} "parents" #{#afield/box "root"} "name" "window + renderer" "frame" #afield/rect [-640.0 -360.0 240.0 90.0] "preamble" "" "code" #afield/file-inline {"path" "renderer_code_.kt" "inline" "import afield.four.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = true\n\nonce.renderer {\n    window = Window(\"Field \\u2014 RectSL gallery\")\n    Renderer(window)\n}\n\nstart(renderer::run)\n"}}} {"id" "mirrored-orbit" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "mirrored-orbit" "frame" #afield/rect [-300.0 -220.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "mirrored-orbit_code_.kt" "inline" "// RectSL example: mirrored-orbit\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 16 9 meters\nduration 6\nfps 30\n\n\"left\" rect\n  -4 0 xy\n  2.2 square\n  0xff5a3c solid fill\n  '( 0 -4  3 0  6 4 ) x\n  '( 0 -2  1.5 2  3 -2  4.5 2  6 -2 ) y\n  '( 0 0  6 6.28318 ) rot\n;\n\ndup \"right\" rename\n  mirror-x\n  0x3c8cff solid fill\n;\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "mirrored-orbit_rectsl_.rectsl" "inline" "#rectsl\nwall 16 9 meters\nduration 6\nfps 30\n\n\"left\" rect\n  -4 0 xy\n  2.2 square\n  0xff5a3c solid fill\n  '( 0 -4  3 0  6 4 ) x\n  '( 0 -2  1.5 2  3 -2  4.5 2  6 -2 ) y\n  '( 0 0  6 6.28318 ) rot\n;\n\ndup \"right\" rename\n  mirror-x\n  0x3c8cff solid fill\n;\n"}}} {"id" "rising-bars" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "rising-bars" "frame" #afield/rect [0.0 -220.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "rising-bars_code_.kt" "inline" "// RectSL example: rising-bars\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\nlinear-track \"rise\" '( 0 -2.6   3 0   6 2.6 )\nhold-track \"pulse\" '( 0 0.2   2 1.0   4 0.45 )\n\n\"bar-template\" rect\n  0 -1.6 xy\n  0.9 2.2 wh\n  \"rise\" track-ref y\n  \"pulse\" track-ref smooth alpha\n  0xeeeeee solid fill\n;\n\n8 '(\n  \"bar-template\" select\n    clone\n    i layer\n    i 0.1 * z\n    i 3.5 - 2.0 * x\n) repeat\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "rising-bars_rectsl_.rectsl" "inline" "#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\nlinear-track \"rise\" '( 0 -2.6   3 0   6 2.6 )\nhold-track \"pulse\" '( 0 0.2   2 1.0   4 0.45 )\n\n\"bar-template\" rect\n  0 -1.6 xy\n  0.9 2.2 wh\n  \"rise\" track-ref y\n  \"pulse\" track-ref smooth alpha\n  0xeeeeee solid fill\n;\n\n8 '(\n  \"bar-template\" select\n    clone\n    i layer\n    i 0.1 * z\n    i 3.5 - 2.0 * x\n) repeat\n"}}} {"id" "orbit-petals" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "orbit-petals" "frame" #afield/rect [-300.0 -30.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "orbit-petals_code_.kt" "inline" "// RectSL example: orbit-petals\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 18 8 meters\nduration 8\nfps 30\n\nmaterial bands '(\n  uv 6.0 * sin abs\n)\n\n\"row\" group\n  \"petal\" rect\n    0 0 xy\n    1.7 square\n    '( 0 0   4 3.14159   8 6.28318 ) rot\n    0xffffff solid fill\n    bands material\n  ;\n\n  0 7 '(\n    \"petal\" select\n      clone\n      i 3 - 2.4 * 0 xy\n      bands material\n  ) range\nend-group\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "orbit-petals_rectsl_.rectsl" "inline" "#rectsl\nwall 18 8 meters\nduration 8\nfps 30\n\nmaterial bands '(\n  uv 6.0 * sin abs\n)\n\n\"row\" group\n  \"petal\" rect\n    0 0 xy\n    1.7 square\n    '( 0 0   4 3.14159   8 6.28318 ) rot\n    0xffffff solid fill\n    bands material\n  ;\n\n  0 7 '(\n    \"petal\" select\n      clone\n      i 3 - 2.4 * 0 xy\n      bands material\n  ) range\nend-group\n"}}} {"id" "gradient-sweep" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "gradient-sweep" "frame" #afield/rect [0.0 -30.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "gradient-sweep_code_.kt" "inline" "// RectSL example: gradient-sweep\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\n\"panel\" rect\n  0 0 xy\n  15 6 wh\n  0xff2d55 0x2d7bff  -7.5 -3  7.5 3  linear fill\n  '( 0 -0.3  3 0.3  6 -0.3 ) rot\n  '( 0 0.7  3 1.0  6 0.7 ) scale\n;\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "gradient-sweep_rectsl_.rectsl" "inline" "#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\n\"panel\" rect\n  0 0 xy\n  15 6 wh\n  0xff2d55 0x2d7bff  -7.5 -3  7.5 3  linear fill\n  '( 0 -0.3  3 0.3  6 -0.3 ) rot\n  '( 0 0.7  3 1.0  6 0.7 ) scale\n;\n"}}} {"id" "pinwheel" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "pinwheel" "frame" #afield/rect [-300.0 160.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "pinwheel_code_.kt" "inline" "// RectSL example: pinwheel\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\n\"blade\" rect\n  0 0 xy\n  1.2 square\n  0xffd23c solid fill\n;\n\n0 16 '(\n  \"blade\" select\n    clone\n    i tau * 16 /\n    dup dup cos 7.0 * swap sin 3.0 * xy\n    rot\n    '( 0 0  6 6.28318 ) rotate\n) range\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "pinwheel_rectsl_.rectsl" "inline" "#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\n\"blade\" rect\n  0 0 xy\n  1.2 square\n  0xffd23c solid fill\n;\n\n0 16 '(\n  \"blade\" select\n    clone\n    i tau * 16 /\n    dup dup cos 7.0 * swap sin 3.0 * xy\n    rot\n    '( 0 0  6 6.28318 ) rotate\n) range\n"}}} {"id" "lissajous-swarm" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "lissajous-swarm" "frame" #afield/rect [0.0 160.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "lissajous-swarm_code_.kt" "inline" "// RectSL example: lissajous-swarm\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 18 9 meters\nduration 8\nfps 30\n\nmaterial glow '(\n  uv 5.0 * time 0.6 * + fbm palette\n)\n\n\"dot\" rect\n  0 0 xy\n  0.8 square\n  '( 0 -7  1 0  2 7  3 0  4 -7 ) 4 loop-time x\n  '( 0 -3.5  0.5 0  1 3.5  1.5 0  2 -3.5 ) 2 loop-time y\n  0xffffff solid fill\n  glow material\n;\n\n16 '(\n  \"dot\" select clone\n    i 0.25 * delay-all-time\n) repeat\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "lissajous-swarm_rectsl_.rectsl" "inline" "#rectsl\nwall 18 9 meters\nduration 8\nfps 30\n\nmaterial glow '(\n  uv 5.0 * time 0.6 * + fbm palette\n)\n\n\"dot\" rect\n  0 0 xy\n  0.8 square\n  '( 0 -7  1 0  2 7  3 0  4 -7 ) 4 loop-time x\n  '( 0 -3.5  0.5 0  1 3.5  1.5 0  2 -3.5 ) 2 loop-time y\n  0xffffff solid fill\n  glow material\n;\n\n16 '(\n  \"dot\" select clone\n    i 0.25 * delay-all-time\n) repeat\n"}}} {"id" "strobe-columns" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "strobe-columns" "frame" #afield/rect [-300.0 350.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "strobe-columns_code_.kt" "inline" "// RectSL example: strobe-columns\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport afield.rectsl.writeFrameToMesh\nimport afield.rectsl.RECT_ANIMATION_VERTEX_SHADER\n\nval rectsl = \"\"\"\n#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\n\"cell\" rect\n  0 0 xy\n  1.4 square\n  '( 0 1  1 0  2 1 ) 2 loop-time alpha\n  0x44e0ff solid fill\n;\n\n36 '(\n  \"cell\" select clone\n    i 9 mod 4 - 2.0 *\n    i 9 / floor 1.5 - 2.0 *\n    xy\n    i 9 mod 0.22 * delay-all-time\n) repeat\n\"\"\"\n\nval program = RectAnimationOracle.compile(rectsl).program!!\nval shader  = rectMaterialShaderCode(program)\n\nval module = moduleHere {\n    vertex = RECT_ANIMATION_VERTEX_SHADER\n    fragment = shader.exampleFragmentShader\n    blend = true\n    depthTest = false\n    primitiveType = triangles\n}\nval m = Mesh()\nmodule += \"scene\" to m\nrenderer += \"rectsl\" to module\n\nval ww = program.wall.width.toFloat()\nval wh = program.wall.height.toFloat()\nm.push[\"worldToClip\"] = afield.stdlib.linalg.Matrix4f().ortho(-ww / 2f, ww / 2f, -wh / 2f, wh / 2f, -1f, 1f)\nm.push[\"wallWidth\"] = ww\nm.push[\"wallHeight\"] = wh\n\nvar t = 0.0\nloop {\n    m.push[\"time\"] = t.toFloat()\n    program.writeFrameToMesh(t % program.duration, m)\n    t += 1.0 / 60.0\n    true\n}\n"} "rectsl" #afield/file-inline {"path" "strobe-columns_rectsl_.rectsl" "inline" "#rectsl\nwall 18 8 meters\nduration 6\nfps 30\n\n\"cell\" rect\n  0 0 xy\n  1.4 square\n  '( 0 1  1 0  2 1 ) 2 loop-time alpha\n  0x44e0ff solid fill\n;\n\n36 '(\n  \"cell\" select clone\n    i 9 mod 4 - 2.0 *\n    i 9 / floor 1.5 - 2.0 *\n    xy\n    i 9 mod 0.22 * delay-all-time\n) repeat\n"}}} {"id" "spectrum-bars" "properties" {"children" #{} "parents" #{#afield/box "renderer"} "name" "spectrum-bars" "frame" #afield/rect [0.0 350.0 260.0 150.0] "preamble" "" "code" #afield/file-inline {"path" "spectrum-bars_code_.kt" "inline" "// RectSL example: spectrum-bars\n//\n// The `#rectsl` program below is compiled to a scene; each frame is sampled,\n// lowered to a triangle mesh, and drawn through the shared rect vertex shader\n// plus a StackSL-compiled material fragment. Edit `rectsl` and re-run to change\n// it live. See the \"RectSL examples\" docs page for the language.\n\nimport afield.rectsl.RectAnimationOracle\nimport afield.rectsl.rectMaterialShaderCode\nimport af