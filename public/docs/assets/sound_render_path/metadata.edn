{"version" 2 "boxes" [{"id" "sound_path_fallback" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 · The per-event fallback" "_tombstone" false "frame" #afield/rect [60.0 540.0 420.0 130.0] "code" #afield/file-inline {"path" "sound_path_fallback_code_.kt" "inline" "// The second, finer fallback. `bd` and `hh` are in every Dirt install; `zzzznotadrum` is in\n// none, so THAT EVENT ALONE is voiced by the synth and mixed on top of the sampled ones.\n// A pattern must not go silent just because the library loaded successfully.\nval mixed = showDirtAudio(\n    pat(\"bd zzzznotadrum bd hh\") with gain(0.9),\n    cycles = 4, cps = 2.0,\n    voice = patVoice(wave = PatWave.SQUARE, baseHz = 330.0, decay = 0.05, sustain = 0.3),\n)\nprintln(mixed.describe())\nprintln(\"matched   = ${mixed.matched}\")\nprintln(\"unmatched = ${mixed.unmatched}\")   // <- the tokens that fell back, named\ndisplayOpen(\"main\")\n"} "nested" #{} "preamble" ""}} {"id" "sound_path_roll" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "0 · The schedule" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 130.0] "code" #afield/file-inline {"path" "sound_path_roll_code_.kt" "inline" "// Neither voice yet — just the events. Both renders below are handed exactly this list.\nshowPatRollOf(\n    \"bd ~ sd ~\" to pat(\"bd ~ sd ~\"),\n    \"hh*8\" to pat(\"hh*8\"),\n    title = \"pat(\\\"bd ~ sd ~, hh*8\\\")\",\n    subtitle = \"the schedule both voices are given\",\n    cycles = 2,\n)\ndisplayOpen(\"main\")\n"} "nested" #{} "preamble" ""}} {"id" "sound_path_stand_in" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 · The stand-in voice" "_tombstone" false "frame" #afield/rect [60.0 220.0 420.0 130.0] "code" #afield/file-inline {"path" "sound_path_stand_in_code_.kt" "inline" "// patVoice: one oscillator, one one-pole lowpass, one exponential-decay envelope, per\n// event. `bd` is a 62 Hz sine; `sd` and `hh` are filtered white noise. This is the default\n// everywhere in Field's docs, and it sounds like bursts of white noise because it is.\nval audio = showPatAudio(pat(\"bd ~ sd ~, hh*8\") with gain(0.9), cycles = 4, cps = 2.0)\nprintln(\"stand-in: %.2fs, peak %.3f\".format(audio.frames / 44100.0, PatSoundDocs.peak(audio.mono)))\ndisplayOpen(\"main\")\n"} "nested" #{} "preamble" ""}} {"id" "sound_path_dirt" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 · The real Dirt samples" "_tombstone" false "frame" #afield/rect [60.0 380.0 420.0 130.0] "code" #afield/file-inline {"path" "sound_path_dirt_code_.kt" "inline" "// The identical pattern, mixed from the genuine Tidal sample library — offline, with no\n// audio device. Play box 1 and box 2 back to back: that difference is the whole point.\n//\n// No library on this machine? You will hear box 1 again, and describe() will say so and\n// name the override rather than leaving you to guess from the sound.\nval played = showDirtAudio(pat(\"bd ~ sd ~, hh*8\") with gain(0.9), cycles = 4, cps = 2.0)\nprintln(played.describe())\nprintln(\"usedSamples = ${played.usedSamples}\")\ndisplayOpen(\"main\")\n"} "nested" #{} "preamble" ""}} {"id" "sound_path_where" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 · Where is the library?" "_tombstone" false "frame" #afield/rect [60.0 700.0 420.0 110.0] "code" #afield/file-inline {"path" "sound_path_where_code_.kt" "inline" "// The probe order, and what it found here. Dirt-Samples ships as a SuperCollider quark, so\n// anyone who has run Tidal already has it — hence auto-discovery rather than asking you.\n// ~400MB of third-party audio with mixed per-folder licensing, so it is NOT vendored.\nval root = DirtRender.dirtSampleRoot()\nprintln(if (root != null) \"found: $root\" else \"not found — set ${DirtRender.ENV_VAR} to a copy of Dirt-Samples\")\n"} "nested" #{} "preamble" ""}} {"id" "root" "properties" {"children" #{#afield/box "sound_path_roll" #afield/box "sound_path_stand_in" 