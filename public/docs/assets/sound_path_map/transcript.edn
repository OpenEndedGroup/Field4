{"version" 1 "entries" [{"timestamp" "2026-08-13T09:09:08.564Z" "timestampMillis" 1786612148564 "event" "execute" "entrypoint" "execute-all" "document" "/Users/marc/field4-worktrees/2026-08-13-3-sound-path-map/public/docs/assets/sound_path_map" "fieldLaunchId" "2026-08-13T09:09:07.553Z#37039" "fieldLaunchStartedAt" 1786612147553 "box" {"id" "sound_map_paths" "name" "1 · The map" "frame" {"x" 60.0 "y" 60.0 "w" 520.0 "h" 150.0}} "language" "Kotlin" "type" "code" "line" 0 "strand" "default" "singleLine" false "code" "// The map, printed from the code rather than from a page. Six ways to make samples, five ways\n// out, four ways in — and 7 of the 15 on the one seam that matters.\nSoundPathMap.Role.values().forEach { role ->\n    println(\"${role.label}:\")\n    SoundPathMap.PATHS.filter { it.role == role }.forEach { p ->\n        println(\"  %-20s %-19s %s  needs: %s\".format(\n            p.id, p.timing.label, if (p.onSeam) \"[on the seam]\" else \"[off the seam]\", p.needs))\n        println(\"      ${p.what}\")\n        println(\"      ${p.file} — ${p.entryPoint}${if (p.page == null) \"   (NO PAGE DOCUMENTS THIS)\" else \"\"}\")\n    }\n}\nprintln()\nprintln(\"${SoundPathMap.PATHS.count { it.onSeam }} of ${SoundPathMap.PATHS.size} paths meet AudioPatchSpec.Renderer.render(outL, outR, numFrames, ctx)\")\nprintln(\"no published page mentions: ${SoundPathMap.PATHS.filter { it.page == null }.map { it.id }}\")\n" "index" 0} {"timestamp" "2026-08-13T09:09:10.527Z" "timestampMillis" 1786612150527 "event" "execute" "entrypoint" "execute-all" "document" "/Users/marc/field4-worktrees/2026-08-13-3-sound-path-map/public/docs/assets/sound_path_map" "fieldLaunchId" "2026-08-13T09:09:07.553Z#37039" "fieldLaunchStartedAt" 1786612147553 "box" {"id" "sound_map_compare" "name" "2 · One buffer, three paths" "frame" {"x" 60.0 "y" 240.0 "w" 520.0 "h" 150.0}} "language" "Kotlin" "type" "code" "line" 0 "strand" "default" "singleLine" false "code" "// One buffer, three paths. The dry beat is rendered once by patVoice and then lowpassed at\n// 900 Hz twice — by the Signal graph's own ChamberlinLowpass, and by a Faust program compiled\n// at runtime. Three players, a brightness plot, and the seam claim as a number.\n//\n// The first run pays 13-22s of Truffle warm-up for the Faust compile. The second does not.\nshowSoundPathComparison()\ndisplayOpen(\"path0\")\n" "index" 1}]}