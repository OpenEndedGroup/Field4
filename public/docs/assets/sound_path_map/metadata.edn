{"version" 2 "boxes" [{"id" "sound_map_paths" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 · The map" "_tombstone" false "frame" #afield/rect [60.0 60.0 520.0 150.0] "code" #afield/file-inline {"path" "sound_map_paths_code_.kt" "inline" "// The map, printed from the code rather than from a page. Six ways to make samples, five ways\n// out, four ways in — and 7 of the 15 on the one seam that matters.\nSoundPathMap.Role.values().forEach { role ->\n    println(\"${role.label}:\")\n    SoundPathMap.PATHS.filter { it.role == role }.forEach { p ->\n        println(\"  %-20s %-19s %s  needs: %s\".format(\n            p.id, p.timing.label, if (p.onSeam) \"[on the seam]\" else \"[off the seam]\", p.needs))\n        println(\"      ${p.what}\")\n        println(\"      ${p.file} — ${p.entryPoint}${if (p.page == null) \"   (NO PAGE DOCUMENTS THIS)\" else \"\"}\")\n    }\n}\nprintln()\nprintln(\"${SoundPathMap.PATHS.count { it.onSeam }} of ${SoundPathMap.PATHS.size} paths meet AudioPatchSpec.Renderer.render(outL, outR, numFrames, ctx)\")\nprintln(\"no published page mentions: ${SoundPathMap.PATHS.filter { it.page == null }.map { it.id }}\")\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "sound_map_compare" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 · One buffer, three paths" "_tombstone" false "frame" #afield/rect [60.0 240.0 520.0 150.0] "code" #afield/file-inline {"path" "sound_map_compare_code_.kt" "inline" "// One buffer, three paths. The dry beat is rendered once by patVoice and then lowpassed at\n// 900 Hz twice — by the Signal graph's own ChamberlinLowpass, and by a Faust program compiled\n// at runtime. Three players, a brightness plot, and the seam claim as a number.\n//\n// The first run pays 13-22s of Truffle warm-up for the Faust compile. The second does not.\nshowSoundPathComparison()\ndisplayOpen(\"path0\")\n"} "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "sound_map_paths" #afield/box "sound_map_compare"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}