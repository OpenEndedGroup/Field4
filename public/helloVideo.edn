field.four.Renderer\nimport afield.four.buffers.*\nimport afield.four.modules.*\nimport java.nio.*\nimport afield.four.texture.LoadedTexture\nimport afield.four.texture.*\nvar Box.bbc by Inheritance<LoadedTexture>() /**/\nval Once.bbc by Onceing<LoadedTexture>() /**/\nvar Box.videoSource by Inheritance<HasImageViewArray>() /**/\nval Once.videoSource by Onceing<HasImageViewArray>() /**/\nval Mesh.pos by FromInput()\nval Mesh.tc by FromInput()\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var pos : FloatBuffer; lateinit var tc : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"tc\") { tc = this ; mesh.write(\"pos\") { pos = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } } ;            };         }\nvar Structure.p by Structure.FromStructure<Any>()\nvar Mesh.p by Mesh.BoundFromStructure<org.joml.Matrix4f>()\nvar Structure.m by Structure.FromStructure<Any>()\nvar Mesh.m by Mesh.BoundFromStructure<org.joml.Matrix4f>()\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/" "fragment" #afield/file-inline {"path" "55bc1784-bc44-40eb-bc01-d02eca463445_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 1) in  vec2 ftc;\n\nlayout(set = 0, binding = 0) uniform sampler2D videoSource[2]; // [0]=Y, [1]=UV\n\n// Map (code10<<6)/65535 -> code10/1023\nconst float P010_TO_NORM10 = 65535.0 / (1023.0 * 64.0); // ~= 1.0009615\n\n// Inverse BT.709 OETF (E' -> linear)\n// (This is the inverse of the BT.709 camera encoding curve.)\nfloat invOETF709(float e)\n{\n    return (e < 0.081)\n        ? (e / 4.5)\n        : pow((e + 0.099) / 1.099, 1.0 / 0.45);\n}\n\n// BT.709 Y'CbCr -> R'G'B' (Cb/Cr are signed-ish around 0)\nvec3 ycbcr709_to_rgb(float Y, float Cb, float Cr)\n{\n    return vec3(\n        Y + 1.5748 * Cr,\n        Y - 0.1873 * Cb - 0.4681 * Cr,\n        Y + 1.8556 * Cb\n    );\n}\n\nvoid main()\n{\n    float y16   = texture(videoSource[0], ftc).r;\n    vec2  uv16  = texture(videoSource[1], ftc).rg;\n\n    // Convert UNORM sample back to 10-bit-normalized (approximately exact for P010)\n    float y10n  = y16  * P010_TO_NORM10;   // ~ [0..1] representing code10/1023\n    vec2  uv10n = uv16 * P010_TO_NORM10;\n\n    // Assume LIMITED range (AVCOL_RANGE_MPEG):\n    // 10-bit nominal: Y in [64..940] (span 876), C in [64..960] (span 896), neutral at 512\n    float Y  = (y10n  - (64.0  / 1023.0)) * (1023.0 / 876.0);\n    float Cb = (uv10n.x - (512.0 / 1023.0)) * (1023.0 / 896.0);\n    float Cr = (uv10n.y - (512.0 / 1023.0)) * (1023.0 / 896.0);\n\n    // Y'CbCr -> R'G'B' (still NONLINEAR)\n    vec3 rgb709_nl = ycbcr709_to_rgb(Y, Cb, Cr);\n    rgb709_nl = clamp(rgb709_nl, 0.0, 1.0);\n\n    // Convert to LINEAR light for output to an sRGB attachment\n    vec3 rgb_linear = vec3(\n        invOETF709(rgb709_nl.r),\n        invOETF709(rgb709_nl.g),\n        invOETF709(rgb709_nl.b)\n    );\n\n    uFragColor = vec4(rgb_linear, 1.0);\n}\n"} "vertex" #afield/file-inline {"path" "55bc1784-bc44-40eb-bc01-d02eca463445_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\nlayout (location = 1) in vec2 tc;\n\nlayout (location = 1) out vec2 ftc;\n\nlayout(push_constant) uniform matrices {\n    mat4 p;\n    mat4 m;\n} pc;\n\nvoid main()\n{\n    gl_Position = pc.p * pc.m * vec4(pos, 1);\n    ftc = tc;\n}"} "code_editorState" "{\"cursorState\":[{\"inSelectionMode\":false,\"selectionStart\":{\"lineNumber\":8,\"column\":10},\"position\":{\"lineNumber\":8,\"column\":10}}],\"viewState\":{\"scrollLeft\":0,\"firstPosition\":{\"lineNumber\":1,\"column\":1},\"firstPositionDeltaTop\":0},\"contributionsS