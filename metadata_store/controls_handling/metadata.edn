{:version 2
 :boxes [{:id "controls_handling_demo"
          :properties {:name "Slider handling"
                       :code "var log = mutableListOf<String>()\nfun report(s: String) { log.add(s); display(\"status\", log.takeLast(8).joinToString(\"<br>\")) }\n\nslider(\"plain\", min = 0.0, max = 10.0, step = 0.1, initialValue = 2.5, channel = \"plain\") { report(\"plain=%.2f\".format(it)) }\n\ncontrolGroup(\"group\") {\n    slider(\"cutoff\", min = 20.0, max = 20000.0, initialValue = 1000.0, law = ControlLaw.LOGARITHMIC) { report(\"cutoff=%.1f\".format(it)) }\n    slider(\"mix\", min = 0.0, max = 1.0, step = 0.01, initialValue = 0.25) { report(\"mix=%.2f\".format(it)) }\n}\n\nsyncToProperty(\"gain\", 0.5, min = 0.0, max = 2.0)\nprintln(\"gain property = \" + getPropertyRaw(\"gain\"))\n"
                       :frame [60.0 60.0 520.0 160.0]
                       :notes "Slider handling demo. Run the box, then: shift-drag for a 10x finer relative drag; arrows nudge (shift x10, alt /10); double-click the track or Backspace to reset; click the number to type one. 'gain' is bound with syncToProperty and survives re-runs."}}]}
