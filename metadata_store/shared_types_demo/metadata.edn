{"version" 2 "boxes" [{"id" "receive" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 - Receive it, still typed" "code" #afield/file-inline {"path" "receive_code_.kt" "inline" "// _particle arrives from box 3. These lines only COMPILE because the type\n// crossed the box boundary: a box-declared class would have landed here as\n// Any? and .x would not resolve.\nprintln(_particle)\nprintln(\"x + y  = \" + (_particle.x + _particle.y))\nprintln(\"momentum = \" + _particle.momentum)"} "frame" #afield/rect [500.0 330.0 430.0 230.0] "nested" #{} "preamble" "" "autorun" false}} {"id" "declare" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Declare shared types" "code" #afield/file-inline {"path" "declare_code_.kt" "inline" "// One publish, and every box in this document can name these types.\n// They are compiled as ordinary Kotlin into a directory on the shared\n// classloader -- not declared in this box's snippet, which is why they\n// escape this box at all.\nprintln(sharedTypes(\"\"\"\npackage shared\n\ndata class Particle(val x: Double, val y: Double, val mass: Double) {\n    val momentum: Double get() = mass * kotlin.math.hypot(x, y)\n}\n\"\"\"))"} "frame" #afield/rect [40.0 40.0 430.0 260.0] "nested" #{} "preamble" "" "autorun" false}} {"id" "use" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Use it, with full fidelity" "code" #afield/file-inline {"path" "use_code_.kt" "inline" "// Named arguments, copy, destructuring and the data-class toString all\n// work, because shared.Particle is a real compiled class with real\n// metadata -- not a type name re-spelled as text.\nval p = shared.Particle(x = 3.0, y = 4.0, mass = 2.0)\nprintln(p)\nprintln(p.copy(mass = 10.0))\nval (x, y, m) = p\nprintln(\"destructured: $x $y $m\")\nprintln(\"momentum: \" + p.momentum)"} "frame" #afield/rect [500.0 40.0 430.0 260.0] "nested" #{} "preamble" "" "autorun" false}} {"id" "export" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - Export a value" "code" #afield/file-inline {"path" "export_code_.kt" "inline" "// @rootExported publishes the value to the document root, so any box can\n// reach it. Before shared types, the *value* crossed but its type did not.\n@rootExported\nval particle = shared.Particle(x = 1.5, y = 2.5, mass = 4.0)\n\nprintln(\"exported: \" + particle)"} "frame" #afield/rect [40.0 330.0 430.0 230.0] "nested" #{} "preamble" "" "autorun" false}} {"id" "root" "properties" {"children" #{#afield/box "declare" #afield/box "use" #afield/box "export" #afield/box "receive"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{} "preamble" ""}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}