index 0000000000..f5c22acc40
--- /dev/null
+++ b/tools/test_reference_kdoc_attachment.py
@@ -0,0 +1,16 @@
+import re
+import unittest
+from pathlib import Path
+
+
+class ReferenceKDocAttachmentTest(unittest.TestCase):
+    def test_anchor_comments_attach_to_their_classes(self):
+        source = (Path(__file__).resolve().parents[1] / "src/jvmMain/kotlin/afield/tools/docs/StdlibReferenceGenerator.kt").read_text()
+        docs = {name: doc for doc, name in re.findall(
+            r"/\*\*((?:(?!/\*\*).)*?)\*/\s*internal (?:data )?class (\w+)", source, re.S)}
+        self.assertIn("Where a KDoc", docs.get("TypeAnchors", ""))
+        self.assertIn("One published declaration", docs.get("AnchorEntry", ""))
+
+
+if __name__ == "__main__":
+    unittest.main()
