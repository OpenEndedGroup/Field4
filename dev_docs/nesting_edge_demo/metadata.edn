{"version" 2 "boxes" [{"id" "root" "properties" {"children" #{#afield/box "nest-container" #afield/box "nested-child" #afield/box "edge-probe"} "parents" #{} "name" "root" "_tombstone" false "nested" #{} "preamble" ""}} {"id" "nest-container" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "nesting container" "_tombstone" false "frame" #afield/rect [80.0 80.0 420.0 260.0] "nested" #{#afield/box "nested-child"} "autorun" false "preamble" "import afield.stdlib.Inheritance\nvar Box.sharedByMarker by Inheritance<Int>() /**/\nvar Box.boxLocalOnly by Inheritance<Int>()" "code" "// This box is the container. Everything it declares with the trailing inherit marker,\n// plus every import, reaches whatever is nested inside it -- but only across a\n// connection edge, and this document is stored without one.\nprintln(\"container\")\n"}} {"id" "nested-child" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "nested child" "_tombstone" false "frame" #afield/rect [40.0 60.0 220.0 90.0] "nested" #{} "nestedIn" #afield/box "nest-container" "autorun" false "preamble" "" "code" "// Nested in `nesting container` and stored with no edge to it, which is the state 31 of\n// the 33 live nested boxes in a real 401-document workspace are in. Run `edge-probe`.\nprintln(\"nested child\")\n"}} {"id" "edge-probe" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "edge-probe" "_tombstone" false "frame" #afield/rect [560.0 80.0 420.0 260.0] "nested" #{} "autorun" false "preamble" "" "code" "import afield.macros.gatherPreambleUpwards\n\nval doc = inside\nval container = doc.boxes[\"nest-container\"]!!\nval child = doc.boxes[\"nested-child\"]!!\n\nprintln(\"--- as stored in metadata.edn -------------------------------------------\")\nprintln(\"child \\\"parents\\\" on disk names only: root  (grep the file: no nest-container)\")\nprintln(\"--- as loaded --------------------------------------------------------------\")\nprintln(\"child.nestedIn        = \" + child.nestedIn?.id)\nprintln(\"edge re-derived       = \" + (container in child.parents))\nprintln(\"container.children    = \" + container.children.map { it.id })\nprintln(\"child.parents         = \" + child.parents.map { it.id })\n\nval withEdge = gatherPreambleUpwards(child)\n// `Box.disconnect` reaches for `thisSessionInfo`, a thread local the box-execution thread\n// does not carry, so take the edge out of the property bag directly and put it straight back.\nval saved = child.parents.toMutableSet()\nchild.setPropertyRaw(\"parents\", saved.toMutableSet().apply { remove(container) })\nval withoutEdge = gatherPreambleUpwards(child)\nchild.setPropertyRaw(\"parents\", saved)\n\nprintln(\"--- what the edge buys -----------------------------------------------------\")\nprintln(\"preamble gathered: \" + withoutEdge.length + \" chars without the edge -> \" + withEdge.length + \" chars with it\")\nprintln(\"inherits the marked line  = \" + (\"sharedByMarker\" in withEdge))\nprintln(\"inherits the import       = \" + (\"import afield.stdlib.Inheritance\" in withEdge))\nprintln(\"inherits the UNmarked one = \" + (\"boxLocalOnly\" in withEdge) + \"  (must be false)\")\n"}}]}
