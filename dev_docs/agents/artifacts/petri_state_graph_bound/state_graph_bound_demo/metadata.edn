{:version 2 :boxes [{:id "state-bound-under"
          :properties {:name "1 - under the bound: 82 markings, drawn in full"
                       :code "import afield.petri.*\n\n// 1 -- UNDER the bound. Five philosophers reach 82 markings, which is inside\n// PETRI_STATE_DRAW_LIMIT (400), so nothing changes: a dot per marking, breadth-first depth\n// left to right, and the shortest route to the deadlock over the top in orange.\n\nfun table(n: Int, reverseLast: Boolean = false) = petri {\n    conflict = PetriConflict.ORDER\n    grid = cyc(1, 4)\n    for (i in 0 until n) place(\"fork.$i\", tokens = 1)\n    for (i in 0 until n) {\n        val left = i\n        val right = (i + 1) % n\n        val reversed = reverseLast && i == n - 1\n        t(\"grab.$i\") { from(\"fork.${if (reversed) right else left}\"); to(\"holding.$i\") }\n        t(\"eat.$i\") { from(\"holding.$i\"); from(\"fork.${if (reversed) left else right}\"); to(\"eating.$i\") }\n        t(\"done.$i\") { from(\"eating.$i\"); to(\"fork.$left\"); to(\"fork.$right\") }\n    }\n}\n\nval graph = table(5).stateSpace()\nprintln(\"${graph.stateCount} markings, ${graph.edgeCount} firings\")\nprintln(\"tooDenseToDraw() = ${graph.tooDenseToDraw()}   limit = $PETRI_STATE_DRAW_LIMIT\")\nprintln(\"counterexample: ${graph.deadlockTrace()}\")\n\nshowPetriStateSpace(graph, w = 1080.0, h = 520.0)\ndisplayOpen(\"statespace-summary\")\n"
                       :frame [60.0 60.0 260.0 56.0]
                       :metadata "tags:\n  - petri\n  - state-space\n  - visualization\ndescription: 1 - under the bound: 82 markings, drawn in full\n"}}
         {:id "state-bound-over"
          :properties {:name "2 - over the bound: the drawing declines"
                       :code "import afield.petri.*\n\n// 2 -- OVER the bound. Nine philosophers reach 2 786 markings and 16 209 firings. Drawn the\n// old way that is a grey rectangle with an orange line somewhere in it: the dot radius has\n// bottomed out at two pixels and the breadth-first layers overlap each other.\n//\n// So the drawing declines, and says so on the figure. What you get instead is two panels:\n// the counterexample alone in the top band, laid out one firing per column across the full\n// width, and one bar per breadth-first layer below it whose height is that layer's\n// population -- which is the one thing the fan of dots was really telling you.\n//\n// The dashed red rule under the caption is deliberate and is not decoration: the label\n// helper draws nothing rather than throwing when no font resolves, so in a headless run the\n// words disappear and the rule is what is left saying \"this is not the graph\".\n\nfun table(n: Int, reverseLast: Boolean = false) = petri {\n    conflict = PetriConflict.ORDER\n    grid = cyc(1, 4)\n    for (i in 0 until n) place(\"fork.$i\", tokens = 1)\n    for (i in 0 until n) {\n        val left = i\n        val right = (i + 1) % n\n        val reversed = reverseLast && i == n - 1\n        t(\"grab.$i\") { from(\"fork.${if (reversed) right else left}\"); to(\"holding.$i\") }\n        t(\"eat.$i\") { from(\"holding.$i\"); from(\"fork.${if (reversed) left else right}\"); to(\"eating.$i\") }\n        t(\"done.$i\") { from(\"eating.$i\"); to(\"fork.$left\"); to(\"fork.$right\") }\n    }\n}\n\nval graph = table(9).stateSpace()\nprintln(\"${graph.stateCount} markings, ${graph.edgeCount} firings\")\nprintln(\"tooDenseToDraw() = ${graph.tooDenseToDraw()}\")\nprintln(\"counterexample: ${graph.deadlockTrace()}\")\nprintln(\"verify(): ${graph.deadlockTrace()!!.verify() ?: \"checks out\"}\")\n\nshowPetriStateSpace(graph, w = 1080.0, h = 520.0)\ndisplayOpen(\"statespace-summary\")\n"
                       :frame [60.0 800.0 260.0 56.0]
                       :metadata "tags:\n  - petri\n  - state-space\n  - visualization\ndescription: 2 - over the bound: the drawing declines\n"}}
         {:id "state-bound-insist"
          :properties {:name "3 - insist, and see what was declined"
                       :code "import afield.petri.*\n\n// 3 -- INSIST, and see what was being declined. `maxNodes = Int.MAX_VALUE` gets the old\n// behaviour back byte for byte. Run this and box 2 and put them side by side: box 2 is a\n// figure you can read a fact off, this is 19 000 FLines of texture.\n//\n// The bound is a default, not a policy. If you have measured that you want the hairball --\n// for a poster, or because your net is nine hundred markings and still legible at the size\n// you are drawing it -- raise it.\n\nfun table(n: Int, reverseLast: Boolean = false) = petri {\n    conflict = PetriConflict.ORDER\n    grid = cyc(1, 4)\n    for (i in 0 until n) place(\"fork.$i\", tokens = 1)\n    for (i in 0 until n) {\n        val left = i\n        val right = (i + 1) % n\n        val reversed = reverseLast && i == n - 1\n        t(\"grab.$i\") { from(\"fork.${if (reversed) right else left}\"); to(\"holding.$i\") }\n        t(\"eat.$i\") { from(\"holding.$i\"); from(\"fork.${if (reversed) left else right}\"); to(\"eating.$i\") }\n        t(\"done.$i\") { from(\"eating.$i\"); to(\"fork.$left\"); to(\"fork.$right\") }\n    }\n}\n\nval graph = table(9).stateSpace()\nval summarised = graph.toFLines(w = 1080.0, h = 520.0)\nval everything = graph.toFLines(w = 1080.0, h = 520.0, maxNodes = Int.MAX_VALUE)\nprintln(\"summarised: ${summarised.size} FLines\")\nprintln(\"insisted:   ${everything.size} FLines  (${everything.size / summarised.size}x)\")\n\nshowPetriStateSpace(graph, w = 1080.0, h = 520.0, maxNodes = Int.MAX_VALUE)\ndisplayOpen(\"statespace-summary\")\n"
                       :frame [60.0 1540.0 260.0 56.0]
                       :metadata "tags:\n  - petri\n  - state-space\n  - visualization\ndescription: 3 - insist, and see what was declined\n"}}
         {:id "state-bound-reduction"
          :properties {:name "4 - the reduction, and the two nets that broke it"
                       :code "import afield.petri.*\n\n// 4 -- the other half of tonight's work, which is why box 2 exists at all: the STUBBORN\n// partial-order reduction. It answers deadlock and refuses everything else, and until\n// 2026-08-20 it could answer it *wrongly* on a net with a read or an inhibitor arc, because\n// a stubborn set has to be closed under \"this transition may disable that one\" as well as\n// the reverse and only the reverse was implemented.\n//\n// Both minimal nets are below. Before the fix, the first lost a whole reachable deadlock\n// while still agreeing that one existed, and the second called a wedging net deadlock-free.\n\n// A transition consumes a place another only READS. `take` drains `r`; `peek` needs a token\n// there and does not consume it, so it was not among the consumers of `r`.\nval readArc = petri {\n    place(\"r\", tokens = 1); place(\"s\", tokens = 1); place(\"u\", tokens = 1)\n    t(\"take\") { from(\"s\"); from(\"r\") }\n    t(\"peek\") { read(\"r\"); from(\"u\") }\n}\n\n// A transition PRODUCES into a place another INHIBITS on. `push` arms `gate`'s inhibitor by\n// filling `x`, and `mayDisable` reads a transition's inputs, so it could not see that.\nval inhibitor = petri {\n    place(\"a\", tokens = 1); place(\"g\", tokens = 1); place(\"x\")\n    t(\"push\") { from(\"a\"); to(\"x\") }\n    t(\"recycle\") { from(\"x\"); from(\"g\"); to(\"a\"); to(\"g\") }\n    t(\"gate\") { inhibit(\"x\"); from(\"g\") }\n}\n\nfor ((name, net) in listOf(\"read arc\" to readArc, \"inhibitor arc\" to inhibitor)) {\n    val full = net.stateSpace()\n    val reduced = net.stateSpace(reduction = PetriReduction.STUBBORN)\n    fun dead(g: PetriStateGraph) = g.deadMarkings.map { g.states[it] }.sortedBy { it.toString() }\n    println(\"$name:\")\n    println(\"  full    ${full.stateCount} markings, canDeadlock=${full.canDeadlock}, dead=${dead(full)}\")\n    println(\"  reduced ${reduced.stateCount} markings, canDeadlock=${reduced.canDeadlock}, dead=${dead(reduced)}\")\n    println(\"  agree on every terminal marking: ${dead(full) == dead(reduced)}\")\n}\n\n// And the measured claim, on the net the reduction exists for. `exact` is what keeps the two\n// searches apart: a completed reduced search has proved deadlock and nothing else.\nval big = petri {\n    conflict = PetriConflict.ORDER\n    grid = cyc(1, 4)\n    for (i in 0 until 12) place(\"fork.$i\", tokens = 1)\n    for (i in 0 until 12) {\n        val left = i\n        val right = (i + 1) % 12\n        t(\"grab.$i\") { from(\"fork.$left\"); to(\"holding.$i\") }\n        t(\"eat.$i\") { from(\"holding.$i\"); from(\"fork.$right\"); to(\"eating.$i\") }\n        t(\"done.$i\") { from(\"eating.$i\"); to(\"fork.$left\"); to(\"fork.$right\") }\n    }\n}\nval reduced = big.stateSpace(reduction = PetriReduction.STUBBORN)\nprintln()\nprintln(\"twelve philosophers, full search:    ${big.stateSpace().outcome} -- it cannot finish\")\nprintln(\"twelve philosophers, reduced search: ${reduced.stateCount} markings, ${reduced.outcome}\")\nprintln(\"  canDeadlock=${reduced.canDeadlock} in ${reduced.deadlockTrace()!!.length} firings\")\nprintln(\"  complete=${reduced.complete} exact=${reduced.exact} bounds=${reduced.bounds}\")\n"
                       :frame [60.0 2280.0 260.0 56.0]
                       :metadata "tags:\n  - petri\n  - state-space\n  - visualization\ndescription: 4 - the reduction, and the two nets that broke it\n"}}]}
