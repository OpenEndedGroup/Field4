{:version 2
 :boxes [{:id "rectsl-soft-raster-bias"
          :properties {:name "RectSL soft rasterization: the coverage bias"
                       :code "// RectSL soft rasterization: the coverage bias, in three panels and three numbers.\n//\n// A RectSL scene lowers a third time here -- past the CPU sampler, past the GLSL SDF -- into a\n// DIFFERENTIABLE raster, so a scene's `free-param`s can be solved against a target *image*. The\n// point of this box is not the fit at the bottom. It is the bias in the middle: soft coverage is a\n// gradient source, and it is NOT a renderer, and the difference is measurable.\n//\n// dev_docs/RECTSL_SOFT_RASTER.md has the full tables and says where the bias is acceptable.\n\nimport afield.rectsl.*\nimport afield.Color4\nimport java.util.Base64\n\nfun bar(id: String, x: Track<Double>, y: Track<Double>, w: Track<Double>, h: Double, rot: Double = 0.0) =\n    RectNode(\n        id, x, y, w, constantTrack(h), constantTrack(rot),\n        constantTrack(1.0), constantTrack(1.0), constantTrack(1.0), constantTrack(0.0),\n        constantPaintTrack(PaintSpec.Solid(Color4(1.0, 1.0, 1.0))), MaterialBinding(0), emptySet()\n    )\n\nval wall = WallSpec(16.0, 16.0, UnitKind.Meters)\nval pixel = 16.0 / 128.0\n\n// A deliberately non-dyadic sub-pixel offset. Without it every edge lands exactly on a pixel\n// boundary, no pixel is ever partially covered, and every bias below reads as exactly zero -- which\n// is how the first version of this measurement fooled itself.\nval jx = 0.37 * pixel\nval jy = 0.21 * pixel\n\nfun scene(vararg r: RectNode) = SceneProgram(wall, 1.0, 30.0, r.toList())\nfun specOf(betaPixels: Double, k: CoverageKernel, c: CoverageComposite = CoverageComposite.UNION_SDF) =\n    SoftRasterSpec(wall, 128, 128, betaPixels * pixel, k, c)\n\nfun png(bytes: ByteArray): String =\n    \"<img src='data:image/png;base64,${Base64.getEncoder().encodeToString(bytes)}' \" +\n        \"style='width:100%;border-radius:5px;display:block;margin-bottom:6px'/>\"\n\n// 1 -- obliquity. Soft raster, exact area coverage, and |soft - exact| on a heat ramp.\nval oblique = scene(\n    bar(\"square\", constantTrack(jx), constantTrack(jy), constantTrack(7.83), 7.83, Math.toRadians(24.0))\n)\nval obliqueField = oblique.toAdField()\nval bands = listOf(0.5, 1.0, 2.0, 4.0).map { b ->\n    b to measureCoverageBias(obliqueField, specOf(b, CoverageKernel.LINEAR), 0.0)\n}\ndisplay(\"bias\", png(RectSLSoftRasterFigure.renderBias(obliqueField, specOf(1.5, CoverageKernel.LINEAR), 0.0)))\n\n// 2 -- the union seam. min(sdf_a, sdf_b) is the union's distance OUTSIDE the union and an\n// under-estimate inside it, so where two rects abut the field reads about zero across a region that\n// is entirely covered. Watch the bright bar down the join.\nval seam = scene(\n    bar(\"left\", constantTrack(-2.0 + jx), constantTrack(jy), constantTrack(4.0), 8.0 + jy),\n    bar(\"right\", constantTrack(2.0 + jx), constantTrack(jy), constantTrack(4.0), 8.0 + jy)\n)\nval seamField = seam.toAdField()\nval seamSpec = specOf(1.0, CoverageKernel.LINEAR)\nval exact = exactRaster(seamField, seamSpec, 0.0)\nval minSdf = softRaster(seamField, seamSpec, 0.0)\nval over = softRaster(seamField, specOf(1.0, CoverageKernel.LINEAR, CoverageComposite.OVER), 0.0)\nval minDiff = DoubleArray(exact.size) { kotlin.math.abs(minSdf[it] - exact[it]) }\nval overDiff = DoubleArray(exact.size) { kotlin.math.abs(over[it] - exact[it]) }\nval peak = maxOf(minDiff.max(), overDiff.max())\ndisplay(\"seam\", png(RectSLSoftRasterFigure.renderPanels(\n    listOf(\n        RectSLSoftRasterFigure.Panel(\"exact area\", exact),\n        RectSLSoftRasterFigure.Panel(\"min-sdf diff %.3f\".format(minDiff.max()), minDiff, heat = true, gain = 1.0 / peak),\n        RectSLSoftRasterFigure.Panel(\"over diff %.3f\".format(overDiff.max()), overDiff, heat = true, gain = 1.0 / peak)\n    ),\n    seamSpec.width, seamSpec.height\n)))\n\n// 3 -- the image fit. Three unknowns, solved from the target RASTER alone: this is the derivative\n// the 2026-08-06 attempt correctly said a per-track lowering could not produce.\nval fitScene = scene(\n    bar(\"solved\", FreeParamTrack(\"bar-x\", jx), FreeParamTrack(\"bar-y\", jy), FreeParamTrack(\"bar-w\", 3.0), 5.0 + jy)\n)\nval fitField = fitScene.toAdField()\nval fitSpec = specOf(2.0, CoverageKernel.SIGMOID)\nval truth = mapOf(\"bar-x\" to 1.6, \"bar-y\" to -1.1, \"bar-w\" to 4.2)\nval target = softRaster(fitField, fitSpec, 0.0, fitField.withFreeParameters(truth))\nval seed = softRaster(fitField, fitSpec, 0.0)\nval names = fitField.freeParameterNames\nval theta = fitField.theta.copyOf()\nval m = DoubleArray(names.size)\nval v = DoubleArray(names.size)\nval seedLoss = softRasterLossAndGradient(fitField, fitSpec, 0.0, target, theta).loss\nfor (iteration in 1..320) {\n    val step = softRasterLossAndGradient(fitField, fitSpec, 0.0, target, theta)\n    for (n in names.indices) {\n        val slots = fitField.freeParameterSlots.getValue(names[n])\n        val g = slots.sumOf { step.gradient[it] }\n        if (!g.isFinite()) continue\n        m[n] = 0.9 * m[n] + 0.1 * g\n        v[n] = 0.999 * v[n] + 0.001 * g * g\n        val mHat = m[n] / (1.0 - Math.pow(0.9, iteration.toDouble()))\n        val vHat = v[n] / (1.0 - Math.pow(0.999, iteration.toDouble()))\n        val update = 0.05 * mHat / (kotlin.math.sqrt(vHat) + 1e-8)\n        if (update.isFinite()) for (slot in slots) theta[slot] -= update\n    }\n}\nval finalLoss = softRasterLossAndGradient(fitField, fitSpec, 0.0, target, theta).loss\ndisplay(\"fit\", png(RectSLSoftRasterFigure.renderPanels(\n    listOf(\n        RectSLSoftRasterFigure.Panel(\"target\", target),\n        RectSLSoftRasterFigure.Panel(\"seed loss %.1e\".format(seedLoss).replace(\"+\", \"\"), seed),\n        RectSLSoftRasterFigure.Panel(\n            \"solved loss %.1e\".format(finalLoss).replace(\"+\", \"\"),\n            softRaster(fitField, fitSpec, 0.0, theta)\n        )\n    ),\n    fitSpec.width, fitSpec.height\n)))\n\nval solved = fitField.freeParameters(theta)\nbuildString {\n    appendLine(\"band width sweep, clamped ramp, worst edge bias with corners excluded:\")\n    bands.forEach { (b, row) ->\n        appendLine(\"  beta = %.2f px   %.3e   (%d edge pixels, reach %.2f px)\"\n            .format(b, row.worstEdgeBias, row.edgePixels, row.reachInPixels))\n    }\n    appendLine(\"  -- one pixel is a SHARP optimum, not a trend: below it the band clips coverage\")\n    appendLine(\"     that is really there, above it the band spreads coverage that is not.\")\n    appendLine()\n    appendLine(\"union seam, beta = 1 px:\")\n    appendLine(\"  min-sdf composite, worst bias %.4f\".format(minDiff.max()))\n    appendLine(\"  over composite,    worst bias %.4f\".format(overDiff.max()))\n    appendLine(\"  -- and the ranking FLIPS where rects overlap: see dev_docs/RECTSL_SOFT_RASTER.md\")\n    appendLine()\n    appendLine(\"image fit, three unknowns, from the target raster alone:\")\n    appendLine(\"  loss %.4e -> %.4e\".format(seedLoss, finalLoss))\n    appendLine(\"  solved $solved\")\n    appendLine(\"  truth  $truth\")\n    appendLine(\"  worst parameter miss %.3e\"\n        .format(truth.maxOf { (k, want) -> kotlin.math.abs(solved.getValue(k) - want) }))\n}\n"
                       :frame [60.0 60.0 560.0 380.0]
                       :metadata "tags:\n  - rectsl\n  - differentiable\n  - rasterization\ndescription: A RectSL scene as a differentiable raster, with its coverage bias measured\n"}}]}
