{"version" 2 "boxes" [{"id" "rectsl_window" "properties" {"children" #{#afield/box "rectsl_source"} "parents" #{#afield/box "root"} "name" "RectSL window" "frame" #afield/rect [70.0 40.0 240.0 60.0] "mainLanguage" "rectsl" "preamble" "" "attic" "" "autorun" false "nested" #{}}} {"id" "rectsl_source" "properties" {"children" #{} "parents" #{#afield/box "rectsl_window"} "name" "the scene — talk here (AI4)" "frame" #afield/rect [70.0 150.0 420.0 150.0] "rectSL" #afield/file-inline {"path" "rectsl_source_rectSL_.rectsl" "inline" "# asked: tall thin bars across the wall, a tide travelling left to right;\n# deep sea colours, darker towards the bottom.\n# chosen: 80 bottom-anchored bars, a three-second wave cycle in a six-second clip.\n# added: a slowly rising moon on the right, with broken shimmering light below.\n# The moon and reflection fade at the loop seam so the rise can begin again.\n->wall 16 9 meters\n->duration 6\n->fps 30\n->background 0x030c16\n\n# A round moon made from fine horizontal slices, behind the tide.\nlinear-track \"moon-rise\" '( 0=2.45 6=3.55 )\nlinear-track \"moon-visibility\" '( 0=0 0.8=1 4.9=1 6=0 )\n\"moon\" rect\n  5.3 ->x\n  0.022 ->h\n  0xd9e9dc solid ->fill\n  \"moon-visibility\" track-ref ->alpha\n  64 '(\n    fc dup * 1 swap - sqrt 1.8 * ->w\n    \"moon-rise\" track-ref fc 0.65 * + ->y\n  ) array ;\n\n# The tide: each bar rises and falls, its foot held at the bottom of the wall.\n# Subtracting the horizontal phase makes the crest travel to the right.\n\"tide\" rect\n  0.135 ->w\n  0x031322 0x167c89  0 -0.5  0 0.5 linear ->fill\n  80 '(\n    fc 7.9 * ->x\n    '( 0=0 6=12.56637061436 ) linear\n    f tau * - sin 2.0 * 5.9 +\n    dup ->h\n    0.5 * 4.5 - ->y\n  ) array ;\n\n# Broken moonlight follows the local water height and spreads towards the viewer.\n# Each small horizontal ripple varies independently in width, offset and brightness.\n\"moon-shimmer\" rect\n  0.038 ->h\n  0xa0cece solid ->fill\n  30 '(\n    '( 0=0 6=25.13274122872 ) linear i 2.37 * + sin\n    0.11 * 5.3 + ->x\n    '( 0=0 6=6.28318530718 ) linear\n    5.24925861106 - sin 2 * 1.4 +\n    4.0 + 1 f - * 4.5 - ->y\n    '( 0=0 6=25.13274122872 ) linear i 1.73 * + sin\n    0.16 * 0.8 + f 1.2 * 0.35 + * ->w\n    '( 0=0 6=25.13274122872 ) linear i 2.13 * + sin\n    0.22 * 0.48 + 1 f 0.65 * - *\n    \"moon-visibility\" track-ref * ->alpha\n  ) array ;\n"} "default_property" "rectSL" "preamble" "" "attic" "" "autorun" true "nested" #{} "ai4_chat_running" false "ai4_chat_history" #afield/file "rectsl_source_ai4_chat_history_.md"}} {"id" "root" "properties" {"children" #{#afield/box "rectsl_window"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{} "fileManagerAccessHistory" []}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isDatalogRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}