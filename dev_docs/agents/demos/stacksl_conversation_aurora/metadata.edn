{"version" 2 "boxes" [{"id" "stacksl_window" "properties" {"children" #{#afield/box "stacksl_source"} "parents" #{#afield/box "root"} "name" "StackSL window" "frame" #afield/rect [70.0 40.0 240.0 60.0] "mainLanguage" "stacksl" "preamble" "" "attic" "" "autorun" false "nested" #{}}} {"id" "stacksl_source" "properties" {"children" #{} "parents" #{#afield/box "stacksl_window"} "name" "the shader — talk here (AI4)" "frame" #afield/rect [70.0 150.0 420.0 150.0] "stackSL" #afield/file-inline {"path" "stacksl_source_stackSL_.stacksl" "inline" "# (asked) Night sky, dark hills, slowly rippling green-to-violet aurora, faint stars.\n# (chosen) Fine vertical folds, soft upper veil, and perfectly still, pure-black hills.\nuv x >ux\nuv y >uy\n# Midnight blue sky, slightly brighter near the horizon.\n[0.0015,0.003,0.012,0] [0.004,0.013,0.025,0] <uy 1 swap - mix >sky\n# The curtain's lower edge undulates slowly across the sky.\n<ux 7 * 0.06t + sin 0.065 *\n<ux 17 * 0.04t - sin 0.022 * + 0.43 + >edge\n<uy <edge - >height\n# Broad atmospheric lower fade: no mountain-like cutoff beneath the curtain.\n-0.28 0.06 <height smoothstep\n<height 0.04 0.44 ramp 1 swap - * >veil\n# Loose hanging fabric: uneven gathers with billowing lower folds.\n<ux 48 * <ux 9 * 0.04t + sin 2.5 * +\n<uy 1 swap - dup * <ux 7 * 0.06t + sin * 4 * +\nsin 0.5 * 0.5 + 1.6 pow 0.88 * 0.12 + >folds\n<ux 9 * 0.035t - sin 0.25 * 0.75 + >strength\n# Emerald lower curtain grades into a violet upper veil.\n[0.012,0.48,0.13,0] [0.17,0.018,0.32,0] <height 0.05 0.32 ramp mix\n<veil * <folds * <strength * 0.65 * <sky + >night\n# A few fixed, faint stars, softened to tiny pinpoints.\nuv [0.12,0.82,0,0] - length 0 0.002 pulse\nuv [0.29,0.91,0,0] - length 0 0.0016 pulse +\nuv [0.76,0.88,0,0] - length 0 0.002 pulse +\nuv [0.91,0.69,0,0] - length 0 0.0017 pulse +\nuv [0.56,0.94,0,0] - length 0 0.0018 pulse +\nuv [0.07,0.58,0,0] - length 0 0.0017 pulse +\n[0.18,0.22,0.29,0] * <night + >lit\n# An unlit rolling hill line occludes both sky and aurora.\n<ux 6 * 0.4 + sin 0.045 *\n<ux 15 * sin 0.014 * + 0.17 + >hill\n<lit [0.0003,0.0007,0.0012,0] <uy <hill - -0.002 0.002 ramp 1 swap - mix\n# Hard occlusion below the static horizon; sky above remains untouched.\n<hill <uy step *\n"} "default_property" "stackSL" "preamble" "" "attic" "" "autorun" true "nested" #{} "ai4_chat_running" false "ai4_chat_history" #afield/file "stacksl_source_ai4_chat_history_.md"}} {"id" "root" "properties" {"children" #{#afield/box "stacksl_window"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{} "fileManagerAccessHistory" []}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isDatalogRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}