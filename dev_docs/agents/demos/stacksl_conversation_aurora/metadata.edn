{"version" 2 "boxes" [{"id" "stacksl_window" "properties" {"children" #{#afield/box "stacksl_source"} "parents" #{#afield/box "root"} "name" "StackSL window" "frame" #afield/rect [70.0 40.0 240.0 60.0] "mainLanguage" "stacksl" "preamble" "" "attic" "" "autorun" false "nested" #{}}} {"id" "stacksl_source" "properties" {"children" #{} "parents" #{#afield/box "stacksl_window"} "name" "the shader — talk here (AI4)" "frame" #afield/rect [70.0 150.0 420.0 150.0] "stackSL" #afield/file-inline {"path" "stacksl_source_stackSL_.stacksl" "inline" "# (asked) Night sky, dark hills, green fading to violet aurora, slow ripples, faint stars.\n# (chosen) A luminous pleated curtain above a low, perfectly still, pure-black horizon.\n\n# A gently folding lower edge; one coordinate in, one height out.\n: aurora-hem >q\n  <q x 7 * time 0.06 * + sin 0.035 * 0.43 +\n  <q x 17 * time 0.04 * - sin 0.018 * +\n;\n# Soft, fixed pinpoints; one star position in, one brightness out.\n: starlight length 620 * dup * neg exp ;\n# Static hills with smaller irregularities along their crest.\n: hill-line >q\n  <q x 6 * 0.8 + sin 0.044 * 0.15 +\n  <q x 15 * sin 0.022 * +\n  <q [32,2,0,0] * fbm 0.018 * +\n;\n\n# Midnight blue, subtly lighter toward the horizon.\n[0.002,0.004,0.014] [0.008,0.019,0.033] uv y 1- 2 pow mix >sky\n\n# A few faint stars, kept still while the curtain moves.\nuv [0.08,0.78] - starlight\nuv [0.19,0.92] - starlight 0.7 * +\nuv [0.31,0.69] - starlight 0.6 * +\nuv [0.43,0.88] - starlight +\nuv [0.57,0.95] - starlight 0.55 * +\nuv [0.69,0.76] - starlight 0.8 * +\nuv [0.83,0.91] - starlight 0.6 * +\nuv [0.94,0.65] - starlight +\nuv [0.13,0.37] - starlight 0.45 * +\nuv [0.75,0.34] - starlight 0.5 * +\n[0.15,0.18,0.24] * <sky + >sky\n\n# Height above the rippling hem.\nuv time >w aurora-hem >hem\nuv y <hem - >height\n\n# Uneven gathers: folds bunch together, then open into wider hanging panels.\nuv x\nuv x 13 * sin 0.035 * +\nuv x 6 * time 0.08 * + sin\nuv y 1- 2 pow * 0.04 * + >fold\n<fold 82 * >pleat\n<pleat <pleat sin 0.6 * + cos 0.5 * 0.5 +\n1.7 pow 0.74 * 0.065 + >rays\n<fold 245 * sin 0.5 * 0.5 + 0.18 * 0.82 + <rays * >rays\n\n# Diffuse lower tips of varied length, rather than a single silhouetted edge.\n<height 0 min\n<fold 37 * 0 vec2 noise 0.1 * 0.08 + /\ndup * neg exp\n<height 0 max 6 * neg exp *\n0.72 1.0 uv y smoothstep 1- *\n<rays * >curtain\n\n# Emerald at the hem blends into violet higher in the curtain.\n[0.025,0.46,0.13] [0.22,0.028,0.4]\n0.035 0.28 <height smoothstep mix\n<curtain * <sky + >scene\n\n# A near-black hill silhouette occludes everything behind it.\nuv hill-line >ridge\n[0.001,0.002,0.0035] <scene\n-0.001 0.002 uv y <ridge - smoothstep mix\nsaturate\n# Exact black at/below the static ridge; leave every above-ridge pixel untouched.\nblack uv y <ridge <= select\n"} "default_property" "stackSL" "preamble" "" "attic" "" "autorun" true "nested" #{} "ai4_chat_running" false "ai4_chat_history" #afield/file "stacksl_source_ai4_chat_history_.md"}} {"id" "root" "properties" {"children" #{#afield/box "stacksl_window"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{} "fileManagerAccessHistory" []}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "