{"version" 2 "boxes" [{"id" "cparity_error" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "cparity_root"} "name" "an error is marked where it happened" "_tombstone" false "frame" #afield/rect [60.0 1040.0 340.0 100.0] "code_language" "Clojure" "code" #afield/file-inline {"path" "cparity_error_code_.kt" "inline" ";; The marker lands on line 6, inside mean, where the division failed --\n;; not on line 8, where mean was called.\n(def readings [])\n\n(defn mean [values]\n  (/ (reduce + values) (count values)))\n\n(mean readings)\n"} "preamble" "" "customization" #afield/file-inline {"path" "cparity_error_customization_.js" "inline" "const title = this.querySelector('.box-title-stack') || this;\nlet label = this.querySelector('[data-afield-language-label=\"true\"]');\nif (!label) {\n    label = document.createElement('div');\n    label.setAttribute('data-afield-language-label', 'true');\n    title.appendChild(label);\n}\nlabel.textContent = \"Clojure\";\nlabel.style.fontSize = \"9px\";\nlabel.style.lineHeight = \"1.1\";\nlabel.style.opacity = \"0.58\";\nlabel.style.fontWeight = \"500\";\nlabel.style.letterSpacing = \"0\";\nlabel.style.textTransform = \"none\";\nlabel.style.pointerEvents = \"none\";\nlabel.style.userSelect = \"none\";\nlabel.style.marginTop = \"1px\";\nthis.style.margin = \"\";"}}} {"id" "cparity_root" "properties" {"children" #{#afield/box "cparity_error" #afield/box "cparity_controls" #afield/box "cparity_context"} "parents" #{#afield/box "root"} "name" "Clojure root -- children of this box run as Clojure" "_tombstone" false "frame" #afield/rect [60.0 40.0 340.0 100.0] "mainLanguage" "clojure" "isClojureRoot" true "code" #afield/file-inline {"path" "cparity_root_code_.kt" "inline" "// The language root stays Kotlin; its `mainLanguage` makes its children Clojure.\n// Its `speed` property and this variable are read by the box \"values from the parent\".\nval palette = listOf(\"tomato\", \"teal\", \"gold\")\nprintln(\"the root stays Kotlin\")\n"} "preamble" ""}} {"id" "cparity_context" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "cparity_root"} "name" "values from the parent" "_tombstone" false "frame" #afield/rect [60.0 3040.0 340.0 100.0] "code_language" "Clojure" "code" #afield/file-inline {"path" "cparity_context_code_.kt" "inline" ";; `context` looks on this box, then on its parents: a property by name,\n;; a Kotlin variable by name, or the nearest value of a class.\n(println \"speed\" (context :speed))\n(println \"palette\" (vec (context \"palette\")))\n(println \"missing\" (context :no-such-thing 1.0))\n"} "preamble" "" "customization" #afield/file-inline {"path" "cparity_context_customization_.js" "inline" "const title = this.querySelector('.box-title-stack') || this;\nlet label = this.querySelector('[data-afield-language-label=\"true\"]');\nif (!label) {\n    label = document.createElement('div');\n    label.setAttribute('data-afield-language-label', 'true');\n    title.appendChild(label);\n}\nlabel.textContent = \"Clojure\";\nlabel.style.fontSize = \"9px\";\nlabel.style.lineHeight = \"1.1\";\nlabel.style.opacity = \"0.58\";\nlabel.style.fontWeight = \"500\";\nlabel.style.letterSpacing = \"0\";\nlabel.style.textTransform = \"none\";\nlabel.style.pointerEvents = \"none\";\nlabel.style.userSelect = \"none\";\nlabel.style.marginTop = \"1px\";\nthis.style.margin = \"\";"}}} {"id" "cparity_controls" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "cparity_root"} "name" "a slider and a checkbox, with Clojure handlers" "_tombstone" false "frame" #afield/rect [60.0 2040.0 340.0 100.0] "code_language" "Clojure" "code" #afield/file-inline {"path" "cparity_controls_code_.kt" "inline" ";; The same controls a Kotlin box draws, calling back into Clojure.\n(def state (atom {:freq 3.0 :square false}))\n\n(defn redraw [{:keys [freq square]}]\n  (display \"main\" (format \"<b>%s</b> at %.1f Hz\" (if square \"square\" \"sine\") freq)))\n\n(slider \"frequency\" #(swap! state assoc :freq %) :min 1 :max 10 :step 0.1 :value 3.0)\n(checkbox \"square wave\" #(swap! state assoc :square %))\n\n(add-watch state :redraw (fn [_ _ _ now] (redraw now)))\n(redraw @state)\n"} "preamble" "" "customization" #afield/file-inline {"path" "cparity_controls_customization_.js" "inline" "const title = this.querySelector('.box-title-stack') || this;\nlet label = this.querySelector('[data-afield-language-label=\"true\"]');\nif (!label) {\n    label = document.createElement('div');\n    label.setAttribute('data-afield-language-label', 'true');\n    title.appendChild(label);\n}\nlabel.textContent = \"Clojure\";\nlabel.style.fontSize = \"9px\";\nlabel.style.lineHeight = \"1.1\";\nlabel.style.opacity = \"0.58\";\nlabel.style.fontWeight = \"500\";\nlabel.style.letterSpacing = \"0\";\nlabel.style.textTransform = \"none\";\nlabel.style.pointerEvents = \"none\";\nlabel.style.userSelect = \"none\";\nlabel.style.marginTop = \"1px\";\nthis.style.margin = \"\";"}}} {"id" "root" "properties" {"children" #{#afield/box "cparity_root" #afield/box "cparity_error" #afield/box "cparity_controls" #afield/box "cparity_context"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "aut