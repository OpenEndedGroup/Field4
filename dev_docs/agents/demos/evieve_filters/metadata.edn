{"version" 2 "boxes" [{"id" "evieve_korg_response" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - Korg35 measured response" "frame" #afield/rect [60.0 60.0 520.0 140.0] "code" #afield/file-inline {"path" "korg_response_code_.kt" "inline" "// The Korg35 (MS-20) lowpass at 1 kHz, measured: an impulse through a fresh filter, then a DFT.\n// The tiny amplitude keeps its tanh linear, so this is the small-signal response.\nval freqs = logFrequencies(20.0, 20_000.0, 200)\nshowSignals(\n    \"resonance 0.1\" to frequencyResponseDb(Korg35(1000.p, 0.1.p), freqs, amplitude = 1e-4f),\n    \"resonance 0.5\" to frequencyResponseDb(Korg35(1000.p, 0.5.p), freqs, amplitude = 1e-4f),\n    \"resonance 0.95\" to frequencyResponseDb(Korg35(1000.p, 0.95.p), freqs, amplitude = 1e-4f),\n    \"highpass 0.8\" to frequencyResponseDb(Korg35(1000.p, 0.8.p, Korg35Mode.HP), freqs, amplitude = 1e-4f),\n    channel = \"main\",\n    xTitle = \"frequency, 20 Hz to 20 kHz (log)\",\n)\n"}}} {"id" "evieve_korg_sweep" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Korg35 swept at audio rate" "frame" #afield/rect [60.0 260.0 520.0 140.0] "code" #afield/file-inline {"path" "korg_sweep_code_.kt" "inline" "// A 55 Hz saw through Korg35. The cutoff is a Param whose mod is a Signal, so it moves per sample:\n// a slow 0.5 Hz sweep plus a 110 Hz wobble that puts sidebands on the resonance.\nval cutoff = Param(1200f).also { it.mod = SineOsc(0.5.p) * 900f + SineOsc(110.p) * 250f }\nval voice = SawOsc(55.p) / Korg35(cutoff, 0.9.p, drive = 2.p)\naudio(voice, gain = 0.15f)\n"}}} {"id" "evieve_resonator" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - Resonators: response and sound" "frame" #afield/rect [60.0 460.0 520.0 140.0] "code" #afield/file-inline {"path" "resonator_code_.kt" "inline" "// Three Resonators on white noise, each frequency drifting on its own slow sine,\n// with the 1 kHz resonator's response at three decays plotted beside it.\nval freqs = (logFrequencies(200.0, 5_000.0, 200) + 1000.0).sorted()\nshowSignals(\n    \"decay 0.02 s\" to frequencyResponseDb(Resonator(1000.p, 0.02.p), freqs, frames = 48_000),\n    \"decay 0.1 s\" to frequencyResponseDb(Resonator(1000.p, 0.1.p), freqs, frames = 48_000),\n    \"decay 0.5 s\" to frequencyResponseDb(Resonator(1000.p, 0.5.p), freqs, frames = 48_000),\n    channel = \"main\",\n    xTitle = \"frequency, 200 Hz to 5 kHz (log)\",\n)\nval noise = WhiteNoise() * 0.3f\nfun band(f: Float, drift: Float, rate: Float, decay: Float) =\n    noise / Resonator(Param(f).also { it.mod = SineOsc(rate.p) * drift }, decay.p)\naudio(band(300f, 80f, 0.2f, 0.6f) + band(750f, 150f, 0.45f, 0.4f) + band(2100f, 300f, 0.7f, 0.3f), gain = 0.5f)\n"}}}]}
