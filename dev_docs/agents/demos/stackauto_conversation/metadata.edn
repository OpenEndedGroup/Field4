{"version" 2 "boxes" [{"id" "polytope_renderer" "properties" {"children" #{#afield/box "polytope_source"} "parents" #{#afield/box "root"} "name" "renderer — launch me first" "frame" #afield/rect [70.0 40.0 260.0 60.0] "code" #afield/file-inline {"path" "polytope_renderer_code_.kt" "inline" "// The window the polytope draws in. Launch this box first, then run the polytope box beneath it.\nimport afield.four.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\nOptions.profiling = false\n\nonce.renderer {\n    window = Window(\"Polytope\", initialDimensions = Rect(80.0, 80.0, 720.0, 720.0))\n    Renderer(window)\n}\n\nstart(renderer::run)\n"} "preamble" "" "attic" "" "autorun" false "nested" #{}}} {"id" "polytope_source" "properties" {"children" #{} "parents" #{#afield/box "polytope_renderer"} "name" "the polytope — talk here (AI4)" "frame" #afield/rect [70.0 150.0 420.0 150.0] "code" #afield/file-inline {"path" "polytope_source_code_.kt" "inline" "import afield.four.Renderer\nimport afield.four.modules.fromContext\nimport afield.stdlib.polytope.*\n\n// A snub dodecahedron, each face with its own vertices, so the faces can fly apart whole.\nval renderer: Renderer = fromContext()\nval module = moduleHere()\nval m = Mesh()\nmodule += m named \"polytope\"\nrenderer += module\n\nval camera = Camera()\ncamera.at = vec(0, 0.5, 2.9)\ncamera.target = vec(0, 0, 0)\nm.p = camera.p\nm.m = camera.m\n\nval solid = canonicalConway(\"sD\").polyhedron.triangulate(normals = NormalPolicy.Flat)\nval mesh = solid.mesh\nval P = mesh.positions; val N = mesh.normals!!; val I = mesh.indices\nval centres = HashMap<Int, FloatArray>()\nfor (t in 0 until mesh.triangleCount) {\n    val c = centres.getOrPut(solid.sourceFace(t).value) { FloatArray(4) }\n    for (k in 0..2) { val i = I[3 * t + k]; c[0] += P[3 * i]; c[1] += P[3 * i + 1]; c[2] += P[3 * i + 2]; c[3] += 1f }\n}\nm.set(3 * mesh.triangleCount, mesh.triangleCount) {\n    for (t in 0 until mesh.triangleCount) {\n        val face = solid.sourceFace(t).value\n        val c = centres.getValue(face)\n        for (k in 0..2) {\n            val i = I[3 * t + k]\n            pos.add(P[3 * i], P[3 * i + 1], P[3 * i + 2])\n            nrm.add(N[3 * i], N[3 * i + 1], N[3 * i + 2])\n            cen.add(c[0] / c[3], c[1] / c[3], c[2] / c[3])\n            fid.add(face.toFloat())\n        }\n        tri.add(3 * t, 3 * t + 1, 3 * t + 2)\n    }\n}\n\n// Time, for both slots.\nval started = System.nanoTime()\nm.push.bind(\"params\") { vec((System.nanoTime() - started) / 1e9, 0, 0, 0) }\n\n// The vertex shader's slot: where each face goes. Talk to it in this box's AI4 chat.\nmodule.explode = \"\"\"\n# (start) every face where it belongs: pushed nowhere, shrunk not at all\n[0,0,0,0]\n\"\"\"\n\n// The fragment shader's slot: each face's colour, and where it burns through.\nmodule.face_decay = \"\"\"\n# (start) one warm grey on every face, nothing burned\n[0.75,0.72,0.68,1]\n\"\"\"\n"} "vertex" #afield/file-inline {"path" "polytope_source_vertex_.glsl" "inline" "#version 450\nlayout(location = 0) in vec3 pos;\nlayout(location = 1) in vec3 nrm;\nlayout(location = 2) in vec3 cen;\nlayout(location = 3) in float fid;\nlayout(location = 0) out vec3 vN;\nlayout(location = 1) out vec3 vLocal;\nlayout(location = 2) flat out float vId;\nlayout(location = 3) out float vAway;\nlayout(push_constant) uniform matrices { mat4 p; mat4 m; vec4 params; } pc;\n\n// explode(vec4(face centre xyz, time)): .x pushes the face out along its normal,\n// .y shrinks it about its own centre (0 keeps it whole, 1 shrinks it to a point).\n{{ stack.auto.explode }}\n\nvoid main() {\n    vec4 e = explode(vec4(cen, pc.params.x));\n    vec3 q = cen + (pos - cen) * (1.0 - clamp(e.y, 0.0, 0.95)) + nrm * e.x;\n    vN = nrm;\n    vLocal = pos - cen;\n    vId = fid;\n    vAway = e.x;\n    gl_Position = pc.p * pc.m * vec4(q, 1.0);\n}\n"} "fragment" #afield/file-inline {"path" "polytope_source_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) in vec3 vN;\nlayout(location = 1) in vec3 vLocal;\nlayout(location = 2) flat in float vId;\nlayout(location = 3) in float vAway;\nlayout(location = 0) out vec4 outColor;\nlayout(push_constant) uniform matrices { mat4 p; mat4 m; vec4 params; } pc;\n\n// face_decay(vec4(place on the face xy, how far the face has flown, time)):\n// .rgb is the face's colour; where .a falls below 0.5 the face burns through.\n{{ stack.auto.face_decay }}\n\nvoid main() {\n    vec4 d = face_decay(vec4(vLocal.xy * 3.0 + 0.5, vAway, pc.params.x));\n    if (d.a < 0.5) discard;\n    float light = 0.35 + 0.65 * max(dot(normalize(vN), normalize(vec3(0.4, 0.8, 0.6))), 0.0);\n    outColor = vec4(d.rgb * light, 1.0);\n}\n"} "default_property" "code" "preamble" "" "attic" "" "autorun" false "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "polytope_renderer"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{} "fileManagerAccessHistory" []}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isDatalogRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}