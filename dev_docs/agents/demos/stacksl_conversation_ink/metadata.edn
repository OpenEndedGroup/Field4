{"version" 2 "boxes" [{"id" "stacksl_window" "properties" {"children" #{#afield/box "stacksl_source"} "parents" #{#afield/box "root"} "name" "window" "frame" #afield/rect [70.0 40.0 240.0 60.0] "code" #afield/file-inline {"path" "stacksl_window_code_.kt" "inline" "// The window the programs beneath this box draw in. Its main language is StackSL, so each child is a\n// StackSL program: run one and it appears here, following every edit that compiles; the study tools\n// render their evidence on this window's GPU. It opens with the document (autorun).\n// It is square because a study frame is: uv runs 0..1 across both axes.\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nonce.renderer {\n    window = Window(\"StackSL study\", initialDimensions = Rect(80.0, 80.0, 720.0, 720.0))\n    Renderer(window)\n}\n\nstart(renderer::run)\n"} "mainLanguage" "stacksl" "preamble" "" "attic" "" "autorun" true "nested" #{}}} {"id" "stacksl_source" "properties" {"children" #{} "parents" #{#afield/box "stacksl_window"} "name" "the shader — talk here (AI4)" "frame" #afield/rect [70.0 150.0 420.0 150.0] "stackSL" #afield/file-inline {"path" "stacksl_source_stackSL_.stacksl" "inline" "# Ink in amber water. Time changes the noise's fourth dimension, never scrolls xy.\n: folds\n  >q\n  <q fbm4\n  <q [7.1,3.8,2.4,0] + fbm4\n  vec2 0.5 - 2.8 * <q +\n;\n# Fixed spatial anchor, slow internal evolution.\np 3.8 * 0.06t >w >domain\n<domain folds folds >flow\n# Feathered concentration around a stationary central bloom.\n<flow fbm4 0.78 *\np [1,0.85,0,0] * length 0.92 * - 0.27 + =concentration\n0.28 0.62 ramp smooth >ink\n# Amber water with a gentle falloff toward the edges.\n[0.78,0.40,0.10] [0.42,0.16,0.028] p length 0.85 * mix >water\n# Dilute indigo at the edges, near-black indigo in the pooled pigment.\n<water [0.105,0.095,0.235] <ink 0.0 0.68 ramp smooth mix\n[0.008,0.012,0.060] <ink 0.30 1.0 ramp smooth mix\n# Fine pale threads tracing the folded internal field.\n[0.25,0.30,0.50]\n<flow fbm4 42 * sin abs 1- 4 pow\n<ink 0.45 0.95 ramp smooth * 0.58 * mix\nsaturate\n# Keep the entire original ink rendering, including the user's speed and threads.\n>original\n# Broad water-light ripples evolve independently, more slowly than the ink.\np 2.4 * 0.014t >w fbm4 >waterNoise\np x 7 * p y 4 * + <waterNoise 5 * + 0.07t + sin 0.5 * 0.5 + >light\n# Copper shade to honey light, applied only to clear water.\n<original\n<water [0.64,0.48,0.34,1] * <water [1.22,1.20,1.10,1] * <light mix\n<concentration 0.10 0.28 ramp smooth 1- mix\n# Exact guard: every pixel with any ink keeps its original RGBA.\n<original <ink 0 > select\nsaturate\n"} "default_property" "stackSL" "preamble" "" "attic" "" "autorun" true "nested" #{} "ai4_chat_running" false "ai4_chat_history" #afield/file "stacksl_source_ai4_chat_history_.md"}} {"id" "root" "properties" {"children" #{#afield/box "stacksl_window"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{} "fileManagerAccessHistory" []}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isDatalogRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}