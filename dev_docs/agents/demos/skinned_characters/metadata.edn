{"version" 2 "boxes" [{"id" "gpu_crowd" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "f5e60137-f514-4c01-865c-5af02f1d8eee"} "name" "6 - Skinning on the GPU, and a crowd of 64" "_tombstone" false "frame" #afield/rect [60.0 375.0 600.0 136.0] "code" #afield/file-inline {"path" "gpu_crowd_code_.kt" "inline" "import afield.graphics.scene.GltfSupport\nimport afield.graphics.scene.GpuSkinner\nimport afield.graphics.scene.GpuSkinning\nimport afield.graphics.scene.RiggedFixture\nimport afield.math.linalg.Matrix4f\n\n// Sixty-four characters, one mesh, one draw call, all of them animating -- and not one vertex is\n// re-uploaded after setup. Box 4 above is the CPU skinner: it rewrites the packed vertex buffer\n// every pose, which costs 2.8 ms for a 50,000-vertex character and cannot be done 64 times.\n//\n// EDIT `count` AND RE-RUN. The per-frame CPU cost is `count x bones` matrices, so 2 here.\nval count = 64\n\n// `renderer` and `window` come from box 0, which publishes them with `prop<Renderer>(renderer)`.\n// This box is connected beneath it, so the bare name resolves -- RUN BOX 0 FIRST. Before box 0\n// has run there is no Renderer anywhere and this box fails with \"must pass in a value for\n// context parameter afield.graphics.vulkan.Renderer\", which is the same footgun box 4 documents.\nval model = GltfSupport.loadGltfBasic(\n    RiggedFixture.locate(), GltfSupport.GltfLoadConfig(loadTextures = false)\n)\nval inst = model.meshes.first { it.skin != null }\n\n// The shaders come straight from the library constants, so this box cannot drift from the code\n// `GpuSkinningSmoke` grades. `skinnedFragmentShader` rather than the bundled one because the\n// bundled glTF fragment shader never reads vColor -- it outputs the normal -- so the per-instance\n// tint would be invisible and \"the crowd is varied\" would be unfalsifiable.\nval module = Module(\n    Parameters(\n        renderer = renderer,\n        vertex = GpuSkinning.skinnedVertexShader,\n        fragment = GpuSkinning.skinnedFragmentShader,\n        name = \"gpu skinned crowd\"\n    )\n).pointer()\n\nval m = Mesh(renderer, module)\nmodule += \"crowd\" to m\nrenderer += \"gpu skinned crowd\" to module\n\nval camera = Camera(renderer)\ncamera.p.orthoness = 0.25\ncamera.p.matchDepth = 2.0\ncamera.target = vec(0, 2, 0)\ncamera.at = vec(6.5, 8.5, -17)\ncamera.p()\n\nval skinner = GpuSkinner(inst, instances = count, renderer = renderer, name = \"crowd\")\nskinner.bindTo(m, camera, instanceCount = count, tint = true)\n\n// Instance i on an 8x8 grid. The placement is multiplied into that instance's palette, so it\n// costs one mul per bone and nothing at all on the GPU -- there is no instance-matrix buffer.\nfun place(i: Int): Matrix4f {\n    val x = (i % 8 - 3.5f) * 2.2f\n    val z = (i / 8 - 3.5f) * 2.2f\n    return Matrix4f().translate(vec(x, 0, z))\n}\n\nvar n = 0\nloop {\n    val t = n / 60f\n    // The whole per-frame CPU cost: `count` palettes of 2 matrices each. Every instance is at its\n    // own phase of its own blend of two clips, which is the per-instance clip blending -- it is\n    // evaluated here, on the CPU, because it is O(instances x bones) and bones are units.\n    skinner.uploadPalettes((0 until count).map { i ->\n        skinner.blendedPalette(\n            place(i),\n            \"bend\", (t + i * 0.09f) % 2f,\n            \"curl\", (t * 0.7f + i * 0.05f) % 2f,\n            mix = i / (count - 1f)\n        )\n    })\n    skinner.updateCamera(m, camera)\n    if (n % 120 == 0) println(\"frame $n: $count instances, ${count * skinner.boneCount} matrices uploaded, one draw call\")\n    n++\n    frame()\n}\n"} "preamble" "import afield.graphics.vulkan.Renderer\nimport afield.graphics.vulkan.util.Window\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/" "autorun" false "nested" #{}}} {"id" "c82c404d-a15d-4f51-a06f-66dfc2a00364" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "f5e60137-f514-4c01-865c-5af02f1d8eee"} "name" "5 - The candy wrapper, side by side" "frame" #afield/rect [697.33203125 375.296875 393.60546875 143.71875] "preamble" "import afield.graphics.vulkan.Renderer\nimport afield.graphics.vulkan.util.Window\nimport java.nio.*\nimport arrow.core.right\nimport arrow.core.left\n\n\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;     this.resize(numVert, numTriangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/\n/*start*/\n/*graphics-structure-type:VertexBuffer:VertexBuffer*/\nclass VertexBuffer(\n    members: List<Introspected.Member> = VertexBufferLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var vertexData by Structure.FromStructure<Float>()\n}\nfun VertexBufferByteSize(): Long = 4L\nfun VertexBufferLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"vertexData\", 0, PrimitiveType.float.left(), 4, false),\n    )\nfun HasBuffer.asVertexBuffer(): VertexBuffer =\n    asStructure(VertexBuffer(), VertexBufferLayoutMembers())\nfun BufferParameters.asVertexBuffer(): VertexBuffer =\n    buffer.asVertexBuffer()\n/*end*/\n/*start*/\n/*graphics-structure-type:IndexBuffer:IndexBuffer*/\nclass IndexBuffer(\n    members: List<Introspected.Member> = IndexBufferLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var indexData by Structure.FromStructure<UInt>()\n}\nfun IndexBufferByteSize(): Long = 4L\nfun IndexBufferLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"indexData\", 0, PrimitiveType.uint.left(), 4, false),\n    )\nfun HasBuffer.asIndexBuffer(): IndexBuffer =\n    asStructure(IndexBuffer(), IndexBufferLayoutMembers())\nfun BufferParameters.asIndexBuffer(): IndexBuffer =\n    buffer.asIndexBuffer()\n/*end*/\n/*graphics-pc-structure:modelView*/ var Structure.modelView by Structure.FromStructure<Any>() // view * model\n/*graphics-pc-binding:modelView*/ var Mesh.modelView by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>() // view * model\n/*graphics-pc-binding-group:modelView*/ var MeshGroup.modelView by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>() // view * model\n/*graphics-pc-structure:proj*/ var Structure.proj by Structure.FromStructure<Any>() // projection\n/*graphics-pc-binding:proj*/ var Mesh.proj by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>() // projection\n/*graphics-pc-binding-group:proj*/ var MeshGroup.proj by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>() // projection\n/*graphics-pc-structure:materialBaseColor*/ var Structure.materialBaseColor by Structure.FromStructure<Any>()\n/*graphics-pc-binding:materialBaseColor*/ var Mesh.materialBaseColor by Mesh.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-binding-group:materialBaseColor*/ var MeshGroup.materialBaseColor by MeshGroup.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-structure:vertexOffset*/ var Structure.vertexOffset by Structure.FromStructure<Any>() // in floats\n/*graphics-pc-binding:vertexOffset*/ var Mesh.vertexOffset by Mesh.BoundFromStructure<UInt>() // in floats\n/*graphics-pc-binding-group:vertexOffset*/ var MeshGroup.vertexOffset by MeshGroup.BoundFromStructure<UInt>() // in floats\n/*graphics-pc-structure:indexOffset*/ var Structure.indexOffset by Structure.FromStructure<Any>() // in indices\n/*graphics-pc-binding:indexOffset*/ var Mesh.indexOffset by Mesh.BoundFromStructure<UInt>() // in indices\n/*graphics-pc-binding-group:indexOffset*/ var MeshGroup.indexOffset by MeshGroup.BoundFromStructure<UInt>() // in indices\n/*graphics-pc-structure:vertexStride*/ var Structure.vertexStride by Structure.FromStructure<Any>() // in floats\n/*graphics-pc-binding:vertexStride*/ var Mesh.vertexStride by Mesh.BoundFromStructure<UInt>() // in floats\n/*graphics-pc-binding-group:vertexStride*/ var MeshGroup.vertexStride by MeshGroup.BoundFromStructure<UInt>() // in floats\n/*graphics-pc-structure:useVertexColor*/ var Structure.useVertexColor by Structure.FromStructure<Any>() // bool as uint\n/*graphics-pc-binding:useVertexColor*/ var Mesh.useVertexColor by Mesh.BoundFromStructure<UInt>() // bool as uint\n/*graphics-pc-binding-group:useVertexColor*/ var MeshGroup.useVertexColor by MeshGroup.BoundFromStructure<UInt>() // bool as uint\n/*graphics-pc-structure:vertexBuffer*/ var Structure.vertexBuffer by Structure.FromStructure<Any>()\n/*graphics-pc-binding:vertexBuffer*/ var Mesh.vertexBuffer by Mesh.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-binding-group:vertexBuffer*/ var MeshGroup.vertexBuffer by MeshGroup.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-structure:indexBuffer*/ var Structure.indexBuffer by Structure.FromStructure<Any>()\n/*graphics-pc-binding:indexBuffer*/ var Mesh.indexBuffer by Mesh.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-binding-group:indexBuffer*/ var MeshGroup.indexBuffer by MeshGroup.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()" "nested" #{} "code" #afield/file-inline {"path" "c82c404d-a15d-4f51-a06f-66dfc2a00364_code_.kt" "inline" "/*\nThe candy wrapper: one rig, one pose, two ways of averaging the joints.\n\n`useDualQuaternions = false` is linear blend skinning -- average the joint MATRICES. `true` is\ndual quaternion skinning -- average the rigid MOTIONS. Everything else is identical: same file,\nsame palette, same clip, same frame. The only difference is `method`. Flip it and re-run.\n\nWhy it happens, exactly: at the joint ring the weights are 0.5/0.5 (the rig has only two distinct\nweight tuples, [1,0,0,0] and [0.5,0.5,0,0]). Linear blending averages the joint MATRICES, so at\n180 degrees about y it forms 0.5*I + 0.5*Ry(180) = diag(0, 1, 0), and every x and z on that ring\nis multiplied by zero. Dual quaternions average the joint MOTIONS, and the average of two\nrotations is a rotation.\n*/\nval useDualQuaternions = false\nval twistTime = 1.0f\n\n// Both mesh views would share inst's uploaded vertex buffer. Use one mesh per chosen method.\n\nvar (module, models) = gltfModelHere(RiggedFixture.locate())\nvar m = Mesh()\nmodule += \"tube\" to m\nrenderer += \"candy wrapper\" to module\n\nval camera = Camera()\ncamera.p.orthoness = 0.3\ncamera.p.matchDepth = 2.0\ncamera.target = vec(0, 2, 0)\ncamera.at = vec(2, 3, -8)\ncamera.p()\n\nval inst = models[0].meshes[0]\nval method =\n    if (useDualQuaternions) GltfSkinning.SkinningMethod.DUAL_QUATERNION else GltfSkinning.SkinningMethod.LINEAR_BLEND\nval skinner = CpuSkinner(inst, GltfSkinning.SkinningOptions(method = method))\n\nval jointY = RiggedFixture.UPPER_JOINT_Y\nval rest = DualQuaternionSkinning.candyWrapperRadius(skinner.pose(\"twist\", 0f).position, jointY)\nval out = skinner.pose(\"twist\", twistTime)\ninst.applyToMesh(m, camera, Matrix4f(), reuseBuffers = true)\n\n// Compare the deformed joint ring with its rest radius.\nval radius = DualQuaternionSkinning.candyWrapperRadius(out.position, jointY)\nval label = if (useDualQuaternions) \"dual quaternion\" else \"linear blend\"\nprintln(\"twist t = %.2f, min radius at the y = %.1f ring (rest %.4f)\".format(twistTime, jointY, rest))\nprintln(\"  %-16s %.6f   (%5.1f%% of rest)\".format(label, radius, 100f * radius / rest))\nprintln(\"  non-rigid joints ${out.nonRigidJoints}, antipodal flips ${out.antipodalFlips}\")\n\nloop { frame() }\n"} "fragment" #afield/file-inline {"path" "c82c404d-a15d-4f51-a06f-66dfc2a00364_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 3) in vec4 vColor;\nlayout(location = 1) in vec3 vNormalVS;\n\nvoid main()\n{\n    float d = abs(dot(vNormalVS.xyz, normalize(vec3(1, 0.4, -0.2))));\n    uFragColor = vec4(vNormalVS.rgb*d,1);\n}"} "vertex" #afield/file-inline {"path" "c82c404d-a15d-4f51-a06f-66dfc2a00364_vertex_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\n#extension GL_EXT_scalar_block_layout : require\n\nlayout(std430, buffer_reference) readonly buffer VertexBuffer {\n    float vertexData[];\n};\n\nlayout(std430, buffer_reference) readonly buffer IndexBuffer {\n    uint indexData[];\n};\n\nlayout(push_constant) uniform PushConstants {\n    mat4 modelView; // view * model\n    mat4 proj; // projection\n\n    vec4 materialBaseColor;\n\n    uint vertexOffset; // in floats\n    uint indexOffset; // in indices\n    uint vertexStride; // in floats\n    uint useVertexColor; // bool as uint\n\n    VertexBuffer vertexBuffer;\n    IndexBuffer indexBuffer;\n} pc;\n\nlayout(location = 0) out vec3 vViewPos;\nlayout(location = 1) out vec3 vNormalVS;\nlayout(location = 2) out vec2 vUV;\nlayout(location = 3) out vec4 vColor;\n\nvoid main()\n{\n    uint idx = pc.indexBuffer.indexData[pc.indexOffset+uint(gl_VertexIndex)];\n    uint base = pc.vertexOffset + idx * pc.vertexStride;\n\n    vec3 pos = vec3(\n    pc.vertexBuffer.vertexData[base + 0],\n    pc.vertexBuffer.vertexData[base + 1],\n    pc.vertexBuffer.vertexData[base + 2]\n    );\n\n    vec3 normal = vec3(\n    pc.vertexBuffer.vertexData[base + 3],\n    pc.vertexBuffer.vertexData[base + 4],\n    pc.vertexBuffer.vertexData[base + 5]\n    );\n\n    vec2 uv = vec2(\n    pc.vertexBuffer.vertexData[base + 6],\n    pc.vertexBuffer.vertexData[base + 7]\n    );\n\n    vec4 color = vec4(\n    pc.vertexBuffer.vertexData[base + 8],\n    pc.vertexBuffer.vertexData[base + 9],\n    pc.vertexBuffer.vertexData[base + 10],\n    pc.vertexBuffer.vertexData[base + 11]\n    );\n\n    if (pc.useVertexColor == 0u) {\n        color = vec4(1.0);\n    }\n\n    vec4 clipPosition = pc.proj * pc.modelView*vec4(pos, 1.0);\n\n    mat3 mv3 = mat3(pc.modelView);\n    vec3 normalVS = normalize(mv3 * normal);\n\n    // Compatibility varying: clip-space xyz, currently unused by the paired fragment.\n    vViewPos = clipPosition.xyz;\n    vNormalVS = normalVS;\n    vUV = uv;\n    vColor = color * pc.materialBaseColor;\n\n    gl_Position = clipPosition;\n}\n"} "attic" "" "autorun" false}} {"id" "rig_facts" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - A rigged mesh, and what the loader now reads out of it" "_tombstone" false "frame" #afield/rect [60.0 60.0 600.0 136.0] "code" #afield/file-inline {"path" "rig_facts_code_.kt" "inline" "// Inspect the rig, joint weights and sampled poses before drawing the deformed mesh.\n\nval rig = RiggedFixture.locate()\nval model = GltfSupport.loadGltfBasic(rig, GltfSupport.GltfLoadConfig(loadTextures = false))\nval skin = model.meshes.firstNotNullOf { it.skin }\nval sk = skin.skeleton\n\nprintln(\"rig  $rig\")\nprintln(\n    \"mesh ${model.meshes.first().buffers.vertexCount} vertices, \" +\n        \"${model.meshes.first().buffers.indexCount / 3} triangles\",\n)\nprintln()\nprintln(\"nodes   ${sk.nodes.map { it.name }}\")\nprintln(\"parents ${sk.nodes.map { it.parent }}   (-1 is the scene root)\")\nprintln(\"bones   ${sk.bones.map { \"${it.name} -> node ${it.node}\" }}\")\nprintln(\"clips   ${sk.clips.map { \"${it.name} (${it.durationSeconds}s, ${it.channels.size} channels)\" }}\")\nprintln()\nprintln(\"The skeleton indexes NODES, not bones. Assimp hands over a bone's name and its inverse\")\nprintln(\"bind matrix and no parent -- the hierarchy is in the node tree, a bone's parent chain\")\nprintln(\"routinely runs through nodes that are NOT bones (here: 'armature'), and the skeleton root\")\nprintln(\"is not the mesh's node. Indexing nodes makes all three fall out instead of needing cases.\")\nprintln()\n\n// Weights, over a stated population. A skinning bug that shows up as a mesh collapsing toward the\n// origin is almost always weights that do not sum to 1, so it is worth being able to see the number.\nval infl = skin.influences\nprintln(\n    \"weights over all ${infl.vertexCount} vertices: worst |sum(w) - 1| = ${infl.worstWeightSumError()}, \" +\n        \"${infl.unweightedVertices()} unweighted, ${infl.discardedInfluences} influences past the \" +\n        \"${GltfSkinning.MAX_INFLUENCES}-wide cap\",\n)\n\n// The assertion worth making about a bind pose is EXACTNESS, not closeness: an inverse-bind mistake\n// lands a fraction of a percent off, which any tolerance you would reach for waves through.\nval rest = assimpToTriMesh(rig)\nval atZero = skinnedGltfToTriMesh(rig, clip = \"bend\", seconds = 0f)\nval identical =\n    (0 until rest.vertexCount).count { v ->\n        val a = rest.position(v)\n        val b = atZero.position(v)\n        a.x == b.x && a.y == b.y && a.z == b.z\n    }\nprintln(\"bind pose: $identical of ${rest.vertexCount} vertices bit-identical to the unskinned mesh\")\n\nval view = MeshView(yawDegrees = 0.0, pitchDegrees = 8.0, distance = 2.6)\nshowMeshGrid(\n    \"bind, t = 0\" to atZero,\n    \"bend, t = 0.5\" to skinnedGltfToTriMesh(rig, clip = \"bend\", seconds = 0.5f),\n    \"bend, t = 1\" to skinnedGltfToTriMesh(rig, clip = \"bend\", seconds = 1f),\n    \"curl, t = 1\" to skinnedGltfToTriMesh(rig, clip = \"curl\", seconds = 1f),\n    columns = 4,\n    cellWidth = 300,\n    view = view,\n)\n"} "preamble" "" "nested" #{} "autorun" false}} {"id" "gpu_twist" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "f5e60137-f514-4c01-865c-5af02f1d8eee"} "name" "7 - The candy wrapper on the GPU, linear and dual quaternion in one draw" "_tombstone" false "frame" #afield/rect [700.0 540.0 600.0 136.0] "code" #afield/file-inline {"path" "gpu_twist_code_.kt" "inline" "import afield.graphics.scene.DualQuaternionSkinning\nimport afield.graphics.scene.GltfSkinning.SkinningMethod\nimport afield.graphics.scene.GltfSkinning.SkinningOptions\nimport afield.graphics.scene.GltfSkinning\nimport afield.graphics.scene.GltfSupport\nimport afield.graphics.scene.GpuSkinner\nimport afield.graphics.scene.GpuSkinning\nimport afield.graphics.scene.RiggedFixture\nimport afield.math.linalg.Matrix4f\n\n// Box 5 is the candy wrapper on the CPU. This is the same twist on the GPU, both methods in ONE\n// draw call: the left cylinder is linear blend skinning and pinches to a point at 180 degrees, the\n// right one is dual quaternion skinning and keeps its radius. Same mesh, same palette, same shader;\n// the only difference between them is one word per instance saying which blend to run.\n//\n// RUN BOX 0 FIRST, and stop box 6 if it is running -- both draw into box 0's window.\n//\n// EDIT `methods` AND RE-RUN: make both LINEAR_BLEND and both pinch; make both DUAL_QUATERNION and\n// neither does.\nval methods = listOf(SkinningMethod.LINEAR_BLEND, SkinningMethod.DUAL_QUATERNION)\n\nval model = GltfSupport.loadGltfBasic(\n    RiggedFixture.locate(), GltfSupport.GltfLoadConfig(loadTextures = false)\n)\nval inst = model.meshes.first { it.skin != null }\n\nval module = Module(\n    Parameters(\n        renderer = renderer,\n        vertex = GpuSkinning.skinnedVertexShader,\n        fragment = GpuSkinning.skinnedFragmentShader,\n        name = \"gpu twist, lbs vs dqs\"\n    )\n).pointer()\n\nval m = Mesh(renderer, module)\nmodule += \"twist\" to m\nrenderer += \"gpu twist, lbs vs dqs\" to module\n\nval camera = Camera(renderer)\ncamera.p.orthoness = 0.3\ncamera.p.matchDepth = 2.0\ncamera.target = vec(0, 2, 0)\ncamera.at = vec(0, 2.4, -5.2)\ncamera.p()\n\nval skinner = GpuSkinner(inst, instances = 2, renderer = renderer, name = \"twist\")\nskinner.bindTo(m, camera, instanceCount = 2, tint = true)\n\n// Seen from this camera +x is on the LEFT, so instance 0 goes to +1.3.\nval places = listOf(Matrix4f().translate(vec(1.3, 0, 0)), Matrix4f().translate(vec(-1.3, 0, 0)))\nval sk = skinner.skin.skeleton\nval twist = sk.clip(\"twist\")!!\n\n// The waist as a number, from the CPU oracles on the same palette: the smallest distance from the\n// bone axis of any vertex on the y = 2 ring. Printed so the picture is not the only evidence.\nval restRadius = RiggedFixture.RADIUS\nfun waist(method: SkinningMethod, palette: List<Matrix4f>): Float {\n    val bind = FloatArray(skinner.vertexCount * 3) { skinner.bindPositions[it] }\n    val out = GltfSkinning.skin(bind, null, inst.skin!!.influences, palette, SkinningOptions(method = method))\n    return DualQuaternionSkinning.candyWrapperRadius(out.position, RiggedFixture.UPPER_JOINT_Y)\n}\n\nvar n = 0\nloop {\n    // 0 -> 180 -> 0 degrees of twist, three seconds a cycle at 60 fps, on a loop.\n    val seconds = (n / 90f) % twist.durationSeconds\n    skinner.uploadPalettes(places.map { skinner.placedPalette(it, \"twist\", seconds) }, methods)\n    skinner.updateCamera(m, camera)\n    if (n % 45 == 0) {\n        val rest = sk.palette(twist, seconds)\n        println(\"t = %.2f s   waist, %% of rest radius:   %s %.1f%%   |   %s %.1f%%\".format(\n            seconds,\n            methods[0], 100 * waist(methods[0], rest) / restRadius,\n            methods[1], 100 * waist(methods[1], rest) / restRadius,\n        ))\n    }\n    n++\n    frame()\n}\n"} "preamble" "import afield.graphics.vulkan.Renderer\nimport afield.graphics.vulkan.util.Window\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/" "nested" #{} "autorun" false}} {"id" "drag_time" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - Drag `time` and watch it bend" "_tombstone" false "frame" #afield/rect [700.0 60.0 600.0 136.0] "code" #afield/file-inline {"path" "drag_time_code_.kt" "inline" "import afield.ui.output.controlGroup\nimport afield.ui.output.displayOpen\nimport afield.graphics.scene.RiggedFixture\nimport afield.graphics.scene.posedGltfToTriMesh\nimport afield.geometry.mesh.MeshView\nimport afield.geometry.mesh.showMesh\n\n// Drag `time`. The cylinder bends.\n//\n// `time` runs 0 -> 2 seconds through a clip that rotates the upper bone 0 -> 60 -> 0 degrees about\n// +z. At 0 the tube is straight and the skinned vertices are bit-identical to the unskinned ones;\n// at 1 the tip has swung -sqrt(3) in x, which is -2 sin 60 exactly. Drag `bend to curl` as well and\n// the LOWER bone joins in, which is the parent chain composing.\n\nval rig = RiggedFixture.locate()\nval view = MeshView(yawDegrees = 0.0, pitchDegrees = 8.0, distance = 2.6)\n\nvar seconds = 0.6\nvar mix = 0.0\n\nfun draw() {\n    // blendedPalette mixes the two clips' joint matrices componentwise -- the same linear blend that\n    // linear blend skinning itself commits to, so a limb shortens at 90 degrees here exactly as it\n    // does there. Not a quaternion blend, deliberately, so the two agree.\n    val mesh = posedGltfToTriMesh(rig) { s ->\n        s.blendedPalette(s.clip(\"bend\"), seconds.toFloat(), s.clip(\"curl\"), seconds.toFloat(), mix.toFloat())\n    }\n    val b = mesh.bounds()\n    // Printed as well as drawn, so the pose is a NUMBER and not only a picture -- at time 1, mix 0,\n    // tip x is -1.982, which is -2 sin 60 minus the tube's own radius projected onto the bend.\n    println(\"time %.2f s, bend->curl %.2f -> tip x %.4f, top y %.4f\"\n        .format(seconds, mix, b.min.x, b.max.y))\n    showMesh(\n        mesh, channel = \"pose\", view = view,\n        caption = \"time %.2f s, bend->curl %.2f — tip reaches x = %.3f\".format(seconds, mix, b.min.x),\n    )\n}\n\ncontrolGroup(\"controls\") {\n    slider(\"time\", min = 0.0, max = 2.0, step = 0.01, initialValue = seconds) { seconds = it; draw() }\n    slider(\"bend to curl\", min = 0.0, max = 1.0, step = 0.01, initialValue = mix) { mix = it; draw() }\n}\ndisplayOpen(\"controls\")\ndraw()\nprintln(\"Drag `time` (0 to 2 s) in the controls above, or on /controllers.\")\nprintln(\"At time 0 and 2 the tube is straight; the extreme is at time 1.\")\n"} "preamble" "" "nested" #{} "autorun" false}} {"id" "gpu_skin" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "f5e60137-f514-4c01-865c-5af02f1d8eee"} "name" "4 - The same deformation on the GPU, no shader change" "_tombstone" false "frame" #afield/rect [700.0 226.0 600.0 136.0] "code" #afield/file-inline {"path" "gpu_skin_code_.kt" "inline" "/*\nDraw a CPU-skinned pose with Field's glTF module and bundled shaders.\nCpuSkinner rewrites the packed position/normal data that applyToMesh uploads.\n\nEDIT `poseTime` AND RE-RUN. 0 is a straight tube; 1 is a 60-degree bend with the tip at\nx = -1.982. The line it prints is the tip's x and the mesh's top y, so the pose is a number as\nwell as a picture.\n*/\nval poseTime = 1.0f\n\n// Launch the connected renderer parent first.\n\nvar (module, models) = gltfModelHere(RiggedFixture.locate())\n\nvar m = Mesh()\nmodule += \"skinned\" to m\nrenderer += \"skinned characters\" to module\n\nval camera = Camera()\ncamera.p.orthoness = 0.3\ncamera.p.matchDepth = 2.0\ncamera.target = vec(0, 2, 0)\ncamera.at = vec(2, 3, -8)\ncamera.p()\n\nval inst = models[0].meshes[0]\nval skinner = CpuSkinner(inst)\nval out = skinner.pose(\"bend\", poseTime)\n\n// model = identity, NOT the default: a skinned mesh is already in scene space, because glTF 2.0\n// 3.7.3.2 says a skinned mesh node's own transform is ignored. The default would apply it twice.\ninst.applyToMesh(m, camera, Matrix4f(), reuseBuffers = true)\n\nval minX = (0 until out.vertexCount).minOf { out.position[it * 3] }\nval maxY = (0 until out.vertexCount).maxOf { out.position[it * 3 + 1] }\nprintln(\"gpu skinned at t = %.2f -> tip x %.4f, top y %.4f\".format(poseTime, minX, maxY))\n\nloop { frame() }\n\n// Pose and upload once; edit poseTime and rerun to inspect a different bend.\n"} "preamble" "import afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\nimport java.nio.*\nimport arrow.core.right\nimport arrow.core.left\n\n\n/*supermap*/ class MappedStructure {;     lateinit var tri : IntBuffer; ; }; fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;     this.resize(numVert, numTriangle);     val mesh = this;     MappedStructure().apply {;          mesh.t?.mapAndWrite_ints { tri = this ; builder() } ;    }; }\n/*start*/\n/*graphics-structure-type:VertexBuffer:VertexBuffer*/\nclass VertexBuffer(\n    members: List<Introspected.Member> = VertexBufferLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var vertexData by Structure.FromStructure<Float>()\n}\nfun VertexBufferByteSize(): Long = 4L\nfun VertexBufferLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"vertexData\", 0, PrimitiveType.float.left(), 4, false),\n    )\nfun HasBuffer.asVertexBuffer(): VertexBuffer =\n    asStructure(VertexBuffer(), VertexBufferLayoutMembers())\nfun BufferParameters.asVertexBuffer(): VertexBuffer =\n    buffer.asVertexBuffer()\n/*end*/\n/*start*/\n/*graphics-structure-type:IndexBuffer:IndexBuffer*/\nclass IndexBuffer(\n    members: List<Introspected.Member> = IndexBufferLayoutMembers(),\n    baseOffset: Int = 0,\n    pathPrefix: String = \"\",\n    root: Structure? = null\n) : Structure(members, baseOffset, pathPrefix, root) {\n    init { setMembers(members) }\n    var indexData by Structure.FromStructure<UInt>()\n}\nfun IndexBufferByteSize(): Long = 4L\nfun IndexBufferLayoutMembers(): List<Introspected.Member> =\n    listOf(\n        Introspected.Member(\"indexData\", 0, PrimitiveType.uint.left(), 4, false),\n    )\nfun HasBuffer.asIndexBuffer(): IndexBuffer =\n    asStructure(IndexBuffer(), IndexBufferLayoutMembers())\nfun BufferParameters.asIndexBuffer(): IndexBuffer =\n    buffer.asIndexBuffer()\n/*end*/\n/*graphics-pc-structure:modelView*/ var Structure.modelView by Structure.FromStructure<Any>() // view * model\n/*graphics-pc-binding:modelView*/ var Mesh.modelView by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>() // view * model\n/*graphics-pc-binding-group:modelView*/ var MeshGroup.modelView by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>() // view * model\n/*graphics-pc-structure:proj*/ var Structure.proj by Structure.FromStructure<Any>() // projection\n/*graphics-pc-binding:proj*/ var Mesh.proj by Mesh.BoundFromStructure<afield.math.linalg.Matrix4f>() // projection\n/*graphics-pc-binding-group:proj*/ var MeshGroup.proj by MeshGroup.BoundFromStructure<afield.math.linalg.Matrix4f>() // projection\n/*graphics-pc-structure:materialBaseColor*/ var Structure.materialBaseColor by Structure.FromStructure<Any>()\n/*graphics-pc-binding:materialBaseColor*/ var Mesh.materialBaseColor by Mesh.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-binding-group:materialBaseColor*/ var MeshGroup.materialBaseColor by MeshGroup.BoundFromStructure<afield.math.linalg.Vector4f>()\n/*graphics-pc-structure:vertexOffset*/ var Structure.vertexOffset by Structure.FromStructure<Any>() // in floats\n/*graphics-pc-binding:vertexOffset*/ var Mesh.vertexOffset by Mesh.BoundFromStructure<UInt>() // in floats\n/*graphics-pc-binding-group:vertexOffset*/ var MeshGroup.vertexOffset by MeshGroup.BoundFromStructure<UInt>() // in floats\n/*graphics-pc-structure:indexOffset*/ var Structure.indexOffset by Structure.FromStructure<Any>() // in indices\n/*graphics-pc-binding:indexOffset*/ var Mesh.indexOffset by Mesh.BoundFromStructure<UInt>() // in indices\n/*graphics-pc-binding-group:indexOffset*/ var MeshGroup.indexOffset by MeshGroup.BoundFromStructure<UInt>() // in indices\n/*graphics-pc-structure:vertexStride*/ var Structure.vertexStride by Structure.FromStructure<Any>() // in floats\n/*graphics-pc-binding:vertexStride*/ var Mesh.vertexStride by Mesh.BoundFromStructure<UInt>() // in floats\n/*graphics-pc-binding-group:vertexStride*/ var MeshGroup.vertexStride by MeshGroup.BoundFromStructure<UInt>() // in floats\n/*graphics-pc-structure:useVertexColor*/ var Structure.useVertexColor by Structure.FromStructure<Any>() // bool as uint\n/*graphics-pc-binding:useVertexColor*/ var Mesh.useVertexColor by Mesh.BoundFromStructure<UInt>() // bool as uint\n/*graphics-pc-binding-group:useVertexColor*/ var MeshGroup.useVertexColor by MeshGroup.BoundFromStructure<UInt>() // bool as uint\n/*graphics-pc-structure:vertexBuffer*/ var Structure.vertexBuffer by Structure.FromStructure<Any>()\n/*graphics-pc-binding:vertexBuffer*/ var Mesh.vertexBuffer by Mesh.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-binding-group:vertexBuffer*/ var MeshGroup.vertexBuffer by MeshGroup.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-structure:indexBuffer*/ var Structure.indexBuffer by Structure.FromStructure<Any>()\n/*graphics-pc-binding:indexBuffer*/ var Mesh.indexBuffer by Mesh.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\n/*graphics-pc-binding-group:indexBuffer*/ var MeshGroup.indexBuffer by MeshGroup.BoundFromStructure<afield.graphics.vulkan.buffers.HasBuffer>()\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/" "nested" #{} "autorun" false "fragment" #afield/file-inline {"path" "gpu_skin_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 3) in vec4 vColor;\nlayout(location = 1) in vec3 vNormalVS;\n\nvoid main()\n{\n    float d = abs(dot(vNormalVS.xyz, normalize(vec3(1, 0.4, -0.2))));\n    uFragColor = vec4(vNormalVS.rgb*d,1);\n}"} "vertex" #afield/file-inline {"path" "gpu_skin_vertex_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\n#extension GL_EXT_scalar_block_layout : require\n\nlayout(std430, buffer_reference) readonly buffer VertexBuffer {\n    float vertexData[];\n};\n\nlayout(std430, buffer_reference) readonly buffer IndexBuffer {\n    uint indexData[];\n};\n\nlayout(push_constant) uniform PushConstants {\n    mat4 modelView; // view * model\n    mat4 proj; // projection\n\n    vec4 materialBaseColor;\n\n    uint vertexOffset; // in floats\n    uint indexOffset; // in indices\n    uint vertexStride; // in floats\n    uint useVertexColor; // bool as uint\n\n    VertexBuffer vertexBuffer;\n    IndexBuffer indexBuffer;\n} pc;\n\nlayout(location = 0) out vec3 vViewPos;\nlayout(location = 1) out vec3 vNormalVS;\nlayout(location = 2) out vec2 vUV;\nlayout(location = 3) out vec4 vColor;\n\nvoid main()\n{\n    uint idx = pc.indexBuffer.indexData[pc.indexOffset+uint(gl_VertexIndex)];\n    uint base = pc.vertexOffset + idx * pc.vertexStride;\n\n    vec3 pos = vec3(\n    pc.vertexBuffer.vertexData[base + 0],\n    pc.vertexBuffer.vertexData[base + 1],\n    pc.vertexBuffer.vertexData[base + 2]\n    );\n\n    vec3 normal = vec3(\n    pc.vertexBuffer.vertexData[base + 3],\n    pc.vertexBuffer.vertexData[base + 4],\n    pc.vertexBuffer.vertexData[base + 5]\n    );\n\n    vec2 uv = vec2(\n    pc.vertexBuffer.vertexData[base + 6],\n    pc.vertexBuffer.vertexData[base + 7]\n    );\n\n    vec4 color = vec4(\n    pc.vertexBuffer.vertexData[base + 8],\n    pc.vertexBuffer.vertexData[base + 9],\n    pc.vertexBuffer.vertexData[base + 10],\n    pc.vertexBuffer.vertexData[base + 11]\n    );\n\n    if (pc.useVertexColor == 0u) {\n        color = vec4(1.0);\n    }\n\n    vec4 clipPosition = pc.proj * pc.modelView*vec4(pos, 1.0);\n\n    mat3 mv3 = mat3(pc.modelView);\n    vec3 normalVS = normalize(mv3 * normal);\n\n    // Compatibility varying: clip-space xyz, currently unused by the paired fragment.\n    vViewPos = clipPosition.xyz;\n    vNormalVS = normalVS;\n    vUV = uv;\n    vColor = color * pc.materialBaseColor;\n\n    gl_Position = clipPosition;\n}\n"}}} {"id" "f5e60137-f514-4c01-865c-5af02f1d8eee" "properties" {"children" #{#afield/box "gpu_skin" #afield/box "c82c404d-a15d-4f51-a06f-66dfc2a00364" #afield/box "gpu_crowd" #afield/box "gpu_twist"} "parents" #{#afield/box "root"} "name" "0 - A window and a renderer, which box 4 needs" "frame" #afield/rect [0.0 0.0 100.0 100.0] "preamble" "import afield.graphics.vulkan.util.Window\nimport afield.graphics.vulkan.Renderer\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/" "nested" #{} "code" #afield/file-inline {"path" "f5e60137-f514-4c01-865c-5af02f1d8eee_code_.kt" "inline" "import afield.graphics.vulkan.util.Options\n\n// Publish the window and renderer for the connected drawing boxes.\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\nonce.renderer {\n    window = Window(\"Field · skinned characters\", initialDimensions = Rect(80.0, 80.0, 1100.0, 700.0))\n    Renderer(window)\n}\nprintln(\"renderer ready — now run box 4\")\nstart(renderer::run)\n"} "autorun" false}} {"id" "path_trace" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 - The refusal PathTraceGltf used to make" "_tombstone" false "frame" #afield/rect [60.0 226.0 600.0 136.0] "code" #afield/file-inline {"path" "path_trace_code_.kt" "inline" "import afield.graphics.scene.fabricated.GltfSkinPose\nimport afield.graphics.scene.fabricated.PathTraceScene\nimport afield.graphics.scene.fabricated.importGltf\n\n// Compare path-tracing geometry imported at rest and at the selected bend pose.\n\nval rig = RiggedFixture.locate()\n\nval rest = PathTraceScene()\nval restImport = rest.importGltf(rig)\nval bent = PathTraceScene()\nval bentImport = bent.importGltf(rig, pose = GltfSkinPose(\"bend\", 1f))\n\nprintln(\n    \"rest pose   ${restImport.triangleCount} triangles, \" +\n        \"x in [%.4f, %.4f]\".format(restImport.boundsMin.x, restImport.boundsMax.x),\n)\nprintln(\n    \"bend t=1    ${bentImport.triangleCount} triangles, \" +\n        \"x in [%.4f, %.4f]\".format(bentImport.boundsMin.x, bentImport.boundsMax.x),\n)\nprintln()\nbentImport.warnings.forEach { println(\"warning: $it\") }\nprintln()\n\n/*\nThe cross-check worth printing: two completely separate readers of the same deformation. The\ntracer walks Assimp and stages world-space triangles; the CPU bridge packs a 12-float vertex\nbuffer and builds a TriMesh. They are two implementations of one formula, so agreeing is\nevidence and disagreeing would localise the bug.\n*/\nval cpu = skinnedGltfToTriMesh(rig, clip = \"bend\", seconds = 1f).bounds()\nprintln(\"CPU bridge  x in [%.4f, %.4f], y in [%.4f, %.4f]\".format(cpu.min.x, cpu.max.x, cpu.min.y, cpu.max.y))\nprintln(\n    \"tracer      x in [%.4f, %.4f], y in [%.4f, %.4f]\"\n        .format(bentImport.boundsMin.x, bentImport.boundsMax.x, bentImport.boundsMin.y, bentImport.boundsMax.y),\n)\nprintln(\n    \"max |difference| = %.7f\"\n        .format(\n            maxOf(\n                kotlin.math.abs(cpu.min.x - bentImport.boundsMin.x),\n                kotlin.math.abs(cpu.max.x - bentImport.boundsMax.x),\n                kotlin.math.abs(cpu.min.y - bentImport.boundsMin.y),\n                kotlin.math.abs(cpu.max.y - bentImport.boundsMax.y),\n            ),\n        ),\n)\nprintln()\nprintln(\"An unknown clip name fails the import rather than quietly tracing the rest pose -- try\")\nprintln(\"GltfSkinPose(\\\"walk\\\", 1f) above and read the message.\")\n"} "preamble" "" "nested" #{} "autorun" false}}] "persistent