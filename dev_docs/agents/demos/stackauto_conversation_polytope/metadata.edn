{"version" 2 "boxes" [{"id" "polytope_source" "properties" {"children" #{} "parents" #{#afield/box "polytope_renderer"} "name" "the polytope — talk here (AI4)" "frame" #afield/rect [70.0 150.0 420.0 150.0] "code" #afield/file-inline {"path" "polytope_source_code_.kt" "inline" "import afield.four.Renderer\nimport afield.four.modules.fromContext\nimport afield.stdlib.polytope.*\n\n// A snub dodecahedron, each face with its own vertices, so the faces can fly apart whole.\nval renderer: Renderer = fromContext()\nval module = moduleHere()\nval m = Mesh()\nmodule += m named \"polytope\"\nrenderer += module\n\nval camera = Camera()\ncamera.at = vec(0, 0.5, 2.9)\ncamera.target = vec(0, 0, 0)\nm.p = camera.p\nm.m = camera.m\n\nval solid = canonicalConway(\"sD\").polyhedron\nval topology = solid.topology\nval xyz = solid.realization!!.vertexCoordinates\nval centres = solid.faceCentroids\n// Centre-to-perimeter fans give a polygon radius, not a circular mask.\nval fanCount = topology.faces.sumOf { topology.faceCycle(it.id).size }\nm.set(3 * fanCount, fanCount) {\n    var t = 0\n    topology.faces.forEachIndexed { f, face ->\n        val c = centres[f]\n        val n = solid.faceNormal(face.id)\n        val ring = topology.faceCycle(face.id).map { xyz[topology.vertexMap.getValue(it)] }\n        for (k in ring.indices) {\n            for ((p, r) in listOf(c to 0f, ring[k] to 1f, ring[(k + 1) % ring.size] to 1f)) {\n                pos.add(p.x, p.y, p.z); nrm.add(n.x, n.y, n.z); cen.add(c.x, c.y, c.z)\n                fid.add(face.id.value.toFloat()); faceRadius.add(r)\n            }\n            tri.add(3 * t, 3 * t + 1, 3 * t + 2); t++\n        }\n    }\n}\n\n// Time, for the animated explode slot; face_decay follows its travel.\nval started = System.nanoTime()\nm.push.bind(\"params\") { vec((System.nanoTime() - started) / 1e9, 0, 0, 0) }\n\n// The vertex shader's slot: where each face goes.\nmodule.explode = \"\"\"# Repeating 4.8-second phase; higher face centres lead the wave\ninput w\n4.8 /\ninput y\n0.222817 *\n+\nfract\n# Fast attack: reach full extension in 0.384 seconds\ndup\n0.08 /\n# Slow return: back home at phase 0.58, then rest\nswap\n-1 *\n0.58 +\n0.5 /\nmin\n# Clamp and ease both ends so the faces rejoin cleanly\n0 max\n1 min\nsmooth\n# Synchronized outward travel and shrink about each face centre\n[0.65,0.25,0,0] *\"\"\"\n\n// The fragment shader's slot: heat and polygon-shaped, ragged burn-through.\nmodule.face_decay = \"\"\"# Heat follows outward travel\ninput z\n0.65 /\n0 max\n1 min\nsmooth\n# Dark iron to incandescent orange\n[1.355,0.23,-0.037,0] *\n[0.045,0.05,0.055,0] +\n# Host polygon radius: zero at centre, one at the real perimeter\ninput w\n# Deep, stable tears in the remaining rim\ninput xy\n13 *\nfbm\n0.42 *\n+\n0.015 +\n# Eat most of the interior while far out; fully heal on return\ninput z\n0.65 /\n0.55 -\n0.30 /\n0 max\n1 min\nsmooth\n1.07 *\n-\n# Keep a narrow outer thread even at the deepest tears\ninput w\n0.975 -\nmax\n# Host discards alpha below 0.5\n10 *\n0.5 +\n[0,0,0,1] *\n+\"\"\"\n"} "vertex" #afield/file-inline {"path" "polytope_source_vertex_.glsl" "inline" "#version 450\nlayout(location = 0) in vec3 pos;\nlayout(location = 1) in vec3 nrm;\nlayout(location = 2) in vec3 cen;\nlayout(location = 3) in float fid;\nlayout(location = 4) in float faceRadius;\nlayout(location = 0) out vec3 vN;\nlayout(location = 1) out vec3 vLocal;\nlayout(location = 2) flat out float vId;\nlayout(location = 3) out float vAway;\nlayout(location = 4) out float vRadius;\nlayout(push_constant) uniform matrices { mat4 p; mat4 m; vec4 params; } pc;\n\n// explode: outward travel and shrink about each face centre.\n{{ stack.auto.explode }}\n\nvoid main() {\n    vec4 e = explode(vec4(cen, pc.params.x));\n    vec3 q = cen + (pos - cen) * (1.0 - clamp(e.y, 0.0, 0.95)) + nrm * e.x;\n    vN = nrm;\n    vLocal = pos - cen;\n    vId = fid;\n    vAway = e.x;\n    vRadius = faceRadius;\n    gl_Position = pc.p * pc.m * vec4(q, 1.0);\n}\n"} "fragment" #afield/file-inline {"path" "polytope_source_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) in vec3 vN;\nlayout(location = 1) in vec3 vLocal;\nlayout(location = 2) flat in float vId;\nlayout(location = 3) in float vAway;\nlayout(location = 4) in float vRadius;\nlayout(location = 0) out vec4 outColor;\nlayout(push_constant) uniform matrices { mat4 p; mat4 m; vec4 params; } pc;\n\n// face_decay(vec4(place on the face xy, outward travel, polygon radius)):\n// radius is 0 at the face centre and 1 at its actual perimeter, including pentagons.\n// .rgb is the face's colour; where .a falls below 0.5 the face burns through.\n{{ stack.auto.face_decay }}\n\nvoid main() {\n    vec4 d = face_decay(vec4(vLocal.xy * 3.0 + 0.5, vAway, vRadius));\n    if (d.a < 0.5) discard;\n    float light = 0.35 + 0.65 * max(dot(normalize(vN), normalize(vec3(0.4, 0.8, 0.6))), 0.0);\n    outColor = vec4(d.rgb * light, 1.0);\n}\n"} "default_property" "code" "preamble" "import afield.four.util.Window\nimport afield.four.Renderer\nimport afield.four.buffers.*\nimport afield.four.modules.*\nimport arrow.core.left\nimport arrow.core.right\nimport java.nio.*\n/*supermap*/ class MappedStructure {;             lateinit var tri : IntBuffer; lateinit var cen : FloatBuffer; lateinit var pos : FloatBuffer; lateinit var nrm : FloatBuffer; lateinit var fid : FloatBuffer; lateinit var faceRadius : FloatBuffer; ;         };         fun Mesh.set(numVert : Int, numTriangle : Int = 0, builder : MappedStructure.() -> Unit = {}) {;             this.resize(numVert, numTriangle);             val mesh = this;             MappedStructure().apply {;                  mesh.write(\"faceRadius\") { faceRadius = this ; mesh.write(\"fid\") { fid = this ; mesh.write(\"nrm\") { nrm = this ; mesh.write(\"pos\") { pos = this ; mesh.write(\"cen\") { cen = this ; mesh.t?.mapAndWrite_ints { tri = this ; builder() } } } } } } ;            };         }\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/\n/*graphics-input:cen*/ val Mesh.cen by FromInput()\n/*graphics-input:pos*/ val Mesh.pos by FromInput()\n/*graphics-input:nrm*/ val Mesh.nrm by FromInput()\n/*graphics-input:fid*/ val Mesh.fid by FromInput()\n/*graphics-input:faceRadius*/ val Mesh.faceRadius by FromInput()\n/*start*/\n/*stack-auto:explode*/\nvar ModulePointer.explode: String\n    get() = afield.stdlib.stackAutoShaderSource(this, \"explode\")\n    set(value) { afield.stdlib.stackAutoShaderSource(this, \"explode\", value) }\nvar ComputeModulePointer.explode: String\n    get() = afield.stdlib.stackAutoShaderSource(this, \"explode\")\n    set(value) { afield.stdlib.stackAutoShaderSource(this, \"explode\", value) }\nvar MeshModulePointer.explode: String\n    get() = afield.stdlib.stackAutoShaderSource(this, \"explode\")\n    set(value) { afield.stdlib.stackAutoShaderSource(this, \"explode\", value) }\n/*end*/\n/*start*/\n/*stack-auto:face_decay*/\nvar ModulePointer.face_decay: String\n    get() = afield.stdlib.stackAutoShaderSource(this, \"face_decay\")\n    set(value) { afield.stdlib.stackAutoShaderSource(this, \"face_decay\", value) }\nvar ComputeModulePointer.face_decay: String\n    get() = afield.stdlib.stackAutoShaderSource(this, \"face_decay\")\n    set(value) { afield.stdlib.stackAutoShaderSource(this, \"face_decay\", value) }\nvar MeshModulePointer.face_decay: String\n    get() = afield.stdlib.stackAutoShaderSource(this, \"face_decay\")\n    set(value) { afield.stdlib.stackAutoShaderSource(this, \"face_decay\", value) }\n/*end*/\n/*graphics-pc-structure:p*/ var Structure.p by Structure.FromStructure<Any>()\n/*graphics-pc-binding:p*/ var Mesh.p by Mesh.BoundFromStructure<afield.stdlib.linalg.Matrix4f>()\n/*graphics-pc-binding-group:p*/ var MeshGroup.p by MeshGroup.BoundFromStructure<afield.stdlib.linalg.Matrix4f>()\n/*graphics-pc-structure:m*/ var Structure.m by Structure.FromStructure<Any>()\n/*graphics-pc-binding:m*/ var Mesh.m by Mesh.BoundFromStructure<afield.stdlib.linalg.Matrix4f>()\n/*graphics-pc-binding-group:m*/ var MeshGroup.m by MeshGroup.BoundFromStructure<afield.stdlib.linalg.Matrix4f>()\n/*graphics-pc-structure:params*/ var Structure.params by Structure.FromStructure<Any>()\n/*graphics-pc-binding:params*/ var Mesh.params by Mesh.BoundFromStructure<afield.stdlib.linalg.Vector4f>()\n/*graphics-pc-binding-group:params*/ var MeshGroup.params by MeshGroup.BoundFromStructure<afield.stdlib.linalg.Vector4f>()\n/*graphics-ubo:face_decay_numbers*/ val ModulePointer.face_decay_numbers by FromUniform()\n/*graphics-ubo:explode_numbers*/ val ModulePointer.explode_numbers by FromUniform()" "attic" "" "autorun" false "nested" #{} "ai4_chat_running" false "ai4_chat_history" #afield/file "polytope_source_ai4_chat_history_.md"}} {"id" "polytope_renderer" "properties" {"children" #{#afield/box "polytope_source"} "parents" #{#afield/box "root"} "name" "renderer — launch me first" "frame" #afield/rect [70.0 40.0 260.0 60.0] "code" #afield/file-inline {"path" "polytope_renderer_code_.kt" "inline" "// The window the polytope draws in. Launch this box first, then run the polytope box beneath it.\nimport afield.four.util.Options\n\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nOptions.enableHDR = false\nOptions.profiling = false\n\nonce.renderer {\n    window = Window(\"Polytope\", initialDimensions = Rect(80.0, 80.0, 720.0, 720.0))\n    Renderer(window)\n}\n\nstart(renderer::run)\n"} "preamble" "import afield.four.Renderer\nimport afield.four.util.Window\nvar Box.window by Inheritance<Window>() /**/\nval Once.window by Onceing<Window>() /**/\nvar Box.renderer by Inheritance<Renderer>() /**/\nval Once.renderer by Onceing<Renderer>() /**/" "attic" "" "autorun" false "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "polytope_renderer"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{} "fileManagerAccessHistory" 