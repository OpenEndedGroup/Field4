# Still zellige: all geometry and glaze depend only on position.
# Fold a point into one of eight mirrored wedges.
: wedge
  polar >pol
  <pol y 0.392699 + 0.785398 mod 0.392699 - abs
  <pol x swap vec2 cart
;
# Signed edge of an eight-point star, with straight ceramic edges.
: star
  wedge dup x swap y 1.45 * + 0.465 - 1.7614 /
;
# Octagonal distance for the central white medallion.
: octagon
  abs >a
  <a x <a y max
  <a x <a y + 0.707107 * max
;
# Four by four repeating rosettes.
uv 4 * >grid
<grid fract 0.5 - >q
<q star >edge
<q wedge >fold
<q octagon 0.132 - >hub
# Alternating cobalt facets, warm white ground, tiny saffron corner diamonds.
[0.88,0.87,0.81,1] >ivory
[0.018,0.055,0.30,1] [0.027,0.10,0.44,1]
<q polar y 0.392699 + 0.785398 / floor 2 mod mix >cobalt
<ivory <cobalt -0.0015 0.0015 <edge smoothstep 1- mix
<ivory -0.0015 0.0015 <hub smoothstep 1- mix
>ceramic
# A small saffron diamond sits at each junction of four repeats.
<q abs 0.5 swap - x+y 0.105 - 0.707107 * >goldedge
<ceramic [0.86,0.43,0.035,1] -0.0015 0.0015 <goldedge smoothstep 1- mix
>ceramic
# Saffron centre jewel, deliberately much smaller than the cobalt petals.
<q abs x+y 0.045 - 0.707107 * >jewel
<ceramic [0.86,0.43,0.035,1] -0.0015 0.0015 <jewel smoothstep 1- mix
>ceramic
# Grout follows star edges, hub, centre jewels and the eight petal divisions.
<edge abs <hub abs min <goldedge abs min <jewel abs min >joint
<fold x 0.382683 * <fold y 0.92388 * - abs
<hub 0.004 > * <hub 0.004 <= 1 * +
<joint min >joint
# Straight background joints end at the rosette and corner diamonds.
<q abs dup x swap y max 0.5 swap -
<edge 0.006 > * <edge 0.006 <= 1 * +
<joint min >joint
# Subtle static glaze variation; dark, narrow recessed mortar.
<ceramic uv 95 * noise 0.045 * 0.955 + *
>glaze
[0.024,0.028,0.035,1] <glaze 0.003 0.005 <joint smoothstep mix
