{"version" 2 "boxes" [{"id" "stacksl_window" "properties" {"children" #{#afield/box "stacksl_source"} "parents" #{#afield/box "root"} "name" "window" "frame" #afield/rect [70.0 40.0 240.0 60.0] "code" #afield/file-inline {"path" "stacksl_window_code_.kt" "inline" "// The window the programs beneath this box draw in. Its main language is StackSL, so each child is a\n// StackSL program: run one and it appears here, following every edit that compiles; the study tools\n// render their evidence on this window's GPU. It opens with the document (autorun).\n// It is square because a study frame is: uv runs 0..1 across both axes.\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nonce.renderer {\n    window = Window(\"StackSL study\", initialDimensions = Rect(80.0, 80.0, 720.0, 720.0))\n    Renderer(window)\n}\n\nstart(renderer::run)\n"} "mainLanguage" "stacksl" "preamble" "" "attic" "" "autorun" true "nested" #{}}} {"id" "stacksl_source" "properties" {"children" #{} "parents" #{#afield/box "stacksl_window"} "name" "the shader — talk here (AI4)" "frame" #afield/rect [70.0 150.0 420.0 150.0] "stackSL" #afield/file-inline {"path" "stacksl_source_stackSL_.stacksl" "inline" "# Still zellige: all geometry and glaze depend only on position.\n# Fold a point into one of ten mirrored wedges.\n: wedge\n  polar >pol\n  <pol y 0.314159265 + 0.628318531 mod 0.314159265 - abs\n  <pol x swap vec2 cart\n;\n# Ten-point star with the same tip and valley radii as the original.\n: star\n  wedge dup x swap y 1.707717 * + 0.465 - 1.707717 dup * 1 + sqrt /\n;\n# Ten-sided central white medallion.\n: medallion\n  wedge x\n;\n# Four by four repeating rosettes.\nuv 4 * >grid\n<grid fract 0.5 - >q\n<q star >edge\n<q wedge >fold\n<q medallion 0.132 - >hub\n# Alternating terracotta facets, cream ground, tiny deep-green corner diamonds.\n[0.92,0.84,0.68,1] >ivory\n[0.48,0.135,0.065,1] [0.62,0.205,0.105,1]\n<q polar y 0.314159265 + 0.628318531 / floor 2 mod mix >cobalt\n<ivory <cobalt -0.0015 0.0015 <edge smoothstep 1- mix\n<ivory -0.0015 0.0015 <hub smoothstep 1- mix\n>ceramic\n# A small deep-green diamond sits at each junction of four repeats.\n<q abs 0.5 swap - x+y 0.105 - 0.707107 * >goldedge\n<ceramic [0.012,0.095,0.045,1] -0.0015 0.0015 <goldedge smoothstep 1- mix\n>ceramic\n# Deep-green centre jewel, deliberately much smaller than the terracotta petals.\n<q abs x+y 0.045 - 0.707107 * >jewel\n<ceramic [0.012,0.095,0.045,1] -0.0015 0.0015 <jewel smoothstep 1- mix\n>ceramic\n# Grout follows star edges, hub, centre jewels and the ten petal divisions.\n<edge abs <hub abs min <goldedge abs min <jewel abs min >joint\n<fold x 0.309016994 * <fold y 0.951056516 * - abs\n<hub 0.004 > * <hub 0.004 <= 1 * +\n<joint min >joint\n# Straight background joints end at the rosette and corner diamonds.\n<q abs dup x swap y max 0.5 swap -\n<edge 0.006 > * <edge 0.006 <= 1 * +\n<joint min >joint\n# Subtle static glaze variation; dark, narrow recessed mortar.\n<ceramic uv 95 * noise 0.045 * 0.955 + *\n>glaze\n[0.024,0.028,0.035,1] <glaze 0.007 0.009 <joint smoothstep mix\n"} "default_property" "stackSL" "preamble" "" "attic" "" "autorun" true "nested" #{} "ai4_chat_running" false "ai4_chat_history" #afield/file "stacksl_source_ai4_chat_history_.md"}} {"id" "root" "properties" {"children" #{#afield/box "stacksl_window"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{} "fileManagerAccessHistory" []}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone