{"version" 2 "boxes" [{"id" "stacksl_window" "properties" {"children" #{#afield/box "stacksl_source"} "parents" #{#afield/box "root"} "name" "StackSL window" "frame" #afield/rect [70.0 40.0 240.0 60.0] "mainLanguage" "stacksl" "preamble" "" "attic" "" "autorun" false "nested" #{}}} {"id" "stacksl_source" "properties" {"children" #{} "parents" #{#afield/box "stacksl_window"} "name" "the shader — talk here (AI4)" "frame" #afield/rect [70.0 150.0 420.0 150.0] "stackSL" #afield/file-inline {"path" "stacksl_source_stackSL_.stacksl" "inline" "# (asked) Still zellige-like tiles: eight-fold cobalt and white rosettes,\n# a little saffron, and thin dark grout. No time-dependent words.\n# (chosen) Four repeats, square/diamond eight-point stars, ivory inset stars.\n: squaremax >point <point abs x <point abs y max ;\n: starfield >point\n<point y <point x atan2 0.6283185307179586 / 0.5 + fract 0.5 - abs 0.6283185307179586 * >angle\n0.3141592653589793 <angle - sin 0.765366865 * <angle sin +\n0.23651136821647611 / <point length * 0.707106781 * ;\n\n# Repeating coordinates; the two squares make an eight-point silhouette.\nuv 4 * fract 0.5 - >tile\n<tile starfield >star\n<star 0.303 - >edge\n\n# Cobalt stars in an ivory ground.\n[0.48,0.13,0.065,1] [0.91,0.82,0.65,1] -0.002 0.002 <edge smoothstep mix >color\n\n# Fine charcoal grout on the perimeter of every star.\n<color [0.012,0.018,0.023,1] 0.012 0.015 <edge abs smoothstep 1 swap - mix >color\n\n# A smaller white star forms the center of each rosette.\n<color [0.91,0.82,0.65,1] 0.127 0.130 <star smoothstep 1 swap - mix >color\n<color [0.012,0.018,0.023,1] 0.004 0.007 <star 0.129 - abs smoothstep 1 swap - mix >color\n\n# Small saffron octagons at the center, framed with dark grout.\n<tile abs x <tile abs y max <tile abs x <tile abs y + 0.707107 * max >octagon\n<color [0.012,0.018,0.023,1] 0.067 0.070 <octagon smoothstep 1 swap - mix >color\n<color [0.015,0.095,0.045,1] 0.058 0.061 <octagon smoothstep 1 swap - mix >color\n\n# Small cobalt diamonds join the four white interstitial tiles.\n<tile abs x <tile abs y + >corner\n<color [0.012,0.018,0.023,1] 0.848 0.853 <corner smoothstep mix >color\n<color [0.48,0.13,0.065,1] 0.863 0.868 <corner smoothstep mix >color\n<color\n"} "default_property" "stackSL" "preamble" "" "attic" "" "autorun" true "nested" #{} "ai4_chat_running" false "ai4_chat_history" #afield/file "stacksl_source_ai4_chat_history_.md"}} {"id" "root" "properties" {"children" #{#afield/box "stacksl_window"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{} "fileManagerAccessHistory" []}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isDatalogRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}