{"version" 2 "boxes" [{"id" "aff1dff8-9c85-4fc1-9c9a-de7cae2ce37b" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "A saved{} counter" "frame" #afield/rect [60.0 240.0 530.0 140.0] "preamble" "" "nested" #{} "code" #afield/file-inline {"path" "aff1dff8-9c85-4fc1-9c9a-de7cae2ce37b_code_.kt" "inline" "// `saved {}` is per-box persistence: assign to it and it is on disk, read it next\n// session and it is still there. The file is <document dir>/<box id>/runs.json.\n//\n// Run this box a few times in a NORMAL session and the count climbs across restarts.\n// Run it in a READ-ONLY session and it climbs within the run and then forgets: the\n// write is refused, and `~/.afield/logs/save_reload.log` says so with a\n// `write-refused-read-only` line naming this property.\n//\n// Before 2026-09-07 the read-only case wrote the file anyway — including on the very\n// first *read*, because with no file yet `saved {}` computes the default and writes it.\nvar runs by saved { 0 }\n\nruns = runs + 1\nprintln(\"this box has run $runs time(s)\")\n"}}} {"id" "870b3111-5179-4b74-8e71-06aec8dc8536" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "How to see read-only mode" "frame" #afield/rect [60.0 60.0 530.0 140.0] "nested" #{} "preamble" "" "code" #afield/file-inline {"path" "870b3111-5179-4b74-8e71-06aec8dc8536_code_.kt" "inline" "// Read-only mode, end to end.\n//\n// Open this document normally:      ./field.sh <workspace> -d read_only_session\n// Open it read-only:                ./field.sh <workspace> -d read_only_session --read-only\n//\n// Read-only is also AFIELD_READ_ONLY=1, -Dafield.readOnly=true, or the agent\n// backdoor's `open --read-only` for a single session.\n//\n// What to look for in a read-only session:\n//\n//   1. An amber pill at the top of the window: READ-ONLY, and in plain words that\n//      nothing you change here will be saved.\n//   2. Type in any box. The pill becomes a running count of the changes that are\n//      going to be discarded. Cursor movement does NOT count -- Monaco's view state\n//      is not part of the document.\n//   3. Try to close or reload the window. The browser asks you to confirm, because\n//      there is work to lose. Field has no explicit save, so this dialog is the only\n//      moment a user would otherwise find out.\n//   4. Drop a file onto the canvas. Refused, with a reason, instead of silently\n//      copying it into a document that will not be written.\n//\n// Nothing in this document needs a GPU, a network, or any setup.\nprintln(\"open me with --read-only and read the pill at the top of the window\")\n"}}} {"id" "root" "properties" {"children" #{#afield/box "870b3111-5179-4b74-8e71-06aec8dc8536" #afield/box "aff1dff8-9c85-4fc1-9c9a-de7cae2ce37b"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isDatalogRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}