{"version" 2 "boxes" [{"id" "rectsl_window" "properties" {"children" #{#afield/box "rectsl_source"} "parents" #{#afield/box "root"} "name" "window" "frame" #afield/rect [70.0 40.0 240.0 60.0] "code" #afield/file-inline {"path" "rectsl_window_code_.kt" "inline" "// The window the scenes beneath this box play in. Its main language is RectSL, so each child is a\n// RectSL scene: run one and it plays here, looping, following every edit that compiles; the study\n// tools draw their evidence on this window's GPU. It opens with the document (autorun).\n// A scene's wall is fitted into the window, with black around it when their shapes differ.\nprop<Window>(window)\nprop<Renderer>(renderer)\n\nonce.renderer {\n    window = Window(\"RectSL study\", initialDimensions = Rect(80.0, 80.0, 960.0, 540.0))\n    Renderer(window)\n}\n\nstart(renderer::run)\n"} "mainLanguage" "rectsl" "preamble" "" "attic" "" "autorun" true "nested" #{}}} {"id" "rectsl_source" "properties" {"children" #{} "parents" #{#afield/box "rectsl_window"} "name" "the scene — talk here (AI4)" "frame" #afield/rect [70.0 150.0 420.0 150.0] "rectSL" #afield/file-inline {"path" "rectsl_source_rectSL_.rectsl" "inline" "# (asked) A Fischinger-inspired visual score: vertical rectangles, 120 BPM, 4/4, stronger first beat; lower rows answer in a one-beat canon.\n# (chosen) Three symmetrical rows; cream and vermilion on black. Top leads, middle +0.5 s, bottom +1 s; six-second loop.\n->wall 16 9 meters\n->duration 6\n->fps 30\n->background 0x0e0a08\n\n# One two-second bar: sharp attacks every 0.5 s, short releases, and a larger downbeat.\nlinear-track \"four-beats\" '( 0=2.1  0.34=0.62  0.44=0.62  0.5=1.4  0.72=0.62  0.94=0.62  1=1.4  1.22=0.62  1.44=0.62  1.5=1.4  1.72=0.62  1.94=0.62  2=2.1 )\n\n# Upper register: nine cream strokes, gently taller toward the centre.\n\"upper-cream\" rect  2.65 ->y  0.30 ->w  0xf3e8cc solid ->fill\n9 '( fc 6.4 * ->x  \"four-beats\" track-ref 2 loop-time fc abs -0.25 * 1 + value* ->h ) array ;\n\n# Eight vermilion strokes interleaved in the upper register.\n\"upper-vermilion\" rect  2.65 ->y  0.22 ->w  0xe34227 solid ->fill\n8 '( fc 5.6 * ->x  \"four-beats\" track-ref 2 loop-time fc abs -0.25 * 1 + value* ->h ) array ;\n\n# Central register answers the top one beat later, retaining its heavier weight.\n\"middle-vermilion\" rect  0 ->y  0.38 ->w  0xe34227 solid ->fill\n9 '( fc 6.4 * ->x  \"four-beats\" track-ref 2 loop-time 0.5 delay-time fc abs -0.30 * 1.18 + value* ->h ) array ;\n\n# Central cream strokes share the middle row's one-beat delay.\n\"middle-cream\" rect  0 ->y  0.26 ->w  0xf3e8cc solid ->fill\n8 '( fc 5.6 * ->x  \"four-beats\" track-ref 2 loop-time 0.5 delay-time fc abs -0.30 * 1.18 + value* ->h ) array ;\n\n# Lower register answers another beat later: two beats behind the top.\n\"lower-cream\" rect  -2.65 ->y  0.30 ->w  0xf3e8cc solid ->fill\n9 '( fc 6.4 * ->x  \"four-beats\" track-ref 2 loop-time 1 delay-time fc abs -0.25 * 1 + value* ->h ) array ;\n\n# Lower vermilion strokes share the bottom row's two-beat delay.\n\"lower-vermilion\" rect  -2.65 ->y  0.22 ->w  0xe34227 solid ->fill\n8 '( fc 5.6 * ->x  \"four-beats\" track-ref 2 loop-time 1 delay-time fc abs -0.25 * 1 + value* ->h ) array ;\n"} "default_property" "rectSL" "preamble" "" "attic" "" "autorun" true "nested" #{} "ai4_chat_running" false "ai4_chat_history" #afield/file "rectsl_source_ai4_chat_history_.md"}} {"id" "root" "properties" {"children" #{#afield/box "rectsl_window"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{} "fileManagerAccessHistory" []}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "me