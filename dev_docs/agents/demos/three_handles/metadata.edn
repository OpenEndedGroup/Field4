{"version" 2 "boxes" [{"id" "curve" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 - A curve you shape" "_tombstone" false "frame" #afield/rect [60.0 60.0 420.0 136.0] "code" #afield/file-inline {"path" "curve_code_.kt" "inline" "/*\nDrag the four yellow points. The curve, its control polygon and the length at its end\nfollow every move, because each drag calls draw() again with the point where it was put.\n*/\nval points = mutableListOf(vec(-60, 0, 0), vec(-30, 60, 30), vec(30, -50, -30), vec(60, 20, 0))\n\nfun draw() {\n    three(name = \"curve\", height = 480) {\n        val curve = fline {\n            moveTo(points[0])\n            cubicTo(points[1], points[2], points[3])\n        }\n        val polygon = fline {\n            moveTo(points[0])\n            lineTo(points[1])\n            lineTo(points[2])\n            lineTo(points[3])\n            color = vec(1.0, 1.0, 1.0, 0.3)\n        }\n        lines([curve, polygon])\n        val end = points[3]\n        label(vec(end.x, end.y + 14, end.z), \"%.1f long\".format(curve.length()), style = \"tag\")\n        points.forEachIndexed { i, p ->\n            handle(\"p$i\", at = p, label = \"p$i\") { drag ->\n                points[i] = drag.position\n                draw()\n            }\n        }\n    }\n}\ndraw()\n"} "preamble" "" "nested" #{}}} {"id" "slab" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 - A slab and a post" "_tombstone" false "frame" #afield/rect [60.0 720.0 420.0 136.0] "code" #afield/file-inline {"path" "slab_code_.kt" "inline" "/*\nThe blue handle runs on a vertical rail (axis = y): it sets the slab's height. The orange\none slides only across the slab's top (normal = y), carrying the post with it. Field holds\neach handle to its line or plane before the callback sees the position.\n*/\nvar height = 20.0\nvar post = vec(20, 0, 10)\n\nfun draw() {\n    three(name = \"slab\", height = 480) {\n        mesh(\n            boxMesh(120, height, 60).translated(0.0, height / 2, 0.0),\n            id = \"slab\",\n            wireframe = false,\n            material = ThreeSurfaceMaterial(color = floatArrayOf(0.85f, 0.55f, 0.3f)),\n        )\n        mesh(\n            boxMesh(6, 40, 6).translated(post.x.toDouble(), height + 20, post.z.toDouble()),\n            id = \"post\",\n            wireframe = false,\n        )\n        handle(\n            \"height\",\n            at = vec(-60.0, height, 30.0),\n            label = \"height %.0f\".format(height),\n            axis = vec(0, 1, 0),\n            color = \"#4fc3f7\",\n        ) { drag ->\n            height = maxOf(2.0, drag.position.y.toDouble())\n            draw()\n        }\n        handle(\n            \"post\",\n            at = vec(post.x.toDouble(), height, post.z.toDouble()),\n            label = \"post\",\n            normal = vec(0, 1, 0),\n            color = \"#ff8a65\",\n        ) { drag ->\n            post = drag.position\n            draw()\n        }\n    }\n}\ndraw()\n"} "preamble" "" "nested" #{}}} {"id" "root" "properties" {"children" #{#afield/box "curve" #afield/box "slab"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_control