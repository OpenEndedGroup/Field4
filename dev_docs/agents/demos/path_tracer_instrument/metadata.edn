{"version" 2 "boxes" [{"id" "pt_renderer" "properties" {"children" #{#afield/box "pt_tracer"} "parents" #{#afield/box "root"} "name" "path tracing renderer" "_tombstone" false "frame" #afield/rect [40.0 40.0 240.0 60.0] "code" #afield/file-inline {"path" "pt_renderer_code_.kt" "inline" "// The window and the Vulkan renderer every other box in this document inherits.\n// `once.renderer` means re-running this box does not build a second window.\nimport afield.four.util.Options\nprop<Window>(window)\nprop<Renderer>(renderer)\nOptions.enableHDR = false\nonce.renderer {\n    window = Window(\"Field · Path tracer instrument\")\n    Renderer(window)\n}\nstart(renderer::run)\n"} "preamble" "" "nested" #{}}} {"id" "pt_tracer" "properties" {"children" #{#afield/box "pt_instrument" #afield/box "pt_plot" #afield/box "pt_swap" #afield/box "pt_restore"} "parents" #{#afield/box "root" #afield/box "pt_renderer"} "name" "1 - The tracer, with a log" "_tombstone" false "frame" #afield/rect [40.0 180.0 380.0 92.0] "code" #afield/file-inline {"path" "pt_tracer_code_.kt" "inline" "// The shipped materials scene at 640x360, plus the one new line: a convergence log.\n//\n// `recordConvergence()` attaches a log the tracer appends to from inside its own `render`, so\n// it costs no frames. This replaces the shape four scratch boxes were written in last night --\n// `frames { repeat(180) { frame() } }` with a `println` inside -- which spends 180 real frames\n// to learn what the log already knows.\nimport afield.four.fabricated.*\nimport afield.four.modules.fromContext\nimport java.io.File\n\nval renderer: Renderer = fromContext()\nprop<PathTracingRenderer>(tracer)\nprop<PathTraceConvergence>(log)\n\ntracer = PathTraceDemo.install(renderer,\n    File(\"public/docs/assets/fabricate_demo/venice_sunset_1k.exr\").absolutePath)\ntracer.samplesPerFrame = 1\ntracer.maxBounces = 5\ntracer.indirectClamp = 10f\ntracer.exposure = 1.5f\ntracer.blitToScreen()\n\nlog = tracer.recordConvergence()\nprintln(\"${tracer.backend}: ${tracer.triangleCount} triangles, ${tracer.width} x ${tracer.height}\")\n"} "preamble" "" "nested" #{}}} {"id" "pt_instrument" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "pt_tracer"} "name" "2 - The instrument, in one line" "_tombstone" false "frame" #afield/rect [40.0 360.0 380.0 92.0] "code" #afield/file-inline {"path" "pt_instrument_code_.kt" "inline" "// This is the whole instrument. One line.\n//\n// Until tonight it produced\n//   PathTracingRenderer afield.four.fabricated.PathTracingRenderer@19266ca3\n// and nothing else -- 376 bytes, ~330 of them the wrapper div. `PathTracingRenderer` is not a\n// data class and had no value printer registered, so `ValueVisualizer` fell all the way through\n// to `formatFallbackObject`, which is a class name and a `toString()`. Every one of the 26\n// `afield.four` types the tracer is built out of -- `Renderer`, `Camera`, `ComputeModulePointer`,\n// `RenderToTexture`, `VulkanBuffer` -- has had a printer since it was written.\n//\n// Re-run this box at any time; it reads the live tracer.\n//\n// The row to read is `up`. This scene's camera declares an up of (0, 1, 0), and the tracer\n// builds its own as `right x forward`, which on this camera is 11.94 degrees away -- so the\n// declared vector is not the one the image is made with. Two of last night's four scratch boxes\n// were printing `camera.up` and its three components as `toRawBits()`, hunting exactly this, and\n// no property tree could have shown it to them: the value is a local inside a private method.\n// The row only appears when the two disagree.\nimport afield.four.fabricated.PathTracingRenderer\n\nprop<PathTracingRenderer>(tracer)\ndisplay(\"output\", tracer)\n"} "preamble" "" "nested" #{}}} {"id" "pt_plot" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "pt_tracer"} "name" "3 - The convergence curve" "_tombstone" false "frame" #afield/rect [800.0 360.0 380.0 92.0] "code" #afield/file-inline {"path" "pt_plot_code_.kt" "inline" "// Samples against wall seconds, with a labelled dashed rule wherever accumulation\n// restarted and why. Run box 3 or 4 first and re-run this to see a mark appear.\n//\n// This is one call to `showSignals`, the house terse-plot helper. There is no new plotting\n// code anywhere in this feature: `showSignals` already takes named series, a shared x, and\n// `marks` drawn as full-height dashed rules carrying their label into the legend.\nimport afield.four.fabricated.*\n\nprop<PathTracingRenderer>(tracer)\nprop<PathTraceConvergence>(log)\n\nprintln(log)\nprintln(\"resets so far: \" + log.resetMarks())\nshowConvergence(log)\n"} "preamble" "" "nested" #{}}} {"id" "pt_swap" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "pt_tracer"} "name" "4 - Swap the integrator, live" "_tombstone" false "frame" #afield/rect [40.0 680.0 380.0 92.0] "code" #afield/file-inline {"path" "pt_swap_code_.kt" "inline" "// Three calls, three different answers, and that is the whole point of the type.\nimport afield.four.fabricated.*\n\nprop<PathTracingRenderer>(tracer)\n\n// 1. No argument offers the packaged integrator -- which is exactly what is already\n//    running. UNCHANGED. `ComputeModulePointer.reload` answers a bare `false` here, the\n//    same `false` it answers for a compile failure, so a `check(...)` around it throws on\n//    a no-op. That is why this returns three outcomes instead of a boolean.\nprintln(tracer.reloadIntegrator())\n\n// 2. A source that does not compile. FAILED, with the compiler's own messages, and the\n//    last working pipeline keeps rendering -- watch the window: the image does not blink.\nprintln(tracer.reloadIntegrator(\"#version 460\\nvoid main() { this is not glsl }\"))\n\n// 3. A real swap: direct light only. One line changes, but the whole ~30 KB integrator is\n//    recompiled and hot-swapped under a running camera. `integratorSource()` hands you the\n//    packaged source with this device's HARDWARE_QUERY define already applied -- the step\n//    that used to exist only at two private call sites, in no document and no API.\nval directOnly = tracer.integratorSource()\n    .replace(\"return vec4(radiance+indirect,1);\", \"return vec4(radiance,1);\")\nprintln(tracer.reloadIntegrator(directOnly))\n\n// The gold sphere loses the bounce light under its equator and goes black; the blue one\n// loses its warm floor bounce. The camera has not moved by a single bit.\nprintln(\"reset: '\" + tracer.lastResetReason + \"' generation=\" + tracer.resetGeneration)\n"} "preamble" "" "nested" #{}}} {"id" "pt_restore" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "pt_tracer"} "name" "5 - Put the integrator back" "_tombstone" false "frame" #afield/rect [40.0 1020.0 380.0 92.0] "code" #afield/file-inline {"path" "pt_restore_code_.kt" "inline" "// The same no-argument call that answered UNCHANGED in box 3 now RELOADS, because the live\n// pipeline is the patched one. Nothing about the tracer had to be rebuilt to get here: same\n// scene, same environment, same accumulation buffers, same camera.\nimport afield.four.fabricated.*\n\nprop<PathTracingRenderer>(tracer)\n\nprintln(tracer.reloadIntegrator())\nprintln(\"reset: '\" + tracer.lastResetReason + \"' generation=\" + tracer.resetGeneration)\n\n// And the instrument again, so you can read the generation count going up and the reason\n// changing. Re-run box 2 to see the reset land on the convergence curve as a labelled rule.\ndisplay(\"output\", tracer)\n"} "preamble" "" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isDatalogRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}