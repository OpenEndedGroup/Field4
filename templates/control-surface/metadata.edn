{"version" 2 "boxes" [{"id" "tpl_surface" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "control surface" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 160.0] "code" #afield/file-inline {"path" "tpl_surface_code_.kt" "inline" "// A performer's surface: a logarithmic slider, a bipolar one, a momentary gate and a meter.\n// Run it, then read `cutoff`, `pan` and `gate` from the code below it, or point the meter's\n// `source` at a number of your own.\nvar cutoff = 1000.0\nvar pan = 0.0\nvar gate = false\n\nval start = System.nanoTime()\nfun level() = 0.5 + 0.48 * Math.sin((System.nanoTime() - start) / 1e9 * 2.2)\n\ncontrolGroup(\"surface\") {\n    // Equal travel is an equal ratio, so 1 kHz sits near the middle of 20 Hz-20 kHz.\n    slider(\"cutoff\", min = 20.0, max = 20000.0, initialValue = cutoff, law = ControlLaw.LOGARITHMIC) { cutoff = it }\n    // Dead centre is exactly mid-travel.\n    slider(\"pan\", min = -1.0, max = 1.0, initialValue = pan, law = ControlLaw.BIPOLAR) { pan = it }\n    // Down while held, up on release, even when the pointer leaves the button.\n    button(\"gate\") { down -> gate = down }\n    meter(\"level\", min = 0.0, max = 1.0, source = { level() })\n}\ndisplayOpen(\"surface\")\n"} "metadata" #afield/file-inline {"path" "tpl_surface_metadata_.yaml" "inline" "doc: |\n  A logarithmic slider, a bipolar slider, a momentary gate and a meter, in one control\n  group to read from your own code.\n"} "preamble" ""}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s