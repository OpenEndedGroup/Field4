{"version" 2 "boxes" [{"id" "tpl_csound_pluck" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "tpl_csound_root"} "name" "pluck" "_tombstone" false "frame" #afield/rect [80.0 200.0 340.0 260.0] "code_language" "Csound" "code" #afield/file-inline {"path" "tpl_csound_pluck_code_.kt" "inline" "<CsoundSynthesizer>\n<CsOptions>\n-m0\n</CsOptions>\n<CsInstruments>\n; sr, ksmps, nchnls and 0dbfs come from Field: 48000, 32, 2 and 1.\nchn_k \"cutoff\", 1, 3, 2400, 200, 8000   ; written by Field, read here\nmassign 0, \"Key\"                        ; MIDI notes, from any channel\n\ninstr Pluck                             ; p4 MIDI note, p5 level in dBFS\n  icps  =         cpsmidinn(p4)\n  asig  pluck     ampdbfs(p5), icps, icps, 0, 1\n  kcut  chnget    \"cutoff\"\n  kcut  port      kcut, 0.02\n  asig  butterlp  asig, kcut\n  aenv  linsegr   1, p3, 1, 0.3, 0\n  asig  =         asig * aenv\n  chnmix    asig * 0.25, \"reverb\"\n  outs      asig, asig\nendin\n\ninstr Key\n  icps  cpsmidi\n  iamp  ampmidi   0.3\n  asig  pluck     iamp, icps, icps, 0, 1\n  aenv  madsr     0.005, 0.1, 0.6, 0.4\n  chnmix    asig * aenv * 0.25, \"reverb\"\n  outs      asig * aenv, asig * aenv\nendin\n\ninstr Reverb\n  ain     chnget    \"reverb\"\n  aL, aR  reverbsc  ain, ain, 0.85, 10000\n  outs      aL, aR\n  chnclear  \"reverb\"\nendin\n</CsInstruments>\n<CsScore>\ni \"Reverb\" 0 z\ni \"Pluck\"  0    0.5  57  -12\ni .        +    .    60  .\ni .        +    .    64  .\ni .        +    1.5  67  -9\n; Alt+Enter one of these while the box plays:\ni \"Pluck\"  0    1    69  -9\ni \"Pluck\"  0    2    45  -6\n</CsScore>\n</CsoundSynthesizer>\n"}}} {"id" "tpl_csound_root" "properties" {"children" #{#afield/box "tpl_csound_pluck"} "parents" #{#afield/box "root"} "name" "Csound root · boxes under this are Csound" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 70.0] "mainLanguage" "csound" "code" #afield/file-inline {"path" "tpl_csound_root_code_.kt" "inline" "// This box stays Kotlin. Its `mainLanguage` makes every box connected under it Csound.\nprintln(\"Csound root\")\n"} "metadata" #afield/file-inline {"path" "tpl_csound_root_metadata_.yaml" "inline" "doc: |\n  A Csound root and one instrument under it: a plucked string with a reverb, played by\n  its score and by any MIDI keyboard. Launch it, then run a score line on its own.\n"} "preamble" ""}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isPostScriptRoot" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}