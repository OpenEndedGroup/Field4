{"version" 2 "boxes" [{"id" "tpl_lane" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "keyframe lane" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 200.0] "code" #afield/file-inline {"path" "tpl_lane_code_.kt" "inline" "// Launch this box to play the curve: the playhead sweeps it every four seconds. Edit the\n// curve while it plays; your edits are saved with the box. Boxes under this one read `lane`.\nprop<Double>(lane) = 0.0\nval curve = keyframes(name = \"lane\", defaults = [vec(0.0, 0.1), vec(1.0, 0.9), vec(2.5, 0.4), vec(4.0, 0.1)])\n\nlateinit var gauge: MeterHandle\ncontrolGroup(\"meter\") { gauge = meter(\"lane\") }\ndisplayOpen(\"meter\")\n\nval start = System.nanoTime()\nloop {\n    val t = ((System.nanoTime() - start) / 1e9) % 4.0\n    curve.setTime(t)\n    lane = curve.evaluateValueAt(t)\n    gauge.set(lane)\n}\n"} "metadata" #afield/file-inline {"path" "tpl_lane_metadata_.yaml" "inline" "doc: |\n  A hand-edited keyframe curve, played on a four-second loop into a meter and published\n  as `lane` to every box connected under it.\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeIn