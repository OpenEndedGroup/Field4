{"version" 2 "boxes" [{"id" "tpl_tour" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "tour" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 90.0] "code" #afield/file-inline {"path" "tpl_tour_code_.kt" "inline" "// A guided tour of the boxes connected beneath this one, top to bottom. Connect the boxes you\n// want to show under it, write a line about each in its notes, then run this box.\nval stops = children.sortedBy { it.frame.y }\n\nif (stops.isEmpty()) {\n    markdown(\"Connect the boxes to tour beneath this one, then run it again.\")\n} else {\n    val show = slideShow {\n        stops.forEachIndexed { i, stop ->\n            step(stop.name.ifBlank { \"Box ${i + 1}\" }) {\n                val links = when (i) {\n                    0 -> \"[[next]]\"\n                    stops.lastIndex -> \"[[back]] [[home:Start again]] [[finish]]\"\n                    else -> \"[[back]] [[next]]\"\n                }\n                markdownNote(\"## ${stop.name}\\n${stop.notes}\\n\\n$links\")\n                selectBox(stop)\n            }\n        }\n    }\n    runBlocking { show.start() }\n}\n"} "metadata" #afield/file-inline {"path" "tpl_tour_metadata_.yaml" "inline" "doc: |\n  A slideshow that tours the boxes connected beneath it, top to bottom, showing each\n  box's notes.\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isPostScriptRoot" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}