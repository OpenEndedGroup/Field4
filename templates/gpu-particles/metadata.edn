{"version" 2 "boxes" [{"id" "tpl_particles_compute" "properties" {"children" #{#afield/box "tpl_particles_draw"} "parents" #{#afield/box "root"} "name" "particles · compute" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 90.0] "code" #afield/file-inline {"path" "tpl_particles_compute_code_.kt" "inline" "// Launch the renderer, then this box, then the draw box under it. This box moves 100 000\n// particles on the GPU every frame and publishes their positions as `particlePositions`.\nvar module = computeModuleHere {}\nvar m = ComputeMesh()\nmodule += \"step\" to m\n// Keyed by this box's id, so a second copy under the same renderer adds to the first.\nrenderer += \"particles_\" + id.take(8) to module\n\nval N = 100000\nvar inData = defaultBuffer { size = N.vec4s }.buffer\nvar outData = defaultBuffer { size = N.vec4s }.buffer\nm.inData = { inData }\nm.outData = { outData }\nm.particleCount = { N }\nm.something = { (AnimationClock.nowSeconds() * 0.6).f }\nprop<FrameBufferGroup>(particlePositions) = outData\nm.x = (N + 63) / 64\nm.y = 1\nm.z = 1\n\nval seeded = kotlin.random.Random(0x4f1e1d)\ninData.write {\n    for (i in 0 until N) {\n        put(vec(seeded.nextDouble(), seeded.nextDouble(), seeded.nextDouble(), seeded.nextDouble()))\n    }\n}\n"} "compute" #afield/file-inline {"path" "tpl_particles_compute_compute_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\nlayout(local_size_x = 64) in;\n\nlayout(std430, buffer_reference) buffer inData {\n    vec4 a[];\n};\nlayout(std430, buffer_reference) buffer outData {\n    vec4 a[];\n};\n\nlayout(push_constant) uniform dat {\n    inData inData;\n    outData outData;\n    float something; // seconds, scaled by the box's speed\n    uint particleCount;\n} pc;\n\nvoid main() {\n    uint idx = gl_GlobalInvocationID.x;\n    if (idx >= pc.particleCount) return;\n    vec4 seed = pc.inData.a[idx]; // xy position, zw modulation and size\n    float phaseZ = pc.something * seed.z;\n    float phaseW = pc.something * seed.w;\n    vec2 moved = vec2(\n        seed.x * cos(phaseZ) + seed.y * sin(phaseW),\n        -seed.x * sin(phaseW) + seed.y * cos(phaseZ * 0.03)\n    );\n    pc.outData.a[idx] = vec4(moved, seed.zw);\n}\n"} "parentHint" "Connect under a renderer: select the renderer box, then this one, and press G. The renderer template makes one." "metadata" #afield/file-inline {"path" "tpl_particles_compute_metadata_.yaml" "inline" "doc: |\n  100 000 particles moved by a compute shader every frame, and a box beneath it that\n  draws them. Connect the compute box under a renderer.\n"} "preamble" ""}} {"id" "tpl_particles_draw" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "tpl_particles_compute"} "name" "particles · draw" "_tombstone" false "frame" #afield/rect [80.0 220.0 300.0 90.0] "code" #afield/file-inline {"path" "tpl_particles_draw_code_.kt" "inline" "// Draws the particles the box above publishes as `particlePositions`. Launch it after that box.\nvar module = moduleHere { primitiveType = triangles }\nvar m = Mesh()\nmodule += \"mesh\" to m\nrenderer += \"particles_draw_\" + id.take(8) to module\n\nval N = 100000\nm.inData = { particlePositions }\nm.aspectRatio = { window.width / window.height.toFloat() }\nm.set(N * 2 * 3, 0) {}\n"} "vertex" #afield/file-inline {"path" "tpl_particles_draw_vertex_.glsl" "inline" "#version 450\n#extension GL_EXT_buffer_reference : require\n\nlayout(std430, buffer_reference) buffer inData {\n    vec4 pos[];\n};\n\nlayout(location = 0) out vec2 tc;\n\nlayout(push_constant) uniform push {\n    inData inData;\n    float aspectRatio; // window width / height\n} pc;\n\n// Two triangles per particle, a unit square around its centre.\nconst vec3[6] part = vec3[6](vec3(0,0,0),vec3(1,0,0),vec3(1,1,0),vec3(0,0,0),vec3(1,1,0),vec3(0,1,0));\n\nvoid main() {\n    float scale = pc.inData.pos[gl_VertexIndex/6].w;\n    vec3 p = (part[gl_VertexIndex%6]-vec3(0.5,0.5,0))*scale;\n    p.xy += pc.inData.pos[gl_VertexIndex/6].xy*10.0;\n    p.xy *= vec2(1/pc.aspectRatio, 1);\n    gl_Position = vec4(p*0.04, 1);\n    tc = part[gl_VertexIndex%6].xy;\n}\n"} "fragment" #afield/file-inline {"path" "tpl_particles_draw_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\nlayout(location = 0) in vec2 tc;\n\n// A soft ring per particle.\nvoid main() {\n    float d = max(0.0, 0.5-length(tc-vec2(0.5)));\n    float w = fwidth(d);\n    d = smoothstep(0.1, 0.1+w, d)*smoothstep(0.14+w, 0.14, d);\n    uFragColor = vec4(1.0, 0.8, 0.4, d*0.2);\n    if (d<0.01) discard;\n}\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isPostScriptRoot" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}