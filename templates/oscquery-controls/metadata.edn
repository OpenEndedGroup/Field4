{"version" 2 "boxes" [{"id" "tpl_oscq" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "OSCQuery controls" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 160.0] "code" #afield/file-inline {"path" "tpl_oscq_code_.kt" "inline" "import afield.io.osc.query.*\n\n/*\nField controls that are also OSCQuery parameters: TouchDesigner, Max, Chataigne and VDMX find\nthem as \"Field\" on the network, and setting one there moves the slider here. Every copy of this\nbox publishes under a path of its own.\n*/\nvar gain = 0.5\nvar mute = false\n\nval q = oscQuery(\"Field\")\nval path = \"/field_\" + id.take(6)\nq.controls(path) {\n    slider(\"gain\", 0.0, 1.0, initialValue = gain) { gain = it }\n    checkbox(\"mute\", mute) { mute = it }\n}\nmarkdown(\"Published under `$path`. Browse **http://localhost:${q.httpPort}/** for the namespace.\")\n"} "metadata" #afield/file-inline {"path" "tpl_oscq_metadata_.yaml" "inline" "doc: |\n  A slider and a checkbox that are also OSCQuery parameters, published on the network\n  under a path of this box's own.\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeIn