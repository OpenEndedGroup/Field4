{"version" 2 "boxes" [{"id" "tpl_listen" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "listen to the drawing" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 130.0] "code" #afield/file-inline {"path" "tpl_listen_code_.kt" "inline" "// Run this box, then draw a stroke anywhere on the drawing layer (Alt+D, then P). Each\n// finished stroke calls the handler; stopping the box removes it.\nvar strokes = 0\nnotation.onStroke { s ->\n    strokes++\n    val over = s.box?.name ?: \"the canvas\"\n    markdown(\"stroke $strokes: ${s.points.size} points, ${s.length.toInt()} long, over $over\")\n}\n"} "metadata" #afield/file-inline {"path" "tpl_listen_metadata_.yaml" "inline" "doc: |\n  A handler for strokes drawn by hand on the drawing layer: each finished stroke arrives\n  with its points, its length and the box it was drawn over.\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole" "isCsound