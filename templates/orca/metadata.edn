{"version" 2 "boxes" [{"id" "tpl_orca" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "ORCA" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 200.0] "code" #afield/file-inline {"path" "tpl_orca_code_.kt" "inline" "// Launch, then click the grid to type into ORCA. Space plays and pauses; Cmd-G lists every\n// operator. Ask AI4 (Cmd-4) to change the tune: it can read, write and command this ORCA.\nval synth = PatSynthBank()\nval o = orca(\n    rows = 12,\n    grid =\n        \"\"\"\n    #.ORCA.IN.FIELD.#\n    .\n    .2C8\n    D2.8TCDEGAGED\n    .:04\n    .\n    D8\n    .:12C\n\"\"\",\n)\no.onNote {\n    synth.play(it)\n    markdown(\"heard\", \"`${it.note}${it.octave}` on channel ${it.channel}, MIDI ${it.midi}\")\n}\ndisplayOpen(\"heard\")\n// Tool names are document-wide, so each copy names its own after its box.\no.exposeTools(name = \"orca_\" + id.take(8))\n\nsynth\n"} "metadata" #afield/file-inline {"path" "tpl_orca_metadata_.yaml" "inline" "doc: |\n  An ORCA livecoding grid in a box output, playing through a PatSynthBank, with AI4\n  tools to read and write its grid.\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi