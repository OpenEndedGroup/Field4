{"version" 2 "boxes" [{"id" "first_steps_drawing" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "First steps · a moving drawing" "_tombstone" false "frame" #afield/rect [70.0 70.0 350.0 100.0] "code" #afield/file-inline {"path" "first_steps_drawing_code_.kt" "inline" "// Launch: Alt+Up. Stop: Alt+Down. On a Mac, Alt is Option.\nvar petals = 5\npetals = 5 // Change this 5 to 8, then press Alt+Enter on this line while the drawing runs.\nprintln(petals) // Field shows this value beside the code.\n// Phase advances once per Runloop iteration; this is a frame-based speed.\nvar phaseStep = 0.045\nphaseStep = 0.045 // Change this value and Alt+Enter this line to change the running speed.\nvar phase = 0.0\n\nloop {\n    phase += phaseStep\n    // Each curve is a little further into the wave: together they make a ribbon.\n    val ribbon =\n        (0..23).map { layer ->\n            val depth = layer / 23.0\n            fline {\n                breakNext()\n                for (i in 0..180) {\n                    val angle = i * Math.PI / 90.0\n                    val wave = Math.sin(petals * angle + phase - 4.0 * depth)\n                    val radius = 35.0 + 90.0 * depth + 18.0 * wave\n                    val twist = angle + 0.4 * Math.sin(phase + 2.0 * depth)\n                    val x = 160.0 + radius * Math.cos(twist)\n                    val y = 160.0 + radius * Math.sin(twist)\n                    lineTo(x, y)\n                }\n                thickness = 0.8\n                color = vec(0.55 + 0.4 * depth, 0.85 + 0.15 * depth, 1.0, 0.8)\n            }\n        }\n    lines(ribbon, w = 320.0, h = 320.0)\n}\n\n// Field autosaves edits. Stop, close this tab, then reopen your copy\n// from Welcome: your edited code is there; launch it to animate again.\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}