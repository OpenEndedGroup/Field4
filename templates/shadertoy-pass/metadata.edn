{"version" 2 "boxes" [{"id" "tpl_shadertoy" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "ShaderToy pass" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 90.0] "code" #afield/file-inline {"path" "tpl_shadertoy_code_.kt" "inline" "/*\nA ShaderToy Image pass drawn into the window of the renderer above. The program is this box's\nfragment property: mainImage gets fragCoord in pixels (y up) and the ShaderToy uniforms\n(iResolution, iTime, iMouse, iDate, iChannel0..3). Edit it and press Alt+Enter to recompile; a\nmistake is marked on its own line and the last good program keeps running. ShaderToy code\npasted from the web works as is. Copies share one canvas, so launching one shows its picture.\n*/\nval canvas = shadertoyCanvas()\ncanvas += shadertoyHere {\n    +canvas.rtt\n}\n"} "fragment" #afield/file-inline {"path" "tpl_shadertoy_fragment_.glsl" "inline" "{{ shadertoy.image }}\nvoid mainImage(out vec4 fragColor, in vec2 fragCoord) {\n    vec2 uv = (2.0 * fragCoord - iResolution.xy) / iResolution.y;\n    float t = iTime * 0.7;\n    vec3 col = vec3(0.015, 0.018, 0.018);\n    float grid = mod(floor((uv.x + 2.0) * 9.0) + floor((uv.y + 2.0) * 9.0), 2.0);\n    if (grid < 0.5) col = vec3(0.025, 0.03, 0.03);\n    for (int i = 0; i < 8; i++) {\n        float fi = float(i);\n        vec2 c = vec2(cos(t + fi * 1.35), sin(t * 0.8 + fi * 1.1)) * 0.42;\n        float r = 0.17 + 0.035 * step(0.5, mod(fi, 2.0));\n        float ring = 1.0 - step(0.018, abs(length(uv - c) - r));\n        float dotMask = 1.0 - step(0.035, length(uv - c));\n        if (ring > 0.5) {\n            if (mod(fi, 3.0) < 1.0) col = vec3(0.16, 0.72, 0.62);\n            else if (mod(fi, 3.0) < 2.0) col = vec3(0.95, 0.74, 0.25);\n            else col = vec3(0.35, 0.50, 0.95);\n        }\n        if (dotMask > 0.5) col = vec3(0.92, 0.96, 0.90);\n    }\n    fragColor = vec4(col, 1.0);\n}\n"} "parentHint" "Connect under a renderer: select the renderer box, then this one, and press G. The renderer template makes one." "metadata" #afield/file-inline {"path" "tpl_shadertoy_metadata_.yaml" "inline" "doc: |\n  A ShaderToy-style Image pass, mainImage and the ShaderToy uniforms, drawn into the\n  window of the renderer above it.\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isPostScriptRoot" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}