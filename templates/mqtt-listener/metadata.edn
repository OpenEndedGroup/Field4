{"version" 2 "boxes" [{"id" "tpl_mqtt" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "MQTT listener" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 160.0] "code" #afield/file-inline {"path" "tpl_mqtt_code_.kt" "inline" "import afield.io.mqtt.*\n\n// The last eight messages under `field/#`, newest first, from the MQTT broker: an embedded one\n// unless AFIELD_MQTT_URL names another. Run this box; the publish at the end sends one to see.\nval recent = ArrayDeque<String>()\nmqtt.subscribe(\"field/#\") { topic, message ->\n    recent.addFirst(\"**$topic** = ${message.text}\")\n    while (recent.size > 8) recent.removeLast()\n    markdown(recent.joinToString(\"\\n\\n\"))\n}\n\nmqtt.publish(\"field/hello\", \"hello from $name\")\n"} "metadata" #afield/file-inline {"path" "tpl_mqtt_metadata_.yaml" "inline" "doc: |\n  The latest messages on an MQTT topic, from Field's embedded broker or another one.\n"} "preamble" ""}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_runni