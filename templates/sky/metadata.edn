{"version" 2 "boxes" [{"id" "tpl_sky" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "sky" "_tombstone" false "frame" #afield/rect [80.0 80.0 300.0 90.0] "code" #afield/file-inline {"path" "tpl_sky_code_.kt" "inline" "// A sky behind whatever the renderer above draws: single scattering through Earth's atmosphere.\n// The physics is `#include \"sky/atmosphere.glsl\"`; the camera and tone mapping are in this box's\n// fragment property. Launch it under a renderer and drag the sliders.\nimport afield.graphics.sky.SkyView\n\nval view = SkyView(sunElevation = 30.0, altitude = 3.5, pitch = 10.0, exposure = 2.0)\nval sky = moduleHere {\n    depthTest = false\n    depthWrite = false\n    blend = false\n}\nval quad = fullscreenTriangle(sky)\nsky += \"quad\" to quad\n// Keyed by this box's id, so a second copy does not replace the first.\nval key = \"sky_\" + id.take(8)\nrenderer += key to sky\n// Draw first, behind everything else under this renderer, however late this box launches: the\n// other modules move after the sky, keeping their own order.\nval modules = renderer.renderList.modules\nval drawnAfter = modules.filterKeys { it != key }\ndrawnAfter.keys.forEach(modules::remove)\nmodules.putAll(drawnAfter)\nquad.viewport = {\n    vec(window.width.toFloat(), window.height.toFloat(), view.altitude, Math.toRadians(view.sunElevation))\n}\nquad.view = {\n    vec(Math.toRadians(view.sunAzimuth), Math.toRadians(view.pitch), view.exposure, Math.toRadians(view.fieldOfView))\n}\n\ncontrolGroup(\"Sky\") {\n    slider(\"Sun elevation (degrees)\", min = -12.0, max = 90.0, initialValue = view.sunElevation) {\n        view.sunElevation = it\n    }\n    slider(\"Sun azimuth (degrees)\", min = -180.0, max = 180.0, initialValue = view.sunAzimuth) { view.sunAzimuth = it }\n    slider(\"Altitude (log10 km)\", min = -3.0, max = 4.5, initialValue = Math.log10(view.altitude)) {\n        view.altitude = Math.pow(10.0, it)\n    }\n    slider(\"Camera pitch (degrees)\", min = -90.0, max = 90.0, initialValue = view.pitch) { view.pitch = it }\n    slider(\"Exposure\", min = 0.1, max = 40.0, initialValue = view.exposure) { view.exposure = it }\n}\ndisplayOpen(\"Sky\")\n"} "vertex" #afield/file-inline {"path" "tpl_sky_vertex_.glsl" "inline" "#version 450\n// One triangle that covers the whole window; positions come from the vertex index.\nvoid main() {\n    vec2 p = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);\n    gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n}\n"} "fragment" #afield/file-inline {"path" "tpl_sky_fragment_.glsl" "inline" "#version 450\n#include \"sky/atmosphere.glsl\"\n\nlayout(location = 0) out vec4 color;\n\nlayout(push_constant) uniform pcs {\n    vec4 viewport; // width, height, altitude (km), sun elevation (radians)\n    vec4 view; // sun azimuth, camera pitch, exposure, vertical field of view (radians)\n} pc;\n\nvoid main() {\n    Atmosphere a = earthAtmosphere();\n    // A pinhole camera at the given altitude, looking along -z and pitched up by view.y.\n    vec2 uv = (gl_FragCoord.xy - 0.5 * pc.viewport.xy) / pc.viewport.y;\n    uv.y = -uv.y;\n    float pitch = pc.view.y;\n    vec3 forward = vec3(0.0, sin(pitch), -cos(pitch));\n    vec3 right = vec3(1.0, 0.0, 0.0);\n    vec3 up = cross(right, forward);\n    vec3 rd = normalize(forward + (uv.x * right + uv.y * up) * 2.0 * tan(0.5 * pc.view.w));\n    vec3 ro = vec3(0.0, a.planetRadius + pc.viewport.z, 0.0);\n    float e = pc.viewport.w, az = pc.view.x;\n    vec3 sun = vec3(cos(e) * sin(az), sin(e), -cos(e) * cos(az));\n    vec3 L = skyRadiance(a, ro, rd, sun, vec3(20.0), 0.00465, 32, 8);\n    // Exposure, then a soft shoulder so the sun's disc saturates instead of clipping hue.\n    color = vec4(1.0 - exp(-L * pc.view.z), 1.0);\n}\n"} "parentHint" "Connect under a renderer: select the renderer box, then this one, and press G. The renderer template makes one." "metadata" #afield/file-inline {"path" "tpl_sky_metadata_.yaml" "inline" "doc: |\n  A physically based sky, live-codable, with sliders for the sun, altitude, pitch and\n  exposure. Connect it under a renderer.\n"} "preamble" ""}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "parentHint" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "panes" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "_controlMidi" "keyframeData" "keyframeInterpolants" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_panel" "ai4_continuation" "ai4_chat_running" "ai4_chat_suspension" "ai4_session" "ai4_garden" "fileManagerAccessHistory" "kitRole" "isCsoundRoot" "isPdRoot" "isDatalogRoot" "isClojureRoot" "isFieldMLRoot" "isForthRoot" "isLuaRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isPostScriptRoot" "isKotlinJsRoot" "aiStudy" "mainLanguage" "spreadsheet"]}