{"version" 2 "boxes" [{"id" "first_graphics_renderer" "properties" {"name" "1 · Launch the renderer" "frame" #afield/rect [70.0 70.0 350.0 100.0] "parents" #{#afield/box "root"} "children" #{#afield/box "first_graphics_triangle"} "code" #afield/file-inline {"path" "first_graphics_renderer_code_.kt" "inline" "// Launch this box first: Alt+Up (Option+Up on macOS).\nprop<Window>(window)\nprop<Renderer>(renderer)\nonce.renderer {\n    window = Window(\"Field · first native graphics\")\n    Renderer(window)\n}\nstart(renderer::run)\n"}}} {"id" "first_graphics_triangle" "properties" {"name" "2 · Launch the triangle" "frame" #afield/rect [70.0 270.0 350.0 100.0] "parents" #{#afield/box "first_graphics_renderer"} "children" #{} "code" #afield/file-inline {"path" "first_graphics_triangle_code_.kt" "inline" "// this is almost as simple as drawing a triangle gets here. First a shader:\nvar module = moduleHere {\n    primitiveType = triangle_strip\n}\n\n    // then a mesh\nvar m  = Mesh()\n\n    // then some connection\nmodule += m named \"my mesh\"\nrenderer += module\n\n/*\nThis gets us everything we need to start rendering things. In particular, we get a vertex shader:\n\n[[property vertex]]\n*/\n\n    // and a fragment shader:\n\n/*\n[[property fragment]]\n*/\n\n// you can edit these by switching to these properties in the editor `f1` or `ctrl-P`.\n\n// and then 3 vertices and one triangle strip consisting of 3 indices\nm.set(3, 3) {\n    pos.add(0,0,0, 0.5,0,0, 0.5,0.5,0)\n\n    // for a flourish, we have some color as well\n    3 {\n        col.add(0,it/3.0,1-it/3.0,1)\n    }\n    tri.add(0,1,2)\n}\n"} "vertex" #afield/file-inline {"path" "first_graphics_triangle_vertex_.glsl" "inline" "#version 450\nlayout (location = 0) in vec3 pos;\n\nlayout (location = 1) in vec4 col;\nlayout (location = 0) out vec4 fcol;\n\n// pos is already in clip space; col is passed to the fragment shader.\n\nvoid main()\n{\n\n    fcol = col;\n    gl_Position = vec4(pos, 1);\n}\n"} "fragment" #afield/file-inline {"path" "first_graphics_triangle_fragment_.glsl" "inline" "#version 450\nlayout(location = 0) out vec4 uFragColor;\n\nlayout(location = 0) in vec4 fcol;\nvoid main()\n{\n    uFragColor = vec4(1.0, 0.8, 0.4, 1.0)* fcol;\n}"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "drawing" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "ai4_chat_history" "ai4_chat_running" "fileManagerAccessHistory"]}