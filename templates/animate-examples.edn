  {:id "processing-bouncing-ball"
   :name "Bouncing Ball"
   :parent "animate-processing"
   :code "// Setup - runs once
var x = 400f
var y = 300f
var vx = 3f
var vy = 2f
val radius = 25f

p.stroke(255f)
p.strokeWeight(2f)

println(\"Ball animation starting\")

// Animation - runs every frame
animate {
    p.background(0f)
    
    // Update position
    x += vx
    y += vy
    
    // Bounce off edges
    if (x - radius < 0 || x + radius > p.width) vx *= -1
    if (y - radius < 0 || y + radius > p.height) vy *= -1
    
    // Draw ball
    p.fill(255f, 200f, 100f)
    p.ellipse(x, y, radius * 2, radius * 2)
    
    // Draw trail
    p.fill(255f, 200f, 100f, 50f)
    p.noStroke()
    p.ellipse(x, y, radius * 4, radius * 4)
    p.stroke(255f)
}"
   :x 120
   :y 470
   :w 400
   :h 400}
  
  {:id "processing-multiple-circles"
   :name "Multiple Circles"
   :parent "animate-processing"
   :code "// Setup - create circle data
val circles = (0 until 5).map { i ->
    mapOf(
        \"x\" to (i + 1) * p.width / 6f,
        \"y\" to p.height / 2f,
        \"phase\" to i * 0.5f,
        \"r\" to 255f * i / 5,
        \"g\" to 255f - 255f * i / 5,
        \"b\" to 100f
    )
}

p.strokeWeight(2f)
p.stroke(255f)

// Animation
animate {
    p.background(0f)
    
    circles.forEach { circle ->
        val x = circle[\"x\"] as Float
        val baseY = circle[\"y\"] as Float
        val phase = circle[\"phase\"] as Float
        val y = baseY + 80 * kotlin.math.sin(p.frameCount * 0.03f + phase).toFloat()
        
        p.fill(
            circle[\"r\"] as Float,
            circle[\"g\"] as Float,
            circle[\"b\"] as Float
        )
        p.ellipse(x, y, 50f, 50f)
    }
}"
   :x 540
   :y 470
   :w 400
   :h 350}
  
  {:id "processing-mouse-trail"
   :name "Mouse Trail"
   :parent "animate-processing"
   :code "// Setup
val trailLength = 20
val trail = mutableListOf<Pair<Float, Float>>()

p.strokeWeight(1f)

// Animation
animate {
    p.background(0f)
    
    // Add current mouse position
    trail.add(Pair(p.mouseX.toFloat(), p.mouseY.toFloat()))
    
    // Keep only recent positions
    if (trail.size > trailLength) {
        trail.removeAt(0)
    }
    
    // Draw trail
    trail.forEachIndexed { i, (x, y) ->
        val alpha = 255f * (i + 1) / trail.size
        val size = 10f + 20f * (i + 1) / trail.size
        
        p.fill(255f, 100f, 200f, alpha)
        p.noStroke()
        p.ellipse(x, y, size, size)
    }
}"
   :x 960
   :y 470
   :w 400
   :h 300}
  
  {:id "notes"
   :name "Notes"
   :parent "animate-example-root"
   :code "/**
 * ANIMATE BLOCK SYNTAX
 * 
 * The animate { } block provides a clear way to separate
 * setup code from animation code:
 * 
 * 1. Code OUTSIDE animate runs ONCE (setup)
 * 2. Code INSIDE animate runs EVERY FRAME
 * 
 * Benefits:
 * - More readable and intentional
 * - Clear separation of concerns
 * - Standard pattern across examples
 * 
 * See ANIMATE_BLOCK_SYNTAX.md for more details.
 */"
   :x 500
   :y 170
   :w 450
   :h 200}]}
