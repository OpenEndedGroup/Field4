{:boxes
 [{:id "animate-example-root"
   :name "Animate Example"
   :x 100
   :y 100
   :w 250
   :h 50
   :doc "Examples demonstrating the animate { } block syntax"}
  
  {:id "animate-simple"
   :name "Simple Animate"
   :parent "animate-example-root"
   :code "// Setup code - runs once
println(\"Setting up animation...\")
val speed = 2f

// Animation code - runs every frame
animate {
    println(\"Frame: $frameNumber\")
    
    // Stop after 60 frames
    if (frameNumber > 60) {
        end()
    }
}"
   :x 120
   :y 170
   :w 350
   :h 200}
  
  {:id "notes"
   :name "Notes"
   :parent "animate-example-root"
   :code "/**
 * ANIMATE BLOCK SYNTAX
 * 
 * The animate { } block provides a clear way to separate
 * setup code from animation code:
 * 
 * 1. Code OUTSIDE animate runs ONCE (setup)
 * 2. Code INSIDE animate runs EVERY FRAME
 * 
 * Benefits:
 * - More readable and intentional
 * - Clear separation of concerns
 * - Standard pattern across examples
 * 
 * See dev_docs/animation/ANIMATE_BLOCK_SYNTAX.md for more details.
 */"
   :x 500
   :y 170
   :w 450
   :h 200}]}
