{"version" 2 "boxes" [{"id" "tpl_midi" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "MIDI learn" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 200.0] "code" #afield/file-inline {"path" "tpl_midi_code_.kt" "inline" "// Press MIDI learn, touch a control, then turn a knob: the two are bound, and the binding is\n// saved with the box. Launch to listen to the first hardware MIDI input; stop to close it.\nvar cutoff = 1000.0\nvar bright = false\n\ncontrolGroup(\"synth\") {\n    slider(\"cutoff\", 20.0, 20000.0, initialValue = cutoff, law = ControlLaw.LOGARITHMIC) { cutoff = it }\n    checkbox(\"bright\", bright) { bright = it }\n    midiLearnButton()\n}\nval midi = midiLearn(\"synth\")\n\nframes {\n    val device = MidiDevices.inputs().firstOrNull { !it.isSoftware }\n    val input = device?.let(MidiDevices::openInput)\n    input?.let(midi::attach)\n    println(device?.let { \"listening to ${it.name}\" } ?: \"no MIDI input on this machine\")\n    try {\n        while (frame()) {}\n    } finally {\n        input?.close()\n    }\n}\n"} "metadata" #afield/file-inline {"path" "tpl_midi_metadata_.yaml" "inline" "doc: |\n  A control group with a MIDI learn button, listening to the first hardware MIDI input while it\n  runs. Bindings are saved with the box.\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot"