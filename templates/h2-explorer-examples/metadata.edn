{"version" 2 "boxes" [{"id" "d7d194dd-536f-44f3-9d5e-de58542baa7e" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "5 · an exception" "frame" #afield/rect [100.0 880.0 640.0 300.0] "nested" #{} "preamble" "" "code" #afield/file-inline {"path" "d7d194dd-536f-44f3-9d5e-de58542baa7e_code_.kt" "inline" "// `Throwable` is `java.lang`, and `.h2` refuses to reflect into platform packages -- a\n// `Thread` or a `ClassLoader` by property is a JVM field dump. So exceptions get an adapter:\n// type, message, the cause chain, and the stack as a scrollable list.\n//\n// Click `stack` and `causes`.\n\nval boom = runCatching {\n    try {\n        throw IllegalArgumentException(\"the inner reason\")\n    } catch (t: Throwable) {\n        throw IllegalStateException(\"the outer failure\", t)\n    }\n}.exceptionOrNull()!!\n\ndisplay(\"error\", boom.h2)\ndisplayOpen(\"error\")"}}} {"id" "9a3aaad6-0c2f-4851-9ef7-ae0fc6af4d00" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "6 · a Set, and the old behaviour" "frame" #afield/rect [780.0 880.0 640.0 300.0] "preamble" "" "nested" #{} "code" #afield/file-inline {"path" "9a3aaad6-0c2f-4851-9ef7-ae0fc6af4d00_code_.kt" "inline" "// The collection half of the gate used to be narrower than its own machinery: it admitted\n// `IntArray` but not `ByteArray`, `List` but not `Set`, while both the tree and the explorer\n// already knew how to draw all of them. Swap the two lines below to compare `.h` and `.h2`.\n\nval names = (1..400).map { \"node-\" + it }.toSet()\n\ndisplay(\"set\", names.h2)\n// display(\"set\", names.h)\ndisplayOpen(\"set\")"}}} {"id" "15301b9c-4454-4b37-b439-7c5fc2c8d06d" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "4 · an FLine" "frame" #afield/rect [780.0 520.0 640.0 320.0] "nested" #{} "preamble" "" "code" #afield/file-inline {"path" "15301b9c-4454-4b37-b439-7c5fc2c8d06d_code_.kt" "inline" "// A polyline's content is its node list, which is one property among four. The adapter\n// turns it into a node table: index, instruction kind, control-point count, endpoint, and how\n// many per-node properties each carries.\n//\n// Note the `Close` row: `FLine.Node.end` THROWS on a Close (it is Node(0) and stores no point of\n// its own), so the adapter reads the last stored point and a Close honestly carries blanks.\n\nimport afield.graphics.FLine\n\nval f = FLine()\n    .moveTo(0.15, 0.2)\n    .lineTo(0.85, 0.2)\n    .cubicTo(0.95, 0.5, 0.75, 0.8, 0.5, 0.8)\n    .lineTo(0.15, 0.5)\n\ndisplay(\"fline\", f.h2)\ndisplayOpen(\"fline\")"}}} {"id" "b26b8dce-3dce-41aa-b712-7bb0f7daaad7" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "2 · this box" "frame" #afield/rect [780.0 180.0 640.0 300.0] "preamble" "" "nested" #{} "code" #afield/file-inline {"path" "b26b8dce-3dce-41aa-b712-7bb0f7daaad7_code_.kt" "inline" "// A hand-written adapter, because reflecting a Box would read `Box.ki` -- a lazy delegate\n// that BUILDS A K2 REPL ENGINE on read. Exploring a box would compile one.\n//\n// Click into `properties` for the box's whole property bag, and `edges` for its\n// parents / children / nested / nestedIn as one table.\n\ndisplay(\"box\", thisBox.h2)\ndisplayOpen(\"box\")"}}} {"id" "f58460c5-30dc-496e-9bce-dd041b340c6e" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "3 · a function" "frame" #afield/rect [100.0 520.0 640.0 320.0] "preamble" "" "nested" #{} "code" #afield/file-inline {"path" "f58460c5-30dc-496e-9bce-dd041b340c6e_code_.kt" "inline" "// An `Fn`'s only non-derived field is a private `(Double) -> Double`, so a property tree\n// would show you nothing. The adapter samples it instead: 512 rows of x and f(x) over the\n// declared domain, which is what you actually wanted to see.\n//\n// Scroll it. The explorer streams windows over the socket rather than sending 512 rows at once.\n\nimport afield.stdlib.Functions\n\nval wobble = Functions.fn(Functions.Domain(0.0, 6.283185), \"sin+ripple\") {\n    kotlin.math.sin(it) + 0.15 * kotlin.math.sin(it * 7)\n}\n\ndisplay(\"fn\", wobble.h2)\ndisplayOpen(\"fn\")"}}} {"id" "e29999a2-6465-412b-8e0f-e169694f0de7" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "h2 Explorer Examples" "frame" #afield/rect [100.0 80.0 340.0 60.0] "nested" #{} "preamble" ""}} {"id" "18cf2855-5314-4355-b200-3ed9c4984a1c" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Notes" "frame" #afield/rect [100.0 1240.0 820.0 440.0] "nested" #{} "preamble" "" "code" #afield/file-inline {"path" "18cf2855-5314-4355-b200-3ed9c4984a1c_code_.kt" "inline" "/*\n * HOW `.h2` DECIDES\n *\n * `.h2` engages when there is something to browse, and otherwise hands the value straight to\n * `.h` -- byte for byte, same HTML. Two rules:\n *\n *   1. A collection, array, map or buffer. No size threshold: the gate admits exactly what the\n *      three rendering surfaces can draw.\n *   2. A domain object with two or more readable properties.\n *\n * Two or more, and not `.h`'s elision point of ten, because `.h2` is typed by hand. Someone who\n * wanted the compact form typed `.h`.\n *\n * WHAT IT REFUSES, and why each refusal is deliberate:\n *\n *   - numbers, strings, booleans, chars, enums -- nothing to browse\n *   - `Quantity` and `Expression` -- the unit-aware formatter IS the value\n *   - vectors, matrices, quaternions -- `.h` draws a matrix as a heatmap; a property dump is worse\n *   - `Pair`, `Triple`, lambdas\n *   - anything in a JVM or Kotlin platform package (`java.`, `kotlin.`, ...)\n *\n * That last one is what keeps \"`.h2` explores everything\" from meaning \"`.h2` dumps every object\n * on the heap\". A class with an EMPTY package is admitted, which is where your own box-compiled\n * declarations live -- box 1 above relies on that.\n *\n * WHEN THE REFLECTIVE DEFAULT READS BADLY\n *\n * Register an adapter. It returns the value you would rather explore, and every surface picks it\n * up -- a `LinkedHashMap` inherits map paging, and a `List<Map<String, Any?>>` becomes a table\n * with one column per key:\n *\n *     registerH2Value<MyType> { v ->\n *         H2ValueSnapshot(\n *             value = linkedMapOf(\"a\" to v.a, \"rows\" to v.rows),\n *             summary = \"MyType with ${v.rows.size} rows\",\n *             title = \"MyType\"\n *         )\n *     }\n *\n * Reach for one when reflection would be misleading (an `Fn`), when the interesting content is not\n * in the fields (an `FLine`), or -- most importantly -- when a getter has SIDE EFFECTS. A\n * `KProperty1` getter is opaque, so `.h2` cannot tell a field read from a property that opens a\n * file or compiles a REPL engine. `Box` is served by an adapter for exactly that reason.\n *\n * A getter that throws is not hidden: it becomes a row marked with a warning sign, carrying the\n * exception text.\n *\n * See dev_docs/VALUE_VISUALIZER.md and public/docs/visualizers.md.\n */"}}} {"id" "8f01ff7d-3580-40e6-acd5-a8e303a19fdb" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "1 · your own data class" "frame" #afield/rect [100.0 180.0 640.0 300.0] "nested" #{} "preamble" "" "code" #afield/file-inline {"path" "8f01ff7d-3580-40e6-acd5-a8e303a19fdb_code_.kt" "inline" "// The reflective default. No adapter, no registration -- `.h2` reads the properties of\n// anything it is handed, in constructor order, and pages them.\n//\n// `.h` renders this as one line: `Trail { id -> 7, x -> 0.25, ... }`.\n\ndata class Trail(val id: Int, val x: Double, val y: Double, val label: String, val closed: Boolean)\n\ndisplay(\"trail\", Trail(7, 0.25, 0.75, \"trail-7\", true).h2)\ndisplayOpen(\"trail\")"}}} {"id" "root" "properties" {"children" #{#afield/box "e29999a2-6465-412b-8e0f-e169694f0de7" #afield/box "8f01ff7d-3580-40e6-acd5-a8e303a19fdb" #afield/box "b26b8dce-3dce-41aa-b712-7bb0f7daaad7" #afield/box "f58460c5-30dc-496e-9bce-dd041b340c6e" #afield/box "15301b9c-4454-4b37-b439-7c5fc2c8d06d" #afield/box "d7d194dd-536f-44f3-9d5e-de58542baa7e" #afield/box "9a3aaad6-0c2f-4851-9ef7-ae0fc6af4d00" #afield/box "18cf2855-5314-4355-b200-3ed9c4984a1c"} "parents" #{#afield/box "metaroot"} "name" "root" "nested" #{}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "fragment" "stackSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRemoteJSRoot" "isPythonRoot" ".*_editorState" "metadata" "nested" "nestedIn" "playlist" "pauseList" "bookmarks" "slideShow" "autorun" "layers" "layerFrames" "_controlGroupValues" "ai4_auto_name" "ai4_auto_name_signature" "fileManagerAccessHistory" "isClojureRoot" "isDatalogRoot" "isForthRoot" "isFieldMLRoot" "isMorphoRoot" "isNanoRoot" "nanoLaunchDelayMs" "nanoMemoryInit" "isKotlinJsRoot" "mainLanguage" "spreadsheet"]}