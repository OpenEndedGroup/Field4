{"version" 2 "boxes" [{"id" "tpl_clojure_root" "properties" {"children" #{#afield/box "tpl_clojure_cell"} "parents" #{#afield/box "root"} "name" "Clojure root · boxes under this run as Clojure" "preamble" "" "_tombstone" false "frame" #afield/rect [80.0 80.0 340.0 70.0] "mainLanguage" "clojure" "code" #afield/file-inline {"path" "tpl_clojure_root_code_.kt" "inline" "// This box stays Kotlin. Its `mainLanguage` makes every box connected under it Clojure.\nprintln(\"Clojure root\")\n"} "metadata" #afield/file-inline {"path" "tpl_clojure_root_metadata_.yaml" "inline" "doc: |\n  A Clojure root and one Clojure box under it, with a slider whose handler is Clojure.\n"}}} {"id" "tpl_clojure_cell" "properties" {"children" #{} "parents" #{#afield/box "root" #afield/box "tpl_clojure_root"} "name" "clojure box" "_tombstone" false "frame" #afield/rect [80.0 200.0 340.0 140.0] "code_language" "Clojure" "code" #afield/file-inline {"path" "tpl_clojure_cell_code_.kt" "inline" ";; A Clojure box: run it, or select a form and run only that.\n(def state (atom {:freq 3.0}))\n\n(defn redraw [{:keys [freq]}]\n  (display \"main\" (format \"<b>%.1f Hz</b>\" freq)))\n\n(slider \"frequency\" #(swap! state assoc :freq %) :min 1 :max 10 :step 0.1 :value 3.0)\n(add-watch state :redraw (fn [_ _ _ now] (redraw now)))\n(redraw @state)\n"}}}] "persistentProperties" ["contents" "frame" "name" "code" "code_language" "box_kind" "textFrame" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_proxy_mime" "filename" "preamble" "introduction" "attic" "notes" "geometryReviews" "geometryAppearance" "fragment" "stackSL" "rectSL" "msl" "vertex" "vertex_fragment" "task" "mesh" "raygen" "miss" "closesthit" "anyhit" "intersection" "callable" "fragment_s" "vertex_s" "task_s" "mesh_s" "raygen_s" "miss_s" "closesthit_s" "anyhit_s" "intersection_s" "callable_s" "children" "parents" "compute" "compute_s" "customization" "source_id" "templateId" "_tombstone" "isRem