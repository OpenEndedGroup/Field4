{"version" 2 "boxes" [{"id" "present_live_field" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Live Field" "frame" #afield/rect [80 180 480 80] "autorun" true "code" #afield/file-inline {"path" "present_live_field_code_.kt" "inline" "markdown(\"main\", \"# A document, not a screenshot\\nEdit this box while the audience watches.\")\n"}}} {"id" "present_teaching_guide" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Teaching guide" "frame" #afield/rect [700 180 260 80] "autorun" true "code" #afield/file-inline {"path" "present_teaching_guide_code_.kt" "inline" "val teachingGuide = slideShow {\n    step(\"Change the live code\") {\n        markdownNote(\"\"\"\n            ## A real document on the screen\n            The editor shows the source of **Live Field**. Change a sentence and run the box.\n\n            [[next:Next: use the saved macro]]\n        \"\"\".trimIndent())\n        selectBoxByName(\"Live Field\", property = \"code\", line = 1, highlight = 1)\n    }\n    step(\"Build something with a macro\") {\n        markdownNote(\"\"\"\n            ## Make the next part live\n            Press **Run reveal_wave** in the presenter controls. The macro creates and runs a wave box.\n            Select **A wave, live**, change `0.17`, and run it again.\n\n            [[back]] [[next]]\n        \"\"\".trimIndent())\n    }\n    step(\"Teach from the working material\") {\n        markdownNote(\"\"\"\n            ## Keep the working material\n            This document, its source, this guide, and the macro live in the talk repository.\n            Close this guide and press Next in the presenter controls to return to the talk.\n\n            [[back]] [[finish]]\n        \"\"\".trimIndent())\n    }\n}\nUnit\n"} "kitRole" "teaching-guide"}} {"id" "present_talk" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Presentation" "frame" #afield/rect [80 40 480 90] "autorun" true "code" #afield/file-inline {"path" "present_talk_code_.kt" "inline" "import afield.ui.slides.*\nimport kotlinx.html.*\n\nval talkDocument = inside.documentName\n\npresentation(title = \"Teaching with Field\") {\n    section(\"Opening\") {\n        step(\"Field / present\") {\n            audience {\n                stylesheet(\"presentation.css\")\n                p(classes = \"muted\") { +\"A LIVE TEACHING ENVIRONMENT\" }\n                h1 { +\"FIELD / PRESENT\" }\n                p { +\"The talk and the working material, together.\" }\n                hr { }\n                p(classes = \"muted\") { +\"Use Next in the presenter controls.\" }\n            }\n            markdownNote(\"The audience has its own window. These notes stay in your Field document. [[next]]\")\n        }\n        step(\"Work in the open\") {\n            audience {\n                stylesheet(\"presentation.css\")\n                h1 { +\"Work in the open.\" }\n                div(classes = \"columns\") {\n                    div { h2 { +\"Explain\" }; p { +\"A slide can be a few lines of Kotlin and HTML.\" } }\n                    div { h2 { +\"Explore\" }; p { +\"Bring the actual webpage or document on screen.\" } }\n                    div { h2 { +\"Change\" }; p { +\"Run the code. Follow the question.\" } }\n                }\n            }\n            markdownNote(\"Edit the words in the Presentation box and run it again. It keeps the current step. [[back]] [[next]]\")\n        }\n    }\n    section(\"Pictures and ideas\") {\n        step(\"A figure, fullscreen\") {\n            audience {\n                stylesheet(\"presentation.css\")\n                fullScreenImage(\"wave.svg\", alt = \"A white sine wave on black\", citation = \"Field / Present · sine wave study · editable SVG\")\n            }\n            markdownNote(\"One image, with its credit. The figure stays a shared file, not a copy inside a slide. [[back]] [[next]]\")\n        }\n        step(\"A figure and an idea\") {\n            audience {\n                stylesheet(\"presentation.css\")\n                imageBeside(\"wave.svg\", alt = \"A sine wave\", citation = \"Field / Present · sine wave study\") {\n                    +\"\"\"\n                        # A small change.\n                        The picture and the explanation live together.\n\n                        1. Predict the effect of a frequency change.\n                        2. Try it in the live document.\n                    \"\"\".md\n                }\n            }\n            markdownNote(\"Markdown mixes with HTML and image layouts. Edit presentation.css in its Field box, then Refresh slide. [[back]] [[next]]\")\n        }\n    }\n    section(\"Working material\") {\n        step(\"A real webpage\") {\n            audienceWebpage(\"https://example.org/\")\n            markdownNote(\"This is a real browser view. Navigate and interact with it directly. [[back]] [[next]]\")\n        }\n        step(\"A live Field document\") {\n            audienceDocument(talkDocument, macro = \"reveal_wave\")\n            markdownNote(\"Use **Run reveal_wave** to build a wave, or **Start document guide** to teach through the code. [[back]] [[next]]\")\n        }\n        step(\"YouTube\") {\n            audienceYouTube(\"M7lc1UVf-VE\")\n            markdownNote(\"Replace this embed test video with one for your lesson. [[back]] [[next]]\")\n        }\n    }\n    step(\"Keep teaching\") {\n        audience {\n            stylesheet(\"presentation.css\")\n            h1 { +\"Keep teaching.\" }\n            p { +\"Slides, examples, guides, macros and media belong with the lesson.\" }\n            hr { }\n            p(classes = \"muted\") { +\"Save the document. Everything stays editable.\" }\n        }\n        markdownNote(\"Use the previous steps to revisit an example. Close the audience or controller when finished. [[back]] [[finish]]\")\n    }\n}.present()\n"}}} {"id" "present_styles" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "presentation.css" "frame" #afield/rect [700 40 260 90] "file_proxy_mode" "document" "file_proxy_path" "files/presentation.css" "default_property" "contents" "contents_language" "css" "customization" "this.classList.add(\"file-proxy-box\"); this.style.backgroundColor = \"var(--field-bg)\""}}] "persistentProperties" ["frame" "name" "code" "parents" "children" "autorun" "kitRole" "slideShow" "file_proxy_mode" "file_proxy_path" "default_property" "contents_language" "customization"]}
