{"version" 2 "boxes" [{"id" "present_live_field" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Live Field" "frame" #afield/rect [80.0 180.0 480.0 80.0] "autorun" true "code" #afield/file-inline {"path" "present_live_field_code_.kt" "inline" "markdown(\"main\", \"# A document, not a screenshot\\nEdit this box while the audience watches.\")\n"}}} {"id" "present_teaching_guide" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Teaching guide" "frame" #afield/rect [700.0 180.0 260.0 80.0] "autorun" true "code" #afield/file-inline {"path" "present_teaching_guide_code_.kt" "inline" "val teachingGuide = slideShow {\n    step(\"Change the live code\") {\n        markdownNote(\n            \"\"\"\n            ## A real document on the screen\n            The editor shows the source of **Live Field**. Change a sentence and run the box.\n\n            [[next:Next: use the saved macro]]\n        \"\"\"\n                .trimIndent(),\n        )\n        selectBoxByName(\"Live Field\", property = \"code\", line = 1, highlight = 1)\n    }\n    step(\"Build something with a macro\") {\n        markdownNote(\n            \"\"\"\n            ## Make the next part live\n            Press **Run reveal_wave** in the presenter controls. The macro creates and runs a wave box.\n            Select **A wave, live**, change `0.17`, and run it again.\n\n            [[back]] [[next]]\n        \"\"\"\n                .trimIndent(),\n        )\n    }\n    step(\"Teach from the working material\") {\n        markdownNote(\n            \"\"\"\n            ## Keep the working material\n            This document, its source, this guide, and the macro live in the talk repository.\n            Close this guide and press Next in the presenter controls to return to the talk.\n\n            [[back]] [[finish]]\n        \"\"\"\n                .trimIndent(),\n        )\n    }\n}\nUnit\n"} "kitRole" "teaching-guide"}} {"id" "present_talk" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Presentation" "frame" #afield/rect [80.0 40.0 480.0 90.0] "autorun" true "code" #afield/file-inline {"path" "present_talk_code_.kt" "inline" "import kotlinx.html.*\n\nval talkDocument = inside.documentName\nval waveExperiment = inside.root.children.single { it.name == \"Wave experiment\" }\nval waveBaseline = LessonCheckpoint.capture(waveExperiment)\nval lessonDirectory = files.documentDirectory.toString()\nfun runWaveExperiment() {\n    val result = OperationTranscript.runMacro(lessonDirectory, \"run_wave\")\n    check(result.success) { result.toString() }\n}\n\npresentation(title = \"Teaching with Field\") {\n        section(\"Opening\") {\n            step(\"Field / present\") {\n                audience {\n                    stylesheet(\"presentation.css\")\n                    p(classes = \"muted\") { +\"A LIVE TEACHING ENVIRONMENT\" }\n                    h1 { +\"FIELD / PRESENT\" }\n                    p { +\"The talk and the working material, together.\" }\n                    hr {}\n                    p(classes = \"muted\") { +\"Use Next in the presenter controls.\" }\n                }\n                markdownNote(\"The audience has its own window. These notes stay in your Field document. [[next]]\")\n            }\n            step(\"Work in the open\") {\n                audience {\n                    stylesheet(\"presentation.css\")\n                    h1 { +\"Work in the open.\" }\n                    div(classes = \"columns\") {\n                        div {\n                            h2 { +\"Explain\" }\n                            p { +\"A slide can be a few lines of Kotlin and HTML.\" }\n                        }\n                        div {\n                            h2 { +\"Explore\" }\n                            p { +\"Bring the actual webpage or document on screen.\" }\n                        }\n                        div {\n                            h2 { +\"Change\" }\n                            p { +\"Run the code. Follow the question.\" }\n                        }\n                    }\n                }\n                markdownNote(\n                    \"Edit the words in the Presentation box and run it again. It keeps the current step. [[back]] [[next]]\",\n                )\n            }\n        }\n        section(\"Pictures and ideas\") {\n            step(\"A figure, fullscreen\") {\n                audience {\n                    stylesheet(\"presentation.css\")\n                    fullScreenImage(\n                        \"wave.svg\",\n                        alt = \"A white sine wave on black\",\n                        citation = \"Field / Present · sine wave study · editable SVG\",\n                    )\n                }\n                reveal(\"Look more closely\", dimPrevious = 0.25) {\n                    fadeIn(durationMs = 600) {\n                        h1 { +\"One curve. Many questions.\" }\n                        p { +\"Keep the figure in view while adding the next idea.\" }\n                    }\n                }\n                markdownNote(\n                    \"One image, with its credit. The figure stays a shared file, not a copy inside a slide. [[back]] [[next]]\",\n                )\n            }\n            step(\"A figure and an idea\") {\n                audience {\n                    stylesheet(\"presentation.css\")\n                    imageBeside(\"wave.svg\", alt = \"A sine wave\", citation = \"Field / Present · sine wave study\") {\n                        +\"\"\"\n                        # A small change.\n                        The picture and the explanation live together.\n\n                        1. Predict the effect of a frequency change.\n                        2. Try it in the live document.\n                    \"\"\"\n                            .md\n                    }\n                }\n                markdownNote(\n                    \"Markdown mixes with HTML and image layouts. Edit presentation.css in its Field box, then Refresh slide. [[back]] [[next]]\",\n                )\n            }\n        }\n        // Editable Markdown slides: AI4 can revise one slide without rewriting this Kotlin.\n        slides(\"talk.slides.json\")\n        section(\"A repeatable experiment\") {\n            step(\"Predict a wave\", id = \"wave-experiment\") {\n                audience {\n                    stylesheet(\"presentation.css\")\n                    +\"# Twice the frequency?\\nPredict what happens to the wavelength.\".md\n                }\n                markdownNote(\n                    \"Next reveals the explanation, then opens the experiment. Change frequency and run Wave experiment. Reset restores only its source and runs setup again. [[back]] [[next]]\",\n                )\n                cue(\"Explain\") {\n                    audience {\n                        stylesheet(\"presentation.css\")\n                        +\"# Half the wavelength.\\nAt the same propagation speed, twice the frequency means half the wavelength.\"\n                            .md\n                    }\n                }\n                cue(\"Try it live\") {\n                    audienceDocument(talkDocument, macro = \"run_wave\", interactiveGuide = false)\n                    onEnter { runWaveExperiment() }\n                    selectBox(waveExperiment)\n                }\n                checkpoint(\"Wave baseline\") {\n                    waveBaseline.restore()\n                    runWaveExperiment()\n                }\n            }\n        }\n        section(\"Working material\") {\n            step(\"A real webpage\") {\n                audienceWebpage(\"https://example.org/\")\n                markdownNote(\"This is a real browser view. Navigate and interact with it directly. [[back]] [[next]]\")\n            }\n            step(\"A live Field document\") {\n                audienceDocument(talkDocument, macro = \"reveal_wave\")\n                markdownNote(\n                    \"Use **Run reveal_wave** to build a wave, or **Start document guide** to teach through the code. [[back]] [[next]]\",\n                )\n            }\n            step(\"YouTube\") {\n                audienceYouTube(\"M7lc1UVf-VE\")\n                markdownNote(\"Replace this embed test video with one for your lesson. [[back]] [[next]]\")\n            }\n        }\n        step(\"Keep teaching\") {\n            audience {\n                stylesheet(\"presentation.css\")\n                h1 { +\"Keep teaching.\" }\n                p { +\"Slides, examples, guides, macros and media belong with the lesson.\" }\n                hr {}\n                p(classes = \"muted\") { +\"Save the document. Everything stays editable.\" }\n            }\n            markdownNote(\n                \"Use the previous steps to revisit an example. Close the audience or controller when finished. [[back]] [[finish]]\",\n            )\n        }\n    }\n    .present()\n"}}} {"id" "present_styles" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "presentation.css" "frame" #afield/rect [700.0 40.0 260.0 90.0] "file_proxy_mode" "document" "file_proxy_path" "files/presentation.css" "default_property" "contents" "contents_language" "css" "customization" "this.classList.add(\"file-proxy-box\"); this.style.backgroundColor = \"var(--field-bg)\""}} {"id" "present_wave_experiment" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Wave experiment" "frame" #afield/rect [80.0 400.0 480.0 80.0] "autorun" true "code" #afield/file-inline {"path" "present_wave_experiment_code_.kt" "inline" "val frequency = 1.0\nval points =\n    (0..160).joinToString(\" \") { i ->\n        val x = i * 4\n        val y = 110 - 65 * kotlin.math.sin(i * 0.08 * frequency)\n        \"$x,$y\"\n    }\ndisplay(\n    \"wave\",\n    \"\"\"<div style=\"background:#000;padding:20px\"><svg viewBox=\"0 0 640 220\" width=\"640\" height=\"220\"><polyline points=\"$points\" fill=\"none\" stroke=\"white\" stroke-width=\"3\"/></svg></div>\"\"\",\n)\ndisplayOpen(\"wave\")\n"}}}] "persistentProperties" ["frame" "name" "code" "parents" "children" "autorun" "kitRole" "slideShow" "file_proxy_mode" "file_proxy_path" "default_property" "contents_language" "customization"]}