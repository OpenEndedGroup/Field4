{"version" 2 "boxes" [{"id" "present_live_field" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Live Field" "_tombstone" false "frame" #afield/rect [80.0 50.0 480.0 80.0] "autorun" true "code" #afield/file-inline {"path" "present_live_field_code_.kt" "inline" "markdown(\"main\", \"# A document, not a screenshot\\nEdit this box while the audience watches.\")\n"}}} {"id" "present_teaching_guide" "properties" {"children" #{} "parents" #{#afield/box "root"} "name" "Teaching guide" "_tombstone" false "frame" #afield/rect [700.0 50.0 260.0 80.0] "autorun" true "code" #afield/file-inline {"path" "present_teaching_guide_code_.kt" "inline" "val teachingGuide = slideShow {\n    step(\"Change the live code\") {\n        markdownNote(\"\"\"\n            ## A real document on the screen\n            The editor shows the source of **Live Field**. Change a sentence and run the box.\n\n            [[next:Next: use the saved macro]]\n        \"\"\".trimIndent())\n        selectBoxByName(\"Live Field\", property = \"code\", line = 1, highlight = 1)\n    }\n    step(\"Build something with a macro\") {\n        markdownNote(\"\"\"\n            ## Make the next part live\n            Press **Run reveal_wave** in the presenter controls. The macro creates and runs a wave box.\n            Select **A wave, live**, change `0.17`, and run it again.\n\n            [[back]] [[next]]\n        \"\"\".trimIndent())\n    }\n    step(\"Teach from the working material\") {\n        markdownNote(\"\"\"\n            ## Keep the working material\n            This document, its source, this guide, and the macro live in the talk repository.\n            Close this guide and advance the presentation cue to return to the talk.\n\n            [[back]] [[finish]]\n        \"\"\".trimIndent())\n    }\n}\nUnit\n"}}}] "persistentProperties" ["frame" "name" "code" "code_language" "contents_language" "default_property" "file_proxy_mode" "file_proxy_path" "file_proxy_original_path" "file_prox