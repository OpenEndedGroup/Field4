<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="warn">
        <appender-ref ref="STDOUT" />
    </root>

    <!-- smileTsne reports the final cost itself; Smile logs it every tenth iteration at INFO. -->
    <logger name="smile.manifold.TSNE" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <!-- Common noisy disconnect path when clients drop sockets mid-read. -->
    <logger name="io.netty.channel.DefaultChannelPipeline" level="ERROR"/>

</configuration>
