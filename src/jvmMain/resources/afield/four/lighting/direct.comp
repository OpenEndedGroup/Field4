#version 460
#ifdef HARDWARE_QUERY
#extension GL_EXT_ray_query : require
layout(set=0,binding=4) uniform accelerationStructureEXT sceneAS;
#endif
#extension GL_EXT_buffer_reference : require
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D positions;
layout(set=0,binding=1) uniform sampler2D normals;
layout(set=0,binding=2) uniform sampler2D albedo;
layout(set=0,binding=3) uniform sampler2D source;
layout(set=0,binding=5) uniform sampler2D motion;
layout(buffer_reference,std430) buffer Pixels { vec4 values[]; };
layout(push_constant) uniform Settings {
    Pixels pixels;
    int width; int height;
    vec4 center;
    vec4 edgeU;
    vec4 edgeV;
    vec4 radiance;
    int mode; int view; int samples; uint seed;
    float epsilon; float weight;
} p;
uint hash(uint v) { v ^= v >> 16; v *= 0x7feb352du; v ^= v >> 15; v *= 0x846ca68bu; return v ^ (v >> 16); }
float random(inout uint state) { state = hash(state); return float(state >> 8) * (1.0 / 16777216.0); }
float visible(vec3 point, vec3 n, vec3 lightPoint) {
#ifdef HARDWARE_QUERY
    vec3 origin = point + n*p.epsilon;
    vec3 delta = lightPoint-origin;
    float distanceToLight = length(delta);
    if (distanceToLight <= 2.0*p.epsilon) return 1.0;
    rayQueryEXT q;
    rayQueryInitializeEXT(q, sceneAS, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
        255, origin, 0.0, delta/distanceToLight, distanceToLight-p.epsilon);
    while (rayQueryProceedEXT(q)) {}
    return rayQueryGetIntersectionTypeEXT(q,true) == gl_RayQueryCommittedIntersectionNoneEXT ? 1.0 : 0.0;
#else
    return 1.0;
#endif
}
void main() {
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= p.width || xy.y >= p.height) return;
    int index = xy.y*p.width+xy.x;
    vec4 original = texelFetch(source,xy,0);
    if (p.mode == 0) { p.pixels.values[index] = original; return; }
    vec4 position = texelFetch(positions,xy,0);
    vec3 normal = texelFetch(normals,xy,0).xyz;
    if (position.w >= 1.0 || dot(normal,normal) < 0.1) { p.pixels.values[index] = vec4(original.rgb,-1.0); return; }
    normal = normalize(normal);
    vec3 color = texelFetch(albedo,xy,0).rgb;
    vec3 crossEdges = cross(p.edgeU.xyz,p.edgeV.xyz);
    float area = length(crossEdges);
    vec3 lightNormal = crossEdges/area;
    uint state = hash(uint(index) ^ hash(p.seed + 0x9e3779b9u));
    vec3 sum = vec3(0.0); float visibility = 0.0;
    for(int i=0;i<p.samples;i++) {
        float u = random(state)-0.5;
        float vLight = random(state)-0.5;
        vec3 samplePoint = p.center.xyz + u*p.edgeU.xyz + vLight*p.edgeV.xyz;
        vec3 delta = samplePoint-position.xyz;
        float r2 = dot(delta,delta);
        if (r2 <= p.epsilon*p.epsilon) continue;
        vec3 direction = delta*inversesqrt(r2);
        float cosSurface = max(dot(normal,direction),0.0);
        float cosLight = max(dot(lightNormal,-direction),0.0); // one sided, area measure
        float v = p.mode == 2 ? visible(position.xyz,normal,samplePoint) : 1.0;
        visibility += v;
        sum += color*(1.0/3.141592653589793)*p.radiance.rgb*(area*cosSurface*cosLight/r2)*v;
    }
    vec3 lit = sum/float(p.samples);
    visibility /= float(p.samples);
    if(p.view == 1) lit = normal*0.5+0.5;
    if(p.view == 2) lit = vec3(position.w);
    if(p.view == 3) lit = vec3(visibility);
    if(p.view == 4) lit = vec3(texelFetch(motion,xy,0).xy*8.0+0.5,0.5);
    p.pixels.values[index] = vec4(mix(original.rgb,lit,p.weight),visibility);
}
