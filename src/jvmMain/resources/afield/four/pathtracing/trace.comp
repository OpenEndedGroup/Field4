    vec2 disk=radius*vec2(cos(phi),sin(phi));
    disk.y=mix(sqrt(max(0.0,1.0-disk.x*disk.x)),disk.y,0.5*(1.0+stretched.z));
    vec3 h=disk.x*tangent+disk.y*bitangent+sqrt(max(0.0,1.0-dot(disk,disk)))*stretched;
    return localToWorld*normalize(vec3(alpha*h.xy,max(1e-6,h.z)));
