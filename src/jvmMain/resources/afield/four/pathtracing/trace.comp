        HistoryPixel previous=ptScene.historyRead.items[index];old=previous.value;count=previous.albedoCount.w;
        // Once stationary accumulation mixes a silhouette, don't later carry that mixed pixel onto a surface.
        if (!sameSurface(guide,previous,worldPixel(guide.position.xyz,frame.origin,frame.up,frame.forward)))
            guide.normal.w=-1.0;
    } else if (frame.temporal.x==2) old=reproject(guide,count);
    float total=count+float(frame.image.w);
    vec4 mean=old+(sum-float(frame.image.w)*old)/total;
    // Keep unfogged history, so reprojection uses the NEW camera distance even through dense fog.
    // Stationary pixels accumulate per-path fogged samples, preserving jitter/DOF edge coverage.
    vec4 oldFog=vec4(0);
    if (count>0.0) oldFog=frame.temporal.x==2 ?
        depthFog(old,distance(guide.position.xyz,frame.origin.xyz)) : ptScene.accumulation.items[index];
    ptScene.accumulation.items[index]=oldFog+(fogSum-float(frame.image.w)*oldFog)/total;
    if (frame.temporal.x>=0) {
        guide.value=mean;guide.albedoCount.w=total;
        ptScene.historyWrite.items[index]=guide;
    }
}
