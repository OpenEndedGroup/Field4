    }
    xi.x=min((xi.x-0.05)/0.95,0.99999994);
    int low=0, high=frame.scene.y*frame.scene.z-1;
    while (low<high) { int middle=(low+high)/2; if (xi.x<ptScene.distribution.items[middle].x) high=middle; else low=middle+1; }
    int x=low%frame.scene.y, y=low/frame.scene.y;
    float phi=2.0*PI*((float(x)+xi.y)/float(frame.scene.y)-0.5);
    float cosTheta=mix(cos(PI*float(y)/float(frame.scene.z)),cos(PI*float(y+1)/float(frame.scene.z)),jitter);
    float sinTheta=sqrt(max(0.0,1.0-cosTheta*cosTheta));
    pdf=0.95*ptScene.distribution.items[low].y/max(solidAngle(y),1e-20)+0.05/(4.0*PI);
