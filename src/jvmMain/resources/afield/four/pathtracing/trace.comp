// eta is transmitted IOR / incident IOR. Exact dielectric Fresnel includes total internal reflection.
float dielectricFresnel(float cosine, float eta) {
    if (eta==1.0) return 0.0;
    float c=clamp(abs(cosine),0.0,1.0);
    float sin2=(1.0-c*c)/(eta*eta);
    if (sin2>=1.0) return 1.0;
    float ct=sqrt(1.0-sin2);
    float parallel=(eta*c-ct)/(eta*c+ct), perpendicular=(c-eta*ct)/(c+eta*ct);
    return 0.5*(parallel*parallel+perpendicular*perpendicular);
