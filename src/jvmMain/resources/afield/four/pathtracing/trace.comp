    vec3 h=normalize(wo+wi); float nh=max(dot(n,h),0.0),vh=max(dot(wo,h),1e-8);
    float alpha=max(m.emission.w*m.emission.w,0.001);
    float d=ggxD(nh,alpha); vec3 f=fresnel(mix(vec3(0.04),m.base.rgb,m.base.w),vh);
    float p=specProbability(m);
