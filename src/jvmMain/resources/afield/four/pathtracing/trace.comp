layout(buffer_reference,std430,buffer_reference_align=16) readonly buffer Triangles { Triangle items[]; };
layout(buffer_reference,std430,buffer_reference_align=16) readonly buffer Nodes { Node items[]; };
layout(buffer_reference,std430,buffer_reference_align=16) readonly buffer Materials { Material items[]; };
layout(buffer_reference,std430,buffer_reference_align=16) buffer Accumulation { vec4 items[]; };
layout(buffer_reference,std430,buffer_reference_align=8) readonly buffer Distribution { vec2 items[]; };
layout(buffer_reference,std430,buffer_reference_align=4) readonly buffer Directions { uint items[]; };
layout(buffer_reference,std430,buffer_reference_align=16) readonly buffer TextureData { vec4 items[]; };
layout(set=0,binding=3,std140) uniform SceneBuffers {
    Triangles triangles; Nodes nodes; Materials materials; Accumulation accumulation; Distribution distribution; Directions directions; TextureData textures;
} ptScene;
layout(set=0,binding=0) uniform Frame {
    vec4 origin; vec4 right; vec4 up; vec4 forward;
    ivec4 image; // width, height, first sample index, samples per dispatch
    ivec4 scene; // node count, environment width, environment height, max bounces
    vec4 lighting; // environment intensity, yaw radians, ray epsilon, show environment background
