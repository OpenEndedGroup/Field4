// Sample the projected visible hemisphere, then undo the roughness stretch.
vec3 sampleVisibleNormal(vec3 n,vec3 wo,float alpha,vec2 xi) {
    mat3 localToWorld=basis(n);
    vec3 view=transpose(localToWorld)*wo;
    vec3 stretched=normalize(vec3(alpha*view.xy,view.z));
    vec3 tangent=stretched.z<0.99999 ? normalize(cross(vec3(0,0,1),stretched)) : vec3(1,0,0);
    vec3 bitangent=cross(stretched,tangent);
