#version 460
#extension GL_EXT_buffer_reference : require
// HARDWARE_QUERY is injected only when the device enabled VK_KHR_ray_query.
#ifdef HARDWARE_QUERY
#extension GL_EXT_ray_query : require
layout(set=0,binding=2) uniform accelerationStructureEXT sceneAS;
#endif
layout(local_size_x=8,local_size_y=8) in;
const float PI = 3.141592653589793;
struct Triangle { vec4 a; vec4 b; vec4 c; vec4 na; vec4 nb; vec4 nc; vec4 uv[6]; vec4 color[3]; };
struct Node { vec4 lo; vec4 hi; ivec4 data; };
struct Material { vec4 base; vec4 emission; vec4 optical; vec4 absorption; ivec4 maps; vec4 coverage; vec4 textureParams; };
// optical: transmission flag, IOR, thin-sheet flag, reserved. absorption: sigma_a or sheet tint.
layout(buffer_reference,std430,buffer_reference_align=16) readonly buffer Triangles { Triangle items[]; };
layout(buffer_reference,std430,buffer_reference_align=16) readonly buffer Nodes { Node items[]; };
layout(buffer_reference,std430,buffer_reference_align=16) readonly buffer Materials { Material items[]; };
layout(buffer_reference,std430,buffer_reference_align=16) buffer Accumulation { vec4 items[]; };
layout(buffer_reference,std430,buffer_reference_align=8) readonly buffer Distribution { vec2 items[]; };
layout(buffer_reference,std430,buffer_reference_align=4) readonly buffer Directions { uint items[]; };
layout(buffer_reference,std430,buffer_reference_align=16) readonly buffer TextureData { vec4 items[]; };
// value is unfogged radiance. normal.w is roughness, or -1 if unsafe; albedoCount.w is sample count.
struct HistoryPixel { vec4 value; vec4 position; vec4 normal; vec4 albedoCount; };
layout(buffer_reference,std430,buffer_reference_align=16) buffer History { HistoryPixel items[]; };
layout(set=0,binding=3,std140) uniform SceneBuffers {
    Triangles triangles; Nodes nodes; Materials materials; Accumulation accumulation; Distribution distribution; Directions directions; TextureData textures;
    History historyRead; History historyWrite;
    // emitterTable: cumulative probability and triangle index per emissive triangle.
    // emitterLookup: selection probability and area per triangle, the inverse map MIS needs.
    Distribution emitterTable; Distribution emitterLookup;
} ptScene;
layout(set=0,binding=0) uniform Frame {
    vec4 origin; vec4 right; vec4 up; vec4 forward;
    ivec4 image; // width, height, first sample index, samples per dispatch
    ivec4 scene; // node count, environment width, environment height, max bounces
    vec4 lighting; // environment intensity, yaw radians, ray epsilon, show environment background
    vec4 background; // premultiplied linear RGBA for primary misses
    vec4 sampling; // indirect clamp, pixel jitter width, aperture radius, focus-plane distance
    ivec4 temporal; // -1 disabled, 0 reset, 1 stationary, 2 reproject; sequence index; history cap; reserved
    vec4 previousOrigin; vec4 previousRight; vec4 previousUp; vec4 previousForward;
    vec4 historyPolicy; // motion sensitivity, roughness sensitivity, maximum defocus radius in pixels, reserved
    vec4 fog; // linear RGB, density per world unit
    vec4 fogOptions; // clear start distance, fog background misses, reserved, reserved
    ivec4 emitters; // sampled emissive-triangle count (zero disables direct emitter sampling), reserved
    // The participating medium, which is a different thing from fog above: fog attenuates a
    // finished radiance by the primary hit distance, this one is sampled along every segment.
    vec4 medium; // single-scattering albedo RGB, extinction per world unit in w (zero disables)
    vec4 mediumOptions; // Henyey-Greenstein g, bounded flag, reserved, reserved
    vec4 mediumLow; // bounds minimum when bounded, w unused
    vec4 mediumHigh; // bounds maximum when bounded, w unused
} frame;
layout(set=0,binding=1) uniform sampler2D environmentMap;

// Editable material code is inserted here, after the public types and before the integrator.
struct PathTraceSurface { vec3 position; vec3 normal; vec3 geometricNormal; vec3 outgoing; vec2 barycentric; int materialId; vec2 uv; vec4 color; };
// MATERIAL_BEGIN
Material shadeMaterial(Material material, PathTraceSurface surface) { return material; }
// MATERIAL_END

uint hash(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; return x ^ (x >> 16); }
// Nested uniform scramble: each output prefix is a permutation of the corresponding input prefix.
uint owen(uint x, uint seed) {
    x = bitfieldReverse(x);
    x ^= x * 0x3d20adeau; x += seed; x *= (seed >> 16) | 1u;
    x ^= x * 0x05526c56u; x ^= x * 0x53a22864u;
    return bitfieldReverse(x);
}
uint pixelSeed; uint sampleIndex;
float sampleDimension(uint dimension) {
    uint value=0u, bit=0u;
    // A distinct generating matrix per decision is essential: independently scrambling the
    // same 2D matrix at each bounce leaves high-dimensional correlations that never converge.
    for (uint i=sampleIndex^(sampleIndex>>1u); i!=0u; i>>=1u,bit++)
        if ((i&1u)!=0u) value^=ptScene.directions.items[dimension*32u+bit];
    return float(owen(value,hash(pixelSeed^(dimension*0x9e3779b9u)))>>8)*(1.0/16777216.0);
}
vec2 sample2(uint domain) { return vec2(sampleDimension(domain*2u),sampleDimension(domain*2u+1u)); }

// Texture pixels are linear RGBA in ordinary storage buffers: no descriptor-indexing extension.
int wrappedTexel(int x,int size,int mode) {
    if(mode==1) return clamp(x,0,size-1);
    int period=mode==2 ? size*2 : size;
    int p=((x%period)+period)%period;
    return mode==2 && p>=size ? period-1-p : p;
}
vec4 texel(int offset,ivec2 p,ivec2 size,ivec2 wrap) {
    p=ivec2(wrappedTexel(p.x,size.x,wrap.x),wrappedTexel(p.y,size.y,wrap.y));
    return ptScene.textures.items[offset+2+p.y*size.x+p.x];
}
vec4 sampleMap(int offset,vec2 uv) {
    if(offset<0) return vec4(1);
    vec4 header=ptScene.textures.items[offset];ivec2 size=ivec2(header.xy),wrap=ivec2(header.zw);
    // Bound coordinates before conversion to integer (large tiling UVs must not overflow).
    for(int i=0;i<2;i++) uv[i]=wrap[i]==1 ? clamp(uv[i],0.0,1.0) : mod(uv[i],wrap[i]==2 ? 2.0 : 1.0);
    vec2 p=uv*vec2(size);
    if(ptScene.textures.items[offset+1].x>0.5) return texel(offset,ivec2(floor(p)),size,wrap);
    p-=0.5;ivec2 base=ivec2(floor(p));vec2 f=fract(p);
    return mix(mix(texel(offset,base,size,wrap),texel(offset,base+ivec2(1,0),size,wrap),f.x),
               mix(texel(offset,base+ivec2(0,1),size,wrap),texel(offset,base+ivec2(1,1),size,wrap),f.x),f.y);
}
vec2 vertexUV(Triangle t,int vertex,int slot) {
    vec4 uv=t.uv[vertex*2+slot/2];return (slot%2)==0 ? uv.xy : uv.zw;
}
vec2 hitUV(Triangle t,vec2 bary,int slot) {
    return vertexUV(t,0,slot)*(1.0-bary.x-bary.y)+vertexUV(t,1,slot)*bary.x+vertexUV(t,2,slot)*bary.y;
}
vec4 hitColor(Triangle t,vec2 bary) { return t.color[0]*(1.0-bary.x-bary.y)+t.color[1]*bary.x+t.color[2]*bary.y; }
Material texturedMaterial(Triangle t,vec2 bary) {
    Material m=ptScene.materials.items[int(t.a.w)];
    vec4 base=sampleMap(m.maps.x,hitUV(t,bary,0))*hitColor(t,bary);
    m.base.rgb*=base.rgb;m.coverage.x*=base.a;
    vec4 mr=sampleMap(m.maps.y,hitUV(t,bary,1));m.base.w*=mr.b;m.emission.w*=mr.g;
    m.emission.rgb*=sampleMap(m.maps.z,hitUV(t,bary,2)).rgb;
    return m;
}
bool acceptsHit(int id,vec2 bary,vec3 ro,vec3 rd) {
    Triangle t=ptScene.triangles.items[id];Material m=ptScene.materials.items[int(t.a.w)];
    if(m.coverage.w<0.5 && m.optical.x<0.5 && dot(cross(t.b.xyz-t.a.xyz,t.c.xyz-t.a.xyz),rd)>=0.0) return false;
    if(m.coverage.z<0.5) return true;
    float alpha=m.coverage.x*sampleMap(m.maps.x,hitUV(t,bary,0)).a*hitColor(t,bary).a;
    if(m.coverage.z<1.5) return alpha>=m.coverage.y;
    // Stochastic coverage is shared by camera, continuation and shadow traversal. It does not bend rays.
    uint seed=hash(pixelSeed^hash(sampleIndex)^hash(uint(id)));
    seed=hash(seed^floatBitsToUint(ro.x)^floatBitsToUint(ro.y)^floatBitsToUint(ro.z));
    seed=hash(seed^floatBitsToUint(rd.x)^floatBitsToUint(rd.y)^floatBitsToUint(rd.z));
    return float(seed>>8)*(1.0/16777216.0)<alpha;
}
vec3 mappedNormal(Material m,Triangle t,vec2 bary,vec3 n) {
    if(m.maps.w<0) return n;
    vec2 d1=vertexUV(t,1,3)-vertexUV(t,0,3),d2=vertexUV(t,2,3)-vertexUV(t,0,3);
    float det=d1.x*d2.y-d1.y*d2.x;if(abs(det)<1e-12) return n;
    vec3 e1=t.b.xyz-t.a.xyz,e2=t.c.xyz-t.a.xyz;
    vec3 tangent=(e1*d2.y-e2*d1.y)/det,bitangent=(e2*d1.x-e1*d2.x)/det;
    tangent-=n*dot(n,tangent);if(dot(tangent,tangent)<1e-16) return n;
    tangent=normalize(tangent);bitangent=normalize(cross(n,tangent))*sign(dot(cross(n,tangent),bitangent));
    vec3 map=sampleMap(m.maps.w,hitUV(t,bary,3)).xyz*2.0-1.0;map.xy*=m.textureParams.x;
    vec3 result=tangent*map.x+bitangent*map.y+n*map.z;
    return dot(result,result)>1e-16 ? normalize(result) : n;
}
// Interpolated, flipped to the arriving ray's side, then normal-mapped, with the same guard at
// every step. The integrator and the emitter sampler must agree here: a material hook that reads
// surface.normal would otherwise hand the two strategies different radiance for one point, which
// is a bias in their combination rather than a shading difference.
vec3 shadingNormal(Triangle t,Material m,vec2 bary,vec3 rd,vec3 geometric) {
    vec3 n=normalize(t.na.xyz*(1.0-bary.x-bary.y)+t.nb.xyz*bary.x+t.nc.xyz*bary.y);
    if (dot(n,geometric)<0.0) n=-n;
    if (dot(n,-rd)<=0.0) n=geometric;
    n=mappedNormal(m,t,bary,n);
    if (dot(n,geometric)<=0.0 || dot(n,-rd)<=0.0) n=geometric;
    return n;
}
struct Hit { float t; int triangle; vec2 bary; };
bool boxHit(vec3 ro, vec3 rd, vec3 lo, vec3 hi, float limit) {
    float nearT = frame.lighting.z, farT = limit;
    for (int axis=0; axis<3; axis++) {
        if (abs(rd[axis]) < 1e-20) { if (ro[axis]<lo[axis] || ro[axis]>hi[axis]) return false; }
        else {
            float a=(lo[axis]-ro[axis])/rd[axis], b=(hi[axis]-ro[axis])/rd[axis];
            nearT=max(nearT,min(a,b)); farT=min(farT,max(a,b));
        }
    }
    return nearT <= farT;
}
// limit is a distance along a unit rd: an area-light shadow ray has to stop short of its own light.
Hit intersectScene(vec3 ro, vec3 rd, bool shadow, float limit) {
    Hit h = Hit(limit, -1, vec2(0));
#ifdef HARDWARE_QUERY
    rayQueryEXT query;
    uint flags = gl_RayFlagsNoOpaqueEXT;
    if (shadow) flags |= gl_RayFlagsTerminateOnFirstHitEXT;
    rayQueryInitializeEXT(query, sceneAS, flags, 255, ro, frame.lighting.z, rd, h.t);
    while (rayQueryProceedEXT(query)) {
        if(rayQueryGetIntersectionTypeEXT(query,false)==gl_RayQueryCandidateIntersectionTriangleEXT &&
           acceptsHit(rayQueryGetIntersectionPrimitiveIndexEXT(query,false),rayQueryGetIntersectionBarycentricsEXT(query,false),ro,rd))
            rayQueryConfirmIntersectionEXT(query);
    }
    if (rayQueryGetIntersectionTypeEXT(query,true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        h.t = rayQueryGetIntersectionTEXT(query,true);
        h.triangle = rayQueryGetIntersectionPrimitiveIndexEXT(query,true);
        h.bary = rayQueryGetIntersectionBarycentricsEXT(query,true);
    }
#else
    int nodeIndex=0;
    while (nodeIndex < frame.scene.x) {
        Node node=ptScene.nodes.items[nodeIndex];
        if (!boxHit(ro,rd,node.lo.xyz,node.hi.xyz,h.t)) { nodeIndex=node.data.z; continue; }
        for (int j=0; j<node.data.y; j++) {
            int id=node.data.x+j; Triangle t=ptScene.triangles.items[id];
            vec3 e1=t.b.xyz-t.a.xyz, e2=t.c.xyz-t.a.xyz, p=cross(rd,e2);
            float det=dot(e1,p); if (abs(det)<1e-10) continue;
            vec3 s=ro-t.a.xyz; float u=dot(s,p)/det;
            if (u<0.0 || u>1.0) continue;
            vec3 q=cross(s,e1); float v=dot(rd,q)/det;
            if (v<0.0 || u+v>1.0) continue;
            float distance=dot(e2,q)/det;
            if (distance>frame.lighting.z && distance<h.t && acceptsHit(id,vec2(u,v),ro,rd)) {
                h=Hit(distance,id,vec2(u,v)); if (shadow) return h;
            }
        }
        nodeIndex++;
    }
#endif
    return h;
}
Hit intersectScene(vec3 ro, vec3 rd, bool shadow) { return intersectScene(ro,rd,shadow,1e30); }
mat3 basis(vec3 n) {
    vec3 t=normalize(cross(abs(n.z)<0.999 ? vec3(0,0,1) : vec3(0,1,0),n));
    return mat3(t,cross(n,t),n);
}
vec3 rotateY(vec3 v, float a) { float c=cos(a),s=sin(a); return vec3(c*v.x+s*v.z,v.y,-s*v.x+c*v.z); }
vec2 environmentUV(vec3 d) {
    d=rotateY(d,-frame.lighting.y);
    return vec2(fract(atan(d.z,d.x)/(2.0*PI)+0.5),acos(clamp(d.y,-1.0,1.0))/PI);
}
vec3 environment(vec3 d) { return textureLod(environmentMap,environmentUV(d),0).rgb*frame.lighting.x; }
float solidAngle(int row) {
    return (2.0*PI/float(frame.scene.y)) * (cos(PI*float(row)/float(frame.scene.z))-cos(PI*float(row+1)/float(frame.scene.z)));
}
float environmentPdf(vec3 d) {
    ivec2 p=clamp(ivec2(environmentUV(d)*vec2(frame.scene.yz)),ivec2(0),frame.scene.yz-1);
    return 0.95*ptScene.distribution.items[p.y*frame.scene.y+p.x].y / max(solidAngle(p.y),1e-20) + 0.05/(4.0*PI);
}
vec3 sampleEnvironment(vec2 xi, float jitter, out float pdf) {
    if (xi.x<0.05) {
        float phi=2.0*PI*(xi.y-0.5), c=1.0-2.0*jitter;
        float r=sqrt(max(0.0,1.0-c*c));
        vec3 direction=rotateY(vec3(cos(phi)*r,c,sin(phi)*r),frame.lighting.y);
        pdf=environmentPdf(direction);
        return direction;
    }
    xi.x=min((xi.x-0.05)/0.95,0.99999994);
    int low=0, high=frame.scene.y*frame.scene.z-1;
    while (low<high) { int middle=(low+high)/2; if (xi.x<ptScene.distribution.items[middle].x) high=middle; else low=middle+1; }
    int x=low%frame.scene.y, y=low/frame.scene.y;
    float phi=2.0*PI*((float(x)+xi.y)/float(frame.scene.y)-0.5);
    float cosTheta=mix(cos(PI*float(y)/float(frame.scene.z)),cos(PI*float(y+1)/float(frame.scene.z)),jitter);
    float sinTheta=sqrt(max(0.0,1.0-cosTheta*cosTheta));
    pdf=0.95*ptScene.distribution.items[low].y/max(solidAngle(y),1e-20)+0.05/(4.0*PI);
    return rotateY(vec3(cos(phi)*sinTheta,cosTheta,sin(phi)*sinTheta),frame.lighting.y);
}
float powerWeight(float a,float b) {
    // Narrow refractive lobes can have very large directional PDFs. Normalize before squaring.
    float scale=max(a,b); if (scale<=0.0) return 0.0;
    a/=scale; b/=scale; return a*a/(a*a+b*b);
}
// ----------------------------------------------------------- participating medium
// One homogeneous medium: a scalar extinction, an RGB single-scattering albedo and a
// Henyey-Greenstein phase function, optionally confined to an axis-aligned box. Extinction is
// deliberately achromatic, so a distance sample is one scalar decision and nothing here needs a
// per-channel pdf; colour comes from the albedo instead.

/**
 * The part of [0,limit] along a unit rd that lies inside the medium, as (near,far). An empty
 * overlap returns far<near, which is how every caller spells "this segment misses the medium".
 * An unbounded medium is the whole segment.
 */
vec2 mediumSpan(vec3 ro,vec3 rd,float limit) {
    if (frame.mediumOptions.y<0.5) return vec2(0.0,limit);
    float nearT=0.0,farT=limit;
    for (int axis=0; axis<3; axis++) {
        if (abs(rd[axis])<1e-20) {
            if (ro[axis]<frame.mediumLow[axis] || ro[axis]>frame.mediumHigh[axis]) return vec2(0.0,-1.0);
        } else {
            float a=(frame.mediumLow[axis]-ro[axis])/rd[axis], b=(frame.mediumHigh[axis]-ro[axis])/rd[axis];
            nearT=max(nearT,min(a,b)); farT=min(farT,max(a,b));
        }
    }
    return nearT<=farT ? vec2(nearT,farT) : vec2(0.0,-1.0);
}
/**
 * Analytic transmittance over [0,limit]. This is what a light connection is multiplied by, and it
 * is the only place transmittance is *evaluated* rather than estimated: along a scattering
 * segment the distance sampler estimates it with a binary event instead, so the two never both
 * apply to the same interval.
 */
float mediumTransmittance(vec3 ro,vec3 rd,float limit) {
    if (frame.medium.w<=0.0) return 1.0;
    vec2 span=mediumSpan(ro,rd,limit);
    return span.y<=span.x ? 1.0 : exp(-frame.medium.w*(span.y-span.x));
}
/**
 * Distance to a real scattering event along rd, or a negative value for "nothing before limit".
 *
 * [u] is in/out on purpose. There is no spare Sobol dimension for this decision -- the existing
 * four-per-bounce layout already reaches dimension 97 at twelve bounces, with the lens pair at
 * 98/99 -- so the distance sample shares the BSDF-lobe selector's dimension and, on the escape
 * branch, is remapped back to uniform. Conditional on no scatter, u is uniform on [1-T,1), so
 * (u-(1-T))/T is exactly uniform on [0,1): the caller's later use of u is undisturbed, not
 * approximately undisturbed. With extinction zero, T is one and u comes back unchanged, which is
 * why a medium-disabled render is bit-for-bit what this integrator produced before media existed.
 */
float sampleMediumDistance(vec3 ro,vec3 rd,float limit,inout float u) {
    float extinction=frame.medium.w;
    if (extinction<=0.0) return -1.0;
    vec2 span=mediumSpan(ro,rd,limit);
    if (span.y<=span.x) return -1.0;
    float escape=exp(-extinction*(span.y-span.x));
    if (u>=1.0-escape) { u=(u-(1.0-escape))/max(escape,1e-30); return -1.0; }
    // The decision above and the distance below agree in exact arithmetic; min() is the guard
    // against them disagreeing in the last bit and placing the event past the surface.
    return min(span.x-log(max(1.0-u,1e-30))/extinction,span.y);
}
/**
 * Henyey-Greenstein, as a density over solid angle, of scattering an arrival direction into an
 * outgoing one. [mu] is the cosine between the two *directions of travel*, so mu near one is
 * forward scattering and positive g concentrates there. Integrates to one over the sphere, which
 * is what makes it its own importance-sampling pdf and leaves the phase-sampled weight at one.
 */
float phase(float mu,float g) {
    if (abs(g)<1e-4) return 1.0/(4.0*PI);
    float d=1.0+g*g-2.0*g*clamp(mu,-1.0,1.0);
    return (1.0-g*g)/(4.0*PI*max(d,1e-12)*sqrt(max(d,1e-12)));
}
/** Exact inverse-CDF sample of [phase] about the arrival direction rd. */
vec3 samplePhase(vec3 rd,float g,vec2 xi) {
    float mu;
    if (abs(g)<1e-4) mu=1.0-2.0*xi.y;
    else {
        float s=(1.0-g*g)/(1.0-g+2.0*g*xi.y);
        mu=clamp((1.0+g*g-s*s)/(2.0*g),-1.0,1.0);
    }
    float radius=sqrt(max(0.0,1.0-mu*mu)),phi=2.0*PI*xi.x;
    return basis(rd)*vec3(radius*cos(phi),radius*sin(phi),mu);
}

struct EmitterSample { vec3 direction; vec3 radiance; float pdf; float distance; };
// Probability this triangle's own area sampling would have produced a hit arriving along
// direction after travelling dist, as a solid-angle density. Zero whenever the emitter strategy
// cannot produce the point at all, which leaves the BSDF-hit arm's MIS weight at exactly one.
float emitterPdf(int id,vec3 direction,float dist) {
    if (frame.emitters.x<=0) return 0.0;
    vec2 entry=ptScene.emitterLookup.items[id];
    if (entry.x<=0.0 || entry.y<=0.0) return 0.0;
    Triangle t=ptScene.triangles.items[id];
    float cosLight=abs(dot(normalize(cross(t.b.xyz-t.a.xyz,t.c.xyz-t.a.xyz)),direction));
    return entry.x*dist*dist/max(entry.y*cosLight,1e-20);
}
// Pick a triangle from the power-weighted table, then a point uniformly over its area. The
// dist^2/|cos| Jacobian is what converts that area density into something comparable with a BSDF
// pdf, and is where this kind of change is usually wrong.
EmitterSample sampleEmitter(vec3 origin,float selector,vec2 xi) {
    EmitterSample s=EmitterSample(vec3(0,0,1),vec3(0),0.0,0.0);
    int count=frame.emitters.x;
    if (count<=0) return s;
    int low=0,high=count-1;
    while (low<high) { int middle=(low+high)/2; if (selector<ptScene.emitterTable.items[middle].x) high=middle; else low=middle+1; }
    int id=int(ptScene.emitterTable.items[low].y);
    vec2 entry=ptScene.emitterLookup.items[id];
    if (entry.x<=0.0 || entry.y<=0.0) return s;
    Triangle t=ptScene.triangles.items[id];
    float edge=sqrt(clamp(xi.x,0.0,1.0));
    vec2 bary=vec2(edge*(1.0-xi.y),edge*xi.y);
    vec3 point=t.a.xyz*(1.0-bary.x-bary.y)+t.b.xyz*bary.x+t.c.xyz*bary.y;
    vec3 delta=point-origin;
    float d2=dot(delta,delta);
    if (d2<1e-20) return s;
    s.distance=sqrt(d2);
    s.direction=delta/s.distance;
    vec3 face=normalize(cross(t.b.xyz-t.a.xyz,t.c.xyz-t.a.xyz));
    float cosLight=-dot(face,s.direction);
    Material stored=ptScene.materials.items[int(t.a.w)];
    // A one-sided emitter's back face is culled in acceptsHit, so it must be dark here too.
    if (cosLight<=0.0) { if (stored.coverage.w<0.5) return s; cosLight=-cosLight; face=-face; }
    s.pdf=entry.x*d2/max(entry.y*cosLight,1e-20);
    Material m=texturedMaterial(t,bary);
    vec3 n=shadingNormal(t,m,bary,s.direction,face);
    m=shadeMaterial(m,PathTraceSurface(point,n,face,-s.direction,bary,int(t.a.w),hitUV(t,bary,0),hitColor(t,bary)));
    s.radiance=m.emission.rgb;
    return s;
}
float specProbability(Material m) { return mix(0.35,1.0,m.base.w); }
vec3 fresnel(vec3 f0,float cosTheta) { return f0+(1.0-f0)*pow(1.0-clamp(cosTheta,0.0,1.0),5.0); }
float ggxD(float nh,float alpha) { float a2=alpha*alpha; float d=nh*nh*(a2-1.0)+1.0; return a2/(PI*d*d); }
float smithG1(float nv,float alpha) { return 2.0*nv/max(nv+sqrt(alpha*alpha+(1.0-alpha*alpha)*nv*nv),1e-20); }
// GGX visible-normal sampling (Heitz; PBRT 4e section 9.6.4).
// Sample the projected visible hemisphere, then undo the roughness stretch.
vec3 sampleVisibleNormal(vec3 n,vec3 wo,float alpha,vec2 xi) {
    mat3 localToWorld=basis(n);
