    tangent=normalize(tangent);bitangent=normalize(cross(n,tangent))*sign(dot(cross(n,tangent),bitangent));
    vec3 map=sampleMap(m.maps.w,hitUV(t,bary,3)).xyz*2.0-1.0;map.xy*=m.textureParams.x;
