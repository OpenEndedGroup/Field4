Hit intersectScene(vec3 ro, vec3 rd, bool shadow) {
    Hit h = Hit(1e30, -1, vec2(0));
#ifdef HARDWARE_QUERY
    rayQueryEXT query;
    uint flags = gl_RayFlagsNoOpaqueEXT;
    if (shadow) flags |= gl_RayFlagsTerminateOnFirstHitEXT;
    rayQueryInitializeEXT(query, sceneAS, flags, 255, ro, frame.lighting.z, rd, h.t);
    while (rayQueryProceedEXT(query)) {
        if(rayQueryGetIntersectionTypeEXT(query,false)==gl_RayQueryCandidateIntersectionTriangleEXT &&
           acceptsHit(rayQueryGetIntersectionPrimitiveIndexEXT(query,false),rayQueryGetIntersectionBarycentricsEXT(query,false),ro,rd))
            rayQueryConfirmIntersectionEXT(query);
    }
    if (rayQueryGetIntersectionTypeEXT(query,true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        h.t = rayQueryGetIntersectionTEXT(query,true);
        h.triangle = rayQueryGetIntersectionPrimitiveIndexEXT(query,true);
        h.bary = rayQueryGetIntersectionBarycentricsEXT(query,true);
    }
#else
    int nodeIndex=0;
    while (nodeIndex < frame.scene.x) {
        Node node=ptScene.nodes.items[nodeIndex];
        if (!boxHit(ro,rd,node.lo.xyz,node.hi.xyz,h.t)) { nodeIndex=node.data.z; continue; }
        for (int j=0; j<node.data.y; j++) {
            int id=node.data.x+j; Triangle t=ptScene.triangles.items[id];
            vec3 e1=t.b.xyz-t.a.xyz, e2=t.c.xyz-t.a.xyz, p=cross(rd,e2);
            float det=dot(e1,p); if (abs(det)<1e-10) continue;
            vec3 s=ro-t.a.xyz; float u=dot(s,p)/det;
            if (u<0.0 || u>1.0) continue;
            vec3 q=cross(s,e1); float v=dot(rd,q)/det;
            if (v<0.0 || u+v>1.0) continue;
            float distance=dot(e2,q)/det;
            if (distance>frame.lighting.z && distance<h.t && acceptsHit(id,vec2(u,v),ro,rd)) {
                h=Hit(distance,id,vec2(u,v)); if (shadow) return h;
            }
