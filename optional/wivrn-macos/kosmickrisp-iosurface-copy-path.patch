+/*
+ * Copy path for drivers without VK_EXT_metal_objects (KosmicKrisp): the app renders into a
+ * local image and each release copies it into the service's IOSurface, whose memory is
+ * imported as a host-pointer buffer. On Apple silicon that memory is unified, so the copy is
+ * a GPU transfer with no CPU involvement.
+ */
+bool vk_apple_metal_objects_enabled = false;
+
+struct vk_iosurface_copy
+{
+	VkImage image;
+	VkBuffer buffer;
+	VkDeviceMemory memory;
+	uint32_t row_texels;
+	IOSurfaceRef surface;
+};
+
+#define VK_IOSURFACE_COPY_MAX 128
+static struct vk_iosurface_copy g_iosurface_copies[VK_IOSURFACE_COPY_MAX];
+static pthread_mutex_t g_iosurface_copies_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static VkResult
+create_iosurface_copy(struct vk_bundle *vk, VkImage image, IOSurfaceRef surface)
+{
+	void *base = IOSurfaceGetBaseAddress(surface);
+	size_t size = IOSurfaceGetAllocSize(surface);
+	size_t bytes_per_element = IOSurfaceGetBytesPerElement(surface);
+	size_t bytes_per_row = IOSurfaceGetBytesPerRow(surface);
+	if (base == NULL || size == 0 || bytes_per_element == 0 || bytes_per_row % bytes_per_element != 0) {
+		VK_ERROR(vk, "IOSurface copy path: unusable surface (base %p, size %zu, %zu bytes/row, %zu bytes/element)",
+		         base, size, bytes_per_row, bytes_per_element);
+		return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+	}
+
+	VkExternalMemoryBufferCreateInfo external_info = {
+	    .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+	    .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+	};
+	VkBufferCreateInfo buffer_info = {
+	    .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+	    .pNext = &external_info,
+	    .size = size,
+	    .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+	    .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+	};
+	VkBuffer buffer = VK_NULL_HANDLE;
+	VkResult ret = vk->vkCreateBuffer(vk->device, &buffer_info, NULL, &buffer);
+	if (ret != VK_SUCCESS) {
+		VK_ERROR(vk, "IOSurface copy path: vkCreateBuffer: %s", vk_result_string(ret));
+		return ret;
+	}
+
+	VkMemoryRequirements requirements = {0};
+	vk->vkGetBufferMemoryRequirements(vk->device, buffer, &requirements);
+	uint32_t type_bits = requirements.memoryTypeBits;
+	PFN_vkGetMemoryHostPointerPropertiesEXT host_pointer_properties =
+	    (PFN_vkGetMemoryHostPointerPropertiesEXT)vk->vkGetDeviceProcAddr(vk->device,
+	                                                                     "vkGetMemoryHostPointerPropertiesEXT");
+	if (host_pointer_properties != NULL) {
+		VkMemoryHostPointerPropertiesEXT props = {.sType = VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT};
+		if (host_pointer_properties(vk->device, VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, base,
+		                            &props) == VK_SUCCESS) {
+			type_bits &= props.memoryTypeBits;
+		}
+	}
+	uint32_t type_index = UINT32_MAX;
+	for (uint32_t i = 0; i < vk->device_memory_props.memoryTypeCount; i++) {
+		if ((type_bits & (1u << i)) != 0 && (vk->device_memory_props.memoryTypes[i].propertyFlags &
+		                                     VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) != 0) {
+			type_index = i;
+			break;
+		}
+	}
+	if (type_index == UINT32_MAX) {
+		VK_ERROR(vk, "IOSurface copy path: no host-visible memory type for the surface (bits 0x%x)", type_bits);
+		vk->vkDestroyBuffer(vk->device, buffer, NULL);
+		return VK_ERROR_FEATURE_NOT_PRESENT;
+	}
+
+	VkImportMemoryHostPointerInfoEXT import_info = {
+	    .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT,
+	    .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT,
+	    .pHostPointer = base,
+	};
+	VkMemoryAllocateInfo allocate_info = {
+	    .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+	    .pNext = &import_info,
+	    .allocationSize = size,
+	    .memoryTypeIndex = type_index,
+	};
+	VkDeviceMemory memory = VK_NULL_HANDLE;
+	ret = vk->vkAllocateMemory(vk->device, &allocate_info, NULL, &memory);
+	if (ret == VK_SUCCESS) {
+		ret = vk->vkBindBufferMemory(vk->device, buffer, memory, 0);
+	}
+	if (ret != VK_SUCCESS) {
+		VK_ERROR(vk, "IOSurface copy path: importing the surface's memory: %s", vk_result_string(ret));
+		if (memory != VK_NULL_HANDLE) {
+			vk->vkFreeMemory(vk->device, memory, NULL);
+		}
+		vk->vkDestroyBuffer(vk->device, buffer, NULL);
+		return ret;
+	}
+
+	pthread_mutex_lock(&g_iosurface_copies_lock);
+	struct vk_iosurface_copy *slot = NULL;
+	for (uint32_t i = 0; i < VK_IOSURFACE_COPY_MAX; i++) {
+		if (g_iosurface_copies[i].image == VK_NULL_HANDLE) {
+			slot = &g_iosurface_copies[i];
+			break;
+		}
+	}
+	if (slot != NULL) {
+		CFRetain(surface);
+		*slot = (struct vk_iosurface_copy){
+		    .image = image,
+		    .buffer = buffer,
+		    .memory = memory,
+		    .row_texels = (uint32_t)(bytes_per_row / bytes_per_element),
+		    .surface = surface,
+		};
+	}
+	pthread_mutex_unlock(&g_iosurface_copies_lock);
+	if (slot == NULL) {
+		VK_ERROR(vk, "IOSurface copy path: more than %d swapchain images", VK_IOSURFACE_COPY_MAX);
+		vk->vkFreeMemory(vk->device, memory, NULL);
+		vk->vkDestroyBuffer(vk->device, buffer, NULL);
+		return VK_ERROR_TOO_MANY_OBJECTS;
+	}
+	VK_DEBUG(vk, "IOSurface copy path: image %p -> %zu bytes, %zu bytes/row", (void *)image, size, bytes_per_row);
+	return VK_SUCCESS;
+}
+
+bool
+vk_iosurface_copy_target(VkImage image, VkBuffer *out_buffer, uint32_t *out_row_texels)
+{
+	bool found = false;
+	pthread_mutex_lock(&g_iosurface_copies_lock);
+	for (uint32_t i = 0; i < VK_IOSURFACE_COPY_MAX && image != VK_NULL_HANDLE; i++) {
+		if (g_iosurface_copies[i].image == image) {
+			*out_buffer = g_iosurface_copies[i].buffer;
+			*out_row_texels = g_iosurface_copies[i].row_texels;
+			found = true;
+			break;
+		}
+	}
+	pthread_mutex_unlock(&g_iosurface_copies_lock);
+	return found;
+}
+
+void
+vk_iosurface_copy_release(struct vk_bundle *vk, VkImage image)
+{
+	struct vk_iosurface_copy copy = {0};
+	pthread_mutex_lock(&g_iosurface_copies_lock);
+	for (uint32_t i = 0; i < VK_IOSURFACE_COPY_MAX && image != VK_NULL_HANDLE; i++) {
+		if (g_iosurface_copies[i].image == image) {
+			copy = g_iosurface_copies[i];
+			g_iosurface_copies[i] = (struct vk_iosurface_copy){0};
+			break;
+		}
+	}
+	pthread_mutex_unlock(&g_iosurface_copies_lock);
+	if (copy.image == VK_NULL_HANDLE) {
+		return;
+	}
+	vk->vkDestroyBuffer(vk->device, copy.buffer, NULL);
+	vk->vkFreeMemory(vk->device, copy.memory, NULL);
+	CFRelease(copy.surface);
+}
