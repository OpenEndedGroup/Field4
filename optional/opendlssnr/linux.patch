+int runRender(int argc, char** argv) {
+  const std::string modelDir = argValue(argc, argv, "--model");
+  const std::string proxyFile = argValue(argc, argv, "--proxy");
+  const std::string output = argValue(argc, argv, "--output");
+  const uint32_t width = (uint32_t)atoi(argValue(argc, argv, "--width", "0").c_str());
+  const uint32_t height = (uint32_t)atoi(argValue(argc, argv, "--height", "0").c_str());
+  if (modelDir.empty() || proxyFile.empty() || output.empty() || width < 33 || height < 33) {
+    fprintf(stderr, "usage: dlss5vk render --model <dir> --proxy <RGBA f32 file> --width W --height H --output <prefix>\n");
+    return 2;
+  }
+  const auto proxy = readFile(proxyFile);
+  if (proxy.size() != (uint64_t)width * height * 16) throw std::runtime_error("proxy byte size mismatch");
+  for (size_t i = 0; i < proxy.size(); i += 4) {
+    float value; memcpy(&value, proxy.data() + i, 4);
+    if (!std::isfinite(value) || value < 0 || value > 1) throw std::runtime_error("proxy values must be finite in 0..1");
+  }
+  vk::Context context;
+  printf("device: %s\n", context.deviceName().c_str());
+  nr::Model model(context, modelDir, true);
+  nr::Kernels kernels(context, argValue(argc, argv, "--shaders", executableDirectory(argv[0]) + "/shaders"));
+  kernels.setSiluTable(ref::siluTable());
+  const nr::Geometry geometry = nr::Geometry::fromValid(width, height);
+  nr::Graph graph(context, model, kernels, geometry, {.fusedBlocks = fusedBlocksEnabled()});
+  nr::Activation* features = graph.allocate("render features", geometry.fullWidth * geometry.fullHeight, 16, nr::Format::F32);
+  vk::Buffer proxyBuffer = context.createBuffer(proxy.size(), false, "render proxy");
+  context.upload(proxyBuffer, proxy.data(), proxy.size());
+  nr::Kernels::PreprocessArgs preprocess{geometry.fullWidth, geometry.fullHeight, width, height, width, height,
+      (uint32_t)atoi(argValue(argc, argv, "--seed", "1").c_str()), false,
+      (float)atof(argValue(argc, argv, "--tone", "1").c_str()),
+      (float)atof(argValue(argc, argv, "--structure", "1").c_str()),
+      (float)atof(argValue(argc, argv, "--skin", "1").c_str()),
+      (float)atof(argValue(argc, argv, "--style", "1").c_str())};
+  VkCommandBuffer commands = context.beginCommands();
+  kernels.preprocessFromProxy(commands, proxyBuffer, *features, preprocess);
+  graph.record(commands, *features);
+  context.endAndSubmit(commands, true);
+  checkChainTimeouts(kernels);
+  const auto head = context.download(graph.head().buffer, graph.head().validBytes());
+  const auto input = context.download(features->buffer, features->validBytes());
+  for (size_t i = 0; i < head.size(); i += 4) {
+    float value; memcpy(&value, head.data() + i, 4);
+    if (!std::isfinite(value)) throw std::runtime_error("network produced a non-finite head value");
+  }
+  std::vector<uint8_t> pixels((size_t)width * height * 3);
+  double difference = 0;
+  for (uint32_t y = 0; y < height; ++y)
+    for (uint32_t x = 0; x < width; ++x)
+      for (uint32_t c = 0; c < 3; ++c) {
+        const size_t padded = (size_t)y * geometry.fullWidth + x;
+        const size_t pixel = (size_t)y * width + x;
+        float h, centred, original;
+        memcpy(&h, head.data() + (padded * 4 + c) * 4, 4);
+        memcpy(&centred, input.data() + (padded * 16 + 4 + c) * 4, 4);
+        memcpy(&original, proxy.data() + (pixel * 4 + c) * 4, 4);
+        const float result = composed(h, centred);
+        difference += std::abs(result - original);
+        pixels[pixel * 3 + c] = (uint8_t)std::floor(result * 255 + 0.5f);
+      }
+  std::ofstream image(output + ".ppm", std::ios::binary);
+  image << "P6\n" << width << " " << height << "\n255\n";
+  image.write(reinterpret_cast<const char*>(pixels.data()), pixels.size());
+  std::ofstream raw(output + ".head.f32", std::ios::binary);
+  raw.write(reinterpret_cast<const char*>(head.data()), head.size());
+  if (!image || !raw) throw std::runtime_error("cannot write render outputs");
+  context.destroyBuffer(proxyBuffer);
+  printf("rendered %ux%u (padded %ux%u), %u dispatches, finite head; mean RGB change %.6f\n",
+         width, height, geometry.fullWidth, geometry.fullHeight, kernels.dispatchCount(), difference / pixels.size());
+  printf("saved %s.ppm and %s.head.f32\n", output.c_str(), output.c_str());
+  return 0;
+}
