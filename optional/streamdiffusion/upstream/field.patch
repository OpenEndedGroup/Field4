@@ -312,6 +312,15 @@ class TAEHVTensorRTDecoder:
         if cached is not None:
             return cached
 
+        # Streaming warms up through shapes 2, 3, then 4. Each context can
+        # retain over a GB of device memory, so keep only the active shape.
+        # Return PyTorch's unused pool to CUDA before TensorRT allocates its
+        # context; TensorRT cannot reuse memory held by PyTorch's allocator.
+        torch.cuda.synchronize(device)
+        self._engine_cache.clear()
+        with torch.cuda.device(device):
+            torch.cuda.empty_cache()
+
