diff --git a/src/app/field_web_bridge.cpp b/src/app/field_web_bridge.cpp
new file mode 100644
index 0000000..de3e470
--- /dev/null
+++ b/src/app/field_web_bridge.cpp
@@ -0,0 +1,168 @@
+#include "app/field_web_bridge.hpp"
+#include "ui/main_window.hpp"
+#include <emscripten.h>
+#include <QByteArray>
+#include <QDir>
+#include <QFile>
+#include <QTimer>
+
+namespace {
+EM_JS(int, has_same_origin_parent, (), {
+  try { return window.parent !== window && window.parent.location.origin === window.location.origin; }
+  catch (_) { return false; }
+});
+
+// Only a same-origin parent frame can call Patchy's document API. The parent
+// receives JSON-RPC replies from the same live session as the visible editor.
+EM_JS(void, install_field_message_listener, (), {
+  if (window.parent === window) return;
+  Module.fieldPatchyQueue = [];
+  Module.fieldPatchyFileQueue = [];
+  window.addEventListener('message', function(event) {
+    if (event.source !== window.parent || event.origin !== window.location.origin) return;
+    var data = event.data;
+    if (data && data.type === 'field-patchy-load-file' && data.bytes instanceof ArrayBuffer) {
+      Module.fieldPatchyFileQueue.push({type: 'load', bytes: new Uint8Array(data.bytes)});
+      return;
+    }
+    if (data && data.type === 'field-patchy-read-file') {
+      Module.fieldPatchyFileQueue.push({type: 'read'});
+      return;
+    }
+    if (!data || data.type !== 'field-patchy-request' ||
+        !data.message || typeof data.message !== 'object') return;
+    try { Module.fieldPatchyQueue.push(JSON.stringify(data.message)); }
+    catch (_) { /* A malformed browser message cannot enter the native session. */ }
+  });
+});
+
+EM_JS(int, field_file_request_kind, (), {
+  var queue = Module.fieldPatchyFileQueue;
+  if (!queue || !queue.length) return 0;
+  return queue[0].type === 'load' ? 1 : 2;
+});
+
+EM_JS(int, field_load_file_length, (), {
+  return Module.fieldPatchyFileQueue[0].bytes.length;
+});
+
+EM_JS(void, copy_field_load_file, (char* destination), {
+  var item = Module.fieldPatchyFileQueue.shift();
+  HEAPU8.set(item.bytes, destination);
+});
+
+EM_JS(void, discard_field_file_request, (), {
+  Module.fieldPatchyFileQueue.shift();
+});
+
+EM_JS(void, post_field_file_loaded, (int ok), {
+  window.parent.postMessage({type: 'field-patchy-file-loaded', ok: !!ok}, window.location.origin);
+});
+
+EM_JS(void, post_field_file_read, (const char* bytes, int length), {
+  var copy = bytes ? HEAPU8.slice(bytes, bytes + length) : null;
+  window.parent.postMessage({type: 'field-patchy-file-read', bytes: copy && copy.buffer},
+                            window.location.origin, copy ? [copy.buffer] : []);
+});
+
+EM_JS(int, field_message_length, (), {
+  var queue = Module.fieldPatchyQueue;
+  return queue && queue.length ? lengthBytesUTF8(queue[0]) : -1;
+});
+
+EM_JS(void, copy_field_message, (char* destination, int capacity), {
+  stringToUTF8(Module.fieldPatchyQueue.shift(), destination, capacity);
+});
+
+EM_JS(void, discard_field_message, (), {
+  Module.fieldPatchyQueue.shift();
+});
+
+EM_JS(void, post_field_ready, (), {
+  if (window.parent !== window) {
+    window.parent.postMessage({type: 'field-patchy-ready'}, window.location.origin);
+  }
+});
+
+EM_JS(void, post_field_reply_bytes, (const char* reply), {
+  if (window.parent !== window) {
+    window.parent.postMessage(
+      {type: 'field-patchy-response', message: JSON.parse(UTF8ToString(reply))},
+      window.location.origin);
+  }
+});
+
+void post_field_reply(const QByteArray& bytes) { post_field_reply_bytes(bytes.constData()); }
+}  // namespace
+
+namespace patchy {
+bool field_web_bridge_available() { return has_same_origin_parent() != 0; }
+
+FieldWebBridge::FieldWebBridge(ui::MainWindow& window)
+    : session_(window, true, post_field_reply) {
+  QDir().mkpath(QStringLiteral("/field"));
+  session_.connect_from_any_thread();
+  install_field_message_listener();
+  auto* inbox_timer = new QTimer(&window);
+  inbox_timer->setInterval(10);
+  QObject::connect(inbox_timer, &QTimer::timeout, &window, [this] {
+    const int length = field_message_length();
+    if (length < 0) return;
+    if (length > 16 * 1024 * 1024) {
+      discard_field_message();
+      return;
+    }
+    QByteArray message(length + 1, '\0');
+    copy_field_message(message.data(), message.size());
+    message.chop(1);
+    session_.receive_line(message);
+  });
+  inbox_timer->start();
+  auto* file_timer = new QTimer(&window);
+  file_timer->setInterval(10);
+  QObject::connect(file_timer, &QTimer::timeout, &window, [] {
+    constexpr auto path = "/field/painting.psd";
+    const int kind = field_file_request_kind();
+    if (kind == 1) {
+      const int length = field_load_file_length();
+      if (length <= 0 || length > 512 * 1024 * 1024) {
+        discard_field_file_request();
+        post_field_file_loaded(0);
+        return;
+      }
+      QByteArray bytes(length, '\0');
+      copy_field_load_file(bytes.data());
+      QDir().mkpath(QStringLiteral("/field"));
+      QFile file(QString::fromLatin1(path));
+      const bool ok = file.open(QIODevice::WriteOnly | QIODevice::Truncate) &&
+          file.write(bytes) == bytes.size();
+      post_field_file_loaded(ok ? 1 : 0);
+    } else if (kind == 2) {
+      discard_field_file_request();
+      QFile file(QString::fromLatin1(path));
+      if (!file.open(QIODevice::ReadOnly)) { post_field_file_read(nullptr, 0); return; }
+      const auto bytes = file.readAll();
+      post_field_file_read(bytes.constData(), bytes.size());
+    }
+  });
+  file_timer->start();
+  auto* ready_timer = new QTimer(&window);
+  ready_timer->setInterval(0);
+  QObject::connect(ready_timer, &QTimer::timeout, &window, [this, ready_timer] {
+    if (session_.ready()) {
+      ready_timer->stop();
+      ready_timer->deleteLater();
+      post_field_ready();
+    } else if (session_.closed()) {
+      ready_timer->stop();
+      ready_timer->deleteLater();
+    }
+  });
+  ready_timer->start();
+}
+
+FieldWebBridge::~FieldWebBridge() {
+  session_.shutdown();
+}
+
+}  // namespace patchy
