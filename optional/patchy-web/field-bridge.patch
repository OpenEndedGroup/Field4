+#pragma once
+
+#include "ui/mcp_session.hpp"
+
+namespace patchy::ui { class MainWindow; }
+
+namespace patchy {
+
+/** True only for an iframe with a same-origin host. */
+bool field_web_bridge_available();
+
+// The browser host speaks the existing MCP document protocol over postMessage.
+// The session remains owned by Patchy's visible window and runs on its UI thread.
+class FieldWebBridge {
+ public:
+  explicit FieldWebBridge(ui::MainWindow& window);
+  ~FieldWebBridge();
+  FieldWebBridge(const FieldWebBridge&) = delete;
+  FieldWebBridge& operator=(const FieldWebBridge&) = delete;
+
+ private:
+  ui::McpSession session_;
+};
+
+}  // namespace patchy
